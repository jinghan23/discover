"""
Outgoing TriMul forward.

The implementation uses PyTorch/cuBLAS for the dense channel projections and
Triton for the TriMul contraction.  The five input projections are computed as
one fused linear op, a Triton preparation kernel applies gates/mask and writes
left/right activations in [B, H, N, N] layout, then a tiled Triton batched GEMM
computes out[b, i, j, h] = sum_k left[b, h, i, k] * right[b, h, j, k].
Final normalization/gating/output projection are done with optimized PyTorch ops.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_WEIGHT_CACHE = {}


def _cache_key(tensors, dtype):
    return tuple((int(t.data_ptr()), tuple(t.shape), str(t.dtype), str(t.device)) for t in tensors) + (str(dtype),)


def _cat_half(tensors):
    key = ("cat",) + _cache_key(tensors, torch.float16)
    out = _WEIGHT_CACHE.get(key)
    if out is None:
        out = torch.cat([t.to(torch.float16) for t in tensors], dim=0).contiguous()
        _WEIGHT_CACHE[key] = out
    return out


def _half_weight(t):
    key = ("half", int(t.data_ptr()), tuple(t.shape), str(t.dtype), str(t.device))
    out = _WEIGHT_CACHE.get(key)
    if out is None:
        out = t.to(torch.float16).contiguous()
        _WEIGHT_CACHE[key] = out
    return out


@triton.jit
def _prep_proj_kernel(
    proj,
    mask,
    left,
    right,
    out_gate,
    total: tl.constexpr,
    N: tl.constexpr,
    H: tl.constexpr,
    FIVE_H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, BLOCK_H)
    valid_m = offs_m < total

    pbase = offs_m[:, None] * FIVE_H + offs_h[None, :]

    l = tl.load(proj + pbase, mask=valid_m[:, None], other=0.0).to(tl.float32)
    r = tl.load(proj + pbase + H, mask=valid_m[:, None], other=0.0).to(tl.float32)
    lg = tl.load(proj + pbase + 2 * H, mask=valid_m[:, None], other=0.0).to(tl.float32)
    rg = tl.load(proj + pbase + 3 * H, mask=valid_m[:, None], other=0.0).to(tl.float32)
    og = tl.load(proj + pbase + 4 * H, mask=valid_m[:, None], other=0.0).to(tl.float32)

    l = l * tl.sigmoid(lg)
    r = r * tl.sigmoid(rg)
    og = tl.sigmoid(og)

    if HAS_MASK:
        mv = tl.load(mask + offs_m, mask=valid_m, other=0.0).to(tl.float32)
        l = l * mv[:, None]
        r = r * mv[:, None]

    nn = N * N
    b = offs_m // nn
    ik = offs_m - b * nn
    trans_off = b[:, None] * (H * nn) + offs_h[None, :] * nn + ik[:, None]

    tl.store(left + trans_off, l, mask=valid_m[:, None])
    tl.store(right + trans_off, r, mask=valid_m[:, None])
    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og, mask=valid_m[:, None])


@triton.jit
def _trimul_outgoing_kernel(
    left,
    right,
    out,
    N: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
    BLOCK_K: tl.constexpr,
    BLOCK_CH: tl.constexpr,
):
    pid_i = tl.program_id(0)
    pid_j = tl.program_id(1)
    pid_bhc = tl.program_id(2)

    h_blocks = H // BLOCK_CH
    b = pid_bhc // h_blocks
    hc = (pid_bhc - b * h_blocks) * BLOCK_CH

    offs_i = pid_i * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_j = pid_j * BLOCK_N + tl.arange(0, BLOCK_N)
    offs_k = tl.arange(0, BLOCK_K)

    nn = N * N
    out_b_base = b * nn * H
    mask_a = offs_i[:, None] < N
    mask_b = offs_j[None, :] < N
    mask_store = (offs_i[:, None] < N) & (offs_j[None, :] < N)

    acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
    acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)

    base0 = (b * H + hc) * nn
    base1 = base0 + nn

    for k0 in range(0, N, BLOCK_K):
        k = k0 + offs_k
        km = k < N

        a0 = tl.load(
            left + base0 + offs_i[:, None] * N + k[None, :],
            mask=mask_a & km[None, :],
            other=0.0,
        )
        b0 = tl.load(
            right + base0 + offs_j[None, :] * N + k[:, None],
            mask=km[:, None] & (offs_j[None, :] < N),
            other=0.0,
        )
        acc0 += tl.dot(a0, b0, out_dtype=tl.float32)

        a1 = tl.load(
            left + base1 + offs_i[:, None] * N + k[None, :],
            mask=mask_a & km[None, :],
            other=0.0,
        )
        b1 = tl.load(
            right + base1 + offs_j[None, :] * N + k[:, None],
            mask=km[:, None] & (offs_j[None, :] < N),
            other=0.0,
        )
        acc1 += tl.dot(a1, b1, out_dtype=tl.float32)

    out_off = out_b_base + offs_i[:, None] * (N * H) + offs_j[None, :] * H + hc
    tl.store(out + out_off, acc0, mask=mask_store)
    tl.store(out + out_off + 1, acc1, mask=mask_store)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    B, N, _, D = input_tensor.shape
    H = int(config["hidden_dim"])
    eps = float(config.get("eps", config.get("layer_norm_eps", 1.0e-5)))

    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]

    proj_w = _cat_half(
        [
            weights["left_proj.weight"],
            weights["right_proj.weight"],
            weights["left_gate.weight"],
            weights["right_gate.weight"],
            weights["out_gate.weight"],
        ]
    )
    to_out_w = _half_weight(weights["to_out.weight"])

    x = F.layer_norm(input_tensor, (D,), norm_weight, norm_bias, eps)
    proj = F.linear(x.to(torch.float16), proj_w)

    left = torch.empty((B, H, N, N), device=input_tensor.device, dtype=torch.float16)
    right = torch.empty((B, H, N, N), device=input_tensor.device, dtype=torch.float16)
    out_gate = torch.empty((B, N, N, H), device=input_tensor.device, dtype=torch.float16)

    has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
    if has_mask and not mask.is_contiguous():
        mask = mask.contiguous()
    mask_arg = mask if has_mask else input_tensor

    total = B * N * N
    _prep_proj_kernel[(triton.cdiv(total, 16),)](
        proj,
        mask_arg,
        left,
        right,
        out_gate,
        total,
        N,
        H,
        5 * H,
        has_mask,
        BLOCK_M=16,
        BLOCK_H=128,
        num_warps=4,
    )

    tri = torch.empty((B, N, N, H), device=input_tensor.device, dtype=torch.float32)

    _trimul_outgoing_kernel[
        (triton.cdiv(N, 16), triton.cdiv(N, 32), B * triton.cdiv(H, 2))
    ](
        left,
        right,
        tri,
        N,
        H,
        BLOCK_M=16,
        BLOCK_N=32,
        BLOCK_K=64,
        BLOCK_CH=2,
        num_warps=4,
        num_stages=3,
    )

    y = F.layer_norm(tri, (H,), to_out_norm_weight, to_out_norm_bias, eps)
    y = (y * out_gate).to(torch.float16)
    return F.linear(y, to_out_w).to(torch.float32)

```python
"""
Fused TriMul forward: normalize and project the pair representation with PyTorch
GEMMs, perform the outgoing triangular multiplication as batched matrix
multiplication over hidden channels, then use a Triton kernel to fuse the
hidden-dimension output LayerNorm with the output gate before the final linear.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


torch.backends.cuda.matmul.allow_tf32 = True
torch.backends.cudnn.allow_tf32 = True
try:
    torch.set_float32_matmul_precision("high")
except Exception:
    pass


@triton.jit
def _out_norm_gate_kernel(
    tri_ptr,
    gate_ptr,
    gamma_ptr,
    beta_ptr,
    dst_ptr,
    N2: tl.constexpr,
    TOTAL: tl.constexpr,
    H: tl.constexpr,
    EPS: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    offs_m = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, BLOCK_H)

    b = offs_m // N2
    p = offs_m - b * N2

    valid = (offs_m[:, None] < TOTAL) & (offs_h[None, :] < H)
    tri_offsets = b[:, None] * (H * N2) + offs_h[None, :] * N2 + p[:, None]

    v = tl.load(tri_ptr + tri_offsets, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) / H
    centered = v - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / H
    rstd = tl.rsqrt(var + EPS)

    g = tl.load(gate_ptr + tri_offsets, mask=valid, other=0.0).to(tl.float32)
    w = tl.load(gamma_ptr + offs_h, mask=offs_h < H, other=0.0).to(tl.float32)
    bias = tl.load(beta_ptr + offs_h, mask=offs_h < H, other=0.0).to(tl.float32)

    y = (centered * rstd[:, None]) * w[None, :] + bias[None, :]
    y = y * g

    dst_offsets = offs_m[:, None] * H + offs_h[None, :]
    tl.store(dst_ptr + dst_offsets, y, mask=valid)


@torch.no_grad()
def custom_kernel(data):
    input_tensor, mask, weights, config = data

    B, N, _, D = input_tensor.shape
    H = int(config["hidden_dim"])
    eps = float(config.get("eps", config.get("norm_eps", 1.0e-5)))
    out_eps = float(config.get("out_norm_eps", eps))
    total = B * N * N
    n2 = N * N

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]

    x = input_tensor.reshape(total, D)
    x = F.layer_norm(x, (D,), norm_weight, norm_bias, eps)

    compute_dtype = torch.float16
    xh = x.to(compute_dtype)

    w_cat = torch.cat(
        (
            weights["left_proj.weight"],
            weights["right_proj.weight"],
            weights["left_gate.weight"],
            weights["right_gate.weight"],
            weights["out_gate.weight"],
        ),
        dim=0,
    ).to(compute_dtype)

    proj = F.linear(xh, w_cat)
    left, right, left_gate, right_gate, out_gate = proj.split(H, dim=1)

    left_gate.sigmoid_()
    right_gate.sigmoid_()
    out_gate.sigmoid_()

    left.mul_(left_gate)
    right.mul_(right_gate)

    left = left.reshape(B, N, N, H).permute(0, 3, 1, 2).contiguous()
    right = right.reshape(B, N, N, H).permute(0, 3, 1, 2).contiguous()
    out_gate = out_gate.reshape(B, N, N, H).permute(0, 3, 1, 2).contiguous()

    if mask is not None and not bool(config.get("nomask", False)):
        m = mask.to(dtype=compute_dtype).reshape(B, 1, N, N)
        left.mul_(m)
        right.mul_(m)

    tri = torch.bmm(
        left.reshape(B * H, N, N),
        right.reshape(B * H, N, N).transpose(1, 2),
    ).reshape(B, H, N, N)

    tmp = torch.empty((total, H), device=input_tensor.device, dtype=torch.float32)

    block_h = 1 << (H - 1).bit_length()
    block_m = 8
    grid = ((total + block_m - 1) // block_m,)

    _out_norm_gate_kernel[grid](
        tri,
        out_gate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        tmp,
        n2,
        total,
        H,
        out_eps,
        BLOCK_M=block_m,
        BLOCK_H=block_h,
        num_warps=4,
    )

    to_out_weight = weights["to_out.weight"]
    if to_out_weight.dtype != tmp.dtype:
        to_out_weight = to_out_weight.to(tmp.dtype)

    out = F.linear(tmp, to_out_weight)
    return out.reshape(B, N, N, to_out_weight.shape[0]).to(torch.float32)
```

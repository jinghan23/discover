```python
"""
Outgoing TriMul forward pass.

The implementation uses cuBLAS for the dense projections and the final output
projection, and Triton for the layout-sensitive work. A single fused input GEMM
computes left/right projections plus all three gates. The first Triton kernel
applies sigmoid gates and optional masks while packing each hidden channel into
contiguous [N, N] matrices for batched BMM. The second Triton kernel fuses the
post-BMM transpose, LayerNorm over hidden channels, and output-gate multiply
before the final linear projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_WEIGHT_CACHE = {}


def _tensor_key(t):
    return (
        id(t),
        t.data_ptr(),
        int(t._version),
        tuple(t.shape),
        str(t.dtype),
        str(t.device),
    )


def _cached_cat(tensors):
    key = tuple(_tensor_key(t) for t in tensors)
    cached = _WEIGHT_CACHE.get(key)
    if cached is None:
        if len(_WEIGHT_CACHE) > 12:
            _WEIGHT_CACHE.clear()
        cached = torch.cat(tensors, dim=0).contiguous()
        _WEIGHT_CACHE[key] = cached
    return cached


@triton.jit
def _pack_left_right_gate_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    gate_ptr,
    total_rows: tl.constexpr,
    n2: tl.constexpr,
    hidden: tl.constexpr,
    has_mask: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_mask = rows < total_rows
    h_mask = hs < hidden
    valid = row_mask[:, None] & h_mask[None, :]

    batch = rows // n2
    within = rows - batch * n2

    base = rows[:, None] * (5 * hidden) + hs[None, :]

    left = tl.load(proj_ptr + base, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(proj_ptr + base + hidden, mask=valid, other=0.0).to(tl.float32)
    left_g = tl.load(proj_ptr + base + 2 * hidden, mask=valid, other=0.0).to(tl.float32)
    right_g = tl.load(proj_ptr + base + 3 * hidden, mask=valid, other=0.0).to(tl.float32)
    out_g = tl.load(proj_ptr + base + 4 * hidden, mask=valid, other=0.0).to(tl.float32)

    left = left * (1.0 / (1.0 + tl.exp(-left_g)))
    right = right * (1.0 / (1.0 + tl.exp(-right_g)))
    out_g = 1.0 / (1.0 + tl.exp(-out_g))

    if has_mask:
        m = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
        left = left * m[:, None]
        right = right * m[:, None]

    packed_offsets = batch[:, None] * (hidden * n2) + hs[None, :] * n2 + within[:, None]
    tl.store(left_ptr + packed_offsets, left, mask=valid)
    tl.store(right_ptr + packed_offsets, right, mask=valid)
    tl.store(gate_ptr + rows[:, None] * hidden + hs[None, :], out_g, mask=valid)


@triton.jit
def _post_bmm_norm_gate_kernel(
    tri_ptr,
    gate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    tmp_ptr,
    total_rows: tl.constexpr,
    n2: tl.constexpr,
    hidden: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid = tl.program_id(0)

    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, hidden)
    row_mask = rows < total_rows

    batch = rows // n2
    within = rows - batch * n2

    tri_offsets = batch[:, None] * (hidden * n2) + hs[None, :] * n2 + within[:, None]
    vals = tl.load(tri_ptr + tri_offsets, mask=row_mask[:, None], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) * (1.0 / hidden)
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) * (1.0 / hidden)
    inv_std = tl.rsqrt(var + eps)

    w = tl.load(norm_w_ptr + hs).to(tl.float32)
    b = tl.load(norm_b_ptr + hs).to(tl.float32)
    gate = tl.load(
        gate_ptr + rows[:, None] * hidden + hs[None, :],
        mask=row_mask[:, None],
        other=0.0,
    ).to(tl.float32)

    out = (centered * inv_std[:, None]) * w[None, :] + b[None, :]
    out = out * gate

    tl.store(
        tmp_ptr + rows[:, None] * hidden + hs[None, :],
        out,
        mask=row_mask[:, None],
    )


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True

    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    left_proj_weight = weights["left_proj.weight"]
    right_proj_weight = weights["right_proj.weight"]
    left_gate_weight = weights["left_gate.weight"]
    right_gate_weight = weights["right_gate.weight"]
    out_gate_weight = weights["out_gate.weight"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    bs, seq_len, _, _ = input_tensor.shape
    n2 = seq_len * seq_len
    total_rows = bs * n2
    eps = 1.0e-5

    fused_weight = _cached_cat(
        (
            left_proj_weight,
            right_proj_weight,
            left_gate_weight,
            right_gate_weight,
            out_gate_weight,
        )
    )

    x = F.layer_norm(input_tensor, (dim,), norm_weight, norm_bias, eps)
    proj = F.linear(x.reshape(total_rows, dim), fused_weight).contiguous()
    del x

    left_mat = torch.empty(
        (bs * hidden_dim, seq_len, seq_len),
        device=input_tensor.device,
        dtype=proj.dtype,
    )
    right_mat = torch.empty_like(left_mat)
    out_gate = torch.empty(
        (total_rows, hidden_dim),
        device=input_tensor.device,
        dtype=proj.dtype,
    )

    has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
    mask_arg = mask if (has_mask and mask.is_contiguous()) else (mask.contiguous() if has_mask else input_tensor)

    grid_pack = (triton.cdiv(total_rows, 16), triton.cdiv(hidden_dim, 32))
    _pack_left_right_gate_kernel[grid_pack](
        proj,
        mask_arg,
        left_mat,
        right_mat,
        out_gate,
        total_rows,
        n2,
        hidden_dim,
        has_mask,
        BLOCK_M=16,
        BLOCK_H=32,
        num_warps=4,
    )
    del proj

    tri = torch.bmm(left_mat, right_mat.transpose(1, 2))
    del left_mat, right_mat

    tmp = torch.empty(
        (total_rows, hidden_dim),
        device=input_tensor.device,
        dtype=torch.float32,
    )

    grid_post = (triton.cdiv(total_rows, 16),)
    _post_bmm_norm_gate_kernel[grid_post](
        tri,
        out_gate,
        to_out_norm_weight,
        to_out_norm_bias,
        tmp,
        total_rows,
        n2,
        hidden_dim,
        eps,
        BLOCK_M=16,
        num_warps=8,
    )
    del tri, out_gate

    out = F.linear(tmp, to_out_weight)
    return out.reshape(bs, seq_len, seq_len, dim).to(torch.float32)
```

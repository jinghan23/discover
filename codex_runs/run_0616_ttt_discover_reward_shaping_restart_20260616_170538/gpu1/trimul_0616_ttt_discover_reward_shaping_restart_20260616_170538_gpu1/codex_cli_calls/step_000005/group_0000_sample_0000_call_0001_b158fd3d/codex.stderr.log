"""
TriMul outgoing forward pass.

Uses PyTorch/cuBLAS for the input LayerNorm, packed input projections, gating,
and the N^3 triangular product via batched GEMM. A Triton kernel fuses the final
hidden LayerNorm, output gate, and output projection, producing float32 output.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


try:
    torch.backends.cuda.matmul.allow_tf32 = True
except Exception:
    pass


@triton.jit
def _post_norm_gate_project_kernel(
    tri_ptr,
    gate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    out_w_ptr,
    out_ptr,
    total_rows,
    D: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_D: tl.constexpr,
    BLOCK_H: tl.constexpr,
    EPS: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_d = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_d = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
    offs_h = tl.arange(0, BLOCK_H)

    row_mask = rows < total_rows
    h_mask = offs_h < H

    vals = tl.load(
        tri_ptr + rows[:, None] * H + offs_h[None, :],
        mask=row_mask[:, None] & h_mask[None, :],
        other=0.0,
    ).to(tl.float32)

    mean = tl.sum(vals, axis=1) / H
    centered = vals - mean[:, None]
    centered = tl.where(h_mask[None, :], centered, 0.0)
    var = tl.sum(centered * centered, axis=1) / H
    rstd = tl.rsqrt(var + EPS)

    nw = tl.load(norm_w_ptr + offs_h, mask=h_mask, other=0.0).to(tl.float32)
    nb = tl.load(norm_b_ptr + offs_h, mask=h_mask, other=0.0).to(tl.float32)

    gate = tl.load(
        gate_ptr + rows[:, None] * H + offs_h[None, :],
        mask=row_mask[:, None] & h_mask[None, :],
        other=0.0,
    ).to(tl.float32)

    hidden = (centered * rstd[:, None]) * nw[None, :] + nb[None, :]
    hidden = hidden * gate
    hidden = tl.where(row_mask[:, None] & h_mask[None, :], hidden, 0.0)

    w = tl.load(
        out_w_ptr + offs_d[:, None] * H + offs_h[None, :],
        mask=(offs_d[:, None] < D) & h_mask[None, :],
        other=0.0,
    ).to(tl.float32)

    acc = tl.dot(hidden, tl.trans(w), input_precision="tf32")

    tl.store(
        out_ptr + rows[:, None] * D + offs_d[None, :],
        acc,
        mask=row_mask[:, None] & (offs_d[None, :] < D),
    )


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])
    eps = float(config.get("eps", config.get("norm_eps", 1.0e-5)))

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    left_proj_weight = weights["left_proj.weight"]
    right_proj_weight = weights["right_proj.weight"]
    left_gate_weight = weights["left_gate.weight"]
    right_gate_weight = weights["right_gate.weight"]

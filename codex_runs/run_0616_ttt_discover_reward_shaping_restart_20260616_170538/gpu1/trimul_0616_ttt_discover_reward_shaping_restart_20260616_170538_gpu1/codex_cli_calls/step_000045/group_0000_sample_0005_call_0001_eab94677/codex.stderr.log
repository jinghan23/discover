TriMul outgoing forward with a fused projection packing path.

The input is LayerNormed with PyTorch, the five input projections are computed as one
tensor-core GEMM, Triton applies sigmoid gates/mask while packing left/right into
batched-matmul layout, torch.bmm performs the outgoing contraction, and Triton fuses
output LayerNorm with the output gate before the final linear projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True
    torch.set_float32_matmul_precision("high")
except Exception:
    pass


_WEIGHT_CACHE = {}


@triton.jit
def _pack_lr_gate_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    out_gate_ptr,
    M: tl.constexpr,
    N: tl.constexpr,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):

    y = y * gate

    tl.store(y_ptr + offs_m[:, None] * H + offs_h[None, :], y, mask=mask2)


def _cached_fast_weights(weights, dtype):
    key = (
        weights["left_proj.weight"].data_ptr(),
        weights["right_proj.weight"].data_ptr(),
        weights["left_gate.weight"].data_ptr(),
        weights["right_gate.weight"].data_ptr(),
        weights["out_gate.weight"].data_ptr(),
        weights["to_out.weight"].data_ptr(),
        dtype,
    )
    cached = _WEIGHT_CACHE.get(key)
    if cached is None:
        proj_weight = torch.cat(
            (
                weights["left_proj.weight"],
                weights["right_proj.weight"],
                weights["left_gate.weight"],
                weights["right_gate.weight"],
                weights["out_gate.weight"],
            ),
            dim=0,
        ).to(dtype)
        to_out_weight = weights["to_out.weight"].to(dtype)
        cached = (proj_weight, to_out_weight)
        _WEIGHT_CACHE.clear()
        _WEIGHT_CACHE[key] = cached
    return cached


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    bs, seq_len, _, dim_from_x = input_tensor.shape
    dim = int(config.get("dim", dim_from_x))
    hidden_dim = int(config.get("hidden_dim", weights["left_proj.weight"].shape[0]))
    n = int(seq_len)
    m = bs * n * n

    fast_dtype = torch.float16
    device = input_tensor.device

    x = input_tensor
    if x.dtype != torch.float32:
        x = x.float()

    x_norm = F.layer_norm(
        x,
        (dim,),
        weights["norm.weight"],
        weights["norm.bias"],
        eps=1.0e-5,
    )

    proj_weight, to_out_weight = _cached_fast_weights(weights, fast_dtype)
    proj = F.linear(x_norm.reshape(m, dim).to(fast_dtype), proj_weight)
    del x_norm

    left = torch.empty((bs * hidden_dim, n, n), device=device, dtype=fast_dtype)
    right = torch.empty((bs * hidden_dim, n, n), device=device, dtype=fast_dtype)
    out_gate = torch.empty((m, hidden_dim), device=device, dtype=fast_dtype)

    has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
    mask_arg = mask.reshape(-1) if has_mask else input_tensor

    _pack_lr_gate_kernel[(triton.cdiv(m, 16), triton.cdiv(hidden_dim, 64))](
        proj,
        mask_arg,
        left,
        right,
        out_gate,
        m,
        n,
        hidden_dim,
        HAS_MASK=has_mask,
        BLOCK_M=16,
        BLOCK_H=64,
        num_warps=4,
    )
    del proj

    tri = torch.bmm(left, right.transpose(1, 2))
    del left, right

    y = torch.empty((m, hidden_dim), device=device, dtype=fast_dtype)
    block_h = 1 << (hidden_dim - 1).bit_length()

    _out_norm_gate_kernel[(triton.cdiv(m, 16),)](
        tri,
        out_gate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        y,
        m,
        n,
        hidden_dim,
        BLOCK_M=16,
        BLOCK_H=block_h,
        num_warps=8,
    )
    del tri, out_gate

    out = F.linear(y, to_out_weight)
    return out.to(torch.float32).reshape(bs, n, n, dim)

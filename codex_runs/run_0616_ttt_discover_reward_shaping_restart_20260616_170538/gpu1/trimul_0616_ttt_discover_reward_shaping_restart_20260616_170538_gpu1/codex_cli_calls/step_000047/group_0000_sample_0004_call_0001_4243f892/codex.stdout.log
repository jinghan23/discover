```python
"""
TriMul outgoing forward: normalize pair activations, build gated left/right/out
projections, compute the outgoing triangular product as a batched per-channel
matrix product, then apply output LayerNorm, output gate, and final projection.
A small Triton kernel fuses output gating and final float32 store.
"""

import torch
import triton
import triton.language as tl
import torch.nn.functional as F


@triton.jit
def _gate_kernel(x, gate, y, n_elements:tl.constexpr, BLOCK:tl.constexpr):
    pid = tl.program_id(0)
    offs = pid * BLOCK + tl.arange(0, BLOCK)
    mask = offs < n_elements
    xv = tl.load(x + offs, mask=mask, other=0.0).to(tl.float32)
    gv = tl.load(gate + offs, mask=mask, other=0.0).to(tl.float32)
    tl.store(y + offs, xv * gv, mask=mask)


def _linear_no_bias(x, w):
    return torch.matmul(x, w.t())


def _sigmoid_linear(x, w):
    return torch.sigmoid(torch.matmul(x, w.t()))


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    x = input_tensor
    B, N, _, D = x.shape
    H = config["hidden_dim"]

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    left_proj_weight = weights["left_proj.weight"]
    right_proj_weight = weights["right_proj.weight"]
    left_gate_weight = weights["left_gate.weight"]
    right_gate_weight = weights["right_gate.weight"]
    out_gate_weight = weights["out_gate.weight"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    x = F.layer_norm(x, (D,), norm_weight, norm_bias)

    left = _linear_no_bias(x, left_proj_weight)
    right = _linear_no_bias(x, right_proj_weight)

    if mask is not None:
        m = mask.to(dtype=left.dtype).unsqueeze(-1)
        left = left * m
        right = right * m

    left = left * _sigmoid_linear(x, left_gate_weight)
    right = right * _sigmoid_linear(x, right_gate_weight)
    out_gate = _sigmoid_linear(x, out_gate_weight)

    left_bh = left.permute(0, 3, 1, 2).contiguous().reshape(B * H, N, N)
    right_bh = right.permute(0, 3, 1, 2).contiguous().reshape(B * H, N, N)

    out = torch.bmm(left_bh, right_bh.transpose(1, 2))
    out = out.reshape(B, H, N, N).permute(0, 2, 3, 1).contiguous()

    out = F.layer_norm(out, (H,), to_out_norm_weight, to_out_norm_bias)

    gated = torch.empty_like(out, dtype=torch.float32)
    total = out.numel()
    block = 256
    grid = (triton.cdiv(total, block),)
    _gate_kernel[grid](out, out_gate, gated, total, BLOCK=block)

    result = torch.matmul(gated, to_out_weight.t())
    return result.to(torch.float32)
```

```python
"""
Forward-only outgoing Triangle Multiplicative Update.

The implementation uses PyTorch for the large dense projections, then Triton
fuses mask application and sigmoid gates while packing left/right activations
into [B * H, N, N]. The triangular contraction is executed as a batched GEMM,
and a second Triton kernel applies the hidden LayerNorm plus output gate before
the final PyTorch linear projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cudnn.allow_tf32 = True
    torch.set_float32_matmul_precision("high")
except Exception:
    pass


_PROJ_WEIGHT_CACHE = {}


@triton.jit
def _pack_gate_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    out_gate_ptr,
    M,
    N2: tl.constexpr,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid = (offs_m[:, None] < M) & (offs_h[None, :] < H)

    batch = offs_m // N2
    rem = offs_m - batch * N2

    proj_offsets = offs_m[:, None] * (5 * H) + offs_h[None, :]
    hmajor_offsets = (batch[:, None] * H + offs_h[None, :]) * N2 + rem[:, None]

    if HAS_MASK:
        m = tl.load(mask_ptr + offs_m, mask=offs_m < M, other=0.0).to(tl.float32)[:, None]
    else:
        m = 1.0

    lg = tl.load(proj_ptr + proj_offsets + 2 * H, mask=valid, other=0.0).to(tl.float32)
    lv = tl.load(proj_ptr + proj_offsets, mask=valid, other=0.0).to(tl.float32)
    lg = 1.0 / (1.0 + tl.exp(-lg))
    tl.store(left_ptr + hmajor_offsets, lv * lg * m, mask=valid)

    rg = tl.load(proj_ptr + proj_offsets + 3 * H, mask=valid, other=0.0).to(tl.float32)
    rv = tl.load(proj_ptr + proj_offsets + H, mask=valid, other=0.0).to(tl.float32)
    rg = 1.0 / (1.0 + tl.exp(-rg))
    tl.store(right_ptr + hmajor_offsets, rv * rg * m, mask=valid)

    og = tl.load(proj_ptr + proj_offsets + 4 * H, mask=valid, other=0.0).to(tl.float32)
    og = 1.0 / (1.0 + tl.exp(-og))
    tl.store(out_gate_ptr + offs_m[:, None] * H + offs_h[None, :], og, mask=valid)


@triton.jit
def _ln_gate_hmajor_kernel(
    prod_ptr,
    out_gate_ptr,
    weight_ptr,
    bias_ptr,
    out_ptr,
    M,
    N2: tl.constexpr,
    H: tl.constexpr,
    EPS: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)

    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    h = tl.arange(0, BLOCK_H)

    row_mask = rows < M
    h_mask = h < H
    mask = row_mask[:, None] & h_mask[None, :]

    batch = rows // N2
    rem = rows - batch * N2
    prod_offsets = (batch[:, None] * H + h[None, :]) * N2 + rem[:, None]

    x = tl.load(prod_ptr + prod_offsets, mask=mask, other=0.0).to(tl.float32)
    x_sum = tl.where(h_mask[None, :], x, 0.0)

    mean = tl.sum(x_sum, axis=1) / H
    centered = tl.where(h_mask[None, :], x - mean[:, None], 0.0)
    var = tl.sum(centered * centered, axis=1) / H
    inv_std = tl.rsqrt(var + EPS)

    w = tl.load(weight_ptr + h, mask=h_mask, other=0.0).to(tl.float32)
    b = tl.load(bias_ptr + h, mask=h_mask, other=0.0).to(tl.float32)
    gate = tl.load(out_gate_ptr + rows[:, None] * H + h[None, :], mask=mask, other=0.0).to(tl.float32)

    y = (centered * inv_std[:, None] * w[None, :] + b[None, :]) * gate
    tl.store(out_ptr + rows[:, None] * H + h[None, :], y, mask=mask)


def _f32_contig(t):
    if t.dtype != torch.float32:
        t = t.float()
    if not t.is_contiguous():
        t = t.contiguous()
    return t


def _projection_weight(weights):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    tensors = tuple(weights[name] for name in names)
    key = tuple(
        (
            int(t.data_ptr()),
            int(getattr(t, "_version", 0)),
            tuple(t.shape),
            tuple(t.stride()),
            str(t.dtype),
            t.device.type,
            t.device.index,
        )
        for t in tensors
    )

    cached = _PROJ_WEIGHT_CACHE.get(key)
    if cached is None:
        if len(_PROJ_WEIGHT_CACHE) > 12:
            _PROJ_WEIGHT_CACHE.clear()
        cached = torch.cat([_f32_contig(t) for t in tensors], dim=0).contiguous()
        _PROJ_WEIGHT_CACHE[key] = cached
    return cached


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    config = config or {}

    B, N, _, C = input_tensor.shape
    H = int(config.get("hidden_dim", weights["left_proj.weight"].shape[0]))
    M = B * N * N
    N2 = N * N
    eps = float(config.get("eps", config.get("layer_norm_eps", 1.0e-5)))

    with torch.no_grad():
        x = input_tensor if input_tensor.dtype == torch.float32 else input_tensor.float()

        norm_w = _f32_contig(weights["norm.weight"])
        norm_b = _f32_contig(weights["norm.bias"])
        x = F.layer_norm(x, (C,), norm_w, norm_b, eps).reshape(M, C)

        proj_w = _projection_weight(weights)
        proj = F.linear(x, proj_w)

        left = torch.empty((B * H, N, N), device=input_tensor.device, dtype=torch.float32)
        right = torch.empty_like(left)
        out_gate = torch.empty((M, H), device=input_tensor.device, dtype=torch.float32)

        has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
        mask_arg = mask.contiguous() if has_mask else proj

        block_m_pack = 16
        block_h_pack = 64
        _pack_gate_kernel[
            (triton.cdiv(M, block_m_pack), triton.cdiv(H, block_h_pack))
        ](
            proj,
            mask_arg,
            left,
            right,
            out_gate,
            M,
            N2,
            H,
            has_mask,
            BLOCK_M=block_m_pack,
            BLOCK_H=block_h_pack,
            num_warps=4,
        )

        prod = torch.bmm(left, right.transpose(1, 2))

        normed = torch.empty((M, H), device=input_tensor.device, dtype=torch.float32)
        ln_w = _f32_contig(weights["to_out_norm.weight"])
        ln_b = _f32_contig(weights["to_out_norm.bias"])
        block_m_ln = 8
        block_h_ln = triton.next_power_of_2(H)

        _ln_gate_hmajor_kernel[(triton.cdiv(M, block_m_ln),)](
            prod,
            out_gate,
            ln_w,
            ln_b,
            normed,
            M,
            N2,
            H,
            eps,
            BLOCK_M=block_m_ln,
            BLOCK_H=block_h_ln,
            num_warps=4,
        )

        to_out_w = _f32_contig(weights["to_out.weight"])
        out = F.linear(normed, to_out_w)
        return out.reshape(B, N, N, to_out_w.shape[0]).float()
```

```python
"""TriMul outgoing forward: fp32 input LayerNorm, one packed fp16 projection for left/right/gates,
Triton for sigmoid gating + optional mask + channel-major layout, batched GEMM for the N^3 contraction,
then Triton output LayerNorm/gate and fp16 output projection with fp32 return.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_PACKED_PROJ_CACHE = {}
_HALF_WEIGHT_CACHE = {}
_PROJ_NAMES = (
    "left_proj.weight",
    "right_proj.weight",
    "left_gate.weight",
    "right_gate.weight",
    "out_gate.weight",
)


def _tensor_key(t):
    return (
        t.data_ptr(),
        tuple(t.shape),
        tuple(t.stride()),
        str(t.dtype),
        t.device.type,
        t.device.index,
        getattr(t, "_version", 0),
    )


def _half_weight(w):
    if w.dtype == torch.float16 and w.is_contiguous():
        return w
    key = _tensor_key(w)
    hit = _HALF_WEIGHT_CACHE.get(key)
    if hit is not None:
        return hit[1]
    if len(_HALF_WEIGHT_CACHE) > 16:
        _HALF_WEIGHT_CACHE.clear()
    hw = w.to(torch.float16).contiguous()
    _HALF_WEIGHT_CACHE[key] = (w, hw)
    return hw


def _packed_proj_weight(weights):
    tensors = tuple(weights[name] for name in _PROJ_NAMES)
    key = tuple(_tensor_key(t) for t in tensors)
    hit = _PACKED_PROJ_CACHE.get(key)
    if hit is not None:
        return hit[1]
    if len(_PACKED_PROJ_CACHE) > 8:
        _PACKED_PROJ_CACHE.clear()

    parts = []
    for t in tensors:
        if t.dtype == torch.float16 and t.is_contiguous():
            parts.append(t)
        else:
            parts.append(t.to(torch.float16).contiguous())

    packed = torch.cat(parts, dim=0).contiguous()
    _PACKED_PROJ_CACHE[key] = (tensors, packed)
    return packed


@triton.jit
def _gate_transpose_packed_kernel(
    proj_p, mask_p, left_t, right_t,
    total: tl.constexpr,
    n: tl.constexpr,
    hdim: tl.constexpr,
    has_mask: tl.constexpr,
    BLOCK: tl.constexpr,
):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    valid = offs < total

    h = offs % hdim
    row = offs // hdim
    n2 = n * n
    b = row // n2
    row_in = row - b * n2

    base = row * (hdim * 5) + h

    lp = tl.load(proj_p + base, mask=valid, other=0.0).to(tl.float32)
    rp = tl.load(proj_p + base + hdim, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_p + base + hdim * 2, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_p + base + hdim * 3, mask=valid, other=0.0).to(tl.float32)

    lval = lp * (1.0 / (1.0 + tl.exp(-lg)))
    rval = rp * (1.0 / (1.0 + tl.exp(-rg)))

    if has_mask:
        m = tl.load(mask_p + row, mask=valid, other=0.0).to(tl.float32)
        lval *= m
        rval *= m

    dst = (b * hdim + h) * n2 + row_in
    tl.store(left_t + dst, lval, mask=valid)
    tl.store(right_t + dst, rval, mask=valid)


@triton.jit
def _post_ln_gate_packed_kernel(
    tri_p, proj_p, norm_w_p, norm_b_p, post_p,
    n: tl.constexpr,
    hdim: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    row = tl.program_id(0)
    hs = tl.arange(0, BLOCK_H)
    hmask = hs < hdim

    n2 = n * n
    b = row // n2
    rem = row - b * n2

    vals = tl.load(
        tri_p + (b * hdim + hs) * n2 + rem,
        mask=hmask,
        other=0.0,
    ).to(tl.float32)

    mean = tl.sum(vals, axis=0) / hdim
    centered = vals - mean
    var = tl.sum(centered * centered, axis=0) / hdim
    vals = centered * tl.rsqrt(var + eps)

    nw = tl.load(norm_w_p + hs, mask=hmask, other=0.0).to(tl.float32)
    nb = tl.load(norm_b_p + hs, mask=hmask, other=0.0).to(tl.float32)
    og = tl.load(
        proj_p + row * (hdim * 5) + hdim * 4 + hs,
        mask=hmask,
        other=0.0,
    ).to(tl.float32)

    gate = 1.0 / (1.0 + tl.exp(-og))
    out = (vals * nw + nb) * gate
    tl.store(post_p + row * hdim + hs, out, mask=hmask)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        bs, n, _, dim = input_tensor.shape
        hidden_dim = int(config.get("hidden_dim", weights["left_proj.weight"].shape[0]))
        eps = float(config.get("eps", config.get("layer_norm_eps", 1e-5)))
        rows = bs * n * n
        total = rows * hidden_dim

        x = F.layer_norm(
            input_tensor.float(),
            (dim,),
            weights["norm.weight"].contiguous().float(),
            weights["norm.bias"].contiguous().float(),
            eps,
        ).to(torch.float16)
        x2 = x.reshape(rows, dim)

        proj_w = _packed_proj_weight(weights)
        proj = F.linear(x2, proj_w)
        del x, x2

        left_t = torch.empty((bs * hidden_dim, n, n), device=input_tensor.device, dtype=torch.float16)
        right_t = torch.empty_like(left_t)

        has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
        mask_c = mask.contiguous() if has_mask else input_tensor

        _gate_transpose_packed_kernel[(triton.cdiv(total, 256),)](
            proj, mask_c, left_t, right_t,
            total, n, hidden_dim, has_mask,
            BLOCK=256,
            num_warps=4,
        )

        tri = torch.bmm(left_t, right_t.transpose(1, 2))
        del left_t, right_t

        post = torch.empty((rows, hidden_dim), device=input_tensor.device, dtype=torch.float16)
        _post_ln_gate_packed_kernel[(rows,)](
            tri, proj,
            weights["to_out_norm.weight"].contiguous(),
            weights["to_out_norm.bias"].contiguous(),
            post,
            n, hidden_dim, eps,
            BLOCK_H=triton.next_power_of_2(hidden_dim),
            num_warps=4,
        )
        del tri, proj

        out = F.linear(post, _half_weight(weights["to_out.weight"]))
        return out.reshape(bs, n, n, weights["to_out.weight"].shape[0]).float()
```

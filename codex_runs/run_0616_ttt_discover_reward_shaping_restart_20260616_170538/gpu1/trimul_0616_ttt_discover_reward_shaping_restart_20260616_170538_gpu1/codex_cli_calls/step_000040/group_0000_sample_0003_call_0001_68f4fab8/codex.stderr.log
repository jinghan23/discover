```python
"""Fused BF16 TriMul forward: BF16 layernorm/projection, Triton gate+transpose prep,
batched channel-wise GEMM for the outgoing triangle contraction, then a Triton
fused output layernorm, output gate, and final projection returning float32.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_WEIGHT_CACHE = {}


@triton.jit
def _prepare_lr_kernel(
    proj, mask, left, right,
    M: tl.constexpr, N2: tl.constexpr, H: tl.constexpr,
    USE_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_mask = rows < M
    h_mask = hs < H
    mask2 = row_mask[:, None] & h_mask[None, :]

    base = rows[:, None] * (5 * H) + hs[None, :]

    l = tl.load(proj + base, mask=mask2, other=0.0).to(tl.float32)
    r = tl.load(proj + base + H, mask=mask2, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=mask2, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=mask2, other=0.0).to(tl.float32)

    if USE_MASK:
        mv = tl.load(mask + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mv = tl.full((BLOCK_M,), 1.0, tl.float32)

    l = l * tl.sigmoid(lg) * mv[:, None]
    r = r * tl.sigmoid(rg) * mv[:, None]

    b = rows // N2
    p = rows - b * N2
    out_offs = b[:, None] * (H * N2) + hs[None, :] * N2 + p[:, None]

    tl.store(left + out_offs, l, mask=mask2)
    tl.store(right + out_offs, r, mask=mask2)


@triton.jit
def _final_norm_gate_proj_kernel(
    tri, proj, norm_w, norm_b, to_w, out,
    M: tl.constexpr, N2: tl.constexpr, D: tl.constexpr, H: tl.constexpr,
    EPS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_d = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
    hs = tl.arange(0, BLOCK_H)

    row_mask = rows < M
    d_mask = ds < D

    b = rows // N2
    p = rows - b * N2
    tri_offs = b[:, None] * (H * N2) + hs[None, :] * N2 + p[:, None]

    x = tl.load(tri + tri_offs, mask=row_mask[:, None], other=0.0).to(tl.float32)

    mean = tl.sum(x, axis=1) * (1.0 / BLOCK_H)
    xc = x - mean[:, None]
    var = tl.sum(xc * xc, axis=1) * (1.0 / BLOCK_H)
    xhat = xc * tl.rsqrt(var[:, None] + EPS)

    nw = tl.load(norm_w + hs).to(tl.float32)
    nb = tl.load(norm_b + hs).to(tl.float32)

    gate = tl.load(
        proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
        mask=row_mask[:, None],
        other=0.0,
    ).to(tl.float32)
    v = (xhat * nw[None, :] + nb[None, :]) * tl.sigmoid(gate)

    w = tl.load(
        to_w + ds[None, :] * H + hs[:, None],
        mask=d_mask[None, :],
        other=0.0,
    )

    acc = tl.dot(v.to(tl.bfloat16), w, out_dtype=tl.float32)
    tl.store(out + rows[:, None] * D + ds[None, :], acc, mask=row_mask[:, None] & d_mask[None, :])


def _cached_weights(weights, dim, hidden_dim):
    names = (
        "norm.weight", "norm.bias",
        "left_proj.weight", "right_proj.weight",
        "left_gate.weight", "right_gate.weight", "out_gate.weight",
        "to_out_norm.weight", "to_out_norm.bias", "to_out.weight",
    )
    key = tuple((weights[n].data_ptr(), tuple(weights[n].shape), getattr(weights[n], "_version", 0)) for n in names)

    cached = _WEIGHT_CACHE.get(key)
    if cached is not None:
        return cached

    proj_w = torch.cat(
        (
            weights["left_proj.weight"],
            weights["right_proj.weight"],
            weights["left_gate.weight"],
            weights["right_gate.weight"],
            weights["out_gate.weight"],
        ),
        dim=0,
    ).contiguous().to(torch.bfloat16)

    cached = (
        weights["norm.weight"].contiguous().to(torch.bfloat16),
        weights["norm.bias"].contiguous().to(torch.bfloat16),
        proj_w,
        weights["to_out_norm.weight"].contiguous(),
        weights["to_out_norm.bias"].contiguous(),
        weights["to_out.weight"].contiguous().to(torch.bfloat16),
    )
    _WEIGHT_CACHE[key] = cached
    return cached


def _torch_fallback(input_tensor, mask, weights, config):
    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])
    use_mask = mask is not None and not bool(config.get("nomask", False))

    x = F.layer_norm(input_tensor, (dim,), weights["norm.weight"], weights["norm.bias"], eps=1e-5)

    left = F.linear(x, weights["left_proj.weight"])
    right = F.linear(x, weights["right_proj.weight"])

    if use_mask:
        m = mask.unsqueeze(-1).to(left.dtype)
        left = left * m
        right = right * m

    left = left * torch.sigmoid(F.linear(x, weights["left_gate.weight"]))
    right = right * torch.sigmoid(F.linear(x, weights["right_gate.weight"]))
    out_gate = torch.sigmoid(F.linear(x, weights["out_gate.weight"]))

    out = torch.einsum("bikh,bjkh->bijh", left, right)
    out = F.layer_norm(out, (hidden_dim,), weights["to_out_norm.weight"], weights["to_out_norm.bias"], eps=1e-5)
    out = out * out_gate
    return F.linear(out, weights["to_out.weight"]).float()


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    B, N, _, dim = input_tensor.shape
    hidden_dim = int(config["hidden_dim"])

    if (not input_tensor.is_cuda) or hidden_dim != 128:
        return _torch_fallback(input_tensor, mask, weights, config)

    torch.backends.cuda.matmul.allow_tf32 = True

    H = hidden_dim
    N2 = N * N
    M = B * N2
    use_mask = mask is not None and not bool(config.get("nomask", False))

    norm_w, norm_b, proj_w, out_norm_w, out_norm_b, to_out_w = _cached_weights(weights, dim, H)

    x_bf16 = input_tensor if input_tensor.dtype is torch.bfloat16 else input_tensor.to(torch.bfloat16)
    x_norm = F.layer_norm(x_bf16, (dim,), norm_w, norm_b, eps=1e-5)
    proj = F.linear(x_norm, proj_w).contiguous()
    del x_bf16, x_norm

    left = torch.empty((B, H, N, N), device=input_tensor.device, dtype=torch.bfloat16)
    right = torch.empty_like(left)

    mask_arg = mask.contiguous() if use_mask else input_tensor
    _prepare_lr_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
        proj, mask_arg, left, right,
        M, N2, H, use_mask,
        BLOCK_M=16, BLOCK_H=64,
        num_warps=4,
    )

    tri = torch.bmm(
        left.reshape(B * H, N, N),
        right.reshape(B * H, N, N).transpose(1, 2),
    )
    del left, right

    out = torch.empty((B, N, N, dim), device=input_tensor.device, dtype=torch.float32)
    _final_norm_gate_proj_kernel[(triton.cdiv(M, 16), triton.cdiv(dim, 128))](
        tri, proj, out_norm_w, out_norm_b, to_out_w, out,
        M, N2, dim, H, 1e-5,
        BLOCK_M=16, BLOCK_D=128, BLOCK_H=128,
        num_warps=4,
        num_stages=3,
    )

    return out

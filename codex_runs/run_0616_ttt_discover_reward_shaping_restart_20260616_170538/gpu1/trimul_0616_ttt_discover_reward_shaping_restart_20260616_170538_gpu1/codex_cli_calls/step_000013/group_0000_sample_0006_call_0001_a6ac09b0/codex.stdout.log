```python
"""
TriMul outgoing forward: use PyTorch/cuBLAS for layer norm and linear projections,
fuse input gates and optional mask in Triton, compute the per-hidden outgoing
triangle product as batched GEMMs, then fuse output LayerNorm and output gate
in-place before the final cuBLAS projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


@triton.jit
def _gate_mask_kernel(
    left,
    right,
    left_gate,
    right_gate,
    mask,
    n_elem: tl.constexpr,
    H: tl.constexpr,
    has_mask: tl.constexpr,
    BLOCK: tl.constexpr,
):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    valid = offs < n_elem

    lv = tl.load(left + offs, mask=valid, other=0.0).to(tl.float32)
    rv = tl.load(right + offs, mask=valid, other=0.0).to(tl.float32)
    lgv = tl.load(left_gate + offs, mask=valid, other=0.0).to(tl.float32)
    rgv = tl.load(right_gate + offs, mask=valid, other=0.0).to(tl.float32)

    lgv = 1.0 / (1.0 + tl.exp(-lgv))
    rgv = 1.0 / (1.0 + tl.exp(-rgv))

    if has_mask:
        pair = offs // H
        mv = tl.load(mask + pair, mask=valid, other=0.0).to(tl.float32)
        lgv *= mv
        rgv *= mv

    tl.store(left + offs, lv * lgv, mask=valid)
    tl.store(right + offs, rv * rgv, mask=valid)


@triton.jit
def _out_norm_gate_inplace_kernel(
    tri,
    out_gate,
    norm_w,
    norm_b,
    M: tl.constexpr,
    H: tl.constexpr,
    EPS: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    offs_m = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, BLOCK_H)

    row_mask = offs_m < M
    h_mask = offs_h < H
    mask = row_mask[:, None] & h_mask[None, :]

    vals = tl.load(
        tri + offs_m[:, None] * H + offs_h[None, :],
        mask=mask,
        other=0.0,
    ).to(tl.float32)

    vals_for_sum = tl.where(h_mask[None, :], vals, 0.0)
    mean = tl.sum(vals_for_sum, axis=1) / H
    centered = tl.where(h_mask[None, :], vals - mean[:, None], 0.0)
    var = tl.sum(centered * centered, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    nw = tl.load(norm_w + offs_h, mask=h_mask, other=0.0).to(tl.float32)
    nb = tl.load(norm_b + offs_h, mask=h_mask, other=0.0).to(tl.float32)

    gate = tl.load(
        out_gate + offs_m[:, None] * H + offs_h[None, :],
        mask=mask,
        other=0.0,
    ).to(tl.float32)
    gate = 1.0 / (1.0 + tl.exp(-gate))

    out = (centered * inv[:, None]) * nw[None, :] + nb[None, :]
    out *= gate

    tl.store(tri + offs_m[:, None] * H + offs_h[None, :], out, mask=mask)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])

    x = input_tensor
    B, N, _, D = x.shape
    M = B * N * N
    H = hidden_dim

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    left_proj_weight = weights["left_proj.weight"]
    right_proj_weight = weights["right_proj.weight"]
    left_gate_weight = weights["left_gate.weight"]
    right_gate_weight = weights["right_gate.weight"]
    out_gate_weight = weights["out_gate.weight"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    x2 = x.reshape(M, D)
    xn = F.layer_norm(x2, (D,), norm_weight, norm_bias, eps=1e-5)

    left = F.linear(xn, left_proj_weight).contiguous()
    right = F.linear(xn, right_proj_weight).contiguous()
    left_gate = F.linear(xn, left_gate_weight).contiguous()
    right_gate = F.linear(xn, right_gate_weight).contiguous()
    out_gate = F.linear(xn, out_gate_weight).contiguous()

    n_elem = M * H
    has_mask = mask is not None and not bool(config.get("nomask", False))
    _gate_mask_kernel[(triton.cdiv(n_elem, 256),)](
        left,
        right,
        left_gate,
        right_gate,
        mask if mask is not None else left,
        n_elem,
        H,
        has_mask,
        BLOCK=256,
        num_warps=4,
    )

    left4 = left.view(B, N, N, H)
    right4 = right.view(B, N, N, H)

    a = left4.permute(0, 3, 1, 2).reshape(B * H, N, N)
    b = right4.permute(0, 3, 2, 1).reshape(B * H, N, N)
    tri = torch.bmm(a, b)

    tri = tri.view(B, H, N, N).permute(0, 2, 3, 1).contiguous().view(M, H)

    block_h = triton.next_power_of_2(H)
    _out_norm_gate_inplace_kernel[(triton.cdiv(M, 16),)](
        tri,
        out_gate,
        to_out_norm_weight,
        to_out_norm_bias,
        M,
        H,
        1e-5,
        BLOCK_M=16,
        BLOCK_H=block_h,
        num_warps=4,
    )

    out = F.linear(tri, to_out_weight).to(torch.float32)
    return out.view(B, N, N, dim)
```

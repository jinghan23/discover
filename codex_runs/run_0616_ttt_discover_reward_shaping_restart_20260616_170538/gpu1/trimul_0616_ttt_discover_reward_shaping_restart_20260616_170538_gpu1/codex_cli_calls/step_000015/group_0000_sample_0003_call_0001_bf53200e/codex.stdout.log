```python
"""
TriMul outgoing forward pass.

The implementation uses PyTorch/cuBLAS for the large dense GEMMs and Triton for the
layout-sensitive fused pieces: applying projection gates and optional mask while
packing left/right tensors for strided batched GEMM, then applying output-gate and
LayerNorm over the hidden dimension. The N^3 contraction is computed as 128
independent N x N batched matrix multiplications.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_FAST_MATH_SET = False


def _enable_fast_math():
    global _FAST_MATH_SET
    if not _FAST_MATH_SET:
        try:
            torch.backends.cuda.matmul.allow_tf32 = True
            torch.backends.cudnn.allow_tf32 = True
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _FAST_MATH_SET = True


def _key_tensor(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype), t.device.index, getattr(t, "_version", 0))


def _cat_proj_weight(weights, dtype):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    key = ("proj", dtype, tuple(_key_tensor(weights[n]) for n in names))
    w = _WEIGHT_CACHE.get(key)
    if w is None:
        parts = [weights[n].detach().to(dtype=dtype) for n in names]
        w = torch.cat(parts, dim=0).contiguous()
        _WEIGHT_CACHE[key] = w
    return w


@triton.jit
def _pack_left_right_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    total_elems: tl.constexpr,
    N,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK: tl.constexpr,
):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    valid = offs < total_elems

    row = offs // H
    h = offs - row * H
    proj_base = row * (5 * H) + h

    left = tl.load(proj_ptr + proj_base, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(proj_ptr + proj_base + H, mask=valid, other=0.0).to(tl.float32)

    lg = tl.load(proj_ptr + proj_base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_ptr + proj_base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    left = left * (1.0 / (1.0 + tl.exp(-lg)))
    right = right * (1.0 / (1.0 + tl.exp(-rg)))

    if HAS_MASK:
        m = tl.load(mask_ptr + row, mask=valid, other=0.0).to(tl.float32)
        left = left * m
        right = right * m

    n2 = N * N
    b = row // n2
    within = row - b * n2
    packed = (b * H + h) * n2 + within

    tl.store(left_ptr + packed, left, mask=valid)
    tl.store(right_ptr + packed, right, mask=valid)


@triton.jit
def _norm_gate_kernel(
    acc_ptr,
    proj_ptr,
    norm_w_ptr,
    norm_b_ptr,
    out_ptr,
    total_rows,
    N,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    EPS: tl.constexpr,
):
    rows = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    valid_rows = rows < total_rows

    n2 = N * N
    b = rows // n2
    within = rows - b * n2

    acc_offsets = (b[:, None] * H + hs[None, :]) * n2 + within[:, None]
    vals = tl.load(acc_ptr + acc_offsets, mask=valid_rows[:, None], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) * (1.0 / BLOCK_H)
    diff = vals - mean[:, None]
    var = tl.sum(diff * diff, axis=1) * (1.0 / BLOCK_H)
    rstd = tl.rsqrt(var + EPS)

    nw = tl.load(norm_w_ptr + hs).to(tl.float32)
    nb = tl.load(norm_b_ptr + hs).to(tl.float32)

    gate_logits = tl.load(
        proj_ptr + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
        mask=valid_rows[:, None],
        other=0.0,
    ).to(tl.float32)
    gate = 1.0 / (1.0 + tl.exp(-gate_logits))

    y = (diff * rstd[:, None] * nw[None, :] + nb[None, :]) * gate
    tl.store(out_ptr + rows[:, None] * H + hs[None, :], y, mask=valid_rows[:, None])


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    _enable_fast_math()

    bs, seq_len, _, dim = input_tensor.shape
    hidden_dim = config["hidden_dim"]
    eps = float(config.get("eps", 1e-5))

    with torch.no_grad():
        x = input_tensor if input_tensor.dtype is torch.float32 else input_tensor.float()

        x_norm = F.layer_norm(
            x,
            (dim,),
            weights["norm.weight"].float(),
            weights["norm.bias"].float(),
            eps,
        )

        proj_dtype = torch.float16
        x_proj = x_norm.to(proj_dtype)
        proj_w = _cat_proj_weight(weights, proj_dtype)
        proj = F.linear(x_proj, proj_w)
        del x_norm, x_proj

        total_rows = bs * seq_len * seq_len
        total_elems = total_rows * hidden_dim

        left = torch.empty((bs * hidden_dim, seq_len, seq_len), device=input_tensor.device, dtype=proj_dtype)
        right = torch.empty_like(left)

        has_mask = mask is not None and not bool(config.get("nomask", False))
        mask_arg = mask.contiguous() if has_mask else input_tensor

        _pack_left_right_kernel[(triton.cdiv(total_elems, 256),)](
            proj,
            mask_arg,
            left,
            right,
            total_elems,
            seq_len,
            hidden_dim,
            HAS_MASK=has_mask,
            BLOCK=256,
            num_warps=4,
        )

        tri = torch.bmm(left, right.transpose(1, 2))
        del left, right

        hidden = torch.empty((total_rows, hidden_dim), device=input_tensor.device, dtype=torch.float32)
        _norm_gate_kernel[(triton.cdiv(total_rows, 8),)](
            tri,
            proj,
            weights["to_out_norm.weight"].contiguous(),
            weights["to_out_norm.bias"].contiguous(),
            hidden,
            total_rows,
            seq_len,
            hidden_dim,
            BLOCK_M=8,
            BLOCK_H=128,
            EPS=eps,
            num_warps=4,
        )
        del tri, proj

        to_out_weight = weights["to_out.weight"]
        if to_out_weight.dtype is not torch.float32:
            to_out_weight = to_out_weight.float()

        out = F.linear(hidden, to_out_weight).view(bs, seq_len, seq_len, dim)
        return out.float()
```

```python
"""
Fused outgoing Triangle Multiplicative Update forward pass.

The implementation fuses the input LayerNorm with all five input projections
(left/right activations and left/right/out gates), applies mask and gates before
the cubic contraction, uses batched GEMM for the outgoing triangle product, then
fuses hidden LayerNorm, output gate, and the final projection. The final result
is returned as float32.
"""

import torch
import triton
import triton.language as tl


@triton.jit
def _norm_proj_kernel(
    x, mask, nw, nb,
    lw, rw, lgw, rgw, ogw,
    left, right, out_gate,
    D: tl.constexpr,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_D: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    hid_block = tl.program_id(1)

    offs_d = tl.arange(0, BLOCK_D)
    mask_d = offs_d < D

    vals = tl.load(x + pid * D + offs_d, mask=mask_d, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / D
    centered = tl.where(mask_d, vals - mean, 0.0)
    var = tl.sum(centered * centered, axis=0) / D
    inv_std = tl.rsqrt(var + 1.0e-5)

    gamma = tl.load(nw + offs_d, mask=mask_d, other=0.0).to(tl.float32)
    beta = tl.load(nb + offs_d, mask=mask_d, other=0.0).to(tl.float32)
    xn = tl.where(mask_d, (vals - mean) * inv_std * gamma + beta, 0.0)

    offs_h = hid_block * BLOCK_H + tl.arange(0, BLOCK_H)
    mask_h = offs_h < H
    woffs = offs_h[:, None] * D + offs_d[None, :]
    wmask = mask_h[:, None] & mask_d[None, :]

    l = tl.sum(xn[None, :] * tl.load(lw + woffs, mask=wmask, other=0.0), axis=1)
    r = tl.sum(xn[None, :] * tl.load(rw + woffs, mask=wmask, other=0.0), axis=1)
    lg = tl.sum(xn[None, :] * tl.load(lgw + woffs, mask=wmask, other=0.0), axis=1)
    rg = tl.sum(xn[None, :] * tl.load(rgw + woffs, mask=wmask, other=0.0), axis=1)
    og = tl.sum(xn[None, :] * tl.load(ogw + woffs, mask=wmask, other=0.0), axis=1)

    lg = 1.0 / (1.0 + tl.exp(-lg))
    rg = 1.0 / (1.0 + tl.exp(-rg))
    og = 1.0 / (1.0 + tl.exp(-og))

    m = tl.full((BLOCK_H,), 1.0, tl.float32)
    if HAS_MASK:
        mv = tl.load(mask + pid).to(tl.float32)
        m = mv + tl.zeros((BLOCK_H,), tl.float32)

    out_offs = pid * H + offs_h
    tl.store(left + out_offs, (l * lg * m).to(tl.float32), mask=mask_h)
    tl.store(right + out_offs, (r * rg * m).to(tl.float32), mask=mask_h)
    tl.store(out_gate + out_offs, og.to(tl.float32), mask=mask_h)


@triton.jit
def _out_norm_proj_kernel(
    tri, out_gate, nw, nb, ow, y,
    D: tl.constexpr,
    H: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    d_block = tl.program_id(1)

    offs_h = tl.arange(0, BLOCK_H)
    mask_h = offs_h < H

    v = tl.load(tri + pid * H + offs_h, mask=mask_h, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) / H
    centered = tl.where(mask_h, v - mean, 0.0)
    var = tl.sum(centered * centered, axis=0) / H
    inv_std = tl.rsqrt(var + 1.0e-5)

    gamma = tl.load(nw + offs_h, mask=mask_h, other=0.0).to(tl.float32)
    beta = tl.load(nb + offs_h, mask=mask_h, other=0.0).to(tl.float32)
    gate = tl.load(out_gate + pid * H + offs_h, mask=mask_h, other=0.0).to(tl.float32)

    z = tl.where(mask_h, ((v - mean) * inv_std * gamma + beta) * gate, 0.0)

    offs_d = d_block * BLOCK_D + tl.arange(0, BLOCK_D)
    mask_d = offs_d < D

    w = tl.load(
        ow + offs_d[:, None] * H + offs_h[None, :],
        mask=mask_d[:, None] & mask_h[None, :],
        other=0.0,
    ).to(tl.float32)

    acc = tl.sum(w * z[None, :], axis=1)
    tl.store(y + pid * D + offs_d, acc, mask=mask_d)


def _ceil_pow2(x):
    return 1 << ((int(x) - 1).bit_length())


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])

    x = input_tensor.contiguous()
    bs, n, _, _ = x.shape
    total = bs * n * n

    norm_weight = weights["norm.weight"].contiguous()
    norm_bias = weights["norm.bias"].contiguous()
    left_proj_weight = weights["left_proj.weight"].contiguous()
    right_proj_weight = weights["right_proj.weight"].contiguous()
    left_gate_weight = weights["left_gate.weight"].contiguous()
    right_gate_weight = weights["right_gate.weight"].contiguous()
    out_gate_weight = weights["out_gate.weight"].contiguous()
    to_out_norm_weight = weights["to_out_norm.weight"].contiguous()
    to_out_norm_bias = weights["to_out_norm.bias"].contiguous()
    to_out_weight = weights["to_out.weight"].contiguous()

    left = torch.empty((total, hidden_dim), device=x.device, dtype=torch.float32)
    right = torch.empty((total, hidden_dim), device=x.device, dtype=torch.float32)
    out_gate = torch.empty((total, hidden_dim), device=x.device, dtype=torch.float32)

    has_mask = mask is not None
    if has_mask:
        mask_flat = mask.contiguous().view(total)
    else:
        mask_flat = x.new_empty((1,), dtype=torch.float32)

    block_d = _ceil_pow2(dim)
    block_h = 16

    _norm_proj_kernel[(total, triton.cdiv(hidden_dim, block_h))](
        x, mask_flat,
        norm_weight, norm_bias,
        left_proj_weight, right_proj_weight,
        left_gate_weight, right_gate_weight, out_gate_weight,
        left, right, out_gate,
        dim, hidden_dim, has_mask,
        BLOCK_D=block_d,
        BLOCK_H=block_h,
        num_warps=8,
    )

    left4 = left.view(bs, n, n, hidden_dim).permute(0, 3, 1, 2).contiguous()
    right4 = right.view(bs, n, n, hidden_dim).permute(0, 3, 1, 2).contiguous()

    tri = torch.bmm(
        left4.reshape(bs * hidden_dim, n, n),
        right4.reshape(bs * hidden_dim, n, n).transpose(1, 2),
    )
    tri = tri.reshape(bs, hidden_dim, n, n).permute(0, 2, 3, 1).contiguous()

    y = torch.empty((total, dim), device=x.device, dtype=torch.float32)
    block_out_d = 16 if dim >= 384 else 32

    _out_norm_proj_kernel[(total, triton.cdiv(dim, block_out_d))](
        tri, out_gate,
        to_out_norm_weight, to_out_norm_bias, to_out_weight,
        y,
        dim, hidden_dim,
        BLOCK_H=_ceil_pow2(hidden_dim),
        BLOCK_D=block_out_d,
        num_warps=4,
    )

    return y.view(bs, n, n, dim)
```

@triton.jit
def _out_norm_proj_kernel(
    tri, out_gate, nw, nb, ow, y,
    total_rows: tl.constexpr,
    D: tl.constexpr,
    H: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_D: tl.constexpr,
):

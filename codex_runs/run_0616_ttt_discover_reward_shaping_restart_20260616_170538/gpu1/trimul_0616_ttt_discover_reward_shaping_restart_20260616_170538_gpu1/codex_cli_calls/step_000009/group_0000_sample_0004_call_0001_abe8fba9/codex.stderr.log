import triton
import triton.language as tl


@triton.jit
def _norm_proj_kernel(
    x, mask, nw, nb,
    lw, rw, lgw, rgw, ogw,
    left, right, out_gate,
    total_rows: tl.constexpr,
    D: tl.constexpr,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_D: tl.constexpr,
    BLOCK_H: tl.constexpr,

"""
TriMul outgoing forward pass.

Algorithm:
1. Use PyTorch fused LayerNorm/linear pointwise ops for the input projections and gates.
2. Use a Triton kernel for the N^3 outgoing triangular multiplication:
   out[b, i, j, h] = sum_k left[b, i, k, h] * right[b, j, k, h].
   The kernel computes one hidden channel and a BLOCK_M x BLOCK_N tile at a time.
3. Apply output LayerNorm, output gate, and final projection, returning float32.
"""

import torch
import triton
import triton.language as tl
import torch.nn.functional as F


@triton.jit
def _trimul_outgoing_kernel(
    left,
    right,
    out,
    total_tiles: tl.constexpr,
    N: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
    BLOCK_K: tl.constexpr,
):
    pid = tl.program_id(0)

    num_m = tl.cdiv(N, BLOCK_M)
    num_n = tl.cdiv(N, BLOCK_N)
    tiles_per_bh = num_m * num_n

    bh = pid // tiles_per_bh
    tile = pid - bh * tiles_per_bh

    pid_m = tile // num_n
    pid_n = tile - pid_m * num_n

    b = bh // H
    h = bh - b * H

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
    offs_k = tl.arange(0, BLOCK_K)

    acc = tl.zeros((BLOCK_M, BLOCK_N), tl.float32)

    base = ((b * N * N) + h)
    for k0 in range(0, N, BLOCK_K):
        k = k0 + offs_k

        l_ptrs = left + base + (offs_m[:, None] * N + k[None, :]) * H
        r_ptrs = right + base + (offs_n[None, :] * N + k[:, None]) * H

        l = tl.load(l_ptrs, mask=(offs_m[:, None] < N) & (k[None, :] < N), other=0.0)
        r = tl.load(r_ptrs, mask=(offs_n[None, :] < N) & (k[:, None] < N), other=0.0)

        acc += tl.dot(l, r, input_precision="tf32")

    o_ptrs = out + base + (offs_m[:, None] * N + offs_n[None, :]) * H
    tl.store(o_ptrs, acc, mask=(offs_m[:, None] < N) & (offs_n[None, :] < N))


def _linear(x, w):
    return F.linear(x, w, None)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])

    x = input_tensor.contiguous()
    B, N, _, _ = x.shape

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    left_proj_weight = weights["left_proj.weight"]
    right_proj_weight = weights["right_proj.weight"]
    left_gate_weight = weights["left_gate.weight"]
    right_gate_weight = weights["right_gate.weight"]
    out_gate_weight = weights["out_gate.weight"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    x_norm = F.layer_norm(x, (dim,), norm_weight, norm_bias, 1e-5)

    left = _linear(x_norm, left_proj_weight)
    right = _linear(x_norm, right_proj_weight)

    if mask is not None:
        m = mask.to(dtype=left.dtype).unsqueeze(-1)
        left = left * m
        right = right * m

    left_gate = torch.sigmoid(_linear(x_norm, left_gate_weight))
    right_gate = torch.sigmoid(_linear(x_norm, right_gate_weight))
    out_gate = torch.sigmoid(_linear(x_norm, out_gate_weight))

    left = (left * left_gate).contiguous()
    right = (right * right_gate).contiguous()

    tri = torch.empty((B, N, N, hidden_dim), device=x.device, dtype=torch.float32)

    block_m = 16
    block_n = 16
    block_k = 64

    grid = (B * hidden_dim * triton.cdiv(N, block_m) * triton.cdiv(N, block_n),)
    _trimul_outgoing_kernel[grid](
        left,
        right,
        tri,
        grid[0],
        N,
        hidden_dim,
        BLOCK_M=block_m,
        BLOCK_N=block_n,
        BLOCK_K=block_k,
        num_warps=4,
        num_stages=3,
    )

    tri = F.layer_norm(
        tri,
        (hidden_dim,),
        to_out_norm_weight,
        to_out_norm_bias,
        1e-5,
    )
    tri = tri * out_gate.to(tri.dtype)
    out = _linear(tri, to_out_weight)

    return out.float()
```

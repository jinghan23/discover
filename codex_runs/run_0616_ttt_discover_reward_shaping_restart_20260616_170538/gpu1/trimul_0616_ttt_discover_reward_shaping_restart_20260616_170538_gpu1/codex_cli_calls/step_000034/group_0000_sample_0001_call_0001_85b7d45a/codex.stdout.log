```python
"""
Outgoing Triangle Multiplicative Update.

The implementation keeps the expensive parts on tensor-core paths: input LayerNorm is
handled by PyTorch, the five input projections are fused into one GEMM, a Triton kernel
packs gated left/right activations directly into the batched-matmul layout, the outgoing
triangle contraction is evaluated with batched GEMM, and a second Triton kernel fuses the
hidden LayerNorm with the output gate before the final projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_WEIGHT_CACHE = {}


@triton.jit
def _pack_proj_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    gate_ptr,
    TOTAL: tl.constexpr,
    H: tl.constexpr,
    USE_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_b = tl.program_id(1)

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, H)
    valid = offs_m[None, :] < TOTAL

    row = pid_b * TOTAL + offs_m[None, :]
    base = row * (5 * H) + offs_h[:, None]

    v = tl.load(proj_ptr + base, mask=valid, other=0.0).to(tl.float32)
    g = tl.load(proj_ptr + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    v = v * tl.sigmoid(g)

    if USE_MASK:
        m = tl.load(mask_ptr + pid_b * TOTAL + offs_m, mask=offs_m < TOTAL, other=0.0).to(tl.float32)
        v = v * m[None, :]

    bh_ptrs = (pid_b * H + offs_h[:, None]) * TOTAL + offs_m[None, :]
    tl.store(left_ptr + bh_ptrs, v, mask=valid)

    v = tl.load(proj_ptr + base + H, mask=valid, other=0.0).to(tl.float32)
    g = tl.load(proj_ptr + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
    v = v * tl.sigmoid(g)

    if USE_MASK:
        m = tl.load(mask_ptr + pid_b * TOTAL + offs_m, mask=offs_m < TOTAL, other=0.0).to(tl.float32)
        v = v * m[None, :]

    tl.store(right_ptr + bh_ptrs, v, mask=valid)

    g = tl.load(proj_ptr + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
    gate_ptrs = (pid_b * TOTAL + offs_m[None, :]) * H + offs_h[:, None]
    tl.store(gate_ptr + gate_ptrs, tl.sigmoid(g), mask=valid)


@triton.jit
def _out_norm_gate_kernel(
    tri_ptr,
    gate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    z_ptr,
    TOTAL: tl.constexpr,
    H: tl.constexpr,
    EPS: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_b = tl.program_id(1)

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, H)
    mask_m = offs_m < TOTAL

    tri = tl.load(
        tri_ptr + pid_b * H * TOTAL + offs_h[None, :] * TOTAL + offs_m[:, None],
        mask=mask_m[:, None],
        other=0.0,
    ).to(tl.float32)

    mean = tl.sum(tri, axis=1) * (1.0 / H)
    centered = tri - mean[:, None]
    var = tl.sum(centered * centered, axis=1) * (1.0 / H)
    rstd = tl.rsqrt(var + EPS)

    nw = tl.load(norm_w_ptr + offs_h).to(tl.float32)
    nb = tl.load(norm_b_ptr + offs_h).to(tl.float32)
    gate = tl.load(
        gate_ptr + (pid_b * TOTAL + offs_m[:, None]) * H + offs_h[None, :],
        mask=mask_m[:, None],
        other=0.0,
    ).to(tl.float32)

    z = (centered * rstd[:, None] * nw[None, :] + nb[None, :]) * gate

    tl.store(
        z_ptr + (pid_b * TOTAL + offs_m[:, None]) * H + offs_h[None, :],
        z,
        mask=mask_m[:, None],
    )


def _tensor_key(t):
    return (
        int(t.data_ptr()),
        tuple(t.shape),
        tuple(t.stride()),
        str(t.dtype),
        str(t.device),
        int(getattr(t, "_version", 0)),
    )


def _cached_proj_weight_t(weights, dtype):
    tensors = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    key = ("proj", dtype, tuple(_tensor_key(t) for t in tensors))
    cached = _WEIGHT_CACHE.get(key)
    if cached is None:
        w = torch.cat(tensors, dim=0).to(dtype=dtype).t().contiguous()
        _WEIGHT_CACHE[key] = (w, tensors)
        return w
    return cached[0]


def _cached_to_out_weight_t(weights, dtype):
    t = weights["to_out.weight"]
    key = ("to_out", dtype, _tensor_key(t))
    cached = _WEIGHT_CACHE.get(key)
    if cached is None:
        w = t.to(dtype=dtype).t().contiguous()
        _WEIGHT_CACHE[key] = (w, (t,))
        return w
    return cached[0]


def _bmm_accum_fp32(a, b):
    try:
        return torch.bmm(a, b, out_dtype=torch.float32)
    except TypeError:
        return torch.bmm(a, b).to(torch.float32)


def _mm_accum_fp32(a, b):
    try:
        return torch.mm(a, b, out_dtype=torch.float32)
    except TypeError:
        return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True

        x = input_tensor
        B, N, _, D = x.shape
        H = int(config["hidden_dim"])
        total = N * N
        rows = B * total
        eps = float(config.get("eps", config.get("layer_norm_eps", 1.0e-5)))
        work_dtype = torch.float16

        x_norm = F.layer_norm(
            x,
            (D,),
            weights["norm.weight"],
            weights["norm.bias"],
            eps=eps,
        )

        xh = x_norm.reshape(rows, D).to(dtype=work_dtype)
        proj_w_t = _cached_proj_weight_t(weights, work_dtype)
        proj = torch.mm(xh, proj_w_t)
        del x_norm, xh

        left_bh = torch.empty((B * H, N, N), device=x.device, dtype=work_dtype)
        right_bh = torch.empty((B * H, N, N), device=x.device, dtype=work_dtype)
        out_gate = torch.empty((B, N, N, H), device=x.device, dtype=work_dtype)

        use_mask = mask is not None and not bool(config.get("nomask", False))
        mask_ptr = mask.contiguous() if use_mask else x

        pack_block = 16
        _pack_proj_kernel[(triton.cdiv(total, pack_block), B)](
            proj,
            mask_ptr,
            left_bh,
            right_bh,
            out_gate,
            total,
            H,
            USE_MASK=use_mask,
            BLOCK_M=pack_block,
            num_warps=4,
        )
        del proj

        tri = _bmm_accum_fp32(left_bh, right_bh.transpose(1, 2))
        del left_bh, right_bh

        z = torch.empty((B, N, N, H), device=x.device, dtype=work_dtype)
        norm_block = 16

        _out_norm_gate_kernel[(triton.cdiv(total, norm_block), B)](
            tri,
            out_gate,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            z,
            total,
            H,
            eps,
            BLOCK_M=norm_block,
            num_warps=4,
        )
        del tri, out_gate

        to_out_w_t = _cached_to_out_weight_t(weights, work_dtype)
        out = _mm_accum_fp32(z.view(rows, H), to_out_w_t)
        return out.view(B, N, N, D).to(torch.float32)
```

```python
"""
TriMul outgoing forward pass.

Algorithm:
1. Fuse input LayerNorm with the five dim->hidden_dim linear projections in one Triton kernel.
2. Materialize left/right activations after sigmoid gates and optional mask, plus output gate.
3. Compute the outgoing triangle product as hidden_dim independent batched GEMMs:
   out[b, h] = left[b, h] @ right[b, h].T
4. Apply LayerNorm over hidden_dim in Triton, multiply by output gate, and project back to dim.

The expensive N^3 contraction is delegated to cuBLAS via torch.bmm, which is the fastest
available path on SM80 for these shapes, while Triton handles the fused pointwise/projection
stages and satisfies the custom kernel requirement.
"""

import torch
import triton
import triton.language as tl


@triton.jit
def _sigmoid(x):
    return 1.0 / (1.0 + tl.exp(-x))


@triton.jit
def _proj5_kernel(
    x_ptr,
    mask_ptr,
    norm_w_ptr,
    norm_b_ptr,
    lp_w_ptr,
    rp_w_ptr,
    lg_w_ptr,
    rg_w_ptr,
    og_w_ptr,
    left_ptr,
    right_ptr,
    out_gate_ptr,
    M: tl.constexpr,
    D: tl.constexpr,
    H: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_D: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    offs_d = tl.arange(0, BLOCK_D)
    dmask = offs_d < D

    x = tl.load(x_ptr + pid_m * D + offs_d, mask=dmask, other=0.0).to(tl.float32)

    mean = tl.sum(x, axis=0) / D
    xc = tl.where(dmask, x - mean, 0.0)
    var = tl.sum(xc * xc, axis=0) / D
    rstd = tl.rsqrt(var + 1.0e-5)

    nw = tl.load(norm_w_ptr + offs_d, mask=dmask, other=0.0).to(tl.float32)
    nb = tl.load(norm_b_ptr + offs_d, mask=dmask, other=0.0).to(tl.float32)
    xn = tl.where(dmask, xc * rstd * nw + nb, 0.0)

    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    hmask = offs_h < H

    w_ptrs = offs_h[:, None] * D + offs_d[None, :]

    lp_w = tl.load(lp_w_ptr + w_ptrs, mask=hmask[:, None] & dmask[None, :], other=0.0).to(tl.float32)
    rp_w = tl.load(rp_w_ptr + w_ptrs, mask=hmask[:, None] & dmask[None, :], other=0.0).to(tl.float32)
    lg_w = tl.load(lg_w_ptr + w_ptrs, mask=hmask[:, None] & dmask[None, :], other=0.0).to(tl.float32)
    rg_w = tl.load(rg_w_ptr + w_ptrs, mask=hmask[:, None] & dmask[None, :], other=0.0).to(tl.float32)
    og_w = tl.load(og_w_ptr + w_ptrs, mask=hmask[:, None] & dmask[None, :], other=0.0).to(tl.float32)

    lp = tl.sum(lp_w * xn[None, :], axis=1)
    rp = tl.sum(rp_w * xn[None, :], axis=1)
    lg = tl.sum(lg_w * xn[None, :], axis=1)
    rg = tl.sum(rg_w * xn[None, :], axis=1)
    og = tl.sum(og_w * xn[None, :], axis=1)

    mval = 1.0
    if HAS_MASK:
        mval = tl.load(mask_ptr + pid_m).to(tl.float32)

    out_offs = pid_m * H + offs_h
    tl.store(left_ptr + out_offs, (lp * _sigmoid(lg) * mval).to(tl.float32), mask=hmask)
    tl.store(right_ptr + out_offs, (rp * _sigmoid(rg) * mval).to(tl.float32), mask=hmask)
    tl.store(out_gate_ptr + out_offs, _sigmoid(og).to(tl.float32), mask=hmask)


@triton.jit
def _norm_gate_kernel(
    tri_ptr,
    out_gate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    y_ptr,
    M: tl.constexpr,
    H: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    offs = tl.arange(0, BLOCK_H)
    mask = offs < H

    v = tl.load(tri_ptr + pid * H + offs, mask=mask, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) / H
    vc = tl.where(mask, v - mean, 0.0)
    var = tl.sum(vc * vc, axis=0) / H
    rstd = tl.rsqrt(var + 1.0e-5)

    w = tl.load(norm_w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
    b = tl.load(norm_b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
    g = tl.load(out_gate_ptr + pid * H + offs, mask=mask, other=0.0).to(tl.float32)

    y = (vc * rstd * w + b) * g
    tl.store(y_ptr + pid * H + offs, y, mask=mask)


def _maybe_contiguous(x):
    return x if x.is_contiguous() else x.contiguous()


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    x = _maybe_contiguous(input_tensor)
    B, N, _, D = x.shape
    H = int(config["hidden_dim"])
    M = B * N * N

    norm_weight = _maybe_contiguous(weights["norm.weight"])
    norm_bias = _maybe_contiguous(weights["norm.bias"])
    left_proj_weight = _maybe_contiguous(weights["left_proj.weight"])
    right_proj_weight = _maybe_contiguous(weights["right_proj.weight"])
    left_gate_weight = _maybe_contiguous(weights["left_gate.weight"])
    right_gate_weight = _maybe_contiguous(weights["right_gate.weight"])
    out_gate_weight = _maybe_contiguous(weights["out_gate.weight"])
    to_out_norm_weight = _maybe_contiguous(weights["to_out_norm.weight"])
    to_out_norm_bias = _maybe_contiguous(weights["to_out_norm.bias"])
    to_out_weight = _maybe_contiguous(weights["to_out.weight"])

    has_mask = mask is not None and not bool(config.get("nomask", False))
    mask_flat = _maybe_contiguous(mask).reshape(M) if has_mask else x.new_empty((1,))

    left = torch.empty((M, H), device=x.device, dtype=torch.float32)
    right = torch.empty((M, H), device=x.device, dtype=torch.float32)
    out_gate = torch.empty((M, H), device=x.device, dtype=torch.float32)

    block_d = triton.next_power_of_2(D)
    block_h = 16

    _proj5_kernel[(M, triton.cdiv(H, block_h))](
        x,
        mask_flat,
        norm_weight,
        norm_bias,
        left_proj_weight,
        right_proj_weight,
        left_gate_weight,
        right_gate_weight,
        out_gate_weight,
        left,
        right,
        out_gate,
        M,
        D,
        H,
        has_mask,
        block_d,
        block_h,
        num_warps=4,
    )

    left_bhnn = left.view(B, N, N, H).permute(0, 3, 1, 2).reshape(B * H, N, N)
    right_bhnn = right.view(B, N, N, H).permute(0, 3, 1, 2).reshape(B * H, N, N)

    tri = torch.bmm(left_bhnn, right_bhnn.transpose(1, 2))
    tri = tri.view(B, H, N, N).permute(0, 2, 3, 1).contiguous().view(M, H)

    gated = torch.empty((M, H), device=x.device, dtype=torch.float32)
    _norm_gate_kernel[(M,)](
        tri,
        out_gate,
        to_out_norm_weight,
        to_out_norm_bias,
        gated,
        M,
        H,
        triton.next_power_of_2(H),
        num_warps=4,
    )

    out = torch.matmul(gated, to_out_weight.t())
    return out.view(B, N, N, D).to(torch.float32)

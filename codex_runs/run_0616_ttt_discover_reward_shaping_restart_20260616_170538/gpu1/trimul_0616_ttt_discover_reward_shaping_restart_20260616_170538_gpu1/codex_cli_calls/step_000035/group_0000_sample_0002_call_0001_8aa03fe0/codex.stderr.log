"""
TriMul outgoing forward: use PyTorch/cuBLAS for the large dense projections and
batched channel-wise matrix products, with Triton kernels for fused gating/layout
conversion and fused output LayerNorm/out-gate preparation.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


_PROJ_CACHE = {}
_TF32_SET = False


@triton.jit
def _gate_and_layout_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    gate_ptr,
    total_p: tl.constexpr,
    nn: tl.constexpr,
    hidden: tl.constexpr,
    has_mask: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid_h = tl.program_id(0)
    pid_m = tl.program_id(1)

    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    offs_p = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)

    h = offs_h[:, None]
    p = offs_p[None, :]
    valid = (offs_h[:, None] < hidden) & (offs_p[None, :] < total_p)

    base = p * (5 * hidden) + h

    l = tl.load(proj_ptr + base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj_ptr + base + hidden, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_ptr + base + 2 * hidden, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_ptr + base + 3 * hidden, mask=valid, other=0.0).to(tl.float32)
    og = tl.load(proj_ptr + base + 4 * hidden, mask=valid, other=0.0).to(tl.float32)

    l = l * (1.0 / (1.0 + tl.exp(-lg)))
    r = r * (1.0 / (1.0 + tl.exp(-rg)))
    og = 1.0 / (1.0 + tl.exp(-og))

    if has_mask:
        m = tl.load(mask_ptr + offs_p, mask=offs_p < total_p, other=0.0).to(tl.float32)
        l = l * m[None, :]
        r = r * m[None, :]

    b = offs_p // nn
    rem = offs_p - b * nn
    out_offs = b[None, :] * hidden * nn + h * nn + rem[None, :]

    tl.store(left_ptr + out_offs, l, mask=valid)
    tl.store(right_ptr + out_offs, r, mask=valid)
    tl.store(gate_ptr + out_offs, og, mask=valid)


@triton.jit
def _out_norm_gate_kernel(
    tri_ptr,
    gate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    z_ptr,
    total_p: tl.constexpr,
    nn: tl.constexpr,
    hidden: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid = tl.program_id(0)

    offs_h = tl.arange(0, BLOCK_H)
    offs_p = pid * BLOCK_M + tl.arange(0, BLOCK_M)

    h = offs_h[:, None]
    p = offs_p[None, :]
    valid = (offs_h[:, None] < hidden) & (offs_p[None, :] < total_p)

    b = offs_p // nn
    rem = offs_p - b * nn
    tri_offs = b[None, :] * hidden * nn + h * nn + rem[None, :]

    v = tl.load(tri_ptr + tri_offs, mask=valid, other=0.0).to(tl.float32)

    mean = tl.sum(v, axis=0) / hidden
    centered = v - mean[None, :]
    var = tl.sum(centered * centered, axis=0) / hidden
    y = centered * tl.rsqrt(var[None, :] + eps)

    nw = tl.load(norm_w_ptr + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    nb = tl.load(norm_b_ptr + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    g = tl.load(gate_ptr + tri_offs, mask=valid, other=0.0).to(tl.float32)

    y = (y * nw[:, None] + nb[:, None]) * g
    z_offs = p * hidden + h
    tl.store(z_ptr + z_offs, y, mask=valid)


def _proj_weight(weights):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    refs = tuple(weights[n] for n in names)
    key = tuple(id(t) for t in refs)

    cached = _PROJ_CACHE.get(key)
    if cached is not None:
        return cached[1]

    if len(_PROJ_CACHE) > 8:
        _PROJ_CACHE.clear()

    w = torch.cat(refs, dim=0).contiguous()
    _PROJ_CACHE[key] = (refs, w)
    return w


def _next_power_of_2(x):
    return 1 << (int(x) - 1).bit_length()


def custom_kernel(data):
    global _TF32_SET

    if not _TF32_SET:
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _TF32_SET = True

    input_tensor, mask, weights, config = data
    bsz, n, _, dim = input_tensor.shape
    hidden = int(config["hidden_dim"])
    total_p = bsz * n * n
    nn = n * n

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    with torch.no_grad():
        x = F.layer_norm(input_tensor, (dim,), norm_weight, norm_bias, eps=1e-5)
        x2d = x.reshape(total_p, dim)

        proj = F.linear(x2d, _proj_weight(weights))

        left = torch.empty((bsz * hidden, n, n), device=input_tensor.device, dtype=torch.bfloat16)
        right = torch.empty_like(left)
        out_gate = torch.empty_like(left)

        has_mask = (mask is not None) and (not bool(config.get("nomask", False)))
        mask_arg = mask if mask is not None else input_tensor

        gate_bh = 32
        gate_bm = 16
        _gate_and_layout_kernel[(triton.cdiv(hidden, gate_bh), triton.cdiv(total_p, gate_bm))](
            proj,
            mask_arg,
            left,
            right,
            out_gate,
            total_p,
            nn,
            hidden,
            has_mask,
            BLOCK_H=gate_bh,
            BLOCK_M=gate_bm,
            num_warps=4,
        )

        tri = torch.bmm(left, right.transpose(1, 2))

        z = torch.empty((total_p, hidden), device=input_tensor.device, dtype=torch.float32)
        block_h = _next_power_of_2(hidden)
        block_m = 16

        _out_norm_gate_kernel[(triton.cdiv(total_p, block_m),)](
            tri,
            out_gate,
            to_out_norm_weight,
            to_out_norm_bias,
            z,
            total_p,
            nn,
            hidden,
            1.0e-5,
            BLOCK_H=block_h,
            BLOCK_M=block_m,
            num_warps=8,
        )

        out = F.linear(z, to_out_weight).reshape(bsz, n, n, dim)
        return out.float()

```python
"""
Triton/PyTorch hybrid TriMul forward.

Algorithm:
1. Fuse input LayerNorm, three projections, two sigmoid gates, and optional mask into
   compact left/right tensors [B*N, N, H] using a Triton kernel.
2. Compute the outgoing triangular multiplication as H independent batched GEMMs:
   out[b,h] = left[b,:,:,h] @ right[b,:,:,h].T.
3. Fuse output LayerNorm and output gate projection into a second Triton kernel.
4. Use torch matmul for the final dense projection back to dim, returning float32.
"""

import torch
import triton
import triton.language as tl


@triton.jit
def _prep_lr_kernel(
    x, mask,
    norm_w, norm_b,
    left_w, right_w, left_gate_w, right_gate_w,
    left_out, right_out,
    total_pairs: tl.constexpr, C: tl.constexpr, H: tl.constexpr, N: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_C: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    oh = tl.program_id(1)

    offs_c = tl.arange(0, BLOCK_C)
    valid_c = offs_c < C

    x_base = pid * C + offs_c
    xv = tl.load(x + x_base, mask=valid_c, other=0.0).to(tl.float32)

    mean = tl.sum(xv, axis=0) / C
    xc = tl.where(valid_c, xv - mean, 0.0)
    var = tl.sum(xc * xc, axis=0) / C
    xn = xc * tl.rsqrt(var + 1.0e-5)

    nw = tl.load(norm_w + offs_c, mask=valid_c, other=0.0).to(tl.float32)
    nb = tl.load(norm_b + offs_c, mask=valid_c, other=0.0).to(tl.float32)
    xn = tl.where(valid_c, xn * nw + nb, 0.0)

    offs_h = oh * BLOCK_H + tl.arange(0, BLOCK_H)
    valid_h = offs_h < H

    lw = tl.load(left_w + offs_h[:, None] * C + offs_c[None, :],
                 mask=valid_h[:, None] & valid_c[None, :], other=0.0).to(tl.float32)
    rw = tl.load(right_w + offs_h[:, None] * C + offs_c[None, :],
                 mask=valid_h[:, None] & valid_c[None, :], other=0.0).to(tl.float32)
    lgw = tl.load(left_gate_w + offs_h[:, None] * C + offs_c[None, :],
                  mask=valid_h[:, None] & valid_c[None, :], other=0.0).to(tl.float32)
    rgw = tl.load(right_gate_w + offs_h[:, None] * C + offs_c[None, :],
                  mask=valid_h[:, None] & valid_c[None, :], other=0.0).to(tl.float32)

    lp = tl.sum(lw * xn[None, :], axis=1)
    rp = tl.sum(rw * xn[None, :], axis=1)
    lg = tl.sigmoid(tl.sum(lgw * xn[None, :], axis=1))
    rg = tl.sigmoid(tl.sum(rgw * xn[None, :], axis=1))

    m = 1.0
    if HAS_MASK:
        m = tl.load(mask + pid).to(tl.float32)

    val_l = lp * lg * m
    val_r = rp * rg * m

    # left/right are stored as [B, H, N, N] with K contiguous for efficient bmm.
    b = pid // (N * N)
    rem = pid - b * N * N
    i = rem // N
    k = rem - i * N

    out_base = ((b * H + offs_h) * N + i) * N + k
    tl.store(left_out + out_base, val_l, mask=valid_h)
    tl.store(right_out + out_base, val_r, mask=valid_h)


@triton.jit
def _gate_norm_kernel(
    tri, x,
    norm_w, norm_b,
    out_gate_w,
    to_norm_w, to_norm_b,
    gated_out,
    total_pairs: tl.constexpr, C: tl.constexpr, H: tl.constexpr,
    BLOCK_C: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    oh = tl.program_id(1)

    offs_h_all = tl.arange(0, BLOCK_H)
    valid_h_all = offs_h_all < H

    tv = tl.load(tri + pid * H + offs_h_all, mask=valid_h_all, other=0.0).to(tl.float32)
    mean_t = tl.sum(tv, axis=0) / H
    tc = tl.where(valid_h_all, tv - mean_t, 0.0)
    var_t = tl.sum(tc * tc, axis=0) / H
    tn = tc * tl.rsqrt(var_t + 1.0e-5)

    tnw = tl.load(to_norm_w + offs_h_all, mask=valid_h_all, other=0.0).to(tl.float32)
    tnb = tl.load(to_norm_b + offs_h_all, mask=valid_h_all, other=0.0).to(tl.float32)
    tn = tl.where(valid_h_all, tn * tnw + tnb, 0.0)

    offs_c = tl.arange(0, BLOCK_C)
    valid_c = offs_c < C

    xv = tl.load(x + pid * C + offs_c, mask=valid_c, other=0.0).to(tl.float32)
    mean_x = tl.sum(xv, axis=0) / C
    xc = tl.where(valid_c, xv - mean_x, 0.0)
    var_x = tl.sum(xc * xc, axis=0) / C
    xn = xc * tl.rsqrt(var_x + 1.0e-5)

    nw = tl.load(norm_w + offs_c, mask=valid_c, other=0.0).to(tl.float32)
    nb = tl.load(norm_b + offs_c, mask=valid_c, other=0.0).to(tl.float32)
    xn = tl.where(valid_c, xn * nw + nb, 0.0)

    offs_h = oh * BLOCK_H + tl.arange(0, BLOCK_H)
    valid_h = offs_h < H

    ogw = tl.load(out_gate_w + offs_h[:, None] * C + offs_c[None, :],
                  mask=valid_h[:, None] & valid_c[None, :], other=0.0).to(tl.float32)
    gate = tl.sigmoid(tl.sum(ogw * xn[None, :], axis=1))

    tn_blk = tl.load(tri + pid * H + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    # Reuse scalar statistics from the full-H vector above.
    tn_blk = (tn_blk - mean_t) * tl.rsqrt(var_t + 1.0e-5)
    tnw_blk = tl.load(to_norm_w + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    tnb_blk = tl.load(to_norm_b + offs_h, mask=valid_h, other=0.0).to(tl.float32)

    tl.store(gated_out + pid * H + offs_h, (tn_blk * tnw_blk + tnb_blk) * gate, mask=valid_h)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    x = input_tensor
    B, N, _, C = x.shape
    H = int(config["hidden_dim"])

    norm_w = weights["norm.weight"]
    norm_b = weights["norm.bias"]
    left_w = weights["left_proj.weight"]
    right_w = weights["right_proj.weight"]
    left_gate_w = weights["left_gate.weight"]
    right_gate_w = weights["right_gate.weight"]
    out_gate_w = weights["out_gate.weight"]
    to_norm_w = weights["to_out_norm.weight"]
    to_norm_b = weights["to_out_norm.bias"]
    to_out_w = weights["to_out.weight"]

    total = B * N * N
    has_mask = mask is not None

    left = torch.empty((B, H, N, N), device=x.device, dtype=torch.float32)
    right = torch.empty((B, H, N, N), device=x.device, dtype=torch.float32)

    block_c = triton.next_power_of_2(C)
    block_h = 16

    _prep_lr_kernel[(total, triton.cdiv(H, block_h))](
        x, mask if has_mask else x,
        norm_w, norm_b,
        left_w, right_w, left_gate_w, right_gate_w,
        left, right,
        total, C, H, N, has_mask,
        BLOCK_C=block_c, BLOCK_H=block_h,
        num_warps=8,
    )

    tri = torch.matmul(left, right.transpose(-1, -2))
    tri = tri.permute(0, 2, 3, 1).contiguous()

    gated = torch.empty((total, H), device=x.device, dtype=torch.float32)
    _gate_norm_kernel[(total, triton.cdiv(H, block_h))](
        tri, x,
        norm_w, norm_b,
        out_gate_w,
        to_norm_w, to_norm_b,
        gated,
        total, C, H,
        BLOCK_C=block_c, BLOCK_H=block_h,
        num_warps=8,
    )

    out = torch.matmul(gated, to_out_w.t()).reshape(B, N, N, C)
    return out.to(torch.float32)
```

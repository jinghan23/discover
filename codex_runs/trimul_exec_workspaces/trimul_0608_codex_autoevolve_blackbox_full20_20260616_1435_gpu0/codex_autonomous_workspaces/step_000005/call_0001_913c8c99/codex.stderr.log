codex
The projection fusion experiments did not beat cuBLAS. I’m checking smaller runtime details now: the exact batched-GEMM call form, final normalization tile sizes, and whether special-case paths for small `N` can reduce overhead without changing math.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N in [256,512,768,1024]:
 B=1 if N>256 else 2; H=128
 l=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
 r=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
 def bench(fn,it=8):
  for _ in range(2): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return round(sum(ts)/len(ts),1), round(min(ts),1)
 print('N',N,'bmm out_dtype',bench(lambda: torch.bmm(l,r.transpose(1,2),out_dtype=torch.float16)))
 print('N',N,'bmm no out_dtype',bench(lambda: torch.bmm(l,r.transpose(1,2))))
 # matmul broad
 print('N',N,'matmul',bench(lambda: torch.matmul(l,r.transpose(1,2))))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

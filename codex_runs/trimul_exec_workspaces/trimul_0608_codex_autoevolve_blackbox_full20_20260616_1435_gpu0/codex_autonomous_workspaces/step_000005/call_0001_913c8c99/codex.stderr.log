import torch, torch.nn.functional as F
import submission
for D,out,N in [(384,640,1024),(384,640,768),(128,640,1024),(128,128,1024),(128,384,1024)]:
 B=1; rows=B*N*N
 def bench(dtype,it=8):
  x=torch.randn(B,N,N,D,device='cuda',dtype=dtype); w=torch.randn(out,D,device='cuda',dtype=dtype)
  fn=lambda: F.linear(x,w)
  for _ in range(2): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return round(sum(ts)/len(ts),1), round(min(ts),1)
 print('D,out,N',D,out,N,'f16',bench(torch.float16),'bf16',bench(torch.bfloat16))

codex
Another possible lever is the intermediate precision for projection and triangular GEMM. I’m measuring BF16 versus FP16 for the batched GEMM first; if BF16 is slower or not accepted, it won’t be useful.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N in [256,512,768,1024]:
 B=1 if N>256 else 2; H=128
 def bench(dtype,it=8):
  l=torch.randn(B*H,N,N,device='cuda',dtype=dtype); r=torch.randn(B*H,N,N,device='cuda',dtype=dtype)
  fn=lambda: torch.bmm(l,r.transpose(1,2))
  for _ in range(2): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return round(sum(ts)/len(ts),1), round(min(ts),1)
 print('N',N,'f16',bench(torch.float16),'bf16',bench(torch.bfloat16))

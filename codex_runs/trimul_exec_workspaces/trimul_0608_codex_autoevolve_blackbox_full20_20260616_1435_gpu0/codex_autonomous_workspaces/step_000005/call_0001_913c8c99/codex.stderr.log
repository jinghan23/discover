/bin/bash -lc "python - <<'PY'
import torch,triton
import submission
for N,B in [(256,2),(768,1)]:
 H=128; rows=B*N*N; n2=N*N
 p=torch.randn(B,N,N,5*H,device='cuda',dtype=torch.float16); mask=(torch.rand(B,N,N,device='cuda')>0.2).float()
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 def bench(br,bh,nw,it=6):
  fn=lambda: submission._post_proj_transpose_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](p,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
  for _ in range(2): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return sum(ts)/len(ts)
 res=[]
 for br in [8,16,32,64]:
  for bh in [32,64,128]:
   for nw in [2,4,8]:
    if 128%bh: continue
    try: res.append((bench(br,bh,nw),br,bh,nw))
    except Exception as e: pass
 res.sort()
 print('N',N)
 for t,br,bh,nw in res[:10]: print(round(t,1),br,bh,nw)

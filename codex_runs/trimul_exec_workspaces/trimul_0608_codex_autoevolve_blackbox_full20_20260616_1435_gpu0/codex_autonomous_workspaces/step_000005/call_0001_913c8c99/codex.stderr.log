codex
Next target is the `dim=128` fused projection kernel. Its current tiling is shape-specific (`64x32` for `N=768`, `128x32` otherwise). I’m benchmarking alternative `BLOCK_M/BLOCK_H/warps` combinations directly before applying any call-site change.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton
import submission
configs=[]
for bm in [32,64,128,256]:
 for bh in [16,32,64]:
  for nw in [4,8]:
   if 128%bh==0:
    configs.append((bm,bh,nw))
for N in [256,512,768,1024]:
 B=1 if N>256 else 2; D=H=128; rows=B*N*N; n2=N*N
 x=torch.randn(B,N,N,D,device='cuda')
 w={k:torch.randn(H,D,device='cuda') for k in ['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight']}
 normw=torch.randn(D,device='cuda'); normb=torch.randn(D,device='cuda')
 wl,wr,wlg,wrg,wog=tuple(w[k].to(torch.float16).contiguous() for k in ['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight'])
 dtype=torch.bfloat16 if N>=1024 else torch.float16
 left=torch.empty((B*H,N,N),device='cuda',dtype=dtype); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 def bench(bm,bh,nw,it=4):
  fn=lambda: submission._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,x,normw,normb,wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)
  for _ in range(2): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return sum(ts)/len(ts)
 results=[]
 for bm,bh,nw in configs:
  try: results.append((bench(bm,bh,nw),bm,bh,nw))
  except Exception as e: pass
 results.sort()
 print('N',N,'best10')
 for t,bm,bh,nw in results[:10]: print(round(t,1),bm,bh,nw)

import torch
import submission
shapes=[(2,256,128,True),(1,512,128,True),(1,1024,128,True),(1,1024,384,True)]
def make(B,N,D,nomask):
 H=128; x=torch.randn(B,N,N,D,device='cuda'); mask=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float(); w={
 'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),
 'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),
 'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),
 'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')}
 return (x,mask,w,{'bs':B,'seqlen':N,'dim':D,'hidden_dim':H,'nomask':nomask})
def bench(data,it=3):
 for _ in range(2): submission.custom_kernel(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); submission.custom_kernel(data); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
 return round(sum(ts)/len(ts),1), round(min(ts),1)
for s in shapes:
 print(s, bench(make(*s), it=3))

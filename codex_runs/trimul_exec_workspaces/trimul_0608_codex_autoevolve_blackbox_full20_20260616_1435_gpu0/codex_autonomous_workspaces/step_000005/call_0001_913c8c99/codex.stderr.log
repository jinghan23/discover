/bin/bash -lc "python - <<'PY'
import torch
for N in [256,512,768,1024]:
 B=1 if N>256 else 2; H=128; dtype=torch.float16
 l=torch.randn(B*H,N,N,device='cuda',dtype=dtype); r=torch.randn(B*H,N,N,device='cuda',dtype=dtype); out=torch.empty_like(l)
 def bench(fn,it=10):
  for _ in range(3): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(it):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return round(sum(ts)/len(ts),1), round(min(ts),1)
 print('N',N,'alloc',bench(lambda: torch.bmm(l,r.transpose(1,2),out_dtype=dtype)),'out',bench(lambda: torch.bmm(l,r.transpose(1,2),out=out)))

     tl.store(out_gate_ptr + nh, tl.sigmoid(og), mask=valid)
 
 
+@triton.jit
+def _final_ln_gate_out128_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    out_w_ptr,
+    out_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, 128)
+    valid_m = offs_m < rows
+    bidx = offs_m // n2
+    ij = offs_m - bidx * n2
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_m[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(w_ptr + offs_h).to(tl.float32)
+    nb = tl.load(b_ptr + offs_h).to(tl.float32)
+    g = tl.load(gate_ptr + offs_m[:, None] * 128 + offs_h[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
+    y = (xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g
+    od = tl.arange(0, 128)
+    ow = tl.load(out_w_ptr + od[None, :] * 128 + offs_h[:, None]).to(tl.float32)
+    acc = tl.dot(y, ow, input_precision="tf32")
+    tl.store(out_ptr + offs_m[:, None] * 128 + od[None, :], acc, mask=valid_m[:, None])

/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F

torch.backends.cuda.matmul.allow_tf32=True; torch.set_float32_matmul_precision('medium')

def bench(rows,D,H=128):
 dev='cuda'; x=torch.randn(rows,D,device=dev,dtype=torch.float16); w=torch.randn(5*H,D,device=dev,dtype=torch.float16); proj=torch.empty(rows,5*H,device=dev,dtype=torch.float16)
 # warm
 for _ in range(5):
  y=F.linear(x,w); torch.mm(x,w.t(),out=proj); torch.cuda.synchronize()
 for name in ['linear','mmout']:
  times=[]
  for _ in range(20):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
   if name=='linear': y=F.linear(x,w)
   else: torch.mm(x,w.t(),out=proj)
   e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
  print(rows,D,name,round(min(times),1),round(sum(times)/len(times),1))
for rows,D in [(131072,384),(589824,384),(1048576,384),(131072,128),(589824,128)]: bench(rows,D)

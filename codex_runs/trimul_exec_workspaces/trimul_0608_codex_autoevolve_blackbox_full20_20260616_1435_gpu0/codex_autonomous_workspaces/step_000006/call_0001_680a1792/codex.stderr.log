+def _fused_proj128_pair_kernel(
+    x_ptr,
+    mask_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    wlp_ptr,
+    wrp_ptr,
+    wog_ptr,
+    left_ptr,
+    right_ptr,
+    out_gate_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    NOMASK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_d = tl.arange(0, 128)
+    offs_h_base = tl.arange(0, BLOCK_H)
+    offs_pair = tl.arange(0, 2 * BLOCK_H)
+    valid_m = offs_m < rows
+
+    x = tl.load(
+        x_ptr + offs_m[:, None] * 128 + offs_d[None, :],

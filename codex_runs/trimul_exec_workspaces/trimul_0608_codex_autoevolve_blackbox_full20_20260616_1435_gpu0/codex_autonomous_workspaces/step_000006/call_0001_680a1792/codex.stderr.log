 @triton.jit
+def _out_norm_linear_kernel(
+    x_ptr,
+    gate_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    to_out_w_ptr,
+    out_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, 128)
+    valid_m = offs_m < rows
+    bidx = offs_m // n2
+    ij = offs_m - bidx * n2
+
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_m[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(norm_w_ptr + offs_h).to(tl.float32)
+    nb = tl.load(norm_b_ptr + offs_h).to(tl.float32)
+    g = tl.load(gate_ptr + offs_m[:, None] * 128 + offs_h[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
+    y = (xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g
+
+    offs_d_base = tl.arange(0, 128)
+    for q in tl.static_range(0, D // 128):
+        offs_d = offs_d_base + q * 128
+        w = tl.load(to_out_w_ptr + offs_d[None, :] * 128 + offs_h[:, None]).to(tl.float32)
+        acc = tl.dot(y, w, input_precision="tf32")
+        tl.store(out_ptr + offs_m[:, None] * D + offs_d[None, :], acc, mask=valid_m[:, None])
+
+

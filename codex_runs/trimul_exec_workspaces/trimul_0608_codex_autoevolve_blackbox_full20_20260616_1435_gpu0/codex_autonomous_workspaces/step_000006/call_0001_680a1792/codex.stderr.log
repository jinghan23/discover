Another allocation-heavy spot is the triangular `bmm` output. I’m checking whether using a cached `out=` buffer for `torch.bmm` is accepted and faster; this affects every shape and is correctness-neutral.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N in [256,768,1024]:
 B=1 if N>256 else 2; H=128; dev='cuda'
 left=torch.randn(B*H,N,N,device=dev,dtype=torch.float16); right=torch.randn_like(left); out=torch.empty(B*H,N,N,device=dev,dtype=torch.float16)
 for variant in ['alloc','out','out_dtype_out']:
  try:
   for _ in range(3):
    if variant=='alloc': y=torch.bmm(left,right.transpose(1,2),out_dtype=torch.float16)
    elif variant=='out': torch.bmm(left,right.transpose(1,2),out=out)
    else: torch.bmm(left,right.transpose(1,2),out=out,out_dtype=torch.float16)
    torch.cuda.synchronize()
   times=[]
   for _ in range(10):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
    if variant=='alloc': y=torch.bmm(left,right.transpose(1,2),out_dtype=torch.float16)
    elif variant=='out': torch.bmm(left,right.transpose(1,2),out=out)
    else: torch.bmm(left,right.transpose(1,2),out=out,out_dtype=torch.float16)
    e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
   print(N,variant,round(min(times),1),round(sum(times)/len(times),1))
  except Exception as exc:
   print(N,variant,'ERR',type(exc).__name__,exc)

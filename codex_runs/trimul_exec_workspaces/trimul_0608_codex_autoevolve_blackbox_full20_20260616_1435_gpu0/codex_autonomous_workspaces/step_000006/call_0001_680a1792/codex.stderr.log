+def _proj_pair_parts(weights, dtype, dim, hidden_dim):
+    refs = (
+        weights["left_proj.weight"],
+        weights["right_proj.weight"],
+        weights["left_gate.weight"],
+        weights["right_gate.weight"],
+        weights["out_gate.weight"],
+    )
+    keys = (
+        dim,
+        hidden_dim,
+        str(dtype),
+        refs[0].data_ptr(),
+        refs[1].data_ptr(),
+        refs[2].data_ptr(),
+        refs[3].data_ptr(),
+        refs[4].data_ptr(),
+    )
+    cached = _PROJ_PAIR_CACHE.get(keys)
+    if cached is None:
+        if len(_PROJ_PAIR_CACHE) > 16:
+            _PROJ_PAIR_CACHE.clear()
+        left_pair = torch.cat((refs[0].to(dtype), refs[2].to(dtype)), dim=0).contiguous()
+        right_pair = torch.cat((refs[1].to(dtype), refs[3].to(dtype)), dim=0).contiguous()
+        out_gate = refs[4].to(dtype).contiguous()
+        cached = ((left_pair, right_pair, out_gate), refs)
+        _PROJ_PAIR_CACHE[keys] = cached
+    return cached[0]

"""
Optimized outgoing TriMul forward: Triton handles row layernorms, projection
post-processing, gates, and masks; FP16 batched GEMMs compute the triangular
update; a Triton row-normalize/gate stage feeds a cached-output TF32 projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl

torch.backends.cuda.matmul.allow_tf32 = True
torch.backends.cudnn.allow_tf32 = True
torch.set_float32_matmul_precision("medium")

_PROJ_W_CACHE = {}
_PROJ_PARTS_CACHE = {}
_PROJ_PAIR_CACHE = {}
_NORM_DEFAULT_CACHE = {}
_BUF_CACHE = {}
_BUF_SHAPE = None


def _buf(shape_key, name, shape, dtype, device):
    global _BUF_SHAPE
    if _BUF_SHAPE != shape_key:
        _BUF_CACHE.clear()
        _BUF_SHAPE = shape_key
    key = (name, dtype)
    cached = _BUF_CACHE.get(key)
    if cached is None:
        cached = torch.empty(shape, device=device, dtype=dtype)
        _BUF_CACHE[key] = cached
    return cached


def _norm_is_default(w, b):
    key = (w.data_ptr(), b.data_ptr())
    cached = _NORM_DEFAULT_CACHE.get(key)
    if cached is None:
        if len(_NORM_DEFAULT_CACHE) > 32:
            _NORM_DEFAULT_CACHE.clear()
        cached = bool(torch.all(w == 1).item() and torch.all(b == 0).item())
        _NORM_DEFAULT_CACHE[key] = cached
    return cached


def _proj_weight(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    keys = (
        dim,
        hidden_dim,
        str(dtype),
        refs[0].data_ptr(),
        refs[1].data_ptr(),
        refs[2].data_ptr(),
        refs[3].data_ptr(),
        refs[4].data_ptr(),
    )
    cached = _PROJ_W_CACHE.get(keys)
    if cached is None:
        if len(_PROJ_W_CACHE) > 16:
            _PROJ_W_CACHE.clear()
        proj = torch.cat(
            (
                refs[0].to(dtype),
                refs[1].to(dtype),
                refs[2].to(dtype),
                refs[3].to(dtype),
                refs[4].to(dtype),
            ),
            dim=0,
        ).contiguous()
        cached = (proj, refs)
        _PROJ_W_CACHE[keys] = cached
    return cached[0]


def _proj_parts(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    keys = (
        dim,
        hidden_dim,
        str(dtype),
        refs[0].data_ptr(),
        refs[1].data_ptr(),
        refs[2].data_ptr(),
        refs[3].data_ptr(),
        refs[4].data_ptr(),
    )
    cached = _PROJ_PARTS_CACHE.get(keys)
    if cached is None:
        if len(_PROJ_PARTS_CACHE) > 16:
            _PROJ_PARTS_CACHE.clear()
        parts = tuple(w.to(dtype).contiguous() for w in refs)
        cached = (parts, refs)
        _PROJ_PARTS_CACHE[keys] = cached
    return cached[0]


def _proj_pair_parts(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    keys = (
        dim,
        hidden_dim,
        str(dtype),
        refs[0].data_ptr(),
        refs[1].data_ptr(),
        refs[2].data_ptr(),
        refs[3].data_ptr(),
        refs[4].data_ptr(),
    )
    cached = _PROJ_PAIR_CACHE.get(keys)
    if cached is None:
        if len(_PROJ_PAIR_CACHE) > 16:
            _PROJ_PAIR_CACHE.clear()
        left_pair = torch.cat((refs[0].to(dtype), refs[2].to(dtype)), dim=0).contiguous()
        right_pair = torch.cat((refs[1].to(dtype), refs[3].to(dtype)), dim=0).contiguous()
        out_gate = refs[4].to(dtype).contiguous()
        cached = ((left_pair, right_pair, out_gate), refs)
        _PROJ_PAIR_CACHE[keys] = cached
    return cached[0]


@triton.jit
def _ln_gate_tile_kernel(
    x_ptr,
    gate_ptr,
    w_ptr,
    b_ptr,
    y_ptr,
    rows: tl.constexpr,
    n2: tl.constexpr,
    H: tl.constexpr,
    AFFINE: tl.constexpr,
    BLOCK_R: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
    offs_h = tl.arange(0, BLOCK_H)
    valid_r = offs_r < rows
    valid_h = offs_h < H
    valid = valid_r[:, None] & valid_h[None, :]
    bidx = offs_r // n2
    ij = offs_r - bidx * n2
    x_addr = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
    x = tl.load(x_ptr + x_addr, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(tl.where(valid_h[None, :], x, 0.0), axis=1) / H
    xc = tl.where(valid_h[None, :], x - mean[:, None], 0.0)
    var = tl.sum(xc * xc, axis=1) / H
    rstd = tl.rsqrt(var + 1.0e-5)
    y_addr = offs_r[:, None] * H + offs_h[None, :]
    g = tl.load(gate_ptr + y_addr, mask=valid, other=0.0).to(tl.float32)
    y = xc * rstd[:, None]
    if AFFINE:
        w = tl.load(w_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
        b = tl.load(b_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
        y = y * w[None, :] + b[None, :]
    y = y * g
    tl.store(y_ptr + y_addr, y, mask=valid)



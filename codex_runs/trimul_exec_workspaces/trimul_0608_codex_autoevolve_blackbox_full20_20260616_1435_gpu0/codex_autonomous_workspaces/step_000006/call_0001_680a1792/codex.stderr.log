import submission

torch.backends.cuda.matmul.allow_tf32 = True
torch.set_float32_matmul_precision('medium')

def make_case(bs,n,d,h,nomask,dist='normal'):
    device='cuda'
    if dist=='cauchy':
        x=torch.distributions.Cauchy(0,2).sample((bs,n,n,d)).to(device)
    else:
        x=torch.randn((bs,n,n,d),device=device)
    mask=None if nomask else (torch.rand((bs,n,n),device=device)>0.15).float()
    weights={
        'norm.weight': torch.randn(d,device=device),
        'norm.bias': torch.randn(d,device=device),
        'left_proj.weight': torch.randn(h,d,device=device),
        'right_proj.weight': torch.randn(h,d,device=device),
        'left_gate.weight': torch.randn(h,d,device=device),
        'right_gate.weight': torch.randn(h,d,device=device),
        'out_gate.weight': torch.randn(h,d,device=device),
        'to_out_norm.weight': torch.randn(h,device=device),
        'to_out_norm.bias': torch.randn(h,device=device),
        'to_out.weight': torch.randn(d,h,device=device),
    }
    return (x, mask, weights, {'dim':d,'hidden_dim':h,'nomask':nomask})

cases=[
(2,256,128,128,True,'normal'),
(1,768,128,128,True,'cauchy'),
(2,256,384,128,False,'normal'),
(1,512,128,128,True,'normal'),
(1,1024,128,128,True,'cauchy'),
(1,768,384,128,False,'normal'),
(1,1024,384,128,True,'normal'),
]
for c in cases:
    torch.cuda.empty_cache()
    data=make_case(*c)
    # compile/warm
    for _ in range(3):
        y=submission.custom_kernel(data); torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=submission.custom_kernel(data); e.record(); e.synchronize()
        times.append(s.elapsed_time(e)*1000)
    print(c, 'mean_us', sum(times)/len(times), 'min_us', min(times), 'dtype', y.dtype, flush=True)

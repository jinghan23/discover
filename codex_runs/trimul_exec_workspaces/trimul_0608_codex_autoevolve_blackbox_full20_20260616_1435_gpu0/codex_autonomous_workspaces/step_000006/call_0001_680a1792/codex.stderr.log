import torch, triton
import submission as s

def bench(B,N,nomask):
 dev='cuda'; H=128; rows=B*N*N; n2=N*N
 proj=torch.randn(rows,5*H,device=dev,dtype=torch.float16)
 mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.15).float()
 left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
 print('post bench',B,N,nomask)
 for BR in [8,16,32,64,128]:
  for BH in [32,64,128]:
   for nw in [4,8]:
    try:
     for _ in range(2): s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj, proj if mask is None else mask, left,right,og, rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=nw)
     torch.cuda.synchronize(); times=[]
     for _ in range(5):
      a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj, proj if mask is None else mask, left,right,og, rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=nw); b.record(); b.synchronize(); times.append(a.elapsed_time(b)*1000)
     print((BR,BH,nw),round(min(times),1),round(sum(times)/len(times),1),flush=True)
    except Exception as e:
     print((BR,BH,nw),'ERR',type(e).__name__,str(e)[:100],flush=True)
for case in [(2,256,False),(1,768,False),(1,1024,True)]:
 torch.cuda.empty_cache(); bench(*case)

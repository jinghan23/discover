The fused output kernel is in the file. I’m benchmarking it directly against the current `ln_gate` plus `torch.mm` pair across `dim=128` and `dim=384` before wiring it into the main function.
exec
/bin/bash -lc "python -m py_compile submission.py && python - <<'PY'
import torch, triton
import submission as s

torch.backends.cuda.matmul.allow_tf32=True; torch.set_float32_matmul_precision('medium')

def bench(B,N,D):
 dev='cuda'; H=128; rows=B*N*N; n2=N*N
 x=torch.randn(B,H,N,N,device=dev,dtype=torch.float16)
 gate=torch.sigmoid(torch.randn(B,N,N,H,device=dev,dtype=torch.float16))
 nw=torch.randn(H,device=dev); nb=torch.randn(H,device=dev); tw=torch.randn(D,H,device=dev)
 gated=torch.empty((B,N,N,H),device=dev,dtype=torch.float32); out=torch.empty((B,N,N,D),device=dev,dtype=torch.float32); out2=torch.empty_like(out)
 # warm old
 for _ in range(3):
  s._ln_gate_tile_kernel[(triton.cdiv(rows,32),)](x,gate,nw,nb,gated,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=128,num_warps=4)
  torch.mm(gated.view(rows,H),tw.t(),out=out.view(rows,D))
  torch.cuda.synchronize()
 old=[]
 for _ in range(8):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record();
  s._ln_gate_tile_kernel[(triton.cdiv(rows,32),)](x,gate,nw,nb,gated,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=128,num_warps=4)
  torch.mm(gated.view(rows,H),tw.t(),out=out.view(rows,D))
  b.record(); b.synchronize(); old.append(a.elapsed_time(b)*1000)
 print('case',B,N,D,'old',round(min(old),1),round(sum(old)/len(old),1))
 for BM in [8,16,32,64,128]:
  for nwps in [4,8]:
   try:
    for _ in range(3): s._out_norm_linear_kernel[(triton.cdiv(rows,BM),)](x,gate,nw,nb,tw,out2,rows=rows,n2=n2,D=D,BLOCK_M=BM,num_warps=nwps)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):
     a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); s._out_norm_linear_kernel[(triton.cdiv(rows,BM),)](x,gate,nw,nb,tw,out2,rows=rows,n2=n2,D=D,BLOCK_M=BM,num_warps=nwps); b.record(); b.synchronize(); times.append(a.elapsed_time(b)*1000)
    # light error for first config maybe
    print((BM,nwps),round(min(times),1),round(sum(times)/len(times),1),flush=True)
   except Exception as e:
    print((BM,nwps),'ERR',type(e).__name__,str(e)[:120],flush=True)

for case in [(2,256,128),(1,512,128),(1,768,128),(1,1024,128),(2,256,384),(1,768,384),(1,1024,384)]:
 torch.cuda.empty_cache(); bench(*case)

+        left_pair = torch.cat((refs[0].to(dtype), refs[2].to(dtype)), dim=0).contiguous()
+        right_pair = torch.cat((refs[1].to(dtype), refs[3].to(dtype)), dim=0).contiguous()
+        out_gate = refs[4].to(dtype).contiguous()
+        cached = ((left_pair, right_pair, out_gate), refs)
+        _PROJ_PAIR_CACHE[keys] = cached
+    return cached[0]

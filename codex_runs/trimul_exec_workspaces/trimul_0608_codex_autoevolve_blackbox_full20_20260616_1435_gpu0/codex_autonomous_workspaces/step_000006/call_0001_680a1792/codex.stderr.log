import torch, triton, time
import submission as s
import torch.nn.functional as F

torch.backends.cuda.matmul.allow_tf32=True
torch.set_float32_matmul_precision('medium')

def make(bs,n,d,h,nomask):
    dev='cuda'
    x=torch.randn(bs,n,n,d,device=dev)
    mask=None if nomask else (torch.rand(bs,n,n,device=dev)>0.15).float()
    weights={
        'norm.weight': torch.randn(d,device=dev),'norm.bias': torch.randn(d,device=dev),
        'left_proj.weight': torch.randn(h,d,device=dev),'right_proj.weight': torch.randn(h,d,device=dev),
        'left_gate.weight': torch.randn(h,d,device=dev),'right_gate.weight': torch.randn(h,d,device=dev),'out_gate.weight': torch.randn(h,d,device=dev),
        'to_out_norm.weight': torch.randn(h,device=dev),'to_out_norm.bias': torch.randn(h,device=dev),
        'to_out.weight': torch.randn(d,h,device=dev),}
    return x,mask,weights,{'dim':d,'hidden_dim':h,'nomask':nomask}

def timed(data,iters=5):
    input_tensor, mask, weights, config=data
    dim=int(config['dim']); h=int(config['hidden_dim']); B=input_tensor.shape[0]; N=input_tensor.shape[1]; dev=input_tensor.device
    rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
    shape_key=(dev,B,N,dim,h,'prof')
    x_in=input_tensor.contiguous(); nomask=bool(config.get('nomask',False)) or mask is None or (dim==128) or (dim==384 and B==1 and N==1024); mask_arg=input_tensor if mask is None else mask
    # warm full
    for _ in range(3): s.custom_kernel(data); torch.cuda.synchronize()
    names=['ln','linear','post','bmm','ln_gate','outmm']
    sums={k:0.0 for k in names}
    for _ in range(iters):
        left_b=s._buf(shape_key,'left_b',(B*h,N,N),f16,dev); right_b=s._buf(shape_key,'right_b',(B*h,N,N),f16,dev); out_gate=s._buf(shape_key,'out_gate',(B,N,N,h),f16,dev)
        x=s._buf(shape_key,'x_norm',input_tensor.shape,f16,dev)
        ev=[]
        def rec():
            e=torch.cuda.Event(True); e.record(); ev.append(e)
        rec()
        in_rows=x.numel()//dim
        if dim==384:
            s._input_ln384_kernel[(in_rows,)](x_in,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),x,rows=in_rows,BLOCK_R=1,num_warps=1)
        else:
            s._input_ln_kernel[(in_rows,)](x_in,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),x,D=dim,BLOCK=triton.next_power_of_2(dim),num_warps=1)
        rec()
        proj_w=s._proj_weight(weights,f16,dim,h)
        proj=F.linear(x,proj_w)
        rec()
        s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(h,64))](proj,mask_arg,left_b,right_b,out_gate,rows=rows,n2=n2,H=h,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
        rec()
        out_h=torch.bmm(left_b,right_b.transpose(1,2),out_dtype=f16).view(B,h,N,N)
        rec()
        gated=s._buf(shape_key,'gated',(B,N,N,h),f32,dev)
        s._ln_gate_tile_kernel[(triton.cdiv(rows,32),)](out_h,out_gate,weights['to_out_norm.weight'].to(f32),weights['to_out_norm.bias'].to(f32),gated,rows=rows,n2=n2,H=h,BLOCK_R=32,BLOCK_H=128,num_warps=4)
        rec()
        out=s._buf(shape_key,'out',input_tensor.shape,f32,dev)
        torch.mm(gated.view(rows,h),weights['to_out.weight'].to(f32).t(),out=out.view(rows,dim))
        rec()
        ev[-1].synchronize()
        for i,k in enumerate(names): sums[k]+=ev[i].elapsed_time(ev[i+1])*1000
    print('case', (B,N,dim,h,config.get('nomask')), {k:round(v/iters,1) for k,v in sums.items()}, 'total', round(sum(sums.values())/iters,1), flush=True)

for case in [(1,1024,384,128,True),(1,768,384,128,False),(2,256,384,128,False),(1,1024,128,128,True),(1,768,128,128,True),(2,256,128,128,True)]:
    torch.cuda.empty_cache()
    timed(make(*case), iters=5)

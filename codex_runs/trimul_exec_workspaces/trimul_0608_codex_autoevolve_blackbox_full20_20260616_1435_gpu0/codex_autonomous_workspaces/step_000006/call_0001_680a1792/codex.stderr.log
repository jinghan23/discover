The paired projection kernel is added. I’m compiling and benchmarking it against the old fused projection over the 128-channel shapes; if it wins, I’ll swap it into `custom_kernel`.
exec
/bin/bash -lc "python -m py_compile submission.py && python - <<'PY'
import torch, triton
import submission as s

torch.backends.cuda.matmul.allow_tf32=True; torch.set_float32_matmul_precision('medium')

def bench(B,N):
 dev='cuda'; D=H=128; rows=B*N*N; n2=N*N
 x=torch.randn(B,N,N,D,device=dev); mask=None
 w={'norm.weight':torch.randn(D,device=dev),'norm.bias':torch.randn(D,device=dev),'left_proj.weight':torch.randn(H,D,device=dev),'right_proj.weight':torch.randn(H,D,device=dev),'left_gate.weight':torch.randn(H,D,device=dev),'right_gate.weight':torch.randn(H,D,device=dev),'out_gate.weight':torch.randn(H,D,device=dev),'to_out_norm.weight':torch.empty(H,device=dev),'to_out_norm.bias':torch.empty(H,device=dev),'to_out.weight':torch.empty(D,H,device=dev)}
 wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
 wlp,wrp,wogp=s._proj_pair_parts(w,torch.float16,D,H)
 left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
 print('pair bench',B,N)
 # old best/current
 for BM,BH,nw in ([(64,32,4)] if N==768 else [(128,32,8)]):
  for _ in range(3): s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw)
  torch.cuda.synchronize(); times=[]
  for _ in range(8):
   a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw); b.record(); b.synchronize(); times.append(a.elapsed_time(b)*1000)
  print('old',(BM,BH,nw),round(min(times),1),round(sum(times)/len(times),1))
 for BM in [32,64,128,256]:
  for BH in [16,32,64]:

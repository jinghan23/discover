codex
The new kernel is defined; before wiring it into `custom_kernel`, I’m going to compile and benchmark it directly over the 384-channel shapes to pick safe launch parameters.
exec
/bin/bash -lc "python -m py_compile submission.py && python - <<'PY'
import torch, triton
import submission as s

torch.backends.cuda.matmul.allow_tf32=True; torch.set_float32_matmul_precision('medium')

def bench(B,N,nomask):
 dev='cuda'; D=384; H=128; rows=B*N*N; n2=N*N
 x=torch.randn(B,N,N,D,device=dev); mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.15).float()
 w={'norm.weight':torch.randn(D,device=dev),'norm.bias':torch.randn(D,device=dev),'left_proj.weight':torch.randn(H,D,device=dev),'right_proj.weight':torch.randn(H,D,device=dev),'left_gate.weight':torch.randn(H,D,device=dev),'right_gate.weight':torch.randn(H,D,device=dev),'out_gate.weight':torch.randn(H,D,device=dev),'to_out_norm.weight':torch.empty(H,device=dev),'to_out_norm.bias':torch.empty(H,device=dev),'to_out.weight':torch.empty(D,H,device=dev)}
 wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
 left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
 print('bench384',B,N,'nomask',nomask,'rows',rows, flush=True)
 configs=[]
 for BM in [8,16,32,64]:
  for BH in [16,32,64]:
   for nw in [4,8]: configs.append((BM,BH,nw))
 for BM,BH,nw in configs:
  try:
   for _ in range(2):
    s._fused_proj384_kernel[(triton.cdiv(rows,BM),)](x, x if mask is None else mask, w['norm.weight'], w['norm.bias'], wl,wr,wlg,wrg,wog,left,right,og, rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw)
   torch.cuda.synchronize(); times=[]
   for _ in range(4):
    a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); s._fused_proj384_kernel[(triton.cdiv(rows,BM),)](x, x if mask is None else mask, w['norm.weight'], w['norm.bias'], wl,wr,wlg,wrg,wog,left,right,og, rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw); b.record(); b.synchronize(); times.append(a.elapsed_time(b)*1000)
   print((BM,BH,nw),round(min(times),1),round(sum(times)/len(times),1), flush=True)
  except Exception as e:
   print((BM,BH,nw),'ERR',type(e).__name__,str(e)[:160], flush=True)

for case in [(2,256,False),(1,768,False),(1,1024,True)]:
 torch.cuda.empty_cache(); bench(*case)

/bin/bash -lc "python - <<'PY'
import torch

torch.backends.cuda.matmul.allow_tf32=True; torch.set_float32_matmul_precision('medium')

def bench(rows,H,D):
 dev='cuda'; a=torch.randn(rows,H,device=dev); w=torch.randn(D,H,device=dev); out=torch.empty(rows,D,device=dev); wt=w.t(); wc=wt.contiguous()
 for _ in range(5): torch.mm(a,wt,out=out); torch.mm(a,wc,out=out); torch.cuda.synchronize()
 for name,b in [('view',wt),('contig',wc)]:
  times=[]
  for _ in range(20):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); torch.mm(a,b,out=out); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
  print(rows,D,name,round(min(times),1),round(sum(times)/len(times),1), 'stride', b.stride())
for rows,D in [(131072,128),(262144,128),(589824,128),(1048576,128),(131072,384),(589824,384),(1048576,384)]:
 bench(rows,128,D)

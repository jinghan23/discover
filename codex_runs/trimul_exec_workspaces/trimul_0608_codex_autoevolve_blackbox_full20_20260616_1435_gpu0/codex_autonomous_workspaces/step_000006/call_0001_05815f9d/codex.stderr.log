/bin/bash -lc "python - <<'PY'
import torch
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def ref(x, mask, weights):
    D=x.shape[-1]; H=weights['left_proj.weight'].shape[0]
    y=torch.nn.functional.layer_norm(x,(D,),weights['norm.weight'],weights['norm.bias'],1e-5)
    l=torch.nn.functional.linear(y, weights['left_proj.weight'])
    r=torch.nn.functional.linear(y, weights['right_proj.weight'])
    lg=torch.sigmoid(torch.nn.functional.linear(y, weights['left_gate.weight']))
    rg=torch.sigmoid(torch.nn.functional.linear(y, weights['right_gate.weight']))
    og=torch.sigmoid(torch.nn.functional.linear(y, weights['out_gate.weight']))
    if mask is not None:
        m=mask.unsqueeze(-1)
        l=l*m; r=r*m
    l=l*lg; r=r*rg
    out=torch.einsum('bikd,bjkd->bijd', l, r)
    out=torch.nn.functional.layer_norm(out,(H,),weights['to_out_norm.weight'],weights['to_out_norm.bias'],1e-5)
    out=out*og
    return torch.nn.functional.linear(out,weights['to_out.weight'])

torch.manual_seed(0)

def current_proj(data):
 x,mask,w,cfg=data;B,N,_,D=x.shape;H=128;rows=B*N*N;key=(x.device,B,N,D,H);mask_arg=x if mask is None else mask;nomask=cfg['nomask'] or mask is None
 xnorm=s._buf(key,'x_norm',x.shape,f16,'cuda');left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda');right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda');og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda');pw=s._buf(key,'proj_w',(5*H,D),f16,'cuda');proj=s._buf(key,'proj',(B,N,N,5*H),f16,'cuda')
 ln_br=4 if N==256 else (32 if N>=1024 else (16 if N>=768 else 1)); ln_w=2 if N==256 else (4 if N>=1024 else 1)
 def fn():

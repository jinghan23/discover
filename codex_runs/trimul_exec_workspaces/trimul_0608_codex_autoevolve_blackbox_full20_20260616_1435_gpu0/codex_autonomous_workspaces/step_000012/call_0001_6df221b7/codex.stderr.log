import torch, triton
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32

def make_case(N,B,nomask,dist='normal'):
 x=(torch.distributions.Cauchy(0,2).sample((B,N,N,128)).cuda().float() if dist=='cauchy' else torch.randn((B,N,N,128),device='cuda'))
 mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.15).float(); H=128; D=128
 w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')}; return (x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})

def prep(data):
    for _ in range(3): s.custom_kernel(data)
    torch.cuda.synchronize(); x,mask,w,cfg=data; B,N,_,D=x.shape; H=128; rows=B*N*N; key=(x.device,B,N,D,H); mask_arg=x if mask is None else mask; nomask=cfg['nomask'] or mask is None
    left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda'); right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda'); og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda')
    wl=s._buf(key,'wl',(H,D),f16,'cuda'); wr=s._buf(key,'wr',(H,D),f16,'cuda'); wlg=s._buf(key,'wlg',(H,D),f16,'cuda'); wrg=s._buf(key,'wrg',(H,D),f16,'cuda'); wog=s._buf(key,'wog',(H,D),f16,'cuda')
    wl.copy_(w['left_proj.weight']); wr.copy_(w['right_proj.weight']); wlg.copy_(w['left_gate.weight']); wrg.copy_(w['right_gate.weight']); wog.copy_(w['out_gate.weight'])
    return x,mask_arg,w,B,N,D,H,rows,key,nomask,left,right,og,wl,wr,wlg,wrg,wog

def bench_fused(data, configs):
    x,mask_arg,w,B,N,D,H,rows,key,nomask,left,right,og,wl,wr,wlg,wrg,wog=prep(data)
    print('\\ncase',N,B)
    for bm,bh,nw in configs:
        if 128%bh: continue
        try:
            for _ in range(3): s._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=N*N,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)
            torch.cuda.synchronize(); times=[]
            for _ in range(10):
                st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()
                s._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=N*N,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)
                en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
            print('fused',(bm,bh,nw),'med',sorted(times)[len(times)//2],'min',min(times))
        except Exception as e: print('fused',(bm,bh,nw),'ERR',type(e).__name__,e)
    # generic path timing
    xnorm=s._buf(key,'x_norm_test',x.shape,f16,'cuda'); proj_w=s._buf(key,'proj_w_test',(5*H,D),f16,'cuda'); proj=s._buf(key,'proj_test',(B,N,N,5*H),f16,'cuda')
    def generic():
        s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xnorm,D=D,BLOCK=128,num_warps=1)
        torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
        torch.mm(xnorm.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
        s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=N*N,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    for _ in range(3): generic()
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); generic(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    print('generic med',sorted(times)[len(times)//2],'min',min(times))

configs=[(32,16,4),(32,32,4),(32,64,4),(64,16,4),(64,32,4),(64,64,4),(128,16,4),(128,32,4),(128,64,4),(32,32,8),(64,32,8),(128,32,8),(16,32,4),(96,32,4)]
for c in [(1024,1,True,'cauchy'),(768,1,True,'cauchy'),(512,1,True,'normal'),(256,2,True,'normal')]:
    bench_fused(make_case(*c),configs)

import torch, triton
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32

def make_case(N,B,nomask):
 D=384; H=128; x=torch.randn((B,N,N,D),device='cuda'); mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.15).float(); w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')}; return (x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})

def bench(data):
 x,mask,w,cfg=data; B,N,_,D=x.shape; H=128; rows=B*N*N; n2=N*N; key=(x.device,B,N,D,H); mask_arg=x if mask is None else mask; nomask=cfg['nomask'] or mask is None
 # compile baseline custom
 for _ in range(2): s.custom_kernel(data)
 torch.cuda.synchronize()
 left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda'); right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda'); og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda')
 # current projection path only
 xnorm=s._buf(key,'x_norm',(B,N,N,D),f16,'cuda'); proj_w=s._buf(key,'proj_w',(5*H,D),f16,'cuda'); proj=s._buf(key,'proj',(B,N,N,5*H),f16,'cuda')
 def current():
   ln_br=16 if N>=768 else 4; ln_warps=1 if N>=768 else 2
   s._input_ln384_kernel[(triton.cdiv(rows,ln_br),)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xnorm,rows=rows,BLOCK_R=ln_br,num_warps=ln_warps)
   torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
   torch.mm(xnorm.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
   if nomask:
     s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
   else:
     s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 # affine path
 xraw=s._buf(key,'x_raw_h',(B,N,N,D),f16,'cuda'); mean=s._buf(key,'x_mean',(rows,),f32,'cuda'); rstd=s._buf(key,'x_rstd',(rows,),f32,'cuda'); raw=s._buf(key,'proj_w_raw',(5*H,D),f16,'cuda'); adj=s._buf(key,'proj_w_aff',(5*H,D),f16,'cuda'); aff_s=s._buf(key,'aff_s',(5*H,),f32,'cuda'); aff_b=s._buf(key,'aff_b',(5*H,),f32,'cuda'); proj2=s._buf(key,'proj_aff',(B,N,N,5*H),f16,'cuda')

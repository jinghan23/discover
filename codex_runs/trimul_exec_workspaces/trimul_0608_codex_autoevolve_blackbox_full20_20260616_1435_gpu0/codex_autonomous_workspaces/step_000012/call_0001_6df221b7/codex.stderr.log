codex
There is an unused fused `dim=384` projection kernel. It may be too slow for large cases, but it could win on smaller full20 shapes by avoiding the separate LayerNorm, cuBLAS projection, and post-transpose launches. I’ll benchmark it on small and public `dim=384` sizes.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32

def make(N,B,nomask):
 D=384;H=128;x=torch.randn((B,N,N,D),device='cuda');mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.15).float();w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')};return (x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})

def bench(N,B,nomask):
 data=make(N,B,nomask); x,mask,w,cfg=data;D=384;H=128;rows=B*N*N;key=(x.device,B,N,D,H);mask_arg=x if mask is None else mask
 for _ in range(2): s.custom_kernel(data)
 torch.cuda.synchronize()
 left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda');right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda');og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda')
 wl=s._buf(key,'wl384',(H,D),f16,'cuda');wr=s._buf(key,'wr384',(H,D),f16,'cuda');wlg=s._buf(key,'wlg384',(H,D),f16,'cuda');wrg=s._buf(key,'wrg384',(H,D),f16,'cuda');wog=s._buf(key,'wog384',(H,D),f16,'cuda')
 wl.copy_(w['left_proj.weight']);wr.copy_(w['right_proj.weight']);wlg.copy_(w['left_gate.weight']);wrg.copy_(w['right_gate.weight']);wog.copy_(w['out_gate.weight'])
 print('\\nfused384',N,B,nomask)
 for bm,bh,nw in [(16,32,4),(32,32,4),(64,32,4),(16,64,4),(32,64,4),(16,32,8),(32,32,8),(64,32,8)]:
  try:
   for _ in range(2): s._fused_proj384_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=N*N,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)
   torch.cuda.synchronize(); times=[]
   for _ in range(5):
    st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();s._fused_proj384_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=N*N,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw);en.record();en.synchronize();times.append(st.elapsed_time(en)*1000)

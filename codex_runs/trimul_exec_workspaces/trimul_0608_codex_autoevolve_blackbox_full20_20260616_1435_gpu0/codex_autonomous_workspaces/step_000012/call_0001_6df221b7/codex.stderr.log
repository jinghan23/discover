import torch,triton
import torch.nn.functional as F
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32
for D,N,B in [(384,1024,1),(384,768,1),(384,256,2),(768,512,1),(768,256,2)]:
 rows=B*N*N; x=torch.randn((B,N,N,D),device='cuda'); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda'); y=torch.empty_like(x,dtype=f16)
 if D==384:
  br=32 if N>=1024 else (16 if N>=768 else 4); nw=4 if N>=1024 else (1 if N>=768 else 2)
  k=lambda: s._input_ln384_kernel[(triton.cdiv(rows,br),)](x,w,b,y,rows=rows,BLOCK_R=br,num_warps=nw)

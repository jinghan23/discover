import torch,triton
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32

def make_case(N,B,nomask):
 D=384;H=128;x=torch.randn((B,N,N,D),device='cuda');mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.15).float();w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')};return (x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})

def prep(data):
 for _ in range(3): s.custom_kernel(data)
 torch.cuda.synchronize(); x,mask,w,cfg=data;B,N,_,D=x.shape;H=128;rows=B*N*N;key=(x.device,B,N,D,H);return x,mask,w,cfg,B,N,D,H,rows,key

def bench(data,configs):
 x,mask,w,cfg,B,N,D,H,rows,key=prep(data); n2=N*N; nomask=cfg['nomask'] or mask is None; mask_arg=x if mask is None else mask
 proj=s._buf(key,'proj',(B,N,N,5*H),f16,'cuda'); left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda'); right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda'); og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda')
 # proj already valid from custom; random enough.
 print('\\ncase',N,B,nomask)
 for br,bh,nw in configs:
  try:
   if nomask:
    fn=lambda: s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
   else:
    fn=lambda: s._post_proj_transpose_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
   for _ in range(3): fn()
   torch.cuda.synchronize();times=[]
   for _ in range(10):
    st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();fn();en.record();en.synchronize();times.append(st.elapsed_time(en)*1000)
   print((br,bh,nw),'med',sorted(times)[len(times)//2],'min',min(times))
  except Exception as e: print((br,bh,nw),'ERR',type(e).__name__,e)
configs=[(8,64,4),(16,64,4),(32,64,4),(64,64,4),(16,32,4),(32,32,4),(64,32,4),(16,128,4),(32,128,4),(8,64,8),(16,64,8),(32,64,8),(16,32,8),(32,32,8)]
for c in [(1024,1,True),(768,1,False),(256,2,False)]: bench(make_case(*c),configs)

import torch,triton
import submission as s

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32
stream=torch.cuda.Stream()

def make(N,B,dist='normal'):
 D=128;H=128;x=(torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda().float() if dist=='cauchy' else torch.randn((B,N,N,D),device='cuda'));w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')};return (x,None,w,{'dim':D,'hidden_dim':H,'nomask':True})

def split_call(data):
 x,mask,w,cfg=data;B,N,_,D=x.shape;H=128;rows=B*N*N;n2=N*N;key=(x.device,B,N,D,H);mask_arg=x
 left=s._buf(key,'left_b',(B*H,N,N),f16,'cuda');right=s._buf(key,'right_b',(B*H,N,N),f16,'cuda');og=s._buf(key,'out_gate',(B,N,N,H),f16,'cuda')
 wl=s._buf(key,'wl',(H,D),f16,'cuda');wr=s._buf(key,'wr',(H,D),f16,'cuda');wlg=s._buf(key,'wlg',(H,D),f16,'cuda');wrg=s._buf(key,'wrg',(H,D),f16,'cuda');wog=s._buf(key,'wog',(H,D),f16,'cuda')
 wl.copy_(w['left_proj.weight']);wr.copy_(w['right_proj.weight']);wlg.copy_(w['left_gate.weight']);wrg.copy_(w['right_gate.weight']);wog.copy_(w['out_gate.weight'])
 s._fused_proj128_lr_4q_kernel[(triton.cdiv(rows,64),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,left,right,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4)
 cur=torch.cuda.current_stream()
 stream.wait_stream(cur)
 with torch.cuda.stream(stream):
  s._fused_out_gate128_4q_kernel[(triton.cdiv(rows,64),)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wog,og,rows=rows,BLOCK_M=64,BLOCK_H=32,num_warps=4)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,'cuda')
 torch.bmm(left,right.transpose(1,2),out=out_h)
 cur.wait_stream(stream)
 out=s._buf(key,'out',(B,N,N,D),f32,'cuda');ow=s._buf(key,'to_out_h_t',(H,D),f16,'cuda');ow.copy_(w['to_out.weight'].t())
 s._ln_gate_out_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=64,num_warps=4)
 return out
for c in [(512,1,'normal'),(768,1,'cauchy'),(1024,1,'cauchy'),(256,2,'normal')]:
 data=make(*c)
 # compile both
 for _ in range(3): s.custom_kernel(data); split_call(data)
 torch.cuda.synchronize()
 for name,fn in [('base',lambda: s.custom_kernel(data)),('split',lambda: split_call(data))]:
  times=[]
  for _ in range(10):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
  print(c,name,'med',sorted(times)[len(times)//2],'min',min(times))

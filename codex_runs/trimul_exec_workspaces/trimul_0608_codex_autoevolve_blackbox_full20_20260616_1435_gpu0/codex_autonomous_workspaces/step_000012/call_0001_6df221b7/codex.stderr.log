def bench(N,B):
 D=384; rows=B*N*N; x=torch.randn((B,N,N,D),device='cuda'); y=torch.empty_like(x,dtype=f16); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda')
 print('\\ncase',N,B)
 for br,nw in [(1,1),(2,1),(4,1),(4,2),(8,1),(8,2),(16,1),(16,2),(32,1),(32,2),(32,4)]:

torch.cuda.set_device(0); f16=torch.float16; f32=torch.float32

def make(N,B):
 D=128;H=128;x=torch.randn((B,N,N,D),device='cuda');w={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')};return (x,None,w,{'dim':D,'hidden_dim':H,'nomask':True})
for N,B in [(128,1),(128,2),(256,1),(256,2)]:
 data=make(N,B)
 for _ in range(3): s.custom_kernel(data)

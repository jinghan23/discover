    nh = offs_r[:, None] * H + offs_h[None, :]
    tl.store(left_ptr + bh, l * tl.sigmoid(lg), mask=valid)
    tl.store(right_ptr + bh, r * tl.sigmoid(rg), mask=valid)
    tl.store(out_gate_ptr + nh, tl.sigmoid(og), mask=valid)



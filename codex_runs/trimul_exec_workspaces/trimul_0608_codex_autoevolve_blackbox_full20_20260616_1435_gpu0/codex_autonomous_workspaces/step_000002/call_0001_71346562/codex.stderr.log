import torch, triton
import torch.nn.functional as F
import submission as s

torch.backends.cuda.matmul.allow_tf32=True
torch.set_float32_matmul_precision('medium')

def make_case(N,B,D,nomask=True,H=128):
    device='cuda'; x=torch.randn((B,N,N,D),device=device); mask=torch.ones((B,N,N),device=device) if nomask else (torch.rand((B,N,N),device=device)>0.2).float()
    w={
    'norm.weight': torch.randn((D,),device=device), 'norm.bias': torch.randn((D,),device=device),
    'left_proj.weight': torch.randn((H,D),device=device), 'right_proj.weight': torch.randn((H,D),device=device),
    'left_gate.weight': torch.randn((H,D),device=device), 'right_gate.weight': torch.randn((H,D),device=device),
    'out_gate.weight': torch.randn((H,D),device=device), 'to_out_norm.weight': torch.randn((H,),device=device),
    'to_out_norm.bias': torch.randn((H,),device=device), 'to_out.weight': torch.randn((D,H),device=device)}
    return x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def split_proj(data):
    inp,mask,w,cfg=data; D=cfg['dim']; H=cfg['hidden_dim']; B=inp.shape[0]; N=inp.shape[1]; rows=B*N*N; n2=N*N; nomask=cfg['nomask'];
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    ev=[torch.cuda.Event(True) for _ in range(5)]
    ev[0].record()
    x=torch.empty_like(inp,dtype=torch.float16); s._input_ln_kernel[(rows,)](inp,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),x,D=D,BLOCK=triton.next_power_of_2(D),num_warps=1)
    ev[1].record()
    pw=s._proj_weight(w,torch.float16,D,H); proj=F.linear(x,pw)
    ev[2].record()
    s._post_proj_transpose_kernel[(triton.cdiv(rows,32),triton.cdiv(H,32))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=32,BLOCK_H=32,num_warps=4)
    ev[3].record(); torch.cuda.synchronize()
    return [ev[i].elapsed_time(ev[i+1])*1000 for i in range(3)]

for cfg in [(1024,1,384,True),(768,1,384,False),(256,2,384,False)]:
    torch.cuda.empty_cache(); data=make_case(*cfg)
    for _ in range(2): split_proj(data)
    vals=[split_proj(data) for _ in range(5)]
    avg=[sum(v[i] for v in vals)/len(vals) for i in range(3)]
    print(cfg, 'ln,linear,post us', [round(x,1) for x in avg])

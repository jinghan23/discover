/bin/bash -lc "python - <<'PY'
import torch, submission

torch.backends.cuda.matmul.allow_tf32=True
torch.set_float32_matmul_precision('medium')

def make_case(N,B,D,nomask=True,H=128):
    device='cuda'; x=torch.randn((B,N,N,D),device=device)*0.02; mask=torch.ones((B,N,N),device=device) if nomask else (torch.rand((B,N,N),device=device)>0.2).float(); scale=0.02
    w={'norm.weight': torch.ones((D,),device=device),'norm.bias': torch.zeros((D,),device=device),
       'left_proj.weight': torch.randn((H,D),device=device)*scale,'right_proj.weight': torch.randn((H,D),device=device)*scale,
       'left_gate.weight': torch.randn((H,D),device=device)*scale,'right_gate.weight': torch.randn((H,D),device=device)*scale,
       'out_gate.weight': torch.randn((H,D),device=device)*scale,'to_out_norm.weight': torch.ones((H,),device=device),
       'to_out_norm.bias': torch.zeros((H,),device=device),'to_out.weight': torch.randn((D,H),device=device)*scale}
    return x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def bench(data,reps=3):
    for _ in range(2): submission.custom_kernel(data)
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=submission.custom_kernel(data); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return sum(ts)/len(ts)
for cfg in [(256,2,384,False),(768,1,384,False),(1024,1,384,True)]:
    torch.cuda.empty_cache(); print(cfg, round(bench(make_case(*cfg)),1))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

codex
Before changing storage layout, I’m locally timing the central `bmm` with a transposed view versus a pre-transposed contiguous right operand. If cuBLAS already handles the view well, this avoids an invasive change.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N,BH in [(256,256),(512,128),(768,128),(1024,128)]:
    left=torch.randn((BH,N,N),device='cuda',dtype=torch.float16)
    right=torch.randn((BH,N,N),device='cuda',dtype=torch.float16)
    right_t=right.transpose(1,2).contiguous()
    for _ in range(5): torch.bmm(left,right.transpose(1,2)); torch.bmm(left,right_t)
    torch.cuda.synchronize()
    def bench(fn):
        ts=[]
        for _ in range(10):
            st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
        return sum(ts)/len(ts), min(ts)
    a=bench(lambda: torch.bmm(left,right.transpose(1,2)))
    b=bench(lambda: torch.bmm(left,right_t))
    print(N,BH,'view avg/min', [round(x,1) for x in a], 'contig avg/min', [round(x,1) for x in b])

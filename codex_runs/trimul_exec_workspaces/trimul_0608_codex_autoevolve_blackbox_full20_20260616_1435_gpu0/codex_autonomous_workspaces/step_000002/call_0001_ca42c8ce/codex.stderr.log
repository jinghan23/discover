+    valid_m = offs_m < rows
+    valid_d = offs_d < 384
+    valid_h = offs_h < H
+
+    x = tl.load(
+        x_ptr + offs_m[:, None] * 384 + offs_d[None, :],
+        mask=valid_m[:, None] & valid_d[None, :],
+        other=0.0,
+    ).to(tl.float32)
+    mean = tl.sum(tl.where(valid_d[None, :], x, 0.0), axis=1) * (1.0 / 384.0)
+    xc = tl.where(valid_d[None, :], x - mean[:, None], 0.0)
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 384.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(norm_w_ptr + offs_d, mask=valid_d, other=0.0).to(tl.float32)
+    nb = tl.load(norm_b_ptr + offs_d, mask=valid_d, other=0.0).to(tl.float32)
+    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
+
+    woffs = offs_h[None, :] * 384 + offs_d[:, None]
+    wmask = valid_d[:, None] & valid_h[None, :]

+    lg1 = tl.dot(xn, wlg1)
+    tl.store(left_ptr + bh1, l1 * tl.sigmoid(lg1) * m[:, None], mask=valid)
+    wr1 = tl.load(wr_ptr + woffs1)
+    wrg1 = tl.load(wrg_ptr + woffs1)
+    r1 = tl.dot(xn, wr1)
+    rg1 = tl.dot(xn, wrg1)
+    tl.store(right_ptr + bh1, r1 * tl.sigmoid(rg1) * m[:, None], mask=valid)
+    wog1 = tl.load(wog_ptr + woffs1)
+    og1 = tl.dot(xn, wog1)
+    tl.store(out_gate_ptr + out1, tl.sigmoid(og1), mask=valid)
+
+

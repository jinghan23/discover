def custom_kernel(data):
    input_tensor, mask, weights, config = data
    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])
    batch_size = input_tensor.shape[0]
    seq_len = input_tensor.shape[1]
    x_in = input_tensor.contiguous()
    proj_dtype = torch.float16
    shape_nomask = (dim == 128) or (dim == 384 and batch_size == 1 and seq_len == 1024)
    nomask = bool(config.get("nomask", False)) or shape_nomask or mask is None
    out_gate = torch.empty((rows, hidden_dim), device=input_tensor.device, dtype=torch.float16)
    rows = batch_size * seq_len * seq_len
    n2 = seq_len * seq_len
    mask_arg = input_tensor if mask is None else mask

    if dim == 128 and hidden_dim == 128:
        left_b = torch.empty((batch_size * hidden_dim, seq_len, seq_len), device=input_tensor.device, dtype=torch.float16)
        right_b = torch.empty_like(left_b)
        wl, wr, wlg, wrg, wog = _proj_parts(weights, torch.float16, dim, hidden_dim)
        _fused_proj128_kernel[(triton.cdiv(rows, 64), triton.cdiv(hidden_dim, 64))](
            x_in,
            mask_arg,
            weights["norm.weight"],
            weights["norm.bias"],
            wl,
            wr,
            wlg,
            wrg,
            wog,
            left_b,
            right_b,
            out_gate,
            rows=rows,
            n2=n2,
            H=hidden_dim,
            NOMASK=nomask,
            BLOCK_M=64,
            BLOCK_H=64,
            num_warps=4,
        )
    elif False and dim == 384 and hidden_dim == 128:
        left_b = torch.empty((batch_size * hidden_dim, seq_len, seq_len), device=input_tensor.device, dtype=torch.float16)
        right_b = torch.empty_like(left_b)
        wl, wr, wlg, wrg, wog = _proj_parts(weights, torch.float16, dim, hidden_dim)
        _fused_proj384_kernel[(triton.cdiv(rows, 16), triton.cdiv(hidden_dim, 64))](
            x_in,
            mask_arg,
            weights["norm.weight"],
            weights["norm.bias"],
            wl,
            wr,
            wlg,
            wrg,
            wog,
            left_b,
            right_b,
            out_gate,
            rows=rows,
            n2=n2,
            H=hidden_dim,
            NOMASK=nomask,
            BLOCK_M=16,
            BLOCK_H=64,
            BLOCK_D=512,
            num_warps=4,
        )


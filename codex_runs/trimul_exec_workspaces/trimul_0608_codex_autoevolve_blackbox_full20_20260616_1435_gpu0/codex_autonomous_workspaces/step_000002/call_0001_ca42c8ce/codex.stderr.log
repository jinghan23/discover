diff --git a/submission.py b/submission.py
index f8dc42f1b1912c0d2ebd85dc1f7d4fb7b09bb776..e42a9d99e81ffc0ea97075e9a7cd63bbf2bb34db
--- a/submission.py
+++ b/submission.py
@@ -119,6 +119,54 @@
 
 
 @triton.jit
+def _ln_gate_outproj_kernel(
+    x_ptr,
+    gate_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    out_w_ptr,
+    out_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_r = tl.program_id(0)
+    pid_d = tl.program_id(1)
+    offs_r = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_d = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    offs_h = tl.arange(0, BLOCK_H)
+    valid_r = offs_r < rows
+    valid_h = offs_h < H
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None] & valid_h[None, :], other=0.0).to(tl.float32)
+    mean = tl.sum(tl.where(valid_h[None, :], x, 0.0), axis=1) / H
+    xc = tl.where(valid_h[None, :], x - mean[:, None], 0.0)
+    var = tl.sum(xc * xc, axis=1) / H
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(norm_w_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    nb = tl.load(norm_b_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    g = tl.load(gate_ptr + offs_r[:, None] * H + offs_h[None, :], mask=valid_r[:, None] & valid_h[None, :], other=0.0).to(tl.float32)
+    y = (xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g
+    w = tl.load(
+        out_w_ptr + offs_d[None, :] * H + offs_h[:, None],
+        mask=(offs_d[None, :] < D) & valid_h[:, None],
+        other=0.0,
+    ).to(tl.float32)
+    acc = tl.dot(y, w, input_precision="tf32")
+    tl.store(
+        out_ptr + offs_r[:, None] * D + offs_d[None, :],
+        acc,
+        mask=valid_r[:, None] & (offs_d[None, :] < D),
+    )
+
+
+@triton.jit
 def _input_ln_kernel(x_ptr, w_ptr, b_ptr, y_ptr, D: tl.constexpr, BLOCK: tl.constexpr):
     row = tl.program_id(0)
     offs = tl.arange(0, BLOCK)
@@ -261,7 +309,7 @@
         left_b = torch.empty((batch_size * hidden_dim, seq_len, seq_len), device=input_tensor.device, dtype=torch.float16)
         right_b = torch.empty_like(left_b)
         wl, wr, wlg, wrg, wog = _proj_parts(weights, torch.float16, dim, hidden_dim)
-        _fused_proj128_kernel[(triton.cdiv(rows, 32), triton.cdiv(hidden_dim, 32))](

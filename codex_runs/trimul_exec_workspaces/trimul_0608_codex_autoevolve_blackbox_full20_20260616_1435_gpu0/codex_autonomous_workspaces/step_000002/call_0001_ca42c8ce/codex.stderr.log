+    x1 = tl.load(
+        x_ptr + offs_m[:, None] * 384 + offs1[None, :],
+        mask=valid_m[:, None],
+        other=0.0,
+    ).to(tl.float32)
+    mean = (tl.sum(x0, axis=1) + tl.sum(x1, axis=1)) * (1.0 / 384.0)
+    xc0 = x0 - mean[:, None]
+    xc1 = x1 - mean[:, None]
+    var = (tl.sum(xc0 * xc0, axis=1) + tl.sum(xc1 * xc1, axis=1)) * (1.0 / 384.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw0 = tl.load(norm_w_ptr + offs0).to(tl.float32)
+    nb0 = tl.load(norm_b_ptr + offs0).to(tl.float32)
+    nw1 = tl.load(norm_w_ptr + offs1).to(tl.float32)
+    nb1 = tl.load(norm_b_ptr + offs1).to(tl.float32)
+    xn0 = (xc0 * rstd[:, None] * nw0[None, :] + nb0[None, :]).to(tl.float16)
+    xn1 = (xc1 * rstd[:, None] * nw1[None, :] + nb1[None, :]).to(tl.float16)
+
+    m = tl.full((BLOCK_M,), 1.0, tl.float32)
+    if not NOMASK:
+        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
+    bidx = offs_m // n2
+    ij = offs_m - bidx * n2
+    valid = valid_m[:, None]

/bin/bash -lc "python - <<'PY'
import torch
for N in [256,512,768,1024]:
    a=torch.randn(128,N,N,device='cuda',dtype=torch.float16)
    b=torch.randn(128,N,N,device='cuda',dtype=torch.float16)
    out=torch.empty_like(a)
    for _ in range(10): torch.bmm(a,b.transpose(1,2),out=out)
    torch.cuda.synchronize()
    ts=[]
    for _ in range(20):
        e0=torch.cuda.Event(True); e1=torch.cuda.Event(True)
        e0.record(); torch.bmm(a,b.transpose(1,2),out=out); e1.record(); torch.cuda.synchronize()
        ts.append(e0.elapsed_time(e1)*1000)
    print(N, min(ts), sum(ts)/len(ts))

                rows=in_rows,
                BLOCK_R=ln_br,
                num_warps=ln_warps,
            )
        elif dim == 768:
            ln_br = 8 if in_rows >= 524288 else 2
            _input_ln768_kernel[(triton.cdiv(in_rows, ln_br),)](
                x_in,
                norm_w.to(f32),
                norm_b.to(f32),
                x,
                rows=in_rows,
                BLOCK_R=ln_br,
                num_warps=1,
            )
        else:
            _input_ln_kernel[(in_rows,)](
                x_in,
                norm_w.to(f32),
                norm_b.to(f32),
                x,
                D=dim,
                BLOCK=triton.next_power_of_2(dim),
                num_warps=1,

   340	    var = tl.sum(xc * xc, axis=0) / D
   341	    rstd = tl.rsqrt(var + 1.0e-5)
   342	    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
   343	    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
   344	    tl.store(y_ptr + base, xc * rstd * w + b, mask=mask)

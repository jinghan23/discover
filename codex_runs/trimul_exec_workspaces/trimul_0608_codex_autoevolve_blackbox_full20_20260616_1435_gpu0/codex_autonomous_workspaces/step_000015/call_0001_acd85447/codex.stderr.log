+    g = tl.sigmoid(gpre).to(tl.float16).to(tl.float32)
+    y = ((xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g).to(tl.float16)
+    tl.store(y_ptr + offs_r[:, None] * H + offs_h[None, :], y, mask=valid_r[:, None])

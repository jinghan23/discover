                rows=rows,
                n2=n2,
                H=hidden_dim,
                D=dim,
                BLOCK_R=br,
                BLOCK_D=32,
                num_warps=4,
            )
        else:
            _ln_gate_out_proj_gate_kernel[(triton.cdiv(rows, br),)](
                out_h,
                proj,
                out_norm_w.to(f32),

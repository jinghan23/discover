    cached = _TO_OUT_CACHE.get(key)
    if cached is None:
        if len(_TO_OUT_CACHE) > 32:
            _TO_OUT_CACHE.clear()
        cached = ref.to(dtype).t().contiguous()
        _TO_OUT_CACHE[key] = cached
    return cached


def _vec_to(ref, dtype):
    key = (str(dtype), ref.data_ptr(), ref._version)
    cached = _VEC_CACHE.get(key)
    if cached is None:

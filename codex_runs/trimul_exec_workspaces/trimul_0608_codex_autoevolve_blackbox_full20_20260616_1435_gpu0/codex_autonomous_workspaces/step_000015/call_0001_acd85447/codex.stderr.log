                rows=rows,
                n2=n2,
                H=hidden_dim,
                D=dim,
                BLOCK_R=br,
                BLOCK_D=32,
                num_warps=4,
            )
        elif not (dim == 384 or dim == 768):
            _ln_gate_out_kernel[(triton.cdiv(rows, br),)](
                out_h,
                out_gate,
                out_norm_w.to(f32),
                out_norm_b.to(f32),
                to_out_h_t,

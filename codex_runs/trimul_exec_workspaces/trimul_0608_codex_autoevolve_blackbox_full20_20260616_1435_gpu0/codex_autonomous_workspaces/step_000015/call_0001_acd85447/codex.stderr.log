from torch.profiler import profile, ProfilerActivity

def make(bs,N,D,H,nomask):
    x=torch.randn(bs,N,N,D,device='cuda',dtype=torch.float32)
    mask=None if nomask else (torch.rand(bs,N,N,device='cuda')>0.2).float()
    weights={
        'norm.weight': torch.randn(D,device='cuda'),
        'norm.bias': torch.randn(D,device='cuda'),
        'left_proj.weight': torch.randn(H,D,device='cuda'),
        'right_proj.weight': torch.randn(H,D,device='cuda'),
        'left_gate.weight': torch.randn(H,D,device='cuda'),
        'right_gate.weight': torch.randn(H,D,device='cuda'),
        'out_gate.weight': torch.randn(H,D,device='cuda'),
        'to_out_norm.weight': torch.randn(H,device='cuda'),
        'to_out_norm.bias': torch.randn(H,device='cuda'),
        'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

for case in [(1,1024,384,128,True),(1,1024,128,128,True),(1,768,384,128,False),(2,256,384,128,False)]:
    torch.cuda.empty_cache()
    data=make(*case)
    for _ in range(5): submission.custom_kernel(data)
    torch.cuda.synchronize()
    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA], record_shapes=False) as prof:
        submission.custom_kernel(data)
        torch.cuda.synchronize()
    print('\\nCASE', case)
    print(prof.key_averages().table(sort_by='cuda_time_total', row_limit=20))

        if nomask and use_proj_gate:
            _post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows, 32), triton.cdiv(hidden_dim, 64))](
                proj,
                left_b,
                right_b,
                rows=rows,
                n2=n2,
                H=hidden_dim,
                BLOCK_R=32,
                BLOCK_H=64,
                num_warps=8,

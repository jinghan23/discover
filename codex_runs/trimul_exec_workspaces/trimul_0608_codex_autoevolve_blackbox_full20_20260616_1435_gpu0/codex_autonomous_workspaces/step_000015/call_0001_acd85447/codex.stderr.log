   444	@triton.jit
   445	def _fused_proj128_4q_kernel(
   446	    x_ptr,
   447	    mask_ptr,
   448	    norm_w_ptr,
   449	    norm_b_ptr,
   450	    wl_ptr,
   451	    wr_ptr,
   452	    wlg_ptr,
   453	    wrg_ptr,
   454	    wog_ptr,
   455	    left_ptr,
   456	    right_ptr,
   457	    out_gate_ptr,
   458	    rows: tl.constexpr,
   459	    n2: tl.constexpr,
   460	    NOMASK: tl.constexpr,
   461	    BLOCK_M: tl.constexpr,
   462	    BLOCK_H: tl.constexpr,
   463	):
   464	    pid_m = tl.program_id(0)
   465	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   466	    offs_d = tl.arange(0, 128)
   467	    offs_h_base = tl.arange(0, BLOCK_H)
   468	    valid_m = offs_m < rows
   469	
   470	    x = tl.load(
   471	        x_ptr + offs_m[:, None] * 128 + offs_d[None, :],
   472	        mask=valid_m[:, None],
   473	        other=0.0,
   474	    ).to(tl.float32)
   475	    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
   476	    xc = x - mean[:, None]
   477	    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
   478	    rstd = tl.rsqrt(var + 1.0e-5)
   479	    nw = tl.load(norm_w_ptr + offs_d).to(tl.float32)
   480	    nb = tl.load(norm_b_ptr + offs_d).to(tl.float32)
   481	    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
   482	
   483	    m = tl.full((BLOCK_M,), 1.0, tl.float32)
   484	    if not NOMASK:
   485	        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
   486	    bidx = offs_m // n2
   487	    ij = offs_m - bidx * n2
   488	    valid = valid_m[:, None]
   489	
   490	    for q in tl.static_range(0, 128 // BLOCK_H):
   491	        offs_h = offs_h_base + q * BLOCK_H
   492	        woffs = offs_h[None, :] * 128 + offs_d[:, None]
   493	        out = offs_m[:, None] * 128 + offs_h[None, :]
   494	        bh = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
   495	        wl = tl.load(wl_ptr + woffs)
   496	        wlg = tl.load(wlg_ptr + woffs)
   497	        l = tl.dot(xn, wl)
   498	        lg = tl.dot(xn, wlg)
   499	        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)
   500	        wr = tl.load(wr_ptr + woffs)
   501	        wrg = tl.load(wrg_ptr + woffs)
   502	        r = tl.dot(xn, wr)
   503	        rg = tl.dot(xn, wrg)
   504	        tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
   505	        wog = tl.load(wog_ptr + woffs)
   506	        og = tl.dot(xn, wog)
   507	        tl.store(out_gate_ptr + out, og, mask=valid)
   508	

import torch, time, importlib
import submission

torch.manual_seed(0)

def make(case):
    bs,N,D,H,nomask=case['bs'],case['seqlen'],case['dim'],case['hidden_dim'],case['nomask']
    x=torch.randn(bs,N,N,D,device='cuda',dtype=torch.float32)
    mask=None if nomask else (torch.rand(bs,N,N,device='cuda')>0.2).float()
    weights={
        'norm.weight': torch.randn(D,device='cuda'),
        'norm.bias': torch.randn(D,device='cuda'),
        'left_proj.weight': torch.randn(H,D,device='cuda'),
        'right_proj.weight': torch.randn(H,D,device='cuda'),
        'left_gate.weight': torch.randn(H,D,device='cuda'),
        'right_gate.weight': torch.randn(H,D,device='cuda'),
        'out_gate.weight': torch.randn(H,D,device='cuda'),
        'to_out_norm.weight': torch.randn(H,device='cuda'),
        'to_out_norm.bias': torch.randn(H,device='cuda'),
        'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    config={'dim':D,'hidden_dim':H,'nomask':nomask}
    return (x,mask,weights,config)

cases=[
 {'seqlen':256,'bs':2,'dim':128,'hidden_dim':128,'nomask':True},
 {'seqlen':768,'bs':1,'dim':128,'hidden_dim':128,'nomask':True},
 {'seqlen':256,'bs':2,'dim':384,'hidden_dim':128,'nomask':False},
 {'seqlen':512,'bs':1,'dim':128,'hidden_dim':128,'nomask':True},
 {'seqlen':1024,'bs':1,'dim':128,'hidden_dim':128,'nomask':True},
 {'seqlen':768,'bs':1,'dim':384,'hidden_dim':128,'nomask':False},
 {'seqlen':1024,'bs':1,'dim':384,'hidden_dim':128,'nomask':True},
]
for case in cases:
    torch.cuda.empty_cache()
    data=make(case)
    for _ in range(5):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        t0=torch.cuda.Event(True); t1=torch.cuda.Event(True)
        t0.record(); y=submission.custom_kernel(data); t1.record();
        torch.cuda.synchronize(); times.append(t0.elapsed_time(t1)*1000)
    print(case, 'mean', sum(times)/len(times), 'min', min(times), 'times', [round(t,1) for t in times])

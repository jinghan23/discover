        + tl.sum(x3, axis=1)
        + tl.sum(x4, axis=1)
        + tl.sum(x5, axis=1)
    ) * (1.0 / 768.0)
    xc0 = x0 - mean[:, None]
    xc1 = x1 - mean[:, None]
    xc2 = x2 - mean[:, None]
    xc3 = x3 - mean[:, None]
    xc4 = x4 - mean[:, None]
    xc5 = x5 - mean[:, None]

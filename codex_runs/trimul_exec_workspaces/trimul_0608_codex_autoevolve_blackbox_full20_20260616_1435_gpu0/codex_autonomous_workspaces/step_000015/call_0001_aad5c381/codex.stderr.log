To get better signal than the aggregate score, I’m going to run a local synthetic benchmark of the baseline by listed shape. It won’t replace the blackbox score, but it will show which branches are actually consuming time.
exec
/bin/bash -lc "python - <<'PY'
import torch, time, importlib
import submission

torch.manual_seed(0)
shapes = [
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True},
]

def weights(dim,h,device):
    return {
        'norm.weight': torch.randn(dim,device=device),
        'norm.bias': torch.randn(dim,device=device),
        'left_proj.weight': torch.randn(h,dim,device=device),
        'right_proj.weight': torch.randn(h,dim,device=device),
        'left_gate.weight': torch.randn(h,dim,device=device),
        'right_gate.weight': torch.randn(h,dim,device=device),
        'out_gate.weight': torch.randn(h,dim,device=device),
        'to_out_norm.weight': torch.randn(h,device=device),
        'to_out_norm.bias': torch.randn(h,device=device),
        'to_out.weight': torch.randn(dim,h,device=device),
    }

device='cuda'
for cfg in shapes:
    N=cfg['seqlen']; B=cfg['bs']; D=cfg['dim']; H=cfg['hidden_dim']
    torch.cuda.empty_cache()
    x=torch.randn((B,N,N,D),device=device)
    mask=None if cfg['nomask'] else (torch.rand((B,N,N),device=device)>0.2).float()
    w=weights(D,H,device)
    data=(x,mask,w,cfg)
    for _ in range(3):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(5):
        start=torch.cuda.Event(True); end=torch.cuda.Event(True)
        start.record(); y=submission.custom_kernel(data); end.record(); torch.cuda.synchronize()
        times.append(start.elapsed_time(end)*1000)
    print(cfg, 'us', sum(times)/len(times), 'min', min(times))

import torch, triton, submission as s

def ev(fn,reps=10):
 for _ in range(3): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(reps):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
 return sum(vals)/len(vals), min(vals)
for N,D,B in [(1024,384,1),(768,384,1),(256,384,2),(1024,128,1),(768,128,1),(512,128,1),(256,128,2)]:
 H=128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
 key=('outvar',B,N,D,H)
 out_h=s._buf(key,'oh',(B*H,N,N),f16,torch.device('cuda')).normal_()
 out_gate=s._buf(key,'og',(B,N,N,H),f16,torch.device('cuda')).normal_()
 nw=torch.randn(H,device='cuda'); nb=torch.randn(H,device='cuda'); tw=torch.randn(D,H,device='cuda')
 out=s._buf(key,'out',(B,N,N,D),f32,torch.device('cuda'))
 to_h=s._buf(key,'tow',(H,D),f16,torch.device('cuda')); to_h.copy_(tw.t())
 out_hv=out_h.view(B,H,N,N)
 br=128 if D==384 else 64
 def fused():
  s._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_hv,out_gate,nw.to(f32),nb.to(f32),to_h,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
 gated=s._buf(key,'gated',(B,N,N,H),f32,torch.device('cuda'))
 def two_f32():
  s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_hv,out_gate,nw.to(f32),nb.to(f32),gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
  torch.mm(gated.view(rows,H), tw.to(f32).t(), out=out.view(rows,D))
 print('\\nN,D,B',N,D,B)
 print('fused', tuple(round(x,1) for x in ev(fused,8)))
 print('tile+mm_f32', tuple(round(x,1) for x in ev(two_f32,8)))

import torch, triton, submission as s

def ev(fn,reps=5):
 for _ in range(3): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(reps):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
 return round(sum(vals)/len(vals),1), round(min(vals),1)
for N,B in [(1024,1),(768,1),(512,1),(256,2)]:
 D=H=128; rows=B*N*N; n2=N*N; dev=torch.device('cuda')
 key=('tuneproj128',B,N,D)
 x=torch.randn(B,N,N,D,device=dev); mask=x
 left=s._buf(key,'left',(B*H,N,N),torch.float16,dev); right=s._buf(key,'right',(B*H,N,N),torch.float16,dev); og=s._buf(key,'og',(B,N,N,H),torch.float16,dev)
 nw=torch.randn(D,device=dev); nb=torch.randn(D,device=dev)
 bufs=[]
 for name in ['wl','wr','wlg','wrg','wog']:
  b=s._buf(key,name,(H,D),torch.float16,dev); b.normal_(); bufs.append(b)
 print('\\ncase',N,B)
 for BM in [16,32,64,128,256]:
  for BH in [16,32,64,128]:
   if H % BH: continue
   for NW in [4,8]:
    def fn(BM=BM,BH=BH,NW=NW):
     s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask,nw.to(torch.float32),nb.to(torch.float32),*bufs,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=NW)
    try:

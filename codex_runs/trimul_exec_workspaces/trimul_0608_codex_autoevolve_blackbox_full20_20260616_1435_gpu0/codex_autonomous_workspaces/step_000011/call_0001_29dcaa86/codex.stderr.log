codex
The D=384 post-projection transpose/gate kernel is another non-GEMM hot spot, especially for large N. I’m sweeping its row/channel tile choices for masked and unmasked cases.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s

def ev(fn,reps=6):
 for _ in range(3): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(reps):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
 return round(sum(vals)/len(vals),1), round(min(vals),1)
for N,B,maskflag in [(1024,1,False),(768,1,True),(256,2,True)]:
 H=128; rows=B*N*N; n2=N*N; dev=torch.device('cuda')
 key=('tunepost',B,N,H,maskflag)
 proj=s._buf(key,'proj',(B,N,N,5*H),torch.float16,dev).normal_()
 left=s._buf(key,'left',(B*H,N,N),torch.float16,dev); right=s._buf(key,'right',(B*H,N,N),torch.float16,dev); og=s._buf(key,'og',(B,N,N,H),torch.float16,dev)
 mask=(torch.rand(B,N,N,device=dev)>0.2).float() if maskflag else None
 print('\\ncase',N,B,'mask',maskflag)
 for BR in [8,16,32,64,128]:
  for BH in [32,64,128]:
   if H % BH: continue
   for NW in [4,8]:
    def fn(BR=BR,BH=BH,NW=NW):
     if maskflag:
      s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=BR,BLOCK_H=BH,num_warps=NW)
     else:
      s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=NW)
    try:
     print('BR',BR,'BH',BH,'w',NW,'mean/min',ev(fn,4))
    except Exception as e:
     print('ERR',BR,BH,NW,type(e).__name__,str(e)[:50])
     torch.cuda.synchronize()
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace
diff --git a/submission.py b/submission.py
index 6bd39ecf71ef857b0ef0e04e2ca93d2fc32f2d13..bc749394e500d1a37ed9fcd80e19095760be849b
--- a/submission.py
+++ b/submission.py
@@ -19,6 +19,7 @@
 _PROJ_PARTS_CACHE = {}
 _TO_OUT_CACHE = {}
 _VEC_CACHE = {}
+_TENSOR_CACHE = {}
 _BUF_CACHE = {}
 _BUF_SHAPE = None
 
@@ -73,7 +74,7 @@
 
 
 def _vec_to(ref, dtype):
-    key = (str(dtype), ref.data_ptr(), ref._version)
+    key = (str(dtype), id(ref), ref.data_ptr(), ref._version)
     cached = _VEC_CACHE.get(key)
     if cached is None:
         if len(_VEC_CACHE) > 32:
@@ -83,6 +84,50 @@
     return cached
 
 
+def _cached_to(ref, dtype):
+    key = ("to", str(dtype), id(ref), ref.data_ptr(), ref._version, tuple(ref.shape))
+    cached = _TENSOR_CACHE.get(key)
+    if cached is None:
+        if len(_TENSOR_CACHE) > 64:
+            _TENSOR_CACHE.clear()
+        cached = ref.to(dtype).contiguous()
+        _TENSOR_CACHE[key] = cached
+    return cached
+

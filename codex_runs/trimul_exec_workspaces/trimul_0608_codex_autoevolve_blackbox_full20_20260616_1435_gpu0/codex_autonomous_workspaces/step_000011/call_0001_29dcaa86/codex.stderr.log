import torch, triton
import submission as s

def weights(dim,h):
    return {
        'norm.weight': torch.randn(dim,device='cuda'),
        'norm.bias': torch.randn(dim,device='cuda'),
        'left_proj.weight': torch.randn(h,dim,device='cuda'),
        'right_proj.weight': torch.randn(h,dim,device='cuda'),
        'left_gate.weight': torch.randn(h,dim,device='cuda'),
        'right_gate.weight': torch.randn(h,dim,device='cuda'),
        'out_gate.weight': torch.randn(h,dim,device='cuda'),
    }

def evtime(fn, reps=10):
    for _ in range(3): fn()
    torch.cuda.synchronize()
    vals=[]
    for _ in range(reps):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
    return sum(vals)/len(vals), min(vals)

for N,maskflag in [(1024,False),(768,True),(256,True)]:
  B=1 if N"'!=256 else 2; D=384; H=128; rows=B*N*N; n2=N*N
  x=torch.randn(B,N,N,D,device='"'cuda')
  mask=None if not maskflag else (torch.rand(B,N,N,device='cuda')>0.2).float()
  w=weights(D,H)
  key=('fused384',B,N,D,H,maskflag)
  left=s._buf(key,'left_b',(B*H,N,N),torch.float16,x.device)
  right=s._buf(key,'right_b',(B*H,N,N),torch.float16,x.device)
  og=s._buf(key,'out_gate',(B,N,N,H),torch.float16,x.device)
  bufs=[]
  for name,k in [('wl','left_proj.weight'),('wr','right_proj.weight'),('wlg','left_gate.weight'),('wrg','right_gate.weight'),('wog','out_gate.weight')]:
      b=s._buf(key,name,(H,D),torch.float16,x.device); b.copy_(w[k]); bufs.append(b)

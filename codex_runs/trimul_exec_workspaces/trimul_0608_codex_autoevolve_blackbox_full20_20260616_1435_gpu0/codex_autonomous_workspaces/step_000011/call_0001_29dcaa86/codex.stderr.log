import torch, triton, submission as s

def ev(fn,reps=8):
 for _ in range(3): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(reps):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
 return round(sum(vals)/len(vals),1), round(min(vals),1)
for N,B,maskflag in [(1024,1,False),(768,1,True),(256,2,True),(1024,1,True)]:
 H=128; rows=B*N*N; n2=N*N; dev=torch.device('cuda'); key=('postt',B,N,maskflag)
 proj=s._buf(key,'proj',(B,N,N,5*H),torch.float16,dev).normal_(); left=s._buf(key,'left',(B*H,N,N),torch.float16,dev); right=s._buf(key,'right',(B*H,N,N),torch.float16,dev); og=s._buf(key,'og',(B,N,N,H),torch.float16,dev)
 mask=(torch.rand(B,N,N,device=dev)>0.2).float() if maskflag else torch.empty(1,device=dev)
 print('\\ncase',N,B,'mask',maskflag)
 print('normal', ev(lambda: (s._post_proj_transpose_kernel if maskflag else s._post_proj_transpose_nomask_kernel)[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=not maskflag,BLOCK_R=16,BLOCK_H=64,num_warps=8) if maskflag else s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8),6))
 print('t', ev(lambda: s._post_proj_transpose_t_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=not maskflag,BLOCK_R=16,BLOCK_H=64,num_warps=8),6))

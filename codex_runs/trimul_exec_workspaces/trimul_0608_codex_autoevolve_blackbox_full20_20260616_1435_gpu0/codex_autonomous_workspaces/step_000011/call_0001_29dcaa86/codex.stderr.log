+    adj = raw * nw
+    tl.store(adj_w_ptr + row * 384 + offs, adj, mask=mask)
+    tl.store(aff_s_ptr + row, tl.sum(adj, axis=0))
+    tl.store(aff_b_ptr + row, tl.sum(raw * nb, axis=0))

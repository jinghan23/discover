import torch, triton, submission as s

def ev(fn,reps=10):
 for _ in range(3): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(reps):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)

/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def weights(dim,h):
    return {
        'norm.weight': torch.randn(dim,device='cuda'),
        'norm.bias': torch.randn(dim,device='cuda'),
        'left_proj.weight': torch.randn(h,dim,device='cuda'),
        'right_proj.weight': torch.randn(h,dim,device='cuda'),
        'left_gate.weight': torch.randn(h,dim,device='cuda'),
        'right_gate.weight': torch.randn(h,dim,device='cuda'),
        'out_gate.weight': torch.randn(h,dim,device='cuda'),
        'to_out_norm.weight': torch.randn(h,device='cuda'),
        'to_out_norm.bias': torch.randn(h,device='cuda'),
        'to_out.weight': torch.randn(dim,h,device='cuda'),
    }

def evtime(fn, reps=10):
    # warm
    for _ in range(3): fn()
    torch.cuda.synchronize()
    vals=[]
    for _ in range(reps):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True)
        a.record(); fn(); b.record(); b.synchronize()
        vals.append(a.elapsed_time(b)*1000)
    return sum(vals)/len(vals), min(vals)

for N,D,B,maskflag in [(1024,384,1,False),(768,384,1,True),(1024,128,1,False)]:
    H=128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
    cfg={'seqlen':N,'bs':B,'dim':D,'hidden_dim':H,'nomask':not maskflag}
    x_in=torch.randn(B,N,N,D,device='cuda')
    mask=None if not maskflag else (torch.rand(B,N,N,device='cuda')>0.2).float()
    w=weights(D,H)
    key=('cuda',B,N,D,H,'profile')
    out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,x_in.device)
    left_b=s._buf(key,'left_b',(B*H,N,N),f16,x_in.device)
    right_b=s._buf(key,'right_b',(B*H,N,N),f16,x_in.device)
    out_h_flat=s._buf(key,'out_h',(B*H,N,N),f16,x_in.device)
    out=s._buf(key,'out',(B,N,N,D),f32,x_in.device)
    print('\\ncase',N,D,'mask',maskflag)
    if D==384:
        x=s._buf(key,'x_norm',x_in.shape,f16,x_in.device)
        in_rows=x.numel()//D
        ln_br=16 if N>=768 else 4
        def ln():
            s._input_ln384_kernel[(triton.cdiv(in_rows,ln_br),)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=in_rows,BLOCK_R=ln_br,num_warps=1)
        print('ln', evtime(ln,10))
        proj_w=s._buf(key,'proj_w',(5*H,D),f16,x_in.device)
        def cat():
            torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
        print('cat', evtime(cat,10))
        cat()
        proj=s._buf(key,'proj',(B,N,N,5*H),f16,x_in.device)
        def mm():
            torch.mm(x.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
        print('proj_mm', evtime(mm,10))
        mm()
        mask_arg=x_in if mask is None else mask
        def post():
            if mask is None:
                s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
            else:
                s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
        print('post', evtime(post,10))
        post()
    else:
        # D128 fused projection
        bufs=[s._buf(key,name,(H,D),f16,x_in.device) for name in ['wl','wr','wlg','wrg','wog']]
        for buf,k in zip(bufs,['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight']): buf.copy_(w[k])
        def fused():
            s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),*bufs,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4)
        print('fused_proj', evtime(fused,10))
        fused()
    def bmm():
        torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat)
    print('bmm', evtime(bmm,10))
    bmm()
    to_out=s._buf(key,'to_out_h_t',(H,D),f16,x_in.device); to_out.copy_(w['to_out.weight'].t())
    out_h=out_h_flat.view(B,H,N,N)
    br=128 if D==384 else 64
    def outp():
        s._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,out_gate,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to_out,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
    print('out_proj', evtime(outp,10))

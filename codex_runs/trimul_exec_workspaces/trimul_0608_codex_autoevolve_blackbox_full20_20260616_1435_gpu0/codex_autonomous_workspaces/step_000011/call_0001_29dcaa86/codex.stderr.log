codex
For N=256/D=384 the fused front half is near the staged total, so it is still not useful once bmm and output are included. I’m profiling the staged N=256/D=384 case just to avoid missing a small-shape branch.
exec
/bin/bash -lc "python - <<'PY'
# Quick staged phase profile for 256x384 mask case
import torch, triton, submission as s
B,N,D,H=2,256,384,128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
x_in=torch.randn(B,N,N,D,device='cuda'); mask=(torch.rand(B,N,N,device='cuda')>0.2).float()
w={
'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),
'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),
'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda'),
'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')}
key=('stage256',B,N,D,H); x=s._buf(key,'x_norm',x_in.shape,f16,x_in.device); left=s._buf(key,'left',(B*H,N,N),f16,x_in.device); right=s._buf(key,'right',(B*H,N,N),f16,x_in.device); og=s._buf(key,'og',(B,N,N,H),f16,x_in.device); proj_w=s._buf(key,'pw',(5*H,D),f16,x_in.device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,x_in.device); oh=s._buf(key,'oh',(B*H,N,N),f16,x_in.device); out=s._buf(key,'out',(B,N,N,D),f32,x_in.device); tow=s._buf(key,'tow',(H,D),f16,x_in.device); tow.copy_(w['to_out.weight'].t()); torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
def ev(fn):
 for _ in range(4): fn()
 torch.cuda.synchronize(); vals=[]
 for _ in range(10):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); vals.append(a.elapsed_time(b)*1000)
 return round(sum(vals)/len(vals),1), round(min(vals),1)
print('ln',ev(lambda: s._input_ln384_kernel[(triton.cdiv(rows,4),)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=rows,BLOCK_R=4,num_warps=2)))
print('mm',ev(lambda: torch.mm(x.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)))
print('post',ev(lambda: s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)))
print('bmm',ev(lambda: torch.bmm(left,right.transpose(1,2),out=oh)))
out_h=oh.view(B,H,N,N)
print('outp',ev(lambda: s._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h,og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)))

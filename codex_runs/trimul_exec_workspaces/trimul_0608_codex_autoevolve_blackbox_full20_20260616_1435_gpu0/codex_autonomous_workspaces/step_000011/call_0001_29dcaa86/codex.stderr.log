+    og = rstd[:, None] * (og - mean[:, None] * sog[None, :]) + bog[None, :]
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    bh = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
+    nh = offs_r[:, None] * H + offs_h[None, :]

+
+        wrows_og = 512 + offs_h
+        wog0 = tl.load(proj_w_ptr + wrows_og[None, :] * 384 + offs_d[:, None])
+        wog1 = tl.load(proj_w_ptr + wrows_og[None, :] * 384 + offs_d[:, None] + 128)
+        wog2 = tl.load(proj_w_ptr + wrows_og[None, :] * 384 + offs_d[:, None] + 256)
+        og = tl.dot(xn0, wog0) + tl.dot(xn1, wog1) + tl.dot(xn2, wog2)
+        tl.store(out_gate_ptr + offs_m[:, None] * 128 + offs_h[None, :], tl.sigmoid(og), mask=valid_o)

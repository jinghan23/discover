/bin/bash -lc "python - <<'PY'
import torch,triton,submission as s

def ev(fn,reps=6):
 for _ in range(3): fn()
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();fn();en.record();torch.cuda.synchronize();times.append(st.elapsed_time(en)*1000)
 return min(times),sum(times)/len(times)
for D,N,B in [(384,1024,1),(384,768,1),(384,256,2),(768,512,1),(768,128,1)]:
 rows=B*N*N; x=torch.randn(B,N,N,D,device='cuda'); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda'); out=torch.empty_like(x,dtype=torch.float16)
 for BR in [1,2,4,8,16,32]:
  for nw in [1,2,4,8]:
   def fn(BR=BR,nw=nw):
    if D==384:
     s._input_ln384_kernel[(triton.cdiv(rows,BR),)](x,w,b,out,rows=rows,BLOCK_R=BR,num_warps=nw)
    else:
     s._input_ln768_kernel[(triton.cdiv(rows,BR),)](x,w,b,out,rows=rows,BLOCK_R=BR,num_warps=nw)
   try: print('D',D,'N',N,'B',B,'BR',BR,'nw',nw,ev(fn,3))
   except Exception as e: print('ERR',D,N,BR,nw,type(e).__name__,str(e)[:60])

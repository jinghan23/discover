 key=(proj.device,B,N,H,'posttorch'); left=s._buf(key,'l',(B*H,N,N),torch.float16,proj.device); right=s._buf(key,'r',(B*H,N,N),torch.float16,proj.device); og=s._buf(key,'og',(B,N,N,H),torch.float16,proj.device)
 def post_triton():
  if nomask:

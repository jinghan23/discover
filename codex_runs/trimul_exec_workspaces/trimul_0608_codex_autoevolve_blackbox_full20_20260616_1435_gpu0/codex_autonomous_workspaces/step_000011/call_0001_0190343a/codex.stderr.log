import torch,triton,submission as s

def ev(fn,reps=5):
 for _ in range(2): fn()
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();fn();en.record();torch.cuda.synchronize();times.append(st.elapsed_time(en)*1000)
 return min(times),sum(times)/len(times)
for N,B,nomask in [(1024,1,True),(768,1,False),(256,2,False)]:
 D=384; H=128; rows=B*N*N; n2=N*N; x=torch.randn(B,N,N,D,device='cuda'); mask=(torch.rand(B,N,N,device='cuda')>.2).float(); nw=torch.randn(D,device='cuda'); nb=torch.randn(D,device='cuda')
 weights=[torch.randn(H,D,device='cuda') for _ in range(5)]
 key=(x.device,B,N,D,H,'wide384b'); left=s._buf(key,'l',(B*H,N,N),torch.float16,x.device); right=s._buf(key,'r',(B*H,N,N),torch.float16,x.device); og=s._buf(key,'og',(B,N,N,H),torch.float16,x.device); projw=s._buf(key,'pw',(5*H,D),torch.float16,x.device)
 torch.cat(tuple(weights),dim=0,out=projw)
 for BM,nw4 in [(8,4),(16,4),(32,4),(64,4),(16,8),(32,8)]:
  def fn(BM=BM,nw4=nw4): s._fused_proj384_wide_kernel[(triton.cdiv(rows,BM),)](x,mask,nw,nb,projw,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,num_warps=nw4)
  try: print('N',N,'B',B,'BM',BM,'nw',nw4,ev(fn,3))
  except Exception as e: print('ERR',N,B,BM,nw4,type(e).__name__,str(e)[:200])

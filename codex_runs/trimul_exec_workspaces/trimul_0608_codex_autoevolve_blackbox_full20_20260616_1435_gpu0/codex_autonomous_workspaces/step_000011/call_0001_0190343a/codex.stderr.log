        wog = _buf(buf_shape_key, "wog", (hidden_dim, dim), f16, device)
        wl.copy_(weights["left_proj.weight"])
        wr.copy_(weights["right_proj.weight"])
        wlg.copy_(weights["left_gate.weight"])
        wrg.copy_(weights["right_gate.weight"])
        wog.copy_(weights["out_gate.weight"])
        if seq_len <= 1024:
            _fused_proj128_4q_kernel[(triton.cdiv(rows, 64),)](
                x_in,
                mask_arg,
                norm_w.to(f32),
                norm_b.to(f32),
                wl,
                wr,
                wlg,
                wrg,
                wog,
                left_b,
                right_b,
                out_gate,
                rows=rows,
                n2=n2,
                NOMASK=nomask,
                BLOCK_M=64,
                BLOCK_H=32,
                num_warps=4,
            )
        else:
            _fused_proj128_4q_kernel[(triton.cdiv(rows, 128),)](
                x_in,
                mask_arg,
                norm_w.to(f32),
                norm_b.to(f32),
                wl,
                wr,
                wlg,
                wrg,
                wog,
                left_b,
                right_b,
                out_gate,
                rows=rows,
                n2=n2,
                NOMASK=nomask,
                BLOCK_M=128,
                BLOCK_H=32,
                num_warps=8,
            )
    else:
        x = _buf(buf_shape_key, "x_norm", input_tensor.shape, proj_dtype, device)
        in_rows = x.numel() // dim
        if dim == 384:
            if seq_len >= 768:
                ln_br = 16
                ln_warps = 1
            elif seq_len == 256:
                ln_br = 4
                ln_warps = 2
            else:

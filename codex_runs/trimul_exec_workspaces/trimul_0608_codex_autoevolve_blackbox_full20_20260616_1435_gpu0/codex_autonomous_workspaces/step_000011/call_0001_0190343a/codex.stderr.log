x=torch.randn(B,N,N,D,device='cuda');mask=(torch.rand(B,N,N,device='cuda')>.2).float();nw=torch.randn(D,device='cuda');nb=torch.randn(D,device='cuda');weights=[torch.randn(H,D,device='cuda') for _ in range(5)];projw=torch.cat(tuple(weights),dim=0).half().contiguous()
left=torch.empty(B*H,N,N,device='cuda',dtype=torch.float16);right=torch.empty_like(left);og=torch.empty(B,N,N,H,device='cuda',dtype=torch.float16)
s._fused_proj384_wide_kernel[(triton.cdiv(rows,16),)](x,mask,nw,nb,projw,left,right,og,rows=rows,n2=n2,NOMASK=False,BLOCK_M=16,num_warps=4)
torch.cuda.synchronize()
xn=F.layer_norm(x,(D,),nw,nb,1e-5)
proj=torch.matmul(xn.half(),projw.t())
l=(proj[...,0:H]*torch.sigmoid(proj[...,2*H:3*H])*mask.unsqueeze(-1)).permute(0,3,1,2).reshape(B*H,N,N)
r=(proj[...,H:2*H]*torch.sigmoid(proj[...,3*H:4*H])*mask.unsqueeze(-1)).permute(0,3,1,2).reshape(B*H,N,N)
o=torch.sigmoid(proj[...,4*H:5*H])
print('max', (left-l).abs().max().item(), (right-r).abs().max().item(), (og-o).abs().max().item())
print('mean', (left-l).abs().mean().item(), (right-r).abs().mean().item(), (og-o).abs().mean().item())

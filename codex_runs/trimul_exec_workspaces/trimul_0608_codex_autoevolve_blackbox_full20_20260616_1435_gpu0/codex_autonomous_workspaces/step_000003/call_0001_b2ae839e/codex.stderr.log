codex
The generic branch now uses the tiled layernorm with four rows per program. I’ll benchmark 2, 4, and 8-row tile variants directly so we can pick the best before an evaluator run.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000
for B,N,D in [(2,256,384),(1,768,384),(1,1024,384),(1,128,768)]:
 rows=B*N*N; x=torch.randn(B,N,N,D,device='cuda')*0.02; y=torch.empty_like(x,dtype=torch.float16); nw=torch.randn(D,device='cuda')*0.02+1; nb=torch.randn(D,device='cuda')*0.02
 print('shape',B,N,D)
 for BR,nwaps in [(1,1),(2,4),(4,4),(8,4),(8,8)]:
  if BR==1:
   def run(): s._input_ln_kernel[(rows,)](x,nw,nb,y,D=D,BLOCK=triton.next_power_of_2(D),num_warps=nwaps)
  else:
   def run(): s._input_ln_tile_kernel[(triton.cdiv(rows,BR),)](x,nw,nb,y,rows=rows,D=D,BLOCK_R=BR,BLOCK_D=triton.next_power_of_2(D),num_warps=nwaps)
  for _ in range(3): run(); torch.cuda.synchronize()
  ts=[ev(run) for _ in range(8)]
  print(' ',BR,nwaps,round(sorted(ts)[4],1),round(min(ts),1))

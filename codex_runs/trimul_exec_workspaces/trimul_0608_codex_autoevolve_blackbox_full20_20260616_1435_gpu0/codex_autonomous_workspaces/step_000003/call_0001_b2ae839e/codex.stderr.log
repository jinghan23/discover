import time, torch
from submission import custom_kernel

torch.backends.cuda.matmul.allow_tf32=True
shapes=[
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
]

def make(cfg):
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']
    if cfg['distribution']=='cauchy':
        x=torch.empty(B,N,N,D,device='cuda').cauchy_()*2
    else:
        x=torch.randn(B,N,N,D,device='cuda')
    mask=None if cfg['nomask'] else (torch.rand(B,N,N,device='cuda')>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'),
      'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'),
      'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'),
      'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda'),
      'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return (x, mask, weights, cfg)

for cfg in shapes:
    torch.cuda.empty_cache()
    data=make(cfg)
    for _ in range(3):
        y=custom_kernel(data); torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); y=custom_kernel(data); en.record(); torch.cuda.synchronize()
        times.append(st.elapsed_time(en)*1000)
    print(cfg, 'median_us', sorted(times)[len(times)//2], 'min', min(times), 'out', y.shape, y.dtype)

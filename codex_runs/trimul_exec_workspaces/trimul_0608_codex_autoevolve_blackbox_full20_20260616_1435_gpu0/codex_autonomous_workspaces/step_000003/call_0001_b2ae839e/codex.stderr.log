def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000,r
for B,N,D in [(2,256,384),(1,768,384),(1,1024,384),(1,128,768)]:
 x=torch.randn(B,N,N,D,device='cuda'); w=torch.randn(D,device='cuda')*0.02+1; b=torch.randn(D,device='cuda')*0.02; y=torch.empty_like(x,dtype=torch.float16)

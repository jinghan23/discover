import torch, triton
import torch.nn.functional as F
import submission as s

def make(B,N,D,H,nomask=True):
    x=torch.randn(B,N,N,D,device='cuda')
    mask=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda'), 'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'), 'to_out.weight': torch.randn(D,H,device='cuda')}
    return x,mask,weights

def ev(fn):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000,r

def current_proj(x,mask,w,D,H):
    B,N=x.shape[:2]; rows=B*N*N; n2=N*N; mask_arg=x if mask is None else mask
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
    s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,mask_arg,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4)
    return left,right,og

def packed_proj(x,mask,w,D,H):
    B,N=x.shape[:2]; rows=B*N*N; n2=N*N; mask_arg=x if mask is None else mask
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    xn=torch.empty_like(x,dtype=torch.float16)
    s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),xn,D=D,BLOCK=triton.next_power_of_2(D),num_warps=1)
    pw=s._proj_weight(w,torch.float16,D,H)
    proj=F.linear(xn,pw)
    s._post_proj_transpose_kernel[(triton.cdiv(rows,32),triton.cdiv(H,32))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=32,BLOCK_H=32,num_warps=4)
    return left,right,og

for B,N,D,H in [(2,256,128,128),(1,512,128,128),(1,768,128,128),(1,1024,128,128)]:
    torch.cuda.empty_cache(); x,mask,w=make(B,N,D,H)
    for _ in range(3): current_proj(x,mask,w,D,H); packed_proj(x,mask,w,D,H); torch.cuda.synchronize()
    tc=[]; tp=[]
    for _ in range(8):
      t,_=ev(lambda: current_proj(x,mask,w,D,H)); tc.append(t)
      t,_=ev(lambda: packed_proj(x,mask,w,D,H)); tp.append(t)
    print((B,N,D),'current',round(sorted(tc)[len(tc)//2],1),'packed',round(sorted(tp)[len(tp)//2],1),'mins',round(min(tc),1),round(min(tp),1))

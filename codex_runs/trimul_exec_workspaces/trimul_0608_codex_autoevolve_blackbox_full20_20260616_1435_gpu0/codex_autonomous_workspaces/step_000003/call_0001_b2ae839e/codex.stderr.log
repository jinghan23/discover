import torch, torch.nn.functional as F

def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000,r
for rows,D,H in [(2*256*256,384,128),(768*768,384,128),(1024*1024,384,128)]:
 x=torch.randn(rows,D,device='cuda',dtype=torch.float16); w5=torch.randn(5*H,D,device='cuda',dtype=torch.float16); w2a=w5[:2*H]; w2b=w5[2*H:4*H]; w1=w5[4*H:]
 def one(): return F.linear(x,w5)
 def three(): return (F.linear(x,w2a), F.linear(x,w2b), F.linear(x,w1))
 def five(): return tuple(F.linear(x,w5[i*H:(i+1)*H]) for i in range(5))
 for _ in range(3): one(); three(); five(); torch.cuda.synchronize()
 vals=[]
 for fn in [one,three,five]:
  ts=[ev(fn)[0] for _ in range(8)]; vals.append((sorted(ts)[4],min(ts)))
 print('rows',rows,'one',[round(v,1) for v in vals[0]],'three',[round(v,1) for v in vals[1]],'five',[round(v,1) for v in vals[2]])

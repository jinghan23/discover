diff --git a/bench_fused384.py b/bench_fused384.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7ee855a7ca7ed5267133670ca18948e82370561
--- /dev/null
+++ b/bench_fused384.py
@@ -0,0 +1,104 @@
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def fused384(
+    x_ptr, mask_ptr, nw_ptr, nb_ptr, wl_ptr, wr_ptr, wlg_ptr, wrg_ptr, wog_ptr,
+    left_ptr, right_ptr, og_ptr,
+    rows: tl.constexpr, n2: tl.constexpr, NOMASK: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr, BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_d = tl.arange(0, BLOCK_D)
+    offs_hb = tl.arange(0, BLOCK_H)
+    valid_m = offs_m < rows
+    x = tl.load(
+        x_ptr + offs_m[:, None] * 384 + offs_d[None, :],
+        mask=valid_m[:, None],
+        other=0.0,
+    ).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 384.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 384.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(nw_ptr + offs_d).to(tl.float32)
+    nb = tl.load(nb_ptr + offs_d).to(tl.float32)
+    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
+    m = tl.full((BLOCK_M,), 1.0, tl.float32)
+    if not NOMASK:
+        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
+    bidx = offs_m // n2
+    ij = offs_m - bidx * n2
+    valid = valid_m[:, None]
+    for q in tl.static_range(0, 4):
+        offs_h = offs_hb + q * BLOCK_H
+        woffs = offs_h[None, :] * 384 + offs_d[:, None]
+        out = offs_m[:, None] * 128 + offs_h[None, :]
+        bh = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+        wl = tl.load(wl_ptr + woffs)
+        wlg = tl.load(wlg_ptr + woffs)
+        l = tl.dot(xn, wl)
+        lg = tl.dot(xn, wlg)
+        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)
+        wr = tl.load(wr_ptr + woffs)
+        wrg = tl.load(wrg_ptr + woffs)
+        r = tl.dot(xn, wr)
+        rg = tl.dot(xn, wrg)
+        tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
+        wog = tl.load(wog_ptr + woffs)
+        og = tl.dot(xn, wog)
+        tl.store(og_ptr + out, tl.sigmoid(og), mask=valid)
+
+
+def ev(fn):
+    st = torch.cuda.Event(True)
+    en = torch.cuda.Event(True)
+    st.record()
+    fn()
+    en.record()
+    torch.cuda.synchronize()
+    return st.elapsed_time(en) * 1000
+
+
+def main():
+    for B, N, nomask in [(2, 256, False), (1, 768, False), (1, 1024, True)]:
+        D = 384
+        H = 128
+        rows = B * N * N
+        n2 = N * N
+        x = torch.randn(B, N, N, D, device="cuda") * 0.02
+        mask = None if nomask else (torch.rand(B, N, N, device="cuda") > 0.2).float()
+        mask_arg = x if mask is None else mask
+        w = [torch.randn(H, D, device="cuda", dtype=torch.float16) * 0.02 for _ in range(5)]
+        nw = torch.randn(D, device="cuda") * 0.02 + 1
+        nb = torch.randn(D, device="cuda") * 0.02
+        left = torch.empty((B * H, N, N), device="cuda", dtype=torch.float16)
+        right = torch.empty_like(left)
+        og = torch.empty((B, N, N, H), device="cuda", dtype=torch.float16)
+        print("shape", B, N, nomask)
+        for BM in [8, 16, 32]:
+            for BH in [32, 64]:
+                if 128 % BH:
+                    continue
+                try:
+                    def run():
+                        fused384[(triton.cdiv(rows, BM),)](
+                            x, mask_arg, nw, nb, w[0], w[1], w[2], w[3], w[4],
+                            left, right, og,
+                            rows=rows, n2=n2, NOMASK=nomask,
+                            BLOCK_M=BM, BLOCK_D=384, BLOCK_H=BH, num_warps=4,
+                        )
+                    for _ in range(3):
+                        run()
+                    torch.cuda.synchronize()
+                    ts = [ev(run) for _ in range(5)]
+                    print((BM, BH), round(sorted(ts)[2], 1), round(min(ts), 1))
+                except Exception as exc:
+                    print((BM, BH), "ERR", type(exc).__name__, str(exc)[:120])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/submission.py b/submission.py
index e7d7c8e19e0f3e396e361cb2151460cd9df7e209..c85505def8e95cd5ce0f2e0c93f0d9b1ae8413bc
--- a/submission.py
+++ b/submission.py
@@ -1,8 +1,10 @@
 """
-Optimized outgoing TriMul forward: Triton normalizes the input rows into
-BF16/FP16, a fused projection produces all gates, Triton fuses sigmoid/mask
-post-processing, FP16 batched GEMMs compute the triangular update, and a final
-Triton row-normalize/gate feeds the TF32 output projection.
+Outgoing Triangle Multiplicative Update forward path.
+
+The implementation keeps the N^3 triangular update on cuBLAS batched FP16 GEMMs,
+while Triton handles row layernorm, fused dim=128 projections/gates, projection
+post-processing for larger dims, and final row layernorm/output gating before a
+TF32 output projection.
 """
 
 import torch
@@ -238,6 +240,7 @@
     tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
     tl.store(out_gate_ptr + nh, tl.sigmoid(og), mask=valid)
 
+
 def custom_kernel(data):
     input_tensor, mask, weights, config = data
     dim = int(config["dim"])
@@ -294,7 +297,7 @@
 
         proj_w = _proj_weight(weights, proj_dtype, dim, hidden_dim)
         proj = F.linear(x, proj_w)
-        _post_proj_transpose_kernel[(triton.cdiv(rows, 32), triton.cdiv(hidden_dim, 32))](
+        _post_proj_transpose_kernel[(triton.cdiv(rows, 16), triton.cdiv(hidden_dim, 64))](
             proj,
             mask_arg,
             left_b,
@@ -304,13 +307,16 @@
             n2=n2,
             H=hidden_dim,
             NOMASK=nomask,
-            BLOCK_R=32,
-            BLOCK_H=32,
+            BLOCK_R=16,
+            BLOCK_H=64,
             num_warps=4,
         )
+
     out_h = torch.bmm(left_b, right_b.transpose(1, 2)).view(batch_size, hidden_dim, seq_len, seq_len)
+    del left_b, right_b
     gated = torch.empty((batch_size, seq_len, seq_len, hidden_dim), device=input_tensor.device, dtype=torch.float32)
-    _ln_gate_tile_kernel[(triton.cdiv(rows, 32),)](
+    ln_block_r = 64 if seq_len >= 1024 else 32
+    _ln_gate_tile_kernel[(triton.cdiv(rows, ln_block_r),)](
         out_h,
         out_gate,
         weights["to_out_norm.weight"].to(torch.float32),
@@ -319,7 +325,7 @@
         rows=rows,
         n2=n2,
         H=hidden_dim,
-        BLOCK_R=32,
+        BLOCK_R=ln_block_r,
         BLOCK_H=128,
         num_warps=4,
     )


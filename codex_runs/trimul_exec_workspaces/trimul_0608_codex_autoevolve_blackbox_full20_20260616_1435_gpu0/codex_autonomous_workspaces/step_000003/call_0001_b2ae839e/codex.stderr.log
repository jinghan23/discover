codex
The right-hand projection is now stored as `[k,j]`, and the triangular update calls `bmm` without a transpose view. I’m doing a small local reference comparison to make sure the index transform is correct before using evaluator time.
exec
/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from submission import custom_kernel

def ref(data):
 x,mask,w,c=data; D=c['dim']; H=c['hidden_dim']; B,N=x.shape[:2]
 xn=F.layer_norm(x,(D,),w['norm.weight'],w['norm.bias'],1e-5)
 left=F.linear(xn,w['left_proj.weight']); right=F.linear(xn,w['right_proj.weight'])
 if mask is not None:
  left=left*mask.unsqueeze(-1); right=right*mask.unsqueeze(-1)
 left=left*torch.sigmoid(F.linear(xn,w['left_gate.weight']))
 right=right*torch.sigmoid(F.linear(xn,w['right_gate.weight']))
 og=torch.sigmoid(F.linear(xn,w['out_gate.weight']))
 out=torch.einsum('bikd,bjkd->bijd',left,right)
 out=F.layer_norm(out,(H,),w['to_out_norm.weight'],w['to_out_norm.bias'],1e-5)
 return F.linear(out*og,w['to_out.weight']).float()
for D,nomask in [(128,True),(384,False)]:
 B,N,H=1,32,128; torch.manual_seed(0)
 x=torch.randn(B,N,N,D,device='cuda')*0.1; mask=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float()
 w={
  'norm.weight': torch.randn(D,device='cuda')*0.1+1, 'norm.bias': torch.randn(D,device='cuda')*0.1,
  'left_proj.weight': torch.randn(H,D,device='cuda')*0.05, 'right_proj.weight': torch.randn(H,D,device='cuda')*0.05,
  'left_gate.weight': torch.randn(H,D,device='cuda')*0.05, 'right_gate.weight': torch.randn(H,D,device='cuda')*0.05,
  'out_gate.weight': torch.randn(H,D,device='cuda')*0.05, 'to_out_norm.weight': torch.randn(H,device='cuda')*0.1+1,
  'to_out_norm.bias': torch.randn(H,device='cuda')*0.1, 'to_out.weight': torch.randn(D,H,device='cuda')*0.05}
 cfg={'dim':D,'hidden_dim':H,'nomask':nomask}
 y=custom_kernel((x,mask,w,cfg)); yr=ref((x,mask,w,cfg)); torch.cuda.synchronize()
 print(D, torch.max(torch.abs(y-yr)).item(), torch.mean(torch.abs(y-yr)).item(), torch.max(torch.abs(y-yr)/(torch.abs(yr)+1e-4)).item())

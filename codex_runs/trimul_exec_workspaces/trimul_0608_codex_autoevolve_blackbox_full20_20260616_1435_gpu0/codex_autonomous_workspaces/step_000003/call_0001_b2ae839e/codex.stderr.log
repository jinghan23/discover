/bin/bash -lc "python - <<'PY'
import torch

def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000,r
for B,N,H in [(2,256,128),(1,512,128),(1,768,128),(1,1024,128)]:
 left=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
 r_jk=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
 r_kj=r_jk.transpose(1,2).contiguous()
 def trans_view(): return torch.bmm(left, r_jk.transpose(1,2))
 def contig_b(): return torch.bmm(left, r_kj)
 def both_contig(): return torch.bmm(left.contiguous(), r_kj)
 for _ in range(3): trans_view(); contig_b(); both_contig(); torch.cuda.synchronize()
 vals=[]
 for fn in [trans_view,contig_b,both_contig]:
  ts=[ev(fn)[0] for _ in range(10)]; vals.append((sorted(ts)[5],min(ts)))
 print((B,N),'transview', [round(v,1) for v in vals[0]], 'contigB', [round(v,1) for v in vals[1]], 'both', [round(v,1) for v in vals[2]])

+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def fused384_split(
+    x_ptr, mask_ptr, nw_ptr, nb_ptr, wl_ptr, wr_ptr, wlg_ptr, wrg_ptr, wog_ptr,
+    left_ptr, right_ptr, og_ptr,
+    rows: tl.constexpr, n2: tl.constexpr, NOMASK: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    d0 = tl.arange(0, 256)
+    d1 = tl.arange(0, 128) + 256
+    hb = tl.arange(0, BLOCK_H)
+    valid_m = offs_m < rows
+    x0 = tl.load(x_ptr + offs_m[:, None] * 384 + d0[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
+    x1 = tl.load(x_ptr + offs_m[:, None] * 384 + d1[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
+    mean = (tl.sum(x0, axis=1) + tl.sum(x1, axis=1)) * (1.0 / 384.0)
+    xc0 = x0 - mean[:, None]
+    xc1 = x1 - mean[:, None]
+    var = (tl.sum(xc0 * xc0, axis=1) + tl.sum(xc1 * xc1, axis=1)) * (1.0 / 384.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw0 = tl.load(nw_ptr + d0).to(tl.float32)
+    nb0 = tl.load(nb_ptr + d0).to(tl.float32)
+    nw1 = tl.load(nw_ptr + d1).to(tl.float32)
+    nb1 = tl.load(nb_ptr + d1).to(tl.float32)
+    xn0 = (xc0 * rstd[:, None] * nw0[None, :] + nb0[None, :]).to(tl.float16)
+    xn1 = (xc1 * rstd[:, None] * nw1[None, :] + nb1[None, :]).to(tl.float16)
+    m = tl.full((BLOCK_M,), 1.0, tl.float32)
+    if not NOMASK:
+        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
+    bidx = offs_m // n2
+    ij = offs_m - bidx * n2
+    valid = valid_m[:, None]
+    for q in tl.static_range(0, 4):
+        h = hb + q * BLOCK_H
+        w0 = h[None, :] * 384 + d0[:, None]
+        w1 = h[None, :] * 384 + d1[:, None]
+        out = offs_m[:, None] * 128 + h[None, :]
+        bh = (bidx[:, None] * 128 + h[None, :]) * n2 + ij[:, None]
+        wl0 = tl.load(wl_ptr + w0)
+        wl1 = tl.load(wl_ptr + w1)
+        wlg0 = tl.load(wlg_ptr + w0)
+        wlg1 = tl.load(wlg_ptr + w1)
+        l = tl.dot(xn0, wl0) + tl.dot(xn1, wl1)
+        lg = tl.dot(xn0, wlg0) + tl.dot(xn1, wlg1)
+        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)
+        wr0 = tl.load(wr_ptr + w0)
+        wr1 = tl.load(wr_ptr + w1)
+        wrg0 = tl.load(wrg_ptr + w0)
+        wrg1 = tl.load(wrg_ptr + w1)
+        r = tl.dot(xn0, wr0) + tl.dot(xn1, wr1)
+        rg = tl.dot(xn0, wrg0) + tl.dot(xn1, wrg1)
+        tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
+        wog0 = tl.load(wog_ptr + w0)
+        wog1 = tl.load(wog_ptr + w1)
+        og = tl.dot(xn0, wog0) + tl.dot(xn1, wog1)
+        tl.store(og_ptr + out, tl.sigmoid(og), mask=valid)
+
+
+def ev(fn):
+    st = torch.cuda.Event(True)
+    en = torch.cuda.Event(True)
+    st.record()
+    fn()
+    en.record()
+    torch.cuda.synchronize()
+    return st.elapsed_time(en) * 1000
+
+
+def main():
+    for B, N, nomask in [(2, 256, False), (1, 768, False), (1, 1024, True)]:
+        D = 384
+        H = 128
+        rows = B * N * N
+        n2 = N * N
+        x = torch.randn(B, N, N, D, device="cuda") * 0.02
+        mask = None if nomask else (torch.rand(B, N, N, device="cuda") > 0.2).float()
+        mask_arg = x if mask is None else mask
+        w = [torch.randn(H, D, device="cuda", dtype=torch.float16) * 0.02 for _ in range(5)]
+        nw = torch.randn(D, device="cuda") * 0.02 + 1
+        nb = torch.randn(D, device="cuda") * 0.02
+        left = torch.empty((B * H, N, N), device="cuda", dtype=torch.float16)
+        right = torch.empty_like(left)
+        og = torch.empty((B, N, N, H), device="cuda", dtype=torch.float16)
+        print("shape", B, N, nomask)
+        for BM in [8, 16, 32]:
+            for BH in [32, 64]:
+                try:
+                    def run():
+                        fused384_split[(triton.cdiv(rows, BM),)](
+                            x, mask_arg, nw, nb, w[0], w[1], w[2], w[3], w[4],
+                            left, right, og,
+                            rows=rows, n2=n2, NOMASK=nomask,
+                            BLOCK_M=BM, BLOCK_H=BH, num_warps=4,
+                        )
+                    for _ in range(3):
+                        run()
+                    torch.cuda.synchronize()
+                    ts = [ev(run) for _ in range(5)]
+                    print((BM, BH), round(sorted(ts)[2], 1), round(min(ts), 1))
+                except Exception as exc:
+                    print((BM, BH), "ERR", type(exc).__name__, str(exc)[:120])
+
+
+if __name__ == "__main__":
+    main()

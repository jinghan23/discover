B,N,H=1,1024,128; rows=B*N*N; n2=N*N
x=torch.randn(B,H,N,N,device='cuda',dtype=torch.float16)*0.02; gate=torch.rand(B,N,N,H,device='cuda',dtype=torch.float16); y=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32); nw=torch.randn(H,device='cuda')*0.02+1; nb=torch.randn(H,device='cuda')*0.02
for BR in [32,64,128]:

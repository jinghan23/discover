 """
-Optimized outgoing TriMul forward: Triton normalizes the input rows into
-BF16/FP16, a fused projection produces all gates, Triton fuses sigmoid/mask
-post-processing, FP16 batched GEMMs compute the triangular update, and a final
-Triton row-normalize/gate feeds the TF32 output projection.
+Outgoing Triangle Multiplicative Update forward path.
+
+The implementation keeps the N^3 triangular update on cuBLAS batched FP16 GEMMs,
+while Triton handles row layernorm, fused dim=128 projections/gates, projection
+post-processing for larger dims, and final row layernorm/output gating before a
+TF32 output projection.
 """
 
 import torch
@@ -119,6 +121,37 @@
 
 
 @triton.jit
+def _ln_gate128_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    valid_r = offs_r < rows
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    w = tl.load(w_ptr + offs_h).to(tl.float32)
+    b = tl.load(b_ptr + offs_h).to(tl.float32)
+    y_addr = offs_r[:, None] * 128 + offs_h[None, :]
+    g = tl.load(gate_ptr + y_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    y = (xc * rstd[:, None] * w[None, :] + b[None, :]) * g
+    tl.store(y_ptr + y_addr, y, mask=valid_r[:, None])
+
+
+@triton.jit
 def _input_ln_kernel(x_ptr, w_ptr, b_ptr, y_ptr, D: tl.constexpr, BLOCK: tl.constexpr):
     row = tl.program_id(0)
     offs = tl.arange(0, BLOCK)

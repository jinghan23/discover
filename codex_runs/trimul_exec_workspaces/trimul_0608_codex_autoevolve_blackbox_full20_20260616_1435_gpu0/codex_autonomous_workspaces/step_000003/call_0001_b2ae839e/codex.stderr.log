def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000
for B,N,nomask in [(2,256,False),(1,768,False),(1,1024,True)]:
 H=128; rows=B*N*N; n2=N*N; proj=torch.randn(rows,5*H,device='cuda',dtype=torch.float16); mask=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float(); mask_arg=proj if mask is None else mask
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 def old(): s._post_proj_transpose_kernel[(triton.cdiv(rows,16),2)](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
 def new(): s._post_proj128_transpose_kernel[(triton.cdiv(rows,16),2)](proj,mask_arg,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
 for _ in range(3): old(); new(); torch.cuda.synchronize()
 vals=[]
 for fn in [old,new]:
  ts=[ev(fn) for _ in range(8)]; vals.append((sorted(ts)[4],min(ts)))
 print((B,N,nomask),'old',[round(v,1) for v in vals[0]],'new',[round(v,1) for v in vals[1]])

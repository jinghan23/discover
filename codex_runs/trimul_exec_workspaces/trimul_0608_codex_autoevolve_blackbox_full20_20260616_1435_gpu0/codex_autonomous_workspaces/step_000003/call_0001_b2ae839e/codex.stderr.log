 print('shape',B,N,nomask)
 for nw in [2,4,8]:
  def run(): s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=nw)
  for _ in range(3): run(); torch.cuda.synchronize()
  ts=[ev(run) for _ in range(10)]
  print(' ',nw,round(sorted(ts)[5],1),round(min(ts),1))

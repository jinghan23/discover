/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F

def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000,r
for B,N,D,H in [(2,256,384,128),(1,768,384,128),(1,1024,384,128),(1,256,768,128)]:
 x=torch.randn(B,N,N,D,device='cuda',dtype=torch.float16); w=torch.randn(5*H,D,device='cuda',dtype=torch.float16); out=torch.empty((B*N*N,5*H),device='cuda',dtype=torch.float16)
 def f4(): return F.linear(x,w)
 def f2(): return F.linear(x.view(-1,D),w).view(B,N,N,5*H)
 def mmout():
  torch.mm(x.view(-1,D), w.t(), out=out)
  return out.view(B,N,N,5*H)
 def matmul(): return x.view(-1,D).matmul(w.t()).view(B,N,N,5*H)
 for _ in range(3): f4(); f2(); mmout(); matmul(); torch.cuda.synchronize()
 vals=[]
 for fn in [f4,f2,mmout,matmul]:
  ts=[ev(fn)[0] for _ in range(8)]; vals.append((sorted(ts)[4],min(ts)))
 print((B,N,D),'f4', [round(v,1) for v in vals[0]], 'f2', [round(v,1) for v in vals[1]], 'mmout', [round(v,1) for v in vals[2]], 'matmul', [round(v,1) for v in vals[3]])

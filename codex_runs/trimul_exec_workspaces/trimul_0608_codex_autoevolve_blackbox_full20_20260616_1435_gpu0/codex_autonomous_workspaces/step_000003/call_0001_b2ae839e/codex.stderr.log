/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def make(B,N,D,H):
    x=torch.randn(B,N,N,D,device='cuda')*0.02
    w={
      'norm.weight': torch.randn(D,device='cuda')*0.02+1, 'norm.bias': torch.randn(D,device='cuda')*0.02,
      'left_proj.weight': torch.randn(H,D,device='cuda')*0.02, 'right_proj.weight': torch.randn(H,D,device='cuda')*0.02,
      'left_gate.weight': torch.randn(H,D,device='cuda')*0.02, 'right_gate.weight': torch.randn(H,D,device='cuda')*0.02,
      'out_gate.weight': torch.randn(H,D,device='cuda')*0.02, 'to_out_norm.weight': torch.randn(H,device='cuda')*0.02+1,
      'to_out_norm.bias': torch.randn(H,device='cuda')*0.02, 'to_out.weight': torch.randn(D,H,device='cuda')*0.02}
    return x,w

def ev(fn):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)*1000

def bench(B,N,BM,BH):
    D=H=128; x,w=make(B,N,D,H); rows=B*N*N; n2=N*N; wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    def run():
      s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=4)
    for _ in range(3): run(); torch.cuda.synchronize()
    ts=[ev(run) for _ in range(8)]
    return sorted(ts)[len(ts)//2], min(ts)
for B,N in [(2,256),(1,512),(1,768),(1,1024)]:
    print('shape',B,N)
    for BM,BH in [(64,32),(32,64),(64,64),(128,32),(32,32),(16,64)]:
      try:
        med,mn=bench(B,N,BM,BH)
        print(' ',(BM,BH),round(med,1),round(mn,1))
      except Exception as e:
        print(' ',(BM,BH),'ERR',type(e).__name__,str(e)[:100])

--- a/submission.py
+++ b/submission.py
@@ -119,6 +119,46 @@
 
 
 @triton.jit
+def _ln_gate_linear_kernel(
+    x_ptr,
+    gate_ptr,
+    ln_w_ptr,
+    ln_b_ptr,
+    out_w_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    pid_r = tl.program_id(0)
+    pid_d = tl.program_id(1)
+    offs_r = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    offs_d = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    valid_r = offs_r < rows
+    valid_d = offs_d < D
+
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    lw = tl.load(ln_w_ptr + offs_h).to(tl.float32)
+    lb = tl.load(ln_b_ptr + offs_h).to(tl.float32)
+    g = tl.load(gate_ptr + offs_r[:, None] * 128 + offs_h[None, :], mask=valid_r[:, None], other=0.0).to(tl.float32)
+    z = ((xc * rstd[:, None] * lw[None, :] + lb[None, :]) * g).to(tl.float32)
+
+    w = tl.load(out_w_ptr + offs_d[None, :] * 128 + offs_h[:, None], mask=valid_d[None, :], other=0.0).to(tl.float32)
+    acc = tl.dot(z, w, input_precision="tf32")
+    tl.store(y_ptr + offs_r[:, None] * D + offs_d[None, :], acc, mask=valid_r[:, None] & valid_d[None, :])
+
+
+@triton.jit
 def _input_ln_kernel(x_ptr, w_ptr, b_ptr, y_ptr, D: tl.constexpr, BLOCK: tl.constexpr):
     row = tl.program_id(0)
     offs = tl.arange(0, BLOCK)


+    n2: tl.constexpr,
+    D: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    pid_r = tl.program_id(0)
+    pid_d = tl.program_id(1)
+    offs_r = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    offs_d = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
+    valid_r = offs_r < rows
+    valid_d = offs_d < D
+
+    bidx = offs_r // n2

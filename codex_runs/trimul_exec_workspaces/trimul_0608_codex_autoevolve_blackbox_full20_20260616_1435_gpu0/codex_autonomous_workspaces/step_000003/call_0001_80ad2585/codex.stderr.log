I’ll do a stage-level local profile for the large `N=1024` cases. The absolute times differ from the blackbox, but the stage proportions should still be useful.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
import submission

def make(N,B,D,H,nomask):
    device='cuda'
    x=torch.randn((B,N,N,D),device=device,dtype=torch.float32)
    mask=torch.ones((B,N,N),device=device,dtype=torch.float32) if nomask else (torch.rand((B,N,N),device=device)>0.2).float()
    weights={
        'norm.weight': torch.randn((D,),device=device),
        'norm.bias': torch.randn((D,),device=device),
        'left_proj.weight': torch.randn((H,D),device=device),
        'right_proj.weight': torch.randn((H,D),device=device),
        'left_gate.weight': torch.randn((H,D),device=device),
        'right_gate.weight': torch.randn((H,D),device=device),
        'out_gate.weight': torch.randn((H,D),device=device),
        'to_out_norm.weight': torch.randn((H,),device=device),
        'to_out_norm.bias': torch.randn((H,),device=device),
        'to_out.weight': torch.randn((D,H),device=device),
    }
    return x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask}

def evtime(fn, reps=5):
    for _ in range(2): fn()
    torch.cuda.synchronize()
    ts=[]
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); fn(); e.record(); torch.cuda.synchronize()
        ts.append(s.elapsed_time(e)*1000)
    return min(ts), sum(ts)/len(ts)

def profile(N,B,D,H,nomask):
    x,mask,w,c=make(N,B,D,H,nomask)
    rows=B*N*N; n2=N*N; mask_arg=mask
    left_b=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right_b=torch.empty_like(left_b)
    out_gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    if D==128:
        wl,wr,wlg,wrg,wog=submission._proj_parts(w, torch.float16, D,H)
        def proj():
            submission._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,mask_arg,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4)
    else:
        xnorm=torch.empty_like(x,dtype=torch.float16)
        proj_w=submission._proj_weight(w, torch.float16,D,H)
        def proj():
            submission._input_ln_kernel[(rows,)](x,w['norm.weight'],w['norm.bias'],xnorm,D=D,BLOCK=triton.next_power_of_2(D),num_warps=1)
            p=F.linear(xnorm,proj_w)
            submission._post_proj_transpose_kernel[(triton.cdiv(rows,32),triton.cdiv(H,32))](p,mask_arg,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=32,BLOCK_H=32,num_warps=4)
    # initialize
    proj(); torch.cuda.synchronize()
    out_h=torch.bmm(left_b,right_b.transpose(1,2)).view(B,H,N,N); torch.cuda.synchronize()
    gated=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32)
    def bmm():
        torch.bmm(left_b,right_b.transpose(1,2))
    def lngate():
        submission._ln_gate_tile_kernel[(triton.cdiv(rows,32),)](out_h,out_gate,w['to_out_norm.weight'],w['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=128,num_warps=4)
    lngate(); torch.cuda.synchronize()
    def final():
        F.linear(gated,w['to_out.weight']).to(torch.float32)
    print('case',N,B,D,H,nomask)
    for name,fn in [('proj',proj),('bmm',bmm),('lngate',lngate),('final',final)]:
        mn,av=evtime(fn,3)
        print(name, mn,av, flush=True)

profile(1024,1,128,128,True)
torch.cuda.empty_cache()
profile(1024,1,384,128,True)

codex
I’m going to run a local timing script with synthetic tensors for the listed shapes. The blackbox gives only one aggregate score, so local per-shape timings can point to which branch is actually worth more work.
exec
/bin/bash -lc "python - <<'PY'
import torch, time, importlib
import submission

torch.backends.cuda.matmul.allow_tf32=True

def make_case(N,B,D,H,nomask=True):
    device='cuda'
    x=torch.randn((B,N,N,D),device=device,dtype=torch.float32)
    mask=torch.ones((B,N,N),device=device,dtype=torch.float32) if nomask else (torch.rand((B,N,N),device=device)>0.2).float()
    weights={
        'norm.weight': torch.randn((D,),device=device),
        'norm.bias': torch.randn((D,),device=device),
        'left_proj.weight': torch.randn((H,D),device=device),
        'right_proj.weight': torch.randn((H,D),device=device),
        'left_gate.weight': torch.randn((H,D),device=device),
        'right_gate.weight': torch.randn((H,D),device=device),
        'out_gate.weight': torch.randn((H,D),device=device),
        'to_out_norm.weight': torch.randn((H,),device=device),
        'to_out_norm.bias': torch.randn((H,),device=device),
        'to_out.weight': torch.randn((D,H),device=device),
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

def time_case(c):
    # warmup
    for _ in range(3):
        y=submission.custom_kernel(c)
    torch.cuda.synchronize()
    times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=submission.custom_kernel(c); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000)
    return min(times), sum(times)/len(times)

cases=[(256,2,128,128,True),(768,1,128,128,True),(256,2,384,128,False),(512,1,128,128,True),(1024,1,128,128,True),(768,1,384,128,False),(1024,1,384,128,True)]
for args in cases:
    torch.cuda.empty_cache()
    c=make_case(*args)
    mn,av=time_case(c)
    print(args, 'min', mn, 'avg', av, flush=True)
    del c
    torch.cuda.empty_cache()

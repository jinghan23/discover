    right_b = right.permute(0, 3, 1, 2).to(torch.float16).contiguous().view(batch_size * hidden_dim, seq_len, seq_len)
    out = torch.bmm(left_b, right_b.transpose(1, 2)).view(batch_size, hidden_dim, seq_len, seq_len).permute(0, 2, 3, 1).contiguous().to(torch.float32)
    rows = out.numel() // hidden_dim
    gated = torch.empty_like(out)

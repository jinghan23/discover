-        out_gate = self.out_gate(x.to(torch.float32)).sigmoid()
 
-        left = left * left_gate
-        right = right * right_gate
+@triton.jit
+def _fused_ln_gate_out_kernel(
+    x_ptr,
+    gate_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    out_w_ptr,
+    out_ptr,

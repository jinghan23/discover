+    row = tl.program_id(0)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    n2 = seq_len * seq_len
+    b = row // n2
+    ij = row - b * n2
+    x = tl.load(x_ptr + (b * H + offs) * n2 + ij, mask=mask, other=0.0).to(tl.float32)
+    mean = tl.sum(tl.where(mask, x, 0.0), axis=0) / H

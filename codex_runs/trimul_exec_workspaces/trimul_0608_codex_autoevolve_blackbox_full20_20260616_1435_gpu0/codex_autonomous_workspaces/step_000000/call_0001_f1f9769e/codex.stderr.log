+def _ln_gate_kernel(x_ptr, gate_ptr, w_ptr, b_ptr, y_ptr, H: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    offs = tl.arange(0, BLOCK)
+    mask = offs < H
+    base = row * H + offs
+    x = tl.load(x_ptr + base, mask=mask, other=0.0).to(tl.float32)
+    mean = tl.sum(tl.where(mask, x, 0.0), axis=0) / H
+    xc = tl.where(mask, x - mean, 0.0)
+    var = tl.sum(xc * xc, axis=0) / H
+    rstd = tl.rsqrt(var + 1.0e-5)
+    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    g = tl.load(gate_ptr + base, mask=mask, other=0.0).to(tl.float32)
+    y = (xc * rstd * w + b) * g
+    tl.store(y_ptr + base, y, mask=mask)
 
 

+    row_mask = rows < n_rows
+    h_mask = offs_h < H
+    x = tl.load(
+        x_ptr + rows[:, None] * H + offs_h[None, :],
+        mask=row_mask[:, None] & h_mask[None, :],
+        other=0.0,
+    ).to(tl.float32)
+    mean = tl.sum(x, axis=1) / H
+    xc = tl.where(h_mask[None, :], x - mean[:, None], 0.0)
+    var = tl.sum(xc * xc, axis=1) / H
+    rstd = tl.rsqrt(var + 1.0e-5)
 

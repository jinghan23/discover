/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
import submission
M=2; N=4; H=128; B=2
l=torch.randn(B,N,N,H,device='cuda',dtype=torch.bfloat16)
r=torch.randn(B,N,N,H,device='cuda',dtype=torch.bfloat16)
x=torch.einsum('bikd,bjkd->bijd',l,r).to(torch.float32)
g=torch.sigmoid(torch.randn(B,N,N,H,device='cuda'))
w=torch.randn(H,device='cuda'); b=torch.randn(H,device='cuda')
y=torch.empty((B,N,N,H),device='cuda')
rows=x.numel()//H
submission._ln_gate_kernel[(submission.triton.cdiv(rows,4),)](x,g,w,b,y,rows,N,x.stride(0),x.stride(1),x.stride(2),x.stride(3),g.stride(0),g.stride(1),g.stride(2),g.stride(3),BLOCK_M=4,BLOCK_H=128,num_warps=4)
ref=F.layer_norm(x,(H,),w,b,1e-5)*g
torch.cuda.synchronize()
print(x.stride(), y.stride(), ref.stride())
print(torch.max(torch.abs(y-ref)).item(), torch.mean(torch.abs(y-ref)).item())
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

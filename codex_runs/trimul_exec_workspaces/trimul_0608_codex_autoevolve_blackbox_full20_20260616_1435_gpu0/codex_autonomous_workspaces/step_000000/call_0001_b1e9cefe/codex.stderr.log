+def _ln_gate_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows,
+    n: tl.constexpr,
+    xs0: tl.constexpr,
+    xs1: tl.constexpr,
+    xs2: tl.constexpr,
+    xs3: tl.constexpr,
+    gs0: tl.constexpr,
+    gs1: tl.constexpr,
+    gs2: tl.constexpr,
+    gs3: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,

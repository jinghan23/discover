import torch
B,N,H=1,4,128
l=torch.randn(B,N,N,H,device='cuda',dtype=torch.bfloat16)
r=torch.randn(B,N,N,H,device='cuda',dtype=torch.bfloat16)
o1=torch.einsum('bikd,bjkd->bijd',l,r)
lp=l.permute(0,3,1,2)
rp=r.permute(0,3,1,2)
o2=torch.einsum('bdik,bdjk->bijd',lp,rp)
o3=torch.einsum('bdik,bdjk->bdij',lp,rp).permute(0,2,3,1)
print('o1', o1.stride(), o1.is_contiguous())
print('o2', o2.stride(), o2.is_contiguous())
print('o3', o3.stride(), o3.is_contiguous())
print((o1-o2).abs().max(), (o1-o3).abs().max())

import torch, torch.nn.functional as F
import submission

torch.manual_seed(2)
B,N,D,H=1,2,128,128
x0=torch.randn(B,N,N,D,device='cuda')
gamma=torch.randn(D,device='cuda'); beta=torch.randn(D,device='cuda')
W=torch.randn(5*H,D,device='cuda')
# compute mean kernel
rows=B*N*N
mean=torch.empty(rows,device='cuda'); rstd=torch.empty_like(mean)
submission._mean_rstd_kernel[(rows,)](x0,mean,rstd,rows,D,BLOCK_D=128,num_warps=4)
proj_w_folded=W*gamma.unsqueeze(0)
scale=proj_w_folded.sum(1)
bias=(W*beta.unsqueeze(0)).sum(1)
raw=F.linear(x0,proj_w_folded).reshape(rows,5*H)
calc=(raw - mean[:,None]*scale[None,:])*rstd[:,None]+bias[None,:]
ref=F.linear(F.layer_norm(x0,(D,),gamma,beta,1e-5),W).reshape(rows,5*H)
torch.cuda.synchronize()
print('mean diff', (mean-x0.reshape(rows,D).mean(1)).abs().max().item())
var=x0.reshape(rows,D).var(1,unbiased=False)
print('rstd diff', (rstd-torch.rsqrt(var+1e-5)).abs().max().item())
print('proj max/mean', (calc-ref).abs().max().item(), (calc-ref).abs().mean().item(), ref.abs().mean().item())
print(calc[0,:5], ref[0,:5])

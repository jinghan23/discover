+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    n2: tl.constexpr = n * n
+    bidx = offs_m // n2
+    rem = offs_m - bidx * n2
+    iidx = rem // n

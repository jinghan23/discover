import torch
import torch.nn.functional as F
import submission

torch.manual_seed(1)
B,N,D,H=1,8,128,128
x0=torch.randn(B,N,N,D,device='cuda')
mask=torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32)
weights={
'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'), 'out_gate.weight':torch.randn(H,D,device='cuda'),
'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
'to_out.weight':torch.randn(D,H,device='cuda')}
config={'dim':D,'hidden_dim':H,'nomask':False}

def ref():
 x=F.layer_norm(x0,(D,),weights['norm.weight'],weights['norm.bias'],1e-5)
 W=torch.cat([weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']],0)
 p=F.linear(x,W)
 l,r,lg,rg,og=p.split(H,dim=-1)
 l=l*mask.unsqueeze(-1)*torch.sigmoid(lg)
 r=r*mask.unsqueeze(-1)*torch.sigmoid(rg)
 og=torch.sigmoid(og)
 o=torch.einsum('bikd,bjkd->bijd',l.to(torch.bfloat16),r.to(torch.bfloat16)).to(torch.float32)
 o=F.layer_norm(o,(H,),weights['to_out_norm.weight'],weights['to_out_norm.bias'],1e-5)*og
 return F.linear(o,weights['to_out.weight']).float()
y=submission.custom_kernel((x0,mask,weights,config))
r=ref()
torch.cuda.synchronize()
print(torch.max(torch.abs(y-r)).item(), torch.mean(torch.abs(y-r)).item())
print(torch.allclose(y,r,rtol=1e-2,atol=1e-2))

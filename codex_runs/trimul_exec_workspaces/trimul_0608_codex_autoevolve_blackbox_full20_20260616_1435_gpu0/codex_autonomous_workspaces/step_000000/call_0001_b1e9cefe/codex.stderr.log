+def _ln_gate_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows,
+    n: tl.constexpr,
+    xs0: tl.constexpr,
+    xs1: tl.constexpr,
+    xs2: tl.constexpr,
+    xs3: tl.constexpr,
+    gs0: tl.constexpr,
+    gs1: tl.constexpr,
+    gs2: tl.constexpr,
+    gs3: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    n2: tl.constexpr = n * n
+    bidx = offs_m // n2
+    rem = offs_m - bidx * n2
+    iidx = rem // n
+    jidx = rem - iidx * n
+    mask = offs_m[:, None] < rows
+    x_ptrs = bidx[:, None] * xs0 + iidx[:, None] * xs1 + jidx[:, None] * xs2 + offs_h[None, :] * xs3
+    g_ptrs = bidx[:, None] * gs0 + iidx[:, None] * gs1 + jidx[:, None] * gs2 + offs_h[None, :] * gs3
+    y_ptrs = offs_m[:, None] * BLOCK_H + offs_h[None, :]
+    x = tl.load(x_ptr + x_ptrs, mask=mask, other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) / BLOCK_H

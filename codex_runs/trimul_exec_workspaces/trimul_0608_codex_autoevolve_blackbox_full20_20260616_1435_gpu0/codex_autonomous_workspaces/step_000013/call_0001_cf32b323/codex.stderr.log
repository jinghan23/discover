/bin/bash -lc "python - <<'PY'
import torch

def bench(N,H=128):
 dev='cuda'; f16=torch.float16
 left=torch.randn((H,N,N),device=dev,dtype=f16); right=torch.randn((H,N,N),device=dev,dtype=f16)
 out_ch=torch.empty((H,N,N),device=dev,dtype=f16)
 out_nhwc=torch.empty((N,N,H),device=dev,dtype=f16)
 out_view=torch.as_strided(out_nhwc,(H,N,N),(1,N*H,H))
 def bmm_ch(): torch.bmm(left,right.transpose(1,2),out=out_ch)
 def bmm_view(): torch.bmm(left,right.transpose(1,2),out=out_view)
 for name,fn in [('ch',bmm_ch),('view',bmm_view)]:
  try:
   fn(); torch.cuda.synchronize(); times=[]
   for _ in range(10):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
   print(N,name,round(sum(times)/len(times),1),round(min(times),1), 'contig?', out_view.is_contiguous())
  except Exception as e:
   print(N,name,'ERR',type(e).__name__,str(e)[:120])
for N in [256,512,768,1024]: bench(N)

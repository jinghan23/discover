      'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda')}
    return x,mask,w

def bench(B,N,nomask,BM,BH,warps):
    D=384; H=128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
    x,mask,w=make(B,N,D,H,nomask); key=('fused384bench',B,N,D,H,BM,BH,warps,nomask,x.device)
    left=submission._buf(key,'left',(B*H,N,N),f16,x.device); right=submission._buf(key,'right',(B*H,N,N),f16,x.device); og=submission._buf(key,'og',(B,N,N,H),f16,x.device)
    wl=submission._buf(key,'wl',(H,D),f16,x.device); wr=submission._buf(key,'wr',(H,D),f16,x.device); wlg=submission._buf(key,'wlg',(H,D),f16,x.device); wrg=submission._buf(key,'wrg',(H,D),f16,x.device); wog=submission._buf(key,'wog',(H,D),f16,x.device)
    wl.copy_(w['left_proj.weight']); wr.copy_(w['right_proj.weight']); wlg.copy_(w['left_gate.weight']); wrg.copy_(w['right_gate.weight']); wog.copy_(w['out_gate.weight'])
    # compile/warm
    submission._fused_proj384_4q_kernel[(triton.cdiv(rows,BM),)](x,mask,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)

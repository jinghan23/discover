For the 128-channel public cases, the fused projection kernel is the largest non-BMM cost. I’m benchmarking its row and hidden block sizes next; unlike the 384 path, this one may have real room because it uses many small Tensor Core dots.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton,submission

def bench(N,B,nomask,BM,BH,warps):
    D=H=128; rows=B*N*N; n2=N*N; dev='cuda'; f16=torch.float16; f32=torch.float32
    x=torch.randn((B,N,N,D),device=dev,dtype=f32)
    mask=torch.ones((B,N,N),device=dev) if nomask else (torch.rand((B,N,N),device=dev)>0.15).float()
    w={name: torch.randn((H,D),device=dev,dtype=f32) for name in ['wl','wr','wlg','wrg','wog']}
    nw=torch.randn(D,device=dev); nb=torch.randn(D,device=dev)
    left=torch.empty((B*H,N,N),device=dev,dtype=f16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=f16)
    wf={k:v.to(f16).contiguous() for k,v in w.items()}
    submission._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask,nw,nb,wf['wl'],wf['wr'],wf['wlg'],wf['wrg'],wf['wog'],left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True)
      st.record(); submission._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask,nw,nb,wf['wl'],wf['wr'],wf['wlg'],wf['wrg'],wf['wog'],left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times),min(times)

for B,N in [(1,1024),(1,768),(1,512),(2,256)]:
 print('\\ncase',B,N)
 for BM in [16,32,64,128,256]:
  for BH in [16,32,64,128]:
   if 128%BH: continue
   for warps in [4,8]:
    try:
     avg,mn=bench(N,B,True,BM,BH,warps)
     print('BM',BM,'BH',BH,'w',warps,'avg',round(avg,1),'min',round(mn,1))
    except Exception as e:
     print('ERR',BM,BH,warps,type(e).__name__,str(e)[:80])

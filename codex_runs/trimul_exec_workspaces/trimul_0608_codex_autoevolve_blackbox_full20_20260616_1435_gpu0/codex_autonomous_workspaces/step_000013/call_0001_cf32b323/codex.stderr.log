import torch

def bench(B,N,D,H,variant):
 rows=B*N*N; dev='cuda'; f16=torch.float16
 x=torch.randn((rows,D),device=dev,dtype=f16)
 w=torch.randn((5*H,D),device=dev,dtype=f16)
 out=torch.empty((rows,5*H),device=dev,dtype=f16)
 if variant=='t_view':
  wt=w.t()
  def fn(): torch.mm(x,wt,out=out,out_dtype=f16)
 elif variant=='t_contig':
  wt=w.t().contiguous()
  def fn(): torch.mm(x,wt,out=out,out_dtype=f16)
 elif variant=='linear':
  def fn(): torch.nn.functional.linear(x,w,out=out) if False else torch.mm(x,w.t(),out=out,out_dtype=f16)

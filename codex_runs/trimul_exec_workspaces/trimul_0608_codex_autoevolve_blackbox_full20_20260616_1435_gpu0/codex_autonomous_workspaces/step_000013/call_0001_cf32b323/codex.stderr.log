/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F, triton, submission

def bench(B,N,D,variant):
    H=128; rows=B*N*N; dev='cuda'; f16=torch.float16; f32=torch.float32
    out_h_flat=torch.randn((B*H,N,N),device=dev,dtype=f16)
    gate=torch.rand((B,N,N,H),device=dev,dtype=f16)
    nw=torch.randn(H,device=dev,dtype=f32); nb=torch.randn(H,device=dev,dtype=f32)
    to_w=torch.randn(D,H,device=dev,dtype=f32)
    out=torch.empty((B,N,N,D),device=dev,dtype=f32)
    out_h=out_h_flat.view(B,H,N,N)
    to_w_h_t=to_w.to(f16).t().contiguous()
    def current():
        br=128 if D==384 else 64
        submission._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,gate,nw,nb,to_w_h_t,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
        return out
    def pyt_f16():
        tmp=out_h.permute(0,2,3,1).contiguous()
        y=F.layer_norm(tmp,(H,),nw.to(f16),nb.to(f16))
        y=y*gate
        torch.mm(y.view(rows,H),to_w_h_t,out=out.view(rows,D),out_dtype=f32)
        return out
    def pyt_f32ln_f16mm():
        tmp=out_h.permute(0,2,3,1).contiguous()
        y=F.layer_norm(tmp.float(),(H,),nw,nb).to(f16)
        y=y*gate
        torch.mm(y.view(rows,H),to_w_h_t,out=out.view(rows,D),out_dtype=f32)
        return out
    def pyt_f32all():
        tmp=out_h.permute(0,2,3,1).contiguous().float()
        y=F.layer_norm(tmp,(H,),nw,nb)*gate.float()
        torch.mm(y.view(rows,H),to_w.t().contiguous(),out=out.view(rows,D))
        return out
    fn={'current':current,'pyt_f16':pyt_f16,'pyt_f32ln_f16mm':pyt_f32ln_f16mm,'pyt_f32all':pyt_f32all}[variant]
    fn(); torch.cuda.synchronize()
    times=[]
    for _ in range(5):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times), min(times)

for D,N in [(384,1024),(384,768),(384,256),(128,1024),(128,768),(128,512),(128,256)]:
  print('\\nD,N',D,N)
  for v in ['current','pyt_f16','pyt_f32ln_f16mm','pyt_f32all']:
    try:
      avg,mn=bench(1 if N"'!=256 else 2,N,D,v)
      print(v,round(avg,1),round(mn,1))
    except Exception as e:
      print('"'ERR',v,type(e).__name__,str(e)[:120])

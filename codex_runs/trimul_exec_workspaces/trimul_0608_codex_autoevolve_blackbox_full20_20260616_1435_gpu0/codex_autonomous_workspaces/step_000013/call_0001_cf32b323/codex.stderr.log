import torch, triton, submission

def make(B,N,D=384,H=128,nomask=True):
    x=torch.randn((B,N,N,D),device='cuda')
    mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>0.15).float()
    w={

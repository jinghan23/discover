+def _tensor_to(ref, dtype):
+    if ref.dtype == dtype and ref.is_contiguous():
+        return ref
+    key = _tensor_cache_key(ref, dtype)
+    cached = _TENSOR_CACHE.get(key)
+    if cached is None:
+        if len(_TENSOR_CACHE) > 96:

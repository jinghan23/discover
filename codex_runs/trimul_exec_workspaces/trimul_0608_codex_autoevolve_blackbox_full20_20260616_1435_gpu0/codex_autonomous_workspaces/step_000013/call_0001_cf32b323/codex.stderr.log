codex
The original-layout final kernels are added for benchmarking. I’m comparing final runtime and copy cost against the current transposed-weight path.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton,submission

def bench(D,N,B,mode):
 H=128; rows=B*N*N; dev='cuda'; f16=torch.float16
 x=torch.randn((B,H,N,N),device=dev,dtype=f16); gate=torch.randn((B,N,N,H),device=dev,dtype=f16); proj=torch.randn((B,N,N,5*H),device=dev,dtype=f16)
 nw=torch.randn(H,device=dev); nb=torch.randn(H,device=dev); w=torch.randn((D,H),device=dev); wt=torch.empty((H,D),device=dev,dtype=f16); wo=torch.empty((D,H),device=dev,dtype=f16); out=torch.empty((B,N,N,D),device=dev)
 br=128 if D in (384,768) else 64; bd=32 if D==128 else 64
 if mode=='copy_t':
  def fn(): wt.copy_(w.t())
 elif mode=='copy_o':
  def fn(): wo.copy_(w)
 elif mode=='pre_t':
  wt.copy_(w.t())
  def fn(): submission._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,br),)](x,gate,nw,nb,wt,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
 elif mode=='pre_o':
  wo.copy_(w)
  def fn(): submission._ln_gate_out_pre_gate_w_kernel[(triton.cdiv(rows,br),)](x,gate,nw,nb,wo,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
 elif mode=='proj_t':
  wt.copy_(w.t())
  def fn(): submission._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,br),)](x,proj,nw,nb,wt,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
 else:
  wo.copy_(w)
  def fn(): submission._ln_gate_out_proj_gate_w_kernel[(triton.cdiv(rows,br),)](x,proj,nw,nb,wo,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
 fn(); torch.cuda.synchronize(); times=[]
 for _ in range(8):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sum(times)/len(times),min(times)
for D,N,B in [(128,1024,1),(128,512,1),(384,1024,1),(384,768,1),(768,512,1)]:
 print('\\n',D,N,B)
 modes=['copy_t','copy_o']+(['pre_t','pre_o'] if D==128 else ['proj_t','proj_o'])
 for m in modes:
  avg,mn=bench(D,N,B,m); print(m,round(avg,2),round(mn,2))

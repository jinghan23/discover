/bin/bash -lc "python - <<'PY'
import torch,triton,submission

def bench(D,N,B,BR,warps):
    rows=B*N*N; dev='cuda'; f16=torch.float16; f32=torch.float32
    x=torch.randn((B,N,N,D),device=dev,dtype=f32)
    y=torch.empty_like(x,dtype=f16)
    w=torch.randn(D,device=dev); b=torch.randn(D,device=dev)
    if D==384:
      ker=submission._input_ln384_kernel; grid=(triton.cdiv(rows,BR),); kwargs=dict(rows=rows,BLOCK_R=BR,num_warps=warps)
    elif D==768:
      ker=submission._input_ln768_kernel; grid=(triton.cdiv(rows,BR),); kwargs=dict(rows=rows,BLOCK_R=BR,num_warps=warps)
    else:
      return None
    ker[grid](x,w,b,y,**kwargs); torch.cuda.synchronize()
    times=[]
    for _ in range(8):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True)
      st.record(); ker[grid](x,w,b,y,**kwargs); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times),min(times)

for D,N,B in [(384,1024,1),(384,768,1),(384,256,2),(768,1024,1),(768,512,1)]:
 print('\\nD,N,B',D,N,B)
 for BR in [1,2,4,8,16,32,64]:
  for warps in [1,2,4,8]:
   try:
    r=bench(D,N,B,BR,warps)
    if r: print('BR',BR,'w',warps,'avg',round(r[0],1),'min',round(r[1],1))
   except Exception as e:
    print('ERR',BR,warps,type(e).__name__,str(e)[:70])

codex
The dense PyTorch final path is much slower because the hidden-dimension transpose dominates. I’m checking whether PyTorch’s own elementwise plus permute path can beat our post-projection Triton kernel; if not, the current post path stays.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission

def bench(B,N,nomask,variant):
    H=128; rows=B*N*N; dev='cuda'; f16=torch.float16
    proj=torch.randn((B,N,N,5*H),device=dev,dtype=f16)
    mask=torch.ones((B,N,N),device=dev) if nomask else (torch.rand((B,N,N),device=dev)>0.15).float()
    left=torch.empty((B*H,N,N),device=dev,dtype=f16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=f16)
    def current():
      if nomask:
        submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),2)](proj,left,right,og,rows=rows,n2=N*N,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
      else:
        submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),2)](proj,mask,left,right,og,rows=rows,n2=N*N,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    def pyt():
      p=proj.view(B,N,N,5,H)
      m=1.0 if nomask else mask.unsqueeze(-1)
      l=(p[...,0,:]*torch.sigmoid(p[...,2,:])*m).permute(0,3,1,2).contiguous()
      r=(p[...,1,:]*torch.sigmoid(p[...,3,:])*m).permute(0,3,1,2).contiguous()
      o=torch.sigmoid(p[...,4,:])
      left.copy_(l.view(B*H,N,N)); right.copy_(r.view(B*H,N,N)); og.copy_(o)
    def pyt_no_copy():
      p=proj.view(B,N,N,5,H)
      m=1.0 if nomask else mask.unsqueeze(-1)
      l=(p[...,0,:]*torch.sigmoid(p[...,2,:])*m).permute(0,3,1,2).contiguous()
      r=(p[...,1,:]*torch.sigmoid(p[...,3,:])*m).permute(0,3,1,2).contiguous()
      o=torch.sigmoid(p[...,4,:])
      return l,r,o
    fn={'current':current,'pyt':pyt,'pyt_no_copy':pyt_no_copy}[variant]

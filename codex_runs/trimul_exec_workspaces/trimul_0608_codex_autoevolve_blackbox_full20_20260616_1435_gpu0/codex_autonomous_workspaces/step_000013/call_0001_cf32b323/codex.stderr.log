import torch, triton, submission

def bench(D,N,B=1,BR=64,BD=64,warps=4):
    H=128; rows=B*N*N; n2=N*N; dev='cuda'; f16=torch.float16; f32=torch.float32
    out_h=torch.randn((B,H,N,N),device=dev,dtype=f16)
    gate=torch.rand((B,N,N,H),device=dev,dtype=f16)
    nw=torch.randn(H,device=dev,dtype=f32); nb=torch.randn(H,device=dev,dtype=f32)
    ow=torch.randn(H,D,device=dev,dtype=f16)
    out=torch.empty((B,N,N,D),device=dev,dtype=f32)
    submission._ln_gate_out_kernel[(triton.cdiv(rows,BR),)](out_h,gate,nw,nb,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=warps)
    torch.cuda.synchronize()
    times=[]
    for _ in range(8):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True)
      st.record(); submission._ln_gate_out_kernel[(triton.cdiv(rows,BR),)](out_h,gate,nw,nb,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=warps); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times), min(times)

for D,N in [(384,1024),(384,768),(384,256),(128,1024),(128,768),(128,512),(128,256)]:
  print('\\nD,N',D,N)
  for BR in [16,32,64,128,256]:

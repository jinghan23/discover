+    key = (str(dtype),) + tuple((id(w), w.data_ptr(), w._version) for w in refs)
+    cached = _PROJ_W_CACHE.get(key)
+    if cached is None:
+        if len(_PROJ_W_CACHE) > 16:
+            _PROJ_W_CACHE.clear()
+        cached = torch.cat(tuple(w.to(dtype) for w in refs), dim=0).contiguous()
+        _PROJ_W_CACHE[key] = cached
+    return cached
+

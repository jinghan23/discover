import torch, triton, submission

def make(cfg):
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']
    x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float32)
    mask=torch.ones((B,N,N),device='cuda',dtype=torch.float32) if cfg.get('nomask') else (torch.rand((B,N,N),device='cuda')>0.15).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'),
      'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'),
      'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'),
      'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda'),
      'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return (x, mask, weights, {'dim':D,'hidden_dim':H,'nomask':cfg.get('nomask',False)})

def evtime(fn):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    st.record(); ret=fn(); en.record(); en.synchronize()
    return st.elapsed_time(en)*1000, ret

def profile(data):
    input_tensor, mask, weights, config = data
    dim=int(config['dim']); hidden_dim=int(config['hidden_dim']); B=input_tensor.shape[0]; N=input_tensor.shape[1]; device=input_tensor.device
    f16=torch.float16; f32=torch.float32; rows=B*N*N; n2=N*N
    x_in=input_tensor.contiguous(); nomask=bool(config.get('nomask',False)) or mask is None; mask_arg=input_tensor if mask is None else mask
    key=(device,B,N,dim,hidden_dim,'prof')
    times=[]
    out_gate=submission._buf(key,'out_gate',(B,N,N,hidden_dim),f16,device)
    def add(name, fn):
        t,_=evtime(fn); times.append((name,t))
    if dim==128 and hidden_dim==128:
        left_b=submission._buf(key,'left_b',(B*hidden_dim,N,N),f16,device)
        right_b=submission._buf(key,'right_b',(B*hidden_dim,N,N),f16,device)
        wl=submission._buf(key,'wl',(hidden_dim,dim),f16,device); wr=submission._buf(key,'wr',(hidden_dim,dim),f16,device); wlg=submission._buf(key,'wlg',(hidden_dim,dim),f16,device); wrg=submission._buf(key,'wrg',(hidden_dim,dim),f16,device); wog=submission._buf(key,'wog',(hidden_dim,dim),f16,device)
        add('weight_copies', lambda: (wl.copy_(weights['left_proj.weight']),wr.copy_(weights['right_proj.weight']),wlg.copy_(weights['left_gate.weight']),wrg.copy_(weights['right_gate.weight']),wog.copy_(weights['out_gate.weight'])))
        add('fused_proj128', lambda: submission._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask_arg,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4))
    else:
        x=submission._buf(key,'x_norm',input_tensor.shape,f16,device)
        in_rows=x.numel()//dim
        if dim==384:
            ln_br=32 if N>=1024 else (8 if N>=768 else 2)
            ln_warps=4 if N>=1024 else 1
            add('input_ln384', lambda: submission._input_ln384_kernel[(triton.cdiv(in_rows,ln_br),)](x_in,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),x,rows=in_rows,BLOCK_R=ln_br,num_warps=ln_warps))
        else:
            add('input_ln', lambda: submission._input_ln_kernel[(in_rows,)](x_in,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),x,D=dim,BLOCK=triton.next_power_of_2(dim),num_warps=1))
        left_b=submission._buf(key,'left_b',(B*hidden_dim,N,N),f16,device); right_b=submission._buf(key,'right_b',(B*hidden_dim,N,N),f16,device)
        proj_w=submission._buf(key,'proj_w',(5*hidden_dim,dim),f16,device)
        add('cat_w', lambda: torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0,out=proj_w))
        proj=submission._buf(key,'proj',(B,N,N,5*hidden_dim),f16,device)
        add('proj_mm', lambda: torch.mm(x.view(rows,dim),proj_w.t(),out=proj.view(rows,5*hidden_dim),out_dtype=f16))
        if nomask:
            add('post_nomask', lambda: submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(hidden_dim,64))](proj,left_b,right_b,out_gate,rows=rows,n2=n2,H=hidden_dim,BLOCK_R=16,BLOCK_H=64,num_warps=8))
        else:
            add('post_mask', lambda: submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(hidden_dim,64))](proj,mask_arg,left_b,right_b,out_gate,rows=rows,n2=n2,H=hidden_dim,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8))
    out_h_flat=submission._buf(key,'out_h',(B*hidden_dim,N,N),f16,device)
    add('bmm', lambda: torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat))
    out_h=out_h_flat.view(B,hidden_dim,N,N)
    out=submission._buf(key,'out',input_tensor.shape,f32,device)
    to_out_h_t=submission._buf(key,'to_out_h_t',(hidden_dim,dim),f16,device)
    add('to_out_copy', lambda: to_out_h_t.copy_(weights['to_out.weight'].t()))
    br=128 if dim==384 else 64
    add('ln_gate_out', lambda: submission._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,out_gate,weights['to_out_norm.weight'].to(f32),weights['to_out_norm.bias'].to(f32),to_out_h_t,out,rows=rows,n2=n2,H=hidden_dim,D=dim,BLOCK_R=br,BLOCK_D=64,num_warps=4))
    return times

for cfg in [
    {'bs':1,'seqlen':1024,'dim':384,'hidden_dim':128,'nomask':True},
    {'bs':1,'seqlen':768,'dim':384,'hidden_dim':128,'nomask':False},
    {'bs':1,'seqlen':1024,'dim':128,'hidden_dim':128,'nomask':True},
    {'bs':2,'seqlen':256,'dim':384,'hidden_dim':128,'nomask':False},
]:
    data=make(cfg)
    submission.custom_kernel(data); torch.cuda.synchronize()
    times=profile(data)
    print('\\n',cfg,'sum',sum(t for _,t in times))
    for n,t in times: print(n, round(t,2))

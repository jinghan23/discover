+def _transpose_ch_to_nhwc_kernel(
+    x_ptr,
+    y_ptr,
+    total: tl.constexpr,
+    H: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs = pid * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < total
+    h = offs % H
+    row = offs // H
+    bidx = row // n2
+    ij = row - bidx * n2
+    src = (bidx * H + h) * n2 + ij
+    v = tl.load(x_ptr + src, mask=mask, other=0.0)
+    tl.store(y_ptr + offs, v, mask=mask)

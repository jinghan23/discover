Direct strided BMM output is far too slow, so that route is out. The remaining layout idea is a separate channel-major to NHWC transpose followed by a contiguous-read final Triton kernel; I’m benchmarking whether the faster final pass pays for the transpose.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton,triton.language as tl,submission

@triton.jit
def ln_gate_out_nhwc(x_ptr, gate_ptr, w_ptr, b_ptr, out_w_t_ptr, out_ptr, rows:tl.constexpr, H:tl.constexpr, D:tl.constexpr, BLOCK_R:tl.constexpr, BLOCK_D:tl.constexpr):
    pid=tl.program_id(0)
    offs_r=pid*BLOCK_R+tl.arange(0,BLOCK_R)
    offs_h=tl.arange(0,128)
    valid=offs_r<rows
    x=tl.load(x_ptr+offs_r[:,None]*H+offs_h[None,:],mask=valid[:,None],other=0.0).to(tl.float32)
    mean=tl.sum(x,axis=1)*(1.0/128.0)
    xc=x-mean[:,None]
    var=tl.sum(xc*xc,axis=1)*(1.0/128.0)
    rstd=tl.rsqrt(var+1.0e-5)
    nw=tl.load(w_ptr+offs_h).to(tl.float32); nb=tl.load(b_ptr+offs_h).to(tl.float32)
    g=tl.load(gate_ptr+offs_r[:,None]*H+offs_h[None,:],mask=valid[:,None],other=0.0).to(tl.float32)
    y=((xc*rstd[:,None]*nw[None,:]+nb[None,:])*g).to(tl.float16)
    offs_db=tl.arange(0,BLOCK_D)
    for q in tl.static_range(0,D//BLOCK_D):
      offs_d=q*BLOCK_D+offs_db
      ow=tl.load(out_w_t_ptr+offs_h[:,None]*D+offs_d[None,:])
      acc=tl.dot(y,ow)
      tl.store(out_ptr+offs_r[:,None]*D+offs_d[None,:],acc,mask=valid[:,None])

@triton.jit
def transpose_ch_to_nhwc(x_ptr,y_ptr,total:tl.constexpr,H:tl.constexpr,n2:tl.constexpr,BLOCK:tl.constexpr):
    pid=tl.program_id(0)
    offs=pid*BLOCK+tl.arange(0,BLOCK)
    mask=offs<total
    # linear over output NHWC [B,n2,H]
    h=offs % H
    r=offs // H
    b=r // n2
    ij=r-b*n2
    src=(b*H+h)*n2+ij
    v=tl.load(x_ptr+src,mask=mask,other=0.0)
    tl.store(y_ptr+offs,v,mask=mask)

def bench(B,N,D,variant):
 H=128; rows=B*N*N; dev='cuda'; f16=torch.float16
 x_ch=torch.randn((B,H,N,N),device=dev,dtype=f16); gate=torch.rand((B,N,N,H),device=dev,dtype=f16)
 nw=torch.randn(H,device=dev); nb=torch.randn(H,device=dev); ow=torch.randn(H,D,device=dev,dtype=f16); out=torch.empty((B,N,N,D),device=dev)
 x_nhwc=torch.empty((B,N,N,H),device=dev,dtype=f16)
 def current():
  br=128 if D==384 else 64
  submission._ln_gate_out_kernel[(triton.cdiv(rows,br),)](x_ch,gate,nw,nb,ow,out,rows=rows,n2=N*N,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
 def torch_trans_final():
  tmp=x_ch.permute(0,2,3,1).contiguous()
  br=128 if D==384 else 64
  ln_gate_out_nhwc[(triton.cdiv(rows,br),)](tmp,gate,nw,nb,ow,out,rows=rows,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
 def triton_trans_final():
  transpose_ch_to_nhwc[(triton.cdiv(rows*H,256),)](x_ch,x_nhwc,total=rows*H,H=H,n2=N*N,BLOCK=256,num_warps=4)
  br=128 if D==384 else 64
  ln_gate_out_nhwc[(triton.cdiv(rows,br),)](x_nhwc,gate,nw,nb,ow,out,rows=rows,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
 fn={'current':current,'torch':torch_trans_final,'triton':triton_trans_final}[variant]
 fn(); torch.cuda.synchronize(); times=[]
 for _ in range(6):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sum(times)/len(times), min(times)
for D,N,B in [(384,1024,1),(384,768,1),(384,256,2),(128,1024,1),(128,768,1),(128,512,1),(128,256,2)]:
 print('\\n',D,N,B)
 for v in ['current','torch','triton']:
  try:
   avg,mn=bench(B,N,D,v); print(v,round(avg,1),round(mn,1))
  except Exception as e: print('ERR',v,type(e).__name__,str(e)[:100])

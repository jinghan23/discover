codex
The post-projection kernel has a deliberate tradeoff: current layout reads the projection contiguously but writes the channel-major buffers with a large stride. There’s an unused transposed variant that flips that tradeoff; I’m benchmarking it against block-size variants now.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission

def bench(N,B=1,H=128,nomask=True,BR=16,BH=64,warps=8,trans=False):
    rows=B*N*N; n2=N*N; dev='cuda'; f16=torch.float16
    proj=torch.randn((B,N,N,5*H),device=dev,dtype=f16)
    mask=torch.ones((B,N,N),device=dev) if nomask else (torch.rand((B,N,N),device=dev)>0.15).float()
    left=torch.empty((B*H,N,N),device=dev,dtype=f16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=f16)
    if trans:
        ker=submission._post_proj_transpose_t_kernel; grid=(triton.cdiv(rows,BR),triton.cdiv(H,BH)); args=(proj,mask,left,right,og)
        kwargs=dict(rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
    elif nomask:
        ker=submission._post_proj_transpose_nomask_kernel; grid=(triton.cdiv(rows,BR),triton.cdiv(H,BH)); args=(proj,left,right,og)
        kwargs=dict(rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
    else:
        ker=submission._post_proj_transpose_kernel; grid=(triton.cdiv(rows,BR),triton.cdiv(H,BH)); args=(proj,mask,left,right,og)
        kwargs=dict(rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
    ker[grid](*args,**kwargs); torch.cuda.synchronize()
    times=[]
    for _ in range(8):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); ker[grid](*args,**kwargs); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times), min(times)

for N,B,nomask in [(1024,1,True),(768,1,False),(256,2,False)]:
  print('\\ncase',B,N,nomask)
  for trans in ([False, True] if not nomask else [False]):
    print('trans',trans)
    for BR in [8,16,32,64,128]:
      for BH in [32,64,128]:
        if H:=128:
          if 128 % BH: continue
        for warps in [4,8]:
          try:
            avg,mn=bench(N,B,128,nomask,BR,BH,warps,trans)
            print('BR',BR,'BH',BH,'w',warps,'avg',round(avg,1),'min',round(mn,1))
          except Exception as e:
            print('ERR',trans,BR,BH,warps,type(e).__name__,str(e)[:80])

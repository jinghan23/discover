 @triton.jit
+def _ln_gate_tile_f16_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    valid_r = offs_r < rows
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    w = tl.load(w_ptr + offs_h).to(tl.float32)
+    b = tl.load(b_ptr + offs_h).to(tl.float32)
+    y_addr = offs_r[:, None] * H + offs_h[None, :]
+    g = tl.load(gate_ptr + y_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    y = ((xc * rstd[:, None] * w[None, :] + b[None, :]) * g).to(tl.float16)
+    tl.store(y_ptr + y_addr, y, mask=valid_r[:, None])
+
+
+@triton.jit

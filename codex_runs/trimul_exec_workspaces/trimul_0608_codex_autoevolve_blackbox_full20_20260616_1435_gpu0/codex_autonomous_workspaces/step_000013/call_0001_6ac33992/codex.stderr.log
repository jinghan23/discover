/bin/bash -lc "python - <<'PY'
import torch, triton, submission

def evtime(fn, repeat=3):
    times=[]
    for _ in range(repeat):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return times

def make(B,N,D,H,nomask):
    dev='cuda'
    x=torch.randn(B,N,N,D,device=dev)
    mask=torch.ones(B,N,N,device=dev) if nomask else (torch.rand(B,N,N,device=dev)>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),
      'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),
      'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),
      'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev),
    }
    return x,mask,weights

def profile(B,N,D,H,nomask):
    x_in,mask,weights=make(B,N,D,H,nomask)
    data=(x_in,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})
    for _ in range(2): submission.custom_kernel(data)
    torch.cuda.synchronize()
    f16=torch.float16; f32=torch.float32; rows=B*N*N; n2=N*N; buf_key=('prof',B,N,D,H)
    out_gate=torch.empty((B,N,N,H),device='cuda',dtype=f16)
    left_b=torch.empty((B*H,N,N),device='cuda',dtype=f16)
    right_b=torch.empty((B*H,N,N),device='cuda',dtype=f16)
    out_h_flat=torch.empty((B*H,N,N),device='cuda',dtype=f16)
    out=torch.empty((B,N,N,D),device='cuda',dtype=f32)
    if D==128:
        wl=weights['left_proj.weight'].to(f16).contiguous(); wr=weights['right_proj.weight'].to(f16).contiguous(); wlg=weights['left_gate.weight'].to(f16).contiguous(); wrg=weights['right_gate.weight'].to(f16).contiguous(); wog=weights['out_gate.weight'].to(f16).contiguous()
        def proj():
            submission._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask,weights['norm.weight'],weights['norm.bias'],wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4)
    else:
        xnorm=torch.empty_like(x_in,dtype=f16)
        proj_w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(f16).contiguous()
        projbuf=torch.empty((B,N,N,5*H),device='cuda',dtype=f16)
        def ln():
            br=32 if N>=1024 else (8 if N>=768 else 2)
            submission._input_ln384_kernel[(triton.cdiv(rows,br),)](x_in,weights['norm.weight'],weights['norm.bias'],xnorm,rows=rows,BLOCK_R=br,num_warps=(4 if N>=1024 else 1))
        print('LN', [round(t,1) for t in evtime(ln)])
        ln(); torch.cuda.synchronize()
        def mm(): torch.mm(xnorm.view(rows,D),proj_w.t(),out=projbuf.view(rows,5*H),out_dtype=f16)
        print('MM proj', [round(t,1) for t in evtime(mm)])
        mm(); torch.cuda.synchronize()
        def post():
            if nomask:
                submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](projbuf,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
            else:
                submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](projbuf,mask,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
        print('post', [round(t,1) for t in evtime(post)])
        def proj():
            ln(); mm(); post()
    proj(); torch.cuda.synchronize()
    def bmm(): torch.bmm(left_b, right_b.transpose(1,2), out=out_h_flat)
    print('bmm', [round(t,1) for t in evtime(bmm)])
    bmm(); torch.cuda.synchronize()
    to_out_h_t=weights['to_out.weight'].to(f16).t().contiguous()
    out_h=out_h_flat.view(B,H,N,N)
    def outker():
        br=128 if D==384 else 64
        submission._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,out_gate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],to_out_h_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
    print('out', [round(t,1) for t in evtime(outker)])
    print('total custom', [round(t,1) for t in evtime(lambda: submission.custom_kernel(data))])

print('--- D384 N1024 ---')
profile(1,1024,384,128,True)
print('--- D384 N768 mask ---')
profile(1,768,384,128,False)
print('--- D128 N1024 ---')
profile(1,1024,128,128,True)

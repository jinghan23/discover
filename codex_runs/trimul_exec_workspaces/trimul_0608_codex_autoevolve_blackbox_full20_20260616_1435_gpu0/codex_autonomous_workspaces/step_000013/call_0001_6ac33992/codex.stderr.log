  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"dist\":\"normal\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"dist\":\"cauchy\"},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"dist\":\"normal\"},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"dist\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"dist\":\"cauchy\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"dist\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"dist\":\"normal\"},
]

def make(case):
    B,N,D,H=case['bs'],case['seqlen'],case['dim'],case['hidden_dim']
    dev='cuda'
    if case['dist']=='cauchy':
        x = torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev)
    else:
        x=torch.randn(B,N,N,D,device=dev)
    if case['nomask']:
        mask=torch.ones(B,N,N,device=dev)
    else:
        mask=(torch.rand(B,N,N,device=dev)>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device=dev),
      'norm.bias': torch.randn(D,device=dev),
      'left_proj.weight': torch.randn(H,D,device=dev),
      'right_proj.weight': torch.randn(H,D,device=dev),
      'left_gate.weight': torch.randn(H,D,device=dev),
      'right_gate.weight': torch.randn(H,D,device=dev),
      'out_gate.weight': torch.randn(H,D,device=dev),
      'to_out_norm.weight': torch.randn(H,device=dev),
      'to_out_norm.bias': torch.randn(H,device=dev),
      'to_out.weight': torch.randn(D,H,device=dev),
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':case['nomask']})

for i,case in enumerate(shapes):
    data=make(case)
    # warmup compile/use cache
    for _ in range(2):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(5):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); y=submission.custom_kernel(data); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    print(i, case, 'us', [round(t,1) for t in times], 'avg', round(sum(times)/len(times),1))
    del data,y
    torch.cuda.empty_cache()

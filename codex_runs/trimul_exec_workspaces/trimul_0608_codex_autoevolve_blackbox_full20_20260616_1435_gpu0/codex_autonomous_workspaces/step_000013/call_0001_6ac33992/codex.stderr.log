codex
For `dim=128`, the file uses a custom fused projection path instead of cuBLAS. I’m going to compare that against the generic LN + large cuBLAS projection + post path; if cuBLAS wins for large `N`, that could be a real aggregate improvement.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton,importlib,submission
importlib.reload(submission)
for N,B,nomask in [(256,2,True),(512,1,True),(768,1,True),(1024,1,True)]:
 D=128; H=128; rows=B*N*N; n2=N*N; dev='cuda'
 x=torch.randn(B,N,N,D,device=dev); mask=torch.ones(B,N,N,device=dev)
 nw=torch.randn(D,device=dev); nb=torch.randn(D,device=dev)
 weights=[torch.randn(H,D,device=dev) for _ in range(5)]
 ws=[w.to(torch.float16).contiguous() for w in weights]
 left=torch.empty(B*H,N,N,device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device=dev,dtype=torch.float16)
 xnorm=torch.empty_like(x,dtype=torch.float16); proj=torch.empty(B,N,N,5*H,device=dev,dtype=torch.float16); pw=torch.cat(weights,dim=0).to(torch.float16).contiguous()
 def fused():
  submission._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,mask,nw,nb,ws[0],ws[1],ws[2],ws[3],ws[4],left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4)
 def ln(): submission._input_ln_kernel[(rows,)](x,nw,nb,xnorm,D=D,BLOCK=128,num_warps=1)
 def mm(): torch.mm(xnorm.view(rows,D),pw.t(),out=proj.view(rows,5*H),out_dtype=torch.float16)
 def post(): submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 # warm
 for _ in range(2): fused(); ln(); mm(); post()
 torch.cuda.synchronize()
 def time(fn):
  a=[]
  for _ in range(5):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
  return sum(a)/len(a), [round(v,1) for v in a]
 print('\\nN',N,'B',B)
 print('fused', time(fused))
 print('ln', time(ln))
 print('mm', time(mm))
 print('post', time(post))
 print('pipeline', time(lambda:(ln(),mm(),post())))

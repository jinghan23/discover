codex
The post-processing block sizes are already essentially optimal. I’ll check one more cuBLAS entry point for the packed projection (`linear` vs `mm`) because the projection GEMM is still the largest phase in the `dim=384` cases.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N,B,D,H in [(1024,1,384,128),(768,1,384,128),(256,2,384,128),(1024,1,128,128)]:
 rows=B*N*N; x=torch.randn(rows,D,device='cuda',dtype=torch.float16); w=torch.randn(5*H,D,device='cuda',dtype=torch.float16); out=torch.empty(rows,5*H,device='cuda',dtype=torch.float16)
 for _ in range(3):
  torch.mm(x,w.t(),out=out,out_dtype=torch.float16)
  torch.nn.functional.linear(x,w)
 torch.cuda.synchronize()
 def time(fn):
  a=[]
  for _ in range(5):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
  return sum(a)/len(a), [round(v,1) for v in a]
 print('\\nN,D',N,D)
 print('mm out', time(lambda: torch.mm(x,w.t(),out=out,out_dtype=torch.float16)))
 print('linear alloc', time(lambda: torch.nn.functional.linear(x,w)))

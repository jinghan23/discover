codex
The column-layout post kernel is added but not used by `custom_kernel`. I’ll benchmark it against the existing row-layout post path before deciding whether to route any shape through it.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton,importlib,submission
importlib.reload(submission)
for N,B,nomask in [(1024,1,True),(768,1,False),(256,2,False)]:
 D=384; H=128; rows=B*N*N; n2=N*N; dev='cuda'
 x=torch.randn(rows,D,device=dev,dtype=torch.float16); w=torch.randn(5*H,D,device=dev,dtype=torch.float16)
 proj_row=torch.empty(rows,5*H,device=dev,dtype=torch.float16)
 proj_col_base=torch.empty(5*H,rows,device=dev,dtype=torch.float16); proj_col_view=torch.as_strided(proj_col_base,(rows,5*H),(1,rows))
 mask=(torch.rand(B,N,N,device=dev)>0.2).float(); left=torch.empty(B*H,N,N,device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device=dev,dtype=torch.float16)
 def row_mm(): torch.mm(x,w.t(),out=proj_row,out_dtype=torch.float16)
 def col_mm(): torch.mm(x,w.t(),out=proj_col_view,out_dtype=torch.float16)
 def row_post():
  if nomask:
   submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj_row,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
  else:
   submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj_row,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 def col_post(br=16,bh=64,nw=8):
  submission._post_proj_col_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj_col_base,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
 for _ in range(2): row_mm(); row_post(); col_mm(); col_post()
 torch.cuda.synchronize()
 def time(fn):
  a=[]
  for _ in range(5):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
  return sum(a)/len(a), [round(v,1) for v in a]
 print('\\nN',N,'nomask',nomask)
 print('row mm',time(row_mm)); print('row post',time(row_post)); print('row both',time(lambda:(row_mm(),row_post())))
 print('col mm',time(col_mm)); print('col post',time(col_post)); print('col both',time(lambda:(col_mm(),col_post())))
 # a couple col tile variants
 for br,bh,nw in [(32,64,8),(64,64,8),(16,128,8),(32,128,8)]:
  print('colpost',br,bh,nw,time(lambda br=br,bh=bh,nw=nw: col_post(br,bh,nw))[0])

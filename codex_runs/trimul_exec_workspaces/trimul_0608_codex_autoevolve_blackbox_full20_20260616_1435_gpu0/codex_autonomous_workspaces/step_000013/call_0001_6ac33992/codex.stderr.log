/bin/bash -lc "python - <<'PY'
import torch, triton, submission
B,N,D,H=1,1024,384,128
dev='cuda'
x=torch.randn(B,N,N,D,device=dev); w=torch.randn(D,device=dev); b=torch.randn(D,device=dev)
xh=torch.empty_like(x,dtype=torch.float16)
# warm
for _ in range(3):
    torch.nn.functional.layer_norm(x,(D,),w,b).to(torch.float16)
    submission._input_ln384_kernel[(triton.cdiv(B*N*N,32),)](x,w,b,xh,rows=B*N*N,BLOCK_R=32,num_warps=4)
torch.cuda.synchronize()
def time(fn):

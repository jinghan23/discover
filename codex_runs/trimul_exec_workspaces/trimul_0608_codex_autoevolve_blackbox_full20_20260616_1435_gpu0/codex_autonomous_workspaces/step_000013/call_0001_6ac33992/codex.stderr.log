codex
I’m checking one possible bmm layout tradeoff: cuBLAS currently consumes a transposed view of `right_b`. A physical contiguous transpose would only be worth it if bmm improved more than the copy cost, so I’ll measure it locally without changing the submission.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N,BH in [(256,256),(512,128),(768,128),(1024,128)]:
 left=torch.randn(BH,N,N,device='cuda',dtype=torch.float16); right=torch.randn(BH,N,N,device='cuda',dtype=torch.float16); out=torch.empty_like(left)
 rt=torch.empty_like(right)
 for _ in range(3):
  torch.bmm(left,right.transpose(1,2),out=out)
  rt.copy_(right.transpose(1,2)); torch.bmm(left,rt,out=out)
 torch.cuda.synchronize()
 def time(fn):
  a=[]
  for _ in range(5):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
  return sum(a)/len(a), [round(x,1) for x in a]
 print('\\nN',N,'BH',BH)
 print('bmm trans view',time(lambda: torch.bmm(left,right.transpose(1,2),out=out)))
 print('contig transpose copy',time(lambda: rt.copy_(right.transpose(1,2))))
 print('bmm contig',time(lambda: torch.bmm(left,rt,out=out)))
 print('copy+bmm',time(lambda:(rt.copy_(right.transpose(1,2)), torch.bmm(left,rt,out=out))))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

codex
Native layer norm is slower here, so I’m keeping the Triton LN. The next likely issue is the large packed projection GEMM layout; I’ll test whether storing its transposed weight contiguously changes cuBLAS performance.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission
B,N,D,H=1,1024,384,128; rows=B*N*N; dev='cuda'
x=torch.randn(B,N,N,D,device=dev,dtype=torch.float16)
refs=[torch.randn(H,D,device=dev) for _ in range(5)]
w_cat=torch.cat(refs,dim=0).to(torch.float16).contiguous()
w_t=w_cat.t().contiguous()
out=torch.empty(rows,5*H,device=dev,dtype=torch.float16)
# compile/warm
for _ in range(3):
    torch.mm(x.view(rows,D),w_cat.t(),out=out,out_dtype=torch.float16)
    torch.mm(x.view(rows,D),w_t,out=out,out_dtype=torch.float16)
torch.cuda.synchronize()
def time(fn):
    a=[]
    for _ in range(6):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
    return [round(v,1) for v in a]
print('noncontig transpose', time(lambda: torch.mm(x.view(rows,D),w_cat.t(),out=out,out_dtype=torch.float16)))
print('contig transposed', time(lambda: torch.mm(x.view(rows,D),w_t,out=out,out_dtype=torch.float16)))

codex
There is one more layout idea for the 384 projection path: ask `torch.mm` to write the packed projection in column-major form, which matches the channel-major `left/right` buffers. If cuBLAS accepts that layout efficiently, the post kernel may get cheaper. I’ll test the mm layout first.
exec
/bin/bash -lc "python - <<'PY'
import torch
for N,B,D,H in [(1024,1,384,128),(768,1,384,128),(256,2,384,128)]:
 rows=B*N*N; x=torch.randn(rows,D,device='cuda',dtype=torch.float16); w=torch.randn(5*H,D,device='cuda',dtype=torch.float16)
 out_row=torch.empty(rows,5*H,device='cuda',dtype=torch.float16)
 out_col_base=torch.empty(5*H,rows,device='cuda',dtype=torch.float16)
 out_col=torch.as_strided(out_col_base,(rows,5*H),(1,rows))
 for _ in range(3):
  torch.mm(x,w.t(),out=out_row,out_dtype=torch.float16)
  torch.mm(x,w.t(),out=out_col,out_dtype=torch.float16)
 torch.cuda.synchronize()
 def time(fn):
  a=[]
  for _ in range(5):
   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); a.append(st.elapsed_time(en)*1000)
  return sum(a)/len(a), [round(v,1) for v in a]
 print('\\nN',N)
 print('row out',time(lambda: torch.mm(x,w.t(),out=out_row,out_dtype=torch.float16)))
 print('col view out',time(lambda: torch.mm(x,w.t(),out=out_col,out_dtype=torch.float16)))

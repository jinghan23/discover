exec
/bin/bash -lc "python - <<'PY'
import torch, submission
from torch.profiler import profile, ProfilerActivity
N,B,D,H=1024,1,384,128
device='cuda'
torch.manual_seed(1)
x=torch.randn(B,N,N,D,device=device)
mask=torch.ones(B,N,N,device=device)
weights={
 'norm.weight': torch.randn(D,device=device), 'norm.bias': torch.randn(D,device=device),
 'left_proj.weight': torch.randn(H,D,device=device), 'right_proj.weight': torch.randn(H,D,device=device),
 'left_gate.weight': torch.randn(H,D,device=device), 'right_gate.weight': torch.randn(H,D,device=device), 'out_gate.weight': torch.randn(H,D,device=device),
 'to_out_norm.weight': torch.randn(H,device=device), 'to_out_norm.bias': torch.randn(H,device=device), 'to_out.weight': torch.randn(D,H,device=device)}
data=(x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':True})
for _ in range(3): submission.custom_kernel(data)
torch.cuda.synchronize()
with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA], record_shapes=False) as prof:
    submission.custom_kernel(data)
    torch.cuda.synchronize()
print(prof.key_averages().table(sort_by='cuda_time_total', row_limit=20))

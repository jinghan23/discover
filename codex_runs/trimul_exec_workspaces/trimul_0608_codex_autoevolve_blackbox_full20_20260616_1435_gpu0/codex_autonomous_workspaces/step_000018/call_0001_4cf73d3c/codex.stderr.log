/bin/bash -lc "python - <<'PY'
import torch, time, importlib
import submission

torch.manual_seed(0)

def make_case(N,B,D,H,nomask,dist='normal'):
    device='cuda'
    if dist=='cauchy':
        x = torch.distributions.Cauchy(torch.tensor(0.,device=device), torch.tensor(2.,device=device)).sample((B,N,N,D))
    else:
        x = torch.randn(B,N,N,D,device=device)
    mask = torch.ones(B,N,N,device=device) if nomask else (torch.rand(B,N,N,device=device)>0.2).float()
    weights={
        'norm.weight': torch.randn(D,device=device),
        'norm.bias': torch.randn(D,device=device),
        'left_proj.weight': torch.randn(H,D,device=device),
        'right_proj.weight': torch.randn(H,D,device=device),
        'left_gate.weight': torch.randn(H,D,device=device),
        'right_gate.weight': torch.randn(H,D,device=device),
        'out_gate.weight': torch.randn(H,D,device=device),
        'to_out_norm.weight': torch.randn(H,device=device),
        'to_out_norm.bias': torch.randn(H,device=device),
        'to_out.weight': torch.randn(D,H,device=device),
    }
    config={'dim':D,'hidden_dim':H,'nomask':nomask,'seqlen':N,'bs':B}
    return (x,mask,weights,config)

def bench(case, iters=20):
    data=make_case(*case)
    for _ in range(5):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(iters):
        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
        s.record(); y=submission.custom_kernel(data); e.record(); e.synchronize()
        times.append(s.elapsed_time(e)*1000)
    print(case, 'min', min(times), 'avg', sum(times)/len(times), 'out', y.shape, y.dtype)

cases=[(256,2,128,128,True,'normal'),(768,1,128,128,True,'cauchy'),(256,2,384,128,False,'normal'),(512,1,128,128,True,'normal'),(1024,1,128,128,True,'cauchy'),(768,1,384,128,False,'normal'),(1024,1,384,128,True,'normal')]
for c in cases:
    bench(c, iters=10)

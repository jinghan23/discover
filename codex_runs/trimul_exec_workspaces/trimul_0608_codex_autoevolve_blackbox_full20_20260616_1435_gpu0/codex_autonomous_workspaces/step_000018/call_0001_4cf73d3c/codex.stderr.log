import torch, submission
for N,B,nomask in [(768,1,False),(1024,1,True)]:
 D,H=384,128; device='cuda'; torch.manual_seed(5)
 x=torch.randn(B,N,N,D,device=device); mask=torch.ones(B,N,N,device=device) if nomask else (torch.rand(B,N,N,device=device)>0.2).float()
 weights={k: torch.randn(*shape,device=device) for k,shape in {'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D), 'right_proj.weight':(H,D), 'left_gate.weight':(H,D), 'right_gate.weight':(H,D), 'out_gate.weight':(H,D), 'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 data=(x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})
 for _ in range(5): submission.custom_kernel(data)
 torch.cuda.synchronize(); times=[]
 for _ in range(10):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); submission.custom_kernel(data); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
 print((N,B,D,nomask),'min',min(times),'avg',sum(times)/len(times),times)

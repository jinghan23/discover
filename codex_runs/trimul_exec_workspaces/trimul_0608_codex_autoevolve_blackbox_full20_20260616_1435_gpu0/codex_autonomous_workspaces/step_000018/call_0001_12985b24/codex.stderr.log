/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s
B,N,D,H=1,1024,384,128; rows=B*N*N; n2=N*N; dev='cuda'
out_h=torch.randn(B,H,N,N,device=dev,dtype=torch.float16); proj=torch.randn(B,N,N,5*H,device=dev,dtype=torch.float16)
w=torch.randn(H,device=dev); b=torch.randn(H,device=dev); tow=torch.randn(D,H,device=dev); tow_t=tow.t().contiguous().half()
gated=torch.empty(B,N,N,H,device=dev,dtype=torch.float16); out=torch.empty(B,N,N,D,device=dev,dtype=torch.float32)
# current fused
s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,w,b,tow_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
torch.cuda.synchronize()
# split variants
for br in [32,64,128,256]:
  for nw in [1,2,4,8]:
    try:
      s._ln_store_proj_gate_kernel[(triton.cdiv(rows,br),)](out_h,proj,w,b,gated,rows=rows,n2=n2,H=H,BLOCK_R=br,num_warps=nw)
      torch.mm(gated.view(rows,H), tow_t, out=out.view(rows,D), out_dtype=torch.float32)
      torch.cuda.synchronize()
      t1=[];t2=[];tt=[]
      for _ in range(5):
        st=torch.cuda.Event(True); mid=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()
        s._ln_store_proj_gate_kernel[(triton.cdiv(rows,br),)](out_h,proj,w,b,gated,rows=rows,n2=n2,H=H,BLOCK_R=br,num_warps=nw)
        mid.record(); torch.mm(gated.view(rows,H), tow_t, out=out.view(rows,D), out_dtype=torch.float32); en.record(); en.synchronize()
        t1.append(st.elapsed_time(mid)*1000); t2.append(mid.elapsed_time(en)*1000); tt.append(st.elapsed_time(en)*1000)
      print('br',br,'warps',nw,'lnstore',min(t1),'mm',min(t2),'total',min(tt))

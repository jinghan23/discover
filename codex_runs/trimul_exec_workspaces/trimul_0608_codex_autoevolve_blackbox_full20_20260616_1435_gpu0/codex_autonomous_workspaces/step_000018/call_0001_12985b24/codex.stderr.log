index 5ac5dbe9c17d13e763bfa9f9f6ad091646ecdcf6..51a63c945317ead07ca91af4b8e4b61d0690ff86
--- a/submission.py
+++ b/submission.py
@@ -23,6 +23,7 @@
 _BUF_CACHE = {}
 _BUF_SHAPE = None
 _STREAM_CACHE = {}
+_GRAPH_CACHE = {}
 
 
 def _buf(shape_key, name, shape, dtype, device):
@@ -932,7 +933,7 @@
     tl.store(right_ptr + bh, r * tl.sigmoid(rg), mask=valid)
 
 
-def custom_kernel(data):
+def _custom_kernel_impl(data):
     input_tensor, mask, weights, config = data
     dim = int(config["dim"])
     hidden_dim = int(config["hidden_dim"])
@@ -1218,3 +1219,52 @@
         )
         torch.mm(gated.view(rows, hidden_dim), to_out_w.to(f32).t(), out=out.view(rows, dim))
     return out
+
+
+def custom_kernel(data):
+    input_tensor, mask, weights, config = data
+    if torch.cuda.is_current_stream_capturing():
+        return _custom_kernel_impl(data)
+    dim = int(config["dim"])
+    hidden_dim = int(config["hidden_dim"])
+    seq_len = input_tensor.shape[1]
+    batch_size = input_tensor.shape[0]
+    mask_ptr = 0 if mask is None else mask.data_ptr()
+    refs = (
+        weights["norm.weight"],
+        weights["norm.bias"],
+        weights["left_proj.weight"],
+        weights["right_proj.weight"],
+        weights["left_gate.weight"],
+        weights["right_gate.weight"],
+        weights["out_gate.weight"],
+        weights["to_out_norm.weight"],
+        weights["to_out_norm.bias"],
+        weights["to_out.weight"],
+    )
+    key = (
+        input_tensor.device.index,
+        batch_size,
+        seq_len,
+        dim,
+        hidden_dim,
+        bool(config.get("nomask", False)) or mask is None,
+        input_tensor.data_ptr(),
+        mask_ptr,
+    ) + tuple((r.data_ptr(), r._version) for r in refs)
+    cached = _GRAPH_CACHE.get(key)
+    if cached is not None:
+        graph, out = cached
+        graph.replay()
+        return out
+
+    if len(_GRAPH_CACHE) > 16:
+        _GRAPH_CACHE.clear()
+    _custom_kernel_impl(data)
+    torch.cuda.synchronize(input_tensor.device)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = _custom_kernel_impl(data)
+    graph.replay()
+    _GRAPH_CACHE[key] = (graph, out)
+    return out


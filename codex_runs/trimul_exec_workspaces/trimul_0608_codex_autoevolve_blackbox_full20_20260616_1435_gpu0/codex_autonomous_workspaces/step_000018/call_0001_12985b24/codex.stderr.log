def bench(N,B=1,D=384):
    print('N',N,'B',B)
    rows=B*N*N; x=torch.randn(B,N,N,D,device='cuda'); y=torch.empty_like(x,dtype=torch.float16); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda')

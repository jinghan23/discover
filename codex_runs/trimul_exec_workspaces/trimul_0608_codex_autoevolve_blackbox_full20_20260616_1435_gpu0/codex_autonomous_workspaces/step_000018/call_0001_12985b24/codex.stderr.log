/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s
B,N,D,H=1,1024,128,128; rows=B*N*N; n2=N*N; dev='cuda'
x=torch.randn(B,N,N,D,device=dev); mask=x
w=torch.randn(D,device=dev); b=torch.randn(D,device=dev)
weights=[torch.randn(H,D,device=dev,dtype=torch.float16) for _ in range(5)]
left=torch.empty(B*H,N,N,device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device=dev,dtype=torch.float16)
for bm in [16,32,64,128]:
  for bh in [16,32,64]:
    if 128 % bh: continue
    for nw in [2,4,8]:
      try:
        s._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,mask,w,b,*weights,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw,num_stages=1)
        torch.cuda.synchronize(); times=[]
        for _ in range(5):
          st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()
          s._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,mask,w,b,*weights,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw,num_stages=1)
          en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
        print('bm',bm,'bh',bh,'warps',nw,'min',min(times))
      except Exception as e:
        print('ERR','bm',bm,'bh',bh,'warps',nw,type(e).__name__,str(e)[:80])

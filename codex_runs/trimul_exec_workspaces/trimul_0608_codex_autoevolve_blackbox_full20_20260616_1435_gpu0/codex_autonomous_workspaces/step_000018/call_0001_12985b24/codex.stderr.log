codex
A local A800 is available, so I can get useful timing breakdowns without relying only on the blackbox aggregate. I’ll benchmark each listed shape with the current candidate.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, time, importlib
import submission

torch.manual_seed(0)
shapes = [
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
]

def make_weights(D,H):
    dev='cuda'
    return {
      'norm.weight': torch.randn(D,device=dev),
      'norm.bias': torch.randn(D,device=dev),
      'left_proj.weight': torch.randn(H,D,device=dev)/D**0.5,
      'right_proj.weight': torch.randn(H,D,device=dev)/D**0.5,
      'left_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'right_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'out_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'to_out_norm.weight': torch.randn(H,device=dev),
      'to_out_norm.bias': torch.randn(H,device=dev),
      'to_out.weight': torch.randn(D,H,device=dev)/H**0.5,
    }

for cfg in shapes:
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']
    if cfg['distribution']=='cauchy':
        x=torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda()
    else:
        x=torch.randn(B,N,N,D,device='cuda')
    mask=None if cfg['nomask'] else (torch.rand(B,N,N,device='cuda')>0.2).float()
    w=make_weights(D,H)
    data=(x,mask,w,cfg)
    # compile/warm
    for _ in range(3):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); y=submission.custom_kernel(data); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    print(cfg, 'min', min(times), 'avg', sum(times)/len(times))
    del x,mask,w,data,y
    torch.cuda.empty_cache()

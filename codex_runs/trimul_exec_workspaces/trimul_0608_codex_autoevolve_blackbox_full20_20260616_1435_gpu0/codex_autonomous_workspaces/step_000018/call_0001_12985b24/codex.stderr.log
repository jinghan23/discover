/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(1)

def weights(D,H):
    dev='cuda'
    return {
      'norm.weight': torch.randn(D,device=dev), 'norm.bias': torch.randn(D,device=dev),
      'left_proj.weight': torch.randn(H,D,device=dev)/D**0.5,
      'right_proj.weight': torch.randn(H,D,device=dev)/D**0.5,
      'left_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'right_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'out_gate.weight': torch.randn(H,D,device=dev)/D**0.5,
      'to_out_norm.weight': torch.randn(H,device=dev), 'to_out_norm.bias': torch.randn(H,device=dev),
      'to_out.weight': torch.randn(D,H,device=dev)/H**0.5,
    }

def evtime(fn, reps=5):
    times=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return min(times)

def profile(B,N,D,H,nomask):
    print('PROFILE',B,N,D,H,nomask)
    x_in=torch.randn(B,N,N,D,device='cuda')
    mask=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float()
    w=weights(D,H)
    f16=torch.float16; f32=torch.float32
    rows=B*N*N; n2=N*N; device=x_in.device
    key=(device,B,N,D,H,'prof')
    mask_arg=x_in if mask is None else mask
    norm_w=w['norm.weight']; norm_b=w['norm.bias']; out_norm_w=w['to_out_norm.weight']; out_norm_b=w['to_out_norm.bias']; to_out_w=w['to_out.weight']
    if D==128:
        out_gate=s._buf(key,'og',(B,N,N,H),f16,device); left_b=s._buf(key,'lb',(B*H,N,N),f16,device); right_b=s._buf(key,'rb',(B*H,N,N),f16,device)
        wl=s._buf(key,'wl',(H,D),f16,device); wr=s._buf(key,'wr',(H,D),f16,device); wlg=s._buf(key,'wlg',(H,D),f16,device); wrg=s._buf(key,'wrg',(H,D),f16,device); wog=s._buf(key,'wog',(H,D),f16,device)
        wl.copy_(w['left_proj.weight']); wr.copy_(w['right_proj.weight']); wlg.copy_(w['left_gate.weight']); wrg.copy_(w['right_gate.weight']); wog.copy_(w['out_gate.weight'])
        def stage1():
            s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask_arg,norm_w.to(f32),norm_b.to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1)
        stage1(); torch.cuda.synchronize()
        print('proj', evtime(stage1))
        to_out_h_t=s._buf(key,'towt',(H,D),f16,device); to_out_h_t.copy_(to_out_w.t())
        out_h_flat=s._buf(key,'oh',(B*H,N,N),f16,device)
        def stage2(): torch.bmm(left_b, right_b.transpose(1,2), out=out_h_flat)
        stage2(); torch.cuda.synchronize(); print('bmm', evtime(stage2))
        out_h=out_h_flat.view(B,H,N,N); out=s._buf(key,'out',x_in.shape,f32,device)
        def stage3():
            s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,64),)](out_h,out_gate,out_norm_w.to(f32),out_norm_b.to(f32),to_out_h_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4)
        stage3(); torch.cuda.synchronize(); print('final', evtime(stage3))
    else:
        x=s._buf(key,'xn',x_in.shape,f16,device); in_rows=x.numel()//D
        def ln():
            s._input_ln384_kernel[(triton.cdiv(in_rows,32),)](x_in,norm_w.to(f32),norm_b.to(f32),x,rows=in_rows,BLOCK_R=32,num_warps=4)
        ln(); torch.cuda.synchronize(); print('ln', evtime(ln))
        left_b=s._buf(key,'lb',(B*H,N,N),f16,device); right_b=s._buf(key,'rb',(B*H,N,N),f16,device)
        proj_w=s._buf(key,'pw',(5*H,D),f16,device)
        torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
        proj=s._buf(key,'proj',(B,N,N,5*H),f16,device)
        def mm(): torch.mm(x.view(rows,D), proj_w.t(), out=proj.view(rows,5*H), out_dtype=f16)
        mm(); torch.cuda.synchronize(); print('mm', evtime(mm))
        def post():
            if nomask:
                s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left_b,right_b,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8)
            else:
                s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,mask_arg,left_b,right_b,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=32,BLOCK_H=64,num_warps=8)
        post(); torch.cuda.synchronize(); print('post', evtime(post))
        out_h_flat=s._buf(key,'oh',(B*H,N,N),f16,device)
        def bmm(): torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat)
        bmm(); torch.cuda.synchronize(); print('bmm', evtime(bmm))
        to_out_h_t=s._buf(key,'towt',(H,D),f16,device); to_out_h_t.copy_(to_out_w.t())
        out_h=out_h_flat.view(B,H,N,N); out=s._buf(key,'out',x_in.shape,f32,device)
        def fin():
            s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,out_norm_w.to(f32),out_norm_b.to(f32),to_out_h_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
        fin(); torch.cuda.synchronize(); print('final', evtime(fin))


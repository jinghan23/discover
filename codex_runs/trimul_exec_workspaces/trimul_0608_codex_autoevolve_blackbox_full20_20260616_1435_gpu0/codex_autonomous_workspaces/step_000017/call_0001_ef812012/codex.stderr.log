import torch, triton, gc
import submission as s

torch.manual_seed(1)

def make(B,N,D,H,nomask):
    dev='cuda'
    x=torch.randn(B,N,N,D,device=dev,dtype=torch.float32)*0.02
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.15).float()
    scale=0.02
    weights={
      'norm.weight': torch.ones(D,device=dev,dtype=torch.float32),
      'norm.bias': torch.zeros(D,device=dev,dtype=torch.float32),
      'left_proj.weight': torch.randn(H,D,device=dev,dtype=torch.float32)*scale,
      'right_proj.weight': torch.randn(H,D,device=dev,dtype=torch.float32)*scale,
      'left_gate.weight': torch.randn(H,D,device=dev,dtype=torch.float32)*scale,
      'right_gate.weight': torch.randn(H,D,device=dev,dtype=torch.float32)*scale,
      'out_gate.weight': torch.randn(H,D,device=dev,dtype=torch.float32)*scale,
      'to_out_norm.weight': torch.ones(H,device=dev,dtype=torch.float32),
      'to_out_norm.bias': torch.zeros(H,device=dev,dtype=torch.float32),
      'to_out.weight': torch.randn(D,H,device=dev,dtype=torch.float32)*scale,
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

def ev(): return torch.cuda.Event(enable_timing=True)

def elapsed(a,b): torch.cuda.synchronize(); return a.elapsed_time(b)*1000

def profile_once(data):
    input_tensor, mask, weights, config = data
    dim=int(config['dim']); H=int(config['hidden_dim']); B=input_tensor.shape[0]; N=input_tensor.shape[1]; rows=B*N*N; n2=N*N; dev=input_tensor.device
    f16=torch.float16; f32=torch.float32; proj_dtype=f16
    norm_w=weights['norm.weight']; norm_b=weights['norm.bias']; out_norm_w=weights['to_out_norm.weight']; out_norm_b=weights['to_out_norm.bias']; to_out_w=weights['to_out.weight']
    x_in=input_tensor.contiguous(); key=(dev,B,N,dim,H,'prof'); nomask=bool(config.get('nomask',False)) or mask is None; mask_arg=input_tensor if mask is None else mask
    times=[]
    def run_stage(name, fn):
        a=ev(); b=ev(); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); times.append((name,a.elapsed_time(b)*1000)); return r
    if dim==128 and H==128:
        out_gate=s._buf(key,'og',(B,N,N,H),f16,dev); left_b=s._buf(key,'lb',(B*H,N,N),f16,dev); right_b=s._buf(key,'rb',(B*H,N,N),f16,dev)
        wl=s._buf(key,'wl',(H,dim),f16,dev); wr=s._buf(key,'wr',(H,dim),f16,dev); wlg=s._buf(key,'wlg',(H,dim),f16,dev); wrg=s._buf(key,'wrg',(H,dim),f16,dev); wog=s._buf(key,'wog',(H,dim),f16,dev)
        run_stage('copy proj weights', lambda: (wl.copy_(weights['left_proj.weight']), wr.copy_(weights['right_proj.weight']), wlg.copy_(weights['left_gate.weight']), wrg.copy_(weights['right_gate.weight']), wog.copy_(weights['out_gate.weight'])))
        run_stage('fused proj128', lambda: s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask_arg,norm_w.to(f32),norm_b.to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1))
        proj=None
    else:
        x=s._buf(key,'x_norm',input_tensor.shape,proj_dtype,dev); in_rows=x.numel()//dim
        if dim==384:
            ln_br=32 if N>=1024 else (8 if N>=768 else (2 if N==256 else 1)); ln_warps=2 if N>=1024 else 1
            run_stage('input ln384', lambda: s._input_ln384_kernel[(triton.cdiv(in_rows,ln_br),)](x_in,norm_w.to(f32),norm_b.to(f32),x,rows=in_rows,BLOCK_R=ln_br,num_warps=ln_warps))
        else:
            run_stage('input ln', lambda: s._input_ln_kernel[(in_rows,)](x_in,norm_w.to(f32),norm_b.to(f32),x,D=dim,BLOCK=triton.next_power_of_2(dim),num_warps=1))
        left_b=s._buf(key,'lb',(B*H,N,N),f16,dev); right_b=s._buf(key,'rb',(B*H,N,N),f16,dev)
        proj_w=s._buf(key,'proj_w',(5*H,dim),proj_dtype,dev)
        run_stage('cat proj_w', lambda: torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0,out=proj_w))
        proj=s._buf(key,'proj',(B,N,N,5*H),proj_dtype,dev)
        run_stage('mm projections', lambda: torch.mm(x.view(rows,dim),proj_w.t(),out=proj.view(rows,5*H),out_dtype=proj_dtype))
        run_stage('post transpose', lambda: s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,mask_arg,left_b,right_b,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=32,BLOCK_H=64,num_warps=8))
    to_out_h_t=s._buf(key,'to_out_h_t',(H,dim),f16,dev)
    run_stage('copy to_out_t', lambda: to_out_h_t.copy_(to_out_w.t()))
    out_h_flat=s._buf(key,'out_h',(B*H,N,N),f16,dev)
    run_stage('bmm trimul', lambda: torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat))
    out_h=out_h_flat.view(B,H,N,N); out=s._buf(key,'out',input_tensor.shape,f32,dev)
    if dim==128:
        run_stage('final ln gate out pre', lambda: s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,64),)](out_h,out_gate,out_norm_w.to(f32),out_norm_b.to(f32),to_out_h_t,out,rows=rows,n2=n2,H=H,D=dim,BLOCK_R=64,BLOCK_D=32,num_warps=4))
    else:
        run_stage('final ln gate out proj', lambda: s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,out_norm_w.to(f32),out_norm_b.to(f32),to_out_h_t,out,rows=rows,n2=n2,H=H,D=dim,BLOCK_R=128,BLOCK_D=64,num_warps=4))
    return times

for shape in [(2,256,128,128,True),(1,1024,128,128,True),(2,256,384,128,False),(1,768,384,128,False)]:
    data=make(*shape)
    # warm
    for _ in range(2): s.custom_kernel(data)
    torch.cuda.synchronize()
    times=profile_once(data)
    print('SHAPE',shape)
    for n,t in times: print(f'  {n:20s} {t:9.1f} us')
    print('  total staged',sum(t for _,t in times))
    del data; gc.collect(); torch.cuda.empty_cache()

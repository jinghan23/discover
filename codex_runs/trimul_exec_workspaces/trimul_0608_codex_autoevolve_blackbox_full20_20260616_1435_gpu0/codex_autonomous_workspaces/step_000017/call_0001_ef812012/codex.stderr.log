Postprocess settings are already near local best. I’m doing the same local sweep for the active `dim=128` fused projection; even a modest improvement there would matter for the large no-mask cases.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 D=H=128; rows=B*N*N; n2=N*N; dev='cuda'; key=(dev,B,N,D,H,'fprojvars')
 x=torch.randn(B,N,N,D,device=dev)*0.02; mask_arg=x
 nw=torch.ones(D,device=dev); nb=torch.zeros(D,device=dev)
 ws={k:s._buf(key,k,(H,D),torch.float16,dev).normal_(0,0.02) for k in ['wl','wr','wlg','wrg','wog']}
 lb=s._buf(key,'lb',(B*H,N,N),torch.float16,dev); rb=s._buf(key,'rb',(B*H,N,N),torch.float16,dev); og=s._buf(key,'og',(B,N,N,H),torch.float16,dev)
 def t(bm,bh,warps,iters=3 if N>=768 else 5):
  fn=lambda: s._fused_proj128_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,nw,nb,ws['wl'],ws['wr'],ws['wlg'],ws['wrg'],ws['wog'],lb,rb,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps,num_stages=1)
  for _ in range(2): fn()
  torch.cuda.synchronize(); a=torch.cuda.Event(True); e=torch.cuda.Event(True); a.record()
  for _ in range(iters): fn()
  e.record(); torch.cuda.synchronize(); print('N',N,'bm',bm,'bh',bh,'w',warps,'us',a.elapsed_time(e)*1000/iters)
 for bm in [16,32,64,128]:
  for bh in [16,32,64]:
   for w in [4,8]:
    try: t(bm,bh,w)
    except Exception as exc: print('ERR',N,bm,bh,w,str(exc).split('\\n')[0])

 (1,1024,128,128,True),
 (2,256,384,128,False),
 (1,768,384,128,False),
 (1,1024,384,128,True),
]

def make(B,N,D,H,nomask):
    device='cuda'
    x=torch.randn(B,N,N,D,device=device,dtype=torch.float32)
    mask=None if nomask else (torch.rand(B,N,N,device=device)>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device=device,dtype=torch.float32),
      'norm.bias': torch.randn(D,device=device,dtype=torch.float32),
      'left_proj.weight': torch.randn(H,D,device=device,dtype=torch.float32),
      'right_proj.weight': torch.randn(H,D,device=device,dtype=torch.float32),
      'left_gate.weight': torch.randn(H,D,device=device,dtype=torch.float32),
      'right_gate.weight': torch.randn(H,D,device=device,dtype=torch.float32),
      'out_gate.weight': torch.randn(H,D,device=device,dtype=torch.float32),
      'to_out_norm.weight': torch.randn(H,device=device,dtype=torch.float32),
      'to_out_norm.bias': torch.randn(H,device=device,dtype=torch.float32),
      'to_out.weight': torch.randn(D,H,device=device,dtype=torch.float32),
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

for shape in shapes:
    B,N,D,H,nomask=shape
    data=make(B,N,D,H,nomask)
    # reset caches? no, mimic same shape repeated after first
    for _ in range(3):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    iters=10 if N<=512 else 5
    start=torch.cuda.Event(True); end=torch.cuda.Event(True)
    start.record()
    for _ in range(iters):
        y=submission.custom_kernel(data)
    end.record(); torch.cuda.synchronize()
    print(shape, start.elapsed_time(end)/iters*1000, 'us', y.shape, y.dtype, float(y.flatten()[0]))
    del data,y; gc.collect(); torch.cuda.empty_cache()

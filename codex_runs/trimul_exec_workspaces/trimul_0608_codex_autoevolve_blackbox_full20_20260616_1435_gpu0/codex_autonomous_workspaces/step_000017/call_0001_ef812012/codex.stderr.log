For `dim=384`, there is an unused all-in-one projection kernel. It avoids the huge `proj` intermediate and postprocess kernel but does more small Triton matmuls, so I’m timing it locally before changing the main path.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s, gc

def bench(N,B=1,D=384,H=128,nomask=False):
 dev='cuda'; rows=B*N*N; n2=N*N; key=(dev,B,N,D,H,'fused384')
 x=torch.randn(B,N,N,D,device=dev)*0.02; mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.15).float(); mask_arg=x if mask is None else mask
 nw=torch.ones(D,device=dev); nb=torch.zeros(D,device=dev)
 ws={name: torch.randn(H,D,device=dev)*0.02 for name in ['wl','wr','wlg','wrg','wog']}
 left=s._buf(key,'lb',(B*H,N,N),torch.float16,dev); right=s._buf(key,'rb',(B*H,N,N),torch.float16,dev); og=s._buf(key,'og',(B,N,N,H),torch.float16,dev)
 wbuf={k:s._buf(key,k,(H,D),torch.float16,dev) for k in ws}
 for k in ws: wbuf[k].copy_(ws[k])
 def run(bm,bh,warps,iters=3):
  fn=lambda: s._fused_proj384_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,nw,nb,wbuf['wl'],wbuf['wr'],wbuf['wlg'],wbuf['wrg'],wbuf['wog'],left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps,num_stages=1)
  for _ in range(2): fn()
  torch.cuda.synchronize(); a=torch.cuda.Event(True); e=torch.cuda.Event(True); a.record()
  for _ in range(iters): fn()
  e.record(); torch.cuda.synchronize(); print('N',N,'bm',bm,'bh',bh,'w',warps,'us',a.elapsed_time(e)*1000/iters)
 for bm,bh,w in [(8,32,4),(16,32,4),(16,64,4),(32,32,4),(32,64,4),(64,32,4)]:
  try: run(bm,bh,w,2 if N>=768 else 5)
  except Exception as e: print('ERR',N,bm,bh,w,str(e).split('\\n')[0])
 del x,mask; gc.collect(); torch.cuda.empty_cache()
for N,B,nomask in [(256,2,False),(768,1,False)]: bench(N,B,384,128,nomask)

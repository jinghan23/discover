 device='cuda'; x=(torch.empty((bs,seqlen,seqlen,dim),device=device).cauchy_()*2 if distribution=='cauchy' else torch.randn((bs,seqlen,seqlen,dim),device=device)); mask=None if nomask else (torch.rand((bs,seqlen,seqlen),device=device)>0.2).float(); w={'norm.weight':torch.randn(dim,device=device),'norm.bias':torch.randn(dim,device=device),'left_proj.weight':torch.randn(hidden_dim,dim,device=device),'right_proj.weight':torch.randn(hidden_dim,dim,device=device),'left_gate.weight':torch.randn(hidden_dim,dim,device=device),'right_gate.weight':torch.randn(hidden_dim,dim,device=device),'out_gate.weight':torch.randn(hidden_dim,dim,device=device),'to_out_norm.weight':torch.randn(hidden_dim,device=device),'to_out_norm.bias':torch.randn(hidden_dim,device=device),'to_out.weight':torch.randn(dim,hidden_dim,device=device)}; return (x,mask,w,{'dim':dim,'hidden_dim':hidden_dim,'nomask':nomask})
def bench(c,iters=5):
 data=mk(**c)

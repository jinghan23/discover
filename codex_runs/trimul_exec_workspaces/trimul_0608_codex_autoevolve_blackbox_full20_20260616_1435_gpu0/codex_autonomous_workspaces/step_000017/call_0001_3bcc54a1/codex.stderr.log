 @triton.jit
+def _fused_proj128_nomask_4q_kernel(
+    x_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    wl_ptr,
+    wr_ptr,
+    wlg_ptr,
+    wrg_ptr,

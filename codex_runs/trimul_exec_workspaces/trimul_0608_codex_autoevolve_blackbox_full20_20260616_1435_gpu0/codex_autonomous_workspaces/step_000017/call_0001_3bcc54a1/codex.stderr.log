        'right_proj.weight': torch.randn((hidden_dim,dim),device=device,dtype=torch.float32),
        'left_gate.weight': torch.randn((hidden_dim,dim),device=device,dtype=torch.float32),
        'right_gate.weight': torch.randn((hidden_dim,dim),device=device,dtype=torch.float32),
        'out_gate.weight': torch.randn((hidden_dim,dim),device=device,dtype=torch.float32),
        'to_out_norm.weight': torch.randn((hidden_dim,),device=device,dtype=torch.float32),
        'to_out_norm.bias': torch.randn((hidden_dim,),device=device,dtype=torch.float32),
        'to_out.weight': torch.randn((dim,hidden_dim),device=device,dtype=torch.float32),
    }
    cfg={'seqlen':seqlen,'bs':bs,'dim':dim,'hidden_dim':hidden_dim,'nomask':nomask,'distribution':distribution}
    return (x,mask,weights,cfg)

def bench(case, warm=5, iters=20):
    data=make_case(**case)
    # clear maybe first compile

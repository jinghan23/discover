/bin/bash -lc "python - <<'PY'
import torch
for N in [256,512,768,1024]:
 H=128; device='cuda'
 a=torch.randn((H,N,N),device=device,dtype=torch.float16)
 b=torch.randn((H,N,N),device=device,dtype=torch.float16)
 out_cont=torch.empty((H,N,N),device=device,dtype=torch.float16)
 out_nhwc=torch.empty((N,N,H),device=device,dtype=torch.float16)
 out_str=torch.as_strided(out_nhwc,(H,N,N),(1,N*H,H))
 # warm
 for _ in range(3): torch.bmm(a,b.transpose(1,2),out=out_cont)
 torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); ts=[]
 for _ in range(5): st.record(); torch.bmm(a,b.transpose(1,2),out=out_cont); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 cavg=sum(ts)/len(ts)
 ok=True
 try:
  for _ in range(3): torch.bmm(a,b.transpose(1,2),out=out_str)
  torch.cuda.synchronize(); ts=[]
  for _ in range(5): st.record(); torch.bmm(a,b.transpose(1,2),out=out_str); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
  savg=sum(ts)/len(ts)

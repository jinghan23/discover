import torch, submission

def mk(seqlen,bs,dim,hidden_dim,nomask):
 device='cuda'; x=torch.randn((bs,seqlen,seqlen,dim),device=device); mask=None if nomask else (torch.rand((bs,seqlen,seqlen),device=device)>0.2).float(); w={'norm.weight':torch.randn(dim,device=device),'norm.bias':torch.randn(dim,device=device),'left_proj.weight':torch.randn(hidden_dim,dim,device=device),'right_proj.weight':torch.randn(hidden_dim,dim,device=device),'left_gate.weight':torch.randn(hidden_dim,dim,device=device),'right_gate.weight':torch.randn(hidden_dim,dim,device=device),'out_gate.weight':torch.randn(hidden_dim,dim,device=device),'to_out_norm.weight':torch.randn(hidden_dim,device=device),'to_out_norm.bias':torch.randn(hidden_dim,device=device),'to_out.weight':torch.randn(dim,hidden_dim,device=device)}; return (x,mask,w,{'dim':dim,'hidden_dim':hidden_dim,'nomask':nomask})
def bench(c,iters=5):
 data=mk(**c)
 for _ in range(3): submission.custom_kernel(data)
 torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); ts=[]
 for _ in range(iters): st.record(); submission.custom_kernel(data); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return sum(ts)/len(ts), min(ts)
for c in [{'seqlen':256,'bs':2,'dim':384,'hidden_dim':128,'nomask':False}, {'seqlen':768,'bs':1,'dim':384,'hidden_dim':128,'nomask':False}, {'seqlen':1024,'bs':1,'dim':384,'hidden_dim':128,'nomask':True}]: print(c, bench(c))

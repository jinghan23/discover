+def _graph_key(input_tensor, mask, weights, config):
+    dim = int(config["dim"])
+    hidden_dim = int(config["hidden_dim"])
+    mask_ptr = 0 if mask is None else mask.data_ptr()
+    return (
+        input_tensor.device.index,
+        input_tensor.data_ptr(),
+        mask_ptr,
+        input_tensor.shape[0],
+        input_tensor.shape[1],
+        dim,
+        hidden_dim,
+        bool(config.get("nomask", False)) or mask is None,
+        weights["norm.weight"].data_ptr(),
+        weights["norm.bias"].data_ptr(),
+        weights["left_proj.weight"].data_ptr(),
+        weights["right_proj.weight"].data_ptr(),
+        weights["left_gate.weight"].data_ptr(),
+        weights["right_gate.weight"].data_ptr(),
+        weights["out_gate.weight"].data_ptr(),
+        weights["to_out_norm.weight"].data_ptr(),
+        weights["to_out_norm.bias"].data_ptr(),
+        weights["to_out.weight"].data_ptr(),
+    )
+
+
+def custom_kernel(data):
+    input_tensor, mask, weights, config = data
+    if not input_tensor.is_cuda:
+        return _custom_kernel_impl(data)
+    key = _graph_key(input_tensor, mask, weights, config)
+    cached = _GRAPH_CACHE.get(key)
+    if cached is not None:
+        graph, out, keepalive = cached
+        graph.replay()
+        return out
+
+    warm = _GRAPH_WARM.get(key, 0)
+    if warm == 0:
+        _GRAPH_WARM[key] = 1
+        return _custom_kernel_impl(data)
+
+    try:
+        torch.cuda.synchronize(input_tensor.device)
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            out = _custom_kernel_impl(data)
+        keepalive = tuple(_BUF_CACHE.values())
+        _GRAPH_CACHE[key] = (graph, out, keepalive)
+        return out
+    except Exception:
+        _GRAPH_WARM[key] = 0
+        return _custom_kernel_impl(data)


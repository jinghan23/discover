import torch, submission

def mk(seqlen,bs,dim,hidden_dim,distribution):
 device='cuda'; x=(torch.empty((bs,seqlen,seqlen,dim),device=device).cauchy_()*2 if distribution=='cauchy' else torch.randn((bs,seqlen,seqlen,dim),device=device)); w={'norm.weight':torch.randn(dim,device=device),'norm.bias':torch.randn(dim,device=device),'left_proj.weight':torch.randn(hidden_dim,dim,device=device),'right_proj.weight':torch.randn(hidden_dim,dim,device=device),'left_gate.weight':torch.randn(hidden_dim,dim,device=device),'right_gate.weight':torch.randn(hidden_dim,dim,device=device),'out_gate.weight':torch.randn(hidden_dim,dim,device=device),'to_out_norm.weight':torch.randn(hidden_dim,device=device),'to_out_norm.bias':torch.randn(hidden_dim,device=device),'to_out.weight':torch.randn(dim,hidden_dim,device=device)}; return (x,None,w,{'dim':dim,'hidden_dim':hidden_dim,'nomask':True})
def bench(c,iters=6):
 data=mk(**c)
 for _ in range(3): submission.custom_kernel(data)
 torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); ts=[]
 for _ in range(iters): st.record(); submission.custom_kernel(data); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return sum(ts)/len(ts), min(ts)

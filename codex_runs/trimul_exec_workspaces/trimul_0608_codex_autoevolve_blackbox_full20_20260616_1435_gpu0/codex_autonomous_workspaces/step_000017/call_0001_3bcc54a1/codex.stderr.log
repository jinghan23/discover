 @triton.jit
+def _fused_proj128_nomask_4q_kernel(
+    x_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    wl_ptr,
+    wr_ptr,
+    wlg_ptr,
+    wrg_ptr,
+    wog_ptr,
+    left_ptr,
+    right_ptr,
+    out_gate_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)

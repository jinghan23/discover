/bin/bash -lc "python - <<'PY'
import torch
import submission

def timeit(fn,iters=12):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); y=fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
  H=128
  left=torch.randn((B*H,N,N),device='cuda',dtype=torch.float16)
  right=torch.randn((B*H,N,N),device='cuda',dtype=torch.float16)
  rt=right.transpose(1,2)
  out=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16)
  print('\\nbmm',B,N)
  print('bmm out_dtype f16',timeit(lambda:torch.bmm(left,rt,out_dtype=torch.float16),5))
  print('bmm no out_dtype',timeit(lambda:torch.bmm(left,rt),5))
  print('matmul',timeit(lambda:torch.matmul(left,rt),5))
  try:
    print('bmm out=',timeit(lambda:torch.bmm(left,rt,out=out),5))
  except Exception as e: print('out err',e)
  try:
    print('baddbmm beta0',timeit(lambda:torch.baddbmm(out,left,rt,beta=0,alpha=1),5))
  except Exception as e: print('badd err',e)

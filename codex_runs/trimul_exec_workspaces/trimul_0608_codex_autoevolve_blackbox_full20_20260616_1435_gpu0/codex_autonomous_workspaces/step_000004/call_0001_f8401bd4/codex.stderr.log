codex
For the 384 projection, `F.linear` allocates a very large temporary. I’m testing a preallocated `torch.mm(..., out=proj_buf)` version; if cuBLAS performance is similar, avoiding allocator churn may help the blackbox score.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
import submission

def timeit(fn,iters=10):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); y=fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B,D,H in [(256,2,384,128),(768,1,384,128),(1024,1,384,128),(256,2,128,128),(512,1,128,128),(1024,1,128,128)]:
  rows=B*N*N
  x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float16)
  w=torch.randn((5*H,D),device='cuda',dtype=torch.float16)
  proj=torch.empty((B,N,N,5*H),device='cuda',dtype=torch.float16)
  print('\\nproj',B,N,D)
  print('F.linear',timeit(lambda:F.linear(x,w),5))
  print('mm out w.t view',timeit(lambda:torch.mm(x.reshape(rows,D), w.t(), out=proj.reshape(rows,5*H)),5))
  wt=w.t().contiguous()
  print('mm out wt contig',timeit(lambda:torch.mm(x.reshape(rows,D), wt, out=proj.reshape(rows,5*H)),5))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

codex
Since the large fused 384 trial lost, I’m checking smaller PyTorch-call choices: whether flattening the final projection manually or using different output APIs changes cuBLAS selection. These are easy to test and can matter at this scale.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F

def timeit(fn,iters=10):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); y=fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B,D in [(256,2,128),(512,1,128),(768,1,128),(1024,1,128),(256,2,384),(768,1,384),(1024,1,384)]:
  H=128; rows=B*N*N
  g=torch.randn((B,N,N,H),device='cuda')
  w=torch.randn((D,H),device='cuda')
  wt=w.t().contiguous()
  out=torch.empty((B,N,N,D),device='cuda')
  out2d=out.reshape(rows,D)
  print('\\noutproj',B,N,D)
  print('F.linear 4d',timeit(lambda:F.linear(g,w),5))
  print('matmul flatten @ w.t view',timeit(lambda:g.reshape(rows,H).matmul(w.t()),5))
  print('matmul flatten @ wt contig',timeit(lambda:g.reshape(rows,H).matmul(wt),5))
  try:
    print('mm out',timeit(lambda:torch.mm(g.reshape(rows,H), w.t(), out=out2d),5))
  except Exception as e: print('mm out err',e)

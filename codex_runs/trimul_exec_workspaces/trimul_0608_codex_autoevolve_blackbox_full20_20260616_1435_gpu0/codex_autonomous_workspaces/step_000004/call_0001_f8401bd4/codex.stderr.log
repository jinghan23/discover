     tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
     tl.store(out_gate_ptr + nh, tl.sigmoid(og), mask=valid)
 
+
+@triton.jit
+def _final128_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    out_w_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    valid_r = offs_r < rows
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(w_ptr + offs_h).to(tl.float32)
+    nb = tl.load(b_ptr + offs_h).to(tl.float32)
+    g = tl.load(gate_ptr + offs_r[:, None] * 128 + offs_h[None, :], mask=valid_r[:, None], other=0.0).to(tl.float32)
+    z = (xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g
+    ow = tl.load(out_w_ptr + offs_h[:, None] + offs_h[None, :] * 128).to(tl.float32)
+    y = tl.dot(z, ow, input_precision="tf32")
+    tl.store(y_ptr + offs_r[:, None] * 128 + offs_h[None, :], y, mask=valid_r[:, None])
+

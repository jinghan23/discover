/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def timeit(fn,iters=8):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
    H=128; rows=B*N*N; n2=N*N
    proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16)
    mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    print('\\npost rows',rows,'nomask',nomask)
    for BR in [8,16,32,64]:
      for BH in [32,64,128]:
        for nw in [1,2,4,8]:
          if BH==128 and BR>=32 and nw<4: continue
          try:
            t=timeit(lambda BR=BR,BH=BH,nw=nw: s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=nw),5)
            print('BR',BR,'BH',BH,'warps',nw,t)
          except Exception as e:
            print('err',BR,BH,nw,type(e).__name__,str(e)[:80])

import torch, triton
import torch.nn.functional as F
import submission as s

torch.backends.cuda.matmul.allow_tf32=True
torch.set_float32_matmul_precision('medium')

def timeit(fn, iters=10):
    for _ in range(3): fn()
    torch.cuda.synchronize()
    times=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True)
        a.record(); fn(); b.record(); b.synchronize()
        times.append(a.elapsed_time(b)*1000)
    return min(times), sorted(times)[len(times)//2]

def make(B,N,D,H,nomask):
    x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float32)
    mask=torch.ones((B,N,N),device='cuda',dtype=torch.float32) if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'), 'out_gate.weight': torch.randn(H,D,device='cuda'),
      'to_out_norm.weight': torch.randn(H,device='cuda'), 'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return x,mask,weights

def profile(B,N,D,H,nomask):
    print('\\nshape',B,N,D,H,nomask)
    x_in,mask,w=make(B,N,D,H,nomask)
    rows=B*N*N; n2=N*N; device=x_in.device
    f16=torch.float16; f32=torch.float32
    key=(device,B,N,D,H,'prof')
    left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device)
    out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device)
    mask_arg=x_in if nomask else mask
    if D==128:
        parts=s._proj_parts(w,f16,D,H)
        def stage1():
            s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),*parts,left,right,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4)
    else:
        x=s._buf(key,'x_norm',x_in.shape,f16,device)
        proj_w=s._proj_weight(w,f16,D,H)
        proj=s._buf(key,'proj',(B,N,N,5*H),f16,device)
        def ln():
            s._input_ln384_kernel[(rows,)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=rows,BLOCK_R=1,num_warps=1)
        def lin():
            return F.linear(x,proj_w)
        # separate post needs actual proj tensor from lin assigned? use closure nonlocal
        tmp=[None]
        def post():
            if tmp[0] is None: tmp[0]=F.linear(x,proj_w)
            s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](tmp[0],mask_arg,left,right,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
        print('ln', timeit(ln,5)); ln(); torch.cuda.synchronize()
        print('linear5', timeit(lambda: F.linear(x,proj_w),5)); tmp[0]=F.linear(x,proj_w); torch.cuda.synchronize()
        print('post', timeit(post,5))
        def stage1():
            s._input_ln384_kernel[(rows,)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=rows,BLOCK_R=1,num_warps=1)
            p=F.linear(x,proj_w)
            s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](p,mask_arg,left,right,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
    print('stage1all', timeit(stage1,5))
    stage1(); torch.cuda.synchronize()
    oh=[None]
    def bmm():
        oh[0]=torch.bmm(left,right.transpose(1,2),out_dtype=f16).view(B,H,N,N)
    print('bmm', timeit(bmm,5)); bmm(); torch.cuda.synchronize()
    gated=s._buf(key,'gated',(B,N,N,H),f32,device)
    def lngate():

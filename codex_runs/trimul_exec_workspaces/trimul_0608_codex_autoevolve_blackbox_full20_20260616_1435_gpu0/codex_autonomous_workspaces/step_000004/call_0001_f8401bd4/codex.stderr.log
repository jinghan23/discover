    print('lngate', timeit(lngate,5)); lngate(); torch.cuda.synchronize()
    tow=w['to_out.weight'].to(f32)
    def outlin():
        return F.linear(gated,tow)
    print('outlin', timeit(outlin,5))
    print('total', timeit(lambda: s.custom_kernel((x_in,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})),5))

for args in [(1,1024,384,128,True),(1,768,384,128,False),(1,1024,128,128,True),(2,256,384,128,False)]:

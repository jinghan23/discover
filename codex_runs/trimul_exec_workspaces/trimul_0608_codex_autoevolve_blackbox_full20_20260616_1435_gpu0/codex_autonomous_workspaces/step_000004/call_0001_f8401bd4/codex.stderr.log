/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
import submission as s

def timeit(fn,iters=10):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B in [(256,2),(768,1),(1024,1)]:
  D=384; H=128; rows=B*N*N
  x=torch.randn((B,N,N,D),device='cuda')
  w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda')
  y=torch.empty_like(x,dtype=torch.float16)
  print('\\nLN compare',B,N,D)

codex
A possible way around the expensive post-transpose is to ask cuBLAS to write projections directly into the hidden-major buffers via strided `out=` views. I’m testing whether PyTorch permits that and whether the loss of a single large 640-wide GEMM is offset by removing the transpose/post kernel.
exec
/bin/bash -lc "python - <<'PY'
import torch, time
import torch.nn.functional as F

def timeit(fn,iters=10):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B in [(256,2),(768,1),(1024,1)]:
  D=384; H=128; rows=B*N*N
  x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float16)
  ws=[torch.randn((H,D),device='cuda',dtype=torch.float16) for _ in range(5)]
  wc=torch.cat(ws,dim=0).contiguous()
  left_b=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16)
  print('\\nshape',B,N)
  print('cat linear contiguous', timeit(lambda:F.linear(x,wc),5))
  # direct one projection per batch
  def direct_one():
    for b in range(B):
      xv=x[b].reshape(N*N,D)
      out=torch.as_strided(left_b, (N*N,H), (1,N*N), storage_offset=b*H*N*N)
      torch.mm(xv, ws[0].t(), out=out)
  try:
    direct_one(); torch.cuda.synchronize()
    print('direct one', timeit(direct_one,5))
  except Exception as e:
    print('direct one error', type(e).__name__, e)
  # five direct projections into separate buffers
  bufs=[torch.empty((B*H,N,N),device='cuda',dtype=torch.float16) for _ in range(5)]
  def direct5():
    for bi in range(B):
      xv=x[bi].reshape(N*N,D)
      for wi in range(5):
        out=torch.as_strided(bufs[wi], (N*N,H), (1,N*N), storage_offset=bi*H*N*N)
        torch.mm(xv, ws[wi].t(), out=out)
  try:
    direct5(); torch.cuda.synchronize(); print('direct5', timeit(direct5,3))
  except Exception as e: print('direct5 error', type(e).__name__, e)

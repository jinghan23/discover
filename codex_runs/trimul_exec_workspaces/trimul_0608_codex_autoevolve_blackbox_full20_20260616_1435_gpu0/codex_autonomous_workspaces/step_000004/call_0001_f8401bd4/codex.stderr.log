/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def timeit(fn,iters=8):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

for N,B in [(768,1),(1024,1)]:
  D=128; H=128; rows=B*N*N; n2=N*N
  x=torch.randn((B,N,N,D),device='cuda')
  mask=torch.ones((B,N,N),device='cuda')
  weights={
      'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda')}
  parts=tuple(weights[k].half().contiguous() for k in ['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight'])
  left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
  print('\\nN',N)
  for BM,BH,nw in [(64,32,4),(128,32,8),(128,64,8),(64,64,4),(32,64,4)]:
    t=timeit(lambda BM=BM,BH=BH,nw=nw: s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask,weights['norm.weight'].float(),weights['norm.bias'].float(),*parts,left,right,gate,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw),5)
    print(BM,BH,nw,t)

codex
The correctness tolerance requires exact sigmoid. I’m checking PyTorch’s float32 matmul precision setting next; it only affects the final TF32 output projection and can change cuBLASLt algorithm choice.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F

def timeit(fn,iters=8):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

torch.backends.cuda.matmul.allow_tf32=True
for prec in ['highest','high','medium']:
  torch.set_float32_matmul_precision(prec)
  print('\\nprecision',prec)
  for N,B,D in [(1024,1,128),(1024,1,384),(768,1,384),(256,2,384)]:
    H=128; g=torch.randn((B,N,N,H),device='cuda'); w=torch.randn((D,H),device='cuda')
    print(B,N,D,timeit(lambda:F.linear(g,w),5))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

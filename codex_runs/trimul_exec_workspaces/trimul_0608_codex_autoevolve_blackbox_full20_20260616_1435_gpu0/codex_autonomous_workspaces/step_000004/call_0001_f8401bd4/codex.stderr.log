codex
The fused 384 kernel is defined but not yet used by `custom_kernel`. I’m benchmarking it directly against the current `LN + F.linear + post` stage on the three 384 shapes.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
import submission as s

def timeit(fn,iters=5):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(iters):
        a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def bench(B,N,nomask):
  D=384; H=128; rows=B*N*N; n2=N*N
  x=torch.randn((B,N,N,D),device='cuda')
  mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
  weights={
    'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),
    'left_proj.weight':torch.randn(H,D,device='cuda'),'right_proj.weight':torch.randn(H,D,device='cuda'),
    'left_gate.weight':torch.randn(H,D,device='cuda'),'right_gate.weight':torch.randn(H,D,device='cuda'),'out_gate.weight':torch.randn(H,D,device='cuda')}
  parts=tuple(weights[k].half().contiguous() for k in ['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight'])
  proj_w=torch.cat(parts,0).contiguous()
  xnorm=torch.empty_like(x,dtype=torch.float16)
  left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
  print('\\nshape',B,N,'nomask',nomask)
  def current():
    s._input_ln384_kernel[(rows,)](x,weights['norm.weight'],weights['norm.bias'],xnorm,rows=rows,BLOCK_R=1,num_warps=1)
    p=F.linear(xnorm,proj_w)
    s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](p,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
  print('current',timeit(current,3))
  for BM,BH,nw in [(16,32,4),(16,64,4),(32,32,4),(32,64,4),(32,32,8),(64,32,4),(64,32,8)]:
    try:
      t=timeit(lambda BM=BM,BH=BH,nw=nw: s._fused_proj384_kernel[(triton.cdiv(rows,BM),)](x,mask,weights['norm.weight'],weights['norm.bias'],*parts,left,right,gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw),3)
      print('fused',BM,BH,nw,t)
    except Exception as e:
      print('err',BM,BH,nw,type(e).__name__,str(e)[:120])

bench(2,256,False)
bench(1,768,False)
bench(1,1024,True)
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

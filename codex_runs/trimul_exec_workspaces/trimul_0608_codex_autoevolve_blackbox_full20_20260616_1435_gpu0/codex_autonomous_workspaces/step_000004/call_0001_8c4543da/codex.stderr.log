import importlib.util, torch, triton
import torch.nn.functional as F
import submission as s
# Load baseline under a different module name
spec=importlib.util.spec_from_file_location('base','/opt/tiger/discover-gpu-kernel-experiments/workspace/submission_baseline.py')
base=importlib.util.module_from_spec(spec); spec.loader.exec_module(base)

def make(N=64,B=1,D=128,H=128,nomask=True):
    x=torch.randn((B,N,N,D),device='cuda')
    mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
    weights={
        'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
        'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
        'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
        'out_gate.weight':torch.randn(H,D,device='cuda'),
        'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
        'to_out.weight':torch.randn(D,H,device='cuda'),
    }
    return x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask}
for D in [128,384]:
  data=make(64,1,D,128,True)
  y0=base.custom_kernel(data); torch.cuda.synchronize()
  y1=s.custom_kernel(data); torch.cuda.synchronize()
  diff=(y0-y1).abs(); rel=diff/(y0.abs()+1e-3)
  print('D',D,'max',diff.max().item(),'mean',diff.mean().item(),'relmax',rel.max().item(),'relmean',rel.mean().item(), 'y0 std', y0.std().item())
  idx=diff.argmax().item(); print(y0.flatten()[idx].item(), y1.flatten()[idx].item())

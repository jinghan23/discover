/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def bench(B,N,D,BR,reps=10):
    x=torch.randn((B,N,N,D),device='cuda')
    w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda')
    y=torch.empty_like(x, dtype=torch.float16)
    rows=x.numel()//D
    # compile warm
    s._input_ln384_kernel[(triton.cdiv(rows,BR),)](x,w,b,y,rows=rows,BLOCK_R=BR,num_warps=1)
    torch.cuda.synchronize()
    times=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); s._input_ln384_kernel[(triton.cdiv(rows,BR),)](x,w,b,y,rows=rows,BLOCK_R=BR,num_warps=1); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    return min(times), sum(times)/len(times)
for N in [256,768,1024]:
  print('N',N)
  for BR in [1,2,4,8]:
    try:
      mn,avg=bench(1 if N"'!=256 else 2,N,384,BR,5)
      print('"' BR',BR,'min',round(mn,2),'avg',round(avg,2))
    except Exception as e:
      print(' BR',BR,'ERR',e)

codex
The BMM output is H-major, which makes the following LayerNorm gather strided values. I’m checking whether PyTorch’s contraction path can produce NH-last directly fast enough to be useful.
exec
/bin/bash -lc "python - <<'PY'
import torch

def bench(B,N,H,reps=8):
  left=torch.randn((B*H,N,N),device='cuda',dtype=torch.float16)
  right=torch.randn_like(left)
  # warm
  y=torch.bmm(left,right.transpose(1,2),out_dtype=torch.float16)
  y2=torch.einsum('bhik,bhjk->bijh', left.view(B,H,N,N), right.view(B,H,N,N))
  torch.cuda.synchronize(); tb=[]; te=[]
  for _ in range(reps):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=torch.bmm(left,right.transpose(1,2),out_dtype=torch.float16); en.record(); en.synchronize(); tb.append(st.elapsed_time(en)*1000)
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y2=torch.einsum('bhik,bhjk->bijh', left.view(B,H,N,N), right.view(B,H,N,N)); en.record(); en.synchronize(); te.append(st.elapsed_time(en)*1000)
  print('case',B,N,'bmm',round(min(tb),1),round(sum(tb)/len(tb),1),'einsum',round(min(te),1),round(sum(te)/len(te),1),y2.shape,y2.dtype)
for B,N in [(2,256),(1,512),(1,768),(1,1024)]: bench(B,N,128,4)
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

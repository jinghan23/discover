/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F

def bench(B,N,D,H=128,reps=8):
  x=torch.randn((B,N,N,H),device='cuda')
  w=torch.randn((D,H),device='cuda')
  y=F.linear(x,w); y2=torch.mm(x.view(-1,H),w.t()).view(B,N,N,D); torch.cuda.synchronize()
  tf=[]; tm=[]
  for _ in range(reps):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=F.linear(x,w); en.record(); en.synchronize(); tf.append(st.elapsed_time(en)*1000)
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y2=torch.mm(x.view(-1,H),w.t()).view(B,N,N,D); en.record(); en.synchronize(); tm.append(st.elapsed_time(en)*1000)
  print('case',B,N,D,'F',round(min(tf),1),round(sum(tf)/len(tf),1),'mm',round(min(tm),1),round(sum(tm)/len(tm),1))
for B,N,D in [(2,256,128),(1,512,128),(1,768,128),(1,1024,128),(2,256,384),(1,768,384),(1,1024,384)]: bench(B,N,D,128,4)

codex
The fused 128 projection tile is already near the local optimum. I’m testing whether the 384 projection is faster as an explicit flattened `torch.mm` instead of `F.linear` on the 4D tensor.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
import submission as s

def bench(B,N,D=384,H=128,reps=10):
  x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float16)
  w=torch.randn((5*H,D),device='cuda',dtype=torch.float16)
  # warm
  y=F.linear(x,w); y2=torch.mm(x.view(-1,D),w.t()); torch.cuda.synchronize()
  timesF=[]; timesM=[]
  for _ in range(reps):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=F.linear(x,w); en.record(); en.synchronize(); timesF.append(st.elapsed_time(en)*1000)
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y2=torch.mm(x.view(-1,D),w.t()); en.record(); en.synchronize(); timesM.append(st.elapsed_time(en)*1000)
  print('case',B,N,'F min avg',round(min(timesF),1),round(sum(timesF)/len(timesF),1),'mm',round(min(timesM),1),round(sum(timesM)/len(timesM),1), y.shape, y2.shape)
for B,N in [(2,256),(1,768),(1,1024)]: bench(B,N,384,128,5)
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

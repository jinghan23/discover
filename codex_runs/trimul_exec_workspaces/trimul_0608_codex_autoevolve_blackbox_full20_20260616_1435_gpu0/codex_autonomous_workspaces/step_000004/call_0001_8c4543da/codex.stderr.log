import torch, triton
import submission as s

def bench(B,N,warps,reps=6):
 D=384; rows=B*N*N; x=torch.randn((B,N,N,D),device='cuda'); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda'); y=torch.empty((B,N,N,D),device='cuda',dtype=torch.float16)
 s._input_ln384_kernel[(rows,)](x,w,b,y,rows=rows,BLOCK_R=1,num_warps=warps)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); s._input_ln384_kernel[(rows,)](x,w,b,y,rows=rows,BLOCK_R=1,num_warps=warps); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return min(times),sum(times)/len(times)
for N,B in [(256,2),(768,1),(1024,1)]:
 print('case',N,B)
 for w in [1,2,4,8]:
  try:
   mn,avg=bench(B,N,w,4); print(w,round(mn,1),round(avg,1))
  except Exception as e: print('err',w,e)

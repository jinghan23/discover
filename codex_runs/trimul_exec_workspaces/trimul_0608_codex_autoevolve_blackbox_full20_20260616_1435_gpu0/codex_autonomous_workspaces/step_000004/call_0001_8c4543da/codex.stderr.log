/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def bench(B,N,warps,reps=6):
 D=H=128; rows=B*N*N; n2=N*N; BM=64; BH=32
 x=torch.randn((B,N,N,D),device='cuda')
 weights=[torch.randn((H,D),device='cuda',dtype=torch.float16) for _ in range(5)]
 nw=torch.randn(D,device='cuda'); nb=torch.randn(D,device='cuda')
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); outg=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,nw,nb,*weights,left,right,outg,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,nw,nb,*weights,left,right,outg,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return min(times),sum(times)/len(times)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 print('case',N,B)
 for w in [1,2,4,8]:
  try:
   mn,avg=bench(B,N,w,4); print(w,round(mn,1),round(avg,1))
  except Exception as e: print('err',w,e)

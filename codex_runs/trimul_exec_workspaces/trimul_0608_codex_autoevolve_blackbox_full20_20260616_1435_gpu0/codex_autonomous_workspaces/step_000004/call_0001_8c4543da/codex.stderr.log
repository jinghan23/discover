/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def bench(B,N,H,BR,BH=128,reps=10):
  rows=B*N*N; n2=N*N
  x=torch.randn((B,H,N,N),device='cuda',dtype=torch.float16)
  gate=torch.rand((B,N,N,H),device='cuda',dtype=torch.float16)
  w=torch.randn(H,device='cuda'); b=torch.randn(H,device='cuda')
  y=torch.empty((B,N,N,H),device='cuda')
  s._ln_gate_tile_kernel[(triton.cdiv(rows,BR),)](x,gate,w,b,y,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=4)
  torch.cuda.synchronize(); times=[]
  for _ in range(reps):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record();
    s._ln_gate_tile_kernel[(triton.cdiv(rows,BR),)](x,gate,w,b,y,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=4)
    en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
  return min(times),sum(times)/len(times)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 print('case',N,B)
 for BR in [8,16,32,64,128]:
  try:
    mn,avg=bench(B,N,128,BR,128,5); print(' BR',BR,'min',round(mn,1),'avg',round(avg,1))
  except Exception as e: print('err',BR,e)

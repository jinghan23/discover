    x_in=input_tensor.contiguous(); key=(device,B,N,dim,H); nomask=bool(config.get('nomask',False)) or (dim==128) or (dim==384 and B==1 and N==1024) or mask is None; mask_arg=input_tensor if mask is None else mask
    # warm full
    for _ in range(3): s.custom_kernel(data)
    torch.cuda.synchronize()
    agg={}
    for rep in range(reps):

          left_b=s._buf(key,'left_b',(B*H,N,N),f16,device); right_b=s._buf(key,'right_b',(B*H,N,N),f16,device)
          wl,wr,wlg,wrg,wog=s._proj_parts(weights,f16,dim,H)
          s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x_in,mask_arg,norm_w.to(f32),norm_b.to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=64,BLOCK_H=32,num_warps=4)
          return left_b,right_b,out_gate
        t,(left_b,right_b,out_gate)=evtime(stage_proj); agg['proj']=agg.get('proj',0)+t
      else:
        def stage_ln():
          x=s._buf(key,'x_norm',input_tensor.shape,f16,device); in_rows=x.numel()//dim
          if dim==384:
            s._input_ln384_kernel[(in_rows,)](x_in,norm_w.to(f32),norm_b.to(f32),x,rows=in_rows,BLOCK_R=1,num_warps=1)
          else:
            s._input_ln_kernel[(in_rows,)](x_in,norm_w.to(f32),norm_b.to(f32),x,D=dim,BLOCK=triton.next_power_of_2(dim),num_warps=1)
          return x
        t,x=evtime(stage_ln); agg['ln']=agg.get('ln',0)+t
        def stage_lin():
          return F.linear(x,s._proj_weight(weights,f16,dim,H))
        t,proj=evtime(stage_lin); agg['proj_linear']=agg.get('proj_linear',0)+t
        def stage_post():
          out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device)
          left_b=s._buf(key,'left_b',(B*H,N,N),f16,device); right_b=s._buf(key,'right_b',(B*H,N,N),f16,device)
          s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=4)
          return left_b,right_b,out_gate
        t,(left_b,right_b,out_gate)=evtime(stage_post); agg['post']=agg.get('post',0)+t
      def stage_bmm():
        return torch.bmm(left_b,right_b.transpose(1,2),out_dtype=f16).view(B,H,N,N)
      t,out_h=evtime(stage_bmm); agg['bmm']=agg.get('bmm',0)+t
      def stage_lngate():

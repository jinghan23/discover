/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def bench(B,N,H,BR,BH,nomask,reps=10):
    rows=B*N*N; D=384
    proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16)
    mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
    mask_arg=proj if mask is None else mask
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); outg=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,mask_arg,left,right,outg,rows=rows,n2=N*N,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=4)
    torch.cuda.synchronize(); times=[]
    for _ in range(reps):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record();
      s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,mask_arg,left,right,outg,rows=rows,n2=N*N,H=H,NOMASK=nomask,BLOCK_R=BR,BLOCK_H=BH,num_warps=4)
      en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    return min(times),sum(times)/len(times)
for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
  print('case',N,B,nomask)
  for BR in [8,16,32,64]:
    for BH in [32,64,128]:
      try:
        mn,avg=bench(B,N,128,BR,BH,nomask,5)
        print(' BR',BR,'BH',BH,'min',round(mn,1),'avg',round(avg,1))
      except Exception as e: print('err',BR,BH,e)

        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); y=submission.custom_kernel(case); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    return sum(times)/len(times), min(times), max(times), y.shape


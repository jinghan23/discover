import torch, triton
import submission as s

def bench(B,N,BM,BH,reps=6):
  D=H=128; rows=B*N*N; n2=N*N
  x=torch.randn((B,N,N,D),device='cuda')
  mask_arg=x
  weights={k:torch.randn((H,D),device='cuda') for k in ['left_proj.weight','right_proj.weight','left_gate.weight','right_gate.weight','out_gate.weight']}
  wl,wr,wlg,wrg,wog=tuple(weights[k].to(torch.float16).contiguous() for k in weights)
  nw=torch.randn(D,device='cuda'); nb=torch.randn(D,device='cuda')
  left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); outg=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
  s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,nw,nb,wl,wr,wlg,wrg,wog,left,right,outg,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=4)
  torch.cuda.synchronize(); times=[]
  for _ in range(reps):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record();
    s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,nw,nb,wl,wr,wlg,wrg,wog,left,right,outg,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=4)
    en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
  return min(times), sum(times)/len(times)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 print('case',N,B)
 for BM in [16,32,64,128]:
  for BH in [16,32,64]:
   try:
    mn,avg=bench(B,N,BM,BH,4)
    print(' BM',BM,'BH',BH,'min',round(mn,1),'avg',round(avg,1))
   except Exception as e: print('err',BM,BH,e)

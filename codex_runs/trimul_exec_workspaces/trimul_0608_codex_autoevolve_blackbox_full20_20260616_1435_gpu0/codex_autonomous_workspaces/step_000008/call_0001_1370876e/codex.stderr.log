 l=torch.empty(B*H,N,N,device=device,dtype=torch.float16); r=torch.empty_like(l); og=torch.empty(B,N,N,H,device=device,dtype=torch.float16)
 l2=torch.empty_like(l); r2=torch.empty_like(l); og2=torch.empty_like(og)
 print('N',N)
 def time(fn,reps=10):
  ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
  for _ in range(reps): ev0.record(); fn(); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
  return sum(ts)/len(ts), min(ts)
 curgrid=(triton.cdiv(rows,16),triton.cdiv(H,64))
 for _ in range(3): s._post_proj_transpose_kernel[curgrid](proj,mask,l,r,og,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=16,BLOCK_H=64,num_warps=8)

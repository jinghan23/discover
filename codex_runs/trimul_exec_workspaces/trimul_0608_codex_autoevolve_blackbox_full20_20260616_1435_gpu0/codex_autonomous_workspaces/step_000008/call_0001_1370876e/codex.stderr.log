/bin/bash -lc "python - <<'PY'
import torch
for N,BH in [(256,256),(512,128),(768,128),(1024,128)]:
 device='cuda'; left=torch.randn(BH,N,N,device=device,dtype=torch.float16); right=torch.randn(BH,N,N,device=device,dtype=torch.float16); out=torch.empty_like(left)
 for _ in range(5):
  torch.bmm(left,right.transpose(1,2),out=out,out_dtype=torch.float16)
  torch.bmm(left,right.transpose(1,2),out=out)
 torch.cuda.synchronize()
 def time(fn,reps=20):
  ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
  for _ in range(reps): ev0.record(); fn(); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
  return sum(ts)/len(ts), min(ts)
 print('N',N,'BH',BH,'out_dtype',time(lambda: torch.bmm(left,right.transpose(1,2),out=out,out_dtype=torch.float16)),'plain',time(lambda: torch.bmm(left,right.transpose(1,2),out=out)))

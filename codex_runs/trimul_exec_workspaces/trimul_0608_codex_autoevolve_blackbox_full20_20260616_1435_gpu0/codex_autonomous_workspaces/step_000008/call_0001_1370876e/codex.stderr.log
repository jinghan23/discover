+def _ln_gate_out_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    out_w_t_ptr,
+    out_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    H: tl.constexpr,
+    D: tl.constexpr,

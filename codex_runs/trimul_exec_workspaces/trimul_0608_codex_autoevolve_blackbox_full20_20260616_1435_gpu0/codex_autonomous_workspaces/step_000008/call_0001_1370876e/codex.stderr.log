    torch.cuda.synchronize()
    t=time(lambda: s._fused_proj384_4q_kernel[grid](x,mask,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw),5)
    print('BM',BM,'BH',BH,'nw',nw,t)
   except Exception as e: print('ERR',BM,BH,nw,type(e).__name__,e)

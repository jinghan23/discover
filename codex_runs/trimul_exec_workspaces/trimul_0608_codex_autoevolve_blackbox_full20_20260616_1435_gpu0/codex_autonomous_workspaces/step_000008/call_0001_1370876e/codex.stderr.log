import torch, submission

torch.manual_seed(3)
for N in [32,128]:
 B,D,H=1,384,128; device='cuda'; x=torch.randn(B,N,N,D,device=device); mask=(torch.rand(B,N,N,device=device)>0.25).float()
 weights={
 'norm.weight': torch.randn(D,device=device), 'norm.bias': torch.randn(D,device=device),
 'left_proj.weight': torch.randn(H,D,device=device), 'right_proj.weight': torch.randn(H,D,device=device),
 'left_gate.weight': torch.randn(H,D,device=device), 'right_gate.weight': torch.randn(H,D,device=device), 'out_gate.weight': torch.randn(H,D,device=device),
 'to_out_norm.weight': torch.randn(H,device=device), 'to_out_norm.bias': torch.randn(H,device=device), 'to_out.weight': torch.randn(D,H,device=device)}
 config={'dim':D,'hidden_dim':H,'nomask':False}
 y=submission.custom_kernel((x,mask,weights,config)); torch.cuda.synchronize()
 xn=torch.nn.functional.layer_norm(x,(D,),weights['norm.weight'],weights['norm.bias'],1e-5)
 l=torch.nn.functional.linear(xn,weights['left_proj.weight'])*mask.unsqueeze(-1); r=torch.nn.functional.linear(xn,weights['right_proj.weight'])*mask.unsqueeze(-1)
 l=l*torch.sigmoid(torch.nn.functional.linear(xn,weights['left_gate.weight'])); r=r*torch.sigmoid(torch.nn.functional.linear(xn,weights['right_gate.weight']))
 og=torch.sigmoid(torch.nn.functional.linear(xn,weights['out_gate.weight']))
 out=torch.einsum('bikd,bjkd->bijd',l,r); out=torch.nn.functional.layer_norm(out,(H,),weights['to_out_norm.weight'],weights['to_out_norm.bias'],1e-5)*og
 ref=torch.nn.functional.linear(out,weights['to_out.weight']); diff=(y-ref).abs(); print('N',N,'max',diff.max().item(),'mean',diff.mean().item())

codex
Since the fused fp32 output cannot pass, I’ll tune the existing output layernorm/gate kernel itself. It is used on all fallback paths and costs a few hundred microseconds on large cases.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(0)
for N in [256,768,1024]:
 B,H=1,128; rows=N*N; n2=rows; device='cuda'
 out_h=torch.randn(B,H,N,N,device=device,dtype=torch.float16); gate=torch.rand(B,N,N,H,device=device,dtype=torch.float16); nw=torch.randn(H,device=device); nb=torch.randn(H,device=device)
 for dtype in [torch.float16, torch.float32]:
  y=torch.empty(B,N,N,H,device=device,dtype=dtype)
  print('N',N,'dtype',dtype)
  for BR in [16,32,64,128,256]:
   for nwps in [1,2,4,8]:
    try:
     grid=(triton.cdiv(rows,BR),)
     for _ in range(2): s._ln_gate_tile_kernel[grid](out_h,gate,nw,nb,y,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=128,num_warps=nwps)
     torch.cuda.synchronize(); ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
     for _ in range(8): ev0.record(); s._ln_gate_tile_kernel[grid](out_h,gate,nw,nb,y,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=128,num_warps=nwps); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
     print(' BR',BR,'nw',nwps,'avg',sum(ts)/len(ts),'min',min(ts))
    except Exception as e: print(' ERR',BR,nwps,type(e).__name__,e)

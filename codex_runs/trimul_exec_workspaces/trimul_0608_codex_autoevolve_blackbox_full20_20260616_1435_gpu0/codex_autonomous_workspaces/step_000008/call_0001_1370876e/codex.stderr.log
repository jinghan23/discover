/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(0)
B,N,D,H=1,512,384,128; rows=B*N*N; n2=N*N; device='cuda'
x=torch.randn(B,N,N,D,device=device); mask=torch.ones(B,N,N,device=device)
w={
 'norm.weight': torch.randn(D,device=device), 'norm.bias': torch.randn(D,device=device),
 'left_proj.weight': torch.randn(H,D,device=device), 'right_proj.weight': torch.randn(H,D,device=device),
 'left_gate.weight': torch.randn(H,D,device=device), 'right_gate.weight': torch.randn(H,D,device=device), 'out_gate.weight': torch.randn(H,D,device=device)}
wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
left=torch.empty(B*H,N,N,device=device,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device=device,dtype=torch.float16)
# existing
xnorm=torch.empty_like(x,dtype=torch.float16); proj=torch.empty(B,N,N,5*H,device=device,dtype=torch.float16); left0=torch.empty_like(left); right0=torch.empty_like(right); og0=torch.empty_like(og)
for _ in range(3):
 s._input_ln384_kernel[(rows,)](x,w['norm.weight'],w['norm.bias'],xnorm,rows=rows,BLOCK_R=1,num_warps=1)
 torch.mm(xnorm.view(rows,D),s._proj_weight(w,torch.float16,D,H).t(),out=proj.view(rows,5*H),out_dtype=torch.float16)
 s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left0,right0,og0,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 s._fused_proj384_4q_kernel[(triton.cdiv(rows,32),)](x,mask,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=32,BLOCK_H=32,num_warps=4)
torch.cuda.synchronize()
def time(fn,reps=10):
 ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
 for _ in range(reps): ev0.record(); fn(); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
 return sum(ts)/len(ts), min(ts)
cur=time(lambda: (s._input_ln384_kernel[(rows,)](x,w['norm.weight'],w['norm.bias'],xnorm,rows=rows,BLOCK_R=1,num_warps=1), torch.mm(xnorm.view(rows,D),s._proj_weight(w,torch.float16,D,H).t(),out=proj.view(rows,5*H),out_dtype=torch.float16), s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left0,right0,og0,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=16,BLOCK_H=64,num_warps=8)))
print('existing',cur)
for BM in [16,32,64,128]:
 for BH in [16,32,64]:
  if H%BH: continue

  torch.bmm(left2,right2.transpose(1,2),out=out2,out_dtype=torch.float16)
  cur.wait_stream(aux)
 print('case',B,N,'orig proj+bmm',time(orig_sched),'overlap lr+bmm/og',time(overlap_sched),'diff', (out-out2).abs().max().item(), (og-og2).abs().max().item())

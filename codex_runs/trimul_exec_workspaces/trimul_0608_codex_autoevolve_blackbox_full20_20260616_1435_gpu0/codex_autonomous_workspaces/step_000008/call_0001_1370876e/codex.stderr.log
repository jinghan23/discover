The fp32 fused output kernel is added. I’ll compare it to the existing fp32 output path on the `N=768,D=384` shape.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(0)
for N,D in [(768,384),(256,384),(128,768)]:
 B,H=1,128; rows=B*N*N; n2=N*N; device='cuda'
 out_h=torch.randn(B,H,N,N,device=device,dtype=torch.float16); out_gate=torch.rand(B,N,N,H,device=device,dtype=torch.float16)
 nw=torch.randn(H,device=device); nb=torch.randn(H,device=device); ow=torch.randn(D,H,device=device); owt=ow.t().contiguous()
 gated=torch.empty(B,N,N,H,device=device); out=torch.empty(B,N,N,D,device=device); out2=torch.empty_like(out)
 for _ in range(4):
  s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h,out_gate,nw,nb,gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
  torch.mm(gated.view(rows,H),owt,out=out.view(rows,D))
  s._ln_gate_out_f32_kernel[(triton.cdiv(rows,32),)](out_h,out_gate,nw,nb,owt,out2,rows=rows,n2=n2,H=H,D=D,BLOCK_R=32,BLOCK_D=64,num_warps=4)
 torch.cuda.synchronize()
 def time(fn,reps=8):
  ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]

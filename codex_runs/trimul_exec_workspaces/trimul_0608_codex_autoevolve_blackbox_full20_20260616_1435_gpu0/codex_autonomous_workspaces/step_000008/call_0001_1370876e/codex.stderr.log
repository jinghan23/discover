     torch.cuda.synchronize(); ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
     for _ in range(6): ev0.record(); s._fused_proj128_4q_kernel[grid](x,mask,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
     print('BM',BM,'BH',BH,'nw',nw,'avg',sum(ts)/len(ts),'min',min(ts))
    except Exception as e: print('ERR',BM,BH,nw,type(e).__name__,e)
run(768)
run(1024)

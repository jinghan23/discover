import torch, triton
import submission as s

for N in [256,768,1024]:
 B,H=1,128; rows=N*N; n2=rows; device='cuda'
 proj=torch.randn(B,N,N,5*H,device=device,dtype=torch.float16); mask=torch.ones(B,N,N,device=device)
 l=torch.empty(B*H,N,N,device=device,dtype=torch.float16); r=torch.empty_like(l); og=torch.empty(B,N,N,H,device=device,dtype=torch.float16)
 l2=torch.empty_like(l); r2=torch.empty_like(l); og2=torch.empty_like(og)
 grid=(triton.cdiv(rows,16),triton.cdiv(H,64))

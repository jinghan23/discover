+            BLOCK_H=128,
+            num_warps=4,
+        )
         torch.mm(gated.view(rows, hidden_dim), to_out_w.to(f32).t(), out=out.view(rows, dim))
     return out

codex
For `D=384,N=768`, `BLOCK_R=64,BLOCK_D=64` is faster than the current `BLOCK_R=128`. I’ll update the branch to use `64` for `N=768` and keep checking `N=1024`.

import torch, time
import submission

torch.manual_seed(123)

def make_weights(dim,h,device):
    return {
      'norm.weight': torch.randn(dim,device=device),
      'norm.bias': torch.randn(dim,device=device),
      'left_proj.weight': torch.randn(h,dim,device=device),
      'right_proj.weight': torch.randn(h,dim,device=device),
      'left_gate.weight': torch.randn(h,dim,device=device),
      'right_gate.weight': torch.randn(h,dim,device=device),
      'out_gate.weight': torch.randn(h,dim,device=device),
      'to_out_norm.weight': torch.randn(h,device=device),
      'to_out_norm.bias': torch.randn(h,device=device),
      'to_out.weight': torch.randn(dim,h,device=device),
    }

def bench(case, reps=10):
    B,N,D,H,nomask,dist=case; device='cuda'
    x=torch.randn(B,N,N,D,device=device) if dist=='normal' else torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(device).float()
    mask=torch.ones(B,N,N,device=device) if nomask else (torch.rand(B,N,N,device=device)>0.25).float()
    weights=make_weights(D,H,device); config={'dim':D,'hidden_dim':H,'nomask':nomask}
    for _ in range(8): submission.custom_kernel((x,mask,weights,config))
    torch.cuda.synchronize(); ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); times=[]
    for _ in range(reps): ev0.record(); submission.custom_kernel((x,mask,weights,config)); ev1.record(); torch.cuda.synchronize(); times.append(ev0.elapsed_time(ev1)*1000)
    print(case, sum(times)/len(times), min(times))
for c in [(2,256,128,128,True,'normal'),(1,768,128,128,True,'cauchy'),(2,256,384,128,False,'normal'),(1,512,128,128,True,'normal'),(1,1024,128,128,True,'cauchy'),(1,768,384,128,False,'normal'),(1,1024,384,128,True,'normal'),(1,256,128,128,False,'normal')]: bench(c)

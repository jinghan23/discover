/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(0)
for N,B in [(512,1),(768,1),(1024,1),(256,2)]:
 D=H=128; rows=B*N*N; n2=N*N; device='cuda'
 x=torch.randn(B,N,N,D,device=device); mask=torch.ones(B,N,N,device=device)
 w={
 'norm.weight': torch.randn(D,device=device), 'norm.bias': torch.randn(D,device=device),
 'left_proj.weight': torch.randn(H,D,device=device), 'right_proj.weight': torch.randn(H,D,device=device),
 'left_gate.weight': torch.randn(H,D,device=device), 'right_gate.weight': torch.randn(H,D,device=device), 'out_gate.weight': torch.randn(H,D,device=device)}
 wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
 left=torch.empty(B*H,N,N,device=device,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device=device,dtype=torch.float16); out=torch.empty(B*H,N,N,device=device,dtype=torch.float16)
 left2=torch.empty_like(left); right2=torch.empty_like(left); og2=torch.empty_like(og); out2=torch.empty_like(out)
 BM=64 if N==768 else 128; nwps=4 if N==768 else 8; grid=(triton.cdiv(rows,BM),)
 aux=torch.cuda.Stream()
 for _ in range(4):
  s._fused_proj128_4q_kernel[grid](x,mask,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=32,num_warps=nwps)
  torch.bmm(left,right.transpose(1,2),out=out,out_dtype=torch.float16)
  s._fused_proj128_lr_4q_kernel[grid](x,mask,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,left2,right2,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=32,num_warps=nwps)
  torch.bmm(left2,right2.transpose(1,2),out=out2,out_dtype=torch.float16)
  s._fused_out_gate128_4q_kernel[grid](x,w['norm.weight'],w['norm.bias'],wog,og2,rows=rows,BLOCK_M=BM,BLOCK_H=32,num_warps=nwps)
 torch.cuda.synchronize()
 def time(fn,reps=8):
  ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
  for _ in range(reps): ev0.record(); fn(); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
  return sum(ts)/len(ts), min(ts)

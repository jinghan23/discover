Since `D=384,N=512/768` now use the fused fp16 final output, I’ll tune its row block for those sizes; the current `BLOCK_R=128` was chosen from `N=1024`.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s
for N in [512,768,1024]:
 B,D,H=1,384,128; rows=N*N; n2=rows; device='cuda'
 out_h=torch.randn(B,H,N,N,device=device,dtype=torch.float16); gate=torch.rand(B,N,N,H,device=device,dtype=torch.float16); nw=torch.randn(H,device=device); nb=torch.randn(H,device=device); owt=torch.randn(H,D,device=device,dtype=torch.float16); out=torch.empty(B,N,N,D,device=device)
 print('N',N)
 for BR in [32,64,128,256]:
  for BD in [32,64,128]:
   if D%BD: continue
   try:
    grid=(triton.cdiv(rows,BR),)
    for _ in range(2): s._ln_gate_out_kernel[grid](out_h,gate,nw,nb,owt,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=4)
    torch.cuda.synchronize(); ev0=torch.cuda.Event(True); ev1=torch.cuda.Event(True); ts=[]
    for _ in range(8): ev0.record(); s._ln_gate_out_kernel[grid](out_h,gate,nw,nb,owt,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=4); ev1.record(); torch.cuda.synchronize(); ts.append(ev0.elapsed_time(ev1)*1000)
    print('BR',BR,'BD',BD,'avg',sum(ts)/len(ts),'min',min(ts))
   except Exception as e: print('ERR',BR,BD,e)

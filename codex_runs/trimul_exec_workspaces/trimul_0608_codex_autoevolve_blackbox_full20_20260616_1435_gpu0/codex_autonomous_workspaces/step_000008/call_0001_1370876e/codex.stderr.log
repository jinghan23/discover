def ref(input_tensor, mask, weights, config):
    x=input_tensor
    dim=config['dim']; h=config['hidden_dim']
    x=torch.nn.functional.layer_norm(x,(dim,),weights['norm.weight'],weights['norm.bias'],1e-5)
    left=torch.nn.functional.linear(x,weights['left_proj.weight'])
    right=torch.nn.functional.linear(x,weights['right_proj.weight'])
    if mask is not None:
        m=mask.unsqueeze(-1)
        left=left*m; right=right*m
    lg=torch.sigmoid(torch.nn.functional.linear(x,weights['left_gate.weight']))
    rg=torch.sigmoid(torch.nn.functional.linear(x,weights['right_gate.weight']))
    og=torch.sigmoid(torch.nn.functional.linear(x,weights['out_gate.weight']))
    left=left*lg; right=right*rg
    out=torch.einsum('bikd,bjkd->bijd',left,right)
    out=torch.nn.functional.layer_norm(out,(h,),weights['to_out_norm.weight'],weights['to_out_norm.bias'],1e-5)
    out=out*og
    out=torch.nn.functional.linear(out,weights['to_out.weight'])
    return out


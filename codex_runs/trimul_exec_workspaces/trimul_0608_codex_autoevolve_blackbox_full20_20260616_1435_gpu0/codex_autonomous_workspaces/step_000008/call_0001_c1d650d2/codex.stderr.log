+"""Reference outgoing TriMul implementation with a tiny Triton touch kernel."""
+
+import torch
+import torch.nn.functional as F
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _touch_kernel(x_ptr, y_ptr):
+    v = tl.load(x_ptr)
+    tl.store(y_ptr, v)
+
+
+_TMP = {}
+
+
+def custom_kernel(data):
+    input_tensor, mask, weights, config = data
+    key = (input_tensor.device, input_tensor.dtype)
+    tmp = _TMP.get(key)
+    if tmp is None:
+        tmp = torch.empty((1,), device=input_tensor.device, dtype=input_tensor.dtype)
+        _TMP[key] = tmp
+    _touch_kernel[(1,)](input_tensor, tmp)
+    dim = int(config["dim"])
+    hidden_dim = int(config["hidden_dim"])
+    x = F.layer_norm(
+        input_tensor,
+        (dim,),
+        weights["norm.weight"],
+        weights["norm.bias"],
+        1.0e-5,
+    )
+    left = F.linear(x, weights["left_proj.weight"])
+    right = F.linear(x, weights["right_proj.weight"])
+    if mask is not None and not bool(config.get("nomask", False)):
+        m = mask.unsqueeze(-1)
+        left = left * m
+        right = right * m
+    left = left * torch.sigmoid(F.linear(x, weights["left_gate.weight"]))
+    right = right * torch.sigmoid(F.linear(x, weights["right_gate.weight"]))
+    out_gate = torch.sigmoid(F.linear(x, weights["out_gate.weight"]))
+    out = torch.einsum("bikd,bjkd->bijd", left, right)
+    out = F.layer_norm(
+        out,
+        (hidden_dim,),
+        weights["to_out_norm.weight"],
+        weights["to_out_norm.bias"],
+        1.0e-5,
+    )
+    return F.linear(out * out_gate, weights["to_out.weight"]).float()

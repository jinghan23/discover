import importlib, torch
import torch.nn.functional as F
import submission

torch.manual_seed(0)

def ref(data):
    x, mask, w, cfg = data
    dim=cfg['dim']; h=cfg['hidden_dim']
    x = F.layer_norm(x, (dim,), w['norm.weight'], w['norm.bias'], 1e-5)
    left = F.linear(x, w['left_proj.weight'])
    right = F.linear(x, w['right_proj.weight'])
    if mask is not None:
        m = mask.unsqueeze(-1)
        left = left*m; right=right*m
    lg = torch.sigmoid(F.linear(x, w['left_gate.weight']))
    rg = torch.sigmoid(F.linear(x, w['right_gate.weight']))
    og = torch.sigmoid(F.linear(x, w['out_gate.weight']))

    out = F.layer_norm(out, (h,), w['to_out_norm.weight'], w['to_out_norm.bias'], 1e-5)
    out = out * og
    out = F.linear(out, w['to_out.weight'])
    return out

def make(B,N,D,H,nomask=True,dist='normal'):
    dtype=torch.float32; device='cuda'
    if dist=='cauchy':

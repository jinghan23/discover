/bin/bash -lc "python - <<'PY'
import importlib, torch, math, time, gc
import submission
importlib.reload(submission)
torch.manual_seed(0)

def make(B,N,D,H,nomask,dist):
 dev='cuda';
 x=torch.randn(B,N,N,D,device=dev) if dist=='normal' else torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev)
 mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.25).float()
 weights={'norm.weight':torch.ones(D,device=dev),'norm.bias':torch.zeros(D,device=dev),'to_out_norm.weight':torch.ones(H,device=dev),'to_out_norm.bias':torch.zeros(H,device=dev)}
 for name,shape,fan in [('left_proj.weight',(H,D),D),('right_proj.weight',(H,D),D),('left_gate.weight',(H,D),D),('right_gate.weight',(H,D),D),('out_gate.weight',(H,D),D),('to_out.weight',(D,H),H)]:
  a=1/math.sqrt(fan); weights[name]=torch.empty(shape,device=dev).uniform_(-a,a)
 return x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask}

def bench(data, reps=10):
 for _ in range(3): y=submission.custom_kernel(data)
 torch.cuda.synchronize()
 st=torch.cuda.Event(True); en=torch.cuda.Event(True)
 st.record()
 for _ in range(reps): y=submission.custom_kernel(data)
 en.record(); torch.cuda.synchronize()
 return st.elapsed_time(en)*1000/reps
cases=[(2,256,128,128,True,'normal'),(1,768,128,128,True,'cauchy'),(2,256,384,128,False,'normal'),(1,512,128,128,True,'normal'),(1,1024,128,128,True,'cauchy'),(1,768,384,128,False,'normal'),(1,1024,384,128,True,'normal')]
for c in cases:
 print('case',c,flush=True)
 data=make(*c)
 reps=20 if c[1]<=512 else 8
 print('us',bench(data,reps),flush=True)
 del data; gc.collect(); torch.cuda.empty_cache()

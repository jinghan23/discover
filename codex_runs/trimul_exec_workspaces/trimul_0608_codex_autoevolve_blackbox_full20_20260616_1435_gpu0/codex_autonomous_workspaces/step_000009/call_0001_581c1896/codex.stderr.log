codex
One promising structural issue is the BMM output layout: cuBLAS writes `[B,H,N,N]`, while the following Triton layernorm reads hidden channels with a huge stride. For the large `B=1` cases I can try writing BMM directly into `[B,N,N,H]` storage via an `as_strided` output and use a contiguous post kernel.
exec
/bin/bash -lc "python - <<'PY'
import torch
print(torch.__version__)
if torch.cuda.is_available():
    B,H,N=1,4,8
    left=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
    right=torch.randn(B*H,N,N,device='cuda',dtype=torch.float16)
    out=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    view=torch.as_strided(out,(B*H,N,N),(1,N*H,H))
    try:
        torch.bmm(left,right.transpose(1,2),out=view,out_dtype=torch.float16)
        torch.cuda.synchronize()
        ref=torch.bmm(left,right.transpose(1,2))
        print('bmm as_strided ok', (view-ref).abs().max().item(), out.stride(), view.stride())
    except Exception as e:
        print('bmm failed',type(e),e)
    B,H,N=2,4,8
    out=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    # impossible flatten? make shape (B,H,N,N)
    view4=torch.as_strided(out,(B,H,N,N),(N*N*H,1,N*H,H))
    left=torch.randn(B,H,N,N,device='cuda',dtype=torch.float16)
    right=torch.randn(B,H,N,N,device='cuda',dtype=torch.float16)
    try:
        torch.matmul(left,right.transpose(-1,-2),out=view4)
        torch.cuda.synchronize()
        ref=torch.matmul(left,right.transpose(-1,-2))
        print('matmul 4d out ok', (view4-ref).abs().max().item(), view4.stride())
    except Exception as e:
        print('matmul failed',type(e),e)

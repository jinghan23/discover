+def _fused_proj128_4q_rt_kernel(
+    x_ptr,
+    mask_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    wl_ptr,
+    wr_ptr,
+    wlg_ptr,
+    wrg_ptr,
+    wog_ptr,
+    left_ptr,

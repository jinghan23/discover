codex
Local checks show the transposed post kernel is bitwise identical to the row kernel on small masked and nomask cases, so the earlier failure may have been from a surrounding patch. I’m going to benchmark it locally before deciding whether to retry it in the full evaluator.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission
for N,B in [(1024,1),(768,1),(256,2)]:
  H=128; rows=B*N*N; n2=N*N
  proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16)
  mask=(torch.rand((B,N,N),device='cuda')>0.2).float()
  left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
  # warm
  for _ in range(3):
    submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
  torch.cuda.synchronize()
  ts=[]
  for _ in range(10):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
    submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  row=min(ts)
  for _ in range(3):
    submission._post_proj_transpose_t_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
  torch.cuda.synchronize(); ts=[]
  for _ in range(10):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
    submission._post_proj_transpose_t_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,gate,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  print('N',N,'B',B,'row',row,'t',min(ts))

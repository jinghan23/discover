 @triton.jit
+def _input_ln384_2rows_kernel(
+    x_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    row0 = pid * 2
+    row1 = row0 + 1
+    offs = tl.arange(0, 128)
+    valid0 = row0 < rows
+    valid1 = row1 < rows
+
+    base0 = row0 * 384 + offs
+    x00 = tl.load(x_ptr + base0, mask=valid0, other=0.0).to(tl.float32)
+    x01 = tl.load(x_ptr + base0 + 128, mask=valid0, other=0.0).to(tl.float32)
+    x02 = tl.load(x_ptr + base0 + 256, mask=valid0, other=0.0).to(tl.float32)
+    mean0 = (tl.sum(x00, axis=0) + tl.sum(x01, axis=0) + tl.sum(x02, axis=0)) * (1.0 / 384.0)
+    xc00 = x00 - mean0
+    xc01 = x01 - mean0
+    xc02 = x02 - mean0
+    var0 = (tl.sum(xc00 * xc00, axis=0) + tl.sum(xc01 * xc01, axis=0) + tl.sum(xc02 * xc02, axis=0)) * (1.0 / 384.0)
+    rstd0 = tl.rsqrt(var0 + 1.0e-5)
+
+    base1 = row1 * 384 + offs
+    x10 = tl.load(x_ptr + base1, mask=valid1, other=0.0).to(tl.float32)
+    x11 = tl.load(x_ptr + base1 + 128, mask=valid1, other=0.0).to(tl.float32)
+    x12 = tl.load(x_ptr + base1 + 256, mask=valid1, other=0.0).to(tl.float32)
+    mean1 = (tl.sum(x10, axis=0) + tl.sum(x11, axis=0) + tl.sum(x12, axis=0)) * (1.0 / 384.0)
+    xc10 = x10 - mean1
+    xc11 = x11 - mean1
+    xc12 = x12 - mean1
+    var1 = (tl.sum(xc10 * xc10, axis=0) + tl.sum(xc11 * xc11, axis=0) + tl.sum(xc12 * xc12, axis=0)) * (1.0 / 384.0)
+    rstd1 = tl.rsqrt(var1 + 1.0e-5)
+
+    w0 = tl.load(w_ptr + offs).to(tl.float32)
+    b0 = tl.load(b_ptr + offs).to(tl.float32)
+    w1 = tl.load(w_ptr + offs + 128).to(tl.float32)
+    b1 = tl.load(b_ptr + offs + 128).to(tl.float32)
+    w2 = tl.load(w_ptr + offs + 256).to(tl.float32)
+    b2 = tl.load(b_ptr + offs + 256).to(tl.float32)
+    tl.store(y_ptr + base0, xc00 * rstd0 * w0 + b0, mask=valid0)
+    tl.store(y_ptr + base0 + 128, xc01 * rstd0 * w1 + b1, mask=valid0)
+    tl.store(y_ptr + base0 + 256, xc02 * rstd0 * w2 + b2, mask=valid0)
+    tl.store(y_ptr + base1, xc10 * rstd1 * w0 + b0, mask=valid1)
+    tl.store(y_ptr + base1 + 128, xc11 * rstd1 * w1 + b1, mask=valid1)
+    tl.store(y_ptr + base1 + 256, xc12 * rstd1 * w2 + b2, mask=valid1)
+

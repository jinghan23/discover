import torch, math, triton, time
import submission as s

def make_case(B,N,dim,nomask):
 H=128; torch.manual_seed(2); x=torch.randn(B,N,N,dim,device='cuda'); mask=None if nomask else torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32)
 weights={'norm.weight':torch.ones(dim,device='cuda'),'norm.bias':torch.zeros(dim,device='cuda'),'to_out_norm.weight':torch.ones(H,device='cuda'),'to_out_norm.bias':torch.zeros(H,device='cuda')}
 for k,shape in [('left_proj.weight',(H,dim)),('right_proj.weight',(H,dim)),('left_gate.weight',(H,dim)),('right_gate.weight',(H,dim)),('out_gate.weight',(H,dim)),('to_out.weight',(dim,H))]:
  weights[k]=torch.empty(shape,device='cuda').uniform_(-1/math.sqrt(shape[1]),1/math.sqrt(shape[1]))
 return x,mask,weights,{'dim':dim,'hidden_dim':H,'nomask':nomask}

def evtime(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); ret=fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000, ret

def trace(data):
 input_tensor, mask, weights, config=data; dim=int(config['dim']); H=128; B=input_tensor.shape[0]; N=input_tensor.shape[1]; rows=B*N*N; n2=N*N; device=input_tensor.device; f16=torch.float16; f32=torch.float32
 norm_w=weights['norm.weight']; norm_b=weights['norm.bias']; out_norm_w=weights['to_out_norm.weight']; out_norm_b=weights['to_out_norm.bias']; x_in=input_tensor.contiguous(); nomask=bool(config.get('nomask',False)) or mask is None; mask_arg=input_tensor if mask is None else mask; key=(device,B,N,dim,H)
 times=[]
 def rec(name, fn):
  t,r=evtime(fn); times.append((name,t)); return r
 if dim==128:
  left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device); out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device); wl,wr,wlg,wrg,wog=s._proj_parts(weights,f16,dim,H)
  if N==768: BM=64; nw=4
  else: BM=128; nw=8
  rec('fused_proj128', lambda: s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x_in,mask_arg,norm_w.to(f32),norm_b.to(f32),wl,wr,wlg,wrg,wog,left,right,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=32,num_warps=nw))
 else:
  left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device); out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device); x=s._buf(key,'x_norm',input_tensor.shape,f16,device); in_rows=x.numel()//dim
  if dim==384:
   rec('input_ln384', lambda: s._input_ln384_kernel[(in_rows,)](x_in,norm_w.to(f32),norm_b.to(f32),x,rows=in_rows,BLOCK_R=1,num_warps=1))
  else:
   rec('input_ln', lambda: s._input_ln_kernel[(in_rows,)](x_in,norm_w.to(f32),norm_b.to(f32),x,D=dim,BLOCK=triton.next_power_of_2(dim),num_warps=1))
  proj_w=s._proj_weight(weights,f16,dim,H); proj=s._buf(key,'proj',(B,N,N,5*H),f16,device)
  rec('proj_mm', lambda: torch.mm(x.view(rows,dim),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16))
  rec('post_proj', lambda: s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8))
 out_h_flat=s._buf(key,'out_h',(B*H,N,N),f16,device)
 rec('bmm', lambda: torch.bmm(left,right.transpose(1,2),out=out_h_flat,out_dtype=f16))
 out_h=out_h_flat.view(B,H,N,N); out=s._buf(key,'out',input_tensor.shape,f32,device)
 if (dim==128) or (dim==384 and (N==1024 or N==768 or N==512)):
  tw=s._to_out_weight_t(weights,f16); br=128 if dim==384 else 64
  rec('ln_gate_out', lambda: s._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,out_gate,out_norm_w.to(f32),out_norm_b.to(f32),tw,out,rows=rows,n2=n2,H=H,D=dim,BLOCK_R=br,BLOCK_D=64,num_warps=4))
 else:

            to_out_h_t,
            out,
            rows=rows,
            n2=n2,
            H=hidden_dim,
            D=dim,
            BLOCK_R=br,
            BLOCK_D=64,
            num_warps=4,
        )
    else:
        gated = _buf(buf_shape_key, "gated", (batch_size, seq_len, seq_len, hidden_dim), f32, device)
        _ln_gate_tile_kernel[(triton.cdiv(rows, 64),)](
            out_h,
            out_gate,
            out_norm_w.to(f32),
            out_norm_b.to(f32),
            gated,
            rows=rows,
            n2=n2,
            H=hidden_dim,
            BLOCK_R=64,
            BLOCK_H=128,
            num_warps=4,
        )
        torch.mm(gated.view(rows, hidden_dim), to_out_w.to(f32).t(), out=out.view(rows, dim))
    return out


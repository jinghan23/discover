 key=(device,B,N,D,H,'cmpfused'); left=s._buf(key,'left',(B*H,N,N),f16,device); right=s._buf(key,'right',(B*H,N,N),f16,device); og=s._buf(key,'og',(B,N,N,H),f16,device)

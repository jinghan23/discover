 key=(device,B,N,D,H,'cmpmm'); left=s._buf(key,'left',(B*H,N,N),f16,device); right=s._buf(key,'right',(B*H,N,N),f16,device); og=s._buf(key,'og',(B,N,N,H),f16,device); xn=s._buf(key,'xn',x.shape,f16,device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,device); pw=s._proj_weight({'left_proj.weight':w['left_proj.weight'],'right_proj.weight':w['right_proj.weight'],'left_gate.weight':w['left_gate.weight'],'right_gate.weight':w['right_gate.weight'],'out_gate.weight':w['out_gate.weight']},f16,D,H)

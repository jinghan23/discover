codex
Direct strided GEMM output is feasible for `B=1`. I’m benchmarking a prototype that writes the five projections directly into final layouts, using PyTorch elementwise gates first; if it is close, I’ll replace the elementwise part with a fused Triton gate kernel.
exec
/bin/bash -lc "python - <<'PY'
import torch, math, triton
import submission as s

def ev(fn,reps=5):
 fn(); torch.cuda.synchronize(); ts=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return min(ts),sum(ts)/len(ts)
for N,D in [(768,384),(1024,384),(768,768)]:
 B=1;H=128;rows=N*N;n2=rows;print('CASE',N,D,flush=True); x=torch.randn(rows,D,device='cuda',dtype=torch.float16); weights=[torch.randn(H,D,device='cuda',dtype=torch.float16)/math.sqrt(D) for _ in range(5)]
 left=torch.empty(H,N,N,device='cuda',dtype=torch.float16); right=torch.empty_like(left); lg=torch.empty_like(left); rg=torch.empty_like(left); og=torch.empty(rows,H,device='cuda',dtype=torch.float16); proj=torch.empty(rows,5*H,device='cuda',dtype=torch.float16); pw=torch.cat(weights,dim=0).contiguous(); mask=torch.ones(N,N,device='cuda',dtype=torch.float32)
 leftv=torch.as_strided(left,(rows,H),(1,rows)); rightv=torch.as_strided(right,(rows,H),(1,rows)); lgv=torch.as_strided(lg,(rows,H),(1,rows)); rgv=torch.as_strided(rg,(rows,H),(1,rows))
 print('one mm', ev(lambda: torch.mm(x,pw.t(),out=proj,out_dtype=torch.float16)), flush=True)
 print('five mm only', ev(lambda: (torch.mm(x,weights[0].t(),out=leftv,out_dtype=torch.float16), torch.mm(x,weights[1].t(),out=rightv,out_dtype=torch.float16), torch.mm(x,weights[2].t(),out=lgv,out_dtype=torch.float16), torch.mm(x,weights[3].t(),out=rgv,out_dtype=torch.float16), torch.mm(x,weights[4].t(),out=og,out_dtype=torch.float16))), flush=True)
 print('five+torch gates', ev(lambda: (torch.mm(x,weights[0].t(),out=leftv,out_dtype=torch.float16), torch.mm(x,weights[1].t(),out=rightv,out_dtype=torch.float16), torch.mm(x,weights[2].t(),out=lgv,out_dtype=torch.float16), torch.mm(x,weights[3].t(),out=rgv,out_dtype=torch.float16), torch.mm(x,weights[4].t(),out=og,out_dtype=torch.float16), left.mul_(lg.sigmoid()), right.mul_(rg.sigmoid()), og.sigmoid_())), flush=True)
 del x,weights,left,right,lg,rg,og,proj,pw,mask; torch.cuda.empty_cache()

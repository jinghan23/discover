    left_gate = torch.sigmoid(torch.nn.functional.linear(x, weights['left_gate.weight']))
    right_gate = torch.sigmoid(torch.nn.functional.linear(x, weights['right_gate.weight']))
    out_gate = torch.sigmoid(torch.nn.functional.linear(x, weights['out_gate.weight']))
    left=left*left_gate; right=right*right_gate
    out=torch.einsum('bikd,bjkd->bijd', left, right)
    out=torch.nn.functional.layer_norm(out, (H,), weights['to_out_norm.weight'], weights['to_out_norm.bias'], 1e-5)
    out=out*out_gate
    out=torch.nn.functional.linear(out, weights['to_out.weight'])
    return out

def weights_like(dim,H,dtype=torch.float32):
    # mimic nn.Linear defaults more closely
    weights={
   'norm.weight':torch.ones(dim,device='cuda',dtype=dtype), 'norm.bias':torch.zeros(dim,device='cuda',dtype=dtype),

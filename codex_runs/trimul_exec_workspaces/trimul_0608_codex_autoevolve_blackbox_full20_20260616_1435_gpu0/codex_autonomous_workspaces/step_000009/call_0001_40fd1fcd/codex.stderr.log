codex
I’m exploring whether cuBLAS can write projection results directly into the `[H,N,N]` layout for `B=1`, which would remove part of the post-transpose cost. This may not win because it splits one large GEMM into several smaller GEMMs, but it’s worth a quick feasibility check.
exec
/bin/bash -lc "python - <<'PY'
import torch, math, time
N=128;D=384;H=128;rows=N*N
x=torch.randn(rows,D,device='cuda',dtype=torch.float16); w=torch.randn(H,D,device='cuda',dtype=torch.float16); left=torch.empty(H,N,N,device='cuda',dtype=torch.float16)
out=torch.as_strided(left,(rows,H),(1,rows))
print(out.shape,out.stride(),out.is_contiguous())
try:
 torch.mm(x,w.t(),out=out,out_dtype=torch.float16); torch.cuda.synchronize(); print('ok')
 print((out-left.permute(1,2,0).reshape(rows,H)).abs().max())
except Exception as e:
 print('err',e)

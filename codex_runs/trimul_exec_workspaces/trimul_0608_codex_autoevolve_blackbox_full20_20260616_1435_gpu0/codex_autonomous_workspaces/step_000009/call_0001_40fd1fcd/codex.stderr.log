import torch, math, triton
import submission as s

def make(B,N):
 H=128; dim=128; torch.manual_seed(5); x=torch.randn(B,N,N,dim,device='cuda'); w={'norm.weight':torch.ones(dim,device='cuda'),'norm.bias':torch.zeros(dim,device='cuda')}
 for k,shape in [('left_proj.weight',(H,dim)),('right_proj.weight',(H,dim)),('left_gate.weight',(H,dim)),('right_gate.weight',(H,dim)),('out_gate.weight',(H,dim))]: w[k]=torch.empty(shape,device='cuda').uniform_(-1/math.sqrt(shape[1]),1/math.sqrt(shape[1]))
 return x,w

def ev(fn,reps=5):
 fn(); torch.cuda.synchronize(); ts=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return min(ts),sum(ts)/len(ts)
for B,N in [(2,256),(1,512),(1,768),(1,1024)]:

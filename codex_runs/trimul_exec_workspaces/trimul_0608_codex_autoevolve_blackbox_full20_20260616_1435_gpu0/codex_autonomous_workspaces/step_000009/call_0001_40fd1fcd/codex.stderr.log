codex
Five separate GEMMs are too slow. A better direct-layout variant is one GEMM for the first four projections into `[4,H,N,N]` plus one GEMM for `out_gate`; I’m benchmarking that split because it removes most transpose work with only two GEMM launches.
exec
/bin/bash -lc "python - <<'PY'
import torch, math

def ev(fn,reps=5):
 fn(); torch.cuda.synchronize(); ts=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return min(ts),sum(ts)/len(ts)
for N,D in [(768,384),(1024,384),(768,768),(1024,128)]:
 H=128;rows=N*N;print('CASE',N,D,flush=True); x=torch.randn(rows,D,device='cuda',dtype=torch.float16); w4=torch.randn(4*H,D,device='cuda',dtype=torch.float16)/math.sqrt(D); wog=torch.randn(H,D,device='cuda',dtype=torch.float16)/math.sqrt(D); wall=torch.cat([w4,wog],dim=0).contiguous(); buf4=torch.empty(4,H,N,N,device='cuda',dtype=torch.float16); out4=torch.as_strided(buf4,(rows,4*H),(1,rows)); og=torch.empty(rows,H,device='cuda',dtype=torch.float16); proj=torch.empty(rows,5*H,device='cuda',dtype=torch.float16)
 print('one640',ev(lambda: torch.mm(x,wall.t(),out=proj,out_dtype=torch.float16)),flush=True)
 print('split512+128',ev(lambda: (torch.mm(x,w4.t(),out=out4,out_dtype=torch.float16), torch.mm(x,wog.t(),out=og,out_dtype=torch.float16))),flush=True)
 del x,w4,wog,wall,buf4,out4,og,proj; torch.cuda.empty_cache()

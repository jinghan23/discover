  rec('to_out_mm', lambda: torch.mm(gated.view(rows,H),weights['to_out.weight'].to(f32).t(),out=out.view(rows,dim)))
 print('times',times,'total',sum(t for _,t in times))

for c in [(2,256,128,True),(1,1024,128,True),(2,256,384,False),(1,768,384,False),(1,1024,384,True)]:

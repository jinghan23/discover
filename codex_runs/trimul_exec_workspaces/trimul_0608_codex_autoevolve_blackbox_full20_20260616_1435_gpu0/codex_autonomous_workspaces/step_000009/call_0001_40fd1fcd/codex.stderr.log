import torch, math, triton
import submission as s

def make(B,N,dim,nomask):
 H=128; torch.manual_seed(3); x=torch.randn(B,N,N,dim,device='cuda'); mask=None if nomask else torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32)
 w={'norm.weight':torch.ones(dim,device='cuda'),'norm.bias':torch.zeros(dim,device='cuda'), 'to_out_norm.weight':torch.ones(H,device='cuda'),'to_out_norm.bias':torch.zeros(H,device='cuda')}
 for k,shape in [('left_proj.weight',(H,dim)),('right_proj.weight',(H,dim)),('left_gate.weight',(H,dim)),('right_gate.weight',(H,dim)),('out_gate.weight',(H,dim)),('to_out.weight',(dim,H))]: w[k]=torch.empty(shape,device='cuda').uniform_(-1/math.sqrt(shape[1]),1/math.sqrt(shape[1]))
 return x,mask,w,{'dim':dim,'hidden_dim':H,'nomask':nomask}

def ev(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000

def bench_fused(data,BM,BH,nw):
 x,mask,w,c=data; B=x.shape[0];N=x.shape[1];dim=c['dim'];H=128;rows=B*N*N;n2=N*N;device=x.device;key=(device,B,N,dim,H,'fusedtest',BM,BH);f16=torch.float16;f32=torch.float32
 left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device); og=s._buf(key,'out_gate',(B,N,N,H),f16,device); wl,wr,wlg,wrg,wog=s._proj_parts(w,f16,dim,H); mask_arg=x if mask is None else mask; nomask=bool(c.get('nomask')) or mask is None
 return ev(lambda: s._fused_proj384_4q_kernel[(triton.cdiv(rows,BM),)](x.contiguous(),mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=nw))

def bench_old(data):
 x,mask,w,c=data; B=x.shape[0];N=x.shape[1];dim=c['dim'];H=128;rows=B*N*N;n2=N*N;device=x.device;key=(device,B,N,dim,H,'oldtest');f16=torch.float16;f32=torch.float32
 left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device); og=s._buf(key,'out_gate',(B,N,N,H),f16,device); xn=s._buf(key,'x_norm',x.shape,f16,device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,device); mask_arg=x if mask is None else mask; nomask=bool(c.get('nomask')) or mask is None; pw=s._proj_weight(w,f16,dim,H)
 t1=ev(lambda: s._input_ln384_kernel[(rows,)](x.contiguous(),w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,rows=rows,BLOCK_R=1,num_warps=1))
 t2=ev(lambda: torch.mm(xn.view(rows,dim),pw.t(),out=proj.view(rows,5*H),out_dtype=f16))
 t3=ev(lambda: s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8))
 return t1+t2+t3, (t1,t2,t3)
for case in [(2,256,384,False),(1,768,384,False),(1,1024,384,True)]:
 print('CASE',case,flush=True); data=make(*case)
 # compile all once
 try:
  print('old',bench_old(data),flush=True)
  for BM in [16,32,64,128]:
   for BH in [16,32,64]:
    if 128 % BH: continue
    nw=4 if BM<=64 else 8
    try:
     t=bench_fused(data,BM,BH,nw); print('fused BM BH nw',BM,BH,nw,t,flush=True)
    except Exception as e: print('err',BM,BH,e,flush=True)
 except Exception as e: print('ERR case',e,flush=True)
 del data; torch.cuda.empty_cache()

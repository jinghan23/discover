 return min(ts),sum(ts)/len(ts)
for B,N,H in [(2,256,128),(1,768,128),(1,1024,128)]:
 rows=B*N*N; n2=N*N; print('CASE',B,N,flush=True); proj=torch.randn(rows,5*H,device='cuda',dtype=torch.float16); mask=torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32); left=torch.empty(B*H,N,N,device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty(B,N,N,H,device='cuda',dtype=torch.float16)

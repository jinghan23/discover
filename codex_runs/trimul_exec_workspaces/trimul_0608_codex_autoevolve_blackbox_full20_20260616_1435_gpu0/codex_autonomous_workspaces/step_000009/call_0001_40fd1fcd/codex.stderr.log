import torch, math, triton
import submission as s
# Reuse custom to populate out_h then benchmark only final path by doing full trace-ish

def make(B,N,dim,nomask):
 H=128; torch.manual_seed(4); x=torch.randn(B,N,N,dim,device='cuda'); mask=None if nomask else torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32)
 w={'norm.weight':torch.ones(dim,device='cuda'),'norm.bias':torch.zeros(dim,device='cuda'), 'to_out_norm.weight':torch.ones(H,device='cuda'),'to_out_norm.bias':torch.zeros(H,device='cuda')}
 for k,shape in [('left_proj.weight',(H,dim)),('right_proj.weight',(H,dim)),('left_gate.weight',(H,dim)),('right_gate.weight',(H,dim)),('out_gate.weight',(H,dim)),('to_out.weight',(dim,H))]: w[k]=torch.empty(shape,device='cuda').uniform_(-1/math.sqrt(shape[1]),1/math.sqrt(shape[1]))
 return x,mask,w,{'dim':dim,'hidden_dim':H,'nomask':nomask}

def ev(fn, reps=5):
 # warm
 fn(); torch.cuda.synchronize(); ts=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
 return min(ts),sum(ts)/len(ts)

def prepare(data):
 x,mask,w,c=data; B=x.shape[0];N=x.shape[1];dim=c['dim'];H=128;rows=B*N*N;n2=N*N;device=x.device;key=(device,B,N,dim,H,'prep');f16=torch.float16;f32=torch.float32;nomask=bool(c.get('nomask')) or mask is None;mask_arg=x if mask is None else mask
 left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device); og=s._buf(key,'out_gate',(B,N,N,H),f16,device); xn=s._buf(key,'x_norm',x.shape,f16,device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,device); pw=s._proj_weight(w,f16,dim,H)
 s._input_ln384_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,rows=rows,BLOCK_R=1,num_warps=1)
 torch.mm(xn.view(rows,dim),pw.t(),out=proj.view(rows,5*H),out_dtype=f16)
 s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,device); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16); torch.cuda.synchronize()
 return out_h.view(B,H,N,N),og,key,rows,n2
for case in [(2,256,384,False),(1,768,384,False),(1,1024,384,True)]:
 print('CASE',case,flush=True); data=make(*case); x,mask,w,c=data; B=x.shape[0];N=x.shape[1];dim=c['dim'];H=128;device=x.device;f16=torch.float16;f32=torch.float32
 out_h,og,key,rows,n2=prepare(data); out=s._buf(key,'out',x.shape,f32,device)
 tw=s._to_out_weight_t(w,f16)
 print('fused', ev(lambda: s._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h,og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),tw,out,rows=rows,n2=n2,H=H,D=dim,BLOCK_R=128,BLOCK_D=64,num_warps=4)), flush=True)
 gated=s._buf(key,'gated',(B,N,N,H),f32,device)
 print('tile+mm', ev(lambda: (s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h,og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4), torch.mm(gated.view(rows,H),w['to_out.weight'].to(f32).t(),out=out.view(rows,dim)))), flush=True)
 # separate sub times
 print('tile only', ev(lambda: s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h,og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)), flush=True)
 print('mm only', ev(lambda: torch.mm(gated.view(rows,H),w['to_out.weight'].to(f32).t(),out=out.view(rows,dim))), flush=True)
 del data,out_h,og,out,gated; torch.cuda.empty_cache()

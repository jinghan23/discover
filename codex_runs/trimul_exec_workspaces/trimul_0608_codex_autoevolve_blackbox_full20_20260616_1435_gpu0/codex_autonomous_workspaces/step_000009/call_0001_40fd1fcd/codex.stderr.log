/bin/bash -lc "python - <<'PY'
import torch, time, math, importlib
import submission

def make_case(B,N,dim,nomask,dist):
    H=128
    torch.manual_seed(123)
    if dist=='cauchy':
        x=torch.distributions.Cauchy(torch.tensor(0.,device='cuda'),torch.tensor(2.,device='cuda')).sample((B,N,N,dim))
    else:
        x=torch.randn(B,N,N,dim,device='cuda')
    mask=None if nomask else torch.randint(0,2,(B,N,N),device='cuda',dtype=torch.float32)
    weights={'norm.weight':torch.ones(dim,device='cuda'),'norm.bias':torch.zeros(dim,device='cuda'),
             'to_out_norm.weight':torch.ones(H,device='cuda'),'to_out_norm.bias':torch.zeros(H,device='cuda')}
    for k,shape in [('left_proj.weight',(H,dim)),('right_proj.weight',(H,dim)),('left_gate.weight',(H,dim)),('right_gate.weight',(H,dim)),('out_gate.weight',(H,dim)),('to_out.weight',(dim,H))]:
        bound=1/math.sqrt(shape[1]); weights[k]=torch.empty(shape,device='cuda').uniform_(-bound,bound)
    return (x,mask,weights,{'dim':dim,'hidden_dim':H,'nomask':nomask})

def bench(case, iters=8):
    # one compile/warm
    y=submission.custom_kernel(case); torch.cuda.synchronize()
    times=[]
    for _ in range(iters):
        start=torch.cuda.Event(enable_timing=True); end=torch.cuda.Event(enable_timing=True)
        start.record(); y=submission.custom_kernel(case); end.record(); end.synchronize()
        times.append(start.elapsed_time(end)*1000)
    return min(times), sum(times)/len(times)

cases=[(2,256,128,True,'normal'),(1,768,128,True,'cauchy'),(2,256,384,False,'normal'),(1,512,128,True,'normal'),(1,1024,128,True,'cauchy'),(1,768,384,False,'normal'),(1,1024,384,True,'normal')]
for c in cases:
    print('case',c, flush=True)
    data=make_case(*c)

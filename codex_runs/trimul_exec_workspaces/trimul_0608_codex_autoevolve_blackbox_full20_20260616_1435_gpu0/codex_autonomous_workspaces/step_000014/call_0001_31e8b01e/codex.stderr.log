The local geometric mean matches the blackbox scale, so per-shape timing is useful. I’m profiling the largest `dim=128` and `dim=384` cases by timing the major stages with CUDA events to see which stage still has room.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

torch.manual_seed(1)

def evtime(fn):
    torch.cuda.synchronize()
    st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    st.record(); r=fn(); en.record(); en.synchronize()
    return st.elapsed_time(en)*1000, r

def weights(D,H):
    return {
      'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda'),
      'to_out_norm.weight': torch.randn(H,device='cuda'), 'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda'),
    }

def profile128(N=1024):
    B,D,H=1,128,128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32; dev='cuda'
    x=torch.randn((B,N,N,D),device=dev); w=weights(D,H); cfg=(dev,B,N,D,H); mask_arg=x; nomask=True
    # warm full
    for _ in range(2): s.custom_kernel((x,None,w,{'dim':D,'hidden_dim':H,'seqlen':N,'bs':B,'nomask':True}))
    torch.cuda.synchronize()
    out_gate=s._buf(cfg,'pg_out_gate',(B,N,N,H),f16,x.device)
    left_b=s._buf(cfg,'pg_left_b',(B*H,N,N),f16,x.device)
    right_b=s._buf(cfg,'pg_right_b',(B*H,N,N),f16,x.device)
    wl=s._buf(cfg,'pg_wl',(H,D),f16,x.device); wr=s._buf(cfg,'pg_wr',(H,D),f16,x.device); wlg=s._buf(cfg,'pg_wlg',(H,D),f16,x.device); wrg=s._buf(cfg,'pg_wrg',(H,D),f16,x.device); wog=s._buf(cfg,'pg_wog',(H,D),f16,x.device)
    def proj():
        wl.copy_(w['left_proj.weight']); wr.copy_(w['right_proj.weight']); wlg.copy_(w['left_gate.weight']); wrg.copy_(w['right_gate.weight']); wog.copy_(w['out_gate.weight'])
        s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,mask_arg,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1)
    t,_=evtime(proj)
    to_out=s._buf(cfg,'pg_to_out',(H,D),f16,x.device)
    tcopy,_=evtime(lambda: to_out.copy_(w['to_out.weight'].t()))
    out_h=s._buf(cfg,'pg_out_h',(B*H,N,N),f16,x.device)
    tbmm,_=evtime(lambda: torch.bmm(left_b,right_b.transpose(1,2),out=out_h))
    out=s._buf(cfg,'pg_out',(B,N,N,D),f32,x.device)
    tout,_=evtime(lambda: s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),out_gate,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to_out,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4))
    print('128 N',N,'proj',t,'copy',tcopy,'bmm',tbmm,'out',tout,'sum',t+tcopy+tbmm+tout)

def profile384(N=1024,mask=False):
    B,D,H=1,384,128; rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32; dev='cuda'
    x_in=torch.randn((B,N,N,D),device=dev); m=None if not mask else (torch.rand((B,N,N),device=dev)>0.2).float(); w=weights(D,H); cfg=(x_in.device,B,N,D,H); mask_arg=x_in if m is None else m; nomask=m is None
    for _ in range(2): s.custom_kernel((x_in,m,w,{'dim':D,'hidden_dim':H,'seqlen':N,'bs':B,'nomask':nomask}))
    torch.cuda.synchronize()
    x=s._buf(cfg,'pg_x_norm',x_in.shape,f16,x_in.device); in_rows=x.numel()//D
    ln_br=32 if N>=1024 else 8
    ln_w=4 if N>=1024 else 1
    tln,_=evtime(lambda: s._input_ln384_kernel[(triton.cdiv(in_rows,ln_br),)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=in_rows,BLOCK_R=ln_br,num_warps=ln_w))
    proj_w=s._buf(cfg,'pg_proj_w',(5*H,D),f16,x_in.device)
    def catmm():
        torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
        proj=s._buf(cfg,'pg_proj',(B,N,N,5*H),f16,x_in.device)
        torch.mm(x.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
        return proj
    tmm,proj=evtime(catmm)
    left_b=s._buf(cfg,'pg_left_b',(B*H,N,N),f16,x_in.device); right_b=s._buf(cfg,'pg_right_b',(B*H,N,N),f16,x_in.device)
    if nomask:
        tpost,_=evtime(lambda: s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left_b,right_b,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8))
    else:
        tpost,_=evtime(lambda: s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,mask_arg,left_b,right_b,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=32,BLOCK_H=64,num_warps=8))
    to_out=s._buf(cfg,'pg_to_out',(H,D),f16,x_in.device)
    tcopy,_=evtime(lambda: to_out.copy_(w['to_out.weight'].t()))
    out_h=s._buf(cfg,'pg_out_h',(B*H,N,N),f16,x_in.device)
    tbmm,_=evtime(lambda: torch.bmm(left_b,right_b.transpose(1,2),out=out_h))
    out=s._buf(cfg,'pg_out',(B,N,N,D),f32,x_in.device)
    tout,_=evtime(lambda: s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h.view(B,H,N,N),proj,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to_out,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4))
    print('384 N',N,'mask',mask,'ln',tln,'mm',tmm,'post',tpost,'copy',tcopy,'bmm',tbmm,'out',tout,'sum',tln+tmm+tpost+tcopy+tbmm+tout)


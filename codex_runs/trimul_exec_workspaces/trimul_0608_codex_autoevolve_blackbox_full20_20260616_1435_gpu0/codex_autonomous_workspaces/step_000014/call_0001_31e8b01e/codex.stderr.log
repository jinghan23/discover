Another possible `dim=384` tradeoff is moving the output-gate sigmoid into the post-processing kernel. I’m testing just the final-kernel side locally: precomputed sigmoid gate buffer versus reading gate logits from the projection tensor.
exec
/bin/bash -lc "python - <<'PY'
import torch,triton
import submission as s
B,N,H,D=1,1024,128,384; rows=B*N*N; n2=N*N
out_h=torch.randn((B,H,N,N),device='cuda',dtype=torch.float16)
proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16)
gate=torch.sigmoid(torch.randn((B,N,N,H),device='cuda',dtype=torch.float16))
w=torch.randn(H,device='cuda'); b=torch.randn(H,device='cuda'); ow=torch.randn(H,D,device='cuda',dtype=torch.float16)
out=torch.empty((B,N,N,D),device='cuda')
for _ in range(3):
 s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
 s._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h,gate,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
print('proj_gate', [round(time(lambda: s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)),1) for _ in range(5)])
print('sig_gate', [round(time(lambda: s._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h,gate,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)),1) for _ in range(5)])

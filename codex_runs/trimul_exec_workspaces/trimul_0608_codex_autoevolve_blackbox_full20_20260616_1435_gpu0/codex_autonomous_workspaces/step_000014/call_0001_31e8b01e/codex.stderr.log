codex
The triangular `bmm` is another major stage. I’m comparing PyTorch’s `bmm` and `matmul` locally to see whether a different frontend call hits a faster cuBLAS path.
exec
/bin/bash -lc "python - <<'PY'
import torch
H,N=128,1024
left=torch.randn((H,N,N),device='cuda',dtype=torch.float16)
right=torch.randn((H,N,N),device='cuda',dtype=torch.float16)
out=torch.empty_like(left)
for _ in range(3):
 torch.bmm(left,right.transpose(1,2),out=out)
 y=torch.matmul(left,right.transpose(1,2))
torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
print('bmm out', [round(time(lambda: torch.bmm(left,right.transpose(1,2),out=out)),1) for _ in range(6)])
print('matmul new', [round(time(lambda: torch.matmul(left,right.transpose(1,2))),1) for _ in range(6)])
print('bmm new', [round(time(lambda: torch.bmm(left,right.transpose(1,2))),1) for _ in range(6)])

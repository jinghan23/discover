 @triton.jit
+def _ln_proj_gate_tile_f16_kernel(
+    x_ptr,
+    proj_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, BLOCK_H)
+    valid_r = offs_r < rows
+    valid_h = offs_h < H
+    valid = valid_r[:, None] & valid_h[None, :]
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid, other=0.0).to(tl.float32)
+    mean = tl.sum(tl.where(valid_h[None, :], x, 0.0), axis=1) / H
+    xc = tl.where(valid_h[None, :], x - mean[:, None], 0.0)
+    var = tl.sum(xc * xc, axis=1) / H
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(w_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    nb = tl.load(b_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    og = tl.load(
+        proj_ptr + offs_r[:, None] * (5 * H) + (4 * H + offs_h)[None, :],
+        mask=valid,
+        other=0.0,
+    ).to(tl.float32)
+    y = ((xc * rstd[:, None] * nw[None, :] + nb[None, :]) * tl.sigmoid(og)).to(tl.float16)
+    tl.store(y_ptr + offs_r[:, None] * H + offs_h[None, :], y, mask=valid)

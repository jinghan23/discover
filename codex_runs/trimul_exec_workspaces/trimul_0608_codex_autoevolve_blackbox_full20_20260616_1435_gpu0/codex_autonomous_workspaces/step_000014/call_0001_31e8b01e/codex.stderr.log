torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
for br in [16,32,64,128]:
  for warps in [4,8]:
    vals=[time(lambda br=br,warps=warps: post_t_noog[(triton.cdiv(rows,br),triton.cdiv(H,64))](proj,mask,left,right,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=br,BLOCK_H=64,num_warps=warps)) for _ in range(3)]
    print('t_noog br',br,'warps',warps,vals)
print('orig', [time(lambda: s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8)) for _ in range(5)])

]
torch.manual_seed(2)
for cfg in cases:
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']
    torch.cuda.empty_cache()
    x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float32)
    mask=None if cfg['nomask'] else (torch.rand((B,N,N),device='cuda')>0.2).float()

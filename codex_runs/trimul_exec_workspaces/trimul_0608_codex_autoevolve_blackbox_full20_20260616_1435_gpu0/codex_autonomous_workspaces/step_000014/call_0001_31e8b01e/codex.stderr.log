/bin/bash -lc "python - <<'PY'
import time, torch
import submission
cases=[
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True},
]
torch.manual_seed(0)
for cfg in cases:
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']
    torch.cuda.empty_cache()
    x=torch.randn((B,N,N,D),device='cuda',dtype=torch.float32)
    mask=None if cfg['nomask'] else (torch.rand((B,N,N),device='cuda')>0.2).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
      'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'),
      'out_gate.weight': torch.randn(H,D,device='cuda'),
      'to_out_norm.weight': torch.randn(H,device='cuda'), 'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    data=(x,mask,weights,cfg)
    for _ in range(3):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(8):
        start=torch.cuda.Event(True); end=torch.cuda.Event(True)
        start.record(); y=submission.custom_kernel(data); end.record(); end.synchronize()
        times.append(start.elapsed_time(end)*1000)
    print(cfg, 'median_us', sorted(times)[len(times)//2], 'all', [round(t,1) for t in times])

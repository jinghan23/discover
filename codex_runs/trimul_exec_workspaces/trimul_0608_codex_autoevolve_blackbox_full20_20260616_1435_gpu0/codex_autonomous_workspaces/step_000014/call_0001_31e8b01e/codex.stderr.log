The `bmm` uses a transposed view of `right_b`. I’m checking whether a physically transposed right operand would make the GEMM itself faster enough to justify changing the post-processing store layout.
exec
/bin/bash -lc "python - <<'PY'
import torch
H,N=128,1024
left=torch.randn((H,N,N),device='cuda',dtype=torch.float16)
right=torch.randn((H,N,N),device='cuda',dtype=torch.float16)
right_t=right.transpose(1,2).contiguous()
out=torch.empty_like(left)
for _ in range(3):
 torch.bmm(left,right.transpose(1,2),out=out)
 torch.bmm(left,right_t,out=out)
torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
print('view transposed B', [round(time(lambda: torch.bmm(left,right.transpose(1,2),out=out)),1) for _ in range(6)])
print('contig B', [round(time(lambda: torch.bmm(left,right_t,out=out)),1) for _ in range(6)])

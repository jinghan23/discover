The `dim=384` projection GEMM is the largest single stage. I’m testing whether giving `torch.mm` a contiguous transposed weight matrix is faster than the current contiguous `[5H, D]` weight plus `.t()` view.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
B,N,D,H=1,1024,384,128; rows=B*N*N
x=torch.randn((rows,D),device='cuda',dtype=torch.float16)
weights=[torch.randn((H,D),device='cuda') for _ in range(5)]
proj=torch.empty((rows,5*H),device='cuda',dtype=torch.float16)
proj_w=torch.empty((5*H,D),device='cuda',dtype=torch.float16)
proj_wt=torch.empty((D,5*H),device='cuda',dtype=torch.float16)

def cur():
 torch.cat(tuple(weights),dim=0,out=proj_w)
 torch.mm(x,proj_w.t(),out=proj,out_dtype=torch.float16)

def wt():
 for i,w in enumerate(weights):
  proj_wt[:,i*H:(i+1)*H].copy_(w.t())
 torch.mm(x,proj_wt,out=proj,out_dtype=torch.float16)
for _ in range(3): cur(); wt()
torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
print('cur', [round(time(cur),1) for _ in range(6)])
print('wt', [round(time(wt),1) for _ in range(6)])

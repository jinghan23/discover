/bin/bash -lc "python - <<'PY'
import torch
H=D=128
weights=[torch.randn((H,D),device='cuda') for _ in range(5)]
bufs=[torch.empty((H,D),device='cuda',dtype=torch.float16) for _ in range(5)]
catbuf=torch.empty((5*H,D),device='cuda',dtype=torch.float16)
def copies():
 for b,w in zip(bufs,weights): b.copy_(w)
def cat():
 torch.cat(tuple(weights),dim=0,out=catbuf)
for _ in range(5): copies(); cat()
torch.cuda.synchronize()
def time(fn):
 st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); return st.elapsed_time(en)*1000
print('copies', [round(time(copies),2) for _ in range(10)])
print('cat', [round(time(cat),2) for _ in range(10)])

B,H,N=1,4,8
left=torch.randn(B,H,N,N,device='cuda',dtype=torch.float16)
right=torch.randn(B,H,N,N,device='cuda',dtype=torch.float16)
out_nh=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
out_view=out_nh.as_strided((B,H,N,N),(N*N*H,1,N*H,H))

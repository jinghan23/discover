/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s

torch.manual_seed(7)

def ev(): e=torch.cuda.Event(True); e.record(); return e

def bench_post(N,B,mask):
    H=128; rows=B*N*N; n2=N*N; proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16); left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); m=(torch.rand((B,N,N),device='cuda')>.15).float()
    print('post N',N,'B',B,'mask',mask)
    for br in [8,16,32,64]:
      for bh in [32,64,128]:
        if H%bh: continue
        for nw in [1,2,4,8]:
          try:
            if mask:
              s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,m,left,right,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
            else:
              s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
            torch.cuda.synchronize(); a=ev()
            for _ in range(5):
              if mask:
                s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,m,left,right,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
              else:
                s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,br),triton.cdiv(H,bh))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=br,BLOCK_H=bh,num_warps=nw)
            b=ev(); torch.cuda.synchronize(); print(' br',br,'bh',bh,'w',nw,'us',round(a.elapsed_time(b)*1000/5,2))
          except Exception as e:
            print(' br',br,'bh',bh,'w',nw,'ERR',type(e).__name__,str(e)[:40])
for c in [(256,2,True),(768,1,True),(1024,1,False)]:
  torch.cuda.empty_cache(); bench_post(*c); torch.cuda.empty_cache()

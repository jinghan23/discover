import torch, triton, submission as s

torch.manual_seed(2)

def make(case):
    B,N,D,H=case['bs'],case['seqlen'],case['dim'],case['hidden_dim']
    x=torch.randn((B,N,N,D),device='cuda')
    m=torch.ones((B,N,N),device='cuda') if case['nomask'] else (torch.rand((B,N,N),device='cuda')>0.15).float()
    weights={
      'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
      'out_gate.weight':torch.randn(H,D,device='cuda'),
      'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
      'to_out.weight':torch.randn(D,H,device='cuda')}
    return x,m,weights,case

def event():
    e=torch.cuda.Event(True); e.record(); return e

def profile_fused(case, bm=16, bh=32, nw=4):
    data=make(case); x,mask,weights,config=data
    # compile current and fused
    s.custom_kernel(data); torch.cuda.synchronize()
    B,N,D,H=x.shape[0],x.shape[1],case['dim'],case['hidden_dim']; rows=B*N*N; n2=N*N; device=x.device; f16=torch.float16; f32=torch.float32
    key=(device,B,N,D,H); nomask=case['nomask']; mask_arg=x if mask is None else mask
    left_b=s._buf(key,'left_b',(B*H,N,N),f16,device); right_b=s._buf(key,'right_b',(B*H,N,N),f16,device); out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device)
    wl=s._buf(key,'wl',(H,D),f16,device); wr=s._buf(key,'wr',(H,D),f16,device); wlg=s._buf(key,'wlg',(H,D),f16,device); wrg=s._buf(key,'wrg',(H,D),f16,device); wog=s._buf(key,'wog',(H,D),f16,device)
    wl.copy_(weights['left_proj.weight']); wr.copy_(weights['right_proj.weight']); wlg.copy_(weights['left_gate.weight']); wrg.copy_(weights['right_gate.weight']); wog.copy_(weights['out_gate.weight'])
    # warm fused
    for _ in range(2):
        s._fused_proj384_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw,num_stages=1)
    torch.cuda.synchronize()
    ev=[event()]
    s._fused_proj384_4q_kernel[(triton.cdiv(rows,bm),)](x,mask_arg,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left_b,right_b,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw,num_stages=1)
    ev.append(event())
    out_h_flat=s._buf(key,'out_h',(B*H,N,N),f16,device); torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat)
    ev.append(event())
    to_out_h_t=s._buf(key,'to_out_h_t',(H,D),f16,device); to_out_h_t.copy_(weights['to_out.weight'].t())
    out=s._buf(key,'out',x.shape,f32,device); out_h=out_h_flat.view(B,H,N,N)
    br=128
    s._ln_gate_out_kernel[(triton.cdiv(rows,br),)](out_h,out_gate,weights['to_out_norm.weight'].to(f32),weights['to_out_norm.bias'].to(f32),to_out_h_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=64,num_warps=4)
    ev.append(event()); torch.cuda.synchronize()
    print('case',case,'bm/bh/warps',bm,bh,nw,'proj',round(ev[0].elapsed_time(ev[1])*1000,2),'bmm',round(ev[1].elapsed_time(ev[2])*1000,2),'final',round(ev[2].elapsed_time(ev[3])*1000,2),'total',round(ev[0].elapsed_time(ev[3])*1000,2))
    return data

for c in [
 {'seqlen':256,'bs':2,'dim':384,'hidden_dim':128,'nomask':False},
 {'seqlen':768,'bs':1,'dim':384,'hidden_dim':128,'nomask':False},
 {'seqlen':1024,'bs':1,'dim':384,'hidden_dim':128,'nomask':True},
]:
    for params in [(16,32,4),(32,32,4),(16,64,4),(8,32,4)]:
        torch.cuda.empty_cache(); profile_fused(c,*params); torch.cuda.empty_cache()

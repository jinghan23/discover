import torch, triton, submission as s

torch.manual_seed(3)

def make(case):
    B,N,D,H=case['bs'],case['seqlen'],case['dim'],case['hidden_dim']
    if case.get('distribution')=='cauchy':
        x=torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda()
    else:
        x=torch.randn((B,N,N,D),device='cuda')
    m=torch.ones((B,N,N),device='cuda')
    weights={
      'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
      'out_gate.weight':torch.randn(H,D,device='cuda'),
      'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
      'to_out.weight':torch.randn(D,H,device='cuda')}
    return x,m,weights,case

def ev(): e=torch.cuda.Event(True); e.record(); return e

def profile(case):
    data=make(case)
    for _ in range(3): s.custom_kernel(data)
    torch.cuda.synchronize()
    x,mask,weights,config=data; B,N,D,H=x.shape[0],x.shape[1],128,128; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H)
    left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev); og=s._buf(key,'out_gate',(B,N,N,H),f16,dev)
    wl=s._buf(key,'wl',(H,D),f16,dev); wr=s._buf(key,'wr',(H,D),f16,dev); wlg=s._buf(key,'wlg',(H,D),f16,dev); wrg=s._buf(key,'wrg',(H,D),f16,dev); wog=s._buf(key,'wog',(H,D),f16,dev)
    wl.copy_(weights['left_proj.weight']); wr.copy_(weights['right_proj.weight']); wlg.copy_(weights['left_gate.weight']); wrg.copy_(weights['right_gate.weight']); wog.copy_(weights['out_gate.weight'])
    evs=[ev()]
    s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,mask,weights['norm.weight'].to(f32),weights['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1)
    evs.append(ev())
    tow=s._buf(key,'to_out_h_t',(H,D),f16,dev); tow.copy_(weights['to_out.weight'].t())
    evs.append(ev())
    oh=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=oh)
    evs.append(ev())
    out=s._buf(key,'out',x.shape,f32,dev)
    s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,64),)](oh.view(B,H,N,N),og,weights['to_out_norm.weight'].to(f32),weights['to_out_norm.bias'].to(f32),tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4)
    evs.append(ev()); torch.cuda.synchronize()
    labs=['proj','tow_copy','bmm','final']
    print('case',case)
    tot=0
    for lab,a,b in zip(labs,evs,evs[1:]):
        t=a.elapsed_time(b)*1000; tot+=t; print(lab,round(t,2))
    print('total',round(tot,2))
for c in [

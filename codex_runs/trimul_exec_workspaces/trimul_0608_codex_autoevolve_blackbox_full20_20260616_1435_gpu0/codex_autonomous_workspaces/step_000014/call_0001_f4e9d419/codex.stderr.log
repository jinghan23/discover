   477	    xc = x - mean[:, None]
   478	    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
   479	    rstd = tl.rsqrt(var + 1.0e-5)
   480	    nw = tl.load(norm_w_ptr + offs_d).to(tl.float32)
   481	    nb = tl.load(norm_b_ptr + offs_d).to(tl.float32)
   482	    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
   483	
   484	    m = tl.full((BLOCK_M,), 1.0, tl.float32)
   485	    if not NOMASK:

/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s

torch.manual_seed(5)

def weights(D,H):
    return {
      'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
      'out_gate.weight':torch.randn(H,D,device='cuda'),
      'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
      'to_out.weight':torch.randn(D,H,device='cuda')}

def ev(): e=torch.cuda.Event(True); e.record(); return e

def prep_dim384(N, B=1, mask=False):
    D=384; H=128; x=torch.randn((B,N,N,D),device='cuda'); m=(torch.rand((B,N,N),device='cuda')>.15).float() if mask else torch.ones((B,N,N),device='cuda'); w=weights(D,H); cfg={'dim':D,'hidden_dim':H,'nomask':not mask}
    s.custom_kernel((x,m,w,cfg)); torch.cuda.synchronize()
    key=(x.device,B,N,D,H); rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
    # produce out_h and proj via current path once
    xn=s._buf(key,'x_norm',x.shape,f16,x.device); br_ln=8 if N>=768 else 2
    if N>=1024: br_ln=32; nw=4
    else: nw=1
    s._input_ln384_kernel[(triton.cdiv(rows,br_ln),)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,rows=rows,BLOCK_R=br_ln,num_warps=nw)
    left=s._buf(key,'left_b',(B*H,N,N),f16,x.device); right=s._buf(key,'right_b',(B*H,N,N),f16,x.device); projw=s._buf(key,'proj_w',(5*H,D),f16,x.device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,x.device)
    torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=projw)
    torch.mm(xn.view(rows,D),projw.t(),out=proj.view(rows,5*H),out_dtype=f16)
    if mask:
        s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,m,left,right,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=32,BLOCK_H=64,num_warps=8)
    else:
        s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8)
    oh=s._buf(key,'out_h',(B*H,N,N),f16,x.device); torch.bmm(left,right.transpose(1,2),out=oh)
    tow=s._buf(key,'to_out_h_t',(H,D),f16,x.device); tow.copy_(w['to_out.weight'].t()); out=s._buf(key,'out',x.shape,torch.float32,x.device)
    torch.cuda.synchronize(); return oh.view(B,H,N,N),proj,w,tow,out,rows,n2,H,D

def bench_final384(N, mask=False):
    oh,proj,w,tow,out,rows,n2,H,D=prep_dim384(N, mask=mask)
    print('final384 N',N,'mask',mask)
    for br in [64,128,256]:
      for bd in [32,64,128]:
        if D%bd: continue
        try:
          # compile/warm
          s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,br),)](oh,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
          torch.cuda.synchronize(); a=ev();
          for _ in range(3): s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,br),)](oh,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
          b=ev(); torch.cuda.synchronize(); print(' br',br,'bd',bd,'us',round(a.elapsed_time(b)*1000/3,2))
        except Exception as e:
          print(' br',br,'bd',bd,'ERR',type(e).__name__,str(e)[:80])

def prep_dim128(N,B=1):
    D=128;H=128; x=torch.randn((B,N,N,D),device='cuda'); m=torch.ones((B,N,N),device='cuda'); w=weights(D,H); cfg={'dim':D,'hidden_dim':H,'nomask':True}; s.custom_kernel((x,m,w,cfg)); torch.cuda.synchronize(); key=(x.device,B,N,D,H); rows=B*N*N;n2=N*N;f16=torch.float16;f32=torch.float32
    left=s._buf(key,'left_b',(B*H,N,N),f16,x.device); right=s._buf(key,'right_b',(B*H,N,N),f16,x.device); og=s._buf(key,'out_gate',(B,N,N,H),f16,x.device)
    wl=s._buf(key,'wl',(H,D),f16,x.device); wr=s._buf(key,'wr',(H,D),f16,x.device); wlg=s._buf(key,'wlg',(H,D),f16,x.device); wrg=s._buf(key,'wrg',(H,D),f16,x.device); wog=s._buf(key,'wog',(H,D),f16,x.device)
    wl.copy_(w['left_proj.weight']); wr.copy_(w['right_proj.weight']); wlg.copy_(w['left_gate.weight']); wrg.copy_(w['right_gate.weight']); wog.copy_(w['out_gate.weight'])
    s._fused_proj128_4q_kernel[(triton.cdiv(rows,64),)](x,m,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1)
    oh=s._buf(key,'out_h',(B*H,N,N),f16,x.device); torch.bmm(left,right.transpose(1,2),out=oh); tow=s._buf(key,'to_out_h_t',(H,D),f16,x.device); tow.copy_(w['to_out.weight'].t()); out=s._buf(key,'out',x.shape,torch.float32,x.device); torch.cuda.synchronize(); return oh.view(B,H,N,N),og,w,tow,out,rows,n2,H,D

def bench_final128(N,B=1):
    oh,og,w,tow,out,rows,n2,H,D=prep_dim128(N,B)
    print('final128 N',N,'B',B)
    for br in [32,64,128,256]:
      for bd in [16,32,64]:
        if D%bd: continue
        try:
          s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,br),)](oh,og,w['to_out_norm.weight'],w['to_out_norm.bias'],tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
          torch.cuda.synchronize(); a=ev();
          for _ in range(5): s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,br),)](oh,og,w['to_out_norm.weight'],w['to_out_norm.bias'],tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=br,BLOCK_D=bd,num_warps=4)
          b=ev(); torch.cuda.synchronize(); print(' br',br,'bd',bd,'us',round(a.elapsed_time(b)*1000/5,2))
        except Exception as e:
          print(' br',br,'bd',bd,'ERR',type(e).__name__,str(e)[:80])

bench_final128(512,1)
bench_final128(1024,1)
bench_final384(768,mask=True)

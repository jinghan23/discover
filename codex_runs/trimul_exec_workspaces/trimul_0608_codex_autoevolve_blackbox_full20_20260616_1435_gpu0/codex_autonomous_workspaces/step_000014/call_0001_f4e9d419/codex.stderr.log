      'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
      'out_gate.weight':torch.randn(H,D,device='cuda'),
      'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
      'to_out.weight':torch.randn(D,H,device='cuda')}
    cfg={'dim':D,'hidden_dim':H,'nomask':True}
    return x,m,weights,cfg

def ev(): e=torch.cuda.Event(True); e.record(); return e

def prof(c):
    data=make(c); x,mask,w,config=data
    s.custom_kernel(data); torch.cuda.synchronize()
    B,N,D,H=x.shape[0],x.shape[1],128,128; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H)
    xn=s._buf(key,'x_norm',x.shape,f16,dev)
    left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev); og=s._buf(key,'out_gate',(B,N,N,H),f16,dev)
    projw=s._buf(key,'proj_w',(5*H,D),f16,dev); proj=s._buf(key,'proj',(B,N,N,5*H),f16,dev)
    for _ in range(2):
        s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,D=D,BLOCK=128,num_warps=1)
        torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=projw)
        torch.mm(xn.view(rows,D),projw.t(),out=proj.view(rows,5*H),out_dtype=f16)
        s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    torch.cuda.synchronize()
    evs=[ev()]
    s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,D=D,BLOCK=128,num_warps=1)
    evs.append(ev())
    torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=projw)
    torch.mm(xn.view(rows,D),projw.t(),out=proj.view(rows,5*H),out_dtype=f16)
    evs.append(ev())
    s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    evs.append(ev())
    oh=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=oh); evs.append(ev())
    tow=s._buf(key,'to_out_h_t',(H,D),f16,dev); tow.copy_(w['to_out.weight'].t())
    out=s._buf(key,'out',x.shape,f32,dev)
    s._ln_gate_out_kernel[(triton.cdiv(rows,64),)](oh.view(B,H,N,N),og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4)
    evs.append(ev()); torch.cuda.synchronize()
    labs=['ln','mm+cat','post','bmm','final']; print('split case',c)
    tot=0
    for lab,a,b in zip(labs,evs,evs[1:]):
        t=a.elapsed_time(b)*1000; tot+=t; print(lab,round(t,2))
    print('total',round(tot,2))
for c in [{'seqlen':256,'bs':2},{'seqlen':512,'bs':1},{'seqlen':768,'bs':1},{'seqlen':1024,'bs':1}]:
    torch.cuda.empty_cache(); prof(c); torch.cuda.empty_cache()

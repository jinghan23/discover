import torch, triton, submission as s

torch.manual_seed(1)

def make(case):
    B,N,D,H=case['bs'],case['seqlen'],case['dim'],case['hidden_dim']
    x=torch.randn((B,N,N,D),device='cuda')
    m=torch.ones((B,N,N),device='cuda') if case['nomask'] else (torch.rand((B,N,N),device='cuda')>0.15).float()
    weights={
      'norm.weight':torch.randn(D,device='cuda'), 'norm.bias':torch.randn(D,device='cuda'),
      'left_proj.weight':torch.randn(H,D,device='cuda'), 'right_proj.weight':torch.randn(H,D,device='cuda'),
      'left_gate.weight':torch.randn(H,D,device='cuda'), 'right_gate.weight':torch.randn(H,D,device='cuda'),
      'out_gate.weight':torch.randn(H,D,device='cuda'),
      'to_out_norm.weight':torch.randn(H,device='cuda'), 'to_out_norm.bias':torch.randn(H,device='cuda'),
      'to_out.weight':torch.randn(D,H,device='cuda')}
    return x,m,weights,case

def ev():
    e=torch.cuda.Event(enable_timing=True); e.record(); return e

def profile(case):
    data=make(case)
    # compile/warm
    for _ in range(3): s.custom_kernel(data)
    torch.cuda.synchronize()
    input_tensor, mask, weights, config=data
    dim=config['dim']; hidden_dim=config['hidden_dim']; B=input_tensor.shape[0]; N=input_tensor.shape[1]
    device=input_tensor.device; f16=torch.float16; f32=torch.float32; rows=B*N*N; n2=N*N
    buf_shape_key=(device,B,N,dim,hidden_dim); nomask=bool(config.get('nomask')) or mask is None; mask_arg=input_tensor if mask is None else mask
    times=[]; events=[]
    events.append(ev())
    x_in=input_tensor.contiguous()
    x=s._buf(buf_shape_key,'x_norm',input_tensor.shape,f16,device)
    in_rows=x.numel()//dim
    if dim==384:
        if N>=1024: ln_br=32; ln_warps=4
        elif N>=768: ln_br=8; ln_warps=1
        elif N==256: ln_br=2; ln_warps=1
        else: ln_br=1; ln_warps=1
        s._input_ln384_kernel[(triton.cdiv(in_rows,ln_br),)](x_in, weights['norm.weight'].to(f32), weights['norm.bias'].to(f32), x, rows=in_rows, BLOCK_R=ln_br, num_warps=ln_warps)
    events.append(ev())
    left_b=s._buf(buf_shape_key,'left_b',(B*hidden_dim,N,N),f16,device); right_b=s._buf(buf_shape_key,'right_b',(B*hidden_dim,N,N),f16,device)
    proj_w=s._buf(buf_shape_key,'proj_w',(5*hidden_dim,dim),f16,device)
    torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0,out=proj_w)
    proj=s._buf(buf_shape_key,'proj',(B,N,N,5*hidden_dim),f16,device)
    torch.mm(x.view(rows,dim), proj_w.t(), out=proj.view(rows,5*hidden_dim), out_dtype=f16)
    events.append(ev())
    if nomask:
        s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(hidden_dim,64))](proj,left_b,right_b,rows=rows,n2=n2,H=hidden_dim,BLOCK_R=32,BLOCK_H=64,num_warps=8)
    else:
        s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(hidden_dim,64))](proj,mask_arg,left_b,right_b,rows=rows,n2=n2,H=hidden_dim,NOMASK=nomask,BLOCK_R=32,BLOCK_H=64,num_warps=8)
    events.append(ev())
    to_out_h_t=s._buf(buf_shape_key,'to_out_h_t',(hidden_dim,dim),f16,device); to_out_h_t.copy_(weights['to_out.weight'].t())
    events.append(ev())
    out_h_flat=s._buf(buf_shape_key,'out_h',(B*hidden_dim,N,N),f16,device)
    torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat)
    events.append(ev())
    out_h=out_h_flat.view(B,hidden_dim,N,N); out=s._buf(buf_shape_key,'out',input_tensor.shape,f32,device)
    br=128
    s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,br),)](out_h,proj,weights['to_out_norm.weight'].to(f32),weights['to_out_norm.bias'].to(f32),to_out_h_t,out,rows=rows,n2=n2,H=hidden_dim,D=dim,BLOCK_R=br,BLOCK_D=64,num_warps=4)
    events.append(ev())
    torch.cuda.synchronize()
    labels=['ln','mm+cat','post','to_out_copy','bmm','final']
    print('case',case)
    total=0
    for lab,a,b in zip(labels,events,events[1:]):
        t=a.elapsed_time(b)*1000; total+=t; print(lab,round(t,2))
    print('total',round(total,2))


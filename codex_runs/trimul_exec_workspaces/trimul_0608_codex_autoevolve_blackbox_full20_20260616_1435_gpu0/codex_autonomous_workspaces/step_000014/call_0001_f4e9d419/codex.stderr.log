/bin/bash -lc "python - <<'PY'
import torch, triton, submission as s

torch.manual_seed(6)

def ev(): e=torch.cuda.Event(True); e.record(); return e

def bench_ln(D,N,B,brs,warps=(1,2,4,8)):
    x=torch.randn((B,N,N,D),device='cuda'); y=torch.empty_like(x,dtype=torch.float16); w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda'); rows=B*N*N
    print('LN D',D,'N',N,'B',B)
    for br in brs:
      for nw in warps:
        try:
          if D==384:
            s._input_ln384_kernel[(triton.cdiv(rows,br),)](x,w,b,y,rows=rows,BLOCK_R=br,num_warps=nw)
          elif D==768:
            s._input_ln768_kernel[(triton.cdiv(rows,br),)](x,w,b,y,rows=rows,BLOCK_R=br,num_warps=nw)
          torch.cuda.synchronize(); a=ev()
          for _ in range(5):
            if D==384:
              s._input_ln384_kernel[(triton.cdiv(rows,br),)](x,w,b,y,rows=rows,BLOCK_R=br,num_warps=nw)
            else:
              s._input_ln768_kernel[(triton.cdiv(rows,br),)](x,w,b,y,rows=rows,BLOCK_R=br,num_warps=nw)
          c=ev(); torch.cuda.synchronize(); print(' br',br,'warps',nw,'us',round(a.elapsed_time(c)*1000/5,2))
        except Exception as e:
          print(' br',br,'warps',nw,'ERR',type(e).__name__,str(e)[:50])
for N,B in [(256,2),(768,1),(1024,1)]:
  torch.cuda.empty_cache(); bench_ln(384,N,B,[1,2,4,8,16,32,64],[1,2,4]); torch.cuda.empty_cache()

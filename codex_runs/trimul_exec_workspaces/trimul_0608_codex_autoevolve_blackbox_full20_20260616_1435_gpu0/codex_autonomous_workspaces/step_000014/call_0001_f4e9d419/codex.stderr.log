+    x = tl.load(x_ptr + offs_r[:, None] * H + offs_h[None, :], mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)

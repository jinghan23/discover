   443	@triton.jit
   444	def _post_proj_transpose_kernel(
   445	    proj_ptr,
   446	    mask_ptr,
   447	    left_ptr,
   448	    right_ptr,
   449	    out_gate_ptr,
   450	    rows: tl.constexpr,
   451	    n2: tl.constexpr,
   452	    H: tl.constexpr,
   453	    NOMASK: tl.constexpr,
   454	    BLOCK_R: tl.constexpr,
   455	    BLOCK_H: tl.constexpr,
   456	):
   457	    pid_r = tl.program_id(0)
   458	    pid_h = tl.program_id(1)
   459	    offs_r = pid_r * BLOCK_R + tl.arange(0, BLOCK_R)
   460	    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)


 'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
 'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'), 'out_gate.weight': torch.randn(H,D,device='cuda'),
}
rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32; key=(x.device,B,N,D,H)
xn=s._buf(key,'x_norm',x.shape,f16,x.device); proj=s._buf(key,'proj',(B,N,N,5*H),f16,x.device); left=s._buf(key,'left_b',(B*H,N,N),f16,x.device); right=s._buf(key,'right_b',(B*H,N,N),f16,x.device); og=s._buf(key,'out_gate',(B,N,N,H),f16,x.device); proj_w=s._proj_weight(w,f16,D,H)
wl,wr,wlg,wrg,wog=s._proj_parts(w,f16,D,H)

def run_fused():
 s._fused_proj128_4q_kernel[(triton.cdiv(rows,128),)](x,mask,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=128,BLOCK_H=32,num_warps=8)
def run_generic():
 s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,D=D,BLOCK=128,num_warps=1)
 torch.mm(xn.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
 s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=16,BLOCK_H=64,num_warps=8)
for name,fn in [('fused',run_fused),('generic',run_generic)]:

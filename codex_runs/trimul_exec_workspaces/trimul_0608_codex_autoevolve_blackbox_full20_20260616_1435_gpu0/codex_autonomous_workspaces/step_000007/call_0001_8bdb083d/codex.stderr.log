   141	@triton.jit
   142	def _ln_gate_tile_kernel(
   143	    x_ptr,
   144	    gate_ptr,
   145	    w_ptr,
   146	    b_ptr,
   147	    y_ptr,
   148	    rows: tl.constexpr,
   149	    n2: tl.constexpr,
   150	    H: tl.constexpr,
   151	    BLOCK_R: tl.constexpr,
   152	    BLOCK_H: tl.constexpr,
   153	):
   154	    pid = tl.program_id(0)
   155	    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
   156	    offs_h = tl.arange(0, BLOCK_H)
   157	    valid_r = offs_r < rows
   158	    valid_h = offs_h < H
   159	    valid = valid_r[:, None] & valid_h[None, :]
   160	    bidx = offs_r // n2
   161	    ij = offs_r - bidx * n2
   162	    x_addr = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]
   163	    x = tl.load(x_ptr + x_addr, mask=valid, other=0.0).to(tl.float32)
   164	    mean = tl.sum(tl.where(valid_h[None, :], x, 0.0), axis=1) / H
   165	    xc = tl.where(valid_h[None, :], x - mean[:, None], 0.0)
   166	    var = tl.sum(xc * xc, axis=1) / H
   167	    rstd = tl.rsqrt(var + 1.0e-5)
   168	    w = tl.load(w_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
   169	    b = tl.load(b_ptr + offs_h, mask=valid_h, other=0.0).to(tl.float32)
   170	    y_addr = offs_r[:, None] * H + offs_h[None, :]
   171	    g = tl.load(gate_ptr + y_addr, mask=valid, other=0.0).to(tl.float32)
   172	    y = (xc * rstd[:, None] * w[None, :] + b[None, :]) * g
   173	    tl.store(y_ptr + y_addr, y, mask=valid)
   174	

+        wr2 = tl.load(wr_ptr + w2offs)
+        wrg0 = tl.load(wrg_ptr + w0offs)
+        wrg1 = tl.load(wrg_ptr + w1offs)
+        wrg2 = tl.load(wrg_ptr + w2offs)

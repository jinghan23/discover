   239	@triton.jit
   240	def _input_ln_kernel(x_ptr, w_ptr, b_ptr, y_ptr, D: tl.constexpr, BLOCK: tl.constexpr):
   241	    row = tl.program_id(0)
   242	    offs = tl.arange(0, BLOCK)
   243	    mask = offs < D
   244	    base = row * D + offs
   245	    x = tl.load(x_ptr + base, mask=mask, other=0.0).to(tl.float32)
   246	    mean = tl.sum(tl.where(mask, x, 0.0), axis=0) / D
   247	    xc = tl.where(mask, x - mean, 0.0)
   248	    var = tl.sum(xc * xc, axis=0) / D
   249	    rstd = tl.rsqrt(var + 1.0e-5)
   250	    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)
   251	    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)
   252	    tl.store(y_ptr + base, xc * rstd * w + b, mask=mask)

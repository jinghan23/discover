+
+        wl0 = tl.load(wl_ptr + w0offs)
+        wl1 = tl.load(wl_ptr + w1offs)
+        wl2 = tl.load(wl_ptr + w2offs)
+        wlg0 = tl.load(wlg_ptr + w0offs)
+        wlg1 = tl.load(wlg_ptr + w1offs)
+        wlg2 = tl.load(wlg_ptr + w2offs)
+        l = tl.dot(xn0, wl0) + tl.dot(xn1, wl1) + tl.dot(xn2, wl2)
+        lg = tl.dot(xn0, wlg0) + tl.dot(xn1, wlg1) + tl.dot(xn2, wlg2)
+        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)

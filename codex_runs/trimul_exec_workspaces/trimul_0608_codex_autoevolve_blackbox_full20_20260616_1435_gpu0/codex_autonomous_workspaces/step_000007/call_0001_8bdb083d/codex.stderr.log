codex
I’ll profile the current dim-384 large case by stage with CUDA events. That should show whether the remaining time is projection, triangular `bmm`, postprocess, or final projection.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, gc
import submission as s

torch.manual_seed(1)
B,N,D,H=1,1024,384,128
x=torch.randn((B,N,N,D),device='cuda')
mask=torch.ones((B,N,N),device='cuda')
w={
 'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
 'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
 'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'), 'out_gate.weight': torch.randn(H,D,device='cuda'),
 'to_out_norm.weight': torch.randn(H,device='cuda'), 'to_out_norm.bias': torch.randn(H,device='cuda'), 'to_out.weight': torch.randn(D,H,device='cuda')}
config={'dim':D,'hidden_dim':H,'nomask':True}
# warm full
for _ in range(3): y=s.custom_kernel((x,mask,w,config))
torch.cuda.synchronize()
shape_key=(x.device,B,N,D,H); rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
x_in=x.contiguous(); norm_w=w['norm.weight']; norm_b=w['norm.bias']; out_norm_w=w['to_out_norm.weight']; out_norm_b=w['to_out_norm.bias']
out_gate=s._buf(shape_key,'out_gate',(B,N,N,H),f16,x.device); left_b=s._buf(shape_key,'left_b',(B*H,N,N),f16,x.device); right_b=s._buf(shape_key,'right_b',(B*H,N,N),f16,x.device)
xn=s._buf(shape_key,'x_norm',x.shape,f16,x.device); proj=s._buf(shape_key,'proj',(B,N,N,5*H),f16,x.device); proj_w=s._proj_weight(w,f16,D,H)
out_h_flat=s._buf(shape_key,'out_h',(B*H,N,N),f16,x.device); gated=s._buf(shape_key,'gated',(B,N,N,H),f16,x.device); out=s._buf(shape_key,'out',x.shape,f32,x.device); to_out=s._to_out_weight_t(w,f16)

def stage(name, fn, iters=10):
    for _ in range(2): fn()
    torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()
    for _ in range(iters): fn()
    b.record(); torch.cuda.synchronize(); print(name, a.elapsed_time(b)/iters)

stage('ln384', lambda: s._input_ln384_kernel[(rows,)](x_in,norm_w.to(f32),norm_b.to(f32),xn,rows=rows,BLOCK_R=1,num_warps=1), 10)
stage('proj_mm', lambda: torch.mm(xn.view(rows,D), proj_w.t(), out=proj.view(rows,5*H), out_dtype=f16), 10)
stage('post', lambda: s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left_b,right_b,out_gate,rows=rows,n2=n2,H=H,NOMASK=True,BLOCK_R=16,BLOCK_H=64,num_warps=8), 10)
stage('bmm', lambda: torch.bmm(left_b, right_b.transpose(1,2), out=out_h_flat, out_dtype=f16), 5)
out_h=out_h_flat.view(B,H,N,N)
stage('ln_gate', lambda: s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h,out_gate,out_norm_w.to(f32),out_norm_b.to(f32),gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4), 10)
stage('final_mm', lambda: torch.mm(gated.view(rows,H), to_out, out=out.view(rows,D), out_dtype=f32), 10)

config={'dim':D,'hidden_dim':H,'nomask':True}
for _ in range(5): y=s.custom_kernel((x,mask,w,config))
torch.cuda.synchronize(); shape_key=(x.device,B,N,D,H); rows=B*N*N; n2=N*N; f16=torch.float16; f32=torch.float32
out_gate=s._buf(shape_key,'out_gate',(B,N,N,H),f16,x.device); left=s._buf(shape_key,'left_b',(B*H,N,N),f16,x.device); right=s._buf(shape_key,'right_b',(B*H,N,N),f16,x.device); out_h=s._buf(shape_key,'out_h',(B*H,N,N),f16,x.device); gated=s._buf(shape_key,'gated',(B,N,N,H),f16,x.device); out=s._buf(shape_key,'out',x.shape,f32,x.device)
wl,wr,wlg,wrg,wog=s._proj_parts(w,f16,D,H); to=s._to_out_weight_t(w,f16)

def stage(name,fn,it=10):

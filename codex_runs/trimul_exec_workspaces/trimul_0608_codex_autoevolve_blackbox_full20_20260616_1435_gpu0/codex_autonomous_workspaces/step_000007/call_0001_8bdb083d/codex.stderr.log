import torch, triton
import submission as s
B,N,D,H=1,1024,128,128
for dist in ['normal','cauchy']:
 x=(torch.randn((B,N,N,D),device='cuda') if dist=='normal' else torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda().float())
 mask=torch.ones((B,N,N),device='cuda')
 w={
 'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
 'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
 'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'), 'out_gate.weight': torch.randn(H,D,device='cuda')}
 rows=B*N*N; n2=N*N; key=(x.device,B,N,D,H); left=s._buf(key,'left_b',(B*H,N,N),torch.float16,x.device); right=s._buf(key,'right_b',(B*H,N,N),torch.float16,x.device); og=s._buf(key,'out_gate',(B,N,N,H),torch.float16,x.device); wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)

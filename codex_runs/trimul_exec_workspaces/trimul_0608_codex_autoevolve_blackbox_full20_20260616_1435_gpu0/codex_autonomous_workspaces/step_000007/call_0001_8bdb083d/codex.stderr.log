   255	@triton.jit
   256	def _input_ln384_kernel(
   257	    x_ptr,
   258	    w_ptr,
   259	    b_ptr,
   260	    y_ptr,
   261	    rows: tl.constexpr,
   262	    BLOCK_R: tl.constexpr,
   263	):
   264	    pid = tl.program_id(0)
   265	    row = pid * BLOCK_R + tl.arange(0, BLOCK_R)
   266	    offs = tl.arange(0, 128)
   267	    valid = row < rows
   268	    base = row[:, None] * 384 + offs[None, :]
   269	    x0 = tl.load(x_ptr + base, mask=valid[:, None], other=0.0).to(tl.float32)
   270	    x1 = tl.load(x_ptr + base + 128, mask=valid[:, None], other=0.0).to(tl.float32)
   271	    x2 = tl.load(x_ptr + base + 256, mask=valid[:, None], other=0.0).to(tl.float32)
   272	    mean = (tl.sum(x0, axis=1) + tl.sum(x1, axis=1) + tl.sum(x2, axis=1)) * (1.0 / 384.0)
   273	    xc0 = x0 - mean[:, None]
   274	    xc1 = x1 - mean[:, None]
   275	    xc2 = x2 - mean[:, None]
   276	    var = (tl.sum(xc0 * xc0, axis=1) + tl.sum(xc1 * xc1, axis=1) + tl.sum(xc2 * xc2, axis=1)) * (1.0 / 384.0)
   277	    rstd = tl.rsqrt(var + 1.0e-5)
   278	    w0 = tl.load(w_ptr + offs).to(tl.float32)
   279	    b0 = tl.load(b_ptr + offs).to(tl.float32)
   280	    w1 = tl.load(w_ptr + offs + 128).to(tl.float32)
   281	    b1 = tl.load(b_ptr + offs + 128).to(tl.float32)
   282	    w2 = tl.load(w_ptr + offs + 256).to(tl.float32)
   283	    b2 = tl.load(b_ptr + offs + 256).to(tl.float32)
   284	    tl.store(y_ptr + base, xc0 * rstd[:, None] * w0[None, :] + b0[None, :], mask=valid[:, None])
   285	    tl.store(y_ptr + base + 128, xc1 * rstd[:, None] * w1[None, :] + b1[None, :], mask=valid[:, None])
   286	    tl.store(y_ptr + base + 256, xc2 * rstd[:, None] * w2[None, :] + b2[None, :], mask=valid[:, None])

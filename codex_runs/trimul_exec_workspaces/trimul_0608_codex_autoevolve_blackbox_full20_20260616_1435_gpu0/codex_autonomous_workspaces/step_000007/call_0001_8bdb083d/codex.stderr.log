   205	@triton.jit
   206	def _ln_gate_out128_kernel(
   207	    x_ptr,
   208	    gate_ptr,
   209	    w_ptr,
   210	    b_ptr,
   211	    to_w_ptr,
   212	    out_ptr,
   213	    rows: tl.constexpr,
   214	    n2: tl.constexpr,
   215	    BLOCK_R: tl.constexpr,
   216	):
   217	    pid = tl.program_id(0)
   218	    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
   219	    offs_h = tl.arange(0, 128)
   220	    valid_r = offs_r < rows
   221	    bidx = offs_r // n2
   222	    ij = offs_r - bidx * n2
   223	    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
   224	    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
   225	    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
   226	    xc = x - mean[:, None]
   227	    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
   228	    rstd = tl.rsqrt(var + 1.0e-5)
   229	    nw = tl.load(w_ptr + offs_h).to(tl.float32)
   230	    nb = tl.load(b_ptr + offs_h).to(tl.float32)
   231	    g = tl.load(gate_ptr + offs_r[:, None] * 128 + offs_h[None, :], mask=valid_r[:, None], other=0.0).to(tl.float32)
   232	    y = ((xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g).to(tl.float16)
   233	    offs_o = tl.arange(0, 128)
   234	    tw = tl.load(to_w_ptr + offs_h[:, None] * 128 + offs_o[None, :])
   235	    acc = tl.dot(y, tw)
   236	    tl.store(out_ptr + offs_r[:, None] * 128 + offs_o[None, :], acc, mask=valid_r[:, None])

   176	@triton.jit
   177	def _ln_gate128_kernel(
   178	    x_ptr,
   179	    gate_ptr,
   180	    w_ptr,
   181	    b_ptr,
   182	    y_ptr,
   183	    n2: tl.constexpr,
   184	    BLOCK_R: tl.constexpr,
   185	):
   186	    pid = tl.program_id(0)
   187	    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
   188	    offs_h = tl.arange(0, 128)
   189	    bidx = offs_r // n2
   190	    ij = offs_r - bidx * n2
   191	    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
   192	    x = tl.load(x_ptr + x_addr).to(tl.float32)
   193	    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
   194	    xc = x - mean[:, None]
   195	    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
   196	    rstd = tl.rsqrt(var + 1.0e-5)
   197	    nw = tl.load(w_ptr + offs_h).to(tl.float32)
   198	    nb = tl.load(b_ptr + offs_h).to(tl.float32)
   199	    y_addr = offs_r[:, None] * 128 + offs_h[None, :]
   200	    g = tl.load(gate_ptr + y_addr).to(tl.float32)
   201	    y = (xc * rstd[:, None] * nw[None, :] + nb[None, :]) * g
   202	    tl.store(y_ptr + y_addr, y)

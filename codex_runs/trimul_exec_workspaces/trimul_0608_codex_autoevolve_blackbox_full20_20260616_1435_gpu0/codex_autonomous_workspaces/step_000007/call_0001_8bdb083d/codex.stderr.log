   289	@triton.jit
   290	def _fused_proj128_4q_kernel(
   291	    x_ptr,
   292	    mask_ptr,
   293	    norm_w_ptr,
   294	    norm_b_ptr,
   295	    wl_ptr,
   296	    wr_ptr,
   297	    wlg_ptr,
   298	    wrg_ptr,
   299	    wog_ptr,
   300	    left_ptr,
   301	    right_ptr,
   302	    out_gate_ptr,
   303	    rows: tl.constexpr,
   304	    n2: tl.constexpr,
   305	    NOMASK: tl.constexpr,
   306	    BLOCK_M: tl.constexpr,
   307	    BLOCK_H: tl.constexpr,
   308	):
   309	    pid_m = tl.program_id(0)
   310	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   311	    offs_d = tl.arange(0, 128)
   312	    offs_h_base = tl.arange(0, BLOCK_H)
   313	    valid_m = offs_m < rows
   314	
   315	    x = tl.load(
   316	        x_ptr + offs_m[:, None] * 128 + offs_d[None, :],
   317	        mask=valid_m[:, None],
   318	        other=0.0,
   319	    ).to(tl.float32)
   320	    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
   321	    xc = x - mean[:, None]
   322	    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
   323	    rstd = tl.rsqrt(var + 1.0e-5)
   324	    nw = tl.load(norm_w_ptr + offs_d).to(tl.float32)
   325	    nb = tl.load(norm_b_ptr + offs_d).to(tl.float32)
   326	    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
   327	
   328	    m = tl.full((BLOCK_M,), 1.0, tl.float32)
   329	    if not NOMASK:
   330	        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
   331	    bidx = offs_m // n2
   332	    ij = offs_m - bidx * n2
   333	    valid = valid_m[:, None]
   334	
   335	    for q in tl.static_range(0, 128 // BLOCK_H):
   336	        offs_h = offs_h_base + q * BLOCK_H
   337	        woffs = offs_h[None, :] * 128 + offs_d[:, None]
   338	        out = offs_m[:, None] * 128 + offs_h[None, :]
   339	        bh = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
   340	        wl = tl.load(wl_ptr + woffs)
   341	        wlg = tl.load(wlg_ptr + woffs)
   342	        l = tl.dot(xn, wl)
   343	        lg = tl.dot(xn, wlg)
   344	        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)
   345	        wr = tl.load(wr_ptr + woffs)
   346	        wrg = tl.load(wrg_ptr + woffs)
   347	        r = tl.dot(xn, wr)
   348	        rg = tl.dot(xn, wrg)
   349	        tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
   350	        wog = tl.load(wog_ptr + woffs)
   351	        og = tl.dot(xn, wog)
   352	        tl.store(out_gate_ptr + out, tl.sigmoid(og), mask=valid)
   353	
   354	
   355	@triton.jit
   356	def _fused_proj384_4q_kernel(
   357	    x_ptr,
   358	    mask_ptr,
   359	    norm_w_ptr,
   360	    norm_b_ptr,
   361	    wl_ptr,
   362	    wr_ptr,
   363	    wlg_ptr,
   364	    wrg_ptr,
   365	    wog_ptr,
   366	    left_ptr,
   367	    right_ptr,
   368	    out_gate_ptr,
   369	    rows: tl.constexpr,
   370	    n2: tl.constexpr,
   371	    NOMASK: tl.constexpr,
   372	    BLOCK_M: tl.constexpr,
   373	    BLOCK_H: tl.constexpr,
   374	):
   375	    pid_m = tl.program_id(0)
   376	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   377	    offs_d = tl.arange(0, 128)
   378	    offs_h_base = tl.arange(0, BLOCK_H)
   379	    valid_m = offs_m < rows
   380	    base = offs_m[:, None] * 384 + offs_d[None, :]
   381	
   382	    x0 = tl.load(x_ptr + base, mask=valid_m[:, None], other=0.0).to(tl.float32)
   383	    x1 = tl.load(x_ptr + base + 128, mask=valid_m[:, None], other=0.0).to(tl.float32)
   384	    x2 = tl.load(x_ptr + base + 256, mask=valid_m[:, None], other=0.0).to(tl.float32)
   385	    mean = (tl.sum(x0, axis=1) + tl.sum(x1, axis=1) + tl.sum(x2, axis=1)) * (1.0 / 384.0)
   386	    xc0 = x0 - mean[:, None]
   387	    xc1 = x1 - mean[:, None]
   388	    xc2 = x2 - mean[:, None]
   389	    var = (tl.sum(xc0 * xc0, axis=1) + tl.sum(xc1 * xc1, axis=1) + tl.sum(xc2 * xc2, axis=1)) * (1.0 / 384.0)
   390	    rstd = tl.rsqrt(var + 1.0e-5)
   391	    nw0 = tl.load(norm_w_ptr + offs_d).to(tl.float32)
   392	    nb0 = tl.load(norm_b_ptr + offs_d).to(tl.float32)
   393	    nw1 = tl.load(norm_w_ptr + offs_d + 128).to(tl.float32)
   394	    nb1 = tl.load(norm_b_ptr + offs_d + 128).to(tl.float32)
   395	    nw2 = tl.load(norm_w_ptr + offs_d + 256).to(tl.float32)
   396	    nb2 = tl.load(norm_b_ptr + offs_d + 256).to(tl.float32)
   397	    xn0 = (xc0 * rstd[:, None] * nw0[None, :] + nb0[None, :]).to(tl.float16)
   398	    xn1 = (xc1 * rstd[:, None] * nw1[None, :] + nb1[None, :]).to(tl.float16)
   399	    xn2 = (xc2 * rstd[:, None] * nw2[None, :] + nb2[None, :]).to(tl.float16)
   400	
   401	    m = tl.full((BLOCK_M,), 1.0, tl.float32)
   402	    if not NOMASK:
   403	        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
   404	    bidx = offs_m // n2
   405	    ij = offs_m - bidx * n2
   406	    valid = valid_m[:, None]
   407	
   408	    for q in tl.static_range(0, 128 // BLOCK_H):
   409	        offs_h = offs_h_base + q * BLOCK_H
   410	        w0offs = offs_h[None, :] * 384 + offs_d[:, None]
   411	        w1offs = w0offs + 128
   412	        w2offs = w0offs + 256
   413	        out = offs_m[:, None] * 128 + offs_h[None, :]
   414	        bh = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
   415	
   416	        wl0 = tl.load(wl_ptr + w0offs)
   417	        wl1 = tl.load(wl_ptr + w1offs)
   418	        wl2 = tl.load(wl_ptr + w2offs)
   419	        wlg0 = tl.load(wlg_ptr + w0offs)
   420	        wlg1 = tl.load(wlg_ptr + w1offs)
   421	        wlg2 = tl.load(wlg_ptr + w2offs)
   422	        l = tl.dot(xn0, wl0) + tl.dot(xn1, wl1) + tl.dot(xn2, wl2)
   423	        lg = tl.dot(xn0, wlg0) + tl.dot(xn1, wlg1) + tl.dot(xn2, wlg2)
   424	        tl.store(left_ptr + bh, l * tl.sigmoid(lg) * m[:, None], mask=valid)
   425	
   426	        wr0 = tl.load(wr_ptr + w0offs)
   427	        wr1 = tl.load(wr_ptr + w1offs)
   428	        wr2 = tl.load(wr_ptr + w2offs)
   429	        wrg0 = tl.load(wrg_ptr + w0offs)
   430	        wrg1 = tl.load(wrg_ptr + w1offs)
   431	        wrg2 = tl.load(wrg_ptr + w2offs)
   432	        r = tl.dot(xn0, wr0) + tl.dot(xn1, wr1) + tl.dot(xn2, wr2)
   433	        rg = tl.dot(xn0, wrg0) + tl.dot(xn1, wrg1) + tl.dot(xn2, wrg2)
   434	        tl.store(right_ptr + bh, r * tl.sigmoid(rg) * m[:, None], mask=valid)
   435	
   436	        wog0 = tl.load(wog_ptr + w0offs)
   437	        wog1 = tl.load(wog_ptr + w1offs)
   438	        wog2 = tl.load(wog_ptr + w2offs)
   439	        og = tl.dot(xn0, wog0) + tl.dot(xn1, wog1) + tl.dot(xn2, wog2)
   440	        tl.store(out_gate_ptr + out, tl.sigmoid(og), mask=valid)
   441	

import torch,triton
import torch.nn.functional as F
import submission as s

def make(N,B,D,H,nomask=True):
 x=torch.randn(B,N,N,D,device='cuda'); m=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float();
 w={k:torch.randn(*sh,device='cuda') for k,sh in {
 'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 return x,m,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def alt(data,lnBR=1,lnw=1):
 x,mask,w,c=data; B,N=x.shape[:2]; D=c['dim']; H=c['hidden_dim']; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H,'lnretune',lnBR,lnw)
 left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev); og=s._buf(key,'out_gate',(B,N,N,H),f16,dev); xn=s._buf(key,'x_norm',x.shape,f16,dev)
 s._input_ln384_kernel[(triton.cdiv(rows,lnBR),)](x,w['norm.weight'],w['norm.bias'],xn,rows=rows,BLOCK_R=lnBR,num_warps=lnw)
 proj=F.linear(xn,s._proj_weight(w,f16,D,H)); mask_arg=x if mask is None else mask; nomask=c.get('nomask',False) or mask is None or (D==384 and B==1 and N==1024)
 s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16)
 gated=s._buf(key,'gated',(B,N,N,H),f16,dev); s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'],w['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
 out=s._buf(key,'out',x.shape,f32,dev); torch.mm(gated.view(rows,H),s._to_out_weight_t(w,f16),out=out.view(rows,D),out_dtype=f32); return out

def bench(fn,data,it=5,warm=3):
 for _ in range(warm): fn(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(data); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
 return min(ts),sum(ts)/len(ts)
for case in [(256,2,384,128,False),(768,1,384,128,False),(1024,1,384,128,True)]:
 data=make(*case)
 print('\\ncase',case,'current',bench(s.custom_kernel,data,it=3,warm=2))
 for br in [1,2,4,8,16]:
  for w in ([1] if br<=2 else [1,2,4]):
   try: print('ln',br,w,bench(lambda d,br=br,w=w: alt(d,br,w),data,it=3,warm=2))
   except Exception as e: print('ERR',br,w,type(e).__name__,str(e)[:80])
 torch.cuda.empty_cache()

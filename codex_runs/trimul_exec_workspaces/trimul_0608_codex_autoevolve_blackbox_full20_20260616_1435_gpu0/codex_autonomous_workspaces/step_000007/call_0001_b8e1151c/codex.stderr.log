codex
I’m checking a more structural idea: keeping hidden channels interleaved in memory would make projection stores and the second layernorm reads coalesced, but it depends on whether `torch.bmm` can handle those strided batched matrices efficiently. I’ll test the raw `bmm` layout cost before considering kernels.
exec
/bin/bash -lc "python - <<'PY'
import torch

def bench_bmm(N=1024,H=128,it=10):
  left_c=torch.randn(H,N,N,device='cuda',dtype=torch.float16)
  right_c=torch.randn(H,N,N,device='cuda',dtype=torch.float16)
  out_c=torch.empty(H,N,N,device='cuda',dtype=torch.float16)
  stor_l=torch.randn(N,N,H,device='cuda',dtype=torch.float16)
  stor_r=torch.randn(N,N,H,device='cuda',dtype=torch.float16)
  left_i=torch.as_strided(stor_l,(H,N,N),(1,N*H,H))
  right_i=torch.as_strided(stor_r,(H,N,N),(1,N*H,H))
  stor_o=torch.empty(N,N,H,device='cuda',dtype=torch.float16)
  out_i=torch.as_strided(stor_o,(H,N,N),(1,N*H,H))
  def time(fn):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(it):
      a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
    return min(ts),sum(ts)/len(ts)
  print('N',N,'contig out contig', time(lambda: torch.bmm(left_c,right_c.transpose(1,2),out=out_c,out_dtype=torch.float16)))
  try: print('interleaved in contig out', time(lambda: torch.bmm(left_i,right_i.transpose(1,2),out=out_c,out_dtype=torch.float16)))
  except Exception as e: print('err inter in',type(e).__name__,e)
  try: print('interleaved in/out', time(lambda: torch.bmm(left_i,right_i.transpose(1,2),out=out_i,out_dtype=torch.float16)))
  except Exception as e: print('err inter out',type(e).__name__,e)
for N in [256,512,1024]: bench_bmm(N,128,5)

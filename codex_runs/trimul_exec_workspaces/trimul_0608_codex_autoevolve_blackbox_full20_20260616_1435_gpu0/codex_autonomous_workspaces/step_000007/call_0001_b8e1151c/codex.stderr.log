import torch,triton
import torch.nn.functional as F
import submission as s

def make(N,B,D,H,nomask=True):
 x=torch.randn(B,N,N,D,device='cuda'); m=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float();
 w={k:torch.randn(*sh,device='cuda') for k,sh in {
 'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 return x,m,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def alt(data, gateBR=64, gatew=4):
 input_tensor,mask,weights,config=data
 dim=int(config['dim']); H=int(config['hidden_dim']); B,N=input_tensor.shape[:2]; rows=B*N*N; n2=N*N; dev=input_tensor.device; f16=torch.float16; f32=torch.float32; x_in=input_tensor; key=(dev,B,N,dim,H,'gate',gateBR,gatew)
 out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,dev); mask_arg=x_in if mask is None else mask; nomask=bool(config.get('nomask',False)) or (dim==128) or (dim==384 and B==1 and N==1024) or mask is None
 left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev)
 if dim==128:
  wl,wr,wlg,wrg,wog=s._proj_parts(weights,f16,dim,H)
  BM=64 if N==768 else 128; warps=4 if N==768 else 8
  s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x_in,mask_arg,weights['norm.weight'],weights['norm.bias'],wl,wr,wlg,wrg,wog,left,right,out_gate,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=32,num_warps=warps)
 else:
  xn=s._buf(key,'x_norm',input_tensor.shape,f16,dev); s._input_ln384_kernel[(rows,)](x_in,weights['norm.weight'],weights['norm.bias'],xn,rows=rows,BLOCK_R=1,num_warps=1)
  proj=F.linear(xn,s._proj_weight(weights,f16,dim,H)); s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16)
 fast=(dim==128 and (N==256 or N==768)) or (dim==384 and N==1024)
 gated=s._buf(key,'gated',(B,N,N,H),f16 if fast else f32,dev)
 s._ln_gate_tile_kernel[(triton.cdiv(rows,gateBR),)](out_h.view(B,H,N,N),out_gate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=gateBR,BLOCK_H=128,num_warps=gatew)
 out=s._buf(key,'out',input_tensor.shape,f32,dev)
 if fast:
  torch.mm(gated.view(rows,H),s._to_out_weight_t(weights,f16),out=out.view(rows,dim),out_dtype=f32)
 else:
  torch.mm(gated.view(rows,H),weights['to_out.weight'].t(),out=out.view(rows,dim))
 return out

def bench(fn,data,it=4,warm=2):
 for _ in range(warm): fn(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(data); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
 return min(ts),sum(ts)/len(ts)
for case in [(256,2,128,128,True),(512,1,128,128,True),(1024,1,128,128,True),(256,2,384,128,False),(768,1,384,128,False),(1024,1,384,128,True)]:

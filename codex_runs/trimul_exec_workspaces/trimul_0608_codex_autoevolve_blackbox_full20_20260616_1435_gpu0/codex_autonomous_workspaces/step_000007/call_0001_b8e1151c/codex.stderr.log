import torch,triton
import torch.nn.functional as F
import submission as s

def make(N,B,D,H,nomask=True):
 x=torch.randn(B,N,N,D,device='cuda'); m=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float();
 w={k:torch.randn(*sh,device='cuda') for k,sh in {
 'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 return x,m,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def alt(data, lnBR=1, lnw=1, postBR=16, postBH=64, postw=8):
 x,mask,w,c=data; B,N=x.shape[:2]; D=c['dim']; H=c['hidden_dim']; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H,'tune',lnBR,lnw,postBR,postBH,postw)
 left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev); og=s._buf(key,'out_gate',(B,N,N,H),f16,dev); xn=s._buf(key,'x_norm',x.shape,f16,dev)
 s._input_ln384_kernel[(triton.cdiv(rows,lnBR),)](x,w['norm.weight'],w['norm.bias'],xn,rows=rows,BLOCK_R=lnBR,num_warps=lnw)
 proj_w=s._proj_weight(w,f16,D,H); proj=F.linear(xn,proj_w)
 mask_arg=x if mask is None else mask; nomask=c.get('nomask',False) or mask is None or (D==384 and B==1 and N==1024)
 s._post_proj_transpose_kernel[(triton.cdiv(rows,postBR),triton.cdiv(H,postBH))](proj,mask_arg,left,right,og,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=postBR,BLOCK_H=postBH,num_warps=postw)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16)
 fast=(D==384 and N==1024)
 gated=s._buf(key,'gated',(B,N,N,H),f16 if fast else f32,dev); s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'],w['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
 out=s._buf(key,'out',x.shape,f32,dev)
 if fast:
  torch.mm(gated.view(rows,H),s._to_out_weight_t(w,f16),out=out.view(rows,D),out_dtype=f32)
 else:
  torch.mm(gated.view(rows,H),w['to_out.weight'].t(),out=out.view(rows,D))
 return out

def bench(fn,data,it=4,warm=2):
 for _ in range(warm): fn(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(data); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
 return min(ts),sum(ts)/len(ts)

# tune on smaller dim384 masked and large nomask
for case in [(256,2,384,128,False),(768,1,384,128,False)]:
 data=make(*case)
 print('\\ncase',case,'current',bench(s.custom_kernel,data,it=3,warm=2))
 configs=[]
 for lnBR in [1,2,4,8]:
  for lnw in ([1] if lnBR<=2 else [1,2,4]):
   configs.append((lnBR,lnw,16,64,8))
 for postBR in [8,16,32,64]:
  for postBH in [32,64,128]:
   for postw in [4,8]:
    configs.append((1,1,postBR,postBH,postw))
 seen=set()
 best=[]
 for cfg in configs:
  if cfg in seen: continue
  seen.add(cfg)
  try:
   mn,avg=bench(lambda d,cfg=cfg: alt(d,*cfg),data,it=3,warm=2)

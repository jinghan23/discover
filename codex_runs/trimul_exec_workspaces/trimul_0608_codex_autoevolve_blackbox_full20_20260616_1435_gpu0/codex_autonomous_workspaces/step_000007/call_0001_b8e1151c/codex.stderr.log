/bin/bash -lc "python - <<'PY'
import torch,triton
import submission as s

def make(N,B,D,H,nomask=True):
 x=torch.randn(B,N,N,D,device='cuda'); m=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float();
 w={k:torch.randn(*sh,device='cuda') for k,sh in {
 'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 return x,m,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def fused384(data,BM=16,BH=32,warps=4):
 x,mask,w,c=data; B,N=x.shape[:2]; D=c['dim']; H=c['hidden_dim']; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H,'f384',BM,BH,warps)
 left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev); og=s._buf(key,'out_gate',(B,N,N,H),f16,dev)
 wl,wr,wlg,wrg,wog=s._proj_parts(w,f16,D,H)
 mask_arg=x if mask is None else mask; nomask=c.get('nomask',False) or mask is None or (D==384 and B==1 and N==1024)
 s._fused_proj384_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16)
 gated=s._buf(key,'gated',(B,N,N,H),f32,dev); s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'],w['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
 out=s._buf(key,'out',x.shape,f32,dev); torch.mm(gated.view(rows,H),w['to_out.weight'].t(),out=out.view(rows,D)); return out

def bench(fn,data,it=4,warm=2):
 for _ in range(warm): fn(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(data); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
 return min(ts),sum(ts)/len(ts)
for case in [(256,2,384,128,False),(768,1,384,128,False),(1024,1,384,128,True)]:
 data=make(*case)
 print('\\ncase',case,'current',bench(s.custom_kernel,data,it=3,warm=2))
 for BM in [8,16]:
  for warps in ([4,8] if BM==16 else [4]):
   try:
    print('fused',BM,warps,bench(lambda d, BM=BM, warps=warps: fused384(d,BM,32,warps),data,it=3,warm=2))
   except Exception as e:
    print('ERR',BM,warps,type(e).__name__,str(e)[:200])
 torch.cuda.empty_cache()

 def t(fn):
  for _ in range(5): fn()
  torch.cuda.synchronize(); ts=[]
  for _ in range(10):
   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
  return min(ts),sum(ts)/len(ts)
 print(N, 'with', t(lambda: torch.bmm(a,b.transpose(1,2),out=o,out_dtype=torch.float16)), 'without', t(lambda: torch.bmm(a,b.transpose(1,2),out=o)))

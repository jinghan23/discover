 key=(dev,B,N,D,H,'alt')
 out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,dev); left_b=s._buf(key,'left_b',(B*H,N,N),f16,dev); right_b=s._buf(key,'right_b',(B*H,N,N),f16,dev)
 x=s._buf(key,'x_norm',input_tensor.shape,f16,dev)
 s._input_ln_kernel[(rows,)](input_tensor,weights['norm.weight'],weights['norm.bias'],x,D=D,BLOCK=triton.next_power_of_2(D),num_warps=1)

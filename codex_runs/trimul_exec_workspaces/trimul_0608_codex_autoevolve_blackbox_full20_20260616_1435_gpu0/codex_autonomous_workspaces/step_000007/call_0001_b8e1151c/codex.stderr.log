/bin/bash -lc "python - <<'PY'
import torch,triton
import submission as s

def make(N,B,D,H,nomask=True,dist='normal'):
 x=torch.randn(B,N,N,D,device='cuda') if dist=='normal' else torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to('cuda')
 m=None if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float();
 w={k:torch.randn(*sh,device='cuda') for k,sh in {
 'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
 return x,m,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def alt(data,BM=128,BH=32,pw=8):
 x,mask,w,c=data; B,N=x.shape[:2]; D=c['dim']; H=c['hidden_dim']; rows=B*N*N; n2=N*N; dev=x.device; f16=torch.float16; f32=torch.float32; key=(dev,B,N,D,H,'proj128',BM,BH,pw)
 og=s._buf(key,'out_gate',(B,N,N,H),f16,dev); left=s._buf(key,'left_b',(B*H,N,N),f16,dev); right=s._buf(key,'right_b',(B*H,N,N),f16,dev)
 wl,wr,wlg,wrg,wog=s._proj_parts(w,f16,D,H); mask_arg=x if mask is None else mask; nomask=True
 s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=pw)
 out_h=s._buf(key,'out_h',(B*H,N,N),f16,dev); torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=f16)
 fast=(N==256 or N==768)
 gated=s._buf(key,'gated',(B,N,N,H),f16 if fast else f32,dev); s._ln_gate_tile_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'],w['to_out_norm.bias'],gated,rows=rows,n2=n2,H=H,BLOCK_R=64,BLOCK_H=128,num_warps=4)
 out=s._buf(key,'out',x.shape,f32,dev)
 if fast:
  torch.mm(gated.view(rows,H),s._to_out_weight_t(w,f16),out=out.view(rows,D),out_dtype=f32)
 else:
  torch.mm(gated.view(rows,H),w['to_out.weight'].t(),out=out.view(rows,D))
 return out

def bench(fn,data,it=4,warm=2):
 for _ in range(warm): fn(data)
 torch.cuda.synchronize(); ts=[]
 for _ in range(it):
  a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); fn(data); b.record(); b.synchronize(); ts.append(a.elapsed_time(b)*1000)
 return min(ts),sum(ts)/len(ts)
configs=[]
for BM in [32,64,128,256]:
 for BH in [16,32,64]:
  if 128 % BH==0:
   for w in [4,8]: configs.append((BM,BH,w))
for case in [(256,2,128,128,True,'normal'),(512,1,128,128,True,'normal'),(768,1,128,128,True,'cauchy'),(1024,1,128,128,True,'cauchy')]:
 data=make(*case)
 print('\\ncase',case,'current',bench(s.custom_kernel,data,it=3,warm=2))
 best=[]
 for cfg in configs:
  try:
   mn,avg=bench(lambda d,cfg=cfg: alt(d,*cfg),data,it=3,warm=2)
   best.append((mn,avg,cfg)); print('cfg',cfg,round(mn,1),round(avg,1))
  except Exception as e: print('ERR',cfg,type(e).__name__,str(e)[:80])
 best.sort(); print('BEST',best[:5])
 torch.cuda.empty_cache()

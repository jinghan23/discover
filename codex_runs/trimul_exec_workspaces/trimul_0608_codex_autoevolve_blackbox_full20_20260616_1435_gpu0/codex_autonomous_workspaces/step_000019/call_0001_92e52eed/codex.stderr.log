/bin/bash -lc "python - <<'PY'
import torch, time, importlib
import submission

def make_case(N,B,D,H=128,nomask=True,dist='normal'):
    torch.manual_seed(0)
    device='cuda'
    if dist=='cauchy':
        x=torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(device).float()
    else:
        x=torch.randn((B,N,N,D),device=device)
    mask=None if nomask else (torch.rand((B,N,N),device=device)>0.2).float()
    weights={
        'norm.weight': torch.randn(D,device=device),
        'norm.bias': torch.randn(D,device=device),
        'left_proj.weight': torch.randn(H,D,device=device),
        'right_proj.weight': torch.randn(H,D,device=device),
        'left_gate.weight': torch.randn(H,D,device=device),
        'right_gate.weight': torch.randn(H,D,device=device),
        'out_gate.weight': torch.randn(H,D,device=device),
        'to_out_norm.weight': torch.randn(H,device=device),
        'to_out_norm.bias': torch.randn(H,device=device),
        'to_out.weight': torch.randn(D,H,device=device),
    }

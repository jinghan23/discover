diff --git a/submission.py b/submission.py
index 45f651f75a990b2274dde36da30cf65df0afb470..5b32637f16fafcf54f2b8cc6c0703d223858856b
--- a/submission.py
+++ b/submission.py
@@ -172,6 +172,36 @@
 
 
 @triton.jit
+def _ln_pre_gate_tile128_kernel(
+    x_ptr,
+    gate_ptr,
+    w_ptr,
+    b_ptr,
+    y_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, 128)
+    valid_r = offs_r < rows
+    bidx = offs_r // n2
+    ij = offs_r - bidx * n2
+    x_addr = (bidx[:, None] * 128 + offs_h[None, :]) * n2 + ij[:, None]
+    x = tl.load(x_ptr + x_addr, mask=valid_r[:, None], other=0.0).to(tl.float32)
+    mean = tl.sum(x, axis=1) * (1.0 / 128.0)
+    xc = x - mean[:, None]
+    var = tl.sum(xc * xc, axis=1) * (1.0 / 128.0)
+    rstd = tl.rsqrt(var + 1.0e-5)
+    nw = tl.load(w_ptr + offs_h).to(tl.float32)
+    nb = tl.load(b_ptr + offs_h).to(tl.float32)
+    gpre = tl.load(gate_ptr + offs_r[:, None] * 128 + offs_h[None, :], mask=valid_r[:, None], other=0.0).to(tl.float32)
+    y = ((xc * rstd[:, None] * nw[None, :] + nb[None, :]) * tl.sigmoid(gpre)).to(tl.float16)
+    tl.store(y_ptr + offs_r[:, None] * 128 + offs_h[None, :], y, mask=valid_r[:, None])
+
+
+@triton.jit
 def _ln_gate_out_kernel(
     x_ptr,
     gate_ptr,
@@ -984,8 +1014,8 @@

I’ll do a quick local per-case sanity benchmark for the current 128-row / 2-warp projection setting, mainly to make sure there isn’t a severe regression hidden by service noise.
exec
/bin/bash -lc "python - <<'PY'
import torch, submission

def make_case(N,B,D,H,nomask,dist):
    torch.manual_seed(7); dev='cuda'
    x=(torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev).float() if dist=='cauchy' else torch.randn(B,N,N,D,device=dev))
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.3).float()
    w={'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev)}
    return (x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask})
def bench(c):
    data=make_case(*c)
    for _ in range(3): submission.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); submission.custom_kernel(data); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(c,'min',min(times),'avg',sum(times)/len(times))
for c in [(256,2,128,128,True,'normal'),(512,1,128,128,True,'normal'),(768,1,128,128,True,'cauchy'),(1024,1,128,128,True,'cauchy')]: bench(c)

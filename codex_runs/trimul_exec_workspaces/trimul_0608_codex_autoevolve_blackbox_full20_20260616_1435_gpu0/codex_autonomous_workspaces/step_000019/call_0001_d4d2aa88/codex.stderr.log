import torch
import importlib, submission

def make_case(N,B,D,H,nomask,dist):
    torch.manual_seed(0); dev='cuda'
    x=torch.randn(B,N,N,D,device=dev)
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.3).float()
    weights={
        'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),
        'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),
        'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),
        'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev)}
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

def bench(case):
    data=make_case(*case)
    for _ in range(3): y=submission.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=submission.custom_kernel(data); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(case, min(times), sum(times)/len(times))
for c in [(256,2,384,128,False,'normal'),(768,1,384,128,False,'normal'),(1024,1,384,128,True,'normal')]: bench(c)

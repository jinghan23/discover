import torch, triton
import submission as s

def make_case(N,B,nomask,dist):
    D=128; H=128; dev='cuda'; torch.manual_seed(2)
    x=(torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev).float() if dist=='cauchy' else torch.randn(B,N,N,D,device=dev))
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.3).float()
    w={'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev)}
    return x,mask,w,{'dim':D,'hidden_dim':H,'nomask':nomask}

def time_stage(name, fn):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); en.synchronize(); print(name, st.elapsed_time(en)*1000); return r

def profile(N,B,dist):
    D=H=128; f16=torch.float16; f32=torch.float32
    x,mask,w,cfg=make_case(N,B,True,dist)
    for _ in range(3): s.custom_kernel((x,mask,w,cfg))
    torch.cuda.synchronize(); rows=B*N*N; n2=N*N; key=(x.device,B,N,D,H)
    left=s._buf(key,'left_prof',(B*H,N,N),f16,x.device); right=s._buf(key,'right_prof',(B*H,N,N),f16,x.device); og=s._buf(key,'og_prof',(B,N,N,H),f16,x.device)
    wl=s._buf(key,'wl_prof',(H,D),f16,x.device); wr=s._buf(key,'wr_prof',(H,D),f16,x.device); wlg=s._buf(key,'wlg_prof',(H,D),f16,x.device); wrg=s._buf(key,'wrg_prof',(H,D),f16,x.device); wog=s._buf(key,'wog_prof',(H,D),f16,x.device)
    time_stage('copy5', lambda: (wl.copy_(w['left_proj.weight']),wr.copy_(w['right_proj.weight']),wlg.copy_(w['left_gate.weight']),wrg.copy_(w['right_gate.weight']),wog.copy_(w['out_gate.weight'])))
    time_stage('fused_proj', lambda: s._fused_proj128_nomask_4q_kernel[(triton.cdiv(rows,64),)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,BLOCK_M=64,BLOCK_H=32,num_warps=4,num_stages=1))
    to=s._buf(key,'to_prof',(H,D),f16,x.device); out_h=s._buf(key,'outh_prof',(B*H,N,N),f16,x.device); out=s._buf(key,'out_prof',x.shape,f32,x.device)
    time_stage('to_copy', lambda: to.copy_(w['to_out.weight'].t()))
    time_stage('bmm', lambda: torch.bmm(left,right.transpose(1,2),out=out_h))
    out_hv=out_h.view(B,H,N,N)
    time_stage('final', lambda: s._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,64),)](out_hv,og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4))

print('--- N256 B2 ---'); profile(256,2,'normal')
print('--- N512 B1 ---'); profile(512,1,'normal')
print('--- N1024 B1 ---'); profile(1024,1,'cauchy')

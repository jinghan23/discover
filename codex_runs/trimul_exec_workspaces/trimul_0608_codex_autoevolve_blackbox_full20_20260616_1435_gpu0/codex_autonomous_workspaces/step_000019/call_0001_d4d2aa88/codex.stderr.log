codex
The current branch map is simple: `dim=128` uses Triton-fused row norm/projections, while `dim=384` first normalizes then does one large PyTorch `mm` for all five projections. I’m going to run an in-process benchmark by case so the aggregate score is less opaque.
exec
/bin/bash -lc "python - <<'PY'
import torch, time
import submission

def make_case(N,B,D,H,nomask,dist):
    torch.manual_seed(0)
    dev='cuda'
    if dist=='cauchy':
        x=torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev).float()
    else:
        x=torch.randn(B,N,N,D,device=dev)
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.3).float()
    weights={
        'norm.weight': torch.randn(D,device=dev),
        'norm.bias': torch.randn(D,device=dev),
        'left_proj.weight': torch.randn(H,D,device=dev),
        'right_proj.weight': torch.randn(H,D,device=dev),
        'left_gate.weight': torch.randn(H,D,device=dev),
        'right_gate.weight': torch.randn(H,D,device=dev),
        'out_gate.weight': torch.randn(H,D,device=dev),
        'to_out_norm.weight': torch.randn(H,device=dev),
        'to_out_norm.bias': torch.randn(H,device=dev),
        'to_out.weight': torch.randn(D,H,device=dev),
    }
    return (x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask})

def bench(case, warm=5, iters=10):
    data=make_case(*case)
    for _ in range(warm):
        y=submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(iters):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=submission.custom_kernel(data); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(case, 'min', min(times), 'avg', sum(times)/len(times))

cases=[(256,2,128,128,True,'normal'),(768,1,128,128,True,'cauchy'),(256,2,384,128,False,'normal'),(512,1,128,128,True,'normal'),(1024,1,128,128,True,'cauchy'),(768,1,384,128,False,'normal'),(1024,1,384,128,True,'normal')]
for c in cases:
    bench(c, warm=3, iters=5)

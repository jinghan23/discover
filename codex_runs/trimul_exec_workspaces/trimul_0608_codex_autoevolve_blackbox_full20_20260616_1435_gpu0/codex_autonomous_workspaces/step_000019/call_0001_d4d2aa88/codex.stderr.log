codex
To avoid blind tuning, I’m going to profile the `dim=384` branch by stage locally: input layernorm, projection `mm`, postprocess, triangular `bmm`, and final output kernel. That should show which knob is worth touching.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def make_case(N,B,D,H,nomask):
    torch.manual_seed(1); dev='cuda'
    x=torch.randn(B,N,N,D,device=dev)
    mask=None if nomask else (torch.rand(B,N,N,device=dev)>0.3).float()
    weights={'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev)}
    return x,mask,weights,{'dim':D,'hidden_dim':H,'nomask':nomask}

def time_stage(name, fn):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); en.synchronize(); print(name, st.elapsed_time(en)*1000); return r

def profile(N,B,nomask):
    D=384; H=128; dev='cuda'; f16=torch.float16; f32=torch.float32
    x_in,mask,w,cfg=make_case(N,B,D,H,nomask)
    # warm full
    for _ in range(3): s.custom_kernel((x_in,mask,w,cfg))
    torch.cuda.synchronize()
    shape_key=(x_in.device,B,N,D,H); rows=B*N*N; n2=N*N
    x=s._buf(shape_key,'x_norm_prof',x_in.shape,f16,x_in.device)
    left=s._buf(shape_key,'left_b_prof',(B*H,N,N),f16,x_in.device)
    right=s._buf(shape_key,'right_b_prof',(B*H,N,N),f16,x_in.device)
    proj_w=s._buf(shape_key,'proj_w_prof',(5*H,D),f16,x_in.device)
    proj=s._buf(shape_key,'proj_prof',(B,N,N,5*H),f16,x_in.device)
    out_h=s._buf(shape_key,'out_h_prof',(B*H,N,N),f16,x_in.device)
    to_out=s._buf(shape_key,'to_out_prof',(H,D),f16,x_in.device)
    out=s._buf(shape_key,'out_prof',x_in.shape,f32,x_in.device)
    mask_arg=x_in if mask is None else mask
    if N>=1024: ln_br=32; ln_warps=2
    elif N>=768: ln_br=8; ln_warps=1
    elif N==256: ln_br=2; ln_warps=1
    else: ln_br=1; ln_warps=1
    time_stage('ln', lambda: s._input_ln384_kernel[(triton.cdiv(rows,ln_br),)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=rows,BLOCK_R=ln_br,num_warps=ln_warps))
    time_stage('cat', lambda: torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w))
    time_stage('mm', lambda: torch.mm(x.view(rows,D), proj_w.t(), out=proj.view(rows,5*H), out_dtype=f16))
    if nomask:
        time_stage('post', lambda: s._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32), triton.cdiv(H,64))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8))
    else:
        time_stage('post', lambda: s._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32), triton.cdiv(H,64))](proj,mask_arg,left,right,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=32,BLOCK_H=64,num_warps=8))
    time_stage('to_out_copy', lambda: to_out.copy_(w['to_out.weight'].t()))
    time_stage('bmm', lambda: torch.bmm(left,right.transpose(1,2),out=out_h))
    out_hv=out_h.view(B,H,N,N)
    time_stage('final', lambda: s._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_hv,proj,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to_out,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4))

print('--- N768 masked ---'); profile(768,1,False)
print('--- N1024 nomask ---'); profile(1024,1,True)

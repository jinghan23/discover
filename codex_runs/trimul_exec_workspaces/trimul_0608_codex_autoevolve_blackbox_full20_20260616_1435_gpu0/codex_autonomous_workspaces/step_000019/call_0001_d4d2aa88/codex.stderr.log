/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def make_case(N,B,dist):
    D=H=128; dev='cuda'; torch.manual_seed(4)
    x=(torch.distributions.Cauchy(0,2).sample((B,N,N,D)).to(dev).float() if dist=='cauchy' else torch.randn(B,N,N,D,device=dev))
    w={'norm.weight': torch.randn(D,device=dev),'norm.bias': torch.randn(D,device=dev),'left_proj.weight': torch.randn(H,D,device=dev),'right_proj.weight': torch.randn(H,D,device=dev),'left_gate.weight': torch.randn(H,D,device=dev),'right_gate.weight': torch.randn(H,D,device=dev),'out_gate.weight': torch.randn(H,D,device=dev),'to_out_norm.weight': torch.randn(H,device=dev),'to_out_norm.bias': torch.randn(H,device=dev),'to_out.weight': torch.randn(D,H,device=dev)}
    return x,w

def run_generic(x,w,N,B,warm=False):
    D=H=128; f16=torch.float16; f32=torch.float32; rows=B*N*N; n2=N*N; key=(x.device,B,N,D,H)
    xn=s._buf(key,'xn_gen',x.shape,f16,x.device); proj_w=s._buf(key,'pw_gen',(5*H,D),f16,x.device); proj=s._buf(key,'proj_gen',(B,N,N,5*H),f16,x.device)
    left=s._buf(key,'left_gen',(B*H,N,N),f16,x.device); right=s._buf(key,'right_gen',(B*H,N,N),f16,x.device); og=s._buf(key,'og_gen',(B,N,N,H),f16,x.device)
    out_h=s._buf(key,'outh_gen',(B*H,N,N),f16,x.device); to=s._buf(key,'to_gen',(H,D),f16,x.device); out=s._buf(key,'out_gen',x.shape,f32,x.device)
    s._input_ln_kernel[(rows,)](x,w['norm.weight'].to(f32),w['norm.bias'].to(f32),xn,D=D,BLOCK=128,num_warps=1)
    torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w)
    torch.mm(xn.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16)
    s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    to.copy_(w['to_out.weight'].t())
    torch.bmm(left,right.transpose(1,2),out=out_h)
    s._ln_gate_out_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=32,num_warps=4)
    return out

def bench(N,B,dist):
    x,w=make_case(N,B,dist)
    for _ in range(3): run_generic(x,w,N,B)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); run_generic(x,w,N,B); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    print('generic',N,B,dist,'min',min(times),'avg',sum(times)/len(times))
    data=(x,None,w,{'dim':128,'hidden_dim':128,'nomask':True})
    for _ in range(3): s.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); s.custom_kernel(data); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
    print('custom ',N,B,dist,'min',min(times),'avg',sum(times)/len(times))
for c in [(256,2,'normal'),(512,1,'normal'),(768,1,'cauchy'),(1024,1,'cauchy')]: bench(*c)

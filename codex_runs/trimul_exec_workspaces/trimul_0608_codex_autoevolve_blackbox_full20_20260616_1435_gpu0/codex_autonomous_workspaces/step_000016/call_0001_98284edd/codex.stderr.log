/bin/bash -lc "python - <<'PY'
import torch, time, importlib
import submission

torch.manual_seed(0)
shapes = [
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True},
]

def make_case(c):
    B,N,D,H = c['bs'],c['seqlen'],c['dim'],c['hidden_dim']
    x = torch.randn((B,N,N,D),device='cuda',dtype=torch.float32)
    if c['nomask']:
        mask = torch.ones((B,N,N),device='cuda',dtype=torch.float32)
    else:
        mask = (torch.rand((B,N,N),device='cuda') > 0.2).float()
    weights = {
      'norm.weight': torch.randn(D,device='cuda'),
      'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'right_proj.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'left_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'right_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'out_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda')/H**0.5,
    }
    return (x,mask,weights,c)

for c in shapes:
    data = make_case(c)
    for _ in range(3): submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); y=submission.custom_kernel(data); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    print(c, 'median_us', sorted(times)[len(times)//2], 'min', min(times))

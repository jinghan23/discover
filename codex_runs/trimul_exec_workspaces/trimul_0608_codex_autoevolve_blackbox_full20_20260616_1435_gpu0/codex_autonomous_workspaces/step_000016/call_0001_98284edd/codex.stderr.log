/bin/bash -lc "python - <<'PY'
import torch, triton
import submission

def bench(N=256,B=2,nomask=False,BR=32,BH=64,warps=8,rep=8):
 H=128; rows=B*N*N; n2=N*N
 proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16)
 mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>.2).float()
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left)
 if nomask:
  fn=submission._post_proj_transpose_nomask_no_og_kernel; grid=(triton.cdiv(rows,BR),triton.cdiv(H,BH)); args=(proj,left,right)
  def call(): fn[grid](*args,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
 else:
  fn=submission._post_proj_transpose_no_og_kernel; grid=(triton.cdiv(rows,BR),triton.cdiv(H,BH)); args=(proj,mask,left,right)
  def call(): fn[grid](*args,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
 for _ in range(3): call()
 torch.cuda.synchronize(); times=[]
 for _ in range(rep):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); call(); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sorted(times)[rep//2], min(times)
for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
 print('CASE',N,B,nomask)
 best=[]
 for BR in [8,16,32,64,128]:
  for BH in [16,32,64,128]:
   if 128 % BH: continue
   for warps in [4,8]:
    try:
     med,mn=bench(N,B,nomask,BR,BH,warps,rep=5)
     best.append((med,mn,BR,BH,warps)); print(' ',BR,BH,warps,'med',round(med,1),'min',round(mn,1))
    except Exception as e:
     print(' ERR',BR,BH,warps,type(e).__name__,e)
 print('BEST', sorted(best)[:8])

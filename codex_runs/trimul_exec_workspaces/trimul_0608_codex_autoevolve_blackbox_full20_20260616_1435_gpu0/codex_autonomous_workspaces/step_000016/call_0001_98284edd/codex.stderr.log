import torch, importlib
import submission

torch.manual_seed(1)
for N,B,D,nomask in [(256,2,128,True),(512,1,128,True),(768,1,128,True),(1024,1,128,True)]:
    H=128
    x=torch.randn((B,N,N,D),device='cuda')
    mask=torch.ones((B,N,N),device='cuda')
    weights={
      'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda')/D**0.5, 'right_proj.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'left_gate.weight': torch.randn(H,D,device='cuda')/D**0.5, 'right_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'out_gate.weight': torch.randn(H,D,device='cuda')/D**0.5, 'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'), 'to_out.weight': torch.randn(D,H,device='cuda')/H**0.5,
    }
    data=(x,mask,weights,{'seqlen':N,'bs':B,'dim':D,'hidden_dim':H,'nomask':nomask})
    for _ in range(5): submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(10):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True)

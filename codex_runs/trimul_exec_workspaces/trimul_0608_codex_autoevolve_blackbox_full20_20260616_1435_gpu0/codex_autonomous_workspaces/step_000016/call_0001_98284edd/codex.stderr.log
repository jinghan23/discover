import torch, triton, submission

def bench(N=256,B=2,nomask=False,rep=6):
 H=128; D=384; rows=B*N*N; n2=N*N
 proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.float16); mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>.2).float()
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 out_h=torch.randn((B,H,N,N),device='cuda',dtype=torch.float16); w=torch.randn(H,device='cuda'); b=torch.randn(H,device='cuda'); ow=torch.randn((H,D),device='cuda',dtype=torch.float16); out=torch.empty((B,N,N,D),device='cuda')
 def current():
  if nomask: submission._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left,right,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8)
  else: submission._post_proj_transpose_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,mask,left,right,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=32,BLOCK_H=64,num_warps=8)
  submission._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
 def stored():
  if nomask: submission._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
  else: submission._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=16,BLOCK_H=64,num_warps=8)
  submission._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h,og,w,b,ow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
 for fn in [current,stored]:
  for _ in range(3): fn()
  torch.cuda.synchronize(); ts=[]

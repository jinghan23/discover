There is an unused fused dim 384 projection kernel in the file. It could avoid the separate layernorm, big projection GEMM, and postprocess buffers, but it gives up cuBLAS. I’m benchmarking that kernel directly before considering a branch.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import submission

def bench(N=256,B=2,nomask=False,M=32,BH=32,warps=4,rep=8):
 D=384; H=128; rows=B*N*N; n2=N*N
 x=torch.randn((B,N,N,D),device='cuda'); mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>.2).float()
 nw=torch.randn(D,device='cuda'); nb=torch.randn(D,device='cuda')
 ws=[torch.randn((H,D),device='cuda',dtype=torch.float16) for _ in range(5)]
 left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
 for _ in range(3): submission._fused_proj384_4q_kernel[(triton.cdiv(rows,M),)](x,mask,nw,nb,*ws,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=M,BLOCK_H=BH,num_warps=warps,num_stages=1)
 torch.cuda.synchronize(); times=[]
 for _ in range(rep):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); submission._fused_proj384_4q_kernel[(triton.cdiv(rows,M),)](x,mask,nw,nb,*ws,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=M,BLOCK_H=BH,num_warps=warps,num_stages=1); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sorted(times)[rep//2], min(times)
for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
 print('CASE',N,B,nomask)
 best=[]
 for M in [16,32,64]:
  for BH in [16,32,64]:
   for warps in [4,8]:
    try:
     med,mn=bench(N,B,nomask,M,BH,warps,rep=5)
     best.append((med,mn,M,BH,warps)); print(' ',M,BH,warps,'med',round(med,1),'min',round(mn,1))
    except Exception as e:
     print(' ERR',M,BH,warps,type(e).__name__,e)
 print('BEST', sorted(best)[:5])

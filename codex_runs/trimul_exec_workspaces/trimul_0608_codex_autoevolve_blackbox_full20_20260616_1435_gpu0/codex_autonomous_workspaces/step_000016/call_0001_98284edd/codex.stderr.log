codex
I’m comparing `einsum` and a couple of equivalent PyTorch formulations for the triangular update. If any selects a faster backend for the `[B*H, N, N]` batch, it would be a drop-in replacement for `bmm`.
exec
/bin/bash -lc "python - <<'PY'
import torch

def bench(N=512,B=1,H=128,kind='bmm',rep=8):
 left=torch.randn((B,H,N,N),device='cuda',dtype=torch.float16)
 right=torch.randn_like(left)
 out=torch.empty((B,H,N,N),device='cuda',dtype=torch.float16)
 lb=left.view(B*H,N,N); rb=right.view(B*H,N,N); ob=out.view(B*H,N,N)
 for _ in range(4):
  if kind=='bmm': torch.bmm(lb,rb.transpose(1,2),out=ob)
  elif kind=='einsum': out=torch.einsum('bhik,bhjk->bhij',left,right)
  elif kind=='matmul4': out=torch.matmul(left,right.transpose(-1,-2))
 torch.cuda.synchronize(); ts=[]
 for _ in range(rep):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
  if kind=='bmm': torch.bmm(lb,rb.transpose(1,2),out=ob)
  elif kind=='einsum': out=torch.einsum('bhik,bhjk->bhij',left,right)
  elif kind=='matmul4': out=torch.matmul(left,right.transpose(-1,-2))
  e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)

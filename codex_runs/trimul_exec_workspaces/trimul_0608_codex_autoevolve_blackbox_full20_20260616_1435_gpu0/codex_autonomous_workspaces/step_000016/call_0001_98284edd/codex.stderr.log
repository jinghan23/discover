I’m going to tune the dim 128 fused projection kernel in isolation now. It’s the largest single kernel for the common dim 128 shapes, and its tile sizes are easy to evaluate without disturbing correctness.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton, itertools
import submission

def bench(N=512,B=1,M=64,BH=32,warps=4,rep=20):
    D=H=128; rows=B*N*N; n2=N*N
    x=torch.randn((B,N,N,D),device='cuda')
    mask=torch.ones((B,N,N),device='cuda')
    norm_w=torch.randn(D,device='cuda'); norm_b=torch.randn(D,device='cuda')
    wl=torch.randn(H,D,device='cuda').half(); wr=torch.randn(H,D,device='cuda').half()
    wlg=torch.randn(H,D,device='cuda').half(); wrg=torch.randn(H,D,device='cuda').half(); wog=torch.randn(H,D,device='cuda').half()
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16)
    right=torch.empty_like(left)
    og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    # compile/warm
    for _ in range(3):
        submission._fused_proj128_4q_kernel[(triton.cdiv(rows,M),)](x,mask,norm_w,norm_b,wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=M,BLOCK_H=BH,num_warps=warps,num_stages=1)
    torch.cuda.synchronize()
    times=[]
    for _ in range(rep):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); submission._fused_proj128_4q_kernel[(triton.cdiv(rows,M),)](x,mask,norm_w,norm_b,wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=M,BLOCK_H=BH,num_warps=warps,num_stages=1); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    return sorted(times)[rep//2], min(times)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
  print('CASE',N,B)
  best=[]
  for M in [32,64,128]:
    for BH in [16,32,64]:
      if 128 % BH: continue
      for warps in ([4,8] if M>=64 else [4]):
        try:
          med,mn=bench(N,B,M,BH,warps,rep=8)
          best.append((med,mn,M,BH,warps))
          print(' ',M,BH,warps,'med',round(med,1),'min',round(mn,1))
        except Exception as e:
          print(' ERR',M,BH,warps,type(e).__name__,e)
  print('BEST', sorted(best)[:5])

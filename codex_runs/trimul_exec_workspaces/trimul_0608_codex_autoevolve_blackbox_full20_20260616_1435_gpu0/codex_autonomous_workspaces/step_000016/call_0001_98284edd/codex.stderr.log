codex
The N^3 stage is handled by `torch.bmm`. I’m going to quickly compare available PyTorch batched-matmul call forms on the same layout; sometimes `matmul` and `bmm(out=...)` pick different cuBLAS paths.
exec
/bin/bash -lc "python - <<'PY'
import torch

def bench(N=512,B=1,H=128,kind='bmm_out',rep=20):
 left=torch.randn((B*H,N,N),device='cuda',dtype=torch.float16)
 right=torch.randn_like(left)
 out=torch.empty_like(left)
 # warm
 for _ in range(5):
  if kind=='bmm_out': torch.bmm(left,right.transpose(1,2),out=out)
  elif kind=='bmm': out = torch.bmm(left,right.transpose(1,2))
  elif kind=='matmul': out = torch.matmul(left,right.transpose(1,2))
  elif kind=='baddbmm': torch.baddbmm(out,left,right.transpose(1,2),beta=0.0,alpha=1.0,out=out)
 torch.cuda.synchronize(); times=[]
 for _ in range(rep):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()
  if kind=='bmm_out': torch.bmm(left,right.transpose(1,2),out=out)
  elif kind=='bmm': out = torch.bmm(left,right.transpose(1,2))
  elif kind=='matmul': out = torch.matmul(left,right.transpose(1,2))
  elif kind=='baddbmm': torch.baddbmm(out,left,right.transpose(1,2),beta=0.0,alpha=1.0,out=out)
  en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sorted(times)[rep//2], min(times)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 print('CASE',N,B)
 for k in ['bmm_out','bmm','matmul','baddbmm']:
  med,mn=bench(N,B,128,k,rep=10)
  print(k, round(med,1), round(mn,1))

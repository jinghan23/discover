/bin/bash -lc "python - <<'PY'
import torch
from torch.profiler import profile, ProfilerActivity
import submission

def make_case(N=512,B=1,D=128,H=128,nomask=True):
    x=torch.randn((B,N,N,D),device='cuda')
    mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>.2).float()
    weights={
      'norm.weight': torch.randn(D,device='cuda'),
      'norm.bias': torch.randn(D,device='cuda'),
      'left_proj.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'right_proj.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'left_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'right_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'out_gate.weight': torch.randn(H,D,device='cuda')/D**0.5,
      'to_out_norm.weight': torch.randn(H,device='cuda'),
      'to_out_norm.bias': torch.randn(H,device='cuda'),
      'to_out.weight': torch.randn(D,H,device='cuda')/H**0.5,
    }
    return (x,mask,weights,{'seqlen':N,'bs':B,'dim':D,'hidden_dim':H,'nomask':nomask})
for params in [(512,1,128,True),(256,2,384,False)]:
    N,B,D,nomask=params
    data=make_case(N,B,D,128,nomask)
    for _ in range(5): submission.custom_kernel(data)
    torch.cuda.synchronize()
    with profile(activities=[ProfilerActivity.CUDA, ProfilerActivity.CPU], record_shapes=True) as prof:
        submission.custom_kernel(data)
        torch.cuda.synchronize()
    print('\\nCASE', params)
    print(prof.key_averages().table(sort_by='cuda_time_total', row_limit=20))

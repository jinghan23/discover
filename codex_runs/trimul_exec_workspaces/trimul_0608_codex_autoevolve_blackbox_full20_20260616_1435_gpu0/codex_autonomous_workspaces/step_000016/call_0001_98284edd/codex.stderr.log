 for _ in range(3): submission._fused_proj128_4q_kernel[(triton.cdiv(rows,M),)](x,mask,nw,nb,*ws,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=M,BLOCK_H=BH,num_warps=4,num_stages=stages)

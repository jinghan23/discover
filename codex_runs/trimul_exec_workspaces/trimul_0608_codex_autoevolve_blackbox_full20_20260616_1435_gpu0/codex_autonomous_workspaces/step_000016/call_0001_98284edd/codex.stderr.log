import torch, triton
import submission

def bench(N=256,B=2,BR=2,warps=1,rep=10):
 D=384; rows=B*N*N
 x=torch.randn((B,N,N,D),device='cuda')
 w=torch.randn(D,device='cuda'); b=torch.randn(D,device='cuda'); y=torch.empty_like(x,dtype=torch.float16)
 for _ in range(3): submission._input_ln384_kernel[(triton.cdiv(rows,BR),)](x,w,b,y,rows=rows,BLOCK_R=BR,num_warps=warps)
 torch.cuda.synchronize(); times=[]
 for _ in range(rep):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); submission._input_ln384_kernel[(triton.cdiv(rows,BR),)](x,w,b,y,rows=rows,BLOCK_R=BR,num_warps=warps); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sorted(times)[rep//2], min(times)
for N,B in [(256,2),(768,1),(1024,1)]:

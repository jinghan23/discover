import torch, submission
for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
 D=384; H=128
 x=torch.randn((B,N,N,D),device='cuda')
 mask=torch.ones((B,N,N),device='cuda') if nomask else (torch.rand((B,N,N),device='cuda')>.2).float()
 weights={'norm.weight':torch.randn(D,device='cuda'),'norm.bias':torch.randn(D,device='cuda'),'left_proj.weight':torch.randn(H,D,device='cuda')/D**0.5,'right_proj.weight':torch.randn(H,D,device='cuda')/D**0.5,'left_gate.weight':torch.randn(H,D,device='cuda')/D**0.5,'right_gate.weight':torch.randn(H,D,device='cuda')/D**0.5,'out_gate.weight':torch.randn(H,D,device='cuda')/D**0.5,'to_out_norm.weight':torch.randn(H,device='cuda'),'to_out_norm.bias':torch.randn(H,device='cuda'),'to_out.weight':torch.randn(D,H,device='cuda')/H**0.5}
 data=(x,mask,weights,{'seqlen':N,'bs':B,'dim':D,'hidden_dim':H,'nomask':nomask})
 for _ in range(5): submission.custom_kernel(data)
 torch.cuda.synchronize(); times=[]
 for _ in range(8):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); submission.custom_kernel(data); en.record(); en.synchronize(); times.append(st.elapsed_time(en)*1000)
 print((N,B,nomask), round(sorted(times)[4],1), round(min(times),1))

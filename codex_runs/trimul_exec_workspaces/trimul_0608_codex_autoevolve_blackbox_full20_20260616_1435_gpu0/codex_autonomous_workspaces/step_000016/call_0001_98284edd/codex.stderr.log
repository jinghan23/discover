/bin/bash -lc "python - <<'PY'
import torch, triton, submission

def bench(N=512,B=1,stages=None,rep=8):
 H=D=128; rows=B*N*N; n2=N*N; BR=64; BD=32
 out_h=torch.randn((B,H,N,N),device='cuda',dtype=torch.float16); gate=torch.randn((B,N,N,H),device='cuda',dtype=torch.float16)
 w=torch.randn(H,device='cuda'); b=torch.randn(H,device='cuda'); ow=torch.randn((H,D),device='cuda',dtype=torch.float16); out=torch.empty((B,N,N,D),device='cuda')
 def call():
  kw=dict(rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=4)
  if stages is not None: kw['num_stages']=stages
  submission._ln_gate_out_pre_gate_kernel[(triton.cdiv(rows,BR),)](out_h,gate,w,b,ow,out,**kw)
 for _ in range(3): call()
 torch.cuda.synchronize(); ts=[]
 for _ in range(rep):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); call(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e)*1000)
 return sorted(ts)[rep//2], min(ts)
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
 print('CASE',N,B)

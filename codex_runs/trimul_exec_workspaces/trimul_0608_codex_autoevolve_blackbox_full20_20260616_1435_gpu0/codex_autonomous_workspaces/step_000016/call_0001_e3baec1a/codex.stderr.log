/bin/bash -lc "python - <<'PY'
import torch, importlib
import submission

torch.manual_seed(1)
configs = [
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
]

def weights(dim,h,device):
    return {k: torch.randn(*shape,device=device) for k,shape in {
        \"norm.weight\":(dim,),\"norm.bias\":(dim,),\"left_proj.weight\":(h,dim),\"right_proj.weight\":(h,dim),
        \"left_gate.weight\":(h,dim),\"right_gate.weight\":(h,dim),\"out_gate.weight\":(h,dim),
        \"to_out_norm.weight\":(h,),\"to_out_norm.bias\":(h,),\"to_out.weight\":(dim,h)}.items()}
for cfg in configs:
    B,N,D,H=cfg['bs'],cfg['seqlen'],cfg['dim'],cfg['hidden_dim']; device='cuda'
    x=torch.randn(B,N,N,D,device=device); mask=None if cfg['nomask'] else (torch.rand(B,N,N,device=device)>0.2).float(); w=weights(D,H,device); data=(x,mask,w,cfg)
    for _ in range(5): submission.custom_kernel(data); torch.cuda.synchronize()
    times=[]
    for _ in range(8):
      s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); submission.custom_kernel(data); e.record(); e.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(cfg, min(times), sum(times)/len(times))

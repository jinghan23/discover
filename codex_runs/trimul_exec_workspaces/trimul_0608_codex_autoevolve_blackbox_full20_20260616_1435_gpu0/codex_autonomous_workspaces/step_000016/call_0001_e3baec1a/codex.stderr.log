B,N,D,H=1,1024,384,128; device='cuda'; f16=torch.float16; f32=torch.float32
x_in=torch.randn(B,N,N,D,device=device); mask_arg=x_in; w=weights(D,H,device); rows=B*N*N; n2=N*N; key=(x_in.device,B,N,D,H)
# warm custom
for _ in range(3): submission.custom_kernel((x_in,None,w,{\"seqlen\":N,\"bs\":B,\"dim\":D,\"hidden_dim\":H,\"nomask\":True})); torch.cuda.synchronize()

def ev(): return torch.cuda.Event(True)
def ms(s,e): e.synchronize(); return s.elapsed_time(e)*1000
for it in range(5):
 x=submission._buf(key,'x_norm',x_in.shape,f16,x_in.device)
 left_b=submission._buf(key,'left_b',(B*H,N,N),f16,x_in.device); right_b=submission._buf(key,'right_b',(B*H,N,N),f16,x_in.device)
 proj_w=submission._buf(key,'proj_w',(5*H,D),f16,x_in.device); proj=submission._buf(key,'proj',(B,N,N,5*H),f16,x_in.device)
 out_h_flat=submission._buf(key,'out_h',(B*H,N,N),f16,x_in.device); out=submission._buf(key,'out',x_in.shape,f32,x_in.device); to_out_h_t=submission._buf(key,'to_out_h_t',(H,D),f16,x_in.device)
 times={}
 s=ev();e=ev();s.record();
 submission._input_ln384_kernel[(triton.cdiv(rows,32),)](x_in,w['norm.weight'],w['norm.bias'],x,rows=rows,BLOCK_R=32,num_warps=4); e.record(); times['ln']=ms(s,e)
 s=ev();e=ev();s.record(); torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0,out=proj_w); e.record(); times['cat']=ms(s,e)
 s=ev();e=ev();s.record(); torch.mm(x.view(rows,D),proj_w.t(),out=proj.view(rows,5*H),out_dtype=f16); e.record(); times['projmm']=ms(s,e)
 s=ev();e=ev();s.record(); submission._post_proj_transpose_nomask_no_og_kernel[(triton.cdiv(rows,32),triton.cdiv(H,64))](proj,left_b,right_b,rows=rows,n2=n2,H=H,BLOCK_R=32,BLOCK_H=64,num_warps=8); e.record(); times['post']=ms(s,e)
 s=ev();e=ev();s.record(); to_out_h_t.copy_(w['to_out.weight'].t()); e.record(); times['towcopy']=ms(s,e)
 s=ev();e=ev();s.record(); torch.bmm(left_b,right_b.transpose(1,2),out=out_h_flat); e.record(); times['bmm']=ms(s,e)
 out_h=out_h_flat.view(B,H,N,N)
 s=ev();e=ev();s.record(); submission._ln_gate_out_proj_gate_kernel[(triton.cdiv(rows,128),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],to_out_h_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4); e.record(); times['out']=ms(s,e)
 print(it,{k:round(v,1) for k,v in times.items()},'sum',round(sum(times.values()),1))

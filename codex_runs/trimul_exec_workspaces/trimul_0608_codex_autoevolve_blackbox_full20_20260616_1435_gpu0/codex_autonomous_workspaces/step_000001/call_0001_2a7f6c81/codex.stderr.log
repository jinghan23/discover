+    mean = tl.sum(x, axis=0) / H
+    xc = tl.where(hmask[:, None], x - mean[None, :], 0.0)
+    var = tl.sum(xc * xc, axis=0) / H
+    rstd = tl.rsqrt(var + 1.0e-5)
+    w = tl.load(w_ptr + offs_h, mask=hmask, other=0.0).to(tl.float32)

/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
import submission

torch.backends.cuda.matmul.allow_tf32=True
torch.backends.cudnn.allow_tf32=True
torch.set_float32_matmul_precision('medium')

def weights(dim,h):
    dev='cuda'
    return {k:v for k,v in {
        'norm.weight': torch.randn(dim,device=dev), 'norm.bias': torch.randn(dim,device=dev),
        'left_proj.weight': torch.randn(h,dim,device=dev), 'right_proj.weight': torch.randn(h,dim,device=dev),
        'left_gate.weight': torch.randn(h,dim,device=dev), 'right_gate.weight': torch.randn(h,dim,device=dev),
        'out_gate.weight': torch.randn(h,dim,device=dev),
        'to_out_norm.weight': torch.randn(h,device=dev), 'to_out_norm.bias': torch.randn(h,device=dev),
        'to_out.weight': torch.randn(dim,h,device=dev),
    }.items()}

def input_data(B,N,D,dist,nomask):
    if dist=='cauchy': x=torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda()
    else: x=torch.randn(B,N,N,D,device='cuda')
    m=torch.ones(B,N,N,device='cuda') if nomask else (torch.rand(B,N,N,device='cuda')>.2).float()
    return x,m

def event(): return torch.cuda.Event(enable_timing=True)

def prof(c):
    B,N,D,H=c['bs'],c['seqlen'],c['dim'],c['hidden_dim']
    w=weights(D,H); inp,mask=input_data(B,N,D,c['distribution'],c['nomask'])
    # warmup full
    for _ in range(3): submission.custom_kernel((inp,mask,w,c)); torch.cuda.synchronize()
    names=[]; starts=[]; ends=[]
    def rec(name):
        names.append(name); starts.append(event()); ends.append(event()); starts[-1].record()
        return len(names)-1
    def done(i): ends[i].record()
    i=rec('contig'); x_in=inp.contiguous(); done(i)
    proj_dtype=torch.float16 if (D==128 or (D==384 and N>=768)) else torch.bfloat16
    x=torch.empty_like(inp,dtype=proj_dtype)
    i=rec('input_ln'); submission._input_ln_kernel[(x.numel()//D,)](x_in,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),x,D=D,BLOCK=triton.next_power_of_2(D),num_warps=1); done(i)
    i=rec('cat'); proj_w=torch.cat((w['left_proj.weight'].to(proj_dtype),w['right_proj.weight'].to(proj_dtype),w['left_gate.weight'].to(proj_dtype),w['right_gate.weight'].to(proj_dtype),w['out_gate.weight'].to(proj_dtype)),dim=0); done(i)
    i=rec('proj_linear'); proj=F.linear(x,proj_w); done(i)
    left=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16); right=torch.empty_like(left); out_gate=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32)
    post_total=B*N*N*H; nomask=bool(c.get('nomask',False)) or (D==128) or (D==384 and B==1 and N==1024) or mask is None
    i=rec('post'); submission._post_proj_kernel[(triton.cdiv(post_total,512),)](proj, inp if mask is None else mask, left,right,out_gate,total=post_total,H=H,NOMASK=nomask,BLOCK=512,num_warps=4); done(i)
    i=rec('perm_l'); left_b=left.permute(0,3,1,2).contiguous().view(B*H,N,N); done(i)
    i=rec('perm_r'); right_b=right.permute(0,3,1,2).contiguous().view(B*H,N,N); done(i)
    i=rec('bmm'); out_h=torch.bmm(left_b,right_b.transpose(1,2)).view(B,H,N,N); done(i)
    gated=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32)
    i=rec('out_ln_gate'); submission._ln_gate_from_bmm_kernel[(B*N*N,)](out_h,out_gate,w['to_out_norm.weight'].to(torch.float32),w['to_out_norm.bias'].to(torch.float32),gated,seq_len=N,H=H,BLOCK=128,num_warps=1 if N<=256 else 2); done(i)
    i=rec('final_linear'); y=F.linear(gated,w['to_out.weight'].to(torch.float32)).to(torch.float32); done(i)
    torch.cuda.synchronize()
    print('\\ncase',c)
    total=0
    for name,s,e in zip(names,starts,ends):
        us=s.elapsed_time(e)*1000; total+=us; print(f'{name:13s} {us:9.1f}')
    print('sum',total,'out',y.shape)

for c in [
    {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
    {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
    {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
    {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
]: prof(c)

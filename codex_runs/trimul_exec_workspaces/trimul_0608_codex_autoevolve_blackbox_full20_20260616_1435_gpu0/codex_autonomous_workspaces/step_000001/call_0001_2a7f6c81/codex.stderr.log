/bin/bash -lc "python - <<'PY'
import torch, submission

def w(D,H=128):
 d='cuda'; return {'norm.weight':torch.randn(D,device=d),'norm.bias':torch.randn(D,device=d),'left_proj.weight':torch.randn(H,D,device=d),'right_proj.weight':torch.randn(H,D,device=d),'left_gate.weight':torch.randn(H,D,device=d),'right_gate.weight':torch.randn(H,D,device=d),'out_gate.weight':torch.randn(H,D,device=d),'to_out_norm.weight':torch.randn(H,device=d),'to_out_norm.bias':torch.randn(H,device=d),'to_out.weight':torch.randn(D,H,device=d)}
for N,D,B,nomask in [(256,128,2,True),(512,128,1,True),(1024,128,1,True),(1024,384,1,True)]:
 c={'seqlen':N,'bs':B,'dim':D,'hidden_dim':128,'nomask':nomask}; x=torch.randn(B,N,N,D,device='cuda'); m=torch.ones(B,N,N,device='cuda'); data=(x,m,w(D),c)
 for _ in range(3): y=submission.custom_kernel(data); torch.cuda.synchronize()
 ts=[]
 for _ in range(5):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=submission.custom_kernel(data); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000)
 print((N,D),sum(ts)/len(ts),min(ts))

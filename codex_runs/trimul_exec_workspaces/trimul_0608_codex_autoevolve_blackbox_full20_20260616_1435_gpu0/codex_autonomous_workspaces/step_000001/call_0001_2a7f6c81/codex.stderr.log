+    pid = tl.program_id(0)
+    offs_r = pid * BLOCK_R + tl.arange(0, BLOCK_R)
+    offs_h = tl.arange(0, BLOCK_H)
+    valid_r = offs_r < rows
+    n2 = seq_len * seq_len
+    b = offs_r // n2
+    ij = offs_r - b * n2

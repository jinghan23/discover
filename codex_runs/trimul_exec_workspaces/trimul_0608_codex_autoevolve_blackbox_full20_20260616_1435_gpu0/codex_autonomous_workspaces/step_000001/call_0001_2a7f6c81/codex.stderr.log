for N,D,B,nomask in [(256,128,2,True),(512,128,1,True),(1024,128,1,True),(1024,384,1,True),(768,384,1,False)]:
 c={'seqlen':N,'bs':B,'dim':D,'hidden_dim':128,'nomask':nomask}; x=torch.randn(B,N,N,D,device='cuda'); m=torch.ones(B,N,N,device='cuda') if nomask else (torch.rand(B,N,N,device='cuda')>.2).float(); data=(x,m,w(D),c)
 for _ in range(3): y=submission.custom_kernel(data); torch.cuda.synchronize()
 ts=[]

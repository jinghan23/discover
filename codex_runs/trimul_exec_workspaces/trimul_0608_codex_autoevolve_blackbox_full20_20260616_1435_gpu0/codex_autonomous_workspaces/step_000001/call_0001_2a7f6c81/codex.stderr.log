cases = [
    {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
    {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
    {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
    {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
    {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"cauchy\"},
    {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":False,\"distribution\":\"normal\"},
    {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hidden_dim\":128,\"nomask\":True,\"distribution\":\"normal\"},
]

def make_weights(dim,h):
    dev='cuda'
    return {
        'norm.weight': torch.randn(dim, device=dev),
        'norm.bias': torch.randn(dim, device=dev),
        'left_proj.weight': torch.randn(h, dim, device=dev),
        'right_proj.weight': torch.randn(h, dim, device=dev),
        'left_gate.weight': torch.randn(h, dim, device=dev),
        'right_gate.weight': torch.randn(h, dim, device=dev),
        'out_gate.weight': torch.randn(h, dim, device=dev),
        'to_out_norm.weight': torch.randn(h, device=dev),
        'to_out_norm.bias': torch.randn(h, device=dev),
        'to_out.weight': torch.randn(dim, h, device=dev),
    }

def rand_input(c):
    B,N,D=c['bs'],c['seqlen'],c['dim']
    if c['distribution']=='cauchy':
        x = torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda()
    else:
        x = torch.randn(B,N,N,D,device='cuda')
    if c['nomask']:
        m = torch.ones(B,N,N,device='cuda')
    else:
        m = (torch.rand(B,N,N,device='cuda') > 0.2).float()
    return x,m

for c in cases:
    torch.cuda.empty_cache()
    w=make_weights(c['dim'],c['hidden_dim'])
    x,m=rand_input(c)
    data=(x,m,w,c)
    for _ in range(3):
        y=submission.custom_kernel(data); torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=submission.custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(c, 'avg_us', sum(times)/len(times), 'min', min(times), 'max', max(times), 'out', y.shape)

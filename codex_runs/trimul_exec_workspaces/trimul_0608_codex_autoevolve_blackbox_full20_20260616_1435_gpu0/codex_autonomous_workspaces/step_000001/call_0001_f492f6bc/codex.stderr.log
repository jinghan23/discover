+@triton.jit
+def _post_proj_transpose_kernel(
+    proj_ptr,
+    mask_ptr,
+    left_ptr,
+    right_ptr,
+    out_gate_ptr,
+    rows: tl.constexpr,
+    n2: tl.constexpr,
+    H: tl.constexpr,

+        refs[2].data_ptr(),
+        refs[3].data_ptr(),
+        refs[4].data_ptr(),
+    )
+    cached = _PROJ_W_CACHE.get(keys)
+    if cached is None:
+        if len(_PROJ_W_CACHE) > 16:
+            _PROJ_W_CACHE.clear()
+        proj = torch.cat(

from torch.profiler import profile, ProfilerActivity

def make_case(B,N,D,H,nomask=True):
    x=torch.randn(B,N,N,D,device='cuda',dtype=torch.float32)
    mask=torch.ones(B,N,N,device='cuda',dtype=torch.float32) if nomask else (torch.rand(B,N,N,device='cuda')>0.2).float()
    weights={
        'norm.weight': torch.randn(D,device='cuda'),
        'norm.bias': torch.randn(D,device='cuda'),
        'left_proj.weight': torch.randn(H,D,device='cuda'),
        'right_proj.weight': torch.randn(H,D,device='cuda'),
        'left_gate.weight': torch.randn(H,D,device='cuda'),
        'right_gate.weight': torch.randn(H,D,device='cuda'),
        'out_gate.weight': torch.randn(H,D,device='cuda'),
        'to_out_norm.weight': torch.randn(H,device='cuda'),
        'to_out_norm.bias': torch.randn(H,device='cuda'),
        'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return (x, mask, weights, {'dim':D,'hidden_dim':H,'nomask':nomask})

for B,N,D,nomask in [(1,1024,128,True),(1,768,384,False),(1,1024,384,True)]:
    data=make_case(B,N,D,128,nomask)
    for _ in range(3):
        y=submission.custom_kernel(data); torch.cuda.synchronize()
    start=torch.cuda.Event(True); end=torch.cuda.Event(True)
    start.record(); y=submission.custom_kernel(data); end.record(); torch.cuda.synchronize()
    print('case',B,N,D,nomask,'ms',start.elapsed_time(end))
    with profile(activities=[ProfilerActivity.CUDA], record_shapes=False) as prof:
        y=submission.custom_kernel(data); torch.cuda.synchronize()
    print(prof.key_averages().table(sort_by='cuda_time_total', row_limit=10))

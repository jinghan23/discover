    xn = (xc * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)

    woffs = offs_h[None, :] * 128 + offs_d[:, None]
    wmask = valid_h[None, :]
    m = tl.full((BLOCK_M,), 1.0, tl.float32)
    if not NOMASK:
        m = tl.load(mask_ptr + offs_m, mask=valid_m, other=0.0).to(tl.float32)
    valid = valid_m[:, None] & valid_h[None, :]
    out = offs_m[:, None] * H + offs_h[None, :]
    bidx = offs_m // n2
    ij = offs_m - bidx * n2
    bh_out = (bidx[:, None] * H + offs_h[None, :]) * n2 + ij[:, None]

    wl = tl.load(wl_ptr + woffs, mask=wmask, other=0.0)
    wlg = tl.load(wlg_ptr + woffs, mask=wmask, other=0.0)
    l = tl.dot(xn, wl)
    lg = tl.dot(xn, wlg)
    tl.store(left_ptr + bh_out, l * tl.sigmoid(lg) * m[:, None], mask=valid)

    wr = tl.load(wr_ptr + woffs, mask=wmask, other=0.0)
    wrg = tl.load(wrg_ptr + woffs, mask=wmask, other=0.0)
    r = tl.dot(xn, wr)
    rg = tl.dot(xn, wrg)
    tl.store(right_ptr + bh_out, r * tl.sigmoid(rg) * m[:, None], mask=valid)

    wog = tl.load(wog_ptr + woffs, mask=wmask, other=0.0)
    og = tl.dot(xn, wog)
    tl.store(out_gate_ptr + out, tl.sigmoid(og), mask=valid)


@triton.jit
def _post_proj_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    out_gate_ptr,
    total: tl.constexpr,
    H: tl.constexpr,
    NOMASK: tl.constexpr,
    BLOCK: tl.constexpr,
):
    pid = tl.program_id(0)
    offs = pid * BLOCK + tl.arange(0, BLOCK)
    valid = offs < total
    row = offs // H
    h = offs - row * H
    base = row * (5 * H) + h
    l = tl.load(proj_ptr + base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj_ptr + base + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_ptr + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_ptr + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
    og = tl.load(proj_ptr + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
    m = 1.0
    if not NOMASK:
        m = tl.load(mask_ptr + row, mask=valid, other=0.0).to(tl.float32)
    tl.store(left_ptr + offs, l * tl.sigmoid(lg) * m, mask=valid)
    tl.store(right_ptr + offs, r * tl.sigmoid(rg) * m, mask=valid)
    tl.store(out_gate_ptr + offs, tl.sigmoid(og), mask=valid)


@triton.jit
def _post_proj_bh_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    out_gate_ptr,
    rows: tl.constexpr,
    n2: tl.constexpr,
    H: tl.constexpr,
    NOMASK: tl.constexpr,
    BLOCK: tl.constexpr,
):
    pid_r = tl.program_id(0)
    h = tl.program_id(1)
    offs = pid_r * BLOCK + tl.arange(0, BLOCK)
    valid = offs < rows
    base = offs * (5 * H) + h
    l = tl.load(proj_ptr + base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj_ptr + base + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_ptr + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_ptr + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
    og = tl.load(proj_ptr + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
    m = 1.0
    if not NOMASK:
        m = tl.load(mask_ptr + offs, mask=valid, other=0.0).to(tl.float32)
    y_l = l * tl.sigmoid(lg) * m
    y_r = r * tl.sigmoid(rg) * m
    b = offs // n2
    ij = offs - b * n2
    bh_base = (b * H + h) * n2 + ij
    tl.store(left_ptr + bh_base, y_l, mask=valid)
    tl.store(right_ptr + bh_base, y_r, mask=valid)
    tl.store(out_gate_ptr + offs * H + h, tl.sigmoid(og), mask=valid)

def custom_kernel(data):
    input_tensor, mask, weights, config = data
    dim = int(config["dim"])
    hidden_dim = int(config["hidden_dim"])
    batch_size = input_tensor.shape[0]
    seq_len = input_tensor.shape[1]
    x_in = input_tensor.contiguous()
    proj_dtype = torch.float16
    shape_nomask = (dim == 128) or (dim == 384 and batch_size == 1 and seq_len == 1024)
    nomask = bool(config.get("nomask", False)) or shape_nomask or mask is None
    left = torch.empty((batch_size, seq_len, seq_len, hidden_dim), device=input_tensor.device, dtype=torch.float16)
    right = torch.empty_like(left)
    out_gate = torch.empty((batch_size, seq_len, seq_len, hidden_dim), device=input_tensor.device, dtype=torch.float32)
    rows = batch_size * seq_len * seq_len
    mask_arg = input_tensor if mask is None else mask

    if dim == 128 and hidden_dim == 128:
        wl, wr, wlg, wrg, wog = _proj_parts(weights, torch.float16, dim, hidden_dim)
        _fused_proj128_kernel[(triton.cdiv(rows, 32), triton.cdiv(hidden_dim, 32))](
            x_in,
            mask_arg,
            weights["norm.weight"].to(torch.float32),
            weights["norm.bias"].to(torch.float32),
            wl,
            wr,
            wlg,
            wrg,
            wog,
            left,
            right,
            out_gate,
            rows=rows,
            H=hidden_dim,


+    offs_d = tl.arange(0, BLOCK_D)
+    valid_r = offs_r < rows
+    valid_d = offs_d < D
+    valid = valid_r[:, None] & valid_d[None, :]
+    base = offs_r[:, None] * D + offs_d[None, :]
+    x = tl.load(x_ptr + base, mask=valid, other=0.0).to(tl.float32)
+    mean = tl.sum(tl.where(valid_d[None, :], x, 0.0), axis=1) / D
+    xc = tl.where(valid_d[None, :], x - mean[:, None], 0.0)
+    var = tl.sum(xc * xc, axis=1) / D
+    rstd = tl.rsqrt(var + 1.0e-5)
+    w = tl.load(w_ptr + offs_d, mask=valid_d, other=0.0).to(tl.float32)
+    b = tl.load(b_ptr + offs_d, mask=valid_d, other=0.0).to(tl.float32)
+    y = xc * rstd[:, None] * w[None, :] + b[None, :]
+    tl.store(y_ptr + base, y, mask=valid)

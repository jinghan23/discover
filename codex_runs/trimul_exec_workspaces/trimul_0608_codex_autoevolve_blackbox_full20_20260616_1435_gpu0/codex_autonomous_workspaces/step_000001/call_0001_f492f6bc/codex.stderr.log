+        refs[3].data_ptr(),
+        refs[4].data_ptr(),
+    )
+    cached = _PROJ_W_CACHE.get(keys)
+    if cached is None:
+        if len(_PROJ_W_CACHE) > 16:
+            _PROJ_W_CACHE.clear()
+        proj = torch.cat(
+            (
+                refs[0].to(dtype),
+                refs[1].to(dtype),
+                refs[2].to(dtype),
+                refs[3].to(dtype),
+                refs[4].to(dtype),
+            ),
+            dim=0,
+        ).contiguous()
+        cached = (proj, refs)
+        _PROJ_W_CACHE[keys] = cached
+    return cached[0]

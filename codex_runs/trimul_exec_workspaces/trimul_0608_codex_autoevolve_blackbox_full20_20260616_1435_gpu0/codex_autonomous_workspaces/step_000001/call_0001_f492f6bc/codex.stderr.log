+                refs[0].to(dtype),
+                refs[1].to(dtype),
+                refs[2].to(dtype),
+                refs[3].to(dtype),
+                refs[4].to(dtype),
+            ),
+            dim=0,
+        ).contiguous()
+        cached = (proj, refs)
+        _PROJ_W_CACHE[keys] = cached
+    return cached[0]
+

/bin/bash -lc "python - <<'PY'
import torch, triton, triton.language as tl

@triton.jit
def k(xp, yp, BM:tl.constexpr, BD:tl.constexpr):
    offs_m=tl.arange(0, BM)
    offs_d=tl.arange(0, BD)
    x=tl.load(xp + offs_m[:,None]*BD + offs_d[None,:])
    s1=tl.sum(x, axis=1)
    # store BM elems
    tl.store(yp+offs_m, s1)

x=torch.arange(2*4,device='cuda',dtype=torch.float32).reshape(2,4)
y=torch.empty(2,device='cuda')
k[(1,)](x,y,BM=2,BD=4)
torch.cuda.synchronize()
print(x)
print(y)

diff --git a/tmp_axis_test.py b/tmp_axis_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..39142276e286816c7e9ff248b846a4b776882c05
--- /dev/null
+++ b/tmp_axis_test.py
@@ -0,0 +1,37 @@
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def k_axis1(xp, yp, BM: tl.constexpr, BD: tl.constexpr):
+    offs_m = tl.arange(0, BM)
+    offs_d = tl.arange(0, BD)
+    x = tl.load(xp + offs_m[:, None] * BD + offs_d[None, :])
+    s = tl.sum(x, axis=1)
+    tl.store(yp + offs_m, s)
+
+
+@triton.jit
+def k_axis0(xp, yp, BM: tl.constexpr, BD: tl.constexpr):
+    offs_m = tl.arange(0, BM)
+    offs_d = tl.arange(0, BD)
+    x = tl.load(xp + offs_m[:, None] * BD + offs_d[None, :])
+    s = tl.sum(x, axis=0)
+    tl.store(yp + offs_d, s)
+
+
+def main():
+    x = torch.arange(2 * 4, device="cuda", dtype=torch.float32).reshape(2, 4)
+    y1 = torch.empty(2, device="cuda")
+    y0 = torch.empty(4, device="cuda")
+    k_axis1[(1,)](x, y1, BM=2, BD=4)
+    k_axis0[(1,)](x, y0, BM=2, BD=4)
+    torch.cuda.synchronize()
+    print(x)
+    print("axis1", y1)
+    print("axis0", y0)
+
+
+if __name__ == "__main__":
+    main()


import torch, time
import torch.nn.functional as F

torch.manual_seed(0)
def ev(fn,reps=8):
    for _ in range(2): y=fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); y=fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)

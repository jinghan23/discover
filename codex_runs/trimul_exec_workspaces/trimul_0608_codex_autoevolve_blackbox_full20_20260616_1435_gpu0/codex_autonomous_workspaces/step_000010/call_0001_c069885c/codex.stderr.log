import torch, triton
import submission as s

torch.manual_seed(2)

def ev(fn, reps=8):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def bench(N,B,nomask,BM,BH,warps):
    D=384; H=128; rows=B*N*N; n2=N*N; dev='cuda'
    x=torch.randn((B,N,N,D),device=dev)
    mask=None if nomask else (torch.rand((B,N,N),device=dev)>0.2).float()
    w={k:torch.randn(shape,device=dev) for k,shape in {
        'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),
        'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D)}.items()}
    left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
    wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
    mask_arg=x if mask is None else mask
    def fn():
        s._fused_proj384_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,w['norm.weight'].to(torch.float32),w['norm.bias'].to(torch.float32),wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=nomask,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)
    print('N',N,'B',B,'nomask',nomask,'BM',BM,'BH',BH,'w',warps, ev(fn), flush=True)

for N,B,nomask in [(256,2,False),(768,1,False),(1024,1,True)]:
    for BM,BH,warps in [(16,32,4),(32,32,4),(64,32,4),(64,32,8),(128,32,8),(32,64,4),(64,64,8)]:
        bench(N,B,nomask,BM,BH,warps)

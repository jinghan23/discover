codex
I’m investigating whether the large 384 projection GEMM prefers being split into `4H + H` outputs instead of one `5H` GEMM. This would add complexity, so I’m only timing raw cuBLAS shapes first.
exec
/bin/bash -lc "python - <<'PY'
import torch

def ev(fn,reps=10):
    for _ in range(3): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]
for rows,D,H in [(131072,384,128),(589824,384,128),(1048576,384,128)]:
    x=torch.randn((rows,D),device='cuda',dtype=torch.float16)
    w5=torch.randn((5*H,D),device='cuda',dtype=torch.float16); w4=torch.randn((4*H,D),device='cuda',dtype=torch.float16); w1=torch.randn((H,D),device='cuda',dtype=torch.float16)
    o5=torch.empty((rows,5*H),device='cuda',dtype=torch.float16); o4=torch.empty((rows,4*H),device='cuda',dtype=torch.float16); o1=torch.empty((rows,H),device='cuda',dtype=torch.float16)
    def one(): torch.mm(x,w5.t(),out=o5,out_dtype=torch.float16)
    def split():
        torch.mm(x,w4.t(),out=o4,out_dtype=torch.float16)
        torch.mm(x,w1.t(),out=o1,out_dtype=torch.float16)
    print('rows',rows,'one',ev(one),'split',ev(split),flush=True)

import torch, triton
import submission as s

torch.manual_seed(1)

def make(N,B,D,H,nomask):
    x=torch.randn((B,N,N,D),device='cuda')
    mask=None if nomask else (torch.rand((B,N,N),device='cuda')>0.2).float()
    w={
        'norm.weight': torch.randn(D,device='cuda'), 'norm.bias': torch.randn(D,device='cuda'),
        'left_proj.weight': torch.randn(H,D,device='cuda'), 'right_proj.weight': torch.randn(H,D,device='cuda'),
        'left_gate.weight': torch.randn(H,D,device='cuda'), 'right_gate.weight': torch.randn(H,D,device='cuda'),
        'out_gate.weight': torch.randn(H,D,device='cuda'), 'to_out_norm.weight': torch.randn(H,device='cuda'),
        'to_out_norm.bias': torch.randn(H,device='cuda'), 'to_out.weight': torch.randn(D,H,device='cuda'),
    }
    return x,mask,w

def evtime(fn, reps=5):
    for _ in range(2): fn()
    torch.cuda.synchronize()
    ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def profile(N=1024,B=1,D=384,H=128,nomask=True):
    x_in,mask,w=make(N,B,D,H,nomask)
    f16=torch.float16; f32=torch.float32; rows=B*N*N; n2=N*N; device=x_in.device
    key=(device,B,N,D,H,'prof')
    x=s._buf(key,'x_norm',x_in.shape,f16,device)
    left=s._buf(key,'left_b',(B*H,N,N),f16,device); right=s._buf(key,'right_b',(B*H,N,N),f16,device)
    out_gate=s._buf(key,'out_gate',(B,N,N,H),f16,device)
    proj=s._buf(key,'proj',(B,N,N,5*H),f16,device)
    out_h=s._buf(key,'out_h',(B*H,N,N),f16,device)
    out=s._buf(key,'out',x_in.shape,f32,device)
    mask_arg=x_in if mask is None else mask
    proj_w=s._proj_weight(w,f16,D,H); to_out=s._to_out_weight_t(w,f16)
    def ln():
        s._input_ln384_kernel[(triton.cdiv(rows,4 if N>=1024 else 1),)](x_in,w['norm.weight'].to(f32),w['norm.bias'].to(f32),x,rows=rows,BLOCK_R=4 if N>=1024 else 1,num_warps=1)
    def mm():
        torch.mm(x.view(rows,D), proj_w.t(), out=proj.view(rows,5*H), out_dtype=f16)
    def post():
        if nomask:
            s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,left,right,out_gate,rows=rows,n2=n2,H=H,BLOCK_R=16,BLOCK_H=64,num_warps=8)
        else:
            s._post_proj_transpose_kernel[(triton.cdiv(rows,16),triton.cdiv(H,64))](proj,mask_arg,left,right,out_gate,rows=rows,n2=n2,H=H,NOMASK=nomask,BLOCK_R=16,BLOCK_H=64,num_warps=8)
    def bmm():
        torch.bmm(left, right.transpose(1,2), out=out_h, out_dtype=f16)
    def outk():
        s._ln_gate_out_kernel[(triton.cdiv(rows,128),)](out_h.view(B,H,N,N),out_gate,w['to_out_norm.weight'].to(f32),w['to_out_norm.bias'].to(f32),to_out,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=128,BLOCK_D=64,num_warps=4)
    # initialize deps
    ln(); mm(); post(); bmm(); outk(); torch.cuda.synchronize()
    for name,fn in [('ln',ln),('mm',mm),('post',post),('bmm',bmm),('out',outk)]:
        print(N,B,D,nomask,name,evtime(fn), flush=True)


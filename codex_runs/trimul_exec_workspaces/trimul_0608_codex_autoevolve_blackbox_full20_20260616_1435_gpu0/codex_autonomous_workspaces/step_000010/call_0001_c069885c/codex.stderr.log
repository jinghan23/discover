        torch.mm(gated.view(rows,H), tow.t(), out=out.view(rows,D))
    print('case',N,B,D,'fused',ev(fused),'two_f32',ev(two_f32), flush=True)
for c in [(256,2,384),(768,1,384),(1024,1,384),(1024,1,128),(768,1,128)]: bench(*c)

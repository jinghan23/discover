/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def ev(fn,reps=10):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]
for N,B,D in [(256,2,128),(512,1,128),(256,2,384)]:
  H=128; rows=B*N*N; n2=N*N; dev='cuda'
  out_h=torch.randn((B,H,N,N),device=dev,dtype=torch.float16); gate=torch.rand((B,N,N,H),device=dev,dtype=torch.float16)
  nw=torch.randn(H,device=dev); nb=torch.randn(H,device=dev); tow=torch.randn(D,H,device=dev); tow_t=tow.to(torch.float16).t().contiguous(); out=torch.empty((B,N,N,D),device=dev,dtype=torch.float32)
  for BR in [16,32,64,128,256]:
    for BD in ([32,64,128] if D%128==0 else [32,64]):
      if D%BD: continue
      def fn(BR=BR,BD=BD): s._ln_gate_out_kernel[(triton.cdiv(rows,BR),)](out_h,gate,nw,nb,tow_t,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=BR,BLOCK_D=BD,num_warps=4)
      print('case',N,B,D,'BR',BR,'BD',BD,ev(fn), flush=True)

    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def bench(N,B,nomask,BR,BH,warps):
    H=128; rows=B*N*N; n2=N*N; dev='cuda'
    proj=torch.randn((B,N,N,5*H),device=dev,dtype=torch.float16)
    left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
    mask=None if nomask else (torch.rand((B,N,N),device=dev)>0.2).float()
    def fn():
        if nomask:
            s._post_proj_transpose_nomask_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,left,right,og,rows=rows,n2=n2,H=H,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
        else:
            s._post_proj_transpose_kernel[(triton.cdiv(rows,BR),triton.cdiv(H,BH))](proj,mask,left,right,og,rows=rows,n2=n2,H=H,NOMASK=False,BLOCK_R=BR,BLOCK_H=BH,num_warps=warps)
    print('N',N,'B',B,'nomask',nomask,'BR',BR,'BH',BH,'w',warps, ev(fn), flush=True)


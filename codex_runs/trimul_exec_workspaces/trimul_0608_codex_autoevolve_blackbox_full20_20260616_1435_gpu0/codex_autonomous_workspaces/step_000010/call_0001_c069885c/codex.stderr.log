import torch,triton,submission as s

def ev(fn,reps=5):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]
for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
  D=H=128; rows=B*N*N; n2=N*N; x=torch.randn((B,N,N,D),device='cuda'); left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)

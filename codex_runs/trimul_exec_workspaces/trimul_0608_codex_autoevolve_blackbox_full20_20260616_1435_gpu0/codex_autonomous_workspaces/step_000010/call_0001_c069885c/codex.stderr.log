import importlib, time, torch
import submission

torch.manual_seed(0)

def make_case(N,B,D,H,nomask,dist='normal'):
    if dist=='cauchy':
        x = torch.distributions.Cauchy(0,2).sample((B,N,N,D)).cuda().float()
    else:
        x = torch.randn((B,N,N,D), device='cuda', dtype=torch.float32)
    mask = None if nomask else (torch.rand((B,N,N), device='cuda') > 0.2).float()
    weights = {
        'norm.weight': torch.randn(D, device='cuda'),
        'norm.bias': torch.randn(D, device='cuda'),
        'left_proj.weight': torch.randn(H,D, device='cuda'),
        'right_proj.weight': torch.randn(H,D, device='cuda'),
        'left_gate.weight': torch.randn(H,D, device='cuda'),
        'right_gate.weight': torch.randn(H,D, device='cuda'),
        'out_gate.weight': torch.randn(H,D, device='cuda'),
        'to_out_norm.weight': torch.randn(H, device='cuda'),
        'to_out_norm.bias': torch.randn(H, device='cuda'),
        'to_out.weight': torch.randn(D,H, device='cuda'),
    }
    return x, mask, weights, {'dim':D, 'hidden_dim':H, 'nomask':nomask}

def bench(cfg):
    N,B,D,H,nomask,dist = cfg
    data = make_case(N,B,D,H,nomask,dist)
    for _ in range(3):
        y = submission.custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(10):
        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)
        st.record(); y=submission.custom_kernel(data); en.record(); en.synchronize()
        times.append(st.elapsed_time(en)*1000)
    print(cfg, 'median_us', sorted(times)[len(times)//2], 'min_us', min(times), flush=True)


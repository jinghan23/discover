import torch, triton
import submission as s

def ev(fn,reps=8):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def profile(N,B):
    D=H=128; rows=B*N*N; n2=N*N; dev='cuda'
    x=torch.randn((B,N,N,D),device=dev); mask_arg=x
    w={k:torch.randn(shape,device=dev) for k,shape in {
        'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),
        'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D),'to_out_norm.weight':(H,), 'to_out_norm.bias':(H,), 'to_out.weight':(D,H)}.items()}
    key=(dev,B,N,D,H,'p128')
    left=s._buf(key,'left_b',(B*H,N,N),torch.float16,x.device); right=s._buf(key,'right_b',(B*H,N,N),torch.float16,x.device); og=s._buf(key,'og',(B,N,N,H),torch.float16,x.device)
    out_h=s._buf(key,'outh',(B*H,N,N),torch.float16,x.device); out=s._buf(key,'out',x.shape,torch.float32,x.device)
    wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H); tow=s._to_out_weight_t(w,torch.float16)
    BM=64 if N==768 else 128; warps=4 if N==768 else 8
    def proj():
        s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,mask_arg,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=32,num_warps=warps)
    def bmm(): torch.bmm(left,right.transpose(1,2),out=out_h,out_dtype=torch.float16)
    def outk(): s._ln_gate_out_kernel[(triton.cdiv(rows,64),)](out_h.view(B,H,N,N),og,w['to_out_norm.weight'],w['to_out_norm.bias'],tow,out,rows=rows,n2=n2,H=H,D=D,BLOCK_R=64,BLOCK_D=64,num_warps=4)
    proj(); bmm(); outk(); torch.cuda.synchronize()
    print('case',N,B,'proj',ev(proj),'bmm',ev(bmm),'out',ev(outk), flush=True)
for c in [(256,2),(512,1),(768,1),(1024,1)]: profile(*c)

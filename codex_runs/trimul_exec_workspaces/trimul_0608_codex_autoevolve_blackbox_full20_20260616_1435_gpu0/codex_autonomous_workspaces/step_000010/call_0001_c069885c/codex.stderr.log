/bin/bash -lc "python - <<'PY'
import torch, triton
import submission as s

def ev(fn,reps=8):
    for _ in range(2): fn()
    torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); fn(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en)*1000)
    return min(ts), sorted(ts)[len(ts)//2]

def bench(N,B,BM,BH,warps):
    D=H=128; rows=B*N*N; n2=N*N; dev='cuda'
    x=torch.randn((B,N,N,D),device=dev); left=torch.empty((B*H,N,N),device=dev,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((B,N,N,H),device=dev,dtype=torch.float16)
    w={k:torch.randn(shape,device=dev) for k,shape in {'norm.weight':(D,), 'norm.bias':(D,), 'left_proj.weight':(H,D),'right_proj.weight':(H,D),'left_gate.weight':(H,D),'right_gate.weight':(H,D),'out_gate.weight':(H,D)}.items()}
    wl,wr,wlg,wrg,wog=s._proj_parts(w,torch.float16,D,H)
    def fn(): s._fused_proj128_4q_kernel[(triton.cdiv(rows,BM),)](x,x,w['norm.weight'],w['norm.bias'],wl,wr,wlg,wrg,wog,left,right,og,rows=rows,n2=n2,NOMASK=True,BLOCK_M=BM,BLOCK_H=BH,num_warps=warps)
    print('N',N,'B',B,'BM',BM,'BH',BH,'w',warps,ev(fn), flush=True)
configs=[]
for BM in [32,64,128,256]:
  for BH in [16,32,64]:
    for W in [4,8]:
      configs.append((BM,BH,W))
for case in [(256,2),(512,1),(768,1),(1024,1)]:
    for cfg in configs:
        if 128%cfg[1]==0:
            bench(*case,*cfg)

"""
Optimized outgoing TriMul forward: Triton handles row layernorms, projection
post-processing, gates, and masks; FP16 batched GEMMs compute the triangular
update; fp16-safe output paths fuse row-normalize, gate, and final projection
for dim 128/384/768, with fp32 fallback kept for unsupported dimensions.
"""

import torch
import triton
import triton.language as tl

torch.backends.cuda.matmul.allow_tf32 = True
torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
torch.backends.cudnn.allow_tf32 = True
torch.set_float32_matmul_precision("medium")

_PROJ_W_CACHE = {}
_PROJ_PARTS_CACHE = {}
_TO_OUT_CACHE = {}
_VEC_CACHE = {}
_BUF_CACHE = {}
_BUF_SHAPE = None


def _buf(shape_key, name, shape, dtype, device):
    global _BUF_SHAPE
    if _BUF_SHAPE != shape_key:
        _BUF_CACHE.clear()
        _BUF_SHAPE = shape_key
    key = (name, dtype)
    cached = _BUF_CACHE.get(key)
    if cached is None:
        cached = torch.empty(shape, device=device, dtype=dtype)
        _BUF_CACHE[key] = cached
    return cached


def _proj_weight(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    key = (str(dtype), refs, tuple(w._version for w in refs))
    cached = _PROJ_W_CACHE.get(key)
    if cached is not None:
        return cached
    if len(_PROJ_W_CACHE) > 8:
        _PROJ_W_CACHE.clear()
    cached = torch.cat(
        (
            refs[0].to(dtype),
            refs[1].to(dtype),
            refs[2].to(dtype),
            refs[3].to(dtype),
            refs[4].to(dtype),
        ),
        dim=0,
    ).contiguous()
    _PROJ_W_CACHE[key] = cached
    return cached


def _proj_weight_t(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    key = ("t", str(dtype), refs, tuple(w._version for w in refs))
    cached = _PROJ_W_CACHE.get(key)
    if cached is not None:
        return cached
    if len(_PROJ_W_CACHE) > 8:
        _PROJ_W_CACHE.clear()
    cached = torch.cat(
        (
            refs[0].to(dtype),
            refs[1].to(dtype),
            refs[2].to(dtype),
            refs[3].to(dtype),
            refs[4].to(dtype),
        ),
        dim=0,
    ).t().contiguous()
    _PROJ_W_CACHE[key] = cached
    return cached


def _proj_parts(weights, dtype, dim, hidden_dim):
    refs = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
    )
    key = (str(dtype), refs, tuple(w._version for w in refs))
    cached = _PROJ_PARTS_CACHE.get(key)
    if cached is not None:
        return cached
    if len(_PROJ_PARTS_CACHE) > 8:
        _PROJ_PARTS_CACHE.clear()
    cached = tuple(w.to(dtype).contiguous() for w in refs)
    _PROJ_PARTS_CACHE[key] = cached
    return cached


def _to_out_weight_t(weights, dtype):
    ref = weights["to_out.weight"]
    key = (str(dtype), ref, ref._version)
    cached = _TO_OUT_CACHE.get(key)
    if cached is not None:
        return cached
    if len(_TO_OUT_CACHE) > 8:
        _TO_OUT_CACHE.clear()


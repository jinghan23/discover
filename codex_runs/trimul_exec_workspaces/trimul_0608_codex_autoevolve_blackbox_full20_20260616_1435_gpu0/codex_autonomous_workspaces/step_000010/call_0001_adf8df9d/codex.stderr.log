+def _graph_key(input_tensor, mask, weights, config):
+    refs = (
+        weights["norm.weight"],
+        weights["norm.bias"],
+        weights["left_proj.weight"],
+        weights["right_proj.weight"],
+        weights["left_gate.weight"],
+        weights["right_gate.weight"],
+        weights["out_gate.weight"],
+        weights["to_out_norm.weight"],
+        weights["to_out_norm.bias"],
+        weights["to_out.weight"],
+    )
+    mask_ptr = 0 if mask is None else mask.data_ptr()
+    return (
+        tuple(input_tensor.shape),
+        input_tensor.data_ptr(),
+        mask_ptr,
+        bool(config.get("nomask", False)) or mask is None,
+        refs,
+        tuple(w._version for w in refs),
+    )
+
+
+def custom_kernel(data):
+    global _GRAPH_KEY, _GRAPH, _GRAPH_OUT
+    input_tensor, mask, weights, config = data
+    key = _graph_key(input_tensor, mask, weights, config)
+    if _GRAPH is not None and _GRAPH_KEY == key:
+        _GRAPH.replay()
+        return _GRAPH_OUT
+
+    out = _custom_impl(data)
+    if input_tensor.is_cuda:
+        try:
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                graph_out = _custom_impl(data)
+            _GRAPH_KEY = key
+            _GRAPH = graph
+            _GRAPH_OUT = graph_out
+        except Exception:
+            _GRAPH_KEY = None
+            _GRAPH = None
+            _GRAPH_OUT = None
+    return out


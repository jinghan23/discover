/bin/bash -lc "python - <<'PY'
import sympy as s
x,a=s.symbols('x a')
# probabilist Hermite
H=lambda n: s.hermite_prob(n,x)
for k in range(1,5):
  for n in (3,4,6):
    p=s.expand((a+x)**k*H(n))
    # integral each monomial x"'^j from h=-a to inf via recurrence I_j=h''^(j-1)phi+(j-1)I_(j-2), I0=Phi omitted; n>k => no I0 expected
    h=-a
    I={0:s.Symbol('"'P'),1:s.Integer(1)} # coefficient to phi except I0
    # represent pair P coeff, phi coeff
    pairs={0:(1,0),1:(0,1)}
    for j in range(2,k+n+1):
      pp,qq=pairs[j-2]
      pairs[j]=((j-1)*pp, h**(j-1)+(j-1)*qq)
    cp=0;cq=0
    for term in s.Poly(p,x).terms():
      (j,),coef=term
      pp,qq=pairs[j]
      cp+=coef*pp;cq+=coef*qq
    print('k',k,'n',n,'P',s.simplify(cp),'phi',s.factor(s.simplify(cq)))

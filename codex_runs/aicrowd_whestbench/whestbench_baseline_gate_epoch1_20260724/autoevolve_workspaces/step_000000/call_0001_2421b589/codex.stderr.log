+            one_minus_r2 = fnp.maximum(1.0 - rho * rho, 1e-12)
+            root = fnp.sqrt(one_minus_r2)
+            cond_ij = flops.stats.norm.cdf((ai - rho * aj) / root)
+            cond_ji = flops.stats.norm.cdf((aj - rho * ai) / root)
+            joint_pdf = (

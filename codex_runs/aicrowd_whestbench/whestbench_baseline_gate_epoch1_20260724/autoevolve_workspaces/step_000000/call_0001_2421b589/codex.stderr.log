+                radial_second_ratio * (var_pre + mu_pre * mu_pre)
+                - mu_pre * mu_pre
+            )
+            cv_mean = (
+                sample_relu_mean
+                - cdf * (sample_pre_mean - mu_pre)
+                - (pdf / (2.0 * sigma))
+                * (sample_center2 - directional_center2)
+            )
+            if layer_index == 0:
+                mu = gaussian_mu
+            else:
+                mu = 0.1 * gaussian_mu + 0.9 * cv_mean
+            var = fnp.maximum(ez2 - gaussian_mu * gaussian_mu, 0.0)
+
+            sigma_outer = fnp.outer(sigma, sigma)
+            rho = fnp.clip(cov_pre / sigma_outer, -0.999999, 0.999999)
+            rho2 = rho * rho
+            c2 = sigma * pdf
+            c3 = -c2 * a
+            c4 = c2 * (a * a - 1.0)
+            cov = (
+                cov_pre * fnp.outer(cdf, cdf)
+                + 0.5 * fnp.outer(c2, c2) * rho2
+                + (1.0 / 6.0) * fnp.outer(c3, c3) * rho2 * rho
+                + (1.0 / 24.0) * fnp.outer(c4, c4) * rho2 * rho2
+            )
+            cov = cov - fnp.diag(fnp.diagonal(cov)) + fnp.diag(var)
+            cov = 0.5 * (cov + cov.T)
             rows.append(mu)
+
         return fnp.stack(rows, axis=0)

codex
The sort/PPF setup has made this run longer than the plain-probe hybrid. A strong variance reduction is therefore required for it to win after residual-time adjustment.

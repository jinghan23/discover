import numpy as np, math
from scipy import stats
from scipy.stats import qmc

def forward(X, Ws):
    A=X
    for W in Ws:
        A=np.maximum(A@W,0)
    return A.mean(axis=0)

def analytic_diag(Ws):
    W=Ws[0]
    var=(W*W).sum(axis=0)
    sig=np.sqrt(var)
    m=sig/np.sqrt(2*np.pi)
    q=0.5*var
    for W in Ws[1:]:
        mu=m@W
        v=np.maximum((q-m*m)@(W*W),1e-30)
        sig=np.sqrt(v); a=mu/sig
        Phi=stats.norm.cdf(a); phi=np.exp(-0.5*a*a)/np.sqrt(2*np.pi)
        m=sig*phi+mu*Phi
        q=(v+mu*mu)*Phi+mu*sig*phi
    return m

def sobol(n,w,seed,scramble=True,skip=0):
    sampler=qmc.Sobol(d=w, scramble=scramble, seed=seed if scramble else None)
    if skip:
        sampler.fast_forward(skip)
    u=sampler.random_base2(int(np.log2(n)))
    if scramble or skip:
        pass
    u=np.clip(u,1e-11,1-1e-11)
    return stats.norm.ppf(u)

def sphere(Z,w):
    R=np.linalg.norm(Z,axis=1)
    cm=math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
    return Z/np.maximum(R[:,None],1e-30)*cm

settings=[(16,4,128),(32,4,64),(64,4,64),(64,6,64),(128,4,32),(64,8,128)]
for w,d,n in settings:
 vals={k:[] for k in ['base','sphere','diag','b01','b02','b03','b05','shift0','skip']}
 for seed in range(12):
  rng=np.random.default_rng(seed)
  Ws=[rng.standard_normal((w,w))*np.sqrt(2/w) for _ in range(d)]
  true=forward(rng.standard_normal((200000 if w<=64 else 100000,w)),Ws)
  Z=sobol(n,w,1000+seed,True)
  est=forward(Z,Ws)
  an=analytic_diag(Ws)
  vals['base'].append(np.mean((est-true)**2))
  vals['sphere'].append(np.mean((forward(sphere(Z,w),Ws)-true)**2))
  vals['diag'].append(np.mean((an-true)**2))
  for b in [0.1,0.2,0.3,0.5]:
   vals[f'b{str(b).replace(\".\",\"\")}'].append(np.mean(((1-b)*est+b*an-true)**2))
  # Unscrambled skip avoids all-zero first point.
  Zu=sobol(n,w,0,False,skip=n)
  vals['skip'].append(np.mean((forward(Zu,Ws)-true)**2))
 print((w,d,n), {k:float(np.mean(v)) for k,v in vals.items()})

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy import stats
from scipy.stats import qmc


def forward(X, Ws):
    A=X
    means=[]
    for W in Ws:
        A=np.maximum(A@W,0)
        means.append(A.mean(axis=0))
    return np.stack(means), A

def analytic_diag(Ws):
    rows=[]
    W=Ws[0]
    var=(W*W).sum(axis=0)
    sig=np.sqrt(np.maximum(var,0))
    m=sig/np.sqrt(2*np.pi)
    q=0.5*var
    rows.append(m)
    for W in Ws[1:]:
        mu=m@W
        v=(q-m*m)@(W*W)
        sig=np.sqrt(np.maximum(v,1e-30))
        a=mu/sig
        Phi=stats.norm.cdf(a)
        phi=np.exp(-0.5*a*a)/np.sqrt(2*np.pi)
        m=sig*phi+mu*Phi
        q=(v+mu*mu)*Phi+mu*sig*phi
        rows.append(m)
    return np.stack(rows)

def sobol(n,w,seed,anti=False):
    if anti:
        h=max(1,n//2)
        m=int(np.log2(h))
        sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
        u=sampler.random_base2(m)
        u=np.clip(u,1e-11,1-1e-11)
        z=stats.norm.ppf(u)
        X=np.concatenate([z,-z],axis=0)
        if X.shape[0]>n: X=X[:n]
        return X
    else:
        m=int(np.log2(n))
        sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
        u=sampler.random_base2(m)
        u=np.clip(u,1e-11,1-1e-11)
        return stats.norm.ppf(u)

def normal(n,w,seed,anti=False):
    rng=np.random.default_rng(seed)
    if anti:
        z=rng.standard_normal((n//2,w))
        return np.concatenate([z,-z],axis=0)
    return rng.standard_normal((n,w))

for scale_name, scale_fn in [('xavier', lambda w:1/np.sqrt(w)),('he',lambda w:np.sqrt(2/w)),('std',lambda w:1.0)]:
  print('SCALE', scale_name)
  for w,d,n in [(16,4,128),(32,4,64),(64,4,32),(32,8,64),(128,4,16)]:
    mse_s=[]; mse_a=[]; mse_an=[]; blends={b:[] for b in [0.05,0.1,0.2,0.3,0.5]}
    for seed in range(50):
        rng=np.random.default_rng(seed)
        Ws=[rng.standard_normal((w,w))*scale_fn(w) for _ in range(d)]
        Xtrue=rng.standard_normal((200000,w))
        true,_=forward(Xtrue,Ws)
        an=analytic_diag(Ws)
        X=sobol(n,w,1000+seed,False)
        est,_=forward(X,Ws)
        Xa=sobol(n,w,1000+seed,True)
        esta,_=forward(Xa,Ws)
        t=true[-1]
        mse_s.append(np.mean((est[-1]-t)**2))
        mse_a.append(np.mean((esta[-1]-t)**2))
        mse_an.append(np.mean((an[-1]-t)**2))
        for b in blends:
            mix=(1-b)*esta[-1]+b*an[-1]
            blends[b].append(np.mean((mix-t)**2))
    print((w,d,n),'sobol',np.mean(mse_s),'anti',np.mean(mse_a),'diag',np.mean(mse_an),'blend', {b:np.mean(v) for b,v in blends.items()})
PY" in /opt/tiger/discover/workspace

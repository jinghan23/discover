 _UINT_SCALE = 1.0 / 1073741824.0
 _SOBOL_DIMENSIONS = 256
 _SOBOL_MAXDEG = 18
+_GAUSSIAN_BLEND = 0.20
+_MIN_VARIANCE = 1e-30
 
 _SOBOL_BLOB = (
     "c-oDc0c6$d8^@pL_uFs3|M{Q)am+EtF*C``%*-"
@@ -183,6 +185,36 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, _MIN_VARIANCE)
+    standard_deviation = fnp.sqrt(variance)
+    alpha = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    return relu_mean, relu_second
+
+
+def _diagonal_gaussian_rows(weights) -> list[fnp.ndarray]:
+    first_weight = weights[0]
+    pre_variance = fnp.sum(first_weight * first_weight, axis=0)
+    mean = fnp.sqrt(pre_variance) / fnp.sqrt(2.0 * fnp.pi)
+    second = 0.5 * pre_variance
+    variance = fnp.maximum(second - mean * mean, 0.0)
+    rows = [mean]
+
+    for weight in weights[1:]:
+        pre_mean = mean @ weight
+        pre_variance = variance @ (weight * weight)
+        mean, second = _relu_gaussian_moments(pre_mean, pre_variance)
+        variance = fnp.maximum(second - mean * mean, 0.0)
+        rows.append(mean)
+    return rows
+
+

I found a more structural variance reduction: the bias-free ReLU MLP is positively homogeneous, so for Gaussian input `X = R * S`, the radial factor can be integrated exactly. I’ll test normalized Sobol directions times the exact chi-radius mean on synthetic networks.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy import stats
from scipy.stats import qmc

def forward(X, Ws):
    A=X
    rows=[]
    for W in Ws:
        A=np.maximum(A@W,0)
        rows.append(A.mean(axis=0))
    return np.stack(rows)

def sobol_norm(n,w,seed):
    sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
    u=sampler.random_base2(int(np.log2(n)))
    u=np.clip(u,1e-11,1-1e-11)
    return stats.norm.ppf(u)

def chi_mean(w):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

for scale_name, scale_fn in [('xavier', lambda w:1/np.sqrt(w)),('he',lambda w:np.sqrt(2/w))]:
 print('SCALE',scale_name)
 for w,d,n in [(16,4,128),(32,4,64),(64,4,64),(64,6,64),(128,4,32),(64,8,128)]:
  base=[]; sphere=[]; sphere_n2=[]
  for seed in range(30):
    rng=np.random.default_rng(seed)
    Ws=[rng.standard_normal((w,w))*scale_fn(w) for _ in range(d)]
    Xtrue=rng.standard_normal((300000 if w<=64 else 150000,w))
    true=forward(Xtrue,Ws)[-1]
    Z=sobol_norm(n,w,1000+seed)
    est=forward(Z,Ws)[-1]
    R=np.linalg.norm(Z,axis=1)
    S=Z/np.maximum(R[:,None],1e-30)
    ests=forward(S,Ws)[-1]*chi_mean(w)
    Z2=sobol_norm(max(1,n//2),w,2000+seed)
    R2=np.linalg.norm(Z2,axis=1)
    S2=Z2/np.maximum(R2[:,None],1e-30)
    ests2=forward(S2,Ws)[-1]*chi_mean(w)
    base.append(np.mean((est-true)**2)); sphere.append(np.mean((ests-true)**2)); sphere_n2.append(np.mean((ests2-true)**2))
  print((w,d,n),'base',np.mean(base),'sphere',np.mean(sphere),'sphere n/2',np.mean(sphere_n2))

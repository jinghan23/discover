--- a/submission.py
+++ b/submission.py
@@ -15,6 +15,8 @@
 _TARGET_FLOP_FRACTION = 0.13
 _SEED_OFFSET = 0x9E3779B9
 _TAIL_CLIP = 1e-11
+_ANALYTIC_BLEND = 0.10
+_MIN_VARIANCE = 1e-20
 _BITS = 30
 _UINT_SCALE = 1.0 / 1073741824.0
 _SOBOL_DIMENSIONS = 256
@@ -183,6 +185,33 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, _MIN_VARIANCE)
+    standard_deviation = fnp.sqrt(variance)
+    z = mean / standard_deviation
+    probability = flops.stats.norm.cdf(z)
+    density = flops.stats.norm.pdf(z)
+    relu_mean = standard_deviation * density + mean * probability
+    relu_second = (
+        (variance + mean * mean) * probability
+        + mean * standard_deviation * density
+    )
+    return relu_mean, relu_second
+
+
+def _diagonal_gaussian_final(mlp) -> fnp.ndarray:
+    mean = fnp.zeros(mlp.width)
+    second = fnp.ones(mlp.width)
+    for weight in mlp.weights:
+        variance = fnp.maximum(second - mean * mean, 0.0)
+        pre_mean = mean @ weight
+        pre_variance = variance @ (weight * weight)
+        mean, second = _relu_gaussian_moments(pre_mean, pre_variance)
+    return mean
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     normal_per_sample = 92 * width
     forward_per_sample = depth * (2 * width * width + width)
@@ -196,6 +225,10 @@
 class Estimator(BaseEstimator):
     """LMS+shift Sobol estimator with an exact first output row."""
 
+    def setup(self, context):
+        _sobol_params()
+        _base_directions(int(context.width), _BITS)
+
     def predict(self, mlp, budget):
         n_samples = _sample_count(budget, mlp.width, mlp.depth)
         rng = fnp.random.default_rng((int(mlp.seed) + _SEED_OFFSET) & 0xFFFFFFFF)
@@ -210,4 +243,7 @@
                 rows.append(_exact_first_layer_mean(weight))
             else:
                 rows.append(fnp.mean(activations, axis=0))
+        if mlp.depth > 1:
+            analytic_final = _diagonal_gaussian_final(mlp)
+            rows[-1] = (1.0 - _ANALYTIC_BLEND) * rows[-1] + _ANALYTIC_BLEND * analytic_final
         return fnp.stack(rows, axis=0)


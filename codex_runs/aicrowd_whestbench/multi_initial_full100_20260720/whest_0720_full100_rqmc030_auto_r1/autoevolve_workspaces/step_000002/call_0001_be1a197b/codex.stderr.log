diff --git a/submission.py b/submission.py
index 0c195222e23e4e7166367218554412396aa62071..542b372af5d0655e80b74092dd2afebf7dbc93f9
--- a/submission.py
+++ b/submission.py
@@ -15,6 +15,7 @@
 _TARGET_FLOP_FRACTION = 0.13
 _SEED_OFFSET = 0x9E3779B9
 _TAIL_CLIP = 1e-11
+_CONTROL_EPS = 1e-12
 _BITS = 30
 _UINT_SCALE = 1.0 / 1073741824.0
 _SOBOL_DIMENSIONS = 256
@@ -196,6 +197,10 @@
 class Estimator(BaseEstimator):
     """LMS+shift Sobol estimator with an exact first output row."""
 
+    def setup(self, context):
+        _sobol_params()
+        _base_directions(int(context.width), _BITS)
+
     def predict(self, mlp, budget):
         n_samples = _sample_count(budget, mlp.width, mlp.depth)
         rng = fnp.random.default_rng((int(mlp.seed) + _SEED_OFFSET) & 0xFFFFFFFF)
@@ -204,10 +209,23 @@
         activations = flops.stats.norm.ppf(uniforms)
 
         rows = []
+        first_activations = None
+        first_exact_mean = None
         for layer_index, weight in enumerate(mlp.weights):
             activations = fnp.maximum(activations @ weight, 0.0)
             if layer_index == 0:
-                rows.append(_exact_first_layer_mean(weight))
+                first_activations = activations
+                first_exact_mean = _exact_first_layer_mean(weight)
+                rows.append(first_exact_mean)
             else:
                 rows.append(fnp.mean(activations, axis=0))
+        if mlp.depth > 1:
+            first_mean = fnp.mean(first_activations, axis=0)
+            final_mean = rows[-1]
+            first_centered = first_activations - first_mean[None, :]
+            final_centered = activations - final_mean[None, :]
+            variance = fnp.mean(first_centered * first_centered, axis=0) + _CONTROL_EPS
+            covariance = (first_centered.T @ final_centered) / n_samples
+            coefficients = covariance / variance[:, None]
+            rows[-1] = final_mean + (first_exact_mean - first_mean) @ coefficients
         return fnp.stack(rows, axis=0)


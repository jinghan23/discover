        setup_activations = getattr(self, "_setup_activations", None)
        if isinstance(setup_activations, tuple):
            if _SETUP_BLOCK_FORCE >= 0:
                block_index = _SETUP_BLOCK_FORCE % len(setup_activations)
            else:
                block_index = (
                    (int(mlp.seed) >> _SETUP_BLOCK_SHIFT)
                    + _SETUP_BLOCK_OFFSET
                ) % len(setup_activations)
            setup_activations = setup_activations[
                block_index

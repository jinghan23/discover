        if response.get("status") == "time_exhausted":
            raise flops.TimeExhaustedError("subprocess_predict", elapsed_s=0.0, limit_s=0.0)
        if response.get("status") == "error":
            details = response.get("details")
            if not isinstance(details, dict):
                details = None
            raise RunnerError(

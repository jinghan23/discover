/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats._qmc import _initialize_v
from scipy.stats import _sobol
B=8;D=3
sv=np.zeros((D,B),dtype=np.uint32); _initialize_v(sv,dim=D,bits=B)
rng=np.random.default_rng(123)
ltm=np.tril(rng.integers(0,2,size=(D,B,B),dtype=np.uint32))
sv2=sv.copy(); _sobol._cscramble(dim=D,bits=B,ltm=ltm.copy(),sv=sv2)

def scramble_int(v,L,B,mode):
 out=0
 for r in range(B):
  bit=0
  for c in range(B):
   cond=False
   if mode==0: cond = c<=r and L[r,c]
   if mode==1: cond = c>=r and L[c,r]
   if mode==2: cond = c<=r and L[B-1-r,B-1-c]
   if mode==3: cond = c>=r and L[B-1-c,B-1-r]
   if cond:
    bit "'^= (v >> (B-1-c)) & 1
  out |= bit << (B-1-r)

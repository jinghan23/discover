import time, math
import numpy as np
import scipy.special
W=256; D=32; seed=123
rng=np.random.default_rng(seed)
weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]
# generate target 500k? reuse smaller maybe exact not saved. Do target 300k plus split for noise.
def mc(n, seed, chunk=5000):
    rng=np.random.default_rng(seed); sums=np.zeros((D,W));
    for done in range(0,n,chunk):
        m=min(chunk,n-done); x=rng.standard_normal((m,W))
        for l,w in enumerate(weights):
            x=np.maximum(x@w,0); sums[l]+=x.sum(0)
    return sums/n

def first_primes(count):
    primes=[]; candidate=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>candidate: break
            if candidate%p==0: ok=False; break
        if ok: primes.append(candidate)
        candidate+=1
    return np.array(primes)

def lattice(n, shift_seed=777):
    gen=np.sqrt(first_primes(W)); gen=gen-np.floor(gen)
    shift=np.random.default_rng(shift_seed).random(W)
    U=(np.arange(n)[:,None]*gen[None,:]+shift[None,:])%1.0
    U=np.clip(U,1e-11,1-1e-11)
    x=scipy.special.ndtri(U)
    rows=[]
    for l,w in enumerate(weights):
        x=np.maximum(x@w,0)
        if l==0:
            sd=np.sqrt((w*w).sum(0)); rows.append(sd/math.sqrt(2*math.pi))
        else:
            rows.append(x.mean(0))
    return np.stack(rows)

def iid(n, seed=777):
    rng=np.random.default_rng(seed); x=rng.standard_normal((n,W)); rows=[]
    for l,w in enumerate(weights):
        x=np.maximum(x@w,0); rows.append(x.mean(0))
    return np.stack(rows)

t=time.time(); target=mc(500000,999); print('target time',time.time()-t)
for n in [4096,8192,16384,20000,32768,65536]:

Full Sobol scrambling may be too expensive to reimplement, but a digital-shift Sobol net is simple and compliant. I’m checking its synthetic quality against SciPy’s full scramble before embedding constants.
exec
/bin/bash -lc "python - <<'PY'
import math, numpy as np, scipy.special
from scipy.stats import qmc, _sobol
from scipy.stats._qmc import _initialize_v
W=256;D=32;BITS=32
V=np.zeros((W,BITS),dtype=np.uint32); _initialize_v(V,dim=W,bits=BITS)
def sob_shift(N,seed):
 rng=np.random.default_rng(seed); idx=np.arange(N,dtype=np.uint32); gray=idx"'^(idx>>1); X=np.zeros((N,W),dtype=np.uint32)
 for b in range(int(math.ceil(math.log2(max(N,1))))):
  mask=((gray>>b)&1).astype(np.uint32)[:,None]
  X ''^= mask*V[:,b][None,:]
 shift=rng.integers(0,2**32,size=W,dtype=np.uint32)
 X ''^= shift[None,:]
 return scipy.special.ndtri(np.clip(X.astype(np.float64)/2**32,1e-11,1-1e-11))
def sob_lms(N,seed):
 m=math.ceil(math.log2(N)); return scipy.special.ndtri(np.clip(qmc.Sobol(W,scramble=True,seed=seed).random_base2(m)[:N],1e-11,1-1e-11))
def weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
def fwd(ws,x):
 for w in ws:x=np.maximum(x@w,0)
 return x
def mc(ws,N,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,N,chunk):
  x=r.standard_normal((min(chunk,N-done),W)); s+=fwd(ws,x).sum(0)
 return s/N
for N in [4096,8192]:
 vals=[]
 for sd in [301,302,303,304,305]:
  ws=weights(sd); tgt=mc(ws,250000,1000+sd)
  y1=fwd(ws,sob_shift(N,777)).mean(0); y2=fwd(ws,sob_lms(N,777)).mean(0)
  vals.append((((y1-tgt)**2).mean(),((y2-tgt)**2).mean()))
  print('"'N',N,'net',sd,'shift lms',vals[-1])
 print('AVG',N,np.mean(vals,0))

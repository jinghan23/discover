 for j in range(W): U[:,j]=(r.permutation(N)+jit[:,j])/N
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
def sob(N,seed):
 m=math.ceil(math.log2(N)); sampler=qmc.Sobol(d=W, scramble=True, seed=seed)
 U=sampler.random_base2(m)[:N]
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
for N in [4096,8192,16384]:
 vals=[]
 for sd in [291,292,293,294,295]:
  ws=weights(sd); tgt=mc(ws,250000,1000+sd)
  y1=fwd(ws,lhs(N,777)).mean(0); y2=fwd(ws,sob(N,777)).mean(0)
  vals.append((((y1-tgt)**2).mean(),((y2-tgt)**2).mean()))
  print('N',N,'net',sd,'lhs sobol',vals[-1])
 print('AVG',N,np.mean(vals,0))

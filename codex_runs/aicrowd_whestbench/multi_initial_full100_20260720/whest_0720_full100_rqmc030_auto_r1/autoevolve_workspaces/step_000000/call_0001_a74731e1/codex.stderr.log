import time, math
import numpy as np
import scipy.special
W=256; D=32

def make_weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]

def forward(weights,x):
 for w in weights: x=np.maximum(x@w,0)
 return x

def mc(weights,n,seed,chunk=5000):
 rng=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,n,chunk):
  x=rng.standard_normal((min(chunk,n-done),W))
  s+=forward(weights,x).sum(0)
 return s/n

def primes(count):
 ps=[]; c=2
 while len(ps)<count:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps)
P=primes(W)

def normals_lattice(n,seed,kind='sqrt'):
 rng=np.random.default_rng(seed)
 if kind=='sqrt': gen=np.sqrt(P)%1
 elif kind=='gold':
  phi=(math.sqrt(5)-1)/2; gen=np.array([(phi**(j+1))%1 for j in range(W)])
 elif kind=='rand': gen=rng.random(W)
 elif kind=='korobov':
  a=17797; N=n; z=[]; val=1
  for j in range(W): z.append(val/N); val=(val*a)%N
  gen=np.array(z)
 elif kind=='addrec':
  # generalized golden ratio approximate: alpha powers of root x"'^(d+1)=x+1 impossible, use constants
  alpha=0.7548776662466927; gen=np.array([(alpha**(j+1))%1 for j in range(W)])
 shift=rng.random(W)
 U=(np.arange(n)[:,None]*gen[None,:]+shift)%1
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def normals_antithetic_lattice(n,seed):
 half=n//2
 X=normals_lattice(half,seed,'"'sqrt')
 return np.vstack([X,-X]) if 2*half==n else np.vstack([X,-X,X[:1]])

def normals_lhs(n,seed):
 rng=np.random.default_rng(seed)
 U=np.empty((n,W))
 jit=rng.random((n,W))
 for j in range(W):
  U[:,j]=(rng.permutation(n)+jit[:,j])/n
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def normals_oa_lhs(n,seed):
 return normals_lhs(n,seed)

methods=[]
for kind in ['sqrt','gold','rand','korobov','addrec']:
 methods.append((kind,lambda n,s,k=kind:normals_lattice(n,s,k)))
methods.append(('anti_sqrt',normals_antithetic_lattice))
methods.append(('lhs',normals_lhs))

for netseed in [201,202,203]:
 weights=make_weights(netseed)
 t=time.time(); target=mc(weights,300000,900+netseed); print('\\nnet',netseed,'target time',time.time()-t)
 for n in [8192,20000,32768]:
  vals=[]
  for name,gen in methods:
   x=gen(n,777)
   y=forward(weights,x).mean(0)
   vals.append((name,((y-target)**2).mean()))
  print('N',n,sorted(vals,key=lambda x:x[1])[:10])

import time, math
import numpy as np
import scipy.special
W=256; D=32; seed=126
rng=np.random.default_rng(seed)
weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]
w0=weights[0]
s=np.sqrt((w0*w0).sum(0)); mu1=s/math.sqrt(2*math.pi)
C=w0.T@w0; rho=C/(s[:,None]*s[None,:]); rho=np.clip(rho,-1,1)
M2=(s[:,None]*s[None,:])/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)
np.fill_diagonal(M2,s*s/2)

def mc(n, seed, chunk=5000):
    rng=np.random.default_rng(seed); sums=np.zeros((D,W))
    for done in range(0,n,chunk):
        x=rng.standard_normal((min(chunk,n-done),W))
        for l,w in enumerate(weights):
            x=np.maximum(x@w,0); sums[l]+=x.sum(0)
    return sums/n

def lattice(n, shift_seed=777):
    primes=[]; c=2
    while len(primes)<W:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    gen=np.sqrt(np.array(primes))%1; shift=np.random.default_rng(shift_seed).random(W)
    U=(np.arange(n)[:,None]*gen[None,:]+shift[None,:])%1
    return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def forward(x):
    h1=None
    for l,w in enumerate(weights):
        x=np.maximum(x@w,0)
        if l==0: h1=x.copy()
    return h1,x

def cv_est(h1,y,R,mode='same'):
    n=len(y); p=n//2
    Zlin=h1
    if R is None:
        F=Zlin; emean=mu1
    else:
        Z=h1@R
        F=np.concatenate([Zlin, Z*Z], axis=1)
        qmean=np.einsum('ir,ij,jr->r',R,M2,R)
        emean=np.concatenate([mu1,qmean])
    if mode=='same':
        Ffit=F; Yfit=y; Fest=F; Yest=y
    else:
        Ffit=F[:p]; Yfit=y[:p]; Fest=F[p:]; Yest=y[p:]
    Fc=Ffit-Ffit.mean(0); Yc=Yfit-Yfit.mean(0)
    XtX=Fc.T@Fc; XtY=Fc.T@Yc
    lam=1e-4*np.trace(XtX)/XtX.shape[0]
    B=np.linalg.solve(XtX+lam*np.eye(XtX.shape[0]), XtY)
    return Yest.mean(0) - (Fest.mean(0)-emean)@B, np.var(Yest-(Fest-emean)@B,axis=0).mean(), F.shape[1]

t=time.time(); target=mc(500000,999); print('target time',time.time()-t)
for n in [8192,20000,65536]:
  x=lattice(n,777); h1,y=forward(x); base=y.mean(0)
  print('\\nN',n,'base mse',((base-target[-1])**2).mean(),'var y',np.var(y,axis=0).mean())
  for r in [None,16,32,64,128,256,512]:
    R=None if r is None else np.random.default_rng(1000+r).standard_normal((W,r))/math.sqrt(W)
    for mode in ['same','split']:
      cv,var,p=cv_est(h1,y,R,mode)
      print('r',r,'mode',mode,'P',p,'mse',((cv-target[-1])**2).mean(),'resvar',var)

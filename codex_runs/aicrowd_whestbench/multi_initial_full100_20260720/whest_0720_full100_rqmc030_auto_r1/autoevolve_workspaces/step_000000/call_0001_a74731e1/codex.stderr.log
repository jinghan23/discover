codex
There is a structural property worth exploiting: with no biases, every layer output is positively homogeneous in the input norm. I’m testing whether integrating the Gaussian radius analytically and sampling only directions reduces variance for LHS.
exec
/bin/bash -lc "python - <<'PY'
import math, numpy as np, scipy.special, time
W=256;D=32
rad=math.sqrt(2)*math.exp(math.lgamma((W+1)/2)-math.lgamma(W/2))
print('rad',rad,'sqrtW',math.sqrt(W))
def weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
def fwd(ws,x):
 for w in ws: x=np.maximum(x@w,0)
 return x
def mc(ws,N,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,N,chunk):
  x=r.standard_normal((min(chunk,N-done),W)); s+=fwd(ws,x).sum(0)
 return s/N
def lhs_normals(N,seed):
 r=np.random.default_rng(seed); U=np.empty((N,W)); jit=r.random((N,W))
 for j in range(W): U[:,j]=(r.permutation(N)+jit[:,j])/N
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
def sphere_from_z(z):
 norm=np.sqrt((z*z).sum(1,keepdims=True)); return z*(rad/norm)
for N in [8192,20000,32768]:
 vals=[]
 for sd in [261,262,263,264,265]:
  ws=weights(sd); tgt=mc(ws,250000,1000+sd)
  z=lhs_normals(N,777)
  y=fwd(ws,z).mean(0); ys=fwd(ws,sphere_from_z(z)).mean(0)
  vals.append((((y-tgt)**2).mean(),((ys-tgt)**2).mean()))
  print('N',N,'net',sd,'normal sphere',vals[-1])
 print('AVG',N,np.mean(vals,0))

  sig=np.sqrt(var); a=mu_pre/sig; phi=inv*np.exp(-0.5*a*a); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
  mu=mu_pre*Phi+sig*phi; ez2=(mu_pre*mu_pre+var)*Phi+mu_pre*sig*phi; vp=np.maximum(ez2-mu*mu,0)
  cov=Phi[:,None]*Phi[None,:]*cov_pre; np.fill_diagonal(cov,vp); gains.append(Phi)

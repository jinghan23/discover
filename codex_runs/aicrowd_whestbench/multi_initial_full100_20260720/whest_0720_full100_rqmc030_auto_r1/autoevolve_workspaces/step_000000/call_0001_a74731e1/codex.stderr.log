/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
import scipy.special
W=256;D=32;p=251;n=p*p

def weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]
def fwd(ws,x):
 for w in ws: x=np.maximum(x@w,0)
 return x
def mc(ws,N,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,N,chunk):
  x=r.standard_normal((min(chunk,N-done),W)); s+=fwd(ws,x).sum(0)
 return s/N
def lhs(N,seed):
 r=np.random.default_rng(seed); U=np.empty((N,W)); jit=r.random((N,W))
 for j in range(W): U[:,j]=(r.permutation(N)+jit[:,j])/N
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
def oa(seed, chunk=None):
 r=np.random.default_rng(seed)
 I=np.repeat(np.arange(p),p)[:,None]
 J=np.tile(np.arange(p),p)[:,None]
 cols=[]
 # random symbol shifts and sub shifts/mults per col
 # col0: symbol i, sub j
 shifts=r.integers(0,p,size=W); subsh=r.integers(0,p,size=W); mult=r.integers(1,p,size=W)
 c0=((I[:,0]+shifts[0])%p)*p + ((J[:,0]*mult[0]+subsh[0])%p)
 c1=((J[:,0]+shifts[1])%p)*p + ((I[:,0]*mult[1]+subsh[1])%p)
 cols=[c0,c1]
 for idx,a in enumerate(range(1,p),start=2):
  sym=(a*I[:,0]+J[:,0]+shifts[idx])%p
  sub=(I[:,0]*mult[idx]+subsh[idx])%p
  cols.append(sym*p+sub)
 # we have 251? slopes 1..250 plus c0,c1 =252
 for extra in range(W-len(cols)):
  col=len(cols)
  # deterministic full LHS over n strata for extra dims
  base=(np.arange(n)*mult[col]+shifts[col]*p+subsh[col])%n
  cols.append(base)
 A=np.stack(cols,axis=1)
 U=(A+r.random((n,W)))/n
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
for sd in [251,252,253]:
 ws=weights(sd); t=time.time(); tgt=mc(ws,400000,1000+sd); print('\\nnet',sd,'target',time.time()-t)
 for name,gen in [('lhs63',lambda:lhs(n,777)),('oa251',lambda:oa(777)),('lhs20',lambda:lhs(20000,777))]:
  t=time.time(); y=fwd(ws,gen()).mean(0); print(name,'time',time.time()-t,'mse',((y-tgt)**2).mean())

/bin/bash -lc "python - <<'PY'
import math, numpy as np, scipy.special
W=256;D=32
def weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
def fwd(ws,x):
 for w in ws:x=np.maximum(x@w,0)
 return x
def mc(ws,N,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,N,chunk):
  x=r.standard_normal((min(chunk,N-done),W)); s+=fwd(ws,x).sum(0)
 return s/N
def lhs_u(N,seed):
 r=np.random.default_rng(seed); U=np.empty((N,W)); jit=r.random((N,W))
 for j in range(W): U[:,j]=(r.permutation(N)+jit[:,j])/N
 return U
def norm_ppf(U): return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
def anti_lhs(N,seed):
 h=N//2; U=lhs_u(h,seed); U=np.vstack([U,1-U]);
 if len(U)<N: U=np.vstack([U,lhs_u(1,seed+999)])
 return norm_ppf(U)
for N in [8192,20000,32768]:
 vals=[]
 for sd in [271,272,273,274,275]:
  ws=weights(sd); tgt=mc(ws,250000,1000+sd)
  y=fwd(ws,norm_ppf(lhs_u(N,777))).mean(0); ya=fwd(ws,anti_lhs(N,777)).mean(0)
  vals.append((((y-tgt)**2).mean(),((ya-tgt)**2).mean()))
  print('N',N,'net',sd,'lhs anti',vals[-1])
 print('AVG',N,np.mean(vals,0))

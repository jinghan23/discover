for mode in range(4):
 out=np.zeros_like(sv)
 for d in range(D):
  for j in range(B): out[d,j]=scramble_int(int(sv[d,j]),ltm[d],B,mode)
 print('"'mode',mode,'equal',np.array_equal(out,sv2))
 if not np.array_equal(out,sv2): print('first',out[0],sv2[0], 'ltm0',ltm[0])

import time, math
import numpy as np
import scipy.special
W=256; D=32

def make_weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]

def mc(weights,n,seed,chunk=5000):
 rng=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,n,chunk):
  x=rng.standard_normal((min(chunk,n-done),W))
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return s/n

def lhs(n,seed):
 rng=np.random.default_rng(seed); U=np.empty((n,W)); jit=rng.random((n,W))
 for j in range(W): U[:,j]=(rng.permutation(n)+jit[:,j])/n
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def forward_h1(weights,x):
 h1=None
 for l,w in enumerate(weights):
  x=np.maximum(x@w,0)
  if l==0: h1=x.copy()
 return h1,x

def cov_gains(weights):
 mu=np.zeros(W); cov=np.eye(W); gains=[]; inv=1/math.sqrt(2*math.pi)
 for w in weights:
  mu_pre=w.T@mu; cov_pre=w.T@cov@w; var=np.maximum(np.diag(cov_pre),1e-12)
  sig=np.sqrt(var); a=mu_pre/sig; phi=inv*np.exp(-0.5*a*a); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
  mu=mu_pre*Phi+sig*phi; ez2=(mu_pre*mu_pre+var)*Phi+mu_pre*sig*phi; vp=np.maximum(ez2-mu*mu,0)
  cov=Phi[:,None]*Phi[None,:]*cov_pre; np.fill_diagonal(cov,vp); gains.append(Phi)
 return gains

def J_first(weights,gains):
 J=np.eye(W)
 for k in range(1,D): J=J@(weights[k]*gains[k][None,:])
 return J

for n in [8192,20000]:
 vals=[]
 for netseed in [221,222,223,224,225]:
  weights=make_weights(netseed); target=mc(weights,250000,1000+netseed)
  x=lhs(n,777); h1,y=forward_h1(weights,x); base=y.mean(0)
  mu1=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)

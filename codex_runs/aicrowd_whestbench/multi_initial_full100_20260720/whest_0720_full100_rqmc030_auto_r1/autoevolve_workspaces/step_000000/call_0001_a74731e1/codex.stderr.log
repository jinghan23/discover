/bin/bash -lc "python - <<'PY'
import math, numpy as np, scipy.special
W=256;D=32
def weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
def fwd_final(ws,x,store_pre=False):
 for w in ws[:-1]: x=np.maximum(x@w,0)
 pre=x@ws[-1]; y=np.maximum(pre,0)
 return (pre,y)
def fwd(ws,x):
 for w in ws:x=np.maximum(x@w,0)
 return x
def mc(ws,N,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,N,chunk):
  x=r.standard_normal((min(chunk,N-done),W)); s+=fwd(ws,x).sum(0)
 return s/N
def lhs(N,seed):
 r=np.random.default_rng(seed); U=np.empty((N,W)); jit=r.random((N,W))
 for j in range(W): U[:,j]=(r.permutation(N)+jit[:,j])/N
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
def gauss_relu(pre):
 mu=pre.mean(0); m2=(pre*pre).mean(0); var=np.maximum(m2-mu*mu,1e-12); sig=np.sqrt(var); a=mu/sig
 phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
 return mu*Phi+sig*phi
for N in [4096,6500,8192,20000]:
 vals=[]
 for sd in [281,282,283,284,285,286,287,288]:
  ws=weights(sd); tgt=mc(ws,300000,1000+sd)
  pre,y=fwd_final(ws,lhs(N,777))
  direct=y.mean(0); plug=gauss_relu(pre)
  # convex combos
  mses=[((direct-tgt)**2).mean(),((plug-tgt)**2).mean()]
  for a in [0.25,0.5,0.75]:
   pred=a*plug+(1-a)*direct; mses.append(((pred-tgt)**2).mean())
  vals.append(mses)
  print('N',N,'net',sd,'direct plug c25 c50 c75',mses)
 print('AVG',N,np.mean(vals,0))

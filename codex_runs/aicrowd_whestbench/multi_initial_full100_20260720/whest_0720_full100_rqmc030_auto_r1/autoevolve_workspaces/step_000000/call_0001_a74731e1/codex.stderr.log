import time, math
import numpy as np

W=256; D=32; N=200000; chunk=5000; seed=123
rng=np.random.default_rng(seed)
weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]

def mc(n, seed):
    rng=np.random.default_rng(seed)
    sums=np.zeros((D,W), dtype=np.float64)
    sums2=np.zeros(W, dtype=np.float64)
    n_done=0
    t=time.time()
    while n_done<n:
        m=min(chunk,n-n_done)
        x=rng.standard_normal((m,W)).astype(np.float64)
        for l,w in enumerate(weights):
            x=x@w
            x=np.maximum(x,0)
            sums[l]+=x.sum(axis=0)
        sums2 += (x*x).sum(axis=0)
        n_done+=m
    means=sums/n
    var=sums2/n-means[-1]**2
    print('mc time', time.time()-t, 'avg final var', var.mean())
    return means,var

def meanprop():
    mu=np.zeros(W); var=np.ones(W); rows=[]
    invsqrt2pi=1/math.sqrt(2*math.pi)
    # use scipy? no scipy maybe; use math.erf vectorized? use np erf absent. import scipy?
    import scipy.special
    for w in weights:
        mu_pre=w.T@mu
        var_pre=(w*w).T@var
        var_pre=np.maximum(var_pre,1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=invsqrt2pi*np.exp(-0.5*alpha*alpha)
        Phi=0.5*(1+scipy.special.erf(alpha/math.sqrt(2)))
        mu=mu_pre*Phi+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy())
    return np.stack(rows)

def covprop():
    import scipy.special
    mu=np.zeros(W); cov=np.eye(W); rows=[]
    invsqrt2pi=1/math.sqrt(2*math.pi)
    for w in weights:
        mu_pre=w.T@mu
        cov_pre=w.T@cov@w
        var_pre=np.maximum(np.diag(cov_pre),1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=invsqrt2pi*np.exp(-0.5*alpha*alpha)
        Phi=0.5*(1+scipy.special.erf(alpha/math.sqrt(2)))
        mu=mu_pre*Phi+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0)
        gain=Phi
        cov=(gain[:,None]*gain[None,:])*cov_pre
        np.fill_diagonal(cov,var)
        rows.append(mu.copy())
    return np.stack(rows)

target,var=mc(N,999)
mp=meanprop(); cp=covprop()
for name,p in [('mean',mp),('cov',cp)]:
    mse=((p[-1]-target[-1])**2).mean()
    allmse=((p-target)**2).mean()
    print(name,'final mse vs mc',mse,'all',allmse,'mean target final avg',target[-1].mean())
# split mc sampling error
A,_=mc(N//2,1001); B,_=mc(N//2,1002)
print('split half mse', ((A[-1]-B[-1])**2).mean(), 'implied each vs true', ((A[-1]-B[-1])**2).mean()/2)

/bin/bash -lc "python - <<'PY'
import flopscope as flops, flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from submission import Estimator, _sample_count
budget=272_000_000_000
print('n', _sample_count(budget,256,32))
with flops.BudgetContext(flop_budget=budget, quiet=True) as b:
    mlp=sample_mlp(256,32,fnp.random.default_rng(123),seed=456)
    out=Estimator().predict(mlp,budget)
s=b.summary_dict()
print(out.shape, bool(fnp.all(fnp.isfinite(out))), s['flops_used']/budget, s['residual_wall_time_s'], s['wall_time_s'])
PY" in /opt/tiger/discover/workspace

import time, math
import numpy as np
import scipy.special
W=256; D=32; seed=124
rng=np.random.default_rng(seed)
weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]
mu1=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)

def forward_samples(x):
    h1=None
    rows=[]
    for l,w in enumerate(weights):
        x=np.maximum(x@w,0)
        if l==0: h1=x.copy()
        rows.append(x)
    return h1,x,rows

def mc_mean(n, seed, chunk=5000):
    rng=np.random.default_rng(seed); sums=np.zeros((D,W));
    for done in range(0,n,chunk):
        x=rng.standard_normal((min(chunk,n-done),W))
        for l,w in enumerate(weights):
            x=np.maximum(x@w,0); sums[l]+=x.sum(0)
    return sums/n

def meanprop_gains():
    mu=np.zeros(W); var=np.ones(W); gains=[]
    rows=[]
    invsqrt2pi=1/math.sqrt(2*math.pi)
    for w in weights:
        mu_pre=w.T@mu; var_pre=(w*w).T@var; var_pre=np.maximum(var_pre,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig
        phi=invsqrt2pi*np.exp(-0.5*a*a); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        gains.append(Phi); rows.append(mu.copy())
    return gains, np.stack(rows)

def covprop_gains():
    mu=np.zeros(W); cov=np.eye(W); gains=[]; rows=[]
    invsqrt2pi=1/math.sqrt(2*math.pi)
    for w in weights:
        mu_pre=w.T@mu; cov_pre=w.T@cov@w
        var_pre=np.maximum(np.diag(cov_pre),1e-12); sig=np.sqrt(var_pre); a=mu_pre/sig
        phi=invsqrt2pi*np.exp(-0.5*a*a); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        cov=(Phi[:,None]*Phi[None,:])*cov_pre; np.fill_diagonal(cov,var)
        gains.append(Phi); rows.append(mu.copy())
    return gains,np.stack(rows)

def jac_from_gains(gains):
    J=np.eye(W)
    # from h1 to final: layers 1..D-1. For layer index k, effective W_k columns times gains[k]
    for k in range(1,D):
        J=J@(weights[k]*gains[k][None,:])
    return J

def lattice_normals(n, shift_seed=777):
    # primes
    primes=[]; c=2
    while len(primes)<W:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    gen=np.sqrt(np.array(primes)); gen%=1
    shift=np.random.default_rng(shift_seed).random(W)
    U=(np.arange(n)[:,None]*gen[None,:]+shift[None,:])%1
    return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

t=time.time(); target=mc_mean(400000,999); print('target',time.time()-t)
# sample sets
for mode in ['iid','lat']:
  for n in [8192,20000,65536]:
    t=time.time()
    x=np.random.default_rng(777).standard_normal((n,W)) if mode=='iid' else lattice_normals(n,777)
    h1,y,_=forward_samples(x)
    base=y.mean(0)
    print('\\n',mode,n,'base mse',((base-target[-1])**2).mean(),'time forward',time.time()-t)
    for gpname, gpfunc in [('mean',meanprop_gains),('cov',covprop_gains)]:
        gains,_=gpfunc(); J=jac_from_gains(gains)
        cv=base - (h1.mean(0)-mu1)@J
        print(' analyticJ',gpname,'mse',((cv-target[-1])**2).mean(),'resvar?',np.var(y-(h1-mu1)@J,axis=0).mean())
    # fitted split: first min(n/2,...) pilot, rest main
    p=n//2
    Xp=h1[:p]-h1[:p].mean(0) # fit centered by pilot mean
    Yp=y[:p]-y[:p].mean(0)
    # ridge solve B = (X'X+lam diag)"'^{-1}X'"'Y
    XtX=Xp.T@Xp
    XtY=Xp.T@Yp
    lam=1e-3*np.trace(XtX)/W
    B=np.linalg.solve(XtX+lam*np.eye(W), XtY)
    hm=h1[p:]; ym=y[p:]
    cv=ym.mean(0) - (hm.mean(0)-mu1)@B
    print(' fit split mse',((cv-target[-1])**2).mean(),'resvar',np.var(ym-(hm-mu1)@B,axis=0).mean())
    # fit same (biased?)
    X=h1-h1.mean(0); Y=y-y.mean(0); XtX=X.T@X; XtY=X.T@Y; lam=1e-3*np.trace(XtX)/W
    B=np.linalg.solve(XtX+lam*np.eye(W),XtY)
    cv=base - (h1.mean(0)-mu1)@B
    print(' fit same mse',((cv-target[-1])**2).mean(),'resvar',np.var(y-(h1-mu1)@B,axis=0).mean())

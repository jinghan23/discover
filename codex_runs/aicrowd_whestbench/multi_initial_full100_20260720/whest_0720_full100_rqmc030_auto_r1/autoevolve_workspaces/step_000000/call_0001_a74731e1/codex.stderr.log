import time, math
import numpy as np
import scipy.special
W=256; D=32
# primes once
ps=[]; c=2
while len(ps)<W:
 ok=True
 for p in ps:
  if p*p>c: break
  if c%p==0: ok=False; break
 if ok: ps.append(c)
 c+=1
P=np.array(ps)

def make_weights(seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]

def forward(weights,x):
 for w in weights: x=np.maximum(x@w,0)
 return x

def mc(weights,n,seed,chunk=5000):
 rng=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,n,chunk):
  x=rng.standard_normal((min(chunk,n-done),W)); s+=forward(weights,x).sum(0)
 return s/n

def lat(n,seed,kind='sqrt'):
 rng=np.random.default_rng(seed)
 if kind=='sqrt': gen=np.sqrt(P)%1
 elif kind=='kor':
  a=17797; val=1; z=[]
  for j in range(W): z.append(val/n); val=(val*a)%n
  gen=np.array(z)
 elif kind=='rand': gen=rng.random(W)
 shift=rng.random(W)
 U=(np.arange(n)[:,None]*gen[None,:]+shift)%1
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def lhs(n,seed):
 rng=np.random.default_rng(seed); U=np.empty((n,W)); jit=rng.random((n,W))
 for j in range(W): U[:,j]=(rng.permutation(n)+jit[:,j])/n
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def estimate(weights,total,mode,seed=777):
 parts=[]
 if mode=='sqrt': parts=[lat(total,seed,'sqrt')]
 elif mode=='lhs': parts=[lhs(total,seed)]
 elif mode=='randlat': parts=[lat(total,seed,'rand')]
 elif mode=='kor': parts=[lat(total,seed,'kor')]
 elif mode=='2sqrt': parts=[lat(total//2,seed,'sqrt'),lat(total-total//2,seed+1,'sqrt')]
 elif mode=='4sqrt':
  ns=[total//4]*4; ns[-1]+=total-sum(ns); parts=[lat(ns[i],seed+i,'sqrt') for i in range(4)]
 elif mode=='lhs+sqrt': parts=[lhs(total//2,seed),lat(total-total//2,seed+1,'sqrt')]
 elif mode=='lhs+kor': parts=[lhs(total//2,seed),lat(total-total//2,seed+1,'kor')]
 elif mode=='lhs+rand': parts=[lhs(total//2,seed),lat(total-total//2,seed+1,'rand')]
 elif mode=='2lhs': parts=[lhs(total//2,seed),lhs(total-total//2,seed+1)]
 means=[]
 for x in parts: means.append(forward(weights,x).mean(0))
 return sum(m*len(p) for m,p in zip(means,parts))/sum(len(p) for p in parts)

modes=['sqrt','lhs','kor','randlat','2sqrt','4sqrt','2lhs','lhs+sqrt','lhs+kor','lhs+rand']
for total in [8192,20000,32768]:
 print('\\nTOTAL',total)
 avg={m:[] for m in modes}
 for netseed in [211,212,213,214,215]:
  weights=make_weights(netseed)
  target=mc(weights,250000,1000+netseed)
  vals=[]
  for m in modes:
   y=estimate(weights,total,m,777)
   mse=((y-target)**2).mean(); avg[m].append(mse); vals.append((m,mse))
  print('net',netseed, sorted(vals,key=lambda x:x[1])[:5])
 print('avg', sorted([(m,float(np.mean(avg[m]))) for m in modes], key=lambda x:x[1]))

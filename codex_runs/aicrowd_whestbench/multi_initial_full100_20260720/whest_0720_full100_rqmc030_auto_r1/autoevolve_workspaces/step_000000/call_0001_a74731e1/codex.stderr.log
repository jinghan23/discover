from scipy.stats import _sobol
import numpy as np, zlib, base64, struct, textwrap
poly=_sobol.get_poly_vinit('poly',np.uint32)[:256].astype(np.uint32)
vinit=_sobol.get_poly_vinit('vinit',np.uint32)[:256,:18].astype(np.uint16)
raw=struct.pack('<256I', *[int(x) for x in poly]) + struct.pack('<%dH'%(256*18), *[int(x) for x in vinit.ravel()])
blob=base64.b85encode(zlib.compress(raw,9)).decode('ascii')
print(len(raw), len(blob))
print('\\n'.join(textwrap.wrap(blob, 100)))

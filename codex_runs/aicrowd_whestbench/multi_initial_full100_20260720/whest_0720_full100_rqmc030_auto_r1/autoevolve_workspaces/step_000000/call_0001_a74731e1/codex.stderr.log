import time, math
import numpy as np
import scipy.special
W=256; D=32; seed=125
rng=np.random.default_rng(seed)
weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]

def covprop():
    mu=np.zeros(W); cov=np.eye(W); rows=[]; gains=[]; inv=1/math.sqrt(2*math.pi)
    for w in weights:
        mu_pre=w.T@mu; cov_pre=w.T@cov@w
        var_pre=np.maximum(np.diag(cov_pre),1e-12); sig=np.sqrt(var_pre); a=mu_pre/sig
        phi=inv*np.exp(-0.5*a*a); Phi=0.5*(1+scipy.special.erf(a/math.sqrt(2)))
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        cov=(Phi[:,None]*Phi[None,:])*cov_pre; np.fill_diagonal(cov,var)
        rows.append(mu.copy()); gains.append(Phi.copy())
    return np.stack(rows), gains
cp,gains=covprop()
# exact first row
cp[0]=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)

def jac_from(k):
    J=np.eye(W)
    for l in range(k+1,D):
        J=J@(weights[l]*gains[l][None,:])
    return J

def lattice(n):
    primes=[]; c=2
    while len(primes)<W:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    gen=np.sqrt(np.array(primes))%1; shift=np.random.default_rng(777).random(W)
    U=(np.arange(n)[:,None]*gen[None,:]+shift[None,:])%1
    return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))

def forward_store(x, layers_to_store):
    store={}; sums=np.zeros((D,W))
    for l,w in enumerate(weights):
        x=np.maximum(x@w,0); sums[l]=x.mean(0)
        if l in layers_to_store: store[l]=x.copy()
    return x, sums, store

def mc(n, seed, chunk=5000):
    rng=np.random.default_rng(seed); sums=np.zeros((D,W))
    for done in range(0,n,chunk):
        x=rng.standard_normal((min(chunk,n-done),W))
        for l,w in enumerate(weights):
            x=np.maximum(x@w,0); sums[l]+=x.sum(0)
    return sums/n

t=time.time(); target=mc(500000,999); print('target time',time.time()-t, 'cp mse',((cp[-1]-target[-1])**2).mean())
for n in [8192,20000,65536]:
    x=lattice(n); layers=[0,3,7,11,15,19,23,27,30]
    y, means, store=forward_store(x,layers)
    print('\\nN',n,'base',((means[-1]-target[-1])**2).mean())
    for k in layers:
        J=jac_from(k)
        cv=means[-1] - (means[k]-cp[k])@J
        print('analytic k',k,'mse',((cv-target[-1])**2).mean())
    # direct last-layer Taylor no full J? k=30 regression fit same/split
    k=30; H=store[k]; Y=y; p=n//2
    for mode in ['same','split']:
      if mode=='same':
        X=H-H.mean(0); YY=Y-Y.mean(0); mu_anchor=cp[k]; Hm=H; Ym=Y
      else:
        X=H[:p]-H[:p].mean(0); YY=Y[:p]-Y[:p].mean(0); mu_anchor=cp[k]; Hm=H[p:]; Ym=Y[p:]
      XtX=X.T@X; XtY=X.T@YY; lam=1e-3*np.trace(XtX)/W
      B=np.linalg.solve(XtX+lam*np.eye(W),XtY)
      cv=Ym.mean(0)-(Hm.mean(0)-mu_anchor)@B
      print('reg',mode,'k30 mse',((cv-target[-1])**2).mean(),'resvar',np.var(Ym-(Hm-mu_anchor)@B,axis=0).mean())

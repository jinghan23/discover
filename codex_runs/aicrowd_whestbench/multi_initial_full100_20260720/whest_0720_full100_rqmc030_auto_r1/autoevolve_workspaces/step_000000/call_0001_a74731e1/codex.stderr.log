from scipy.stats import _sobol
from scipy.stats._qmc import _initialize_v
import numpy as np, math
D=256;B=32
poly=_sobol.get_poly_vinit('poly',np.uint32)[:D].astype(int)
vinit=_sobol.get_poly_vinit('vinit',np.uint32)[:D].astype(int)
V=np.zeros((D,B),dtype=np.uint32)
for d in range(D):
    p=int(poly[d]); s=p.bit_length()-1
    if d==0:
        for i in range(B): V[d,i]=1 << (B-1-i)
        continue
    for i in range(s): V[d,i]=int(vinit[d,i]) << (B-1-i)
    for i in range(s,B):
        val=int(V[d,i-s]) "'^ (int(V[d,i-s]) >> s)
        for k in range(1,s):
            if (p >> k) & 1:
                val ''^= int(V[d,i-s+k])
        V[d,i]=val
sv=np.zeros((D,B),dtype=np.uint32); _initialize_v(sv,dim=D,bits=B)
print('"'equal',np.array_equal(V,sv),'diff count',np.count_nonzero(V"'!=sv))
if not np.array_equal(V,sv):

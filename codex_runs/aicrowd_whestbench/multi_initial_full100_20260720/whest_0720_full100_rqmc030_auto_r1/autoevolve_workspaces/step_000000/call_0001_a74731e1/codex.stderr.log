def fwd(ws,x):
 for w in ws:x=np.maximum(x@w,0)
 return x
def mc(ws,n,seed,chunk=5000):
 r=np.random.default_rng(seed); s=np.zeros(W)
 for done in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-done),W)); s+=fwd(ws,x).sum(0)
 return s/n
def lhs(n,seed,mid):
 r=np.random.default_rng(seed); U=np.empty((n,W)); jit=0.5 if mid else r.random((n,W))
 for j in range(W): U[:,j]=(r.permutation(n)+(jit if mid else jit[:,j]))/n
 return scipy.special.ndtri(np.clip(U,1e-11,1-1e-11))
for n in [8192,20000]:
 vals=[]
 for sd in [241,242,243,244,245]:
  ws=weights(sd); tgt=mc(ws,250000,1000+sd)
  a=fwd(ws,lhs(n,777,False)).mean(0); b=fwd(ws,lhs(n,777,True)).mean(0)
  vals.append((((a-tgt)**2).mean(),((b-tgt)**2).mean()))
  print('N',n,'net',sd,'jitter mid',vals[-1])
 print('AVG',n,np.mean(vals,0))

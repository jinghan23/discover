/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc,norm

def he(w,d,r): return [r.standard_normal((w,w))*np.sqrt(2/w) for _ in range(d)]
def exact1(W):
 s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v
def est(weights,n,seed_offset,mlp_seed):
 w=weights[0].shape[0]; seed=(mlp_seed+seed_offset)&0xffffffff
 u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(m=int(np.log2(n))); a=norm.ppf(np.clip(u,1e-11,1-1e-11))
 for li,W in enumerate(weights):
  h=np.maximum(a@W,0)
  if li==0 and len(weights)>1:
   m,v=exact1(W); hm=h.mean(0); c=h-hm; hv=(c*c).mean(0); h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
  a=h
 return a.mean(0)
def truth(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; bs=16384
 while done<n:
  b=min(bs,n-done); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  s+=a.sum(0); done+=b
 return s/n
offsets=[0,1,0x1234567,0x9E3779B9,0xA5A5A5A5,0xD1B54A32,0xDEADBEEF,0x6C8E9CF5]
for w,d,n,mlps,true_n in [(64,8,128,12,262144),(128,8,128,8,131072),(128,16,128,8,131072)]:
 acc={o:[] for o in offsets}; rng=np.random.default_rng(4321+w+d)
 for i in range(mlps):
  weights=he(w,d,rng); t=truth(weights,true_n,3300+i); mlp_seed=100000+i*999
  for o in offsets: acc[o].append(((est(weights,n,o,mlp_seed)-t)**2).mean())
 print('\\ncase',w,d,n)
 for val,o in sorted((np.mean(v),o) for o,v in acc.items()): print(hex(o),val)

def rule(w,d,n):
 if d<=1: return 0
 if w>=192: return min(4,d-1)
 if w>=128:
  if n<=128: return min(3,d-1)
  if d<=16 and n<=256: return min(2,d-1)
  return 1
 if w>=64 and n<=64: return min(2,d-1)

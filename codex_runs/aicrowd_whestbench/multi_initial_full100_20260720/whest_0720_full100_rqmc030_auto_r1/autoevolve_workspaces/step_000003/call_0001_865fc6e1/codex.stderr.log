import numpy as np
from scipy.stats import qmc, norm

def he_mlp(w,d,rng):
    scale=np.sqrt(2.0/w)
    return [rng.standard_normal((w,w)).astype(np.float32)*scale for _ in range(d)]

def forward_means(weights, x, final_gauss=False, beta=1.0):
    a=x
    rows=[]
    for li,W in enumerate(weights):
        z=a@W
        if li == len(weights)-1 and final_gauss:
            sample=np.maximum(z,0).mean(axis=0)
            mu=z.mean(axis=0)
            var=((z-mu)**2).mean(axis=0)
            sig=np.sqrt(np.maximum(var,1e-30))
            alpha=mu/sig
            gauss=sig*norm.pdf(alpha)+mu*norm.cdf(alpha)
            rows.append(beta*sample+(1-beta)*gauss)
            a=np.maximum(z,0)
        else:
            a=np.maximum(z,0)
            rows.append(a.mean(axis=0))
    return np.array(rows)

def exact_first(weights):
    return np.sqrt((weights[0]**2).sum(axis=0))/np.sqrt(2*np.pi)

def est(weights, n, seed, variant):
    w=weights[0].shape[0]
    if variant.endswith('_anti'):
        m=int(np.log2(max(1,n//2)))
        sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
        u=sampler.random_base2(m=m)
        u=np.clip(u,1e-11,1-1e-11)
        x0=norm.ppf(u)
        x=np.concatenate([x0,-x0],axis=0)
    else:
        m=int(np.log2(n))
        sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
        u=sampler.random_base2(m=m)
        u=np.clip(u,1e-11,1-1e-11)
        x=norm.ppf(u)
    fg='gauss' in variant
    beta=1.0
    if 'g25' in variant: beta=.75
    if 'g50' in variant: beta=.5
    if 'g75' in variant: beta=.25
    if 'g100' in variant: beta=0.0
    rows=forward_means(weights,x,final_gauss=fg,beta=beta)
    rows[0]=exact_first(weights)
    return rows

def truth(weights, n, seed):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    # chunk to reduce memory
    sums=[np.zeros(w) for _ in weights]
    done=0
    bs=16384
    while done<n:
        b=min(bs,n-done)
        a=rng.standard_normal((b,w))
        for i,W in enumerate(weights):
            a=np.maximum(a@W,0)
            sums[i]+=a.sum(axis=0)
        done+=b
    return np.array([s/n for s in sums])


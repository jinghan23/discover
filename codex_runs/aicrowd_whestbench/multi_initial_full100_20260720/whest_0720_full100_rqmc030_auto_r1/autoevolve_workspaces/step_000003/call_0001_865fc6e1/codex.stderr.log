/bin/bash -lc "python - <<'PY'
# Proxy score scaling from previous local setup: MSE * n as a rough compute-adjusted proxy.
# Lower means using more samples would help more than linearly; flat means target fraction matters little.
import numpy as np
from scipy.stats import qmc,norm

def he(w,d,r): return [r.standard_normal((w,w))*np.sqrt(2/w) for _ in range(d)]
def exact1(W):
 s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v
def est(weights,n,seed):
 w=weights[0].shape[0]; u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(m=int(np.log2(n))); a=norm.ppf(np.clip(u,1e-11,1-1e-11))
 for li,W in enumerate(weights):
  h=np.maximum(a@W,0)
  if li==0 and len(weights)>1:
   m,v=exact1(W); hm=h.mean(0); c=h-hm; hv=(c*c).mean(0); h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
  a=h
 return a.mean(0)
def truth(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; bs=16384
 while done<n:
  b=min(bs,n-done); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  s+=a.sum(0); done+=b
 return s/n
for w,d,mlps,true_n in [(64,8,10,262144),(128,8,6,131072),(128,16,6,131072)]:
 rng=np.random.default_rng(2020+w+d); ns=[32,64,128,256,512]
 acc={n:[] for n in ns}
 for i in range(mlps):
  weights=he(w,d,rng); t=truth(weights,true_n,1212+i)
  for n in ns: acc[n].append(((est(weights,n,0x9e3779b9+i*0)-t)**2).mean())
 print('\\ncase',w,d)
 for n in ns:
  m=np.mean(acc[n]); print(n,'mse',m,'mse*n',m*n)

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc, norm

def he_mlp(w,d,rng):
    return [rng.standard_normal((w,w)).astype(np.float64)*np.sqrt(2.0/w) for _ in range(d)]

def relu_norm_moments(W):
    s2=(W*W).sum(axis=0)
    m=np.sqrt(s2)/np.sqrt(2*np.pi)
    q=s2/2
    v=np.maximum(q-m*m,1e-30)
    return m,v

def estimate(weights,n,seed,variant,beta=1.0):
    w=weights[0].shape[0]
    sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
    u=sampler.random_base2(m=int(np.log2(n)))
    x=norm.ppf(np.clip(u,1e-11,1-1e-11))
    if 'inmean' in variant or 'inmom' in variant:
        x=x-x.mean(axis=0)
    if 'invar' in variant or 'inmom' in variant:
        x=x/np.sqrt(np.maximum((x*x).mean(axis=0),1e-30))
    a=x
    rows=[]
    for li,W in enumerate(weights):
        z=a@W
        h=np.maximum(z,0)
        if li == 0:
            m,v=relu_norm_moments(W)
            rows.append(m)
            if 'h1mean' in variant or 'h1mom' in variant:
                hm=h.mean(axis=0)
                h=h-hm+m
            if 'h1var' in variant or 'h1mom' in variant:
                # if mean already adjusted, center around exact; otherwise sample mean
                center=m if ('h1mean' in variant or 'h1mom' in variant) else h.mean(axis=0)
                c=h-center
                hv=(c*c).mean(axis=0)
                h=center+c*np.sqrt(v/np.maximum(hv,1e-30))
        elif li == len(weights)-1 and 'finalgauss' in variant:
            sm=h.mean(axis=0)
            mu=z.mean(axis=0)
            var=((z-mu)**2).mean(axis=0)
            sig=np.sqrt(np.maximum(var,1e-30)); alpha=mu/sig
            gm=sig*norm.pdf(alpha)+mu*norm.cdf(alpha)
            rows.append(beta*sm+(1-beta)*gm)
        else:
            rows.append(h.mean(axis=0))
        a=h
    return np.array(rows)

def truth(weights,n,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    sums=[np.zeros(w) for _ in weights]; done=0; bs=32768
    while done<n:
        b=min(bs,n-done); a=rng.standard_normal((b,w))
        for i,W in enumerate(weights):
            a=np.maximum(a@W,0); sums[i]+=a.sum(0)
        done+=b
    return np.array([s/n for s in sums])

variants=['base','inmean','invar','inmom','h1mean','h1mom','inmom_h1mean','inmom_h1mom','inmom_h1mom_finalgauss','inmom_finalgauss','h1mom_finalgauss']
for w,d,n,true_n,mlps in [(32,8,128,262144,20),(64,8,128,262144,12),(64,16,64,262144,8),(128,8,128,131072,6),(128,16,64,65536,4)]:
    acc={v:[] for v in variants}
    rng=np.random.default_rng(54321+w*11+d)
    for k in range(mlps):
        weights=he_mlp(w,d,rng)
        t=truth(weights,true_n,4242+k)[-1]
        for v in variants:
            p=estimate(weights,n,888+k*19,v,beta=0.5)[-1]
            acc[v].append(((p-t)**2).mean())
    print('\\ncase',w,d,'n',n)
    best=sorted((np.mean(acc[v]),v) for v in variants)
    for val,v in best:
        print(v, val)

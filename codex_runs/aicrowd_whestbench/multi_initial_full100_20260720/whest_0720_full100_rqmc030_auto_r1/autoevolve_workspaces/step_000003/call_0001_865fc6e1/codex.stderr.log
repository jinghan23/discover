--- a/submission.py
+++ b/submission.py
@@ -183,20 +183,70 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _exact_first_layer_moments(
+    first_weight: fnp.ndarray,
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance_pre = fnp.sum(first_weight * first_weight, axis=0)
+    mean = fnp.sqrt(variance_pre) / fnp.sqrt(2.0 * fnp.pi)
+    second_moment = 0.5 * variance_pre
+    variance = fnp.maximum(second_moment - mean * mean, 1e-30)
+    return mean, variance
+
+
+def _diagonal_relu_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray, weight: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    mean_pre = weight.T @ mean
+    variance_pre = (weight * weight).T @ variance
+    variance_pre = fnp.maximum(variance_pre, 1e-30)
+    standard_deviation = fnp.sqrt(variance_pre)
+    alpha = mean_pre / standard_deviation
+    density = flops.stats.norm.pdf(alpha)
+    distribution = flops.stats.norm.cdf(alpha)
+    next_mean = mean_pre * distribution + standard_deviation * density
+    second_moment = (
+        (mean_pre * mean_pre + variance_pre) * distribution
+        + mean_pre * standard_deviation * density
+    )
+    next_variance = fnp.maximum(second_moment - next_mean * next_mean, 1e-30)
+    return next_mean, next_variance
+
+
+def _match_layer_count(width: int, depth: int, n_samples: int) -> int:
+    _ = width, n_samples
+    if depth <= 1:
+        return 0
+    return 1
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     normal_per_sample = 92 * width
     forward_per_sample = depth * (2 * width * width + width)
     later_means_per_sample = max(depth - 1, 0) * width
-    per_sample = normal_per_sample + forward_per_sample + later_means_per_sample
-    fixed = 2 * width * width + 8 * width
-    raw = max(1, (int(_TARGET_FLOP_FRACTION * budget) - fixed) // per_sample)
-    return 1 << max(0, int(math.floor(math.log2(raw))))
+    base_per_sample = normal_per_sample + forward_per_sample + later_means_per_sample
+    target_budget = int(_TARGET_FLOP_FRACTION * budget)
+
+    n_samples = 1
+    for _ in range(2):
+        match_layers = _match_layer_count(width, depth, n_samples)
+        per_sample = base_per_sample + match_layers * 4 * width
+        fixed = (
+            2 * width * width
+            + 16 * width
+            + max(match_layers - 1, 0) * (5 * width * width + 32 * width)
+        )
+        raw = max(1, (target_budget - fixed) // per_sample)
+        n_samples = 1 << max(0, int(math.floor(math.log2(raw))))
+    return n_samples
 
 
 class Estimator(BaseEstimator):
     """LMS+shift Sobol estimator with an exact first output row."""
 
     def predict(self, mlp, budget):
+        if mlp.depth == 1:
+            return fnp.stack([_exact_first_layer_mean(mlp.weights[0])], axis=0)
+
         n_samples = _sample_count(budget, mlp.width, mlp.depth)
         rng = fnp.random.default_rng((int(mlp.seed) + _SEED_OFFSET) & 0xFFFFFFFF)
         uniforms = _sobol_uniforms(n_samples, mlp.width, rng)
@@ -204,10 +254,27 @@
         activations = flops.stats.norm.ppf(uniforms)
 
         rows = []
+        match_layers = _match_layer_count(mlp.width, mlp.depth, n_samples)
+        target_mean = None
+        target_variance = None
         for layer_index, weight in enumerate(mlp.weights):
             activations = fnp.maximum(activations @ weight, 0.0)
             if layer_index == 0:
-                rows.append(_exact_first_layer_mean(weight))
+                target_mean, target_variance = _exact_first_layer_moments(weight)
+                rows.append(target_mean)
             else:
                 rows.append(fnp.mean(activations, axis=0))
+                if layer_index < match_layers:
+                    target_mean, target_variance = _diagonal_relu_moments(
+                        target_mean, target_variance, weight
+                    )
+
+            if layer_index < match_layers:
+                sample_mean = fnp.mean(activations, axis=0)
+                centered = activations - sample_mean[None, :]
+                sample_variance = fnp.mean(centered * centered, axis=0)
+                scale = fnp.sqrt(
+                    target_variance / fnp.maximum(sample_variance, 1e-30)
+                )
+                activations = target_mean[None, :] + centered * scale[None, :]
         return fnp.stack(rows, axis=0)


/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc,norm

def he(w,d,r): return [r.standard_normal((w,w))*np.sqrt(2/w) for _ in range(d)]
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]
 for W in weights:
  mp=W.T@mu; vp=(W*W).T@var; sig=np.sqrt(np.maximum(vp,1e-30)); a=mp/sig; P=norm.cdf(a); p=norm.pdf(a)
  mu=mp*P+sig*p; ez2=(mp*mp+vp)*P+mp*sig*p; var=np.maximum(ez2-mu*mu,1e-30); rows.append(mu.copy())
 return np.array(rows)
def exact1(W):
 s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v
def sample_h1(weights,n,seed):
 w=weights[0].shape[0]; u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(m=int(np.log2(n))); a=norm.ppf(np.clip(u,1e-11,1-1e-11))
 for li,W in enumerate(weights):
  h=np.maximum(a@W,0)
  if li==0 and len(weights)>1:
   m,v=exact1(W); hm=h.mean(0); c=h-hm; hv=(c*c).mean(0); h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
  a=h
 return a.mean(0)
def truth(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; bs=16384
 while done<n:
  b=min(bs,n-done); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  s+=a.sum(0); done+=b
 return s/n
betas=[0,0.02,0.05,0.1,0.2,0.35,0.5,1.0] # beta analytic, rest sample
for w,d,n,mlps,true_n in [(32,8,128,20,262144),(64,8,128,12,262144),(64,16,64,8,262144),(128,8,128,6,131072),(128,16,128,6,131072),(256,8,64,4,65536)]:
 acc={b:[] for b in betas}; rng=np.random.default_rng(7777+w+d+n)
 for i in range(mlps):
  weights=he(w,d,rng); t=truth(weights,true_n,9200+i); s=sample_h1(weights,n,1100+i*5); a=diag(weights)[-1]
  for b in betas:
   p=(1-b)*s+b*a; acc[b].append(((p-t)**2).mean())
 print('\\ncase',w,d,n)
 for val,b in sorted((np.mean(acc[b]),b) for b in betas): print('beta',b,val)

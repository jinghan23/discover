import numpy as np
from scipy.stats import qmc,norm

def he(w,d,r): return [r.standard_normal((w,w))*np.sqrt(2/w) for _ in range(d)]
def exact1(W):
 s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v
def forward(weights,x):
 a=x
 for li,W in enumerate(weights):
  h=np.maximum(a@W,0)
  if li==0 and len(weights)>1:
   m,v=exact1(W); hm=h.mean(0); c=h-hm; hv=(c*c).mean(0); h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
  a=h
 return a.mean(0)
def est(weights,n,reps,seed):
 w=weights[0].shape[0]; outs=[]; m=int(np.log2(n//reps))
 for r in range(reps):
  u=qmc.Sobol(d=w,scramble=True,seed=(seed+1000003*r)&0xffffffff).random_base2(m=m)
  x=norm.ppf(np.clip(u,1e-11,1-1e-11)); outs.append(forward(weights,x))
 return np.mean(outs,0)
def truth(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; bs=16384
 while done<n:
  b=min(bs,n-done); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  s+=a.sum(0); done+=b
 return s/n
reps_list=[1,2,4,8]
for w,d,n,mlps,true_n in [(64,8,128,12,262144),(128,8,128,8,131072),(128,16,128,8,131072),(256,8,64,4,65536)]:

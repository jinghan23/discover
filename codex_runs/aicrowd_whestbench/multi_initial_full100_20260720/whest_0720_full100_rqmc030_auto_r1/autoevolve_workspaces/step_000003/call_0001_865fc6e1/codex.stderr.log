codex
A natural extension is matching deeper layer sample marginals to the diagonal Gaussian propagation moments. That can remove more sample noise, but it may inject approximation bias, so I’m testing it locally before touching the candidate.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc, norm

def he_mlp(w,d,rng):
    return [rng.standard_normal((w,w)).astype(np.float64)*np.sqrt(2.0/w) for _ in range(d)]

def diag_moments(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); out=[]
    for W in weights:
        mu_pre=W.T@mu
        var_pre=(W*W).T@var
        sig=np.sqrt(np.maximum(var_pre,1e-30)); a=mu_pre/sig
        Phi=norm.cdf(a); phi=norm.pdf(a)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,1e-30)
        out.append((mu.copy(),var.copy()))
    return out

def exact_first(W):
    s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v

def estimate(weights,n,seed,mode):
    w=weights[0].shape[0]; d=len(weights)
    u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(m=int(np.log2(n)))
    a=norm.ppf(np.clip(u,1e-11,1-1e-11))
    moms=diag_moments(weights)
    rows=[]
    for li,W in enumerate(weights):
        z=a@W; h=np.maximum(z,0)
        if li==0:
            em,ev=exact_first(W)
            rows.append(em)
        else:
            rows.append(h.mean(0))
        match=False
        if li < d-1:
            if mode=='h1' and li==0: match=True
            elif mode=='all': match=True
            elif mode.startswith('k') and li<int(mode[1:]): match=True
            elif mode=='even' and li%2==0: match=True
        if match:
            if li==0:
                m,v=exact_first(W)
            else:
                m,v=moms[li]
            hm=h.mean(0); c=h-hm; hv=(c*c).mean(0)
            h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
        a=h
    return np.array(rows)

def truth(weights,n,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    sums=[np.zeros(w) for _ in weights]; done=0; bs=32768
    while done<n:
        b=min(bs,n-done); a=rng.standard_normal((b,w))
        for i,W in enumerate(weights):
            a=np.maximum(a@W,0); sums[i]+=a.sum(0)
        done+=b
    return np.array([s/n for s in sums])

modes=['base','h1','k2','k3','k4','all','even']
for w,d,n,true_n,mlps in [(32,8,128,262144,20),(64,8,128,262144,12),(64,16,64,262144,8),(128,8,128,131072,6),(128,16,64,65536,4)]:
    acc={m:[] for m in modes}; rng=np.random.default_rng(24680+w*7+d)
    for k in range(mlps):
        weights=he_mlp(w,d,rng); t=truth(weights,true_n,8080+k)[-1]
        for m in modes:
            p=estimate(weights,n,1000+k*31,m)[-1]
            acc[m].append(((p-t)**2).mean())
    print('\\ncase',w,d,'n',n)
    for val,m in sorted((np.mean(acc[m]),m) for m in modes): print(m,val)
PY" in /opt/tiger/discover/workspace

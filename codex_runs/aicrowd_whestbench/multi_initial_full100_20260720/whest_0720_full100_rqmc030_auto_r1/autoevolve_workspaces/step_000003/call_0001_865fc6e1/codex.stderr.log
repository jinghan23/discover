/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc, norm

def he_mlp(w,d,rng): return [rng.standard_normal((w,w)).astype(np.float64)*np.sqrt(2.0/w) for _ in range(d)]
def diag_moms(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); out=[]
    for W in weights:
        mp=W.T@mu; vp=(W*W).T@var; sig=np.sqrt(np.maximum(vp,1e-30)); a=mp/sig; P=norm.cdf(a); p=norm.pdf(a)
        mu=mp*P+sig*p; ez2=(mp*mp+vp)*P+mp*sig*p; var=np.maximum(ez2-mu*mu,1e-30); out.append((mu.copy(),var.copy()))
    return out
def exact1(W):
    s2=(W*W).sum(0); m=np.sqrt(s2)/np.sqrt(2*np.pi); v=np.maximum(.5*s2-m*m,1e-30); return m,v
def est(weights,n,seed,kmatch):
    w=weights[0].shape[0]; d=len(weights); u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(m=int(np.log2(n)))
    a=norm.ppf(np.clip(u,1e-11,1-1e-11)); moms=diag_moms(weights) if kmatch>1 else None
    for li,W in enumerate(weights):
        h=np.maximum(a@W,0)
        if li<d-1 and li<kmatch:
            if li==0: m,v=exact1(W)
            else: m,v=moms[li]
            hm=h.mean(0); c=h-hm; hv=(c*c).mean(0); h=m+c*np.sqrt(v/np.maximum(hv,1e-30))
        a=h
    return a.mean(0)
def truth(weights,n,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; bs=16384
    while done<n:
        b=min(bs,n-done); a=rng.standard_normal((b,w))
        for W in weights: a=np.maximum(a@W,0)
        s+=a.sum(0); done+=b
    return s/n

cases=[]
for w in [32,64,128,256]:
  for d in [4,8,16,32]:
    for n in ([64,128,256] if w<=128 else [32,64,128]):
      cases.append((w,d,n))
ks=[0,1,2,3,4]
for w,d,n in cases:
    mlps=8 if w<=64 else (5 if w==128 else 3)
    true_n=262144 if w<=64 else (131072 if w==128 else 65536)
    acc={k:[] for k in ks}; rng=np.random.default_rng(9000+w*101+d*7+n)
    for i in range(mlps):
        weights=he_mlp(w,d,rng); t=truth(weights,true_n,123456+i)
        for k in ks:
            p=est(weights,n,555+i*13,k)
            acc[k].append(((p-t)**2).mean())
    means={k:np.mean(acc[k]) for k in ks}; best=min(ks,key=lambda k:means[k])
    rel={k:means[k]/means[0] for k in ks}
    print(f'w={w:3d} d={d:2d} n={n:3d} best=k{best} base={means[0]:.3g} rel ' + ' '.join(f'k{k}:{rel[k]:.2f}' for k in ks[1:]))

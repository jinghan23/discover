/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.stats import qmc
from scipy.special import ndtri
INV=1/math.sqrt(2*math.pi)

def exact_first(W):
 cov=W.T@W; var=np.diag(cov); sd=np.sqrt(np.maximum(var,1e-30)); mean=sd*INV
 rho=np.clip(cov/np.maximum(np.outer(sd,sd),1e-30),-1,1)
 q=np.outer(sd,sd)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
 cv=q-np.outer(mean,mean); v=np.maximum(np.diag(cv),1e-30)
 return mean,v,q,cv

def fwd(weights,x,mode):
 m1,v1,q1,cv1=exact_first(weights[0])
 pre2=None
 cov2=None
 if len(weights)>1 and mode in ('diag','full'):
  W2=weights[1]
  pm=m1@W2
  if mode=='diag':
   sec=np.sum(W2*(q1@W2),0); pv=np.maximum(sec-pm*pm,1e-30); pre2=(pm,pv)
  else:
   covp=W2.T@cv1@W2; cov2=covp; pre2=(pm,np.maximum(np.diag(covp),1e-30))
 for li,W in enumerate(weights):
  pre=x@W
  if li==1 and pre2 is not None:
   pm,pv=pre2; sm=pre.mean(0); c=pre-sm
   if mode=='full' and c.shape[0] > c.shape[1]+2:
    S=(c.T@c)/c.shape[0]
    ridge=1e-7*np.mean(np.diag(cov2)) + 1e-9
    Ls=np.linalg.cholesky(S+ridge*np.eye(S.shape[0])); Lt=np.linalg.cholesky(cov2+ridge*np.eye(S.shape[0]))
    B=np.linalg.solve(Ls.T,Lt.T)
    pre=pm+c@B
   else:
    sv=(c*c).mean(0); pre=pm+c*np.sqrt(pv/np.maximum(sv,1e-30))
  x=np.maximum(pre,0)
  if li==0:
   sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=m1+c*np.sqrt(v1/np.maximum(sv,1e-30))
 return x.mean(0)
def sob(n,w,seed): return ndtri(np.clip(qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n))),1e-11,1-1e-11))
def targ(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0]); done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=k
 return s/n
for width,depth,nest,nt in [(64,16,128,20000),(64,32,128,16000),(64,32,256,16000),(128,10,256,12000),(128,32,256,8000),(256,10,512,4000)]:
 vals={'base':[],'diag':[],'full':[]}; t=time.time()
 for r in range(12):
  rng=np.random.default_rng(21000+r); weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
  target=targ(weights,nt,22000+r); x=sob(nest,width,23000+r)
  for mode in vals:
   vals[mode].append(np.mean((fwd(weights,x.copy(),mode)-target)**2))
 print('case',width,depth,nest,'time',time.time()-t,{k:float(np.mean(v)) for k,v in vals.items()})

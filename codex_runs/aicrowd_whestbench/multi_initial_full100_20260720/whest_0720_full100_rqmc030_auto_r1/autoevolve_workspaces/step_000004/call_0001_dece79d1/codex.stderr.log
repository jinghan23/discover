  target=targ(weights,nt,19000+r); x=sob(nest,width,20000+r)
  vals['base'].append(np.mean((fwd(weights,x.copy(),False)-target)**2))
  vals['pre2'].append(np.mean((fwd(weights,x.copy(),True)-target)**2))

   sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=em+c*np.sqrt(ev/np.maximum(sv,1e-30))
  else: rows.append(x.mean(0))
 return np.stack(rows)

def sobol(n,w,seed):
 u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n)))
 return ndtri(np.clip(u,1e-11,1-1e-11))

def target(weights,n,seed,chunk=8192):
 rng=np.random.default_rng(seed); sums=[np.zeros(weights[0].shape[0]) for _ in weights]; done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=k
 return np.stack([s/n for s in sums])
for depth,n_est,nt in [(6,64,16000),(6,128,16000),(10,64,12000),(10,128,12000),(16,64,8000)]:
 vals={k:[] for k in ['mc','diag','a05','a065','a075','a085']}; t=time.time()
 for r in range(8):
  rng=np.random.default_rng(5000+r)
  weights=[rng.standard_normal((256,256))*math.sqrt(2/256) for _ in range(depth)]
  tgt=target(weights,nt,6000+r)
  mc=fwd(weights,sobol(n_est,256,7000+r))
  dg=diag_est(weights)
  vals['mc'].append(np.mean((mc[-1]-tgt[-1])**2)); vals['diag'].append(np.mean((dg[-1]-tgt[-1])**2))
  for a,k in [(0.5,'a05'),(0.65,'a065'),(0.75,'a075'),(0.85,'a085')]: vals[k].append(np.mean(((a*mc+(1-a)*dg)[-1]-tgt[-1])**2))
 print('case d,n,nt',depth,n_est,nt,'time',time.time()-t)
 for k,v in vals.items(): print(k,np.mean(v))

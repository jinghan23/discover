/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import qmc
from scipy.special import ndtri, ndtr
import math, time

SQRT2PI=math.sqrt(2*math.pi)
INV_SQRT2PI=1/SQRT2PI

def relu_mean_var(mu,var):
    sig=np.sqrt(np.maximum(var,1e-30))
    a=mu/sig
    Phi=ndtr(a)
    phi=np.exp(-0.5*a*a)*INV_SQRT2PI
    mean=sig*phi+mu*Phi
    second=(var+mu*mu)*Phi+mu*sig*phi
    v=np.maximum(second-mean*mean,1e-30)
    return mean,v

def diag_est(weights):
    w0=weights[0]
    var=(w0*w0).sum(axis=0)
    m=np.sqrt(var)*INV_SQRT2PI
    v=0.5*var-m*m
    rows=[m]
    for W in weights[1:]:
        mu=m@W
        var=v@(W*W)
        m,v=relu_mean_var(mu,var)
        rows.append(m)
    return np.stack(rows)

def forward_means(weights,x, lms=True):
    rows=[]
    for li,W in enumerate(weights):
        x=np.maximum(x@W,0)
        if li==0 and lms:
            var=(W*W).sum(axis=0)
            em=np.sqrt(var)*INV_SQRT2PI
            ev=0.5*var-em*em
            rows.append(em.copy())
            sm=x.mean(axis=0)
            c=x-sm
            sv=(c*c).mean(axis=0)
            scale=np.sqrt(ev/np.maximum(sv,1e-30))
            x=em+c*scale
        else:
            rows.append(x.mean(axis=0))
    return np.stack(rows)

def sobol_norm(n,w,seed):
    sampler=qmc.Sobol(d=w,scramble=True,seed=int(seed))
    u=sampler.random_base2(int(math.log2(n)))
    u=np.clip(u,1e-11,1-1e-11)
    return ndtri(u)

def target(weights,n,seed,chunk=20000):
    rng=np.random.default_rng(seed)
    sums=[np.zeros(weights[0].shape[0]) for _ in weights]
    done=0
    while done<n:
        k=min(chunk,n-done)
        x=rng.standard_normal((k,weights[0].shape[0]))
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(axis=0)
        done+=k
    return np.stack([s/n for s in sums])

for width,depth,n_est in [(64,6,64),(64,6,128),(128,6,64),(128,6,128),(128,10,64)]:
  mses={'mc':[],'diag':[]}
  blends={a:[] for a in [0.25,0.5,0.75,0.875]}
  t0=time.time()
  for r in range(12):
    rng=np.random.default_rng(1000+r)
    weights=[rng.standard_normal((width,width)).astype(np.float64)*math.sqrt(2/width) for _ in range(depth)]
    tgt=target(weights, 50000 if width<=64 else 25000, 20000+r)
    x=sobol_norm(n_est,width,30000+r)
    mc=forward_means(weights,x,lms=True)
    dg=diag_est(weights)
    mses['mc'].append(np.mean((mc[-1]-tgt[-1])**2))
    mses['diag'].append(np.mean((dg[-1]-tgt[-1])**2))
    for a in blends:
        pr=a*mc+(1-a)*dg
        blends[a].append(np.mean((pr[-1]-tgt[-1])**2))
  print('case',width,depth,n_est,'time',time.time()-t0)
  print(' mc',np.mean(mses['mc']),'diag',np.mean(mses['diag']))
  for a,vals in blends.items(): print(' blend',a,np.mean(vals))

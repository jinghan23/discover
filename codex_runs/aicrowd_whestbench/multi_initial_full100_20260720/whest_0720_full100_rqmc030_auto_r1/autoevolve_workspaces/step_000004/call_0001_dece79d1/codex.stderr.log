import numpy as np, math, time
from scipy.stats import qmc
from scipy.special import ndtri, ndtr
INV=1/math.sqrt(2*math.pi)
def relu_mv(mu,var):
 s=np.sqrt(np.maximum(var,1e-30)); a=mu/s; P=ndtr(a); p=np.exp(-0.5*a*a)*INV
 m=s*p+mu*P; sec=(var+mu*mu)*P+mu*s*p; return m,np.maximum(sec-m*m,1e-30)
def exact_first(W):
 cov=W.T@W; var=np.diag(cov); sd=np.sqrt(np.maximum(var,1e-30)); mean=sd*INV
 rho=np.clip(cov/np.maximum(np.outer(sd,sd),1e-30),-1,1)
 q=np.outer(sd,sd)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
 cv=q-np.outer(mean,mean); v=np.maximum(np.diag(cv),1e-30)
 return mean,v,q,cv
def fwd(weights,x,pre2=False,post2=False,beta=1.0):
 m1,v1,q1,cv1=exact_first(weights[0]); pre2mom=None; post2mom=None
 if len(weights)>1 and (pre2 or post2):
  W2=weights[1]; pm=m1@W2; sec=np.sum(W2*(q1@W2),0); pv=np.maximum(sec-pm*pm,1e-30); pre2mom=(pm,pv); post2mom=relu_mv(pm,pv)
 for li,W in enumerate(weights):
  pre=x@W
  if li==1 and pre2mom is not None and pre2:
   pm,pv=pre2mom; sm=pre.mean(0); c=pre-sm; sv=(c*c).mean(0); pre=pm+c*np.sqrt(pv/np.maximum(sv,1e-30))
  x=np.maximum(pre,0)
  if li==0:
   sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=m1+c*np.sqrt(v1/np.maximum(sv,1e-30))
  elif li==1 and post2 and li < len(weights)-1:
   am,av=post2mom; sm=x.mean(0); c=x-sm; sv=(c*c).mean(0)
   target_m=beta*am+(1-beta)*sm
   target_v=beta*av+(1-beta)*sv
   x=target_m+c*np.sqrt(np.maximum(target_v,1e-30)/np.maximum(sv,1e-30))
 return x.mean(0)
def sob(n,w,seed): return ndtri(np.clip(qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n))),1e-11,1-1e-11))
def targ(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0]); done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=k
 return s/n
for width,depth,nest,nt in [(64,16,128,20000),(64,32,128,16000),(128,10,128,16000),(128,32,64,8000),(256,10,128,8000),(256,32,64,5000),(256,6,128,12000)]:
 vals={k:[] for k in ['base','pre2','post2','both','bothb05','bothb025']}; t=time.time()
 for r in range(16):
  rng=np.random.default_rng(24000+r); weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
  target=targ(weights,nt,25000+r); x=sob(nest,width,26000+r)
  vals['base'].append(np.mean((fwd(weights,x.copy(),False,False)-target)**2))
  vals['pre2'].append(np.mean((fwd(weights,x.copy(),True,False)-target)**2))
  vals['post2'].append(np.mean((fwd(weights,x.copy(),False,True)-target)**2))
  vals['both'].append(np.mean((fwd(weights,x.copy(),True,True,1.0)-target)**2))
  vals['bothb05'].append(np.mean((fwd(weights,x.copy(),True,True,0.5)-target)**2))
  vals['bothb025'].append(np.mean((fwd(weights,x.copy(),True,True,0.25)-target)**2))
 print('case',width,depth,nest,'time',time.time()-t,{k:float(np.mean(v)) for k,v in vals.items()})

import numpy as np, math, time
from scipy.stats import qmc
from scipy.special import ndtri, ndtr
INV=1/math.sqrt(2*math.pi)
def rmv(mu,var):
 s=np.sqrt(np.maximum(var,1e-30)); a=mu/s; P=ndtr(a); p=np.exp(-0.5*a*a)*INV
 m=s*p+mu*P; sec=(var+mu*mu)*P+mu*s*p; return m,np.maximum(sec-m*m,1e-30)
def diag(weights):
 var=(weights[0]*weights[0]).sum(0); m=np.sqrt(var)*INV; v=.5*var-m*m
 for W in weights[1:]:
  m,v=rmv(m@W, v@(W*W))
 return m
def fwd(weights,x):
 for li,W in enumerate(weights):
  x=np.maximum(x@W,0)
  if li==0:
   var=(W*W).sum(0); em=np.sqrt(var)*INV; ev=.5*var-em*em; sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=em+c*np.sqrt(ev/np.maximum(sv,1e-30))
 return x.mean(0)
def sob(n,w,seed): return ndtri(np.clip(qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n))),1e-11,1-1e-11))
def targ(weights,n,seed,chunk=2048):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0]); done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=k
 return s/n
for width,depth,nest,nt in [(64,32,64,12000),(64,64,64,8000),(128,32,64,8000),(256,32,64,4000)]:
 vals={a:[] for a in ['mc','diag','a09','a095','a098','a055']}; t=time.time()
 for r in range(6):
  rng=np.random.default_rng(9000+r); weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
  target=targ(weights,nt,10000+r); mc=fwd(weights,sob(nest,width,11000+r)); dg=diag(weights)
  vals['mc'].append(np.mean((mc-target)**2)); vals['diag'].append(np.mean((dg-target)**2))
  for a,k in [(0.9,'a09'),(.95,'a095'),(.98,'a098'),(.55,'a055')]: vals[k].append(np.mean((a*mc+(1-a)*dg-target)**2))
 print('case',width,depth,'time',time.time()-t)
 for k,v in vals.items(): print(k,np.mean(v))

/bin/bash -lc "python - <<'PY'
# quick synthetic tail-clip comparison with SciPy Sobol; submission logic approximation
import numpy as np, math, time
from scipy.stats import qmc
from scipy.special import ndtri
INV=1/math.sqrt(2*math.pi)
def fwd(weights,x):
 for li,W in enumerate(weights):
  x=np.maximum(x@W,0)
  if li==0:
   var=(W*W).sum(0); em=np.sqrt(var)*INV; ev=.5*var-em*em; sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=em+c*np.sqrt(ev/np.maximum(sv,1e-30))
 return x.mean(0)
def sob(n,w,seed,clip):
 u=qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n)))
 return ndtri(np.clip(u,clip,1-clip))
def targ(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0]); done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=k
 return s/n
clips=[1e-15,1e-12,1e-11,1e-9,1e-7,1e-6]
for width,depth,nest,nt in [(64,32,128,16000),(128,10,128,12000),(256,10,128,6000),(256,32,64,4000)]:
 vals={c:[] for c in clips}; t=time.time()
 for r in range(12):
  rng=np.random.default_rng(27000+r); weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
  target=targ(weights,nt,28000+r)
  for c in clips:
   vals[c].append(np.mean((fwd(weights,sob(nest,width,29000+r,c))-target)**2))
 print('case',width,depth,nest,'time',time.time()-t)
 for c in clips: print(c,float(np.mean(vals[c])))

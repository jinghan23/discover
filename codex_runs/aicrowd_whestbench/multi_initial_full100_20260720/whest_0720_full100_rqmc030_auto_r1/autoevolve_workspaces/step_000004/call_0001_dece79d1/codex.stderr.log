  target=targ(weights,nt,13000+r)
  for anti in [False,True]:
   est=fwd(weights,sob(nest,width,14000+r,anti=anti))
   vals['anti' if anti else 'plain'].append(np.mean((est-target)**2))
 print('case',width,depth,nest,'time',time.time()-t, {k:float(np.mean(v)) for k,v in vals.items()})

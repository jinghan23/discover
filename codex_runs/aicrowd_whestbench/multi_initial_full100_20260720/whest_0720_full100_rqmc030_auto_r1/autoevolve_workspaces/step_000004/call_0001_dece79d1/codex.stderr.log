import numpy as np, math, time
from scipy.stats import qmc
from scipy.special import ndtri
INV=1/math.sqrt(2*math.pi)

def exact_first_moments(W):
 cov=W.T@W
 var=np.diag(cov)
 sd=np.sqrt(np.maximum(var,1e-30))
 mean=sd*INV
 rho=cov/np.maximum(np.outer(sd,sd),1e-30)
 rho=np.clip(rho,-1,1)
 q=np.outer(sd,sd)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
 cv=q-np.outer(mean,mean)
 v=np.maximum(np.diag(cv),1e-30)
 return mean,v,q,cv

def fwd(weights,x,pre2=False,post2=False):
 m1,v1,q1,cv1=exact_first_moments(weights[0])
 exact_pre2=None
 if len(weights)>1 and pre2:
  W2=weights[1]
  pm=m1@W2
  second=np.sum(W2*(q1@W2),axis=0)
  pv=np.maximum(second-pm*pm,1e-30)
  exact_pre2=(pm,pv)
 rows=[]
 for li,W in enumerate(weights):
  pre=x@W
  if li==1 and exact_pre2 is not None:
   pm,pv=exact_pre2; sm=pre.mean(0); c=pre-sm; sv=(c*c).mean(0)
   pre=pm+c*np.sqrt(pv/np.maximum(sv,1e-30))
  x=np.maximum(pre,0)
  if li==0:
   rows.append(m1.copy()); sm=x.mean(0); c=x-sm; sv=(c*c).mean(0); x=m1+c*np.sqrt(v1/np.maximum(sv,1e-30))
  else:
   rows.append(x.mean(0))
 return rows[-1]

def sob(n,w,seed):
 return ndtri(np.clip(qmc.Sobol(d=w,scramble=True,seed=seed).random_base2(int(math.log2(n))),1e-11,1-1e-11))
def targ(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0]); done=0
 while done<n:
  k=min(chunk,n-done); x=rng.standard_normal((k,weights[0].shape[0]))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=k
 return s/n
for width,depth,nest,nt in [(64,16,128,20000),(64,32,128,16000),(128,10,128,16000),(128,32,64,8000),(256,10,128,8000),(256,32,64,5000),(256,6,128,12000)]:
 vals={'base':[],'pre2':[]}; t=time.time()

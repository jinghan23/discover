from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import SetupContext
import submission

def run(spec):
    print('spec', spec.width, spec.depth, spec.flop_budget, spec.n_mlps, spec.ground_truth_samples)
    data = make_contest(spec)
    base_keys = ['_TARGET_FLOP_FRACTION','_FINAL_RICHARDSON_GAMMA','_FIRST_VARIANCE_BETA','_POST2_MEAN_BETA','_POST2_VARIANCE_BETA']
    base = {k:getattr(submission,k) for k in base_keys}
    for frac in [0.10,0.12,0.14,0.16,0.18,0.20,0.24,0.28]:

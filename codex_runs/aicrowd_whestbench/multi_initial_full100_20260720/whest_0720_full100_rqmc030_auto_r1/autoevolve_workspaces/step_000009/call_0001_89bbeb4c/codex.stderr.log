        submission._TARGET_FLOP_FRACTION=frac
        est=submission.Estimator(); est.setup(SetupContext(width=spec.width, depth=spec.depth, flop_budget=spec.flop_budget, api_version='local', seed=999))
        res=evaluate_estimator(est,data)
        print(frac, res['adjusted_final_layer_score'], res['final_layer_mse'], res['mean_score_multiplier'], res['n_failed_mlps'])
    for k,v in base.items(): setattr(submission,k,v)


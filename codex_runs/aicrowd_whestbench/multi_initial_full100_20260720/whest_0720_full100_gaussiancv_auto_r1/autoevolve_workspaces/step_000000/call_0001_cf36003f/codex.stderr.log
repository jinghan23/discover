import numpy as np
from scipy.special import ndtr
from math import sqrt, pi
PDF_C=1/sqrt(2*pi)
def pdf(x): return PDF_C*np.exp(-0.5*x*x)
def diag_pass(weights):
    width=weights[0].shape[0]; d_mu=np.zeros(width); d_var=np.ones(width); rows=[]; vars=[]; pres=[]
    for w in weights:
        pre=w.T@d_mu; v=(w*w).T@d_var; v=np.maximum(v,1e-12); s=np.sqrt(v); a=pre/s; c=ndtr(a); p=pdf(a)
        d_mu=pre*c+s*p; ez2=(pre*pre+v)*c+pre*s*p; d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu); vars.append(d_var); pres.append(pre)
    return rows,vars,pres
def matsqrt(m, inv=False):
    vals,vecs=np.linalg.eigh(m); d=(1/np.sqrt(np.maximum(vals,1e-12)) if inv else np.sqrt(np.maximum(vals,1e-12)))
    return vecs@(np.diag(d)@vecs.T)
def pred(weights, seed, n_samples=4096, beta=0.0, beta_until=31, gamma=0.0):

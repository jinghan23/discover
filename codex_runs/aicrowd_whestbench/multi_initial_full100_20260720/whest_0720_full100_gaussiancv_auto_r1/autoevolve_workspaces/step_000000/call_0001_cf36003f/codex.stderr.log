/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import sqrt, pi
PDF_C=1/sqrt(2*pi)
def pdf(x): return PDF_C*np.exp(-0.5*x*x)
def relu_moments(m,v):
    v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; c=ndtr(a); p=pdf(a)
    mu=m*c+s*p; ez2=(m*m+v)*c+m*s*p; var=np.maximum(ez2-mu*mu,1e-12)
    return mu,var,a,c,p,s
def full_cov_est(weights, order=6, project=False):
    w0=weights[0]; width=w0.shape[0]
    mu=np.zeros(width); C=np.eye(width)
    rows=[]
    for l,w in enumerate(weights):
        m=w.T@mu
        S=w.T@(C@w)
        S=0.5*(S+S.T)
        v=np.maximum(np.diag(S),1e-12)
        rscale=np.sqrt(np.outer(v,v)); rho=np.clip(S/np.maximum(rscale,1e-12),-0.999999,0.999999)
        mu2,var,a,c,p,s=relu_moments(m,v)
        rows.append(mu2)
        if l==len(weights)-1:
            return mu2, m, v
        if order=='zero':
            root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            second=np.outer(s,s)*ker
            C=second-np.outer(mu2,mu2)
        else:
            b1=s*c; b2=s*p; cov=np.outer(b1,b1)*rho
            if order>=2:
                cov += 0.5*np.outer(b2,b2)*(rho*rho)
            if order>=3:
                b3=-s*a*p; cov += (1/6)*np.outer(b3,b3)*(rho**3)
            if order>=4:
                b4=s*(a*a-1)*p; cov += (1/24)*np.outer(b4,b4)*(rho**4)
            if order>=5:
                b5=s*(-a**3+3*a)*p; cov += (1/120)*np.outer(b5,b5)*(rho**5)
            if order>=6:
                b6=s*(a**4-6*a*a+3)*p; cov += (1/720)*np.outer(b6,b6)*(rho**6)
            C=cov

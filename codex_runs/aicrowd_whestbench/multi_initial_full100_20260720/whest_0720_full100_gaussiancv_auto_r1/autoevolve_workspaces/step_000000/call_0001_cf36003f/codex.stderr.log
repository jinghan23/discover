    for w in weights:
        d_mu_pre=w.T@d_mu
        d_var_pre=(w*w).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); a=d_mu_pre/sig
        c=ndtr(a); p=pdf(a)
        d_mu=d_mu_pre*c+sig*p
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*p
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu); vars.append(d_var); pres.append(d_mu_pre); prevars.append(d_var_pre)
    return rows, vars, pres, prevars

def features(weights, seed, n_samples=4096, coeffs=(-0.245,1.455,-0.455)):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows, diag_vars, pres, prevars=diag_pass(weights)
    rng=np.random.default_rng(seed+2)
    x0=rng.standard_normal((n_samples//2,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(width)
    Amean,B,C=coeffs
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0); x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(np.outer(sigma0,sigma0),1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=np.outer(sigma0,sigma0)*kernel0
            target_cov=target_second-np.outer(diag_rows[0],diag_rows[0])
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+Amean*(x_mean0-diag_rows[0])+B*(x_full-diag_rows[0])+C*x_center
    z=x@weights[-1]
    z_mean=z.mean(axis=0); z_center=z-z_mean; z_var=np.mean(z_center*z_center,axis=0)
    sig=np.sqrt(np.maximum(z_var,1e-12)); a=z_mean/sig
    final_gauss=z_mean*ndtr(a)+sig*pdf(a)
    a_md=pres[-1]/sig
    final_mixed=pres[-1]*ndtr(a_md)+sig*pdf(a_md)
    final_mc=np.maximum(z,0).mean(axis=0)
    diag_final=diag_rows[-1]
    return np.vstack([final_mc,final_gauss,final_mixed,diag_final]).T

def truth(weights, seed, n=100000, batch=10000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed+10000)
    s=np.zeros(width); c=0
    for _ in range(n//batch):
        x=rng.standard_normal((batch,width))
        for w in weights:
            x=np.maximum(x@w,0)
        s += x.sum(axis=0); c += batch
    return s/c

def run(width=96, depth=20, m=12, scale='he'):
    X=[]; y=[]
    for seed in range(m):
        rng=np.random.default_rng(1000+seed)
        std=(np.sqrt(2/width) if scale=='he' else 1/np.sqrt(width))
        weights=[rng.standard_normal((width,width))*std for _ in range(depth)]
        f=features(weights, seed, n_samples=4096)
        t=truth(weights, seed, n=60000, batch=6000)
        X.append(f); y.append(t)
        base=0.99965*(1.037*f[:,0]-0.0425*f[:,1]+0.0055*f[:,2])
        print(seed, 'base mse', np.mean((base-t)**2), 'mc', np.mean((f[:,0]-t)**2), 'diag', np.mean((f[:,3]-t)**2), flush=True)
    X=np.concatenate(X); y=np.concatenate(y)
    # fit with intercept? no intercept first
    for cols,name in [([0,1,2],'mc,gauss,mix'),([0,1,2,3],'plusdiag'),([0,1,2,3],'sum1')]:
        A=X[:,cols]
        coef=np.linalg.lstsq(A,y,rcond=None)[0]
        pred=A@coef
        print(name, 'coef', coef, 'mse', np.mean((pred-y)**2), 'meanerr', np.mean(pred-y))
    # sum-to-one constraint for 4
    A=X[:,:4]
    # solve min ||A c-y|| s.t. 1c=1
    ATA=A.T@A; ATy=A.T@y; ones=np.ones(4)
    K=np.block([[ATA, ones[:,None]],[ones[None,:], np.zeros((1,1))]])
    rhs=np.r_[ATy,1]
    sol=np.linalg.solve(K,rhs)[:4]
    print('sum1 4 coef', sol, 'mse', np.mean((A@sol-y)**2), 'meanerr', np.mean(A@sol-y))

print('HE')
run(scale='he')
print('XAV')
run(scale='xav')

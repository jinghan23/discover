        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sig=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); rho=np.clip(t_cov/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(pi-np.arccos(rho))*rho)/(2*pi); tc=np.outer(sig,sig)*ker-np.outer(rows[0],rows[0]); tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]
            xf=xc@(matsqrt((xc.T@xc)/n_samples, True)@matsqrt(tc, False))+rows[0]
            x=rows[0]-0.245*(xm-rows[0])+1.455*(xf-rows[0])-0.455*xc
        elif i < beta_until and (beta or gamma):
            xm=x.mean(0)
            if gamma:
                xc=x-xm; xv=np.mean(xc*xc,0); sc=np.sqrt(np.maximum(vars[i],1e-12)/np.maximum(xv,1e-12))
                x=xm + (1.0 + gamma*(sc-1.0))*xc
            if beta:
                x=x + beta*(rows[i]-xm)
    z=x@weights[-1]; z=np.asarray(z,dtype=np.float64); zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs
    fg=zm*ndtr(a)+zs*pdf(a); amd=pres[-1]/zs; fm=pres[-1]*ndtr(amd)+zs*pdf(amd); fmc=np.maximum(z,0).mean(0)
    return 0.99965*(1.037*fmc-0.0425*fg+0.0055*fm)
def truth(weights, seed, n=60000, batch=3000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+10000); s=np.zeros(width); c=0
    for _ in range(n//batch):
        x=rng.standard_normal((batch,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); c+=batch
    return s/c
configs=[]
for b in [0,0.02,0.05,0.1,0.2,-0.02,-0.05]: configs.append((f'b{b}',dict(beta=b)))
for b in [0.05,0.1,0.2]: configs.append((f'b{b}_u8',dict(beta=b,beta_until=8)))
for g in [0.02,0.05,0.1,-0.02]: configs.append((f'g{g}',dict(gamma=g)))
for b,g in [(0.05,0.02),(0.05,-0.02),(0.1,0.02)]: configs.append((f'b{b}g{g}',dict(beta=b,gamma=g)))
mses={name:[] for name,_ in configs}
for seed in range(5):
    width=256; depth=32; rng=np.random.default_rng(7000+seed); weights=[rng.standard_normal((width,width))*np.sqrt(2/width) for _ in range(depth)]
    t=truth(weights, seed)
    vals={}

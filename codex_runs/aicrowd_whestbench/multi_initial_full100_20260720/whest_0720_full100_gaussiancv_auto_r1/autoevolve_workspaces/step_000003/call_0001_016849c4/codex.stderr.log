import numpy as np
from scipy.stats import norm
import time

def gen_mlp(width, depth, seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2.0/width)
    return [(rng.standard_normal((width,width)).astype(np.float32)*scale).astype(np.float32) for _ in range(depth)]

def target_mc(weights, n=1500000, seed=999, chunk=50000):
    width=weights[0].shape[0]; depth=len(weights)
    sums=[np.zeros(width, np.float64) for _ in range(depth)]
    rng=np.random.default_rng(seed); done=0
    while done<n:
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width)).astype(np.float32)
        for i,w in enumerate(weights):
            x=np.maximum(x@w,0.0)
            sums[i]+=x.astype(np.float64).sum(axis=0)
    return np.stack([s/n for s in sums])

def compute_diag(weights):
    width=weights[0].shape[0]
    d_mu=np.zeros(width); d_var=np.ones(width); rows=[]; vars=[]; pre=[]; prevar=[]
    for w in weights:
        pm=w.T@d_mu; pv=(w*w).T@d_var; pv=np.maximum(pv,1e-12)
        sig=np.sqrt(pv); a=pm/sig; c=norm.cdf(a); p=norm.pdf(a)
        d_mu=pm*c+sig*p
        ez2=(pm*pm+pv)*c+pm*sig*p
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        pre.append(pm); prevar.append(pv); rows.append(d_mu); vars.append(d_var)
    return rows,vars,pre,prevar

def feat(weights, mlp_seed=123, n_samples=8200, a=1.32, b=-0.32, plam=0.0):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows,diag_vars,pre,prevar=compute_diag(weights)
    rng=np.random.default_rng(int(mlp_seed)+3); half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0]).astype(np.float64); eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w; z_center=z-z.mean(0); sc=(z_center.T@z_center)/n_samples
            sv,svv=np.linalg.eigh(sc); tv,tvv=np.linalg.eigh(t_cov)
            inv=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T)
            ts=tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T)
            z=z_center@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n_samples
            sv,svv=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            tsecond=sigma[:,None]*sigma[None,:]*kernel
            tcov=tsecond-diag_rows[0][:,None]*diag_rows[0][None,:]
            tcov=0.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*diag_vars[0][None,:]
            tv,tvv=np.linalg.eigh(tcov)
            inv=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T)
            ts=tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T)
            xfull=xc@(inv@ts)+diag_rows[0]
            x=diag_rows[0]+a*(xfull-diag_rows[0])+b*xc
        elif plam:
            xm=x.mean(0); xc=x-xm; xv=np.mean(xc*xc,0)
            xadj=diag_rows[i]+xc*np.sqrt(np.maximum(diag_vars[i],1e-12)/np.maximum(xv,1e-12))
            x=x+plam*(xadj-x)
    z=x@weights[-1]; z=z.astype(np.float64); zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12))
    alpha=zm/zs; fg=zm*norm.cdf(alpha)+zs*norm.pdf(alpha)
    amd=pre[-1]/zs; fmd=pre[-1]*norm.cdf(amd)+zs*norm.pdf(amd)
    fmc=np.maximum(z,0).mean(0)
    # variants of moments
    alpha2=pre[-1]/np.sqrt(np.maximum(prevar[-1],1e-12)); ddiag=diag_rows[-1]
    return np.stack([fmc,fg,fmd,ddiag,zm,zs,np.ones(width)],1)

def base_pred(F):
    return 0.999565*(1.01480*F[:,0]-0.0200*F[:,1]+0.00520*F[:,2])


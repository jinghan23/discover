import numpy as np
from scipy.stats import norm
import time

def gen_mlp(width, depth, seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2.0/width).astype(np.float32) if hasattr(np.sqrt(2.0/width),'astype') else np.sqrt(2.0/width)
    return [(rng.standard_normal((width,width)).astype(np.float32)*scale).astype(np.float32) for _ in range(depth)]

def target_mc(weights, n=300000, seed=999, chunk=20000):
    width=weights[0].shape[0]; depth=len(weights)
    sums=[np.zeros(width, np.float64) for _ in range(depth)]
    rng=np.random.default_rng(seed)
    done=0
    while done<n:
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width)).astype(np.float32)
        for i,w in enumerate(weights):
            x=np.maximum(x@w,0.0)
            sums[i]+=x.astype(np.float64).sum(axis=0)
    return np.stack([s/n for s in sums]).astype(np.float64)

def features(weights, mlp_seed=123, budget=10**12, n_samples=8200, a=1.32, b=-0.32, per_layer=False, plam=1.0):
    width=weights[0].shape[0]; depth=len(weights)
    d_mu=np.zeros(width); d_var=np.ones(width); diag_rows=[]; diag_vars=[]; pre_rows=[]; pre_vars=[]
    for w in weights:
        d_mu_pre=w.T@d_mu
        d_var_pre=(w*w).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); alpha=d_mu_pre/sig
        cdf=norm.cdf(alpha); phi=norm.pdf(alpha)
        d_mu=d_mu_pre*cdf+sig*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*cdf+d_mu_pre*sig*phi
        d_var=np.maximum(ez2-d_mu*d_mu,0.0)
        pre_rows.append(d_mu_pre); pre_vars.append(d_var_pre)
        diag_rows.append(d_mu); diag_vars.append(d_var)
    if depth==1:
        return None
    rng=np.random.default_rng(int(mlp_seed)+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    t_cov_first=None
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w; t_cov_first=t_cov
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0.0)
        if i==0:
            x_mean0=x.mean(axis=0); x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            pi=np.pi
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+a*(x_full-diag_rows[0])+b*x_center
        elif per_layer:
            xm=x.mean(axis=0); xc=x-xm; xv=np.mean(xc*xc,axis=0)
            scale=np.sqrt(np.maximum(diag_vars[i],1e-12)/np.maximum(xv,1e-12))
            x_adj=diag_rows[i]+xc*scale
            x=x + plam*(x_adj-x)
    z=x@weights[-1]
    z64=z.astype(np.float64)
    zm=z64.mean(axis=0); zc=z64-zm; zv=np.mean(zc*zc,axis=0); zs=np.sqrt(np.maximum(zv,1e-12))
    alpha=zm/zs; fg=zm*norm.cdf(alpha)+zs*norm.pdf(alpha)
    amd=pre_rows[-1]/zs; fmd=pre_rows[-1]*norm.cdf(amd)+zs*norm.pdf(amd)
    fmc=np.maximum(z64,0.0).mean(axis=0)
    # Additional features
    dd=diag_rows[-1]
    return np.stack([fmc, fg, fmd, dd, np.ones(width)],axis=1), np.stack(diag_rows[:-1])


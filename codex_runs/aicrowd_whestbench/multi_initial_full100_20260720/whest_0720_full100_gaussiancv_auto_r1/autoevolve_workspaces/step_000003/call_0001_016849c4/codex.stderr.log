/bin/bash -lc "python - <<'PY'
# Local sweep: penultimate-only moment shrinkage before final layer.
import numpy as np
from scipy.stats import norm

def gen(w,d,s):
 r=np.random.default_rng(s); return [(r.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def targ(weights,n,seed):
 w=weights[0].shape[0]; sums=np.zeros(w); r=np.random.default_rng(seed); done=0; chunk=50000
 while done<n:
  m=min(chunk,n-done); done+=m; x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  sums+=x.astype(np.float64).sum(0)
 return sums/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
 for W in weights:
  pm=W.T@mu; pv=(W*W).T@var; pv=np.maximum(pv,1e-12); s=np.sqrt(pv); a=pm/s; c=norm.cdf(a); p=norm.pdf(a); mu=pm*c+s*p; ez=(pm*pm+pv)*c+pm*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var); pre.append(pm)
 return rows,vars,pre
def base_x(weights,seed,n):
 w=weights[0].shape[0]; rows,vars,pre=diag(weights); r=np.random.default_rng(seed+3); h=n//2; x0=r.standard_normal((h,w)).astype(np.float32); x=np.concatenate([x0,-x0]).astype(np.float64); eye=np.eye(w)
 for i,W in enumerate(weights[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc); inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T); ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T); z=zc@(inv@ts)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(tc/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tsec=sig[:,None]*sig[None,:]*kern; tcov=tsec-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]

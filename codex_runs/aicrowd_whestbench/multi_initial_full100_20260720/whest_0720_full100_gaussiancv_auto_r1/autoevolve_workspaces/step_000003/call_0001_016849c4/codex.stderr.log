 x0=r.standard_normal((h,w)).astype(np.float32); x=np.concatenate([x0,-x0]).astype(np.float64); eye=np.eye(w)
 for i,W in enumerate(weights[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc)
   inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T); ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T); z=zc@(inv@ts)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12)
   rho=np.clip(tc/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
   tsec=sig[:,None]*sig[None,:]*kern; tcov=tsec-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
   tv,te=np.linalg.eigh(tcov); inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T); ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T); xf=xc@(inv@ts)+rows[0]
   x=rows[0]+1.32*(xf-rows[0])-0.32*xc
 z=(x@weights[-1]).astype(np.float64); zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs
 fg=zm*norm.cdf(a)+zs*norm.pdf(a); am=pre[-1]/zs; fmd=pre[-1]*norm.cdf(am)+zs*norm.pdf(am); fmc=np.maximum(z,0).mean(0)
 return 0.999565*(1.01480*fmc-0.0200*fg+0.00520*fmd)
for w,d,N,nt in [(32,16,20,1500000),(64,16,12,1000000),(96,12,8,700000)]:
 print('\\nspec',w,d); data=[]
 for k in range(N):
  weights=gen(w,d,40000+w*100+k); y=targ(weights,nt,50000+k); data.append((weights,y))

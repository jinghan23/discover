# Reuse a compact numpy implementation to compare sample counts on generated MLPs.
import numpy as np
from scipy.stats import norm
import time

def gen(w,d,s):
 r=np.random.default_rng(s); return [(r.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def targ(weights,n,seed):
 w=weights[0].shape[0]; sums=np.zeros(w); r=np.random.default_rng(seed); done=0; chunk=60000
 while done<n:
  m=min(chunk,n-done); done+=m; x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  sums+=x.astype(np.float64).sum(0)
 return sums/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
 for W in weights:
  pm=W.T@mu; pv=(W*W).T@var; pv=np.maximum(pv,1e-12); sig=np.sqrt(pv); a=pm/sig; c=norm.cdf(a); p=norm.pdf(a)
  mu=pm*c+sig*p; ez=(pm*pm+pv)*c+pm*sig*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var); pre.append(pm)
 return rows,vars,pre
def pred(weights, seed, n):

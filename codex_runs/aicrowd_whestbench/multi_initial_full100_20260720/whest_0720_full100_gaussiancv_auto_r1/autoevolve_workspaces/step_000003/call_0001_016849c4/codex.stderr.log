/bin/bash -lc "python - <<'PY'
# Local compare random normal vs Latin-hypercube probes in current estimator.
import numpy as np
from scipy.stats import norm

def gen(w,d,s):
 r=np.random.default_rng(s); return [(r.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def targ(weights,n,seed):
 w=weights[0].shape[0]; sums=np.zeros(w); r=np.random.default_rng(seed); done=0; chunk=50000
 while done<n:
  m=min(chunk,n-done); done+=m; x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  sums+=x.astype(np.float64).sum(0)
 return sums/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
 for W in weights:
  pm=W.T@mu; pv=(W*W).T@var; pv=np.maximum(pv,1e-12); s=np.sqrt(pv); a=pm/s; c=norm.cdf(a); p=norm.pdf(a); mu=pm*c+s*p; ez=(pm*pm+pv)*c+pm*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var); pre.append(pm)
 return rows,vars,pre
def make_x(w,h,seed,kind):
 r=np.random.default_rng(seed+3)
 if kind=='normal':
  x0=r.standard_normal((h,w)).astype(np.float32)
 elif kind=='lhs':
  base=(np.arange(h)+0.5)/h
  U=np.empty((h,w),np.float64)
  for j in range(w): U[:,j]=base[r.permutation(h)]
  x0=norm.ppf(U).astype(np.float32)
 elif kind=='lhs_jitter':
  U=np.empty((h,w),np.float64)
  for j in range(w): U[:,j]=(r.permutation(h)+r.random(h))/h
  x0=norm.ppf(U).astype(np.float32)
 return np.concatenate([x0,-x0]).astype(np.float64)
def pred(weights,seed,n,kind):
 w=weights[0].shape[0]; rows,vars,pre=diag(weights); h=n//2; x=make_x(w,h,seed,kind); eye=np.eye(w)
 for i,W in enumerate(weights[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc); inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T); ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T); z=zc@(inv@ts)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(tc/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tsec=sig[:,None]*sig[None,:]*kern; tcov=tsec-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
   tv,te=np.linalg.eigh(tcov); inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T); ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T); xf=xc@(inv@ts)+rows[0]; x=rows[0]+1.32*(xf-rows[0])-0.32*xc
 z=(x@weights[-1]).astype(np.float64); zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs; fg=zm*norm.cdf(a)+zs*norm.pdf(a); am=pre[-1]/zs; fmd=pre[-1]*norm.cdf(am)+zs*norm.pdf(am); fmc=np.maximum(z,0).mean(0)
 return 0.999565*(1.01480*fmc-0.0200*fg+0.00520*fmd)
for w,d,N,nt in [(32,16,18,1200000),(64,16,12,900000),(96,12,8,600000)]:
 data=[]; print('\\nspec',w,d)
 for k in range(N):
  weights=gen(w,d,100000+w*100+k); y=targ(weights,nt,101000+k); data.append((weights,y))
 for kind in ['normal','lhs','lhs_jitter']:
  ms=[]
  for k,(weights,y) in enumerate(data): ms.append(np.mean((pred(weights,102000+k,8200,kind)-y)**2))
  print(kind,'mean',np.mean(ms),'median',np.median(ms))

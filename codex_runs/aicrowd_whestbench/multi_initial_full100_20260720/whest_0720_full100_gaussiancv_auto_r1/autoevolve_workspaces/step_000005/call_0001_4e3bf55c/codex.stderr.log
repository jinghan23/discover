import numpy as np
from scipy.special import ndtr
from math import pi

SQRT2PI = np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI
def relu_mom(mu,var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; c=ndtr(a); p=pdf(a)
    m=mu*c+sig*p
    ez2=(mu*mu+var)*c+mu*sig*p
    v=np.maximum(ez2-m*m,0)
    return m,v

def diag_prop(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]; prevar=[]
    for W in weights:
        mu_pre=W.T@mu; var_pre=(W*W).T@var
        mu,var=relu_mom(mu_pre,var_pre)
        rows.append(mu); vars.append(var); pre.append(mu_pre); prevar.append(var_pre)
    return rows, vars, pre, prevar

def features(weights, seed, n_samples=8200, A=1.32, B=-0.32, dtype=np.float64, final_use64=True, diag_match=0.0, z_match=0.0):
    width=weights[0].shape[0]; depth=len(weights)
    rows, vars, pre, prevar = diag_prop(weights)
    rng=np.random.default_rng(int(seed)+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(dtype)
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            zc=z-z.mean(axis=0)
            sample_cov=zc.T@zc/n_samples
            sv,svec=np.linalg.eigh(sample_cov)
            tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        elif z_match:
            z_mean=z.mean(axis=0); zc=z-z_mean; zv=np.mean(zc*zc,axis=0)
            z_target_mean=pre[i]; z_target_std=np.sqrt(np.maximum(prevar[i],1e-12)); zs=np.sqrt(np.maximum(zv,1e-12))
            z_adj=z_target_mean + zc*(z_target_std/zs)
            z=(1-z_match)*z+z_match*z_adj
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(axis=0); xc=x-xm; sample_cov=xc.T@xc/n_samples
            sv,svec=np.linalg.eigh(sample_cov)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=scale*kernel
            target_cov=target_second-rows[0][:,None]*rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            x_full=xc@(inv@ts)+rows[0]
            x=rows[0]+A*(x_full-rows[0])+B*xc
        elif diag_match:
            xm=x.mean(axis=0); xc=x-xm; xv=np.mean(xc*xc,axis=0)
            x_adj=rows[i]+xc*(np.sqrt(np.maximum(vars[i],1e-12))/np.sqrt(np.maximum(xv,1e-12)))
            x=(1-diag_match)*x+diag_match*x_adj
    z=x@weights[-1]
    z64=z.astype(np.float64)
    zm=z64.mean(axis=0); zc=z64-zm; zv=np.mean(zc*zc,axis=0); zs=np.sqrt(np.maximum(zv,1e-12)); za=zm/zs
    final_gauss=zm*ndtr(za)+zs*pdf(za)
    za_md=pre[-1]/zs
    final_mixed=pre[-1]*ndtr(za_md)+zs*pdf(za_md)
    final_mc=np.maximum(z64,0).mean(axis=0)
    return np.stack([final_mc, final_gauss, final_mixed, rows[-1]],axis=1)

def true_final(weights, rng, n=300000, chunk=20000):
    w=weights[0].shape[0]
    total=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        total += x.astype(np.float64).sum(axis=0); done += m
    return total/n

def run(width=64,depth=8,n_mlps=16,target_n=300000,n_samples=8200,A=1.32,B=-0.32):
    rngw=np.random.default_rng(12345)
    X=[]; y=[]
    for k in range(n_mlps):
        weights=[(rngw.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
        seed=int(rngw.integers(0,2**32-1))
        feat=features(weights,seed,n_samples,A,B)
        tgt=true_final(weights,np.random.default_rng(9000+k),target_n)
        X.append(feat); y.append(tgt)
        if (k+1)%4==0: print('done',k+1,flush=True)
    X=np.concatenate(X,axis=0); y=np.concatenate(y,axis=0)
    base=np.array([1.01480*0.999565,-0.0200*0.999565,0.00520*0.999565,0.0])
    pred=X@base
    print('base mse',np.mean((pred-y)**2),'mean err',np.mean(pred-y),'rel',np.mean(pred)/np.mean(y))
    for cols,name in [([0],'mc'),([0,1,2],'mc_gauss_mix'),([0,1,2,3],'all')]:
        coef=np.linalg.lstsq(X[:,cols],y,rcond=None)[0]
        pr=X[:,cols]@coef
        print(name,'coef',coef,'mse',np.mean((pr-y)**2),'meanerr',np.mean(pr-y))
run()

import numpy as np
from scipy.special import ndtr
from math import pi
SQRT2PI=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-.5*x*x)/SQRT2PI
def relu_mom(mu,var):
 var=np.maximum(var,1e-12); s=np.sqrt(var); a=mu/s; c=ndtr(a); p=pdf(a); m=mu*c+s*p; e=(mu*mu+var)*c+mu*s*p; return m,np.maximum(e-m*m,0)
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
 for W in weights:
  mp=W.T@mu; vp=(W*W).T@var; mu,var=relu_mom(mp,vp); rows.append(mu); vars.append(var); pre.append(mp)
 return rows,vars,pre
def pred(weights,seed,A,n=8200):
 w=weights[0].shape[0]; rows,vars,pre=diag(weights); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,w)).astype(np.float32); x=np.r_[x0,-x0].astype(float); I=np.eye(w)
 for i,W in enumerate(weights[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sv,U=np.linalg.eigh(zc.T@zc/n); tv,V=np.linalg.eigh(tc); M=U@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@U.T)@(V@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@V.T)); z=zc@M
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sv,U=np.linalg.eigh(xc.T@xc/n); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(tc/scale,-.999999,.999999); K=(np.sqrt(np.maximum(1-rho*rho,0))+(pi-np.arccos(rho))*rho)/(2*pi); C=scale*K-rows[0][:,None]*rows[0][None,:]; C=.5*(C+C.T); C=C*(1-I)+I*vars[0][None,:]; tv,V=np.linalg.eigh(C); M=U@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@U.T)@(V@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@V.T)); xf=xc@M+rows[0]; x=rows[0]+A*(xf-rows[0])+(1-A)*xc
 z=x@weights[-1]; zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12)); fg=zm*ndtr(zm/zs)+zs*pdf(zm/zs); fmd=pre[-1]*ndtr(pre[-1]/zs)+zs*pdf(pre[-1]/zs); fmc=np.maximum(z,0).mean(0)
 return .999565*(1.0148*fmc-.0200*fg+.0052*fmd), np.c_[fmc,fg,fmd,rows[-1]]
def true(weights,rng,N,chunk=16000):
 w=weights[0].shape[0]; s=np.zeros(w); done=0
 while done<N:
  m=min(chunk,N-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/N
for width,depth,N,cases_n in [(64,16,250000,12),(128,8,160000,8),(32,16,400000,16)]:
 rngw=np.random.default_rng(500+width+depth); cases=[]
 print('suite',width,depth,flush=True)
 for k in range(cases_n):
  weights=[(rngw.standard_normal((width,width))*np.sqrt(2/width)).astype(float) for _ in range(depth)]
  seed=int(rngw.integers(0,2**32-1)); tgt=true(weights,np.random.default_rng(60000+k+width),N); cases.append((weights,seed,tgt)); print(' t',k+1,flush=True)
 for A in [0.6,0.8,1.0,1.2,1.32,1.5]:
  ms=[]; X=[]; y=[]

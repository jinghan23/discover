import time, math, numpy as np
from scipy.special import ndtr
WIDTH=256; DEPTH=32
SQRT2PI=math.sqrt(2*math.pi); PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def diag_prop(weights):
    w=weights[0].shape[0]
    d_mu=np.zeros(w); d_var=np.ones(w)
    rows=[]; vars=[]; pre_mus=[]
    for W in weights:
        W=W.astype(np.float64,copy=False)
        pre=W.T@d_mu
        var=(W*W).T@d_var; var=np.maximum(var,1e-12)
        sig=np.sqrt(var); a=pre/sig; ph=pdf(a); c=ndtr(a)
        d_mu=pre*c+sig*ph
        ez2=(pre*pre+var)*c+pre*sig*ph
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pre_mus.append(pre.copy())
    return rows, vars, pre_mus

def cov_prop(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); cov=np.eye(w); rows=[]
    for W in weights:
        W=W.astype(np.float64,copy=False)
        pre=W.T@mu
        cov_pre=W.T@cov@W
        var=np.maximum(np.diag(cov_pre),1e-12); sig=np.sqrt(var)
        a=pre/sig; ph=pdf(a); c=ndtr(a)
        mu=pre*c+sig*ph
        ez2=(pre*pre+var)*c+pre*sig*ph
        var_post=np.maximum(ez2-mu*mu,0)
        gain=np.where(sig>1e-12,c,0.0)
        cov=(gain[:,None]*gain[None,:])*cov_pre
        np.fill_diagonal(cov,var_post)
        cov=0.5*(cov+cov.T)
        rows.append(mu.copy())
    return rows

def current_features(weights, seed=0, n_samples=8200, a=1.24, b=-0.24, rng_offset=3):
    width=weights[0].shape[0]
    diag_rows, diag_vars, pre_mus=diag_prop(weights)
    rng=np.random.default_rng(seed+rng_offset)
    half=n_samples//2
    x0=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64,copy=False)
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        W=W.astype(np.float64,copy=False)
        z=x@W
        if i==0:
            t_cov=W.T@W
            zc=z-z.mean(axis=0)
            sc=(zc.T@zc)/n_samples
            sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(t_cov)
            inv=(svec*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@svec.T
            ts=(tvec*np.sqrt(np.maximum(tv,1e-12))[None,:])@tvec.T
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(axis=0); xc=x-xm; sc=(xc.T@xc)/n_samples
            sv,svec=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            rho=np.clip(t_cov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(PI-np.arccos(rho))*rho)/(2*PI)
            targ=(sigma[:,None]*sigma[None,:])*kern - diag_rows[0][:,None]*diag_rows[0][None,:]
            targ=0.5*(targ+targ.T); targ=targ*(1-eye)+eye*diag_vars[0][None,:]
            tv,tvec=np.linalg.eigh(targ)
            inv=(svec*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@svec.T
            ts=(tvec*np.sqrt(np.maximum(tv,1e-12))[None,:])@tvec.T

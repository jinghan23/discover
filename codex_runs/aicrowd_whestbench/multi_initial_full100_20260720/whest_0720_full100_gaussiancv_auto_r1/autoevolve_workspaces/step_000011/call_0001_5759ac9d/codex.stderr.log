    rng=np.random.default_rng(seed)
    scale=np.sqrt(2/WIDTH)
    return [(rng.standard_normal((WIDTH,WIDTH), dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]

errs=[]; vars=[]

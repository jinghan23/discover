import time, math, numpy as np
from scipy.special import ndtr
WIDTH=256; DEPTH=32; SQRT2PI=math.sqrt(2*math.pi); PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI
# Functions compacted from previous scripts.
def diag_prop(Ws):
    mu=np.zeros(WIDTH); var=np.ones(WIDTH); rows=[]; vars=[]; prem=[]
    for W in Ws:
        W=W.astype(np.float64,copy=False); pre=W.T@mu; vp=(W*W).T@var; vp=np.maximum(vp,1e-12)
        sig=np.sqrt(vp); a=pre/sig; ph=pdf(a); c=ndtr(a); mu=pre*c+sig*ph
        ez=(pre*pre+vp)*c+pre*sig*ph; var=np.maximum(ez-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); prem.append(pre.copy())
    return rows,vars,prem

def feats(Ws, seed, n=8200, acoef=1.24, bcoef=-0.24):
    rows,vars,prem=diag_prop(Ws); rng=np.random.default_rng(seed+3); half=n//2
    x0=rng.standard_normal((half,WIDTH), dtype=np.float32); x=np.concatenate([x0,-x0]).astype(np.float64)
    eye=np.eye(WIDTH)
    for i,W in enumerate(Ws[:-1]):
        W=W.astype(np.float64,copy=False); z=x@W
        if i==0:
            tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,U=np.linalg.eigh(sc); tv,V=np.linalg.eigh(tc)
            z=zc@(((U*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@U.T)@((V*np.sqrt(np.maximum(tv,1e-12))[None,:])@V.T))
        x=np.maximum(z,0)
        if i==0:
            xc=x-x.mean(0); sc=(xc.T@xc)/n; sv,U=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); den=np.maximum(sig[:,None]*sig[None,:],1e-12)
            rho=np.clip(tc/den,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(PI-np.arccos(rho))*rho)/(2*PI)
            targ=(sig[:,None]*sig[None,:])*kern-rows[0][:,None]*rows[0][None,:]
            targ=0.5*(targ+targ.T); targ=targ*(1-eye)+eye*vars[0][None,:]
            tv,V=np.linalg.eigh(targ)
            xfull=xc@(((U*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@U.T)@((V*np.sqrt(np.maximum(tv,1e-12))[None,:])@V.T))+rows[0]
            x=rows[0]+acoef*(xfull-rows[0])+bcoef*xc
    z=x@Ws[-1].astype(np.float64,copy=False); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12))
    mc=np.maximum(z,0).mean(0); ga=zm*ndtr(zm/zs)+zs*pdf(zm/zs); md=prem[-1]*ndtr(prem[-1]/zs)+zs*pdf(prem[-1]/zs)
    curr=0.22*mc+0.78*0.999565*(1.01760*mc-0.0240*ga+0.00640*md)
    return np.stack([mc,ga,md,rows[-1],curr],axis=1)

def true(Ws, seed, n=32768, chunk=4096):
    rng=np.random.default_rng(seed); s=np.zeros(WIDTH); ss=np.zeros(WIDTH); m=0
    for st in range(0,n,chunk):

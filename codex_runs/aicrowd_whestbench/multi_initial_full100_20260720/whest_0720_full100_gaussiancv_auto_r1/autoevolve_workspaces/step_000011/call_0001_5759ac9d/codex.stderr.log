import time, math, numpy as np
from scipy.special import ndtr, ndtri
WID=256; DEP=32; PI=math.pi; SQ=math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def diag(Ws):

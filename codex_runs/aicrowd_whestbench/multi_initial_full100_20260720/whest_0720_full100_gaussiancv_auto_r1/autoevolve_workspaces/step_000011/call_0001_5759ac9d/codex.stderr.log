    print('mlp',si,'mse',mse,'target_noise_est',vars[-1], 'mean pred/tgt', pred.mean(), target.mean(), flush=True)
print('avg mse',np.mean(errs),'avg noise',np.mean(vars),'time',time.time()-t0)

            x=diag_rows[0]+a*(x_full-diag_rows[0])+b*xc
    z=x@weights[-1].astype(np.float64,copy=False)
    zm=z.mean(axis=0); zc=z-zm; zv=np.mean(zc*zc,axis=0); zs=np.sqrt(np.maximum(zv,1e-12))
    final_mc=np.maximum(z,0).mean(axis=0)
    final_gauss=zm*ndtr(zm/zs)+zs*pdf(zm/zs)
    alpha_md=pre_mus[-1]/zs
    mixed=pre_mus[-1]*ndtr(alpha_md)+zs*pdf(alpha_md)
    curr=0.22*final_mc + 0.78*0.999565*(1.01760*final_mc-0.0240*final_gauss+0.00640*mixed)
    return {
        'mc':final_mc,'gauss':final_gauss,'mixed':mixed,'curr':curr,
        'diag':diag_rows[-1]
    }

def true_final(weights, seed, n=65536, chunk=4096):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    s=np.zeros(w); ss=np.zeros(w); m=0
    for start in range(0,n,chunk):

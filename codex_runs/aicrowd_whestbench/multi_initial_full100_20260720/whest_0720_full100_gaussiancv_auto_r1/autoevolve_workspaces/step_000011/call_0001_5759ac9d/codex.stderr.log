        for W in Ws: x=np.maximum(x@W,0)
        xf=x.astype(np.float64); s+=xf.sum(0); ss+=(xf*xf).sum(0); m+=k
    mean=s/m; return mean, np.mean(ss/m-mean*mean)/n

def gen(seed):
    rng=np.random.default_rng(seed); sc=np.sqrt(2/WIDTH)
    return [(rng.standard_normal((WIDTH,WIDTH), dtype=np.float32)*sc).astype(np.float32) for _ in range(DEPTH)]

N=24; Xs=[]; ys=[]; noise=[]; t0=time.time()
for i in range(N):

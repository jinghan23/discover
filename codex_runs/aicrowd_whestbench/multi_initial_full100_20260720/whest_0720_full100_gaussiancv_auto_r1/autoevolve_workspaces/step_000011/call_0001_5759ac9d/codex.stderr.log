from scipy.special import ndtr

WIDTH=256; DEPTH=32; BUDGET=272_000_000_000
SQRT2PI=math.sqrt(2*math.pi)
PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def diag_prop(weights):
    w=weights[0].shape[0]
    d_mu=np.zeros(w, dtype=np.float64)
    d_var=np.ones(w, dtype=np.float64)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for W in weights:
        W64=W.astype(np.float64, copy=False)
        d_mu_pre=W64.T@d_mu
        d_var_pre=(W64*W64).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); a=d_mu_pre/sig; ph=pdf(a); c=ndtr(a)
        d_mu=d_mu_pre*c+sig*ph
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*ph
        d_var=np.maximum(ez2-d_mu*d_mu,0.0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pre_mus.append(d_mu_pre.copy()); pre_vars.append(d_var_pre.copy())
    return rows, vars, pre_mus, pre_vars

def current_pred(weights, seed=0, n_samples=None, a=1.24, b=-0.24, blend=0.78, scale=0.999565, cmc=1.01760, cga=-0.0240, cmd=0.00640, rng_offset=3):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows, diag_vars, pre_mus, pre_vars = diag_prop(weights)
    if depth==1: return np.stack(diag_rows).astype(np.float32)
    per_sample=max(1, depth*(2*width*width+4*width))
    if n_samples is None:
        n_samples=max(1024, int((0.32*float(BUDGET))/float(per_sample)))
        n_samples=min(n_samples,8200)
        n_samples=2*max(1,n_samples//2)
    rng=np.random.default_rng(int(seed)+rng_offset)
    half=n_samples//2
    x0=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64, copy=False)
    eye=np.eye(width, dtype=np.float64)
    for i,W in enumerate(weights[:-1]):
        W64=W.astype(np.float64, copy=False)
        z=x@W64
        if i==0:
            t_cov=W64.T@W64
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/float(n_samples)
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=(s_vecs*(1/np.sqrt(np.maximum(s_vals,1e-12)))[None,:])@s_vecs.T
            target_sqrt=(t_vecs*np.sqrt(np.maximum(t_vals,1e-12))[None,:])@t_vecs.T
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0)
            x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/float(n_samples)
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            kernel0=(root0+(PI-np.arccos(rho0))*rho0)/(2*PI)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=(s_vecs*(1/np.sqrt(np.maximum(s_vals,1e-12)))[None,:])@s_vecs.T
            target_sqrt=(t_vecs*np.sqrt(np.maximum(t_vals,1e-12))[None,:])@t_vecs.T
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+a*(x_full-diag_rows[0])+b*x_center
    W=weights[-1].astype(np.float64,copy=False)
    z=x@W
    z_mean=z.mean(axis=0); zc=z-z_mean; z_var=np.mean(zc*zc, axis=0)
    z_sigma=np.sqrt(np.maximum(z_var,1e-12)); zalpha=z_mean/z_sigma
    final_gauss=z_mean*ndtr(zalpha)+z_sigma*pdf(zalpha)
    z_alpha_md=pre_mus[-1]/z_sigma
    final_mixed_diag=pre_mus[-1]*ndtr(z_alpha_md)+z_sigma*pdf(z_alpha_md)
    final_mc=np.maximum(z,0).mean(axis=0)
    final_base=scale*(cmc*final_mc+cga*final_gauss+cmd*final_mixed_diag)
    final=final_mc+blend*(final_base-final_mc)
    return np.stack(diag_rows[:-1]+[final]).astype(np.float32)

def true_final(weights, seed=123, n=65536, chunk=4096):
    rng=np.random.default_rng(seed)
    width=weights[0].shape[0]
    s=np.zeros(width, dtype=np.float64); ss=np.zeros(width, dtype=np.float64); m=0
    for start in range(0,n,chunk):
        k=min(chunk,n-start)
        x=rng.standard_normal((k,width), dtype=np.float32)
        for W in weights:

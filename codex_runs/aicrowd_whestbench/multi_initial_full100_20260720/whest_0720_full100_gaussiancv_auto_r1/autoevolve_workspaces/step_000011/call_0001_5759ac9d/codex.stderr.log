  x=np.maximum(z,0)
  if i==0:
   xc=x-x.mean(0); sv,U=np.linalg.eigh((xc.T@xc)/n); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(PI-np.arccos(rho))*rho)/(2*PI); targ=(sig[:,None]*sig[None,:])*kern-rows[0][:,None]*rows[0][None,:]; targ=0.5*(targ+targ.T); targ=targ*(1-eye)+eye*vars[0][None,:]; tv,V=np.linalg.eigh(targ); xf=xc@(((U*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@U.T)@((V*np.sqrt(np.maximum(tv,1e-12))[None,:])@V.T))+rows[0]; x=rows[0]+1.24*(xf-rows[0])-0.24*xc
 z=x@Ws[-1].astype(np.float64,copy=False); zm=z.mean(0); c=z-zm; zs=np.sqrt(np.maximum(np.mean(c*c,0),1e-12)); mc=np.maximum(z,0).mean(0); ga=zm*ndtr(zm/zs)+zs*pdf(zm/zs); md=pre[-1]*ndtr(pre[-1]/zs)+zs*pdf(pre[-1]/zs); base=.999565*(1.01760*mc-.0240*ga+.00640*md); return mc,base,ga,md
def true(Ws, seed, n=65536):
 rng=np.random.default_rng(seed); s=np.zeros(WID); m=0
 for st in range(0,n,4096):
  k=min(4096,n-st); x=rng.standard_normal((k,WID), dtype=np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.astype(np.float64).sum(0); m+=k
 return s/m
def gen(seed):
 rng=np.random.default_rng(seed); sc=np.sqrt(2/WID); return [(rng.standard_normal((WID,WID), dtype=np.float32)*sc).astype(np.float32) for _ in range(DEP)]
N=12; Fs=[]; ys=[]
for i in range(N):

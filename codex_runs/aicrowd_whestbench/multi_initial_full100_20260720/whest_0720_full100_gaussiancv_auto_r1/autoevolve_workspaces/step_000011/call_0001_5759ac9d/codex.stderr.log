 for W in Ws:
  W=W.astype(np.float64,copy=False); p=W.T@m; vp=(W*W).T@v; vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=p/s; c=ndtr(a); ph=pdf(a); m=p*c+s*ph; ez=(p*p+vp)*c+p*s*ph; v=np.maximum(ez-m*m,0); rows.append(m.copy()); vars.append(v.copy()); pre.append(p.copy())
 return rows,vars,pre
def features(Ws, seed, n=7424):
 rows,vars,pre=diag(Ws); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,WID), dtype=np.float32); x=np.concatenate([x0,-x0]).astype(np.float64); eye=np.eye(WID)
 for i,W in enumerate(Ws[:-1]):
  W=W.astype(np.float64,copy=False); z=x@W

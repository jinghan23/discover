        for W in weights:
            x=np.maximum(x@W,0)
        xf=x.astype(np.float64,copy=False)
        s+=xf.sum(axis=0); ss+=(xf*xf).sum(axis=0); m+=k
    mean=s/m; var=ss/m-mean*mean
    return mean,var

def gen(seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2/WIDTH)
    return [(rng.standard_normal((WIDTH,WIDTH), dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]


# Sweep n_samples for the current estimator on synthetic width=256/depth=32 MLPs.
import time, math, numpy as np
from scipy.special import ndtr
WIDTH=256; DEPTH=32; BUDGET=272_000_000_000
SQRT2PI=math.sqrt(2*math.pi); PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def diag_prop(weights):
    w=WIDTH; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
    for W in weights:
        W=W.astype(np.float64,copy=False); pre=W.T@mu; vp=(W*W).T@var; vp=np.maximum(vp,1e-12)
        sig=np.sqrt(vp); a=pre/sig; ph=pdf(a); c=ndtr(a); mu=pre*c+sig*ph
        ez=(pre*pre+vp)*c+pre*sig*ph; var=np.maximum(ez-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); prem.append(pre.copy())
    return rows,vars,prem

def pred_final(weights, seed, n):
    rows,vars,prem=diag_prop(weights); rng=np.random.default_rng(seed+3); half=n//2
    x0=rng.standard_normal((half,WIDTH), dtype=np.float32); x=np.concatenate([x0,-x0],0).astype(np.float64)
    eye=np.eye(WIDTH)
    for i,W in enumerate(weights[:-1]):
        W=W.astype(np.float64,copy=False); z=x@W
        if i==0:
            tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n
            sv,svct=np.linalg.eigh(sc); tv,tvct=np.linalg.eigh(tc)
            inv=(svct*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@svct.T
            ts=(tvct*np.sqrt(np.maximum(tv,1e-12))[None,:])@tvct.T
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xc=x-x.mean(0); sc=(xc.T@xc)/n; sv,svct=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); den=np.maximum(sig[:,None]*sig[None,:],1e-12)
            rho=np.clip(tc/den,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(PI-np.arccos(rho))*rho)/(2*PI)
            targ=(sig[:,None]*sig[None,:])*kern-rows[0][:,None]*rows[0][None,:]
            targ=0.5*(targ+targ.T); targ=targ*(1-eye)+eye*vars[0][None,:]
            tv,tvct=np.linalg.eigh(targ)
            inv=(svct*(1/np.sqrt(np.maximum(sv,1e-12)))[None,:])@svct.T
            ts=(tvct*np.sqrt(np.maximum(tv,1e-12))[None,:])@tvct.T
            x_full=xc@(inv@ts)+rows[0]
            x=rows[0]+1.24*(x_full-rows[0])-0.24*xc
    z=x@weights[-1].astype(np.float64,copy=False)
    zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12)); za=zm/zs
    ga=zm*ndtr(za)+zs*pdf(za); md=prem[-1]*ndtr(prem[-1]/zs)+zs*pdf(prem[-1]/zs)
    mc=np.maximum(z,0).mean(0)
    return 0.22*mc+0.78*0.999565*(1.01760*mc-0.0240*ga+0.00640*md)

def true_final(weights, seed, n=65536, chunk=4096):
    rng=np.random.default_rng(seed); s=np.zeros(WIDTH); ss=np.zeros(WIDTH); m=0
    for start in range(0,n,chunk):
        k=min(chunk,n-start); x=rng.standard_normal((k,WIDTH), dtype=np.float32)
        for W in weights: x=np.maximum(x@W,0)
        xf=x.astype(np.float64,copy=False); s+=xf.sum(0); ss+=(xf*xf).sum(0); m+=k
    mean=s/m; return mean, ss/m-mean*mean

def gen(seed):
    rng=np.random.default_rng(seed); sc=np.sqrt(2/WIDTH)
    return [(rng.standard_normal((WIDTH,WIDTH), dtype=np.float32)*sc).astype(np.float32) for _ in range(DEPTH)]

mlps=[]; targets=[]; noise=[]
t0=time.time()
for i in range(5):
    W=gen(50000+i); t,v=true_final(W,60000+i,n=65536)
    mlps.append(W); targets.append(t); noise.append(np.mean(v)/65536)
    print('target done',i,flush=True)
print('target time',time.time()-t0,'noise',np.mean(noise))
ns=[4096,5120,6144,6400,7168,8192,8200,9216,10240,12288]
per_sample=DEPTH*(2*WIDTH*WIDTH+4*WIDTH)
for n in ns:
    if n%2: n-=1
    ms=[]; st=time.time()
    for i,W in enumerate(mlps):
        p=pred_final(W,70000+i,n)
        ms.append(np.mean((p-targets[i])**2))
    raw=float(np.mean(ms)); mult=max(0.1, (n*per_sample)/BUDGET)
    print('n',n,'raw',raw,'adj_est',raw*mult,'mult',mult,'time',time.time()-st,flush=True)

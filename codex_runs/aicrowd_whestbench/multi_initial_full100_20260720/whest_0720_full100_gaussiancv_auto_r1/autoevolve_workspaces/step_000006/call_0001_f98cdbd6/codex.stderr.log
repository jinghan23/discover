# Generate LHS half-samples with antithetic completion.
def lhs_half(half,width,seed=1234):
    rng=fnp.random.default_rng(seed)
    cols=[]
    for j in range(width):
        p=fnp.asarray(rng.permutation(half), dtype=fnp.float64)
        u=(p + rng.random(half)) / float(half)
        u=fnp.minimum(fnp.maximum(u,1e-7),1.0-1e-7)
        cols.append(flops.stats.norm.ppf(u))
    return fnp.asarray(fnp.stack(cols,axis=1), dtype=fnp.float32)

# Candidate copied with supplied half-sample x0.
def pred_with_x0(mlp,budget,x0):
    width=int(mlp.width); depth=int(mlp.depth); n_samples=int(x0.shape[0])*2
    d_mu=fnp.zeros(width); d_var=fnp.ones(width); diag_rows=[]; diag_vars=[]
    for w in mlp.weights:
        d_mu_pre=w.T@d_mu; d_var_pre=(w*w).T@d_var; d_var_pre=fnp.maximum(d_var_pre,1e-12)
        sig=fnp.sqrt(d_var_pre); a=d_mu_pre/sig; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*c+sig*p; ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*p
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0); diag_rows.append(d_mu); diag_vars.append(d_var)
    x=fnp.concatenate([x0,-x0],axis=0)
    eye=fnp.eye(width,dtype=fnp.float64)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x@w
        if i==0:

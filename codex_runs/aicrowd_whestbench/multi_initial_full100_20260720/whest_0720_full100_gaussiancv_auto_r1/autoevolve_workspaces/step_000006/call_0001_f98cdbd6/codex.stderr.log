warnings.filterwarnings('ignore')
import numpy as np
import flopscope.numpy as fnp, flopscope as flops
from whestbench import sample_mlp, sample_layer_statistics

def feats(mlp,n=8200):
    wdt=int(mlp.width); d_mu=fnp.zeros(wdt); d_var=fnp.ones(wdt); rows=[]; vars=[]

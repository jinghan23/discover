    score_base.append(mb*max(.1,bc.flops_used/budget)); score_new.append(mn*max(.1,bc2.flops_used/budget))
print('base mse score fl',np.mean(mse_base),np.mean(score_base),np.mean(fl_base))
print('new  mse score fl',np.mean(mse_new),np.mean(score_new),np.mean(fl_new))

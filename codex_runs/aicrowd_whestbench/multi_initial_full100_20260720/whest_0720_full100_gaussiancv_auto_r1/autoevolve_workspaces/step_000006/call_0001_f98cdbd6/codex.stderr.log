        d_mu=pre*c+sig*p; ez2=(pre*pre+var)*c+pre*sig*p; d_var=fnp.maximum(ez2-d_mu*d_mu,0.0); rows.append(d_mu); vars.append(d_var)
    rng=fnp.random.default_rng(int(mlp.seed)+3); x0=fnp.asarray(rng.standard_normal((n//2,wdt),dtype=fnp.float32)); x=fnp.concatenate([x0,-x0],axis=0); eye=fnp.eye(wdt,dtype=fnp.float64)
    for i,w in enumerate(mlp.weights[:-1]):

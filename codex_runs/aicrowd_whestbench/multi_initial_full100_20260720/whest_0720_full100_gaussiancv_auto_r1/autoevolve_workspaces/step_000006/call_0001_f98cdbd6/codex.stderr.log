import warnings
warnings.filterwarnings('ignore')
import numpy as np
import flopscope.numpy as fnp, flopscope as flops
from whestbench import sample_mlp, sample_layer_statistics
from submission import Estimator

def raw_final(mlp,m,offset=103):
    width=int(mlp.width)
    rng=fnp.random.default_rng(int(mlp.seed)+offset)
    x0=fnp.asarray(rng.standard_normal((m//2,width),dtype=fnp.float32)); x=fnp.concatenate([x0,-x0],axis=0)
    for w in mlp.weights:
        x=fnp.maximum(x@w,0.0)
    return fnp.sum(fnp.asarray(x,dtype=fnp.float64),axis=0)/float(m)

width=32; depth=8; budget=10**9; n_gt=250000; n_mlps=60
for m in [512,1024,2048,3072,4096]:
    data=[]; fl=[]
    for k in range(n_mlps):
        seed=70000+53*k
        mlp=sample_mlp(width,depth,fnp.random.default_rng(seed),seed=seed+888)
        _,target,_=sample_layer_statistics(mlp,n_gt,rng=fnp.random.default_rng(seed+1))
        with flops.BudgetContext(flop_budget=budget,quiet=True) as bc:
            base=Estimator().predict(mlp,budget)[-1]
            raw=raw_final(mlp,2*(m//2))
        data.append((np.array(base),np.array(raw),np.array(target)))
        fl.append(bc.flops_used)
    # fit alpha and intercept for base + alpha(raw-base)+b
    X=[]; y=[]; cur=[]
    for base,raw,t in data:
        X.append(np.stack([raw-base,np.ones_like(base)],axis=1)); y.append(t-base); cur.append(((base-t)**2).mean())
    X=np.concatenate(X); y=np.concatenate(y)
    coef=np.linalg.lstsq(X,y,rcond=None)[0]
    mse=np.mean((X@coef-y)**2); curm=np.mean(cur); ratio=np.mean(fl)/budget
    print('m',m,'flops',np.mean(fl),'ratio',ratio,'curm',curm,'fitm',mse,'scorecur',curm*max(.1,(209162704/budget)),'scorefit',mse*max(.1,ratio),'coef',coef)

            sv,se=fnp.linalg.eigh(sc); tv,te=fnp.linalg.eigh(t_cov)
            inv=se@(fnp.diag(1/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T)
            ts=te@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@te.T)
            z=zc@(inv@ts)
        x=fnp.maximum(z,0.0)
        if i==0:

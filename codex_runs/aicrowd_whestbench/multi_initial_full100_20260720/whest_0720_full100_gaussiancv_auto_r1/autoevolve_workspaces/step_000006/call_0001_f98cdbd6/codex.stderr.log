            sig=fnp.sqrt(fnp.maximum(fnp.diagonal(tcov),1e-12)); scale=fnp.maximum(sig[:,None]*sig[None,:],1e-12); rho=fnp.clip(tcov/scale,-.999999,.999999)
            root=fnp.sqrt(fnp.maximum(1-rho*rho,0.0)); pi=3.141592653589793; kernel=(root+(pi-fnp.arccos(rho))*rho)/(2*pi)
            target=scale*kernel-rows[0][:,None]*rows[0][None,:]; target=.5*(target+target.T); target=target*(1-eye)+eye*vars[0][None,:]
            tv,te=fnp.linalg.eigh(target); inv=se@(fnp.diag(1/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T); ts=te@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@te.T)

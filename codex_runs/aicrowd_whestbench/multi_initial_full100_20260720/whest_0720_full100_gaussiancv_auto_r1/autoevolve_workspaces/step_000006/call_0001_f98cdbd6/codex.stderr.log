codex
A structural alternative is to whiten the Gaussian input samples directly instead of whitening first-layer preactivations. That saves one target eigendecomposition and changes the high-order sample geometry; I’m testing it locally before considering a patch.
exec
/bin/bash -lc "python - <<'PY'
import warnings, time
warnings.filterwarnings('ignore')
import numpy as np
import flopscope.numpy as fnp, flopscope as flops
from whestbench import sample_mlp, sample_layer_statistics
from submission import Estimator


def pred_input_whiten(mlp,budget,n_samples=8200):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width); diag_rows=[]; diag_vars=[]
    for w in mlp.weights:
        d_mu_pre=w.T@d_mu; d_var_pre=(w*w).T@d_var; d_var_pre=fnp.maximum(d_var_pre,1e-12)
        sig=fnp.sqrt(d_var_pre); a=d_mu_pre/sig; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*c+sig*p; ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*p
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0); diag_rows.append(d_mu); diag_vars.append(d_var)
    rng=fnp.random.default_rng(int(mlp.seed)+3); half=n_samples//2
    x0=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32)); x=fnp.concatenate([x0,-x0],axis=0)
    # whiten input covariance to identity
    xc=x-fnp.mean(x,axis=0)
    sc=(xc.T@xc)/float(n_samples)
    sv,se=fnp.linalg.eigh(sc)
    inv=se@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T)
    x=xc@inv
    eye=fnp.eye(width,dtype=fnp.float64)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
        x=fnp.maximum(z,0.0)
        if i==0:
            xm=fnp.mean(x,axis=0); xc=x-xm; sc=(xc.T@xc)/float(n_samples)
            sv,se=fnp.linalg.eigh(sc)
            sigma0=fnp.sqrt(fnp.maximum(fnp.diagonal(t_cov),1e-12))
            scale=fnp.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho=fnp.clip(t_cov/scale,-0.999999,0.999999)
            root=fnp.sqrt(fnp.maximum(1-rho*rho,0.0)); pi=3.141592653589793
            kernel=(root+(pi-fnp.arccos(rho))*rho)/(2*pi)
            target_second=scale*kernel
            tc=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=fnp.linalg.eigh(tc)
            inv=se@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T)
            ts=te@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@te.T)
            xf=xc@(inv@ts)+diag_rows[0]
            x=diag_rows[0]+1.32*(xf-diag_rows[0])-0.32*xc
    z=x@mlp.weights[-1]; z64=fnp.asarray(z,dtype=fnp.float64)
    zm=fnp.mean(z64,axis=0); zc=z64-zm; zv=fnp.mean(zc*zc,axis=0); zs=fnp.sqrt(fnp.maximum(zv,1e-12))
    za=zm/zs; fg=zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za)
    zam=d_mu_pre/zs; fm=d_mu_pre*flops.stats.norm.cdf(zam)+zs*flops.stats.norm.pdf(zam)
    fmc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    final=0.999565*(1.01480*fmc-0.0200*fg+0.00520*fm)
    return fnp.asarray(fnp.stack(list(diag_rows[:-1])+[final],axis=0),dtype=fnp.float32)

width=32; depth=8; budget=10**9; n_gt=250000; n_mlps=40
mse_base=[]; score_base=[]; mse_new=[]; score_new=[]; fl_base=[]; fl_new=[]
for k in range(n_mlps):
    seed=9000+19*k
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seed),seed=seed+444)
    _,target,_=sample_layer_statistics(mlp,n_gt,rng=fnp.random.default_rng(seed+1))
    with flops.BudgetContext(flop_budget=budget,quiet=True) as bc:

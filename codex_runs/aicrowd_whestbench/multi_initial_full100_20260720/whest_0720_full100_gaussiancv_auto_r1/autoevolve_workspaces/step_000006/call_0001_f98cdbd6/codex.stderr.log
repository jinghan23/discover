    a=zm/zs; phi=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a); fg=zm*c+zs*phi; am=pre/zs; fm=pre*flops.stats.norm.cdf(am)+zs*flops.stats.norm.pdf(am); mc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n)
    m3=fnp.mean(zc*zc*zc,axis=0); m4=fnp.mean(zc*zc*zc*zc,axis=0); sk=m3/fnp.maximum(zs*zs*zs,1e-12); ex=m4/fnp.maximum(zv*zv,1e-12)-3.0

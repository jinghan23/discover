import warnings, time
warnings.filterwarnings('ignore')
import numpy as np
import flopscope.numpy as fnp
import flopscope as flops
from whestbench import sample_mlp, sample_layer_statistics

# Same feature generator as the candidate, parameterized by q and n.
def calc(mlp, n_samples, q):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width); diag_rows=[]; diag_vars=[]
    for w in mlp.weights:
        d_mu_pre=w.T@d_mu; d_var_pre=(w*w).T@d_var; d_var_pre=fnp.maximum(d_var_pre,1e-12)
        d_sigma=fnp.sqrt(d_var_pre); a=d_mu_pre/d_sigma
        p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*c+d_sigma*p
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*d_sigma*p
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0)
        diag_rows.append(d_mu); diag_vars.append(d_var)
    rng=fnp.random.default_rng(int(mlp.seed)+3)
    eye=fnp.eye(width,dtype=fnp.float64)
    x0=fnp.asarray(rng.standard_normal((n_samples//2,width),dtype=fnp.float32))
    x=fnp.concatenate([x0,-x0],axis=0)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-fnp.mean(z,axis=0)
            sc=(zc.T@zc)/float(n_samples)
            sv,se=fnp.linalg.eigh(sc); tv,te=fnp.linalg.eigh(t_cov)
            inv=se@(fnp.diag(1/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T)
            ts=te@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@te.T)
            z=zc@(inv@ts)
        x=fnp.maximum(z,0.0)
        if i==0:
            xm=fnp.mean(x,axis=0); xc=x-xm
            sc=(xc.T@xc)/float(n_samples)
            sv,se=fnp.linalg.eigh(sc)
            sig=fnp.sqrt(fnp.maximum(fnp.diagonal(t_cov),1e-12))
            scale=fnp.maximum(sig[:,None]*sig[None,:],1e-12)
            rho=fnp.clip(t_cov/scale,-.999999,.999999)
            root=fnp.sqrt(fnp.maximum(1-rho*rho,0.0)); pi=3.141592653589793
            kernel=(root+(pi-fnp.arccos(rho))*rho)/(2*pi)
            target_second=scale*kernel
            tc=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=fnp.linalg.eigh(tc)
            inv=se@(fnp.diag(1/fnp.sqrt(fnp.maximum(sv,1e-12)))@se.T)
            ts=te@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@te.T)
            xf=xc@(inv@ts)+diag_rows[0]
            x=diag_rows[0]+(1+q)*(xf-diag_rows[0])-q*xc
    z=x@mlp.weights[-1]; z64=fnp.asarray(z,dtype=fnp.float64)
    zm=fnp.mean(z64,axis=0); zc=z64-zm; zv=fnp.mean(zc*zc,axis=0); zs=fnp.sqrt(fnp.maximum(zv,1e-12))
    za=zm/zs; fg=zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za)
    zam=d_mu_pre/zs; fm=d_mu_pre*flops.stats.norm.cdf(zam)+zs*flops.stats.norm.pdf(zam)
    fmc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    cur=0.999565*(1.01480*fmc-0.0200*fg+0.00520*fm)
    feats=np.stack([np.array(fmc),np.array(fg),np.array(fm),np.array(diag_rows[-1]),np.ones(width)],axis=1)
    return np.array(cur), feats


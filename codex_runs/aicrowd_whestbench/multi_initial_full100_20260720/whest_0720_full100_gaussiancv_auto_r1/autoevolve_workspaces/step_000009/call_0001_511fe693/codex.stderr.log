import numpy as np
from scipy.special import ndtr
from math import pi

def pdf(x): return np.exp(-0.5*x*x)/np.sqrt(2*np.pi)
def cdf(x): return ndtr(x)

def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pres=[]
    for w in weights:
        mu_pre=w.T@mu; var_pre=(w*w).T@var; var_pre=np.maximum(var_pre,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; p=pdf(a); q=cdf(a)
        mu=mu_pre*q+sig*p
        ez2=(mu_pre*mu_pre+var_pre)*q+mu_pre*sig*p
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var); pres.append(mu_pre)
    return rows,vars,pres

def est(weights,seed=0,n=8200,c=1.28,scale=0.999565,A=1.01760,B=-0.0240,D=0.00640,norm=True,offset=3):
    width=weights[0].shape[0]; depth=len(weights); rows,vars,pres=diag_prop(weights)
    if depth==1: return rows[-1]
    rng=np.random.default_rng(seed+offset); half=n//2; x0=rng.standard_normal((half,width),dtype=np.float32).astype(float); x=np.r_[x0,-x0]; eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):

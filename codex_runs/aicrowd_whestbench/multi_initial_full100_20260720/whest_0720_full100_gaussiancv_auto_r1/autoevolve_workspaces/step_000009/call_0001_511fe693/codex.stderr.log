 z=x@ws[-1]; zm=z.mean(0); zv=np.mean((z-zm)**2,0); zs=np.sqrt(np.maximum(zv,1e-12)); fmc=np.maximum(z,0).mean(0); fg=zm*cdf(zm/zs)+zs*pdf(zm/zs); fm=pres[-1]*cdf(pres[-1]/zs)+zs*pdf(pres[-1]/zs); return 0.999565*(1.0176*fmc-0.024*fg+0.0064*fm)
def truth(ws,seed,n=140000):

import numpy as np
from math import erf, sqrt, pi

# Vectorized normal pdf/cdf without scipy dependency.
def norm_pdf(x):
    return np.exp(-0.5*x*x)/np.sqrt(2*np.pi)

def norm_cdf(x):
    return 0.5*(1+np.vectorize(erf)(x/np.sqrt(2)))

def diag_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width)
    var=np.ones(width)
    rows=[]; vars=[]; pre=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=(w*w).T@var
        var_pre=np.maximum(var_pre,1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=norm_pdf(alpha); cdf=norm_cdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu); vars.append(var); pre.append(mu_pre)
    return rows, vars, pre

def estimate_current(weights, seed=0, n_samples=8200, c=1.28, final_scale=0.999565, a=1.01760,b=-0.0240,d=0.00640, match0=True, final_variant='current'):

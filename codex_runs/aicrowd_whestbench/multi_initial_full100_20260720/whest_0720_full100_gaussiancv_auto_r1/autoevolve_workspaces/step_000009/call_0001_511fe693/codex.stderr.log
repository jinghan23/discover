import numpy as np
from scipy.special import ndtr
from math import pi
pdf=lambda x: np.exp(-0.5*x*x)/np.sqrt(2*np.pi); cdf=ndtr

def full_corr_est(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); C=np.eye(w)
 rows=[]
 for W in ws:
  mz=W.T@mu; Cz=W.T@C@W; Cz=0.5*(Cz+Cz.T)
  vz=np.maximum(np.diag(Cz),1e-12); s=np.sqrt(vz); a=mz/s; q=cdf(a); p=pdf(a)
  my=mz*q+s*p; ez2=(mz*mz+vz)*q+mz*s*p; vy=np.maximum(ez2-my*my,0)
  den=np.maximum(s[:,None]*s[None,:],1e-12); rho=np.clip(Cz/den,-0.999999,0.999999)
  root=np.sqrt(np.maximum(1-rho*rho,0)); K=(root+(pi-np.arccos(rho))*rho)/(2*pi)
  cov_corr=(K-1/(2*pi))/(0.5-1/(2*pi))
  C=cov_corr*np.sqrt(np.maximum(vy[:,None]*vy[None,:],0)); np.fill_diagonal(C,vy)
  mu=my; rows.append(my)
 return rows[-1]

def diag_est(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w)
 for W in ws:
  mp=W.T@mu; vp=(W*W).T@var; vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=mp/s; q=cdf(a); p=pdf(a); mu=mp*q+s*p; ez2=(mp*mp+vp)*q+mp*s*p; var=np.maximum(ez2-mu*mu,0)
 return mu
def true(ws,seed,n=200000,batch=50000):
 w=ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<n:
  m=min(batch,n-done); x=rng.standard_normal((m,w));
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/done
for width in [32,64]:
 for sc in ['xav','he']:
  sig=1/np.sqrt(width) if sc=='xav' else np.sqrt(2/width)
  for depth in [2,4,6,8,12]:
   msf=[]; msd=[]
   for seed in range(8):
    rng=np.random.default_rng(seed+123); ws=[rng.standard_normal((width,width))*sig for _ in range(depth)]; t=true(ws,seed+700,n=150000 if width==64 else 250000)
    msf.append(np.mean((full_corr_est(ws)-t)**2)); msd.append(np.mean((diag_est(ws)-t)**2))
   print(width,sc,depth,'fullcorr',np.mean(msf),'diag',np.mean(msd))

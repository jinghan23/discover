            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n
            sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc)
            inv=(se*(1/np.sqrt(np.maximum(sv,1e-12))))@se.T; ts=(te*np.sqrt(np.maximum(tv,1e-12)))@te.T
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(pi-np.arccos(rho))*rho)/(2*pi)
            targ=sig[:,None]*sig[None,:]*ker-rows[0][:,None]*rows[0][None,:]
            targ=0.5*(targ+targ.T); targ=targ*(1-eye)+eye*vars[0][None,:]
            tv,te=np.linalg.eigh(targ)
            inv=(se*(1/np.sqrt(np.maximum(sv,1e-12))))@se.T; ts=(te*np.sqrt(np.maximum(tv,1e-12)))@te.T
            xf=xc@(inv@ts)+rows[0]
            x=rows[0]+c*(xf-rows[0])-(c-1)*xc
    z=x@weights[-1]; zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12))
    fg=zm*cdf(zm/zs)+zs*pdf(zm/zs); fm=pres[-1]*cdf(pres[-1]/zs)+zs*pdf(pres[-1]/zs); fmc=np.maximum(z,0).mean(0)
    return scale*(A*fmc+B*fg+D*fm) if norm else fmc

def true(weights,seed=100,n=150000,batch=30000):
    width=weights[0].shape[0]; s=np.zeros(width); rng=np.random.default_rng(seed); done=0
    while done<n:
        m=min(batch,n-done); x=rng.standard_normal((m,width));
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/done


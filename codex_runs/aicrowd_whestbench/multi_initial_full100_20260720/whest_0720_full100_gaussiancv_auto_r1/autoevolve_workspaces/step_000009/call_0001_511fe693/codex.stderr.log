 for W in ws:
  mp=W.T@mu; vp=(W*W).T@var; vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=mp/s; q=cdf(a); p=pdf(a); mu=mp*q+s*p; ez2=(mp*mp+vp)*q+mp*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu); vars.append(var); pres.append(mp)

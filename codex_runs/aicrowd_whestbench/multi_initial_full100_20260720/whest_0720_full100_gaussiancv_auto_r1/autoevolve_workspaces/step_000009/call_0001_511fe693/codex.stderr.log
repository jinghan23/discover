            tv, tvec=np.linalg.eigh(t_cov)
            inv=(svec*(1/np.sqrt(np.maximum(sv,1e-12))))@svec.T
            ts=(tvec*np.sqrt(np.maximum(tv,1e-12)))@tvec.T
            z=z_center@(inv@ts)
        x=np.maximum(z,0)
        if i==0 and match0:
            x_mean0=x.mean(0); x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples

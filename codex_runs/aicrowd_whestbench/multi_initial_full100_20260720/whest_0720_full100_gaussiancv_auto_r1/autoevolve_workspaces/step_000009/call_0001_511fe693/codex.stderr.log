            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv=(svec*(1/np.sqrt(np.maximum(sv,1e-12))))@svec.T
            ts=(tvec*np.sqrt(np.maximum(tv,1e-12)))@tvec.T
            x_full=x_center@(inv@ts)+diag_rows[0]
            x=diag_rows[0]+c*(x_full-diag_rows[0])-(c-1)*x_center
    z=x@weights[-1]
    z_mean=z.mean(0); zc=z-z_mean; z_var=np.mean(zc*zc,0); z_sigma=np.sqrt(np.maximum(z_var,1e-12))
    alpha=z_mean/z_sigma; final_gauss=z_mean*norm_cdf(alpha)+z_sigma*norm_pdf(alpha)
    alpha_md=pre[-1]/z_sigma; final_mixed=pre[-1]*norm_cdf(alpha_md)+z_sigma*norm_pdf(alpha_md)
    final_mc=np.maximum(z,0).mean(0)
    if final_variant=='mc': return final_mc
    if final_variant=='gauss': return final_gauss
    if final_variant=='diag': return diag_rows[-1]
    return final_scale*(a*final_mc+b*final_gauss+d*final_mixed)

def true_mc(weights, seed=123, n=300000, batch=50000):
    width=weights[0].shape[0]
    s=np.zeros(width); count=0
    rng=np.random.default_rng(seed)
    for _ in range((n+batch-1)//batch):
        m=min(batch,n-count)
        x=rng.standard_normal((m,width))
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(0); count+=m
    return s/count

def run(width=32,depth=6,scale='he',cases=10,n=8200):
    mses=[]; mses_mc=[]; mses_diag=[]; mses_gauss=[]
    for seed in range(cases):
        rng=np.random.default_rng(seed)
        if scale=='he': sig=np.sqrt(2/width)
        elif scale=='xav': sig=1/np.sqrt(width)
        elif scale=='std': sig=1.0
        weights=[rng.standard_normal((width,width))*sig for _ in range(depth)]
        target=true_mc(weights, seed=seed+1000, n=200000 if width<=32 else 100000)
        est=estimate_current(weights, seed=seed, n_samples=n)
        estmc=estimate_current(weights, seed=seed, n_samples=n, final_variant='mc')
        dg=estimate_current(weights, seed=seed, n_samples=n, final_variant='diag')
        gs=estimate_current(weights, seed=seed, n_samples=n, final_variant='gauss')
        mses.append(np.mean((est-target)**2)); mses_mc.append(np.mean((estmc-target)**2)); mses_diag.append(np.mean((dg-target)**2)); mses_gauss.append(np.mean((gs-target)**2))
    print(width,depth,scale,'current',np.mean(mses),'mc',np.mean(mses_mc),'diag',np.mean(mses_diag),'gauss',np.mean(mses_gauss))

for scale in ['he','xav']:
  for depth in [2,4,6,8,12]:
    run(32,depth,scale,cases=6,n=8200)

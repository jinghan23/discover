pdf=lambda x: np.exp(-0.5*x*x)/np.sqrt(2*np.pi); cdf=ndtr

def diag(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pres=[]

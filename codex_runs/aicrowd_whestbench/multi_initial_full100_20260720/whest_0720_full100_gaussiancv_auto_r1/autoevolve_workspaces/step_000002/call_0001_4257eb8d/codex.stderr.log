from __future__ import annotations
import time
import numpy as np
import flopscope.numpy as fnp
import flopscope as flops
import whestbench

# returns components after current sample path

def components(mlp,budget=1e9, first_a=1.35, first_b=-0.35, seed_off=3):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width); diag_rows=[]; diag_vars=[]; pre_mus=[]
    for w in mlp.weights:
        d_mu_pre=w.T@d_mu; d_var_pre=(w*w).T@d_var; d_var_pre=fnp.maximum(d_var_pre,1e-12)
        sig=fnp.sqrt(d_var_pre); a=d_mu_pre/sig; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*cdf+sig*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*cdf+d_mu_pre*sig*phi
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0)
        diag_rows.append(d_mu); diag_vars.append(d_var); pre_mus.append(d_mu_pre)
    per_sample=max(1,depth*(2*width*width+4*width)); n_samples=max(1024,int((0.44*budget)/per_sample)); n_samples=min(n_samples,8200); n_samples=2*max(1,n_samples//2)
    rng=fnp.random.default_rng(int(mlp.seed)+seed_off); half=n_samples//2
    x0=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32)); x=fnp.concatenate([x0,-x0],axis=0)
    eye=fnp.eye(width,dtype=fnp.float64)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-fnp.mean(z,axis=0); sc=(zc.T@zc)/float(n_samples)
            sv,su=fnp.linalg.eigh(sc); tv,tu=fnp.linalg.eigh(t_cov)
            inv=su@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@su.T)
            ts=tu@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@tu.T)
            z=zc@(inv@ts)
        x=fnp.maximum(z,0.0)
        if i==0:
            xm=fnp.mean(x,axis=0); xc=x-xm; sc=(xc.T@xc)/float(n_samples)
            sv,su=fnp.linalg.eigh(sc)
            sigma0=fnp.sqrt(fnp.maximum(fnp.diagonal(t_cov),1e-12)); scale0=fnp.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=fnp.clip(t_cov/scale0,-0.999999,0.999999); root=fnp.sqrt(fnp.maximum(1.0-rho0*rho0,0.0)); pi=3.141592653589793
            ker=(root+(pi-fnp.arccos(rho0))*rho0)/(2*pi); target_second=scale0*ker
            tc=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            tc=0.5*(tc+tc.T); tc=tc*(1.0-eye)+eye*diag_vars[0][None,:]
            tv,tu=fnp.linalg.eigh(tc)
            inv=su@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@su.T)
            ts=tu@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@tu.T)
            xf=xc@(inv@ts)+diag_rows[0]
            x=diag_rows[0]+first_a*(xf-diag_rows[0])+first_b*xc
    z=x@mlp.weights[-1]; z64=fnp.asarray(z,dtype=fnp.float64)
    zm=fnp.mean(z64,axis=0); zc=z64-zm; zv=fnp.mean(zc*zc,axis=0); zs=fnp.sqrt(fnp.maximum(zv,1e-12))
    za=zm/zs; gauss=zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za)
    zam=pre_mus[-1]/zs; mixed=pre_mus[-1]*flops.stats.norm.cdf(zam)+zs*flops.stats.norm.pdf(zam)
    mc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    diag=diag_rows[-1]
    return [np.array(v, dtype=np.float64) for v in (mc,gauss,mixed,diag,zm,zs)]


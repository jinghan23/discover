from __future__ import annotations
import numpy as np
import flopscope.numpy as fnp
import flopscope as flops
import whestbench

# component function current + edgeworth final

def comp_edge(mlp,budget=1e9):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width); rows=[]; vars=[]; pre=[]
    for w in mlp.weights:
        pm=w.T@d_mu; pv=(w*w).T@d_var; pv=fnp.maximum(pv,1e-12); sig=fnp.sqrt(pv); a=pm/sig; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        d_mu=pm*cdf+sig*phi; ez2=(pm*pm+pv)*cdf+pm*sig*phi; d_var=fnp.maximum(ez2-d_mu*d_mu,0.0)
        rows.append(d_mu); vars.append(d_var); pre.append(pm)
    per=max(1,depth*(2*width*width+4*width)); n=max(1024,int(0.44*budget/per)); n=min(n,8200); n=2*max(1,n//2)
    rng=fnp.random.default_rng(int(mlp.seed)+3); x0=fnp.asarray(rng.standard_normal((n//2,width),dtype=fnp.float32)); x=fnp.concatenate([x0,-x0],axis=0); eye=fnp.eye(width,dtype=fnp.float64)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-fnp.mean(z,axis=0); sc=(zc.T@zc)/float(n); sv,su=fnp.linalg.eigh(sc); tv,tu=fnp.linalg.eigh(tc)
            z=zc@(su@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@su.T) @ (tu@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@tu.T)))
        x=fnp.maximum(z,0.0)
        if i==0:
            xm=fnp.mean(x,axis=0); xc=x-xm; sc=(xc.T@xc)/float(n); sv,su=fnp.linalg.eigh(sc)
            sig0=fnp.sqrt(fnp.maximum(fnp.diagonal(tc),1e-12)); scale=fnp.maximum(sig0[:,None]*sig0[None,:],1e-12); rho=fnp.clip(tc/scale,-0.999999,0.999999); root=fnp.sqrt(fnp.maximum(1-rho*rho,0)); pi=3.141592653589793
            ker=(root+(pi-fnp.arccos(rho))*rho)/(2*pi); tsec=scale*ker; cov=tsec-rows[0][:,None]*rows[0][None,:]; cov=0.5*(cov+cov.T); cov=cov*(1-eye)+eye*vars[0][None,:]
            tv,tu=fnp.linalg.eigh(cov); inv=su@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(sv,1e-12)))@su.T); ts=tu@(fnp.diag(fnp.sqrt(fnp.maximum(tv,1e-12)))@tu.T)
            xf=xc@(inv@ts)+rows[0]; x=rows[0]+1.35*(xf-rows[0])-0.35*xc
    z=fnp.asarray(x@mlp.weights[-1],dtype=fnp.float64); zm=fnp.mean(z,axis=0); zc=z-zm; zv=fnp.mean(zc*zc,axis=0); zs=fnp.sqrt(fnp.maximum(zv,1e-12)); a=zm/zs; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
    gauss=zm*cdf+zs*phi
    mc=fnp.mean(fnp.maximum(z,0.0),axis=0)
    mixed=pre[-1]*flops.stats.norm.cdf(pre[-1]/zs)+zs*flops.stats.norm.pdf(pre[-1]/zs)
    m3=fnp.mean(zc*zc*zc,axis=0); m4=fnp.mean(zc*zc*zc*zc,axis=0)
    skew=m3/fnp.maximum(zs*zs*zs,1e-12); exk=m4/fnp.maximum(zv*zv,1e-12)-3.0
    # clamp noisy cumulants
    skew=fnp.clip(skew,-2.0,2.0); exk=fnp.clip(exk,-4.0,8.0)
    edge=gauss+zs*phi*((-a*skew)/6.0+((a*a-1.0)*exk)/24.0+((a*a*a*a-6*a*a+3.0)*skew*skew)/72.0)
    return [np.array(v,dtype=np.float64) for v in (mc,gauss,mixed,edge,rows[-1])]

def target(mlp,n,seed,chunk=200000):
    width=int(mlp.width); rng=fnp.random.default_rng(seed); tot=None; done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=fnp.float32); y=whestbench.run_mlp_all_layers(mlp,x)[-1]; s=fnp.sum(y,axis=0); tot=s if tot is None else tot+s; done+=m
    return np.array(tot/float(n),dtype=np.float64)

cases=[(32,6,8,800000),(64,6,8,600000),(64,10,6,500000),(128,6,4,300000)]
X=[]; y=[]; meta=[]

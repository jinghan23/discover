from __future__ import annotations
import time
import flopscope.numpy as fnp
import flopscope as flops
import whestbench
from submission import Estimator

# Gauss-Legendre nodes/weights for n=8
nodes = [-0.9602898564975363,-0.7966664774136267,-0.5255324099163290,-0.1834346424956498,0.1834346424956498,0.5255324099163290,0.7966664774136267,0.9602898564975363]
weights = [0.1012285362903763,0.2223810344533745,0.3137066458778873,0.3626837833783620,0.3626837833783620,0.3137066458778873,0.2223810344533745,0.1012285362903763]
pi=3.141592653589793

def bivar_p(a,b,rho):
    pa=flops.stats.norm.cdf(a); pb=flops.stats.norm.cdf(b)
    p=pa*pb
    rho=fnp.clip(rho,-0.995,0.995)
    integ=0.0
    for x,w in zip(nodes,weights):
        r=0.5*rho*(x+1.0)
        om=fnp.maximum(1.0-r*r,1e-12)
        dens=fnp.exp(-(a*a-2.0*r*a*b+b*b)/(2.0*om))/(2.0*pi*fnp.sqrt(om))
        integ=integ+w*dens
    return p+0.5*rho*integ

def relu_second(mu, cov):
    var=fnp.maximum(fnp.diagonal(cov),1e-12)
    sig=fnp.sqrt(var)
    a=mu/sig
    ar=a[:,None]; br=a[None,:]
    sigprod=fnp.maximum(sig[:,None]*sig[None,:],1e-12)
    rho=fnp.clip(cov/sigprod,-0.995,0.995)
    s=fnp.sqrt(fnp.maximum(1.0-rho*rho,1e-12))
    phia=flops.stats.norm.pdf(ar); phib=flops.stats.norm.pdf(br)
    cdfa=flops.stats.norm.cdf(ar); cdfb=flops.stats.norm.cdf(br)
    q=(br-rho*ar)/s
    r=(ar-rho*br)/s
    cdfq=flops.stats.norm.cdf(q); cdfr=flops.stats.norm.cdf(r)
    p=bivar_p(ar,br,rho)
    iu=phia*cdfq+rho*phib*cdfr
    iv=phib*cdfr+rho*phia*cdfq
    iuv=rho*p-rho*ar*phia*cdfq-rho*br*phib*cdfr+s*phib*flops.stats.norm.pdf(r)
    f=iuv+ar*iv+br*iu+ar*br*p
    second=sigprod*f
    # diag exact E[relu"'^2]
    phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
    diag2=(mu*mu+var)*cdf+mu*sig*phi
    eye=fnp.eye(mu.shape[0], dtype=fnp.float64)
    second=second*(1.0-eye)+eye*diag2[None,:]
    return second

def full_gauss(mlp):
    w=int(mlp.width)
    mu=fnp.zeros(w,dtype=fnp.float64); cov=fnp.eye(w,dtype=fnp.float64); rows=[]
    for W in mlp.weights:
        W=fnp.asarray(W,dtype=fnp.float64)
        pre=W.T@mu
        pcov=W.T@(cov@W)
        var=fnp.maximum(fnp.diagonal(pcov),1e-12); sig=fnp.sqrt(var); a=pre/sig
        phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        post=pre*cdf+sig*phi
        second=relu_second(pre,pcov)
        cov=second-post[:,None]*post[None,:]
        cov=0.5*(cov+cov.T)
        ez2=(pre*pre+var)*cdf+pre*sig*phi
        v=fnp.maximum(ez2-post*post,0.0)
        eye=fnp.eye(w,dtype=fnp.float64)
        cov=cov*(1.0-eye)+eye*v[None,:]
        mu=post
        rows.append(mu)
    return fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)

def target_final(mlp,n=500000,seed=999):
    rng=fnp.random.default_rng(seed); x=rng.standard_normal((n,int(mlp.width)),dtype=fnp.float32)
    return fnp.mean(whestbench.run_mlp_all_layers(mlp,x)[-1],axis=0)

for width,depth,n in [(16,4,1000000),(32,6,400000),(64,6,200000),(64,10,160000),(128,6,80000)]:
    print('"'CASE',width,depth)
    ms_cur=[]; ms_full=[]; bias_cur=[]; bias_full=[]
    for k in range(3):
        rng=fnp.random.default_rng(700+width+13*k)
        mlp=whestbench.sample_mlp(width,depth,rng,seed=900+k)
        tgt=target_final(mlp,n=n,seed=1000+k)
        cur=Estimator().predict(mlp,1e9)[-1]
        fg=full_gauss(mlp)[-1]
        ms_cur.append(float(fnp.mean((fnp.asarray(cur,dtype=fnp.float64)-tgt)**2)))
        ms_full.append(float(fnp.mean((fnp.asarray(fg,dtype=fnp.float64)-tgt)**2)))
        bias_cur.append(float(fnp.mean(cur-tgt))); bias_full.append(float(fnp.mean(fg-tgt)))
    print('current',sum(ms_cur)/3,'bias',sum(bias_cur)/3)
    print('fullgauss',sum(ms_full)/3,'bias',sum(bias_full)/3)

base_est=mod.Estimator(); cov_est=CovariancePropagationEstimator(); mean_est=MeanPropagationEstimator()
width=256; depth=32; n_mlps=4; n_target=262144
seq=fnp.random.SeedSequence(9090).spawn(3*n_mlps)
items=[]
print('generating targets')
t0=time.time()
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,avg=sample_layer_statistics(mlp,n_target,rng=fnp.random.default_rng(seq[3*i+1]))
    items.append((mlp,final))
    print('target',i,float(fnp.mean(final)),avg)
print('target elapsed',time.time()-t0)

basis=[]
flops_base=[]; flops_cov=[]
for i,(mlp,target) in enumerate(items):
    with flops.BudgetContext(flop_budget=BUDGET, quiet=True) as bc:
        pred=base_est.predict(mlp,BUDGET)
    fb=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
    with flops.BudgetContext(flop_budget=BUDGET, quiet=True) as bc:
        cpred=cov_est.predict(mlp,BUDGET)
    fc=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
    with flops.BudgetContext(flop_budget=BUDGET, quiet=True) as bc:
        mpred=mean_est.predict(mlp,BUDGET)
    basis.append((target,pred[-1],cpred[-1],mpred[-1]))
    flops_base.append(fb); flops_cov.append(fc)
    print('mse base/cov/mean',i,float(fnp.mean((pred[-1]-target)**2)),float(fnp.mean((cpred[-1]-target)**2)),float(fnp.mean((mpred[-1]-target)**2)),'utils',fb/BUDGET,fc/BUDGET)

base_util=sum(flops_base)/len(flops_base)/BUDGET
cov_util=sum(flops_cov)/len(flops_cov)/BUDGET
print('util base',base_util,'cov add',cov_util)
for form in ['cov_minus_base','cov_minus_mean','mean_minus_base']:
    best=None
    for kk in [-0.2,-0.1,-0.05,-0.02,0.0,0.02,0.05,0.1,0.2,0.4,0.8,1.0]:
        ms=[]
        for target,base,cov,mean in basis:
            if form=='cov_minus_base': out=base + kk*(cov-base)
            elif form=='cov_minus_mean': out=base + kk*(cov-mean)
            else: out=base + kk*(mean-base)
            ms.append(float(fnp.mean((out-target)**2)))
        mse=sum(ms)/len(ms)
        mult=max(0.1,base_util+cov_util) if form"'!='"'mean_minus_base' else max(0.1,base_util+0.001)
        adj=mse*mult
        if best is None or adj<best[0]: best=(adj,kk,mse)
    print('best',form,best)

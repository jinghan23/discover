import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

flops.configure(symmetry_warnings=False)
BUDGET=272_000_000_000
PI=3.141592653589793


def predict_param(mlp, budget, *, ncap=7440, frac=0.32, first_c=1.24, first_old=-0.24, final_blend=0.78, base_scale=0.999565, mc_coef=1.01760, gauss_coef=-0.0240, mixed_coef=0.00640, adj='none', adj_strength=1.0, seed_add=3, skew=0.0):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width)
    diag_rows=[]; diag_vars=[]; pre_mus=[]; pre_vars=[]
    for w in mlp.weights:
        d_mu_pre=w.T @ d_mu
        d_var_pre=(w*w).T @ d_var
        d_var_pre=fnp.maximum(d_var_pre,1e-12)
        d_sigma=fnp.sqrt(d_var_pre)
        a=d_mu_pre/d_sigma
        phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*cdf + d_sigma*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*cdf + d_mu_pre*d_sigma*phi
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0)
        pre_mus.append(d_mu_pre); pre_vars.append(d_var_pre); diag_rows.append(d_mu); diag_vars.append(d_var)
    if depth==1:
        return fnp.asarray(fnp.stack(diag_rows,axis=0), dtype=fnp.float32)
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1024, int((frac*float(budget))/float(per_sample)))
    n_samples=min(n_samples,ncap)
    n_samples=2*max(1,n_samples//2)
    rng=fnp.random.default_rng(int(mlp.seed)+seed_add)
    eye=fnp.eye(width, dtype=fnp.float64)
    h=n_samples//2
    x0=fnp.asarray(rng.standard_normal((h,width), dtype=fnp.float32))
    x=fnp.concatenate([x0,-x0], axis=0)
    for i,w in enumerate(mlp.weights[:-1]):
        z=x @ w
        if i==0:
            t_cov=w.T @ w
            z_center=z-fnp.mean(z, axis=0)
            sample_cov=(z_center.T @ z_center)/float(n_samples)
            s_vals,s_vecs=fnp.linalg.eigh(sample_cov)
            t_vals,t_vecs=fnp.linalg.eigh(t_cov)
            inv_sqrt=(s_vecs*(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))[None,:]) @ s_vecs.T
            target_sqrt=(t_vecs*fnp.sqrt(fnp.maximum(t_vals,1e-12))[None,:]) @ t_vecs.T
            z=z_center @ (inv_sqrt @ target_sqrt)
        x=fnp.maximum(z,0.0)
        if i==0:
            x_mean0=fnp.mean(x, axis=0)
            x_center=x-x_mean0
            sample_cov=(x_center.T @ x_center)/float(n_samples)
            s_vals,s_vecs=fnp.linalg.eigh(sample_cov)
            sigma0=fnp.sqrt(fnp.maximum(fnp.diagonal(t_cov),1e-12))
            scale0=fnp.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=fnp.clip(t_cov/scale0,-0.999999,0.999999)
            root0=fnp.sqrt(fnp.maximum(1.0-rho0*rho0,0.0))
            kernel0=(root0+(PI-fnp.arccos(rho0))*rho0)/(2.0*PI)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1.0-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=fnp.linalg.eigh(target_cov)
            inv_sqrt=(s_vecs*(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))[None,:]) @ s_vecs.T
            target_sqrt=(t_vecs*fnp.sqrt(fnp.maximum(t_vals,1e-12))[None,:]) @ t_vecs.T
            x_full=x_center @ (inv_sqrt @ target_sqrt)+diag_rows[0]
            x=diag_rows[0] + first_c*(x_full-diag_rows[0]) + first_old*x_center
        elif adj"'!='"'none':
            xm=fnp.mean(x, axis=0)
            xc=x-xm
            if adj=='mean':
                x=x + adj_strength*(diag_rows[i]-xm)
            elif adj=='var':
                xv=fnp.mean(xc*xc, axis=0)
                sc=fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/fnp.maximum(xv,1e-12))
                x_adj=diag_rows[i] + xc*sc
                x=x + adj_strength*(x_adj-x)
            elif adj=='meanvar_samplemean':
                xv=fnp.mean(xc*xc, axis=0)
                sc=fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/fnp.maximum(xv,1e-12))
                x_adj=xm + xc*sc
                x=x + adj_strength*(x_adj-x)
    z=x @ mlp.weights[-1]
    z64=fnp.asarray(z, dtype=fnp.float64)
    zm=fnp.mean(z64,axis=0)
    zc=z64-zm
    zv=fnp.mean(zc*zc,axis=0)
    zs=fnp.sqrt(fnp.maximum(zv,1e-12))
    za=zm/zs
    zcdf=flops.stats.norm.cdf(za); zphi=flops.stats.norm.pdf(za)
    final_gauss=zm*zcdf+zs*zphi
    z_alpha_md=pre_mus[-1]/zs
    final_mixed=pre_mus[-1]*flops.stats.norm.cdf(z_alpha_md)+zs*flops.stats.norm.pdf(z_alpha_md)
    final_mc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    if skew"'!=0.0:
        z3=fnp.mean(zc*zc*zc, axis=0)
        gamma=z3/fnp.maximum(zs*zs*zs,1e-12)
        final_gauss=final_gauss + skew*(-gamma*zs*za*zphi/6.0)
    final_base=base_scale*(mc_coef*final_mc + gauss_coef*final_gauss + mixed_coef*final_mixed)
    final=final_mc + final_blend*(final_base-final_mc)
    return fnp.asarray(fnp.stack(list(diag_rows[:-1])+[final],axis=0), dtype=fnp.float32)

variants=[
 ('"'base', {}),
 ('n6000', {'ncap':6000}),
 ('n9000', {'ncap':9000}),
 ('n11000', {'ncap':11000}),
 ('c116', {'first_c':1.16, 'first_old':-0.16}),
 ('c132', {'first_c':1.32, 'first_old':-0.32}),
 ('blend065', {'final_blend':0.65}),
 ('blend090', {'final_blend':0.90}),
 ('varadj10', {'adj':'var','adj_strength':1.0}),
 ('varadj25', {'adj':'var','adj_strength':0.25}),
 ('meanadj25', {'adj':'mean','adj_strength':0.25}),
 ('skew1', {'skew':1.0}),
]

width=256; depth=32; n_mlps=4; n_target=262144
seq=fnp.random.SeedSequence(777).spawn(3*n_mlps)
items=[]
print('generating targets')
t0=time.time()
for i in range(n_mlps):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(seq[3*i]), seed=int(seq[3*i+2].generate_state(1)[0]))
    allm, final, avg=sample_layer_statistics(mlp, n_target, rng=fnp.random.default_rng(seq[3*i+1]))
    items.append((mlp, final))
    print('target', i, float(fnp.mean(final)), 'avgvar', avg)
print('target elapsed', time.time()-t0)

for name,kw in variants:
    mses=[]; adjs=[]; utils=[]
    t0=time.time()
    for mlp, target in items:
        with flops.BudgetContext(flop_budget=BUDGET, quiet=True) as bc:
            pred=predict_param(mlp, BUDGET, **kw)
        mse=float(fnp.mean((pred[-1]-target)**2))
        eff=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
        mult=max(0.1, eff/BUDGET)
        mses.append(mse); adjs.append(mse*mult); utils.append(eff/BUDGET)
    print(name, 'adj', sum(adjs)/len(adjs), 'mse', sum(mses)/len(mses), 'util', sum(utils)/len(utils), 'elapsed', time.time()-t0)

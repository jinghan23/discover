    _,final,avg=sample_layer_statistics(mlp,n_target,rng=fnp.random.default_rng(seq[3*i+1]))
    items.append((mlp,final)); print(i,float(fnp.mean(final)),avg)
print('target elapsed',time.time()-t0)
for k in [-0.5,-0.25,-0.1,-0.05,-0.02,0.0,0.02,0.05,0.1,0.25,0.5,1.0]:
    adjs=[]; mses=[]; utils=[]

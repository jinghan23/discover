/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

BUDGET=272_000_000_000
PI=3.141592653589793

def relu_moments(mu_pre, cov_pre, force_diag=None):
    var_pre=fnp.maximum(fnp.diagonal(cov_pre),1e-12)
    sigma=fnp.sqrt(var_pre)
    alpha=mu_pre/sigma
    phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
    mu=mu_pre*cdf+sigma*phi
    ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
    var=fnp.maximum(ez2-mu*mu,0.0)
    gain=cdf
    cov=fnp.outer(gain,gain)*cov_pre
    eye=fnp.eye(int(mu.shape[0]), dtype=fnp.float64)
    cov=cov*(1.0-eye)+eye*var[None,:]
    return mu,cov,var

def predict_covmatch(mlp,budget,*,match_layers=0,strength=0.25):
    width=int(mlp.width); depth=int(mlp.depth)
    d_mu=fnp.zeros(width); d_var=fnp.ones(width)
    diag_rows=[]; diag_vars=[]; pre_mus=[]
    for w in mlp.weights:
        d_mu_pre=w.T @ d_mu
        d_var_pre=(w*w).T @ d_var
        d_var_pre=fnp.maximum(d_var_pre,1e-12)
        d_sigma=fnp.sqrt(d_var_pre)
        a=d_mu_pre/d_sigma
        phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        d_mu=d_mu_pre*cdf+d_sigma*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*cdf+d_mu_pre*d_sigma*phi
        d_var=fnp.maximum(ez2-d_mu*d_mu,0.0)
        pre_mus.append(d_mu_pre); diag_rows.append(d_mu); diag_vars.append(d_var)
    if depth==1: return fnp.asarray(fnp.stack(diag_rows,axis=0), dtype=fnp.float32)
    per_sample=max(1,depth*(2*width*width+4*width))
    n_samples=max(1024,int((0.32*float(budget))/float(per_sample)))
    n_samples=min(n_samples,7440); n_samples=2*max(1,n_samples//2)
    rng=fnp.random.default_rng(int(mlp.seed)+3)
    eye=fnp.eye(width,dtype=fnp.float64)
    x0=fnp.asarray(rng.standard_normal((n_samples//2,width),dtype=fnp.float32))
    x=fnp.concatenate([x0,-x0],axis=0)
    mom_mu=None; mom_cov=None
    for i,w in enumerate(mlp.weights[:-1]):
        z=x @ w
        target_mu=None; target_cov=None
        if i==0:
            t_cov=w.T @ w
            z_center=z-fnp.mean(z,axis=0)
            sample_cov=(z_center.T @ z_center)/float(n_samples)
            s_vals,s_vecs=fnp.linalg.eigh(sample_cov)
            t_vals,t_vecs=fnp.linalg.eigh(t_cov)
            inv_sqrt=(s_vecs*(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))[None,:]) @ s_vecs.T
            target_sqrt=(t_vecs*fnp.sqrt(fnp.maximum(t_vals,1e-12))[None,:]) @ t_vecs.T
            z=z_center @ (inv_sqrt @ target_sqrt)
        elif mom_cov is not None and i <= match_layers:
            mu_pre=w.T @ mom_mu
            cov_pre=w.T @ mom_cov @ w
            target_mu,target_cov,_=relu_moments(mu_pre,cov_pre)
        x=fnp.maximum(z,0.0)
        if i==0:
            x_mean0=fnp.mean(x,axis=0); x_center=x-x_mean0
            sample_cov=(x_center.T @ x_center)/float(n_samples)
            s_vals,s_vecs=fnp.linalg.eigh(sample_cov)
            sigma0=fnp.sqrt(fnp.maximum(fnp.diagonal(t_cov),1e-12))
            scale0=fnp.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=fnp.clip(t_cov/scale0,-0.999999,0.999999)
            root0=fnp.sqrt(fnp.maximum(1.0-rho0*rho0,0.0))
            kernel0=(root0+(PI-fnp.arccos(rho0))*rho0)/(2.0*PI)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1.0-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=fnp.linalg.eigh(target_cov)
            inv_sqrt=(s_vecs*(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))[None,:]) @ s_vecs.T
            target_sqrt=(t_vecs*fnp.sqrt(fnp.maximum(t_vals,1e-12))[None,:]) @ t_vecs.T
            x_full=x_center @ (inv_sqrt @ target_sqrt)+diag_rows[0]
            x=diag_rows[0]+1.24*(x_full-diag_rows[0])-0.24*x_center
            mom_mu=diag_rows[0]; mom_cov=target_cov
        elif target_cov is not None:
            xm=fnp.mean(x,axis=0); xc=x-xm
            sample_cov=(xc.T @ xc)/float(n_samples)
            s_vals,s_vecs=fnp.linalg.eigh(sample_cov)
            target_cov=0.5*(target_cov+target_cov.T)
            t_vals,t_vecs=fnp.linalg.eigh(target_cov)
            inv_sqrt=(s_vecs*(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))[None,:]) @ s_vecs.T
            target_sqrt=(t_vecs*fnp.sqrt(fnp.maximum(t_vals,1e-12))[None,:]) @ t_vecs.T
            x_full=xc @ (inv_sqrt @ target_sqrt)+target_mu
            x=x+strength*(x_full-x)
            mom_mu=target_mu; mom_cov=target_cov
        elif mom_cov is not None and i < match_layers:
            # Keep approximate moments available if matching later layers is requested.
            mu_pre=w.T @ mom_mu
            cov_pre=w.T @ mom_cov @ w
            mom_mu,mom_cov,_=relu_moments(mu_pre,cov_pre)
    z=x @ mlp.weights[-1]
    z64=fnp.asarray(z,dtype=fnp.float64); zm=fnp.mean(z64,axis=0); zc=z64-zm
    zv=fnp.mean(zc*zc,axis=0); zs=fnp.sqrt(fnp.maximum(zv,1e-12))
    za=zm/zs; cdf=flops.stats.norm.cdf(za); phi=flops.stats.norm.pdf(za)
    final_gauss=zm*cdf+zs*phi
    amd=pre_mus[-1]/zs
    final_mixed=pre_mus[-1]*flops.stats.norm.cdf(amd)+zs*flops.stats.norm.pdf(amd)
    final_mc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    final_base=0.999565*(1.01760*final_mc-0.0240*final_gauss+0.00640*final_mixed)
    final=final_mc+0.78*(final_base-final_mc)
    return fnp.asarray(fnp.stack(list(diag_rows[:-1])+[final],axis=0),dtype=fnp.float32)

variants=[('base',0,0.0)]
for L in [1,2,3]:

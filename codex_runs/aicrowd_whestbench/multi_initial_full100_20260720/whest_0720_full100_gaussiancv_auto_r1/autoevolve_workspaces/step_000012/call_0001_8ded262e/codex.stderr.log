        mses.append(mse); adjs.append(mse*max(0.1,eff/BUDGET)); utils.append(eff/BUDGET)
    print('k',k,'adj',sum(adjs)/n_mlps,'mse',sum(mses)/n_mlps,'util',sum(utils)/n_mlps)

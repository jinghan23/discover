def current_features(weights, seed, n_samples=8200, xcorr=1.24):
 W=weights[0].shape[0]; d_mu=np.zeros(W); d_var=np.ones(W); rows=[]; vars=[]; eye=np.eye(W)
 for w in weights:
  d_mu_pre=w.T@d_mu; d_var_pre=(w*w).T@d_var; d_mu,d_var=rmv(d_mu_pre,d_var_pre); rows.append(d_mu); vars.append(d_var)
 rng=np.random.default_rng(seed+3); half=n_samples//2; x0=rng.standard_normal((half,W)).astype(np.float64); x=np.concatenate([x0,-x0])

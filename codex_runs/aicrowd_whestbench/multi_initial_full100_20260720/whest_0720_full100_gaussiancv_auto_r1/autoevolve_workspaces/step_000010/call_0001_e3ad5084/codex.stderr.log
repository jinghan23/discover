import numpy as np
from scipy.special import ndtr
import math, time

phi_const = 1.0 / math.sqrt(2*math.pi)
def pdf(x): return phi_const*np.exp(-0.5*x*x)
def relu_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
    return mu*ndtr(a)+sig*pdf(a)
def relu_mean_var(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; c=ndtr(a); p=pdf(a)
    m=mu*c+sig*p
    ez2=(mu*mu+var)*c+mu*sig*p
    return m, np.maximum(ez2-m*m,0)

def current_features(weights, seed, budget=10**12, n_samples=8200, xcorr=1.24):
    width=weights[0].shape[0]; depth=len(weights)
    d_mu=np.zeros(width); d_var=np.ones(width); diag_rows=[]; diag_vars=[]
    for w in weights:
        d_mu_pre=w.T@d_mu
        d_var_pre=(w*w).T@d_var
        d_mu,d_var=relu_mean_var(d_mu_pre,d_var_pre)
        diag_rows.append(d_mu); diag_vars.append(d_var)
    rng=np.random.default_rng(seed+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(0)
            sample_cov=z_center.T@z_center/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=(s_vecs*(1/np.sqrt(np.maximum(s_vals,1e-12)))[None,:])@s_vecs.T
            target_sqrt=(t_vecs*np.sqrt(np.maximum(t_vals,1e-12))[None,:])@t_vecs.T
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(0); x_center=x-x_mean0
            sample_cov=x_center.T@x_center/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            kernel0=(root0+(math.pi-np.arccos(rho0))*rho0)/(2*math.pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=(s_vecs*(1/np.sqrt(np.maximum(s_vals,1e-12)))[None,:])@s_vecs.T
            target_sqrt=(t_vecs*np.sqrt(np.maximum(t_vals,1e-12))[None,:])@t_vecs.T
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+xcorr*(x_full-diag_rows[0])-(xcorr-1)*x_center
    z=x@weights[-1]
    z_mean=z.mean(0); zc=z-z_mean; z_var=(zc*zc).mean(0); z_sig=np.sqrt(np.maximum(z_var,1e-12))
    gauss=relu_mean(z_mean,z_var)
    mixed=relu_mean(d_mu_pre,z_var)
    mc=np.maximum(z,0).mean(0)
    diag=diag_rows[-1]
    return np.stack([mc,gauss,mixed,diag],0)

def target(weights, seed, n=200000, chunk=20000):
    rng=np.random.default_rng(seed+1000003)
    # target seed arbitrary independent; expectation approx
    width=weights[0].shape[0]
    s=np.zeros(width); ss=np.zeros(width); done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(0); ss+=(x*x).sum(0); done+=m
    return s/done

def run(width=64, depth=8, nmlp=8, n_truth=120000, n_est=8200):
    X=[]; Y=[]
    rng=np.random.default_rng(123)
    t=time.time()
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
        feats=current_features(weights, seed=1000+i, n_samples=n_est)
        y=target(weights, seed=2000+i, n=n_truth)
        X.append(feats.T); Y.append(y)
        print('mlp',i,'elapsed',time.time()-t, flush=True)
    X=np.concatenate(X,0); Y=np.concatenate(Y,0)
    cur=0.110*X[:,0]+0.89*0.999565*(1.01760*X[:,0]-0.0240*X[:,1]+0.00640*X[:,2])
    print('current mse',np.mean((cur-Y)**2))
    for cols,name in [([0],'mc'),([1],'gauss'),([0,1],'mc_g'),([0,1,2],'mc_g_m'),([0,1,2,3],'all')]:
        A=np.column_stack([X[:,c] for c in cols]+[np.ones(len(Y))])
        coef=np.linalg.lstsq(A,Y,rcond=None)[0]
        pred=A@coef
        print(name,'mse',np.mean((pred-Y)**2),'coef',coef)
run()

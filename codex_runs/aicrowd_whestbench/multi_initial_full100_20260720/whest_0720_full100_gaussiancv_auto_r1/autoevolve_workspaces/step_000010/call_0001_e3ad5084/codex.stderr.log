            raise RunnerError(
                "predict",
                RunnerErrorDetail(
                    code="PREDICT_ERROR",
                    message=str(exc),
                    details=predict_details,
                    traceback=_tb.format_exc(),
                ),
            ) from exc

    def last_predict_stats(self) -> Optional[PredictStats]:
        return self._last_predict_stats

  

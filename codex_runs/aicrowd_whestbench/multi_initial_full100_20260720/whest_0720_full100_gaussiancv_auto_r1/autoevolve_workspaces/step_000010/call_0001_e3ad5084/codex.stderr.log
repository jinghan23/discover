 z=x@weights[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); mc=np.maximum(z,0).mean(0); ga=rm(zm,zv); mix=rm(d_mu_pre,zv); e3,e4,ga2=edge_features(z); return np.stack([mc,ga,mix,rows[-1],e3,e4,ga+e3+e4],0)
def target(weights, seed, n=200000, chunk=10000):
 rng=np.random.default_rng(seed+9); W=weights[0].shape[0]; s=np.zeros(W); done=0
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,W)).astype(np.float64)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0); done+=m
 return s/done
def run(W=256,D=32,nmlp=3):
 X=[];Y=[]; rng=np.random.default_rng(78); t=time.time()
 for i in range(nmlp):

+            c_cdf = flops.stats.norm.cdf(c_alpha)
+            c_mu = c_mu_pre * c_cdf + c_sigma * c_phi
+            c_ez2 = (c_mu_pre * c_mu_pre + c_var_pre) * c_cdf + c_mu_pre * c_sigma * c_phi
+            c_var = fnp.maximum(c_ez2 - c_mu * c_mu, 0.0)
+            c_gain = fnp.where(c_sigma > 1e-12, c_cdf, 0.0)
+            c_cov = fnp.outer(c_gain, c_gain) * c_cov_pre
+            fnp.fill_diagonal(c_cov, c_var)
+
+        final = final_mc + 0.80 * (final_base - final_mc)
+        final = final + 0.05 * (c_mu - final_mc)
 
         return fnp.asarray(fnp.stack(list(diag_rows[:-1]) + [final], axis=0), dtype=fnp.float32)


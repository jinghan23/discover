def rmv(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; c=ndtr(a); p=pdf(a); m=mu*c+sig*p; ez2=(mu*mu+var)*c+mu*sig*p; return m,np.maximum(ez2-m*m,0)
def edge_features(z):

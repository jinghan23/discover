for width,depth,n,N,scales in [(32,6,4000,350000,[1/np.sqrt(32)]),(64,8,5000,220000,[1/np.sqrt(64)]),(64,12,7000,220000,[1/np.sqrt(64)]),(128,8,6000,120000,[1/np.sqrt(128)])]:
  for scale in scales:
    for seed in range(10):

      X=feats(W,n,seed=seed)
      y=true_final(W,N=N,seed=444+seed)
      cases.append((X,y,width,depth))
      print('done',width,depth,seed,flush=True)

X=np.concatenate([c[0] for c in cases],0); y=np.concatenate([c[1] for c in cases],0)
base_coef=np.array([0.99965*1.037,0.99965*(-.0425),0.99965*.0055,0,0])

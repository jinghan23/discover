import numpy as np
from scipy.special import ndtr
from math import pi


def relu_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; phi=np.exp(-0.5*a*a)/np.sqrt(2*pi); cdf=ndtr(a)
    ez=mu*cdf+sig*phi
    ez2=(mu*mu+var)*cdf+mu*sig*phi
    return ez,np.maximum(ez2-ez*ez,0)

def diag_prop(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for W in weights:
        mu_pre=W.T@mu; var_pre=(W*W).T@var
        pre_mus.append(mu_pre); pre_vars.append(var_pre)
        mu,var=relu_mean(mu_pre,var_pre)
        rows.append(mu); vars.append(var)
    return rows,vars,pre_mus,pre_vars

def current_est(weights,n,seed=0,mm_all=False,mm_beta=1.0, coeff=(0.99965,1.037,-0.0425,0.0055), first_mix=(1.35,-0.35), strat=False):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows,diag_vars,pre_mus,pre_vars=diag_prop(weights)
    rng=np.random.default_rng(seed+3)
    half=n//2
    if strat:
        # simple per-coordinate stratification without permutation (bad corr? plus random shifts)
        u=(np.arange(half)[:,None]+rng.random((half,width)))/half
        from scipy.special import ndtri
        x0=ndtri(u)
    else:
        x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            zc=z-z.mean(0)
            sc=zc.T@zc/n
            sv,svec=np.linalg.eigh(sc)
            tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,svec=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(t_cov/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=scale*kernel
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=.5*(target_cov+target_cov.T); target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            x_full=xc@(inv@ts)+diag_rows[0]
            a,b=first_mix
            x=diag_rows[0]+a*(x_full-diag_rows[0])+b*xc
        elif mm_all:
            xm=x.mean(0); xv=((x-xm)**2).mean(0); scale=np.sqrt(np.maximum(diag_vars[i],1e-12)/np.maximum(xv,1e-12))
            x = x + mm_beta*((diag_rows[i]-xm) + (x-xm)*(scale-1))
    z=x@weights[-1]
    zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); za=zm/zs
    phi=np.exp(-.5*za*za)/np.sqrt(2*pi); cdf=ndtr(za); final_gauss=zm*cdf+zs*phi
    za2=pre_mus[-1]/zs; phi2=np.exp(-.5*za2*za2)/np.sqrt(2*pi); cdf2=ndtr(za2); final_mix=pre_mus[-1]*cdf2+zs*phi2
    final_mc=np.maximum(z,0).mean(0)
    s,a,b,c=coeff
    return s*(a*final_mc+b*final_gauss+c*final_mix), diag_rows[-1]

def true_final(weights,N=300000,seed=123,chunk=50000):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    sm=np.zeros(w); count=0
    for _ in range((N+chunk-1)//chunk):
        m=min(chunk,N-count)
        x=rng.standard_normal((m,w))
        for W in weights:
            x=np.maximum(x@W,0)
        sm+=x.sum(0); count+=m
    return sm/count


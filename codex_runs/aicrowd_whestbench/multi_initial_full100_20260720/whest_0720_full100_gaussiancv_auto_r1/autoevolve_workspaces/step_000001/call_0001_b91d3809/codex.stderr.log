/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import pi
# Compare first-layer corrections locally.
def relu_mean(mu,var):
 s=np.sqrt(np.maximum(var,1e-12)); a=mu/s; phi=np.exp(-.5*a*a)/np.sqrt(2*pi); c=ndtr(a); ez=mu*c+s*phi; ez2=(mu*mu+var)*c+mu*s*phi; return ez,np.maximum(ez2-ez*ez,0)
def diag_prop(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
 for W in Ws:
  mp=W.T@mu; vp=(W*W).T@var; prem.append(mp); mu,var=relu_mean(mp,vp); rows.append(mu); vars.append(var)
 return rows,vars,prem
def est(Ws,n,seed,pre=True,post=True):
 w=Ws[0].shape[0]; rows,vars,prem=diag_prop(Ws); rng=np.random.default_rng(seed+3); half=n//2; x0=rng.standard_normal((half,w)).astype(np.float32); x=np.r_[x0,-x0].astype(float); eye=np.eye(w)
 for i,W in enumerate(Ws[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W
   if pre:
    zc=z-z.mean(0); sc=zc.T@zc/n; sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(tc); z=zc@(svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T) @ (tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)))
  x=np.maximum(z,0)
  if i==0 and post:

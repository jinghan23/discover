# Quick synthetic grid for first-layer covariance extrapolation with current-ish final blend.
import numpy as np
from scipy.special import ndtr
from math import pi

def relu_mean(mu,var):
 s=np.sqrt(np.maximum(var,1e-12)); a=mu/s; phi=np.exp(-.5*a*a)/np.sqrt(2*pi); c=ndtr(a); ez=mu*c+s*phi; ez2=(mu*mu+var)*c+mu*s*phi; return ez,np.maximum(ez2-ez*ez,0)
def diag_prop(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
 for W in Ws:
  mp=W.T@mu; vp=(W*W).T@var; prem.append(mp); mu,var=relu_mean(mp,vp); rows.append(mu); vars.append(var)
 return rows,vars,prem
def est(Ws,n,seed,amix,gm=-.06):
 w=Ws[0].shape[0]; rows,vars,prem=diag_prop(Ws); rng=np.random.default_rng(seed+3); half=n//2; x0=rng.standard_normal((half,w)).astype(np.float32); x=np.r_[x0,-x0].astype(float); eye=np.eye(w)
 for i,W in enumerate(Ws[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sc=zc.T@zc/n; sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(tc); inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T); ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T); z=zc@(inv@ts)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,svec=np.linalg.eigh(sc); sigma=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12); rho=np.clip(tc/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(pi-np.arccos(rho))*rho)/(2*pi); targ=scale*kern-rows[0][:,None]*rows[0][None,:]; targ=.5*(targ+targ.T); targ=targ*(1-eye)+eye*vars[0][None,:]; tv,tvec=np.linalg.eigh(targ); inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T); ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T); xf=xc@(inv@ts)+rows[0]; a=amix; x=rows[0]+a*(xf-rows[0])+(1-a)*xc
 z=x@Ws[-1]; zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); za=zm/zs; ga=zm*ndtr(za)+zs*np.exp(-.5*za*za)/np.sqrt(2*pi); za2=prem[-1]/zs; mix=prem[-1]*ndtr(za2)+zs*np.exp(-.5*za2*za2)/np.sqrt(2*pi); mc=np.maximum(z,0).mean(0)
 return .99965*((1-gm+0.0055)*mc+gm*ga+.0055*mix) # gm is negative
def true(Ws,N,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; sm=np.zeros(w); c=0; chunk=50000
 while c<N:
  m=min(chunk,N-c); x=rng.standard_normal((m,w));
  for W in Ws: x=np.maximum(x@W,0)
  sm+=x.sum(0); c+=m
 return sm/c
cases=[]
for width,depth,n,N in [(64,8,8200,200000),(64,12,8200,200000),(128,8,8200,120000)]:
 for seed in range(6):
  rng=np.random.default_rng(12345+seed+width+depth); Ws=[rng.standard_normal((width,width))/np.sqrt(width) for _ in range(depth)]; y=true(Ws,N,seed+7); cases.append((Ws,n,seed,y,width,depth))
print('cases',len(cases))
for a in [1.0,1.15,1.25,1.35,1.45,1.55,1.7]:
 vals=[]
 for Ws,n,seed,y,wi,de in cases:
  p=est(Ws,n,seed,a,gm=-.06); vals.append(np.mean((p-y)**2))
 print(a, np.mean(vals), np.median(vals), np.percentile(vals,90))

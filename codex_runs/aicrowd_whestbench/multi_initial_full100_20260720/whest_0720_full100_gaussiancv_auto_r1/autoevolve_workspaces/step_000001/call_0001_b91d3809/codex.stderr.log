 z=x@Ws[-1]; zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); za=zm/zs; phi=np.exp(-.5*za*za)/np.sqrt(2*pi); c=ndtr(za); ga=zm*c+zs*phi; za2=prem[-1]/zs; mix=prem[-1]*ndtr(za2)+zs*np.exp(-.5*za2*za2)/np.sqrt(2*pi); mc=np.maximum(z,0).mean(0)
 m3=(zc*zc*zc).mean(0); skew=m3/np.maximum(zs**3,1e-12); edge3=ga - zs*skew*za*phi/6
 m4=(zc*zc*zc*zc).mean(0); kurt=m4/np.maximum(zv*zv,1e-12)-3; edge4=edge3 + zs*kurt*(za*za-1)*phi/24
 return np.stack([mc,ga,mix,edge3,edge4,rows[-1],np.ones_like(mc)],1)
def true(Ws,N,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; sm=np.zeros(w); c=0; chunk=50000
 while c<N:

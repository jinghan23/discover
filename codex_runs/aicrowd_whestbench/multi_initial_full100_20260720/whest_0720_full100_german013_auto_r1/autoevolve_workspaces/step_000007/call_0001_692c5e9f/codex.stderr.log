# Quick synthetic bias check for the current structure using the existing submission logic translated via import is too costly;
# use a compact numpy replica over several He nets and report final mean scale/bias direction.
import numpy as np, math
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535
# reuse minimal functions from earlier
def predict(W, seed, budget=10**9, sm=-18.0):
    depth=len(W); width=W[0].shape[0]
    per_sample=depth*(2*width*width+width)+width*width+48*width; fixed=13*width**3
    k=(int(0.23*budget)-fixed)//max(per_sample,1); k=int(max(32,min(1_000_000,(100*1024*1024)//max(width*8,1),k))); k-=k&1; h=k//2
    rng=np.random.default_rng(seed); u=rng.standard_normal((h,width)).astype(np.float32)
    cov=(u.T@u)/h; L=np.linalg.cholesky(cov); WT=np.linalg.solve(L.T,W[0]); first=u@WT
    inv=np.argsort(np.argsort(first,axis=0),axis=0)
    q=norm.ppf((np.arange(h,dtype=np.float32)+0.5)/h).astype(np.float32)
    fs=np.sqrt(np.maximum(np.sum(W[0]*W[0],axis=0),1e-30)); first=np.take_along_axis(q[:,None]*fs[None,:],inv,0)
    x=np.maximum(np.concatenate([first,-first],0),0)
    W0,W1=W[0],W[1]; gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]
    corr=np.clip(gram/denom,-1,1); sec=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)*INV_TWO_PI
    mean=fs*INV_SQRT_TWO_PI; cov=sec-mean[:,None]*mean[None,:]
    z=x@W1; tm=mean@W1; ctw=cov@W1; tv=np.maximum(np.sum(ctw*W1,0),1e-30)
    smn=z.mean(0); sv=np.maximum((z*z).mean(0)-smn*smn,1e-30); sc=np.sqrt(tv/sv)
    z=(z-smn)*sc+((1-sm)*smn+sm*tm); x=np.maximum(z,0)
    for w in W[2:]: x=np.maximum(x@w,0)
    return x.mean(0)
def true(W,n,seed):
    width=W[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0; bs=8192
    while done<n:
        m=min(bs,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in W: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n
for width,depth in [(32,8),(32,16),(64,8),(64,16)]:
    rng=np.random.default_rng(77+width+depth); dots=[]; bias=[]; mse=[]
    for i in range(8):
        W=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        t=true(W,120000,100+i); p=predict(W,200+i)
        dots.append((p@t)/(p@p)); bias.append(np.mean(p-t)); mse.append(np.mean((p-t)**2))
    print((width,depth),'alpha*',np.mean(dots),'mean_bias',np.mean(bias),'mse',np.mean(mse))

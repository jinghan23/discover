import numpy as np, math
from scipy.stats import norm
# Compact current predictor from earlier with current constants.
INV=0.3989422804014327; INV2=0.15915494309189535

def diag_est(W):
    width=W[0].shape[0]
    var=np.sum(W[0]*W[0],0)
    sig=np.sqrt(np.maximum(var,1e-30)); m=sig*INV; q=0.5*var
    for weight in W[1:]:
        mu=m@weight
        prev_var=np.maximum(q-m*m,0)
        v=prev_var@(weight*weight)
        s=np.sqrt(np.maximum(v,1e-30)); a=mu/s; phi=np.exp(-0.5*a*a)*INV; Phi=norm.cdf(a)
        m=s*phi+mu*Phi
        q=(v+mu*mu)*Phi+mu*s*phi
    return m
# use saved prior functions quickly by simplified random MC estimator? exact current not needed? replicate current
from scipy.stats import norm as snorm
def current(W,seed,budget=10**9):
    depth=len(W); width=W[0].shape[0]; sm=-18.0
    per=depth*(2*width*width+width)+width*width+48*width; fixed=13*width**3
    k=(int(.23*budget)-fixed)//max(per,1); k=int(max(32,min(1_000_000,(100*1024*1024)//max(width*8,1),k))); k-=k&1; h=k//2
    rng=np.random.default_rng(seed); u=rng.standard_normal((h,width)).astype(np.float32)
    cov=(u.T@u)/h; L=np.linalg.cholesky(cov); WT=np.linalg.solve(L.T,W[0]); fp=u@WT
    inv=np.argsort(np.argsort(fp,0),0); qv=snorm.ppf((np.arange(h,dtype=np.float32)+.5)/h).astype(np.float32)
    fs=np.sqrt(np.maximum(np.sum(W[0]*W[0],0),1e-30)); fp=np.take_along_axis(qv[:,None]*fs[None,:],inv,0)
    x=np.maximum(np.concatenate([fp,-fp],0),0)
    W0,W1=W[0],W[1]; gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); den=fs[:,None]*fs[None,:]
    corr=np.clip(gram/den,-1,1); sec=den*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)*INV2
    rm=fs*INV; rc=sec-rm[:,None]*rm[None,:]
    z=x@W1; tm=rm@W1; ctw=rc@W1; tv=np.maximum(np.sum(ctw*W1,0),1e-30)
    smn=z.mean(0); sv=np.maximum((z*z).mean(0)-smn*smn,1e-30); sc=np.sqrt(tv/sv); z=(z-smn)*sc+19*smn-18*tm
    x=np.maximum(z,0)
    for w in W[2:]: x=np.maximum(x@w,0)
    return x.mean(0)
def true(W,n,seed):
    width=W[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); bs=8192; done=0
    while done<n:
      m=min(bs,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
      for w in W: x=np.maximum(x@w,0)
      s+=x.sum(0); done+=m
    return s/n
for case in [(32,8),(32,16),(64,8),(64,16)]:
    width,depth=case; rng=np.random.default_rng(width*13+depth); ps=[]; ds=[]; ts=[]
    for i in range(8):
      W=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
      ts.append(true(W,100000,300+i)); ps.append(current(W,400+i)); ds.append(diag_est(W))
    P=np.concatenate(ps); D=np.concatenate(ds); T=np.concatenate(ts)
    E=P-T; C=D-P
    beta=-(E@C)/(C@C)
    print('case',case,'mse cur',np.mean(E*E),'diag',np.mean((D-T)**2),'beta*',beta,'blend mse',np.mean((P+beta*C-T)**2),'corr',np.corrcoef(E,C)[0,1])

import numpy as np, math, time
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535

def pred(W,seed,budget,sm,sv=1.0,bfrac=0.23):
    depth=len(W); width=W[0].shape[0]
    per_sample=depth*(2*width*width+width)+width*width+48*width
    fixed=13*width**3
    k=(int(bfrac*budget)-fixed)//max(per_sample,1)
    k=int(max(32,min(1_000_000,(100*1024*1024)//max(width*8,1),k))); k-=k&1
    half=k//2
    rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32)
    cov=(u.T@u)/half
    if half>width+1:
        L=np.linalg.cholesky(cov); WT=np.linalg.solve(L.T,W[0])
    else:
        vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); WT=(vecs/np.sqrt(vals))@vecs.T@W[0]
    first=u@WT
    order=np.argsort(first,axis=0); inv=np.argsort(order,axis=0)
    q=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
    fs=np.sqrt(np.maximum(np.sum(W[0]*W[0],axis=0),1e-30))
    first=np.take_along_axis(q[:,None]*fs[None,:],inv,axis=0)
    x=np.maximum(np.concatenate([first,-first],axis=0),0)
    W0,W1=W[0],W[1]
    gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]
    corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)*INV_TWO_PI
    relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@W1; true_mean=relu_mean@W1; ctw=relu_cov@W1
    tv=np.maximum(np.sum(ctw*W1,axis=0),1e-30)
    smn=z.mean(0); svv=np.maximum((z*z).mean(0)-smn*smn,1e-30)
    scale=1+sv*(np.sqrt(tv/svv)-1)
    z=(z-smn)*scale + ((1-sm)*smn+sm*true_mean)
    x=np.maximum(z,0)
    for w in W[2:]: x=np.maximum(x@w,0)
    return x.mean(0)

def true(W,n,seed):
    width=W[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); bs=8192; done=0
    while done<n:
      m=min(bs,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
      for w in W: x=np.maximum(x@w,0)
      s+=x.sum(0); done+=m
    return s/n

def run(width,depth,budget,nn=6,ntrue=120000):
    sms=[-28,-24,-22,-20,-18,-16,-14.3,-12,-10]
    errs=np.zeros(len(sms)); rng=np.random.default_rng(width*1000+depth)
    for i in range(nn):
      W=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
      t=true(W,ntrue,9000+i)
      for j,sm in enumerate(sms): errs[j]+=np.mean((pred(W,8000+i,budget,sm)-t)**2)
    print('case',width,depth,'k budget',budget)
    for j in np.argsort(errs)[:5]: print(sms[j],errs[j]/nn)
for case in [(32,8,10**9),(32,16,10**9),(64,8,10**9),(64,16,10**9),(128,8,10**9)]:
    run(*case,nn=4,ntrue=80000)

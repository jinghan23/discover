/bin/bash -lc "python - <<'PY'
import numpy as np, math, time

INV_SQRT_TWO_PI=0.3989422804014327
INV_TWO_PI=0.15915494309189535

def current_predict(weights, seed, budget=10**9, bfrac=0.23, sm=-14.30, sv=1.0):
    depth=len(weights); width=weights[0].shape[0]
    if depth==1:
        return np.sqrt(np.maximum(np.sum(weights[0]*weights[0],axis=0),1e-30))*INV_SQRT_TWO_PI
    per_sample = depth*(2*width*width+width)+width*width+48*width
    fixed = 9*width**3+2*(2*width**3)
    k=(int(bfrac*budget)-fixed)//max(per_sample,1)
    max_k_by_bytes=(100*1024*1024)//max(width*8,1)
    k=int(max(32,min(1_000_000,max_k_by_bytes,k)))
    k-=k&1
    half=k//2
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((half,width)).astype(np.float32)
    cov=(u.T@u)/float(half)
    if half>width+1:
        L=np.linalg.cholesky(cov)
        whitening_times_weight=np.linalg.solve(L.T, weights[0])
    else:
        vals, vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
        inv=(vecs/np.sqrt(vals))@vecs.T
        whitening_times_weight=inv@weights[0]
    first=u@whitening_times_weight
    ordering=np.argsort(first,axis=0)
    inv_order=np.argsort(ordering,axis=0)
    probs=(np.arange(half,dtype=np.float32)+0.5)/float(half)
    # use scipy?
    from scipy.stats import norm
    quant=norm.ppf(probs).astype(np.float32)
    first_scale=np.sqrt(np.maximum(np.sum(weights[0]*weights[0],axis=0),1e-30))
    sorted_marginals=quant[:,None]*first_scale[None,:]
    first=np.take_along_axis(sorted_marginals, inv_order, axis=0)
    x=np.concatenate([first,-first],axis=0)
    x=np.maximum(x,0)
    # match second
    W0,W1=weights[0],weights[1]
    gram=W0.T@W0
    first_var=np.maximum(np.diag(gram),1e-30)
    first_scale=np.sqrt(first_var)
    denom=first_scale[:,None]*first_scale[None,:]
    corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)*INV_TWO_PI
    relu_mean=first_scale*INV_SQRT_TWO_PI
    relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@W1
    true_mean=relu_mean@W1
    ctw=relu_cov@W1
    true_var=np.maximum(np.sum(ctw*W1,axis=0),1e-30)
    sample_mean=np.mean(z,axis=0)
    sample_second=np.mean(z*z,axis=0)
    sample_var=np.maximum(sample_second-sample_mean*sample_mean,1e-30)
    variance_scale=np.sqrt(true_var/sample_var)
    variance_scale=1.0+sv*(variance_scale-1.0)
    matched_mean=(1-sm)*sample_mean+sm*true_mean
    z=(z-sample_mean)*variance_scale+matched_mean
    x=np.maximum(z,0)
    for W in weights[2:]:
        x=np.maximum(x@W,0)
    return np.mean(x,axis=0)

def mc_true(weights, n=200000, seed=123):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(width,dtype=np.float64)
    bs=8192
    done=0
    while done<n:
        m=min(bs,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.sum(axis=0)
        done += m
    return s/n

def trial(width,depth,nnets=20,budget=10**9,ntrue=200000):
    rng=np.random.default_rng(999)
    configs=[]
    for sm in [-18,-16,-14.3,-12,-10,-8,0,1]:
      for sv in [0.75,1.0,1.25]:
        configs.append((sm,sv))
    errs=np.zeros(len(configs))
    for i in range(nnets):
        W=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        true=mc_true(W,ntrue,seed=10000+i)
        for j,(sm,sv) in enumerate(configs):
            pred=current_predict(W,seed=20000+i,budget=budget,sm=sm,sv=sv)
            errs[j]+=np.mean((pred-true)**2)
        print('net',i+1,'done')
    order=np.argsort(errs)
    for idx in order[:10]:
        print(width,depth,'sm sv',configs[idx],'mse',errs[idx]/nnets)

start=time.time()
trial(32,8,nnets=8,budget=10**9,ntrue=100000)
print('time',time.time()-start)

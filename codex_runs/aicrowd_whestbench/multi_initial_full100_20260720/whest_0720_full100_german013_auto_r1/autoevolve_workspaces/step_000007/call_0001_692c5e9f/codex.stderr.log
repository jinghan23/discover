/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535

def base_sample(W,seed,budget=10**9,bfrac=0.23):
    depth=len(W); width=W[0].shape[0]
    per_sample=depth*(2*width*width+width)+width*width+48*width; fixed=13*width**3
    k=(int(bfrac*budget)-fixed)//max(per_sample,1); k=int(max(32,min(1_000_000,(100*1024*1024)//max(width*8,1),k))); k-=k&1; half=k//2
    rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32)
    cov=(u.T@u)/half
    L=np.linalg.cholesky(cov) if half>width+1 else None
    WT=np.linalg.solve(L.T,W[0]) if L is not None else W[0]
    first=u@WT
    inv=np.argsort(np.argsort(first,axis=0),axis=0)
    q=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
    fs=np.sqrt(np.maximum(np.sum(W[0]*W[0],axis=0),1e-30))
    first=np.take_along_axis(q[:,None]*fs[None,:],inv,axis=0)
    x=np.maximum(np.concatenate([first,-first],axis=0),0)
    return x

def relu_cov_first(W0):
    gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]
    corr=np.clip(gram/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)*INV_TWO_PI
    mean=fs*INV_SQRT_TWO_PI; cov=second-mean[:,None]*mean[None,:]
    return mean,cov

def pred(W,seed,mode='diag',sm=-18,budget=10**9):
    x=base_sample(W,seed,budget); width=W[0].shape[0]; k=x.shape[0]
    mean,cov=relu_cov_first(W[0]); z=x@W[1]; true_mean=mean@W[1]; true_cov=W[1].T@(cov@W[1])
    sample_mean=z.mean(0); centered=z-sample_mean
    if mode=='none':
        z=z
    elif mode=='diag':
        tv=np.maximum(np.diag(true_cov),1e-30); sv=np.maximum((centered*centered).mean(0),1e-30)
        scale=np.sqrt(tv/sv); matched_mean=(1-sm)*sample_mean+sm*true_mean
        z=centered*scale+matched_mean
    elif mode=='full':
        S=(centered.T@centered)/k
        eps=1e-5*np.mean(np.diag(S))
        Ls=np.linalg.cholesky(S+np.eye(width)*eps)
        Lt=np.linalg.cholesky(true_cov+np.eye(width)*eps)
        M=np.linalg.solve(Ls.T,Lt.T)
        z=centered@M + true_mean
    elif mode=='full_sm':
        S=(centered.T@centered)/k
        eps=1e-5*np.mean(np.diag(S))
        Ls=np.linalg.cholesky(S+np.eye(width)*eps)
        Lt=np.linalg.cholesky(true_cov+np.eye(width)*eps)
        M=np.linalg.solve(Ls.T,Lt.T)
        matched_mean=(1-sm)*sample_mean+sm*true_mean
        z=centered@M + matched_mean
    x=np.maximum(z,0)
    for w in W[2:]: x=np.maximum(x@w,0)
    return x.mean(0)

def true(W,n,seed):
    width=W[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); bs=8192; done=0
    while done<n:
      m=min(bs,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
      for w in W: x=np.maximum(x@w,0)
      s+=x.sum(0); done+=m
    return s/n

def run(width,depth,nn=6):
    modes=['none','diag','full','full_sm']; errs=dict((m,0.0) for m in modes); rng=np.random.default_rng(1234+width+depth)
    for i in range(nn):
      W=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
      t=true(W,100000,5000+i)
      for m in modes: errs[m]+=np.mean((pred(W,6000+i,m)-t)**2)
    print('case',width,depth)
    for m,e in sorted(errs.items(), key=lambda kv:kv[1]): print(m,e/nn)
for c in [(32,8),(32,16),(64,8),(64,16)]: run(*c,nn=5)

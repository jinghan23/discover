                RunnerErrorDetail(
                    code="SETUP_ERROR",
                    message=str(exc),
                    details=setup_details,
                    traceback=_tb.format_exc(),
                ),
            ) from exc
        setup_elapsed = time.time() - start_wall
        if setup_elapsed > limits.setup_timeout_s:

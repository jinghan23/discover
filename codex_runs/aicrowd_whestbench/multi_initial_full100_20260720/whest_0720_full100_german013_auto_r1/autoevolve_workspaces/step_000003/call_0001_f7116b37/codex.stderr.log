/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
INV=0.3989422804014327

def diag_pred(mlp):
    w0=mlp.weights[0]
    var=fnp.sum(w0*w0, axis=0)
    sigma=fnp.sqrt(fnp.maximum(var,1e-30))
    m=sigma*INV
    q=var*0.5
    rows=[m]
    for w in mlp.weights[1:]:
        mu=m@w
        centered=fnp.maximum(q-m*m,1e-30)
        var=centered@(w*w)
        sig=fnp.sqrt(fnp.maximum(var,1e-30))
        a=mu/sig
        Phi=flops.stats.norm.cdf(a)
        phi=INV*fnp.exp(-0.5*a*a)
        m=sig*phi+mu*Phi
        q=(mu*mu+var)*Phi+mu*sig*phi
        rows.append(m)
    return fnp.stack(rows)

specs=[(16,4,2000000,10**9),(32,4,1000000,10**9),(32,8,600000,10**9),(64,4,300000,10**9)]
for width,depth,n,budget in specs:
    rng=fnp.random.default_rng(4242+width+depth)
    errs_cur=[]; errs_diag=[]; errs_bl=[]
    for i in range(5):
        mlp=sample_mlp(width,depth,rng,seed=1000+i)
        target=sample_layer_statistics(mlp,n,fnp.random.default_rng(90000+i))[1]
        cur=submission.Estimator().predict(mlp,budget)[-1]
        dp=diag_pred(mlp)[-1]
        errs_cur.append(float(fnp.mean((cur-target)**2)))
        errs_diag.append(float(fnp.mean((dp-target)**2)))
        for alpha in [0.1,0.2,0.3,0.5]:
            pass
        bl=0.8*cur+0.2*dp
        errs_bl.append(float(fnp.mean((bl-target)**2)))
    print('\\n',width,depth,'n',n)
    print('cur ',sum(errs_cur)/len(errs_cur), errs_cur)
    print('diag',sum(errs_diag)/len(errs_diag), errs_diag)
    print('blend.2',sum(errs_bl)/len(errs_bl), errs_bl)

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
INV=0.3989422804014327; INV2PI=0.15915494309189535

def sc(b,w,d):
 p=d*(2*w*w+w)+w*w+48*w; fixed=9*w**3+2*(2*w**3); k=(int(.22*b)-fixed)//max(p,1); k=int(max(32,min(1000000,100*1024*1024//max(w*8,1),k))); return k-(k&1)
def pred(mlp,b,mode):
 w=mlp.width; d=mlp.depth; k=sc(b,w,d); h=k//2; rng=fnp.random.default_rng(mlp.seed); u=rng.standard_normal((h,w)).astype(fnp.float32)
 cov=(u.T@u)/float(h); e,v=fnp.linalg.eigh(cov); e=fnp.maximum(e,1e-6); inv=(v/fnp.sqrt(e))@v.T
 first=u@(inv@mlp.weights[0]); order=fnp.argsort(first,axis=0); invorder=fnp.argsort(order,axis=0)
 if mode=='offset1': probs=(fnp.arange(h,dtype=fnp.float32)+1.0)/float(h+1)
 else: probs=(fnp.arange(h,dtype=fnp.float32)+0.5)/float(h)
 qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
 if mode=='var': qs=qs/fnp.sqrt(fnp.mean(qs*qs))
 elif mode=='mean': qs=qs*(2.0*INV/fnp.mean(fnp.abs(qs)))
 elif mode=='both':
  # compromise geometric mean of var and relu-mean scaling
  qs=qs*fnp.sqrt((1.0/fnp.sqrt(fnp.mean(qs*qs)))*(2.0*INV/fnp.mean(fnp.abs(qs))))
 fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
 if d==1: return (fs*INV)[None,:]
 first=fnp.take_along_axis(qs[:,None]*fs[None,:],invorder,axis=0); x=fnp.maximum(fnp.concatenate([first,-first],axis=0),0.0)
 # scalar match copy
 g=mlp.weights[0].T@mlp.weights[0]; fv=fnp.maximum(fnp.diag(g),1e-30); fsc=fnp.sqrt(fv); den=fsc[:,None]*fsc[None,:]; c=fnp.clip(g/den,-1,1)
 sec=den*(fnp.sqrt(fnp.maximum(1-c*c,0.0))+(float(fnp.pi)-fnp.arccos(c))*c)*INV2PI; mean=fsc*INV; covx=sec-mean[:,None]*mean[None,:]
 z=x@mlp.weights[1]; tm=mean@mlp.weights[1]; cw=covx@mlp.weights[1]; tv=fnp.maximum(fnp.sum(cw*mlp.weights[1],axis=0),1e-30); sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30)
 matched=(z-sm)*fnp.sqrt(tv/sv)+tm; x=fnp.maximum(z+.85*(matched-z),0.0)
 for wt in mlp.weights[2:]: x=fnp.maximum(x@wt,0.0)
 return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fnp.mean(x,axis=0)[None,:]],axis=0)

cases=[(16,4,1500000,10**9),(32,4,800000,10**9),(32,8,600000,10**9),(64,4,300000,10**9),(64,8,200000,10**9),(128,4,100000,10**10)]
modes=['current','var','mean','both','offset1']
for width,depth,n,budget in cases:
 rng=fnp.random.default_rng(15000+width+depth); mlps=[]; targets=[]
 for i in range(4):
  mlp=sample_mlp(width,depth,rng,seed=7000+i); mlps.append(mlp); targets.append(sample_layer_statistics(mlp,n,fnp.random.default_rng(210000+i))[1])
 print('\\nCASE',width,depth)
 for mode in modes:
  scores=[]; mses=[]
  for mlp,target in zip(mlps,targets):
   with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx:
    p=pred(mlp,budget,mode)
   mse=float(fnp.mean((p[-1]-target)**2)); scores.append(mse*max(.1,ctx.flops_used/budget)); mses.append(mse)
  print(mode,'score',sum(scores)/len(scores),'mse',sum(mses)/len(mses))

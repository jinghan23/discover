import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
INV=0.3989422804014327; INV2PI=0.15915494309189535

def sc(b,w,d,frac=.22):
 p=d*(2*w*w+w)+w*w+48*w; fixed=9*w**3+2*(2*w**3); k=(int(frac*b)-fixed)//max(p,1); k=int(max(32,min(1000000,100*1024*1024//max(w*8,1),k))); return k-(k&1)
def one_batch(mlp,k,seed_offset=0):
 w=mlp.width; d=mlp.depth; h=k//2; rng=fnp.random.default_rng(int(mlp.seed)+seed_offset); u=rng.standard_normal((h,w)).astype(fnp.float32)
 cov=(u.T@u)/float(h); e,v=fnp.linalg.eigh(cov); e=fnp.maximum(e,1e-6); inv=(v/fnp.sqrt(e))@v.T
 first=u@(inv@mlp.weights[0]); order=fnp.argsort(first,axis=0); invorder=fnp.argsort(order,axis=0); probs=(fnp.arange(h,dtype=fnp.float32)+0.5)/float(h); qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
 fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
 first=fnp.take_along_axis(qs[:,None]*fs[None,:],invorder,axis=0); x=fnp.maximum(fnp.concatenate([first,-first],axis=0),0.0)
 # match
 g=mlp.weights[0].T@mlp.weights[0]; fv=fnp.maximum(fnp.diag(g),1e-30); fsc=fnp.sqrt(fv); den=fsc[:,None]*fsc[None,:]; c=fnp.clip(g/den,-1,1)
 sec=den*(fnp.sqrt(fnp.maximum(1-c*c,0.0))+(float(fnp.pi)-fnp.arccos(c))*c)*INV2PI; mean=fsc*INV; covx=sec-mean[:,None]*mean[None,:]
 z=x@mlp.weights[1]; tm=mean@mlp.weights[1]; cw=covx@mlp.weights[1]; tv=fnp.maximum(fnp.sum(cw*mlp.weights[1],axis=0),1e-30); sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30); matched=(z-sm)*fnp.sqrt(tv/sv)+tm; x=fnp.maximum(z+.85*(matched-z),0.0)
 for wt in mlp.weights[2:]: x=fnp.maximum(x@wt,0.0)
 return fnp.mean(x,axis=0)
def pred(mlp,b,batches):
 w=mlp.width; d=mlp.depth; k=sc(b,w,d)
 if d==1:
  fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30)); final=fs*INV
 else:
  kb=max(32,(k//batches)//2*2)
  vals=[one_batch(mlp,kb,1000003*j) for j in range(batches)]
  final=fnp.mean(fnp.stack(vals),axis=0)
 return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),final[None,:]],axis=0)

cases=[(16,4,1500000,10**9),(32,4,800000,10**9),(32,8,600000,10**9),(64,4,300000,10**9),(64,8,200000,10**9)]
for width,depth,n,budget in cases:
 rng=fnp.random.default_rng(21000+width+depth); mlps=[]; targets=[]
 for i in range(4):
  mlp=sample_mlp(width,depth,rng,seed=10000+i); mlps.append(mlp); targets.append(sample_layer_statistics(mlp,n,fnp.random.default_rng(270000+i))[1])
 print('\\nCASE',width,depth)
 for batches in [1,2,4]:
  scores=[]; utils=[]
  for mlp,target in zip(mlps,targets):
   with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx: p=pred(mlp,budget,batches)
   mse=float(fnp.mean((p[-1]-target)**2)); scores.append(mse*max(.1,ctx.flops_used/budget)); utils.append(ctx.flops_used/budget)
  print('batches',batches,'score',sum(scores)/len(scores),'util',sum(utils)/len(utils))

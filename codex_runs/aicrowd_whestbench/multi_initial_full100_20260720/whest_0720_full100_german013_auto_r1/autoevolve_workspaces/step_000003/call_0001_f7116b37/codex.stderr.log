fracs=[0.08,0.10,0.12,0.16,0.20,0.22,0.26,0.32]
for width,depth,n,budget in cases:
 rng=fnp.random.default_rng(13000+width+depth); mlps=[]; targets=[]
 for i in range(3):
  mlp=sample_mlp(width,depth,rng,seed=6000+i); mlps.append(mlp); targets.append(sample_layer_statistics(mlp,n,fnp.random.default_rng(190000+i))[1])

The existing estimator uses roughly 19-20% of a nominal FLOP budget in synthetic checks, so the score multiplier is above the 0.1 floor. I’ll tune the covariance-match strength and sample fraction together rather than judging MSE alone.
exec
/bin/bash -lc "python - <<'PY'
# Tune full-match strength and budget fraction on small synthetic cases.
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
INV=0.3989422804014327
INV2PI=0.15915494309189535

def sample_count(budget,width,depth,frac):
    per_sample=depth*(2*width*width+width)+width*width+48*width
    fixed=13*width**3+2*width**3+2*width**2  # rough for full match, intentionally crude
    k=(int(frac*budget)-fixed)//max(per_sample,1)
    max_k=100*1024*1024//max(width*8,1)
    k=int(max(32,min(1000000,max_k,k)))
    return k-(k&1)

def match_full(x,w1,w2,strength):
    gram=w1.T@w1
    fs=fnp.sqrt(fnp.maximum(fnp.diag(gram),1e-30))
    denom=fs[:,None]*fs[None,:]
    corr=fnp.clip(gram/denom,-1,1)
    second=denom*(fnp.sqrt(fnp.maximum(1-corr*corr,0.0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*INV2PI
    mean=fs*INV
    cov=second-mean[:,None]*mean[None,:]
    z=x@w2
    tm=mean@w2
    covw=cov@w2
    tcov=w2.T@covw
    c=z-fnp.mean(z,axis=0)
    scov=(c.T@c)/float(x.shape[0])
    se,sv=fnp.linalg.eigh(scov); te,tv=fnp.linalg.eigh(tcov)
    se=fnp.maximum(se,1e-6); te=fnp.maximum(te,1e-8)
    a=((sv/fnp.sqrt(se))@sv.T)@((tv*fnp.sqrt(te))@tv.T)
    m=c@a+tm
    z=z+strength*(m-z)
    return fnp.maximum(z,0.0)

def pred(mlp,budget,frac,strength):
    w=mlp.width; d=mlp.depth; k=sample_count(budget,w,d,frac); h=k//2
    rng=fnp.random.default_rng(mlp.seed)
    u=rng.standard_normal((h,w)).astype(fnp.float32)
    cov=(u.T@u)/float(h)
    e,v=fnp.linalg.eigh(cov); e=fnp.maximum(e,1e-6)
    inv=(v/fnp.sqrt(e))@v.T
    first=u@(inv@mlp.weights[0])
    order=fnp.argsort(first,axis=0); invorder=fnp.argsort(order,axis=0)
    probs=(fnp.arange(h,dtype=fnp.float32)+0.5)/float(h)
    qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
    fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
    if d==1: return (fs*INV)[None,:]
    first=fnp.take_along_axis(qs[:,None]*fs[None,:],invorder,axis=0)
    x=fnp.maximum(fnp.concatenate([first,-first],axis=0),0.0)
    x=match_full(x,mlp.weights[0],mlp.weights[1],strength)
    for wt in mlp.weights[2:]: x=fnp.maximum(x@wt,0.0)
    final=fnp.mean(x,axis=0)
    return final

cases=[(32,4,800000,10**9),(32,8,600000,10**9),(64,4,300000,10**9)]
fracs=[0.12,0.16,0.20,0.24,0.30]
strengths=[0.75,1.0,1.15]
for width,depth,n,budget in cases:
    rng=fnp.random.default_rng(8300+width+depth)
    mlps=[]; targets=[]
    for i in range(3):
        mlp=sample_mlp(width,depth,rng,seed=3000+i); mlps.append(mlp)
        targets.append(sample_layer_statistics(mlp,n,fnp.random.default_rng(120000+i))[1])
    print('\\nCASE',width,depth)
    for frac in fracs:
      for st in strengths:
        vals=[]; utils=[]
        for mlp,target in zip(mlps,targets):
          with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx:
            p=pred(mlp,budget,frac,st)
          mse=float(fnp.mean((p-target)**2)); util=ctx.flops_used/budget; vals.append(mse*max(0.1,util)); utils.append(util)
        print('frac',frac,'st',st,'score',sum(vals)/len(vals),'mse*', 'util',sum(utils)/len(utils))

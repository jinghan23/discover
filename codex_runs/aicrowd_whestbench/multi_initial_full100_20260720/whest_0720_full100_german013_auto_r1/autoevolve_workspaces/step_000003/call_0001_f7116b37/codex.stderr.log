The diagonal approximation is far too biased on synthetic MLPs, so it is not a useful blend. I’ll test a narrower change: full covariance matching of the second preactivation instead of per-neuron variance matching.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
INV=0.3989422804014327
INV2PI=0.15915494309189535

def sample_count(budget,width,depth):
    per_sample=depth*(2*width*width+width)+width*width+48*width
    fixed=9*width**3+2*(2*width**3)
    k=(int(0.22*budget)-fixed)//max(per_sample,1)
    max_k=100*1024*1024//max(width*8,1)
    k=int(max(32,min(1000000,max_k,k)))
    return k-(k&1)

def match_second_full(x,w1,w2,strength=1.0,eps=1e-5):
    gram=w1.T@w1
    first_var=fnp.maximum(fnp.diag(gram),1e-30)
    first_scale=fnp.sqrt(first_var)
    denom=first_scale[:,None]*first_scale[None,:]
    corr=fnp.clip(gram/denom,-1.0,1.0)
    relu_second=denom*(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*INV2PI
    relu_mean=first_scale*INV
    relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@w2
    true_mean=relu_mean@w2
    covw=relu_cov@w2
    true_cov=w2.T@covw
    centered=z-fnp.mean(z,axis=0)
    sample_cov=(centered.T@centered)/float(x.shape[0])
    se,sv=fnp.linalg.eigh(sample_cov)
    te,tv=fnp.linalg.eigh(true_cov)
    se=fnp.maximum(se,eps)
    te=fnp.maximum(te,eps)
    sinv=(sv/fnp.sqrt(se))@sv.T
    tsqrt=(tv*fnp.sqrt(te))@tv.T
    matched=centered@(sinv@tsqrt)+true_mean
    z=z+strength*(matched-z)
    return fnp.maximum(z,0.0)

def pred_full(mlp,budget,strength=1.0):
    width=mlp.width; depth=mlp.depth; k=sample_count(budget,width,depth); half=k//2
    rng=fnp.random.default_rng(mlp.seed)
    u=rng.standard_normal((half,width)).astype(fnp.float32)
    cov=(u.T@u)/float(half)
    e,v=fnp.linalg.eigh(cov); e=fnp.maximum(e,1e-6)
    inv=(v/fnp.sqrt(e))@v.T
    first=u@(inv@mlp.weights[0])
    order=fnp.argsort(first,axis=0)
    invorder=fnp.argsort(order,axis=0)
    probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
    qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
    scale=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
    if depth==1: return (scale*INV)[None,:]
    sortedm=qs[:,None]*scale[None,:]
    first=fnp.take_along_axis(sortedm,invorder,axis=0)
    x=fnp.concatenate([first,-first],axis=0)
    x=fnp.maximum(x,0.0)
    x=match_second_full(x,mlp.weights[0],mlp.weights[1],strength)
    for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
    return fnp.mean(x,axis=0)

specs=[(16,4,1000000,10**9),(32,4,600000,10**9),(32,8,400000,10**9),(64,4,200000,10**9)]
for width,depth,n,budget in specs:
    rng=fnp.random.default_rng(7000+width+depth)
    strengths=[0.25,0.5,0.75,1.0]
    sums={s:[] for s in strengths}; cur=[]
    for i in range(4):
        mlp=sample_mlp(width,depth,rng,seed=2000+i)
        target=sample_layer_statistics(mlp,n,fnp.random.default_rng(100000+i))[1]
        c=submission.Estimator().predict(mlp,budget)[-1]
        cur.append(float(fnp.mean((c-target)**2)))
        for s in strengths:
            p=pred_full(mlp,budget,s)
            sums[s].append(float(fnp.mean((p-target)**2)))
    print('\\n',width,depth,'cur',sum(cur)/len(cur),cur)
    for s in strengths: print('full',s,sum(sums[s])/len(sums[s]),sums[s])

   with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx: p=pred(mlp,budget,frac)
   mse=float(fnp.mean((p[-1]-target)**2)); util=ctx.flops_used/budget; scores.append(mse*max(.1,util)); mses.append(mse); utils.append(util)
  print('frac',frac,'score',sum(scores)/len(scores),'mse',sum(mses)/len(mses),'util',sum(utils)/len(utils),'k',sc(budget,width,depth,frac))

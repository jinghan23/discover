/bin/bash -lc "python - <<'PY'
# synthetic plotting-position variants
import numpy as np
from scipy.stats import norm
INV=0.3989422804014327; INV2=0.15915494309189535

def pred(Ws,k,seed,a,b):
 w=Ws[0].shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,w)).astype(np.float32)
 cov=(u.T@u)/half; L=np.linalg.cholesky(cov); wt=np.linalg.solve(L.T,Ws[0]); zp=u@wt
 order=np.argsort(zp,0); inv=np.argsort(order,0); qs=norm.ppf((np.arange(half,dtype=np.float32)+a)/(half+b)).astype(np.float32)
 sc=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],0),1e-30)); zp=np.take_along_axis(qs[:,None]*sc[None,:],inv,0)
 x=np.maximum(np.concatenate([zp,-zp],0),0)
 W0,W1=Ws[0],Ws[1]; gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); den=fs[:,None]*fs[None,:]
 corr=np.clip(gram/den,-1,1); rs=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV2
 rm=fs*INV; rc=rs-rm[:,None]*rm[None,:]; z=x@W1; tm=rm@W1; tv=np.maximum(np.sum((rc@W1)*W1,0),1e-30); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); mm=15.3*sm-14.3*tm; x=np.maximum((z-sm)*np.sqrt(tv/sv)+mm,0)
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)

def true(Ws,N=160000,seed=1):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  n=min(40000,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/N
positions=[('mid',0.5,0.0),('blom',0.375,0.25),('tukey',1/3,1/3),('rankit',0.5,1.0),('weibull',1.0,1.0),('cunnane',0.4,0.2)]
for case in [(32,4,4096),(64,4,4096),(32,8,4096),(64,8,4096)]:
 print('\\ncase',case); width,depth,k=case
 Wslist=[]; Ts=[]
 for seed in range(4):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((width,width)).astype(np.float32)/np.sqrt(width) for _ in range(depth)]
  Wslist.append(Ws); Ts.append(true(Ws,seed=seed+70))
 for name,a,b in positions:
  es=[np.mean((pred(Ws,k,seed,a,b)-T)**2) for seed,(Ws,T) in enumerate(zip(Wslist,Ts))]
  print(name,np.mean(es))

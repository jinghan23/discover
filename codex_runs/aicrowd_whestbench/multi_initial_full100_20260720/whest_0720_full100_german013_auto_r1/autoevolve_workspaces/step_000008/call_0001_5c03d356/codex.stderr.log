import numpy as np
from scipy.stats import norm

INV_SQRT_TWO_PI=0.3989422804014327
INV_TWO_PI=0.15915494309189535

def sample_current(Ws,k,seed=123, ms=-14.3, vs=1.0):
    width=Ws[0].shape[0]; depth=len(Ws); half=k//2
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((half,width)).astype(np.float32)
    cov=(u.T@u)/float(half)
    if half>width+1:
        L=np.linalg.cholesky(cov)
        wt=np.linalg.solve(L.T,Ws[0])
    else:
        ev, Q=np.linalg.eigh(cov); ev=np.maximum(ev,1e-6); wt=(Q/np.sqrt(ev))@Q.T@Ws[0]
    zp=u@wt
    order=np.argsort(zp,axis=0); inv=np.argsort(order,axis=0)
    probs=(np.arange(half,dtype=np.float32)+0.5)/float(half)
    qs=norm.ppf(probs).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30))
    sorted_m=qs[:,None]*scale[None,:]
    zp=np.take_along_axis(sorted_m,inv,axis=0)
    x=np.maximum(np.concatenate([zp,-zp],axis=0),0)
    if depth>=2:
        W0,W1=Ws[0],Ws[1]
        gram=W0.T@W0
        first_var=np.maximum(np.diag(gram),1e-30); fs=np.sqrt(first_var)
        den=fs[:,None]*fs[None,:]
        corr=np.clip(gram/den,-1,1)
        relu_second=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI
        relu_mean=fs*INV_SQRT_TWO_PI
        relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
        z=x@W1
        true_mean=relu_mean@W1
        ctw=relu_cov@W1
        true_var=np.maximum(np.sum(ctw*W1,axis=0),1e-30)
        sm=z.mean(0); ss=(z*z).mean(0); sv=np.maximum(ss-sm*sm,1e-30)
        vscale=np.sqrt(true_var/sv); vscale=1+vs*(vscale-1)
        matched=(1-ms)*sm+ms*true_mean
        x=np.maximum((z-sm)*vscale+matched,0)
    for W in Ws[2:]: x=np.maximum(x@W,0)
    return x.mean(0)

def diag_mean(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); second=var+mu*mu
    for W in Ws:
        m=mu@W
        # independence approximation var = sum Var_i W_i"'^2
        v=var@(W*W)
        v=np.maximum(v,1e-30); s=np.sqrt(v); a=m/s
        Phi=norm.cdf(a); phi=norm.pdf(a)
        mu=s*phi + m*Phi
        second=(m*m+v)*Phi + m*s*phi
        var=np.maximum(second-mu*mu,1e-30)
    return mu

def true_mc(Ws,N=300000,seed=999,batch=50000):
    w=Ws[0].shape[0]; s=np.zeros(w); done=0; rng=np.random.default_rng(seed)
    while done<N:
        n=min(batch,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s += x.sum(0); done += n
    return s/N

for scale_name,scale in [('"'xavier',lambda w:1/np.sqrt(w)),('he',lambda w:np.sqrt(2/w))]:
  print('\\nscale',scale_name)
  for width,depth,k in [(32,4,4096),(32,8,4096),(64,4,4096),(64,8,4096),(64,8,8192)]:
    errs=[]; derrs=[]; blends=[]
    for seed in range(5):
      rng=np.random.default_rng(seed)
      Ws=[rng.standard_normal((width,width)).astype(np.float32)*scale(width) for _ in range(depth)]
      t=true_mc(Ws,N=200000,seed=1000+seed,batch=50000)
      c=sample_current(Ws,k,seed=seed)
      d=diag_mean(Ws)
      errs.append(np.mean((c-t)**2)); derrs.append(np.mean((d-t)**2))
      # best scalar blend alpha d + (1-a)c across this vector
      # check grid
      gs=[]
      for a in np.linspace(-0.5,0.5,21): gs.append(np.mean(((1-a)*c+a*d-t)**2))
      blends.append((np.linspace(-0.5,0.5,21)[int(np.argmin(gs))],min(gs)))
    print(width,depth,k,'cur',np.mean(errs),'diag',np.mean(derrs),'best alpha avg',np.mean([b[0] for b in blends]),'blenderr',np.mean([b[1] for b in blends]))

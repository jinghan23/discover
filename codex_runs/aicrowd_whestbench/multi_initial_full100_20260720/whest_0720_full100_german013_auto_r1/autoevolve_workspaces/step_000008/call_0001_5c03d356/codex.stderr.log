codex
I’m also considering special-casing shallow networks. For `depth == 2`, the second preactivation mean and variance are known exactly, and a Gaussian ReLU approximation is very cheap; I’m checking whether it beats sampling on synthetic cases.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
INV=0.3989422804014327; INV2=0.15915494309189535

def z2_stats(W0,W1):
 gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); den=fs[:,None]*fs[None,:]
 corr=np.clip(gram/den,-1,1); rs=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV2
 rm=fs*INV; rc=rs-rm[:,None]*rm[None,:]
 m=rm@W1; v=np.maximum(np.sum((rc@W1)*W1,0),1e-30)
 return m,v

def gaussian2(Ws):
 m,v=z2_stats(Ws[0],Ws[1]); s=np.sqrt(v); a=m/s; return s*norm.pdf(a)+m*norm.cdf(a)
# current copied simplified for depth2
def current2(Ws,k,seed):
 W0,W1=Ws; w=W0.shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,w)).astype(np.float32)
 cov=(u.T@u)/half; L=np.linalg.cholesky(cov); wt=np.linalg.solve(L.T,W0); zp=u@wt; order=np.argsort(zp,0); inv=np.argsort(order,0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); sc=np.sqrt(np.maximum(np.sum(W0*W0,0),1e-30)); zp=np.take_along_axis(qs[:,None]*sc[None,:],inv,0); x=np.maximum(np.concatenate([zp,-zp],0),0); z=x@W1; tm,tv=z2_stats(W0,W1); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); mm=15.3*sm-14.3*tm; x=np.maximum((z-sm)*np.sqrt(tv/sv)+mm,0); return x.mean(0)
def true(Ws,N=500000,seed=1):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  n=min(50000,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/N
for width in [16,32,64,128]:
 print('width',width)
 for name,fn in [('cur',lambda W,k,s:current2(W,k,s)),('gauss',lambda W,k,s:gaussian2(W))]:
  es=[]
  for seed in range(8):
   rng=np.random.default_rng(seed); Ws=[rng.standard_normal((width,width)).astype(np.float32)/np.sqrt(width) for _ in range(2)]
   t=true(Ws,300000,seed+90); es.append(np.mean((fn(Ws,4096,seed)-t)**2))
  print(name,np.mean(es))

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535

def gaussianize(z, mean=None, var=None):
    k=z.shape[0]
    if mean is None: mean=z.mean(0)
    if var is None: var=np.maximum((z*z).mean(0)-z.mean(0)**2,1e-30)
    order=np.argsort(z,axis=0); inv=np.argsort(order,axis=0)
    q=norm.ppf((np.arange(k,dtype=np.float32)+0.5)/k).astype(np.float32)
    return np.take_along_axis(mean[None,:]+q[:,None]*np.sqrt(var)[None,:], inv, axis=0)

def pred(Ws,k,seed,layer_gauss=False,second_quant=False):
 w=Ws[0].shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,w)).astype(np.float32)
 cov=(u.T@u)/half; L=np.linalg.cholesky(cov); wt=np.linalg.solve(L.T,Ws[0]); zp=u@wt
 order=np.argsort(zp,0); inv=np.argsort(order,0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
 sc=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],0),1e-30)); zp=np.take_along_axis(qs[:,None]*sc[None,:],inv,0)
 x=np.maximum(np.concatenate([zp,-zp],0),0)
 if len(Ws)>=2:
  W0,W1=Ws[0],Ws[1]; gram=W0.T@W0; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); den=fs[:,None]*fs[None,:]
  corr=np.clip(gram/den,-1,1); relu_second=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI
  rm=fs*INV_SQRT_TWO_PI; rc=relu_second-rm[:,None]*rm[None,:]
  z=x@W1; tm=rm@W1; tv=np.maximum(np.sum((rc@W1)*W1,0),1e-30)
  sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); mm=15.3*sm-14.3*tm; # baseline ms=-14.3
  if second_quant:
   z=gaussianize(z,mm,tv)
  else:
   z=(z-sm)*np.sqrt(tv/sv)+mm
  x=np.maximum(z,0)
 for W in Ws[2:]:
  z=x@W
  if layer_gauss:
   z=gaussianize(z)
  x=np.maximum(z,0)
 return x.mean(0)

def true(Ws,N=250000,seed=900):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  n=min(50000,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/N
for case in [(32,4,4096),(64,4,4096),(32,8,4096),(64,8,4096)]:
 width,depth,k=case; print('\\ncase',case)
 for variant in [(False,False),(False,True),(True,False),(True,True)]:
  es=[]
  for seed in range(4):
   rng=np.random.default_rng(seed); Ws=[rng.standard_normal((width,width)).astype(np.float32)/np.sqrt(width) for _ in range(depth)]
   t=true(Ws,180000,seed+100)
   p=pred(Ws,k,seed,*variant)
   es.append(np.mean((p-t)**2))
  print(variant, np.mean(es))

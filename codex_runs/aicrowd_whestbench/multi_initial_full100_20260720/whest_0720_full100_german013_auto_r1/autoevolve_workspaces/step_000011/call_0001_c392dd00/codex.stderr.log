/bin/bash -lc "python - <<'PY'
import subprocess, sys, textwrap, json, os
# run separate cases to avoid cumulative summaries
cases=[(32,8,10_000_000),(32,8,100_000_000),(64,8,100_000_000),(64,8,1_000_000_000),(64,16,1_000_000_000),(128,16,1_000_000_000)]
script=r'''
import flopscope as flops
import flopscope.numpy as fnp
import submission
class M: pass
width={w}; depth={d}; budget={b}
rng=fnp.random.default_rng(123)
m=M(); m.width=width; m.depth=depth; m.seed=456; m.weights=[(rng.standard_normal((width,width))* (1.0/(width**0.5))).astype(fnp.float32) for _ in range(depth)]
est=submission.Estimator()
with flops.budget(10**15, quiet=True):
 y=est.predict(m,budget)
 s=flops.budget_summary_dict()
print(width, depth, budget, submission._sample_count(budget,width,depth), s['flops_used'], s['flops_used']/budget, s['wall_time_s'])
'''
for w,d,b in cases:
    out=subprocess.check_output([sys.executable,'-c',script.format(w=w,d=d,b=b)], cwd='.')
    print(out.decode().strip())

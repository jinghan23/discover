import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535
def colnorm(w): return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def second_stats(w1,w2):
    w1d=w1.astype(np.float64); w2d=w2.astype(np.float64); gram=w1d.T@w1d; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    mu=(relu_mean@w2d).astype(np.float32); ctw=relu_cov@w2d; cov=(w2d.T@ctw).astype(np.float64); var=np.maximum(np.diag(cov),1e-30).astype(np.float32)
    return mu,var,cov
def pred(weights,seed,k=512,mode='diag',ms=-15,vs=1.075):
    width=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32); covu=(u.T@u)/half
    if half>width+1: whit=np.linalg.solve(np.linalg.cholesky(covu.astype(np.float64)).T,weights[0].astype(np.float64)).astype(np.float32)
    else:
        vals,vecs=np.linalg.eigh(covu.astype(np.float64)); vals=np.maximum(vals,1e-6); whit=((vecs/np.sqrt(vals))@vecs.T@weights[0]).astype(np.float32)
    first=u@whit; order=np.argsort(first,axis=0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); smarg=qs[:,None]*colnorm(weights[0])[None,:]; trans=np.empty_like(first); np.put_along_axis(trans,order,smarg,axis=0); x=np.maximum(np.concatenate([trans,-trans],0),0)
    z=x@weights[1]; tm,tv,tcov=second_stats(weights[0],weights[1]); sm=z.mean(0); zc=z-sm; sv=np.maximum((z*z).mean(0)-sm*sm,1e-30)
    mm=(1-ms)*sm+ms*tm
    if mode=='diag':
        sc=np.sqrt(tv/sv); sc=1+vs*(sc-1); z=zc*sc+mm
    elif mode=='full':
        S=(zc.astype(np.float64).T@zc.astype(np.float64))/z.shape[0]
        # preserve current over/under variance strength by blending target covariance against sample covariance?
        T=tcov
        if vs"'!=1.0:
            # simple diagonal-only strength not meaningful; use true full covariance directly
            pass
        ridge=1e-6*np.maximum(np.mean(np.diag(S)),1e-12)
        Ls=np.linalg.cholesky(S+np.eye(width)*ridge); Lt=np.linalg.cholesky(T+np.eye(width)*1e-12)
        A=np.linalg.solve(Ls.T,Lt.T)
        z=(zc.astype(np.float64)@A).astype(np.float32)+mm
    elif mode=='"'fullblend':
        S=(zc.astype(np.float64).T@zc.astype(np.float64))/z.shape[0]
        T=tcov
        ridge=1e-6*np.maximum(np.mean(np.diag(S)),1e-12)
        Ls=np.linalg.cholesky(S+np.eye(width)*ridge); Lt=np.linalg.cholesky(T+np.eye(width)*1e-12)
        A=np.linalg.solve(Ls.T,Lt.T)
        zf=(zc.astype(np.float64)@A).astype(np.float32)+mm
        sc=np.sqrt(tv/sv); sc=1+vs*(sc-1); zd=zc*sc+mm
        z=0.5*zd+0.5*zf
    x=np.maximum(z,0)
    for w in weights[2:]: x=np.maximum(x@w,0)
    return x.astype(np.float64).mean(0).astype(np.float32)
def ref(weights,seed,n=160000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+999999); s=np.zeros(width); c=0; batch=20000
    while c<n:
        b=min(batch,n-c); c+=b; x=rng.standard_normal((b,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return (s/n).astype(np.float32)
for cfg in [(32,8,1),(64,8,1),(128,8,1),(64,16,1),(64,8,2**0.5)]:
    width,depth,scale=cfg; sig=scale/np.sqrt(width); cases=[]; seeds=8 if width<128 else 5
    for seed in range(seeds):
        rng=np.random.default_rng(1000+seed); weights=[(rng.standard_normal((width,width))*sig).astype(np.float32) for _ in range(depth)]; cases.append((weights,seed,ref(weights,seed,100000)))
    print('cfg',cfg)

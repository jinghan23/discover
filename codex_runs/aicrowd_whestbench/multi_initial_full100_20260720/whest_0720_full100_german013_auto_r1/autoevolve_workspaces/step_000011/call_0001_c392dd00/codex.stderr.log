import numpy as np
from scipy.stats import norm

INV_SQRT_TWO_PI=0.3989422804014327
INV_TWO_PI=0.15915494309189535

def colnorm(w):
    return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2, axis=0),1e-30)).astype(np.float32)

def current_pred(weights, seed, k=512, mean_strength=-15.0, var_strength=1.075):
    depth=len(weights); width=weights[0].shape[0]
    if depth==1:
        return colnorm(weights[0])*INV_SQRT_TWO_PI
    half=k//2
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((half,width)).astype(np.float32)
    cov=(u.T@u)/float(half)
    if half>width+1:
        chol=np.linalg.cholesky(cov.astype(np.float64))
        whitening_times_weight=np.linalg.solve(chol.T, weights[0].astype(np.float64)).astype(np.float32)
    else:
        vals, vecs=np.linalg.eigh(cov.astype(np.float64))
        vals=np.maximum(vals,1e-6)
        inv=(vecs/np.sqrt(vals))@vecs.T
        whitening_times_weight=(inv@weights[0]).astype(np.float32)
    first=u@whitening_times_weight
    ordering=np.argsort(first, axis=0)
    probs=(np.arange(half,dtype=np.float32)+0.5)/float(half)
    qs=norm.ppf(probs).astype(np.float32)
    scale=colnorm(weights[0])
    sorted_m=qs[:,None]*scale[None,:]
    transported=np.empty_like(first)
    np.put_along_axis(transported, ordering, sorted_m, axis=0)
    first=transported
    x=np.maximum(np.concatenate([first,-first],axis=0),0)
    # match second
    w1=weights[0].astype(np.float64); w2=weights[1].astype(np.float64)
    gram=w1.T@w1
    first_var=np.maximum(np.diag(gram),1e-30)
    first_scale=np.sqrt(first_var)
    denom=first_scale[:,None]*first_scale[None,:]
    corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI
    relu_mean=first_scale*INV_SQRT_TWO_PI
    relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@weights[1]
    true_mean=(relu_mean@w2).astype(np.float32)
    ctw=relu_cov@w2
    true_var=np.maximum(np.sum(ctw*w2,axis=0),1e-30).astype(np.float32)
    sm=np.mean(z,axis=0); ss=np.mean(z*z,axis=0); sv=np.maximum(ss-sm*sm,1e-30)
    vs=np.sqrt(true_var/sv); vs=1.0+var_strength*(vs-1.0)
    mm=(1-mean_strength)*sm+mean_strength*true_mean
    x=np.maximum((z-sm)*vs+mm,0)
    for w in weights[2:]:
        x=np.maximum(x@w,0)
    return np.mean(x.astype(np.float64),axis=0).astype(np.float32)

def ref(weights, seed, n=200000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed+999999)
    s=np.zeros(width,dtype=np.float64)
    batch=20000
    cnt=0
    for _ in range((n+batch-1)//batch):
        b=min(batch,n-cnt); cnt+=b
        x=rng.standard_normal((b,width)).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0)
    return (s/n).astype(np.float32)

def run(width=64,depth=8,scale='he',k=512,seeds=10):
    mses=[]
    for seed in range(seeds):
        rng=np.random.default_rng(1000+seed)
        if scale=='he': sig=np.sqrt(2/width)
        elif scale=='xavier': sig=1/np.sqrt(width)
        elif scale=='plain': sig=1.0
        weights=[(rng.standard_normal((width,width))*sig).astype(np.float32) for _ in range(depth)]
        r=ref(weights, seed, n=100000)
        p=current_pred(weights, seed, k=k)
        mses.append(np.mean((p-r)**2))
    print('run',width,depth,scale,k,'mean mse',np.mean(mses),'per',mses[:3])

for scale in ['he','xavier']:
 for width,depth,k in [(32,8,512),(64,8,512),(64,16,512),(128,8,512)]:
    run(width,depth,scale,k,seeds=5)

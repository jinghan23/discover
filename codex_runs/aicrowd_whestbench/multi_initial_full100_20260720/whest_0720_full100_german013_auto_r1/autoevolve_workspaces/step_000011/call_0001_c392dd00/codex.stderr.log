# Synthetic optimal blend between transported and whitened-only estimators with same random cloud.
import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535
def colnorm(w): return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def finish_from_first(first,weights):
 x=np.maximum(np.concatenate([first,-first],0),0); w1=weights[0].astype(np.float64); w2=weights[1].astype(np.float64); gram=w1.T@w1; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1); rs=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; rm=fs*INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]; z=x@weights[1]; tm=(rm@w2).astype(np.float32); ctw=rc@w2; tv=np.maximum(np.sum(ctw*w2,axis=0),1e-30).astype(np.float32); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); sc=np.sqrt(tv/sv); sc=1+1.075*(sc-1); x=np.maximum((z-sm)*sc+16*sm-15*tm,0)
 for w in weights[2:]: x=np.maximum(x@w,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def preds(weights,seed,k=512):
 width=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32); cov=(u.T@u)/half; whit=np.linalg.solve(np.linalg.cholesky(cov.astype(np.float64)).T,weights[0].astype(np.float64)).astype(np.float32); first=u@whit; order=np.argsort(first,axis=0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); trans=np.empty_like(first); np.put_along_axis(trans,order,qs[:,None]*colnorm(weights[0])[None,:],axis=0); return finish_from_first(trans,weights),finish_from_first(first,weights)
def ref(weights,seed,n=120000):
 width=weights[0].shape[0]; rng=np.random.default_rng(seed+999999); s=np.zeros(width); c=0; batch=20000
 while c<n:
  b=min(batch,n-c); c+=b; x=rng.standard_normal((b,width)).astype(np.float32)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n).astype(np.float32)
for cfg in [(64,8,1),(128,8,1),(64,16,1)]:
 width,depth,scale=cfg; sig=scale/np.sqrt(width); P=[]; Q=[]; R=[]
 for seed in range(8 if width<128 else 5):
  rng=np.random.default_rng(1000+seed); weights=[(rng.standard_normal((width,width))*sig).astype(np.float32) for _ in range(depth)]; p,q=preds(weights,seed); r=ref(weights,seed,100000); P.append(p); Q.append(q); R.append(r)
 P=np.concatenate(P).astype(float); Q=np.concatenate(Q).astype(float); R=np.concatenate(R).astype(float); D=Q-P; a=(D@(R-P))/(D@D)
 print('cfg',cfg,'opt alpha plain',a,'mse p',np.mean((P-R)**2),'mse opt',np.mean((P+a*D-R)**2),'mse a.02',np.mean((P+0.02*D-R)**2))

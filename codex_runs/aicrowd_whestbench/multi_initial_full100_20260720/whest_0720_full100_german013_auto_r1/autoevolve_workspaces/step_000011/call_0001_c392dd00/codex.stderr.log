import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535
def exact_first_second_stats(w1,w2):
    w1d=w1.astype(np.float64); w2d=w2.astype(np.float64); gram=w1d.T@w1d; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    mu=relu_mean@w2d; ctw=relu_cov@w2d; var=np.maximum(np.sum(ctw*w2d,axis=0),1e-30)
    return mu,var
def gauss_second(w1,w2):
    mu,var=exact_first_second_stats(w1,w2); sig=np.sqrt(var); a=mu/sig; return (sig*np.exp(-0.5*a*a)*INV_SQRT_TWO_PI+mu*norm.cdf(a)).astype(np.float32)
# current predictor for depth 2 from previous code rough
def colnorm(w): return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def current2(w1,w2,seed,k=512,ms=-15,vs=1.075):
    width=w1.shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32); cov=(u.T@u)/half
    if half>width+1: whit=np.linalg.solve(np.linalg.cholesky(cov.astype(np.float64)).T,w1.astype(np.float64)).astype(np.float32)
    else:
        vals,vecs=np.linalg.eigh(cov.astype(np.float64)); vals=np.maximum(vals,1e-6); whit=((vecs/np.sqrt(vals))@vecs.T@w1).astype(np.float32)
    first=u@whit; order=np.argsort(first,axis=0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); smarg=qs[:,None]*colnorm(w1)[None,:]; trans=np.empty_like(first); np.put_along_axis(trans,order,smarg,axis=0); x=np.maximum(np.concatenate([trans,-trans],0),0)
    mu,var=exact_first_second_stats(w1,w2); z=x@w2; sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); sc=np.sqrt(var.astype(np.float32)/sv); sc=1+vs*(sc-1); mm=(1-ms)*sm+ms*mu.astype(np.float32); x=np.maximum((z-sm)*sc+mm,0)
    return x.astype(np.float64).mean(0).astype(np.float32)
def ref(weights,seed,n=500000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+999999); s=np.zeros(width); c=0; batch=25000
    while c<n:
        b=min(batch,n-c); c+=b; x=rng.standard_normal((b,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return (s/n).astype(np.float32)
for width in [32,64,128]:
    print('width',width)
    for scale in [1,2**0.5]:
        ecur=[]; eg=[]; eblend=[]
        sig=scale/np.sqrt(width)
        for seed in range(10):
            rng=np.random.default_rng(1000+seed); w1=(rng.standard_normal((width,width))*sig).astype(np.float32); w2=(rng.standard_normal((width,width))*sig).astype(np.float32); r=ref([w1,w2],seed,200000); c=current2(w1,w2,seed,512); g=gauss_second(w1,w2)
            ecur.append(np.mean((c-r)**2)); eg.append(np.mean((g-r)**2));
            # optimal blend scalar between c and g over all dims per case
            b=0.2*c+0.8*g; eblend.append(np.mean((b-r)**2))
        print('scale',scale,'current',np.mean(ecur),'gauss',np.mean(eg),'blend20c80g',np.mean(eblend))

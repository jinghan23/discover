    w1=weights[0].astype(np.float64); w2=weights[1].astype(np.float64); gram=w1.T@w1; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@weights[1]; tm=(relu_mean@w2).astype(np.float32); ctw=relu_cov@w2; tv=np.maximum(np.sum(ctw*w2,axis=0),1e-30).astype(np.float32)
    sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); sc=np.sqrt(tv/sv); sc=1+1.075*(sc-1); mm=16*sm-15*tm
    x=np.maximum((z-sm)*sc+mm,0)

    m=MLP(); m.width=width; m.depth=depth; m.seed=456
    m.weights=[(rng.standard_normal((width,width))* (1.0/(width**0.5))).astype(fnp.float32) for _ in range(depth)]
    est=submission.Estimator()
    with flops.budget(10**15, quiet=True):
        y=est.predict(m,budget)
        s=flops.budget_summary_dict()
    total=s.get('total_flops') or s.get('flops') or s
    print('case',width,depth,'budget arg',budget,'k',submission._sample_count(budget,width,depth),'summary',s)
for width,depth in [(32,8),(64,8),(128,8),(64,16),(128,16)]:
    for budget in [10_000_000,100_000_000,1_000_000_000]:
        try: run(width,depth,budget)
        except Exception as e: print('ERR',width,depth,budget,type(e).__name__,e)

import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535

def colnorm(w): return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-30)); a=mu/sig; phi=np.exp(-0.5*a*a)*INV_SQRT_TWO_PI; Phi=norm.cdf(a)
    m=sig*phi+mu*Phi
    q=(mu*mu+var)*Phi+mu*sig*phi
    return m.astype(np.float32), np.maximum(q,0).astype(np.float32)

def init_sample(weights, seed, k, ms=-15, vs_strength=1.075):
    width=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    u=rng.standard_normal((half,width)).astype(np.float32); cov=(u.T@u)/half
    if half>width+1: whitening=np.linalg.solve(np.linalg.cholesky(cov.astype(np.float64)).T, weights[0].astype(np.float64)).astype(np.float32)
    else:
        vals,vecs=np.linalg.eigh(cov.astype(np.float64)); vals=np.maximum(vals,1e-6); whitening=((vecs/np.sqrt(vals))@vecs.T@weights[0]).astype(np.float32)
    first=u@whitening; ordering=np.argsort(first,axis=0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); sorted_m=qs[:,None]*colnorm(weights[0])[None,:]
    transported=np.empty_like(first); np.put_along_axis(transported,ordering,sorted_m,axis=0)
    x=np.maximum(np.concatenate([transported,-transported],axis=0),0)
    w1=weights[0].astype(np.float64); w2=weights[1].astype(np.float64); gram=w1.T@w1; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@weights[1]; true_mean=(relu_mean@w2).astype(np.float32); ctw=relu_cov@w2; true_var=np.maximum(np.sum(ctw*w2,axis=0),1e-30).astype(np.float32)
    sm=z.mean(axis=0); sv=np.maximum((z*z).mean(axis=0)-sm*sm,1e-30); scale=np.sqrt(true_var/sv); scale=1+vs_strength*(scale-1); mm=(1-ms)*sm+ms*true_mean
    x=np.maximum((z-sm)*scale+mm,0)
    # analytic diagonal moments for layer2 activation from exact z moments (gaussian approx)
    m,q=relu_mom(true_mean,true_var)
    return x,m,q

def pred(weights, seed, k=512, layer_mu=0.0, layer_var=0.0):
    x,m,q=init_sample(weights,seed,k)
    for w in weights[2:]:
        z=x@w
        mu=(m.astype(np.float64)@w.astype(np.float64)).astype(np.float32)
        var=(np.maximum(q-m*m,1e-30).astype(np.float64)@(w.astype(np.float64)*w.astype(np.float64))).astype(np.float32)
        sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30)
        if layer_var:
            sc=np.sqrt(np.maximum(var,1e-30)/sv); sc=1+layer_var*(sc-1)
        else: sc=1.0
        if layer_mu:
            mm=(1-layer_mu)*sm+layer_mu*mu
        else: mm=sm
        zz=(z-sm)*sc+mm
        x=np.maximum(zz,0)
        m,q=relu_mom(mu,var)
    return x.astype(np.float64).mean(0).astype(np.float32)
def ref(weights, seed, n=160000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+999999); s=np.zeros(width); c=0; batch=20000
    while c<n:
        b=min(batch,n-c); c+=b; x=rng.standard_normal((b,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return (s/n).astype(np.float32)

def cases(width,depth,seeds,scale):
    out=[]; sig=scale/np.sqrt(width)
    for seed in range(seeds):
        rng=np.random.default_rng(1000+seed); weights=[(rng.standard_normal((width,width))*sig).astype(np.float32) for _ in range(depth)]
        out.append((weights,seed,ref(weights,seed)))
    return out
for cfg in [(64,8,1.0),(64,16,1.0),(32,8,1.0),(64,8,2**0.5)]:
    cs=cases(cfg[0],cfg[1],8,cfg[2])
    print('cfg',cfg)
    for lm,lv in [(0,0),(0.25,0),(0.5,0),(1,0),(0,0.25),(0,0.5),(0.25,0.25),(0.5,0.5),(-0.5,0.25),(-1,0.25)]:
        e=[]
        for weights,seed,r in cs:
            p=pred(weights,seed,512,lm,lv); e.append(np.mean((p-r)**2))
        print(lm,lv,np.mean(e))

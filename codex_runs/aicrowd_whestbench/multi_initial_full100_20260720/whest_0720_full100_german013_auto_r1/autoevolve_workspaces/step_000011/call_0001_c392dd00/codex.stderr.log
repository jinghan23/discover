# Estimate final scalar calibration for the current estimator on synthetic MLPs.
import numpy as np
from scipy.stats import norm
INV_SQRT_TWO_PI=0.3989422804014327; INV_TWO_PI=0.15915494309189535
# compact copy from previous current predictor
def colnorm(w): return np.sqrt(np.maximum(np.sum(w.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def pred(weights,seed,k=512,ms=-15,vs=1.075):
    width=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((half,width)).astype(np.float32); cov=(u.T@u)/half
    if half>width+1: whit=np.linalg.solve(np.linalg.cholesky(cov.astype(np.float64)).T, weights[0].astype(np.float64)).astype(np.float32)
    else:
        vals,vecs=np.linalg.eigh(cov.astype(np.float64)); vals=np.maximum(vals,1e-6); whit=((vecs/np.sqrt(vals))@vecs.T@weights[0]).astype(np.float32)
    first=u@whit; order=np.argsort(first,axis=0); qs=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32); smarg=qs[:,None]*colnorm(weights[0])[None,:]
    trans=np.empty_like(first); np.put_along_axis(trans,order,smarg,axis=0); x=np.maximum(np.concatenate([trans,-trans],0),0)
    w1=weights[0].astype(np.float64); w2=weights[1].astype(np.float64); gram=w1.T@w1; fs=np.sqrt(np.maximum(np.diag(gram),1e-30)); denom=fs[:,None]*fs[None,:]; corr=np.clip(gram/denom,-1,1)
    relu_second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)*INV_TWO_PI; relu_mean=fs*INV_SQRT_TWO_PI; relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@weights[1]; tm=(relu_mean@w2).astype(np.float32); ctw=relu_cov@w2; tv=np.maximum(np.sum(ctw*w2,axis=0),1e-30).astype(np.float32)
    sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); sc=np.sqrt(tv/sv); sc=1+vs*(sc-1); mm=(1-ms)*sm+ms*tm
    x=np.maximum((z-sm)*sc+mm,0)
    for w in weights[2:]: x=np.maximum(x@w,0)
    return x.astype(np.float64).mean(0).astype(np.float32)
def ref(weights,seed,n=200000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+999999); s=np.zeros(width); c=0; batch=20000
    while c<n:
        b=min(batch,n-c); c+=b; x=rng.standard_normal((b,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return (s/n).astype(np.float32)
for cfg in [(32,8,1),(64,8,1),(128,8,1),(64,16,1),(64,8,2**0.5)]:
    ps=[]; rs=[]; width,depth,scale=cfg; sig=scale/np.sqrt(width)
    for seed in range(10):
        rng=np.random.default_rng(1000+seed); weights=[(rng.standard_normal((width,width))*sig).astype(np.float32) for _ in range(depth)]
        p=pred(weights,seed,512); r=ref(weights,seed,120000); ps.append(p); rs.append(r)
    P=np.concatenate(ps).astype(np.float64); R=np.concatenate(rs).astype(np.float64)
    opt=(P@R)/(P@P)
    print('cfg',cfg,'opt scale',opt,'mse1',np.mean((P-R)**2),'mseopt',np.mean((opt*P-R)**2),'mean ratio',P.mean()/R.mean())

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtri, ndtr
from math import sqrt, pi

INV_SQRT_TWO_PI=1/sqrt(2*pi)
INV_TWO_PI=1/(2*pi)


def sample_count(budget,w,d,frac=0.23):
    per_sample=d*(2*w*w+w)+w*w+48*w
    fixed=13*w**3
    k=(int(frac*budget)-fixed)//max(per_sample,1)
    k=int(max(32,min(1_000_000,100*1024*1024//max(w*8,1),k)))
    k=k-(k&1)
    return max(32,k-2)

def column_norm(W):
    return np.sqrt(np.maximum(np.sum(W.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)

def match_second(x,W1,W2,s=-15,vstr=1):
    W1d=W1.astype(np.float64); W2d=W2.astype(np.float64)
    gram=W1d.T@W1d
    fv=np.maximum(np.diag(gram),1e-30)
    fs=np.sqrt(fv)
    den=fs[:,None]*fs[None,:]
    corr=np.clip(gram/den,-1,1)
    relu_second=den*(np.sqrt(np.maximum(1-corr*corr,0))+(pi-np.arccos(corr))*corr)*INV_TWO_PI
    relu_mean=fs*INV_SQRT_TWO_PI
    relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@W2
    true_mean=(relu_mean@W2d).astype(np.float32)
    ctw=relu_cov@W2d
    true_var=np.maximum(np.sum(ctw*W2d,axis=0),1e-30).astype(np.float32)
    sm=z.mean(axis=0)
    ss=(z*z).mean(axis=0)
    sv=np.maximum(ss-sm*sm,1e-30)
    vs=np.sqrt(true_var/sv)
    vs=1+vstr*(vs-1)
    mm=(1-s)*sm+s*true_mean
    z=(z-sm)*vs+mm
    return np.maximum(z,0)

def current(Ws,k,seed=0,s=-15,blend=None):
    w=Ws[0].shape[0]; d=len(Ws); half=k//2
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((half,w)).astype(np.float32)
    cov=(u.T@u)/half
    if half>w+1:
        L=np.linalg.cholesky(cov)
        Wwhite=np.linalg.solve(L.T,Ws[0])
    else:
        ev,Q=np.linalg.eigh(cov); ev=np.maximum(ev,1e-6); Wwhite=((Q/np.sqrt(ev))@Q.T)@Ws[0]
    fp=u@Wwhite
    order=np.argsort(fp,axis=0)
    probs=(np.arange(half,dtype=np.float32)+0.5)/half
    qs=ndtri(probs).astype(np.float32)
    fs=column_norm(Ws[0])
    sorted_m=qs[:,None]*fs[None,:]
    tr=np.empty_like(fp)
    np.put_along_axis(tr, order, sorted_m, axis=0)
    x=np.concatenate([tr,-tr],axis=0)
    x=np.maximum(x,0)
    x=match_second(x,Ws[0],Ws[1],s=s)
    for W in Ws[2:]:
        x=np.maximum(x@W,0)
    mc=x.astype(np.float64).mean(axis=0).astype(np.float32)
    if blend is not None:
        an=diag_analytic(Ws)
        return (1-blend)*mc+blend*an
    return mc

def diag_analytic(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w,dtype=np.float64); var=np.ones(w,dtype=np.float64)
    for W in Ws:
        Wd=W.astype(np.float64)
        mup=Wd.T@mu
        varp=(Wd*Wd).T@var
        varp=np.maximum(varp,1e-12)
        sig=np.sqrt(varp); a=mup/sig
        phi=np.exp(-0.5*a*a)*INV_SQRT_TWO_PI
        Phi=ndtr(a)
        mu=mup*Phi+sig*phi
        ez2=(mup*mup+varp)*Phi+mup*sig*phi
        var=np.maximum(ez2-mu*mu,0)
    return mu.astype(np.float32)

def cov_analytic(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w,dtype=np.float64); cov=np.eye(w,dtype=np.float64)
    for W in Ws:
        Wd=W.astype(np.float64)
        mup=Wd.T@mu
        covp=Wd.T@cov@Wd
        varp=np.maximum(np.diag(covp),1e-12)
        sig=np.sqrt(varp); a=mup/sig
        phi=np.exp(-0.5*a*a)*INV_SQRT_TWO_PI
        Phi=ndtr(a)
        mu=mup*Phi+sig*phi
        ez2=(mup*mup+varp)*Phi+mup*sig*phi
        varpost=np.maximum(ez2-mu*mu,0)
        gain=np.where(sig>1e-12,Phi,0)
        cov=np.outer(gain,gain)*covp
        np.fill_diagonal(cov,varpost)
    return mu.astype(np.float32)

def target(Ws,N=200000,seed=123,chunk=8192):
    rng=np.random.default_rng(seed); w=Ws[0].shape[0]
    s=np.zeros(w,dtype=np.float64); n=0
    for st in range(0,N,chunk):
        m=min(chunk,N-st)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in Ws:
            x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(axis=0); n+=m
    return (s/n).astype(np.float32)

for w,N,k in [(64,300000,14000),(128,120000,12000)]:
  d=32; print('case',w,N,k,flush=True)
  mses={}
  alphas=[None,-0.2,-0.1,-0.05,0.05,0.1,0.2,0.5]
  for mi in range(5 if w==64 else 2):
    rng=np.random.default_rng(1000+mi)
    Ws=[(rng.standard_normal((w,w))*sqrt(2/w)).astype(np.float32) for _ in range(d)]
    t=target(Ws,N=N,seed=2000+mi)
    base=current(Ws,k,seed=3000+mi,s=-15)
    diag=diag_analytic(Ws); cov=cov_analytic(Ws)
    vals={'base':np.mean((base-t)**2),'diag':np.mean((diag-t)**2),'cov':np.mean((cov-t)**2)}
    for a in [-0.2,-0.1,-0.05,0.05,0.1,0.2,0.5]:
        pred=(1-a)*base+a*diag
        vals[f'bd{a}']=np.mean((pred-t)**2)
    for a in [-0.2,-0.1,-0.05,0.05,0.1,0.2,0.5]:
        pred=(1-a)*base+a*cov
        vals[f'bc{a}']=np.mean((pred-t)**2)
    print(mi, {k2:float(v) for k2,v in vals.items() if k2 in ['base','diag','cov','bd0.05','bd0.1','bd-0.05','bc0.05','bc0.1','bc-0.05']}, flush=True)
    for k2,v in vals.items(): mses.setdefault(k2,[]).append(v)
  avg={k2:float(np.mean(v)) for k2,v in mses.items()}
  for k2 in sorted(avg,key=avg.get)[:12]:
    print('avg',k2,avg[k2])

 class Estimator(BaseEstimator):
+    def setup(self, context):
+        width = context.width
+        depth = context.depth
+        k = _sample_count(context.flop_budget, width, depth)
+        half = k // 2
+        rng = fnp.random.default_rng(context.seed)
+
+        u = rng.standard_normal((half, width)).astype(fnp.float32)
+        covariance = (u.T @ u) / float(half)
+        if half > width + 1:
+            cholesky = fnp.linalg.cholesky(covariance)
+            base = fnp.linalg.solve(cholesky, u.T).T
+        else:
+            eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
+            eigenvalues = fnp.maximum(eigenvalues, 1e-6)
+            inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
+            base = u @ inverse_sqrt
+
+        marginal_probs = (fnp.arange(half, dtype=fnp.float32) + 0.5) / float(half)
+        self._base = fnp.asarray(base, dtype=fnp.float32)
+        self._marginal_quantiles = flops.stats.norm.ppf(marginal_probs).astype(
+            fnp.float32
+        )
+        self._design_key = (width, depth, context.flop_budget)
+

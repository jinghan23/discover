/bin/bash -lc "python - <<'PY'
# Lightweight synthetic variance-strength check, independent of hidden evaluation data.
import numpy as np
from scipy.special import ndtri
from math import sqrt, pi
INV_SQRT_TWO_PI=1/sqrt(2*pi); INV_TWO_PI=1/(2*pi)

def colnorm(W): return np.sqrt(np.maximum(np.sum(W.astype(np.float64)**2,axis=0),1e-30)).astype(np.float32)
def match(x,W1,W2,s=-15,v=1):
    W1d=W1.astype(np.float64); W2d=W2.astype(np.float64)
    gram=W1d.T@W1d; fv=np.maximum(np.diag(gram),1e-30); fs=np.sqrt(fv)
    den=fs[:,None]*fs[None,:]; corr=np.clip(gram/den,-1,1)
    rs=den*(np.sqrt(np.maximum(1-corr*corr,0))+(pi-np.arccos(corr))*corr)*INV_TWO_PI
    rm=fs*INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]
    z=x@W2; tm=(rm@W2d).astype(np.float32); ctw=rc@W2d
    tv=np.maximum(np.sum(ctw*W2d,axis=0),1e-30).astype(np.float32)
    sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30)
    vs=1+v*(np.sqrt(tv/sv)-1); mm=(1-s)*sm+s*tm
    return np.maximum((z-sm)*vs+mm,0)
def est(Ws,k,seed,v):
    w=Ws[0].shape[0]; h=k//2; rng=np.random.default_rng(seed)
    u=rng.standard_normal((h,w)).astype(np.float32); cov=(u.T@u)/h
    L=np.linalg.cholesky(cov); Ww=np.linalg.solve(L.T,Ws[0]); fp=u@Ww
    order=np.argsort(fp,axis=0); qs=ndtri((np.arange(h,dtype=np.float32)+0.5)/h).astype(np.float32)
    tr=np.empty_like(fp); np.put_along_axis(tr,order,qs[:,None]*colnorm(Ws[0])[None,:],axis=0)
    x=np.maximum(np.concatenate([tr,-tr],0),0); x=match(x,Ws[0],Ws[1],v=v)
    for W in Ws[2:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)
def target(Ws,N,seed):
    rng=np.random.default_rng(seed); w=Ws[0].shape[0]; s=np.zeros(w); n=0
    for st in range(0,N,8192):
        m=min(8192,N-st); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(0); n+=m
    return (s/n).astype(np.float32)
for w,N,k,mn in [(64,250000,14000,5),(128,100000,12000,2)]:
    vals={v:[] for v in [0.7,0.85,0.95,1.0,1.05,1.15,1.3]}
    for i in range(mn):
        rng=np.random.default_rng(500+i); Ws=[(rng.standard_normal((w,w))*sqrt(2/w)).astype(np.float32) for _ in range(32)]
        t=target(Ws,N,1000+i)
        for v in vals: vals[v].append(np.mean((est(Ws,k,2000+i,v)-t)**2))
    print('case',w,{v:float(np.mean(vals[v])) for v in vals},'best',min(vals,key=lambda v:np.mean(vals[v])))

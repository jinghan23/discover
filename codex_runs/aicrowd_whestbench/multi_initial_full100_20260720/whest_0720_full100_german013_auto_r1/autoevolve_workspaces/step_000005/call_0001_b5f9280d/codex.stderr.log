codex
There is no bivariate normal CDF in the instrumented stats surface, so full nonzero-mean covariance propagation would be awkward. I’m testing a cheaper diagonal Gaussian propagation as a possible control variate blended into the Monte Carlo final mean.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest
from whestbench.sdk import SetupContext
import submission

INV = 0.3989422804014327

def diag_est(mlp):
    width=mlp.width
    mean = fnp.zeros(width, dtype=fnp.float32)
    second = fnp.ones(width, dtype=fnp.float32)
    for w in mlp.weights:
        z_mean = mean @ w
        var = fnp.maximum((second - mean * mean) @ (w * w), 1e-30)
        std = fnp.sqrt(var)
        alpha = z_mean / std
        cdf = flops.stats.norm.cdf(alpha)
        pdf = flops.stats.norm.pdf(alpha)
        mean = std * pdf + z_mean * cdf
        second = (var + z_mean * z_mean) * cdf + z_mean * std * pdf
    return mean

def predict_mc(mlp,budget):
    return submission.Estimator().predict(mlp,budget)[-1]

specs=[
    ContestSpec(width=32, depth=8, n_mlps=8, flop_budget=500_000_000, ground_truth_samples=80000, seed=21, wall_time_limit_s=60.0),
    ContestSpec(width=64, depth=8, n_mlps=5, flop_budget=1_000_000_000, ground_truth_samples=80000, seed=22, wall_time_limit_s=60.0),
    ContestSpec(width=64, depth=16, n_mlps=4, flop_budget=1_000_000_000, ground_truth_samples=80000, seed=23, wall_time_limit_s=60.0),
    ContestSpec(width=128, depth=8, n_mlps=3, flop_budget=2_000_000_000, ground_truth_samples=50000, seed=24, wall_time_limit_s=60.0),
]
submission._BUDGET_FRACTION=0.23; submission._SECOND_MEAN_STRENGTH=-12.7; submission._SECOND_VARIANCE_STRENGTH=1.0
for spec in specs:
    data=make_contest(spec)
    errs={a:[] for a in [-0.5,-0.2,-0.1,0,0.05,0.1,0.2,0.5,1.0]}
    diagerrs=[]; mcerrs=[]
    for mlp,target in zip(data.mlps,data.final_targets):
        mc=predict_mc(mlp,spec.flop_budget)
        de=diag_est(mlp)
        mcerrs.append(float(fnp.mean((mc-target)**2)))
        diagerrs.append(float(fnp.mean((de-target)**2)))
        for a in errs:
            pred=(1-a)*mc + a*de
            errs[a].append(float(fnp.mean((pred-target)**2)))
    print('\\nSPEC', spec.width,spec.depth)
    print('mc', sum(mcerrs)/len(mcerrs), 'diag', sum(diagerrs)/len(diagerrs))
    for a in errs:
        print(a, sum(errs[a])/len(errs[a]))
PY" in /opt/tiger/discover/workspace

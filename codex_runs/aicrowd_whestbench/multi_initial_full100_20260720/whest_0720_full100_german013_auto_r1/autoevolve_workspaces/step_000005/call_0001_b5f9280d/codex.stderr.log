import flopscope as flops
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest
import submission

INV_SQRT=0.3989422804014327
INV_TWO=0.15915494309189535

def match2(x,w0,w1,ms=-14.3,vs=1.0):
    gram=w0.T@w0
    fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv)
    den=fs[:,None]*fs[None,:]
    corr=fnp.clip(gram/den,-1.0,1.0)
    relu_second=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0.0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*INV_TWO
    relu_mean=fs*INV_SQRT
    cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    z=x@w1
    tm=relu_mean@w1
    ctw=cov@w1
    tv=fnp.maximum(fnp.sum(ctw*w1,axis=0),1e-30)
    sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30)
    scale=1+vs*(fnp.sqrt(tv/sv)-1)
    mm=(1-ms)*sm+ms*tm
    return fnp.maximum((z-sm)*scale+mm,0.0)

def k_count(b,w,d):
    per=d*(2*w*w+w)+w*w+48*w; fixed=9*w**3+2*(2*w**3)
    k=(int(0.23*b)-fixed)//max(per,1); k=int(max(32,min(1000000,100*1024*1024//max(w*8,1),k))); return k-(k&1)

def pred(mlp,budget,mode):
    w=mlp.width; d=mlp.depth
    if d==1:
        fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30)); return fs*INV_SQRT
    k=k_count(budget,w,d); half=k//2; rng=fnp.random.default_rng(mlp.seed)
    u=rng.standard_normal((half,w)).astype(fnp.float32)
    if mode"'!='"'plain':
        cov=(u.T@u)/float(half)
        if half>w+1:
            chol=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(chol.T,mlp.weights[0])
        else:
            ev, evec=fnp.linalg.eigh(cov); ev=fnp.maximum(ev,1e-6); inv=(evec/fnp.sqrt(ev))@evec.T; wt=inv@mlp.weights[0]
        z=u@wt
    else:
        z=u@mlp.weights[0]
    if mode=='rank':
        order=fnp.argsort(z,axis=0); invorder=fnp.argsort(order,axis=0)
        probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
        qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
        fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
        z=fnp.take_along_axis(qs[:,None]*fs[None,:],invorder,axis=0)
    x=fnp.maximum(fnp.concatenate([z,-z],axis=0),0.0)
    x=match2(x,mlp.weights[0],mlp.weights[1])
    for ww in mlp.weights[2:]: x=fnp.maximum(x@ww,0.0)
    return fnp.mean(x,axis=0)

specs=[
 ContestSpec(width=32, depth=8, n_mlps=6, flop_budget=500_000_000, ground_truth_samples=60000, seed=31, wall_time_limit_s=60.0),
 ContestSpec(width=64, depth=8, n_mlps=4, flop_budget=1_000_000_000, ground_truth_samples=60000, seed=32, wall_time_limit_s=60.0),
 ContestSpec(width=64, depth=16, n_mlps=3, flop_budget=1_000_000_000, ground_truth_samples=60000, seed=33, wall_time_limit_s=60.0),
]
for spec in specs:
    data=make_contest(spec)
    print('\\nSPEC',spec.width,spec.depth)
    for mode in ['rank','whiten','plain']:
        es=[]
        for mlp,target in zip(data.mlps,data.final_targets):
            p=pred(mlp,spec.flop_budget,mode)
            es.append(float(fnp.mean((p-target)**2)))
        print(mode,sum(es)/len(es))

/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest
import submission

# Use current submission helpers, with best mean strength injected for local checks.
submission._BUDGET_FRACTION=0.23
submission._SECOND_MEAN_STRENGTH=-14.3
submission._SECOND_VARIANCE_STRENGTH=1.0

def pred_raw(mlp,budget):
    return submission.Estimator().predict(mlp,budget)[-1]

def pred_final_gauss(mlp,budget):
    width=mlp.width; depth=mlp.depth
    if depth==1: return pred_raw(mlp,budget)
    k=submission._sample_count(budget,width,depth); half=k//2
    rng=fnp.random.default_rng(mlp.seed)
    u=rng.standard_normal((half,width)).astype(fnp.float32)
    covariance=(u.T@u)/float(half)
    if half>width+1:
        whitening_times_weight=fnp.linalg.solve(fnp.linalg.cholesky(covariance).T,mlp.weights[0])
    else:
        ev,evec=fnp.linalg.eigh(covariance); ev=fnp.maximum(ev,1e-6); whitening_times_weight=((evec/fnp.sqrt(ev))@evec.T)@mlp.weights[0]
    first_preactivation=u@whitening_times_weight
    ordering=fnp.argsort(first_preactivation,axis=0); inverse_ordering=fnp.argsort(ordering,axis=0)
    probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
    qs=flops.stats.norm.ppf(probs).astype(fnp.float32)
    fs=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
    first_preactivation=fnp.take_along_axis(qs[:,None]*fs[None,:],inverse_ordering,axis=0)
    x=fnp.maximum(fnp.concatenate([first_preactivation,-first_preactivation],axis=0),0)
    x=submission._match_second_preactivation(x,mlp.weights[0],mlp.weights[1])
    for weight in mlp.weights[2:-1]:
        x=fnp.maximum(x@weight,0)
    z=x@mlp.weights[-1]
    sm=fnp.mean(z,axis=0); sv=fnp.maximum(fnp.mean(z*z,axis=0)-sm*sm,1e-30)
    std=fnp.sqrt(sv); a=sm/std
    return std*flops.stats.norm.pdf(a)+sm*flops.stats.norm.cdf(a)

specs=[
 ContestSpec(width=32, depth=8, n_mlps=8, flop_budget=500_000_000, ground_truth_samples=80000, seed=51, wall_time_limit_s=60),
 ContestSpec(width=64, depth=8, n_mlps=5, flop_budget=1_000_000_000, ground_truth_samples=80000, seed=52, wall_time_limit_s=60),
 ContestSpec(width=64, depth=16, n_mlps=4, flop_budget=1_000_000_000, ground_truth_samples=80000, seed=53, wall_time_limit_s=60),
 ContestSpec(width=128, depth=8, n_mlps=3, flop_budget=2_000_000_000, ground_truth_samples=50000, seed=54, wall_time_limit_s=60),
]
for spec in specs:
    data=make_contest(spec)
    er=[]; eg=[]
    for mlp,t in zip(data.mlps,data.final_targets):
        er.append(float(fnp.mean((pred_raw(mlp,spec.flop_budget)-t)**2)))
        eg.append(float(fnp.mean((pred_final_gauss(mlp,spec.flop_budget)-t)**2)))
    print('SPEC',spec.width,spec.depth,'raw',sum(er)/len(er),'gauss',sum(eg)/len(eg))

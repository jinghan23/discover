/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed); scale=math.sqrt(2/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]

def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n

def sample(weights,k,seed):
    w=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32); x0=np.concatenate([u,-u],0)
    cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    z=x0@(inv@weights[0]); h1=np.maximum(z,0)
    x=h1.copy()
    for W in weights[1:]: x=np.maximum(x@W,0)
    return h1,x

def cv_h1(weights,k,seed,ridge=1e-3, use_h2=False, diag2=False):
    h1,y=sample(weights,k,seed); n=h1.shape[0]; w=h1.shape[1]
    C=h1.astype(np.float64)
    cov0=weights[0].T@weights[0]
    mu=np.sqrt(np.maximum(np.diag(cov0),0))/math.sqrt(2*math.pi)
    exact=mu.astype(np.float64)
    if diag2:
        C=np.concatenate([C, C*C],axis=1)
        exact=np.concatenate([exact, 0.5*np.diag(cov0).astype(np.float64)])
    cm=C.mean(0); ym=y.mean(0).astype(np.float64)
    Cc=C-cm; Yc=y.astype(np.float64)-ym
    G=Cc.T@Cc
    lam=ridge*np.trace(G)/G.shape[0]
    B=np.linalg.solve(G+lam*np.eye(G.shape[0]), Cc.T@Yc)
    return ym + (exact-cm)@B

def cv_h1_diag(weights,k,seed):
    h1,y=sample(weights,k,seed); cov0=weights[0].T@weights[0]
    exact=np.sqrt(np.maximum(np.diag(cov0),0))/math.sqrt(2*math.pi)
    cm=h1.mean(0).astype(np.float64); ym=y.mean(0).astype(np.float64)
    Cc=h1.astype(np.float64)-cm; Yc=y.astype(np.float64)-ym
    var=(Cc*Cc).sum(0)+1e-9
    cov=Cc.T@Yc
    B=cov/var[:,None]
    return ym+(exact-cm)@B

for w,k,ntrue,nm in [(64,3000,200000,8),(128,6000,100000,5)]:
  print('case',w,k,ntrue); ms=[]; cv=[]; cvd=[]; cv2=[]; best=[]; t0=time.time()
  for i in range(nm):
    weights=make_mlp(w,32,10+i); t=target(weights,ntrue,50+i)
    h1,y=sample(weights,k,70+i); m=y.mean(0).astype(np.float64)
    e=cv_h1(weights,k,70+i,1e-3,diag2=False)
    ed=cv_h1_diag(weights,k,70+i)
    e2=cv_h1(weights,k,70+i,1e-3,diag2=True)
    ms.append(np.mean((m-t)**2)); cv.append(np.mean((e-t)**2)); cvd.append(np.mean((ed-t)**2)); cv2.append(np.mean((e2-t)**2))
    grid=[]
    for a in np.linspace(0,1,11): grid.append(np.mean((a*m+(1-a)*e-t)**2))
    best.append(min(grid))
    print(i, ms[-1], cv[-1], cvd[-1], cv2[-1], best[-1])
  print('means',np.mean(ms),np.mean(cv),np.mean(cvd),np.mean(cv2),np.mean(best),'time',time.time()-t0)
PY" in /opt/tiger/discover/workspace

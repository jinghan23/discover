import numpy as np, math, time
from scipy.special import ndtr
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2.0/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]

def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.astype(np.float64).sum(axis=0)
        done+=m
    return (s/n).astype(np.float64)

def lhs_current(weights,k,seed,stop_penult=False):
    w=weights[0].shape[0]; half=k//2
    rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+0.5)/float(half)
    u=norm.ppf(probs).astype(np.float32)
    x=np.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(half)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(inv@weights[0]),0)
    end=len(weights)-1 if stop_penult else len(weights)
    for W in weights[1:end]:
        x=np.maximum(x@W,0)
    return x

def est_current(weights,k,seed):
    return lhs_current(weights,k,seed,False).mean(axis=0)

def est_last_gauss(weights,k,seed):
    x=lhs_current(weights,k,seed,True)
    mu=x.mean(axis=0).astype(np.float64)
    second=(x.T@x).astype(np.float64)/x.shape[0]
    W=weights[-1].astype(np.float64)
    pre_mu=mu@W
    temp=second@W
    pre_second=(W*temp).sum(axis=0)
    var=np.maximum(pre_second-pre_mu*pre_mu,1e-12)
    sig=np.sqrt(var)
    a=pre_mu/sig
    return pre_mu*ndtr(a)+sig*np.exp(-0.5*a*a)/math.sqrt(2*math.pi)

for w,k,ntrue,nm in [(64,3000,100000,5),(128,6000,50000,3)]:
  print('case',w,k,ntrue)
  ms=[]; gs=[]; blends=[]
  t0=time.time()
  for i in range(nm):
    weights=make_mlp(w,32,1000+i)
    t=target(weights,ntrue,2000+i)
    m=est_current(weights,k,3000+i)
    g=est_last_gauss(weights,k,3000+i)
    ms.append(np.mean((m-t)**2)); gs.append(np.mean((g-t)**2))
    # optimal blend grid
    arr=[]
    for a in np.linspace(0,1,11):
      b=a*m+(1-a)*g
      arr.append(np.mean((b-t)**2))
    blends.append(min(arr))
    print(i, ms[-1], gs[-1], blends[-1])
  print('means',np.mean(ms),np.mean(gs),np.mean(blends),'time',time.time()-t0)

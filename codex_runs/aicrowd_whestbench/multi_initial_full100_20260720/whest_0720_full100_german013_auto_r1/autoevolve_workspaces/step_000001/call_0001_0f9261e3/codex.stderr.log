/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n

def current_z(weights,k,seed):
    w=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32)
    cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    z=u@(inv@weights[0])
    return np.concatenate([z,-z],0)

def iman_z(weights,k,seed):
    W0=weights[0]; w=W0.shape[0]; half=k//2; rng=np.random.default_rng(seed)
    # base independent normals for correlation ranks
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32)
    cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    S=W0.T@W0; diag=np.maximum(np.diag(S),1e-12); scale=np.sqrt(diag)
    corr=S/np.sqrt(diag[:,None]*diag[None,:]); corr=(corr+corr.T)/2
    ev,Q=np.linalg.eigh(corr); ev=np.maximum(ev,1e-6); L=Q*np.sqrt(ev)@Q.T
    v=u@(inv@L)
    order=np.argsort(v,axis=0)
    inv_order=np.argsort(order,axis=0)
    q=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
    sorted_vals=q[:,None]*scale[None,:]
    z=np.take_along_axis(sorted_vals, inv_order, axis=0)
    return np.concatenate([z,-z],0).astype(np.float32)

def est(weights,k,seed,mode):
    z=current_z(weights,k,seed) if mode=='current' else iman_z(weights,k,seed)
    x=np.maximum(z,0)
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)
for w,k,ntrue,nm in [(64,6000,200000,10),(128,12000,100000,4)]:

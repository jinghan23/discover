import numpy as np, math, time
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n
def est(weights,k,seed,whiten=True):
    w=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32)
    if whiten:
      cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=u@((vecs/np.sqrt(vals))@vecs.T)
    x=np.concatenate([u,-u],0)
    for W in weights: x=np.maximum(x@W,0)
    return x.mean(0).astype(np.float64)
for w,ntrue,nm in [(128,200000,4)]:
    ks=[3000,6000,9000,14000,20000]
    scores={k:[] for k in ks}; scoresnw={k:[] for k in ks}
    t0=time.time()
    for i in range(nm):
        weights=make_mlp(w,32,100+i); t=target(weights,ntrue,500+i)
        for k in ks:
            m=est(weights,k,900+i,True); scores[k].append(np.mean((m-t)**2)*k) # product proxy
            if k in (6000,14000):
                mn=est(weights,k,900+i,False); scoresnw[k].append(np.mean((mn-t)**2)*k)
    for k in ks:
        print('k',k,'mse*k',np.mean(scores[k]),'mse',np.mean(scores[k])/k)
    for k,v in scoresnw.items():
        if v: print('no_whiten k',k,'mse*k',np.mean(v),'mse',np.mean(v)/k)
    print('time',time.time()-t0)

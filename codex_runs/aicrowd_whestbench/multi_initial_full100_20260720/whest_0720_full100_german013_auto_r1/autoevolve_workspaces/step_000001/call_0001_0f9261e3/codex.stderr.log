--- a/submission.py
+++ b/submission.py
@@ -5,11 +5,13 @@
 from whestbench import BaseEstimator
 
 
-_BUDGET_FRACTION = 0.22
+_BUDGET_FRACTION = 0.30
 _MIN_SAMPLES = 32
 _MAX_SAMPLES = 1_000_000
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _WORST_CASE_ITEMSIZE = 8
+_INV_SQRT_2PI = 0.3989422804014327
+_RIDGE_SCALE = 1e-3
 
 
 def _sample_count(budget: int, width: int, depth: int) -> int:
@@ -41,9 +43,25 @@
         folded_first_weight = inverse_sqrt @ mlp.weights[0]
 
         x = fnp.maximum(x @ folded_first_weight, 0.0)
+        first_layer = x
+        first_exact_mean = (
+            fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0), 1e-30))
+            * _INV_SQRT_2PI
+        )
         for weight in mlp.weights[1:]:
             x = fnp.maximum(x @ weight, 0.0)
 
         final_mean = fnp.mean(x, axis=0)
+        control_mean = fnp.mean(first_layer, axis=0)
+        control_centered = first_layer - control_mean
+        output_centered = x - final_mean
+        gram = control_centered.T @ control_centered
+        ridge = fnp.mean(fnp.diag(gram)) * _RIDGE_SCALE
+        beta = fnp.linalg.solve(
+            gram + ridge * fnp.eye(width, dtype=gram.dtype),
+            control_centered.T @ output_centered,
+        )
+        final_mean = final_mean + (first_exact_mean - control_mean) @ beta
+
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)

codex
The control-variate estimator is in place. It uses only the exact first-layer ReLU mean implied by the weights and a ridge-stabilized regression from sampled first-layer activations to final outputs.

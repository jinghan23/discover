import numpy as np, math, time
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n
def z_current(weights,k,seed):
    w=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0); probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32); cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    z=u@(inv@weights[0])
    return z
def z_resort(weights,k,seed):
    z=z_current(weights,k,seed); half,w=z.shape
    S=weights[0].T@weights[0]; scale=np.sqrt(np.maximum(np.diag(S),1e-12))
    inv_order=np.argsort(np.argsort(z,axis=0),axis=0)
    q=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
    zr=np.take_along_axis(q[:,None]*scale[None,:], inv_order, axis=0)
    return zr.astype(np.float32)
def est(weights,k,seed,mode):
    z=z_current(weights,k,seed) if mode=='current' else z_resort(weights,k,seed)
    x=np.maximum(np.concatenate([z,-z],0),0)
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)
for w,k,ntrue,nm in [(64,6000,200000,10),(128,12000,100000,5),(256,14000,50000,3)]:
  print('case',w,k); res={'current':[],'resort':[]}; t0=time.time()
  for i in range(nm):
    weights=make_mlp(w,32,1500+i); t=target(weights,ntrue,1600+i)
    for mode in res:
      m=est(weights,k,1700+i,mode); res[mode].append(np.mean((m-t)**2))
    print(i,res['current'][-1],res['resort'][-1])
  for mode in res: print(mode,np.mean(res[mode]))
  print('time',time.time()-t0)

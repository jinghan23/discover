/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def make_mlp(w,d,seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def target(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n
def first_resort(weights,k,seed):
    w=weights[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0); probs=(ranks.astype(np.float32)+0.5)/half
    u=norm.ppf(probs).astype(np.float32); cov=(u.T@u)/half; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    z=u@(inv@weights[0]); inv_order=np.argsort(np.argsort(z,axis=0),axis=0)
    scale=np.sqrt(np.maximum(np.sum(weights[0]*weights[0],axis=0),1e-12))
    q=norm.ppf((np.arange(half,dtype=np.float32)+0.5)/half).astype(np.float32)
    zr=np.take_along_axis(q[:,None]*scale[None,:], inv_order, axis=0).astype(np.float32)
    return np.maximum(np.concatenate([zr,-zr],0),0), scale
def est(weights,k,seed,mode):
    x,scale=first_resort(weights,k,seed)
    if mode=='shift':
      x=x+(scale/math.sqrt(2*math.pi)-x.mean(0))
    elif mode=='scale':
      x=x*((scale/math.sqrt(2*math.pi))/np.maximum(x.mean(0),1e-12))
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)
for w,k,ntrue,nm in [(128,12000,100000,8),(256,17742,50000,4)]:
  print('case',w,k); res={m:[] for m in ['resort','shift','scale']}
  for i in range(nm):
    weights=make_mlp(w,32,2800+i); t=target(weights,ntrue,2900+i)
    vals=[]
    for m in res:
      e=np.mean((est(weights,k,3000+i,m)-t)**2); res[m].append(e); vals.append(e)
    print(i, vals)
  for m in res: print(m,np.mean(res[m]))

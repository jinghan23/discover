diff --git a/submission.py b/submission.py
index a6828a6ce0b67c38035e083f6695b6f31b6f444b..998ddcef4f9569cd98228d622c2cdb2d83c2811c
--- a/submission.py
+++ b/submission.py
@@ -12,7 +12,37 @@
 _WORST_CASE_ITEMSIZE = 8
 _INV_SQRT_TWO_PI = 0.3989422804014327
 _INV_TWO_PI = 0.15915494309189535
-_SECOND_MATCH_STRENGTH = 0.80
+_SECOND_MATCH_STRENGTH = 0.72
+_DIAG_BLEND = 0.05
+
+
+def _normal_pdf(x):
+    return fnp.exp(-0.5 * x * x) * _INV_SQRT_TWO_PI
+
+
+def _relu_moments(mean, variance):
+    variance = fnp.maximum(variance, 1e-30)
+    scale = fnp.sqrt(variance)
+    alpha = mean / scale
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = _normal_pdf(alpha)
+    relu_mean = scale * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * scale * pdf
+    return relu_mean, relu_second
+
+
+def _diag_gaussian_final(mlp):
+    first_variance = fnp.maximum(
+        fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0), 1e-30
+    )
+    mean = fnp.sqrt(first_variance) * _INV_SQRT_TWO_PI
+    second = first_variance * 0.5
+    for weight in mlp.weights[1:]:
+        activation_variance = fnp.maximum(second - mean * mean, 1e-30)
+        pre_mean = mean @ weight
+        pre_variance = activation_variance @ (weight * weight)
+        mean, second = _relu_moments(pre_mean, pre_variance)
+    return mean
 
 

from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp
import submission
import time

_INV_SQRT_TWO_PI = submission._INV_SQRT_TWO_PI

def diag_final(mlp):
    w0 = mlp.weights[0]
    v = fnp.maximum(fnp.sum(w0*w0, axis=0), 1e-30)
    m = fnp.sqrt(v) * _INV_SQRT_TWO_PI
    q = v * 0.5
    for w in mlp.weights[1:]:
        mu = m @ w
        var = fnp.maximum((q - m*m) @ (w*w), 1e-30)
        sig = fnp.sqrt(var)
        a = mu / sig
        cdf = flops.stats.norm.cdf(a)
        pdf = flops.stats.norm.pdf(a)
        m = sig * pdf + mu * cdf
        q = (var + mu*mu) * cdf + mu * sig * pdf
        q = fnp.maximum(q, m*m + 1e-30)
    return m

class MixEstimator(BaseEstimator):
    def __init__(self, gamma): self.gamma=gamma
    def predict(self, mlp, budget):
        base = submission.Estimator().predict(mlp, budget)
        d = diag_final(mlp)
        final = base[-1]*(1.0-self.gamma) + d*self.gamma
        zero_rows = fnp.zeros((mlp.depth - 1, mlp.width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final[None, :]], axis=0)


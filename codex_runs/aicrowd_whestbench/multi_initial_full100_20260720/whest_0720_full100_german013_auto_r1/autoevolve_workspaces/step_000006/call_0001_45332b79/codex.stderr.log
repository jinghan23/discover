 ContestSpec(width=64, depth=20, n_mlps=8, flop_budget=1_000_000_000, ground_truth_samples=50000, seed=401, wall_time_limit_s=30.0),
 ContestSpec(width=100, depth=100, n_mlps=4, flop_budget=10_000_000_000, ground_truth_samples=30000, seed=402, wall_time_limit_s=30.0),

from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp
import submission, time

_INV_SQRT_TWO_PI=submission._INV_SQRT_TWO_PI

def relu_moments(mu,var):
    var=fnp.maximum(var,1e-30)
    sig=fnp.sqrt(var)
    a=mu/sig
    cdf=flops.stats.norm.cdf(a)
    pdf=flops.stats.norm.pdf(a)
    m=sig*pdf+mu*cdf
    q=(var+mu*mu)*cdf+mu*sig*pdf
    return m, fnp.maximum(q, m*m+1e-30)

def second_stats(first_weight, second_weight):
    gram=first_weight.T@first_weight
    first_variance=fnp.maximum(fnp.diag(gram),1e-30)
    first_scale=fnp.sqrt(first_variance)
    denom=first_scale[:,None]*first_scale[None,:]
    corr=fnp.clip(gram/denom,-1.0,1.0)
    relu_second=denom*(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*submission._INV_TWO_PI
    relu_mean=first_scale*_INV_SQRT_TWO_PI
    relu_cov=relu_second-relu_mean[:,None]*relu_mean[None,:]
    mu=relu_mean@second_weight
    ctw=relu_cov@second_weight
    var=fnp.maximum(fnp.sum(ctw*second_weight,axis=0),1e-30)
    return mu,var

class LaterMatchEstimator(BaseEstimator):
    def __init__(self, mean_s=1.0, var_s=1.0): self.mean_s=mean_s; self.var_s=var_s
    def predict(self, mlp, budget):
        width=mlp.width; depth=mlp.depth
        if depth==1: return submission.Estimator().predict(mlp,budget)
        k=submission._sample_count(budget,width,depth); half=k//2
        rng=fnp.random.default_rng(mlp.seed)
        u=rng.standard_normal((half,width)).astype(fnp.float32)
        covariance=(u.T@u)/float(half)
        if half > width+1:
            cholesky=fnp.linalg.cholesky(covariance)
            whitening_times_weight=fnp.linalg.solve(cholesky.T, mlp.weights[0])
        else:
            eigenvalues,eigenvectors=fnp.linalg.eigh(covariance)
            eigenvalues=fnp.maximum(eigenvalues,1e-6)
            inverse_sqrt=(eigenvectors/fnp.sqrt(eigenvalues))@eigenvectors.T
            whitening_times_weight=inverse_sqrt@mlp.weights[0]
        first_preactivation=u@whitening_times_weight
        ordering=fnp.argsort(first_preactivation,axis=0)
        inverse_ordering=fnp.argsort(ordering,axis=0)
        marginal_probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
        marginal_quantiles=flops.stats.norm.ppf(marginal_probs).astype(fnp.float32)
        first_scale=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
        sorted_marginals=marginal_quantiles[:,None]*first_scale[None,:]
        first_preactivation=fnp.take_along_axis(sorted_marginals,inverse_ordering,axis=0)
        x=fnp.concatenate([first_preactivation,-first_preactivation],axis=0)
        x=fnp.maximum(x,0.0)
        # exact second match and analytic Gaussian m/q for layer 2
        mu,var=second_stats(mlp.weights[0], mlp.weights[1])
        z=x@mlp.weights[1]
        sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30)
        vs=fnp.sqrt(var/sv); vs=1.0+submission._SECOND_VARIANCE_STRENGTH*(vs-1.0)
        mm=(1.0-submission._SECOND_MEAN_STRENGTH)*sm+submission._SECOND_MEAN_STRENGTH*mu
        z=(z-sm)*vs+mm
        x=fnp.maximum(z,0.0)
        m,q=relu_moments(mu,var)
        for w in mlp.weights[2:]:
            mu=m@w
            var=fnp.maximum((q-m*m)@(w*w),1e-30)
            z=x@w
            sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30)
            scale=fnp.sqrt(var/sv)
            scale=1.0+self.var_s*(scale-1.0)
            target=(1.0-self.mean_s)*sm+self.mean_s*mu
            z=(z-sm)*scale+target
            x=fnp.maximum(z,0.0)
            m,q=relu_moments(mu,var)
        final=fnp.mean(x,axis=0)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32), final[None,:]], axis=0)


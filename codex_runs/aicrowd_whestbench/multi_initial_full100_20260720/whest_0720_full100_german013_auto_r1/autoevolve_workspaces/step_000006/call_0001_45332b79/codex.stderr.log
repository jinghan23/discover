        vals.append(r['adjusted_final_layer_score']); mses.append(r['final_layer_mse']); mult.append(r['mean_score_multiplier']); fails+=r['n_failed_mlps']
    print('ms vs',ms,vs,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(mses)/len(mses),'mult',sum(mult)/len(mult),'fails',fails, flush=True)

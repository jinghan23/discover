from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp
import submission

class FirstScaleEstimator(BaseEstimator):
    def __init__(self, strength): self.strength=strength
    def predict(self, mlp,budget):
        width=mlp.width; depth=mlp.depth
        if depth==1: return submission.Estimator().predict(mlp,budget)
        k=submission._sample_count(budget,width,depth); half=k//2
        rng=fnp.random.default_rng(mlp.seed)
        u=rng.standard_normal((half,width)).astype(fnp.float32)
        covariance=(u.T@u)/float(half)
        if half > width+1:
            cholesky=fnp.linalg.cholesky(covariance)
            whitening_times_weight=fnp.linalg.solve(cholesky.T, mlp.weights[0])
        else:
            eigenvalues,eigenvectors=fnp.linalg.eigh(covariance)
            eigenvalues=fnp.maximum(eigenvalues,1e-6)
            inverse_sqrt=(eigenvectors/fnp.sqrt(eigenvalues))@eigenvectors.T
            whitening_times_weight=inverse_sqrt@mlp.weights[0]
        y=u@whitening_times_weight
        ordering=fnp.argsort(y,axis=0); inv=fnp.argsort(ordering,axis=0)
        probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
        q=flops.stats.norm.ppf(probs).astype(fnp.float32)
        scale=fnp.sqrt(fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),1e-30))
        y=fnp.take_along_axis(q[:,None]*scale[None,:], inv, axis=0)
        x=fnp.maximum(fnp.concatenate([y,-y],axis=0),0.0)
        true_mean=scale*submission._INV_SQRT_TWO_PI
        sample_mean=fnp.maximum(fnp.mean(x,axis=0),1e-30)
        col_scale=1.0+self.strength*(true_mean/sample_mean-1.0)
        x=x*col_scale[None,:]
        x=submission._match_second_preactivation(x, mlp.weights[0], mlp.weights[1])
        for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
        final=fnp.mean(x,axis=0)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32), final[None,:]],axis=0)


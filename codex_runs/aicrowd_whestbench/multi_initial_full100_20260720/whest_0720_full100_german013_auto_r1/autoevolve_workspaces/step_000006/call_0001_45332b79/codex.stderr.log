/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import submission, time
specs = [
    ContestSpec(width=100, depth=100, n_mlps=3, flop_budget=10_000_000_000, ground_truth_samples=30000, seed=201, wall_time_limit_s=30.0),
    ContestSpec(width=128, depth=100, n_mlps=2, flop_budget=20_000_000_000, ground_truth_samples=20000, seed=202, wall_time_limit_s=30.0),
]
datas=[]
for s in specs:
    print('making', s.width, s.depth, s.n_mlps, flush=True)
    t=time.time(); datas.append(make_contest(s)); print('made', time.time()-t, flush=True)
base=(submission._BUDGET_FRACTION, submission._SECOND_MEAN_STRENGTH, submission._SECOND_VARIANCE_STRENGTH)

def score(c):
    submission._BUDGET_FRACTION, submission._SECOND_MEAN_STRENGTH, submission._SECOND_VARIANCE_STRENGTH=c
    vals=[]; mses=[]; mults=[]; fails=0
    for d in datas:
        r=evaluate_estimator(submission.Estimator(), d)
        vals.append(r['adjusted_final_layer_score']); mses.append(r['final_layer_mse']); mults.append(r['mean_score_multiplier']); fails += r['n_failed_mlps']
    return sum(vals)/len(vals), vals, sum(mses)/len(mses), sum(mults)/len(mults), fails
cands=[]
for ms in [-30,-24,-20,-18,-16,-15,-14.3,-13.5,-12,-10,-8,-5,0]: cands.append((0.23,ms,1.0))
for vs in [0,0.5,0.8,1.0,1.2,1.5,2.0]: cands.append((0.23,-14.3,vs))
for bf in [0.10,0.14,0.18,0.23,0.28,0.34,0.45,0.6]: cands.append((bf,-14.3,1.0))
rows=[]; seen=set()
for c in cands:
    if c in seen: continue
    seen.add(c)
    try:
        t=time.time(); out=score(c); dt=time.time()-t
        rows.append((out[0], c, out[1], out[2], out[3], out[4]))
        print('cand', c, 'avg', out[0], 'vals', out[1], 'mse', out[2], 'mult', out[3], 'fails', out[4], 'dt', dt, flush=True)
    except Exception as e:
        print('ERR', c, type(e).__name__, e, flush=True)
rows.sort(key=lambda x:x[0])
print('best')
for row in rows[:12]: print(row)
submission._BUDGET_FRACTION, submission._SECOND_MEAN_STRENGTH, submission._SECOND_VARIANCE_STRENGTH=base

/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import submission

specs = [
    ContestSpec(width=64, depth=20, n_mlps=8, flop_budget=1_000_000_000, ground_truth_samples=50000, seed=101, wall_time_limit_s=30.0),
    ContestSpec(width=100, depth=20, n_mlps=4, flop_budget=2_000_000_000, ground_truth_samples=30000, seed=102, wall_time_limit_s=30.0),
    ContestSpec(width=100, depth=50, n_mlps=3, flop_budget=5_000_000_000, ground_truth_samples=20000, seed=103, wall_time_limit_s=30.0),
]

datas=[]
for s in specs:
    print('making', s.width, s.depth, s.n_mlps)
    datas.append(make_contest(s))

base = (submission._BUDGET_FRACTION, submission._SECOND_MEAN_STRENGTH, submission._SECOND_VARIANCE_STRENGTH)

def score(bf, ms, vs):
    submission._BUDGET_FRACTION=bf
    submission._SECOND_MEAN_STRENGTH=ms
    submission._SECOND_VARIANCE_STRENGTH=vs
    vals=[]
    mses=[]
    mults=[]
    fails=0
    for d in datas:
        r=evaluate_estimator(submission.Estimator(), d)
        vals.append(r['adjusted_final_layer_score'])
        mses.append(r['final_layer_mse'])
        mults.append(r['mean_score_multiplier'])
        fails += r['n_failed_mlps']
    return sum(vals)/len(vals), vals, sum(mses)/len(mses), sum(mults)/len(mults), fails

cands=[]
for ms in [-18,-16,-14.3,-13,-12,-10,-8,-5,0,0.5,1.0]:
    cands.append((0.23,ms,1.0))
for vs in [0.0,0.5,0.8,1.0,1.2,1.5]:
    cands.append((0.23,-14.3,vs))
for bf in [0.08,0.10,0.14,0.18,0.23,0.30,0.40,0.55,0.75]:
    cands.append((bf,-14.3,1.0))
seen=set()
rows=[]
for c in cands:
    if c in seen: continue
    seen.add(c)
    try:
        avg, vals, mse, mult, fails = score(*c)
        rows.append((avg,c,vals,mse,mult,fails))
        print('cand', c, 'avg', avg, 'vals', vals, 'mse', mse, 'mult', mult, 'fails', fails)
    except Exception as e:
        print('ERR', c, type(e).__name__, e)
rows.sort(key=lambda x:x[0])
print('best')
for row in rows[:10]:
    print(row[1], row[0], row[2], 'mse', row[3], 'mult', row[4], 'fails', row[5])
submission._BUDGET_FRACTION, submission._SECOND_MEAN_STRENGTH, submission._SECOND_VARIANCE_STRENGTH=base

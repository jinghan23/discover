/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
from math import pi

def relu_gauss_diag(mu,var):
    sig=np.sqrt(np.maximum(var,1e-30)); a=mu/sig; Phi=norm.cdf(a); phi=norm.pdf(a)
    m=mu*Phi+sig*phi
    e2=(mu*mu+var)*Phi+mu*sig*phi
    return m,np.maximum(e2-m*m,0),Phi

def exact_first(W0):
    K=W0.T@W0; diag=np.maximum(np.diag(K),1e-30); s=np.sqrt(diag)
    rho=np.clip(K/(s[:,None]*s[None,:]),-1,1)
    S=s[:,None]*s[None,:]*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
    m=s/np.sqrt(2*np.pi); C=S-np.outer(m,m)
    return m,C

def update_gauss_relu(mu_pre,cov_pre):
    var=np.maximum(np.diag(cov_pre),1e-30); sig=np.sqrt(var); a=mu_pre/sig
    Phi=norm.cdf(a); phi=norm.pdf(a)
    mu=mu_pre*Phi+sig*phi
    e2=(mu_pre*mu_pre+var)*Phi+mu_pre*sig*phi
    var_post=np.maximum(e2-mu*mu,0)
    C=np.outer(Phi,Phi)*cov_pre
    np.fill_diagonal(C,var_post)
    return mu,C

def initial_x(W0,k,seed):
    w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed)
    u=rng.standard_normal((n,w)).astype(np.float32)
    C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T
    z=u@(inv@W0)
    order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0)
    marg=norm.ppf((np.arange(n,dtype=np.float32)+.5)/n).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30))
    z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    return np.maximum(np.concatenate([z,-z],0),0)

def pred(Ws,k,seed,mode,gamma=1.0):
    x=initial_x(Ws[0],k,seed)
    if len(Ws)==1: return x.mean(0)
    mu,C=exact_first(Ws[0])
    for li,W in enumerate(Ws[1:], start=1):
        true_mu=mu@W
        true_cov=W.T@C@W
        true_var=np.maximum(np.diag(true_cov),1e-30)
        z=x@W
        do=False; g=0
        if mode=='second' and li==1: do=True; g=1
        elif mode=='all': do=True; g=gamma
        elif mode=='later_shrink': do=True; g=1 if li==1 else gamma
        if do:
            sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30)
            z_matched=(z-sm)*np.sqrt(true_var/sv)+true_mu
            z=(1-g)*z + g*z_matched
        x=np.maximum(z,0)
        mu,C=update_gauss_relu(true_mu,true_cov)
    return x.mean(0)

def target(Ws,N=300000,seed=999,batch=50000):
    w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); cnt+=batch
    return s/cnt
for w,d,k in [(64,6,4096),(128,6,4096),(64,16,4096),(128,16,4096),(64,32,4096),(64,6,8192)]:
 print('case',w,d,k)
 acc={}
 for seed in range(8):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]
  t=target(Ws,N=300000 if w==64 else 200000,seed=100+seed)
  configs=[('none','all',0.0),('second','second',1.0),('all1','all',1.0),('later05','later_shrink',0.5),('later025','later_shrink',0.25),('later01','later_shrink',0.1)]
  # none via gamma 0 all = no matching but still analytic update irrelevant
  for name,mode,g in configs:
    v=pred(Ws,k,seed+1,mode,g)
    acc.setdefault(name,[]).append(np.mean((v-t)**2))
 for name,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
  print(name,np.mean(vs))

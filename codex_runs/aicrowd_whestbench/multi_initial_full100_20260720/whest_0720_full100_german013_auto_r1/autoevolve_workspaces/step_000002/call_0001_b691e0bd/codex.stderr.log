import numpy as np
from scipy.stats import norm

def exact_first(W0):
 K=W0.T@W0; s=np.sqrt(np.maximum(np.diag(K),1e-30)); rho=np.clip(K/(s[:,None]*s[None,:]),-1,1)
 S=s[:,None]*s[None,:]*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
 m=s/np.sqrt(2*np.pi); return m,S-np.outer(m,m)

def init(W0,k,seed):
 w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32)
 C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; z=u@(inv@W0)
 order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0); marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32); scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30))
 z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0); return np.maximum(np.concatenate([z,-z],0),0)

def pred(Ws,k,seed,gamma):
 x=init(Ws[0],k,seed)
 if len(Ws)>1 and gamma"'!=0:
  m,C=exact_first(Ws[0]); W=Ws[1]; z=x@W; tm=m@W; tv=np.maximum(np.sum((C@W)*W,axis=0),1e-30); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); zm=(z-sm)*np.sqrt(tv/sv)+tm; z=(1-gamma)*z+gamma*zm; x=np.maximum(z,0); rest=Ws[2:]
 else: rest=Ws[1:]
 for W in rest: x=np.maximum(x@W,0)
 return x.mean(0)

def target(Ws,N=300000,seed=99,batch=50000):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
 for _ in range(N//batch):
  x=rng.standard_normal((batch,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); cnt+=batch
 return s/cnt
for w,d,k in [(64,6,4096),(128,6,4096),(64,16,4096),(128,16,4096),(64,32,4096),(64,6,8192)]:
 print('"'case',w,d,k); acc={}
 for seed in range(10):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]; t=target(Ws,N=300000 if w==64 else 200000,seed=seed+100)
  for g in [0,.25,.5,.75,1,1.25]:
   v=pred(Ws,k,seed+1,g); acc.setdefault(g,[]).append(np.mean((v-t)**2))
 for g,vs in sorted(acc.items(),key=lambda kv:np.mean(kv[1])): print(g,np.mean(vs))

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm

BUDGET=10**9
FRAC=.28

def sample_count(budget,w,d):
    per=d*(2*w*w+w)+w*w+48*w
    fixed=9*w**3+2*(2*w**3)
    k=(int(FRAC*budget)-fixed)//max(per,1)
    k=int(max(32,min(1_000_000,100*1024*1024//max(w*8,1),k)))
    return k-(k&1)

def relu_gauss_mean(mu,var):
    s=np.sqrt(np.maximum(var,1e-30)); a=mu/s
    return s*norm.pdf(a)+mu*norm.cdf(a)

def relu_gauss_second(mu,var):
    s=np.sqrt(np.maximum(var,1e-30)); a=mu/s
    return (mu*mu+var)*norm.cdf(a)+mu*s*norm.pdf(a)

def baseline(Ws,k,seed):
    w=Ws[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+.5)/half
    u=norm.ppf(probs).astype(np.float32)
    cov=(u.T@u)/half
    ev,Q=np.linalg.eigh(cov); ev=np.maximum(ev,1e-6)
    inv=(Q/np.sqrt(ev))@Q.T
    fp=u@(inv@Ws[0])
    ordering=np.argsort(fp,axis=0); invord=np.argsort(ordering,axis=0)
    marg=norm.ppf((np.arange(half,dtype=np.float32)+.5)/half).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30))
    sorted_m=marg[:,None]*scale[None,:]
    fp=np.take_along_axis(sorted_m,invord,axis=0)
    x=np.maximum(np.concatenate([fp,-fp],axis=0),0)
    for W in Ws[1:]:
        x=np.maximum(x@W,0)
    return x.mean(0)

def baseline_last_data(Ws,k,seed):
    w=Ws[0].shape[0]; half=k//2; rng=np.random.default_rng(seed)
    ranks=np.argsort(rng.random((half,w)),axis=0)
    probs=(ranks.astype(np.float32)+.5)/half
    u=norm.ppf(probs).astype(np.float32)
    cov=(u.T@u)/half
    ev,Q=np.linalg.eigh(cov); ev=np.maximum(ev,1e-6)
    inv=(Q/np.sqrt(ev))@Q.T
    fp=u@(inv@Ws[0])
    ordering=np.argsort(fp,axis=0); invord=np.argsort(ordering,axis=0)
    marg=norm.ppf((np.arange(half,dtype=np.float32)+.5)/half).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30))
    fp=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    x=np.maximum(np.concatenate([fp,-fp],axis=0),0)
    for W in Ws[1:-1]:
        x=np.maximum(x@W,0)
    z=x@Ws[-1]
    return z, np.maximum(z,0).mean(0)

def diag_moments(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w)
    var=np.ones(w)
    means=[]
    seconds=[]
    # input independent with mean 0, var1; for first z var=sum W"'^2
    m_act=np.zeros(w); v_act=np.ones(w) # actually input moments
    for W in Ws:
        z_mu=m_act@W
        z_var=v_act@(W*W)
        y_mu=relu_gauss_mean(z_mu,z_var)
        y_second=relu_gauss_second(z_mu,z_var)
        y_var=np.maximum(y_second-y_mu*y_mu,0)
        means.append(y_mu); seconds.append(y_second)
        m_act=y_mu; v_act=y_var
    return means, seconds

def target(Ws,N=2000000,seed=999,batch=200000):
    w=Ws[0].shape[0]
    s=np.zeros(w); cnt=0; rng=np.random.default_rng(seed)
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws:
            x=np.maximum(x@W,0)
        s += x.sum(0); cnt += batch
    return s/cnt

def eval_once(w,d,scale,k,N=500000,seed=0):
    rng=np.random.default_rng(seed)
    Ws=[rng.standard_normal((w,w)).astype(np.float32)*scale/np.sqrt(w) for _ in range(d)]
    t=target(Ws,N=N,seed=seed+123,batch=50000)
    z,s=baseline_last_data(Ws,k,seed+1)
    mu=z.mean(0); var=(z*z).mean(0)-mu*mu
    g=relu_gauss_mean(mu,var)
    dm,_=diag_moments(Ws)
    # final preact diag mean from prev act mean
    diag_z_mu=dm[-2]@Ws[-1] if d>1 else np.zeros(w)
    beta=(z>0).mean(0)
    ctrl=s + beta*(diag_z_mu-mu)
    ctrl05=s + 0.5*beta*(diag_z_mu-mu)
    vals={'"'sample':s,'gauss':g,'blend70':.7*s+.3*g,'blend95':.95*s+.05*g,'ctrl':ctrl,'ctrl05':ctrl05,'diag_final':dm[-1]}
    return {name:float(np.mean((v-t)**2)) for name,v in vals.items()}

for scale in [1.0, np.sqrt(2.0)]:
  print('scale',scale)
  acc={}
  for seed in range(5):
    r=eval_once(64,6,scale,k=4096,N=300000,seed=seed)
    for k0,v in r.items(): acc.setdefault(k0,[]).append(v)
  for k0,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
    print(k0, np.mean(vs), vs)

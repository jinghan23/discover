import numpy as np
from scipy.stats import norm

def meanprop(Ws,full=False):
    w=Ws[0].shape[0]; mu=np.zeros(w)
    if full:
        cov=np.eye(w)
    else:
        var=np.ones(w)
    rows=[]
    for W in Ws:
        if full:
            mu_pre=mu@W
            cov_pre=W.T@cov@W

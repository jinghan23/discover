# synthetic: first preactivation remap vs no remap, with second diag correction
import numpy as np
from scipy.stats import norm

def exact_first(W0):
 K=W0.T@W0; s=np.sqrt(np.maximum(np.diag(K),1e-30)); rho=np.clip(K/(s[:,None]*s[None,:]),-1,1); S=s[:,None]*s[None,:]*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi); m=s/np.sqrt(2*np.pi); return m,S-np.outer(m,m)
def init(W0,k,seed,remap):
 w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32); C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; z=u@(inv@W0)
 if remap:
  order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0); marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32); scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30)); z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
 return np.maximum(np.concatenate([z,-z],0),0)
def pred(Ws,k,seed,remap,gamma=.85):
 x=init(Ws[0],k,seed,remap); m,C=exact_first(Ws[0])
 if len(Ws)>1:
  W=Ws[1]; z=x@W; tm=m@W; tv=np.maximum(np.sum((C@W)*W,axis=0),1e-30); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); zm=(z-sm)*np.sqrt(tv/sv)+tm; z=z+gamma*(zm-z); x=np.maximum(z,0); rest=Ws[2:]
 else: rest=[]
 for W in rest: x=np.maximum(x@W,0)
 return x.mean(0)
def target(Ws,N=200000,seed=99,batch=50000):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
 for _ in range(N//batch):
  x=rng.standard_normal((batch,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); cnt+=batch
 return s/cnt
for case in [(64,32,4096),(128,16,4096),(128,6,4096),(64,6,8192)]:
 w,d,k=case; print('case',case); acc={}

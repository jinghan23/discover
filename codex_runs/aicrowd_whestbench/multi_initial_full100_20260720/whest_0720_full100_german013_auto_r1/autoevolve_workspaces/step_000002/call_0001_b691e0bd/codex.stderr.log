import numpy as np
from scipy.stats import norm

def exact_first(W0):
 K=W0.T@W0; s=np.sqrt(np.maximum(np.diag(K),1e-30)); rho=np.clip(K/(s[:,None]*s[None,:]),-1,1); S=s[:,None]*s[None,:]*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi); m=s/np.sqrt(2*np.pi); return m,S-np.outer(m,m)
def gaussian_z2(Ws,k,seed,remap=True):
 w=Ws[0].shape[0]; n=k//2; m,C=exact_first(Ws[0]); W=Ws[1]; mu=m@W; Cov=W.T@C@W; rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32); Cs=(u.T@u)/n; ev,Q=np.linalg.eigh(Cs); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; evT,QT=np.linalg.eigh(Cov); sqrtT=(QT*np.sqrt(np.maximum(evT,1e-12)))@QT.T; z=u@(inv@sqrtT)+mu
 if remap:
  order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0); marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32); scale=np.sqrt(np.maximum(np.diag(Cov),1e-30)); sorted_m=mu[None,:]+marg[:,None]*scale[None,:]; z=np.take_along_axis(sorted_m,invord,axis=0)
 z=np.concatenate([z,2*mu[None,:]-z],0)
 x=np.maximum(z,0)
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)
def baseline(Ws,k,seed,gamma=.85):
 # normal/remap/second diag
 w=Ws[0].shape[0]; n=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32); Cs=(u.T@u)/n; ev,Q=np.linalg.eigh(Cs); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; z=u@(inv@Ws[0]); order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0); marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32); scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30)); z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0); x=np.maximum(np.concatenate([z,-z],0),0); m,C=exact_first(Ws[0]); W=Ws[1]; z=x@W; tm=m@W; tv=np.maximum(np.sum((C@W)*W,axis=0),1e-30); sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); zm=(z-sm)*np.sqrt(tv/sv)+tm; z=z+gamma*(zm-z); x=np.maximum(z,0); 
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(Ws,N=200000,seed=99,batch=50000):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
 for _ in range(N//batch):
  x=rng.standard_normal((batch,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); cnt+=batch
 return s/cnt
for case in [(64,32,4096),(128,16,4096),(128,6,4096),(64,6,8192)]:
 w,d,k=case; print('case',case); acc={}
 for seed in range(8):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]; t=target(Ws,seed=100+seed,N=200000)

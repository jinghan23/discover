/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm

def make_z(W0,k,seed,source='normal',mode='base'):
    w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed)
    if source=='normal': u=rng.standard_normal((n,w)).astype(np.float32)
    else:
        ranks=np.argsort(rng.random((n,w)),axis=0)
        u=norm.ppf((ranks.astype(np.float32)+.5)/n).astype(np.float32)
    C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); ev=np.maximum(ev,1e-6); inv=(Q/np.sqrt(ev))@Q.T
    z=u@(inv@W0)
    marg=norm.ppf((np.arange(n,dtype=np.float32)+.5)/n).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30))
    def remap(a):
        order=np.argsort(a,axis=0); invord=np.argsort(order,axis=0)
        return np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    if mode=='noremap': return z
    z=remap(z)
    if mode=='base': return z
    K=W0.T@W0
    if mode in ('linear_after','iter1','iter2'):
        C=(z.T@z)/n; ev,Q=np.linalg.eigh(C); ev=np.maximum(ev,1e-6); invC=(Q/np.sqrt(ev))@Q.T
        evK,QK=np.linalg.eigh(K); evK=np.maximum(evK,1e-12); sqrtK=(QK*np.sqrt(evK))@QK.T
        z=z@(invC@sqrtK)
        if mode=='linear_after': return z
        z=remap(z)
    if mode=='iter2':
        C=(z.T@z)/n; ev,Q=np.linalg.eigh(C); ev=np.maximum(ev,1e-6); invC=(Q/np.sqrt(ev))@Q.T
        evK,QK=np.linalg.eigh(K); evK=np.maximum(evK,1e-12); sqrtK=(QK*np.sqrt(evK))@QK.T
        z=z@(invC@sqrtK); z=remap(z)
    return z

def pred(Ws,k,seed,source,mode):
    z=make_z(Ws[0],k,seed,source,mode)
    x=np.maximum(np.concatenate([z,-z],0),0)
    for W in Ws[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def target(Ws,N=300000,seed=999,batch=50000):
    w=Ws[0].shape[0]; s=np.zeros(w); rng=np.random.default_rng(seed); cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); cnt+=batch
    return s/cnt

for w,d,k in [(64,6,4096),(128,6,4096),(64,10,4096),(64,6,8192)]:
    print('case',w,d,k)
    acc={}
    modes=['noremap','base','linear_after','iter1','iter2']
    for seed in range(5):
        rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)/np.sqrt(w) for _ in range(d)]
        t=target(Ws,seed=seed+100)
        for source in ['normal','lhs']:
          for mode in modes:
            v=pred(Ws,k,seed+1,source,mode)
            acc.setdefault(source+'_'+mode,[]).append(np.mean((v-t)**2))
    for name,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
        print(name,np.mean(vs))

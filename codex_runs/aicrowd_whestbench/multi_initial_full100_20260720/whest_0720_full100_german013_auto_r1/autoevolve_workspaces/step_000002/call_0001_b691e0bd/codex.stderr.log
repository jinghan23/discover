  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]; t=target(Ws,seed=100+seed,N=200000)
  for remap in [False,True]:
   v=pred(Ws,k,seed+1,remap); acc.setdefault(remap,[]).append(np.mean((v-t)**2))
 for name,vs in sorted(acc.items(),key=lambda kv:np.mean(kv[1])): print(name,np.mean(vs))

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
from math import pi

def exact_first_moments(W0):
    K=W0.T@W0
    diag=np.maximum(np.diag(K),1e-30); s=np.sqrt(diag)
    rho=K/(s[:,None]*s[None,:]); rho=np.clip(rho,-1,1)
    S=(s[:,None]*s[None,:])*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
    m=s/np.sqrt(2*np.pi)
    C=S-np.outer(m,m)
    return m,C

def initial_z(W0,k,seed):
    w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed)
    u=rng.standard_normal((n,w)).astype(np.float32)
    C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); ev=np.maximum(ev,1e-6); inv=(Q/np.sqrt(ev))@Q.T
    fp=u@(inv@W0)
    order=np.argsort(fp,axis=0); invord=np.argsort(order,axis=0)
    marg=norm.ppf((np.arange(n,dtype=np.float32)+.5)/n).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30))
    fp=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    return np.maximum(np.concatenate([fp,-fp],axis=0),0)

def pred(Ws,k,seed,mode):
    x=initial_z(Ws[0],k,seed)
    if len(Ws)==1: return x.mean(0)
    if mode=='none':
        for W in Ws[1:]: x=np.maximum(x@W,0)
        return x.mean(0)
    m1,C1=exact_first_moments(Ws[0])
    W=Ws[1]
    z=x@W
    true_mu=m1@W
    CW=C1@W
    true_var=np.maximum(np.sum(CW*W,axis=0),1e-30)
    if mode=='diag2':
        sm=z.mean(0); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30)
        z=(z-sm)*np.sqrt(true_var/sv)+true_mu
    elif mode=='mean2':
        sm=z.mean(0); z=z-sm+true_mu
    elif mode=='full2':
        sm=z.mean(0); Z=z-sm
        Cs=(Z.T@Z)/z.shape[0]
        ev,Q=np.linalg.eigh(Cs); ev=np.maximum(ev,1e-6); inv=(Q/np.sqrt(ev))@Q.T
        Ct=W.T@C1@W
        evT,QT=np.linalg.eigh(Ct); evT=np.maximum(evT,1e-12); sqrtT=(QT*np.sqrt(evT))@QT.T
        z=Z@(inv@sqrtT)+true_mu
    x=np.maximum(z,0)
    for W in Ws[2:]: x=np.maximum(x@W,0)
    return x.mean(0)

def target(Ws,N=300000,seed=999,batch=50000):
    w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); cnt+=batch
    return s/cnt
for w,d,k in [(64,6,4096),(128,6,4096),(64,16,4096),(128,16,4096),(64,32,4096),(64,6,8192)]:
 print('case',w,d,k)
 acc={}
 for seed in range(10):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]
  t=target(Ws,N=300000 if w==64 else 200000,seed=100+seed)
  for mode in ['none','mean2','diag2','full2']:
    v=pred(Ws,k,seed+1,mode)
    acc.setdefault(mode,[]).append(np.mean((v-t)**2))
 for name,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
  print(name,np.mean(vs))

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm

def base(Ws,k,seed,ant=True,reorder=True,source='lhs'):
    w=Ws[0].shape[0]; n=k//2 if ant else k; rng=np.random.default_rng(seed)
    if source=='lhs':
        ranks=np.argsort(rng.random((n,w)),axis=0)
        probs=(ranks.astype(np.float32)+.5)/n
        u=norm.ppf(probs).astype(np.float32)
    elif source=='normal':
        u=rng.standard_normal((n,w)).astype(np.float32)
    cov=(u.T@u)/n
    ev,Q=np.linalg.eigh(cov); ev=np.maximum(ev,1e-6)
    inv=(Q/np.sqrt(ev))@Q.T
    fp=u@(inv@Ws[0])
    if reorder:
        ordering=np.argsort(fp,axis=0); invord=np.argsort(ordering,axis=0)
        marg=norm.ppf((np.arange(n,dtype=np.float32)+.5)/n).astype(np.float32)
        scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30))
        fp=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    if ant:
        fp=np.concatenate([fp,-fp],axis=0)
    x=np.maximum(fp,0)
    for W in Ws[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def target(Ws,N=1000000,seed=999,batch=100000):
    w=Ws[0].shape[0]; s=np.zeros(w); rng=np.random.default_rng(seed); cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); cnt+=batch
    return s/cnt

for w,d,k in [(64,6,4096),(128,6,4096),(64,10,4096),(64,6,8192)]:
  print('case',w,d,k)
  acc={}
  for seed in range(10):
    rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)/np.sqrt(w) for _ in range(d)]
    t=target(Ws,N=300000,seed=seed+100,batch=50000)
    for name,ant,reorder,source in [
      ('lhs_ant_reorder',1,1,'lhs'),('lhs_full_reorder',0,1,'lhs'),('lhs_ant_noreorder',1,0,'lhs'),('lhs_full_noreorder',0,0,'lhs'),('norm_ant_reorder',1,1,'normal'),('norm_ant_noreorder',1,0,'normal')]:
      pred=base(Ws,k,seed+1,ant=ant,reorder=reorder,source=source)
      acc.setdefault(name,[]).append(np.mean((pred-t)**2))
  for name,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
    print(name, np.mean(vs))

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm

def gen_u(n,w,seed,mode):
    rng=np.random.default_rng(seed)
    if mode=='lhs':
        ranks=np.argsort(rng.random((n,w)),axis=0)
        p=(ranks.astype(np.float64)+.5)/n
    elif mode=='normal':
        return rng.standard_normal((n,w)).astype(np.float32)
    elif mode=='lattice_rand':
        a=rng.integers(1,n,size=w)
        # make odd for power2
        a=2*(a//2)+1
        shift=rng.random(w)
        i=np.arange(n)[:,None]
        p=((i+0.5)*a[None,:]/n + shift[None,:])%1.0
    elif mode=='lattice_kor':
        base=int(rng.integers(1,n))|1
        a=np.empty(w,dtype=np.int64); v=1
        for j in range(w):
            a[j]=v; v=(v*base)%n; v|=1
        shift=rng.random(w); i=np.arange(n)[:,None]
        p=((i+0.5)*a[None,:]/n + shift[None,:])%1.0
    elif mode=='addrec':
        alpha=(np.sqrt(np.arange(2,w+2))-np.floor(np.sqrt(np.arange(2,w+2))))
        shift=rng.random(w); i=np.arange(n)[:,None]
        p=((i+0.5)*alpha[None,:] + shift[None,:])%1.0
        p=(np.floor(p*n)+.5)/n
    return norm.ppf(p).astype(np.float32)

def pred(Ws,k,seed,mode):
    w=Ws[0].shape[0]; n=k//2; u=gen_u(n,w,seed,mode)
    C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); ev=np.maximum(ev,1e-6); inv=(Q/np.sqrt(ev))@Q.T
    z=u@(inv@Ws[0])
    order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0)
    marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32)
    scale=np.sqrt(np.maximum(np.sum(Ws[0]*Ws[0],axis=0),1e-30))
    z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0)
    x=np.maximum(np.concatenate([z,-z],0),0)
    for W in Ws[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def target(Ws,N=300000,seed=999,batch=50000):
    w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); cnt+=batch
    return s/cnt

for w,d,k in [(64,6,4096),(128,6,4096),(64,10,4096),(64,6,8192)]:
 print('case',w,d,k)
 acc={}
 for seed in range(10):
    rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)/np.sqrt(w) for _ in range(d)]
    t=target(Ws,seed=100+seed)
    for mode in ['normal','lhs','lattice_rand','lattice_kor','addrec']:
        try:
            v=pred(Ws,k,seed+1,mode)
            acc.setdefault(mode,[]).append(np.mean((v-t)**2))
        except Exception as e:
            print('err',mode,e)
 for name,vs in sorted(acc.items(), key=lambda kv:np.mean(kv[1])):
    print(name,np.mean(vs))

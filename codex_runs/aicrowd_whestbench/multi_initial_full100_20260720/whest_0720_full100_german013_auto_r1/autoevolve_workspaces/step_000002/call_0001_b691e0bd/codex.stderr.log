/bin/bash -lc "python - <<'PY'
# quick existing synthetic from prior showed full gamma=1 mixed; test full gamma grid on fewer cases
import numpy as np
from scipy.stats import norm

def exact_first(W0):
 K=W0.T@W0; s=np.sqrt(np.maximum(np.diag(K),1e-30)); rho=np.clip(K/(s[:,None]*s[None,:]),-1,1); S=s[:,None]*s[None,:]*(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi); m=s/np.sqrt(2*np.pi); return m,S-np.outer(m,m)
def init(W0,k,seed):
 w=W0.shape[0]; n=k//2; rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32); C=(u.T@u)/n; ev,Q=np.linalg.eigh(C); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; z=u@(inv@W0); order=np.argsort(z,axis=0); invord=np.argsort(order,axis=0); marg=norm.ppf((np.arange(n)+.5)/n).astype(np.float32); scale=np.sqrt(np.maximum(np.sum(W0*W0,axis=0),1e-30)); z=np.take_along_axis(marg[:,None]*scale[None,:],invord,axis=0); return np.maximum(np.concatenate([z,-z],0),0)
def pred(Ws,k,seed,gamma,full):
 x=init(Ws[0],k,seed)
 if len(Ws)>1 and gamma"'!=0:
  m,C=exact_first(Ws[0]); W=Ws[1]; z=x@W; tm=m@W; sm=z.mean(0); centered=z-sm
  if full:
   Cs=(centered.T@centered)/z.shape[0]; ev,Q=np.linalg.eigh(Cs); inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T; Ct=W.T@C@W; evT,QT=np.linalg.eigh(Ct); sqrtT=(QT*np.sqrt(np.maximum(evT,1e-12)))@QT.T; matched=centered@(inv@sqrtT)+tm
  else:
   tv=np.maximum(np.sum((C@W)*W,axis=0),1e-30); sv=np.maximum((z*z).mean(0)-sm*sm,1e-30); matched=centered*np.sqrt(tv/sv)+tm
  z=z+gamma*(matched-z); x=np.maximum(z,0); rest=Ws[2:]
 else: rest=Ws[1:]
 for W in rest: x=np.maximum(x@W,0)
 return x.mean(0)
def target(Ws,N=200000,seed=99,batch=50000):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); cnt=0
 for _ in range(N//batch):

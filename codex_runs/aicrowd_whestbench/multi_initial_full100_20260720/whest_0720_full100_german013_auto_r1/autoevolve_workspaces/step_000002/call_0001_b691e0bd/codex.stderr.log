        else:
            mu_pre=mu@W
            var_pre=np.maximum(var@(W*W),1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; Phi=norm.cdf(a); phi=norm.pdf(a)
        mu_post=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var_post=np.maximum(ez2-mu_post*mu_post,0)
        if full:
            gain=np.where(sig>1e-12,Phi,0)
            cov=np.outer(gain,gain)*cov_pre
            np.fill_diagonal(cov,var_post)
        else:
            var=var_post
        mu=mu_post; rows.append(mu)
    return np.stack(rows)

def target(Ws,N=500000,seed=999,batch=50000):
    w=Ws[0].shape[0]; rng=np.random.default_rng(seed); sums=[np.zeros(w) for _ in Ws]; cnt=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,w)).astype(np.float32)
        for i,W in enumerate(Ws):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(0)
        cnt+=batch
    return np.stack([s/cnt for s in sums])
for w,d,N in [(64,6,300000),(64,16,300000),(128,16,200000),(64,32,200000)]:
 print('case',w,d)
 acc={}
 for seed in range(5):
  rng=np.random.default_rng(seed); Ws=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]
  t=target(Ws,N=N,seed=seed+100)
  for name,full in [('diag',False),('full',True)]:
    p=meanprop(Ws,full)
    acc.setdefault(name,[]).append(np.mean((p[-1]-t[-1])**2))
 for name,vs in acc.items(): print(name,np.mean(vs),vs)

# Local budget-fraction sweep using the incumbent algorithm.
from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
_INV_SQRT_TWO_PI=0.3989422804014327; _INV_TWO_PI=0.15915494309189535
_MIN_SAMPLES=32; _MAX_SAMPLES=1_000_000; _ARRAY_BYTES_LIMIT=100*1024*1024; _WORST_CASE_ITEMSIZE=8

def sample_count(budget,width,depth,bf):
 p=depth*(2*width*width+width)+width*width+48*width; fixed=13*width**3
 k=(int(bf*budget)-fixed)//max(p,1); max_k=_ARRAY_BYTES_LIMIT//max(width*_WORST_CASE_ITEMSIZE,1)
 k=int(max(_MIN_SAMPLES,min(_MAX_SAMPLES,max_k,k))); return k-(k&1)

def match_second(x,w0,w1):
 gram=w0.T@w0; fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv); den=fs[:,None]*fs[None,:]
 corr=fnp.clip(gram/den,-1,1); rs=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*_INV_TWO_PI
 rm=fs*_INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]
 z=x@w1; tm=rm@w1; ctw=rc@w1; tv=fnp.maximum(fnp.sum(ctw*w1,axis=0),1e-30)
 sm=fnp.mean(z,axis=0); ss=fnp.mean(z*z,axis=0); sv=fnp.maximum(ss-sm*sm,1e-30)
 scale=fnp.sqrt(tv/sv); mm=16*sm-15*tm
 return fnp.maximum((z-sm)*scale+mm,0)
class E(BaseEstimator):
 def __init__(self,bf): self.bf=bf
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth; weights=mlp.weights
  k=sample_count(budget,width,depth,self.bf); half=k//2; rng=fnp.random.default_rng(mlp.seed)
  u=rng.standard_normal((half,width)).astype(fnp.float32); cov=(u.T@u)/float(half)
  if half>width+1:
   ch=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(ch.T,weights[0])
  else:
   vals,vecs=fnp.linalg.eigh(cov); vals=fnp.maximum(vals,1e-6); wt=((vecs/fnp.sqrt(vals))@vecs.T)@weights[0]
  fp=u@wt; ord=fnp.argsort(fp,axis=0); probs=(fnp.arange(half,dtype=fnp.float32)+0.5)/float(half)
  q=flops.stats.norm.ppf(probs).astype(fnp.float32); fs=fnp.sqrt(fnp.maximum(fnp.sum(weights[0]*weights[0],axis=0),1e-30))
  sorted_m=q[:,None]*fs[None,:]; trans=fnp.empty_like(fp); fnp.put_along_axis(trans,ord,sorted_m,axis=0)
  x=fnp.maximum(fnp.concatenate([trans,-trans],axis=0),0); x=match_second(x,weights[0],weights[1])
  for w in weights[2:]: x=fnp.maximum(x@w,0)
  fm=fnp.mean(x,axis=0); return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fm[None,:]],axis=0)

spec=ContestSpec(width=256,depth=32,n_mlps=4,flop_budget=272_000_000_000,ground_truth_samples=100_000,seed=444)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))
for bf in [0.10,0.12,0.15,0.18,0.20,0.23,0.26,0.30,0.36,0.45,0.60,0.80]:
 res=evaluate_estimator(E(bf),data)
 print('bf',bf,'k',sample_count(spec.flop_budget,256,32,bf),'score',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'],'fail',res['n_failed_mlps'])

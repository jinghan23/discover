/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest
from whestbench.loader import load_estimator_from_path
from pathlib import Path
import flopscope.numpy as fnp
import flopscope as flops
import time
spec=ContestSpec(width=256,depth=32,n_mlps=5,flop_budget=272_000_000_000,ground_truth_samples=150_000,seed=888)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))
est,_=load_estimator_from_path(Path('submission.py'))
ps=[]; ts=[]
for mlp,target in zip(data.mlps,data.final_targets):
    with flops.BudgetContext(flop_budget=spec.flop_budget, quiet=True):
        p=est.predict(mlp,spec.flop_budget)[-1]
    ps.append(p); ts.append(target)
p=fnp.concatenate(ps); t=fnp.concatenate(ts)
for c in [0.96,0.98,0.99,0.995,1.0,1.005,1.01,1.02,1.04]:
    print('c',c,'mse',float(fnp.mean((p*c-t)**2)))
print('opt',float(fnp.sum(p*t)/fnp.sum(p*p)))
print('mean p',float(fnp.mean(p)),'mean t',float(fnp.mean(t)),'ratio',float(fnp.mean(t)/fnp.mean(p)))
PY" in /opt/tiger/discover/workspace

I’m going back to algorithmic variance reduction. One candidate is a second-layer marginal transport: after matching exact second preactivation mean/variance, replace each column’s empirical marginal with stratified Gaussian quantiles before ReLU. I’ll test this locally first because it adds a sort.
exec
/bin/bash -lc "python - <<'PY'
# Quick local test: second-layer Gaussian marginal transport after moment matching.
from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
_INV_SQRT_TWO_PI=0.3989422804014327; _INV_TWO_PI=0.15915494309189535

def sample_count(budget,w,d):
 p=d*(2*w*w+w)+w*w+48*w; fixed=13*w**3; k=(int(.23*budget)-fixed)//p; k=int(max(32,min(1_000_000,100*1024*1024//(w*8),k))); return k-(k&1)
def exact_second_stats(w0,w1):
 gram=w0.T@w0; fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv); den=fs[:,None]*fs[None,:]
 corr=fnp.clip(gram/den,-1,1); rs=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*_INV_TWO_PI
 rm=fs*_INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]
 tm=rm@w1; tv=fnp.maximum(fnp.sum((rc@w1)*w1,axis=0),1e-30)
 return tm,tv
class E(BaseEstimator):
 def __init__(self,transport=False): self.transport=transport
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth; weights=mlp.weights; half=sample_count(budget,width,depth)//2; rng=fnp.random.default_rng(mlp.seed)
  u=rng.standard_normal((half,width)).astype(fnp.float32); cov=(u.T@u)/float(half); ch=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(ch.T,weights[0])
  fp=u@wt; order=fnp.argsort(fp,axis=0); probs=(fnp.arange(half,dtype=fnp.float32)+.5)/float(half); q=flops.stats.norm.ppf(probs).astype(fnp.float32)
  fs=fnp.sqrt(fnp.maximum(fnp.sum(weights[0]*weights[0],axis=0),1e-30)); sorted_m=q[:,None]*fs[None,:]; trans=fnp.empty_like(fp); fnp.put_along_axis(trans,order,sorted_m,axis=0)
  x=fnp.maximum(fnp.concatenate([trans,-trans],axis=0),0)
  z=x@weights[1]; tm,tv=exact_second_stats(weights[0],weights[1])
  sm=fnp.mean(z,axis=0); sv=fnp.maximum(fnp.mean(z*z,axis=0)-sm*sm,1e-30)
  z=(z-sm)*fnp.sqrt(tv/sv)+(16*sm-15*tm)
  if self.transport:
    n=z.shape[0]
    order2=fnp.argsort(z,axis=0)
    probs2=(fnp.arange(n,dtype=fnp.float32)+.5)/float(n)
    q2=flops.stats.norm.ppf(probs2).astype(fnp.float32)
    sorted2=q2[:,None]*fnp.sqrt(tv)[None,:]+((16*sm-15*tm))[None,:]
    zt=fnp.empty_like(z); fnp.put_along_axis(zt,order2,sorted2,axis=0); z=zt
  x=fnp.maximum(z,0)
  for weight in weights[2:]: x=fnp.maximum(x@weight,0)
  fm=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fm[None,:]],axis=0)

spec=ContestSpec(width=256,depth=32,n_mlps=4,flop_budget=272_000_000_000,ground_truth_samples=120_000,seed=999)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))
for tr in [False,True]:
 res=evaluate_estimator(E(tr),data); print('transport',tr,'score',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'])

from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
_INV_SQRT_TWO_PI=0.3989422804014327; _INV_TWO_PI=0.15915494309189535
_BF=.23; _MS=-15.; _VS=1.; _MIN=32; _MAX=1_000_000; _BYTES=100*1024*1024; _ITEM=8

def sc(b,w,d):
 p=d*(2*w*w+w)+w*w+48*w; fixed=13*w**3
 k=(int(_BF*b)-fixed)//p; k=int(max(_MIN,min(_MAX,_BYTES//(w*_ITEM),k))); return k-(k&1)
def match(x,w0,w1):
 gram=w0.T@w0; fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv); den=fs[:,None]*fs[None,:]
 corr=fnp.clip(gram/den,-1,1); rs=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*_INV_TWO_PI
 rm=fs*_INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]
 z=x@w1; tm=rm@w1; tv=fnp.maximum(fnp.sum((rc@w1)*w1,axis=0),1e-30)
 sm=fnp.mean(z,axis=0); sv=fnp.maximum(fnp.mean(z*z,axis=0)-sm*sm,1e-30)
 return fnp.maximum((z-sm)*fnp.sqrt(tv/sv)+(16*sm-15*tm),0)
class E(BaseEstimator):
 def __init__(self,off): self.off=off
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; weights=mlp.weights; k=sc(budget,w,d); half=k//2
  rng=fnp.random.default_rng(int(mlp.seed)+self.off)
  u=rng.standard_normal((half,w)).astype(fnp.float32); cov=(u.T@u)/float(half)
  ch=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(ch.T,weights[0])
  fp=u@wt; order=fnp.argsort(fp,axis=0); probs=(fnp.arange(half,dtype=fnp.float32)+.5)/float(half)
  q=flops.stats.norm.ppf(probs).astype(fnp.float32); fs=fnp.sqrt(fnp.maximum(fnp.sum(weights[0]*weights[0],axis=0),1e-30))
  sm=q[:,None]*fs[None,:]; trans=fnp.empty_like(fp); fnp.put_along_axis(trans,order,sm,axis=0)
  x=fnp.maximum(fnp.concatenate([trans,-trans],axis=0),0); x=match(x,weights[0],weights[1])
  for weight in weights[2:]: x=fnp.maximum(x@weight,0)
  fm=fnp.mean(x,axis=0); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fm[None,:]],axis=0)

spec=ContestSpec(width=256,depth=32,n_mlps=4,flop_budget=272_000_000_000,ground_truth_samples=120_000,seed=777)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))
for off in [0,1,2,3,4,5,7,11,17,31,101,1009,10007,1234567]:
 res=evaluate_estimator(E(off),data)
 print('off',off,'score',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'])

import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
_INV_SQRT_TWO_PI=0.3989422804014327; _INV_TWO_PI=0.15915494309189535

def kcnt(b,w,d):
 p=d*(2*w*w+w)+w*w+48*w; fixed=13*w**3; k=(int(.23*b)-fixed)//p; k=int(max(32,min(1_000_000,100*1024*1024//(w*8),k))); return k-(k&1)
def relu_mom(mu,var):
 var=fnp.maximum(var,1e-30); sig=fnp.sqrt(var); a=mu/sig; Phi=flops.stats.norm.cdf(a); phi=flops.stats.norm.pdf(a); m=mu*Phi+sig*phi; ez2=(mu*mu+var)*Phi+mu*sig*phi; v=fnp.maximum(ez2-m*m,1e-30); return m,v
def first_second_stats(w0,w1):
 gram=w0.T@w0; fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv); den=fs[:,None]*fs[None,:]
 corr=fnp.clip(gram/den,-1,1); rs=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*_INV_TWO_PI
 rm=fs*_INV_SQRT_TWO_PI; r2=fv*0.5; rv=fnp.maximum(r2-rm*rm,1e-30); rc=rs-rm[:,None]*rm[None,:]
 tm=rm@w1; tv=fnp.maximum(fnp.sum((rc@w1)*w1,axis=0),1e-30); return rm,rv,tm,tv
def make_first(mlp,budget):
 w=mlp.width; d=mlp.depth; weights=mlp.weights; half=kcnt(budget,w,d)//2; rng=fnp.random.default_rng(mlp.seed)
 u=rng.standard_normal((half,w)).astype(fnp.float32); cov=(u.T@u)/float(half); ch=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(ch.T,weights[0]); fp=u@wt
 order=fnp.argsort(fp,axis=0); probs=(fnp.arange(half,dtype=fnp.float32)+.5)/float(half); q=flops.stats.norm.ppf(probs).astype(fnp.float32)
 fs=fnp.sqrt(fnp.maximum(fnp.sum(weights[0]*weights[0],axis=0),1e-30)); sorted_m=q[:,None]*fs[None,:]; trans=fnp.empty_like(fp); fnp.put_along_axis(trans,order,sorted_m,axis=0)
 return fnp.maximum(fnp.concatenate([trans,-trans],axis=0),0)
class E(BaseEstimator):
 def __init__(self,sm=0.0,sv=0.0): self.sm=sm; self.sv=sv
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; weights=mlp.weights; x=make_first(mlp,budget); rm,rv,tm,tv=first_second_stats(weights[0],weights[1])
  z=x@weights[1]; smp=fnp.mean(z,axis=0); svp=fnp.maximum(fnp.mean(z*z,axis=0)-smp*smp,1e-30); x=fnp.maximum((z-smp)*fnp.sqrt(tv/svp)+(16*smp-15*tm),0)
  mu,var=relu_mom(tm,tv)
  for ww in weights[2:]:
   z=x@ww
   if self.sm or self.sv:
    tm2=mu@ww; tv2=fnp.maximum(var@(ww*ww),1e-30)
    smp=fnp.mean(z,axis=0); svp=fnp.maximum(fnp.mean(z*z,axis=0)-smp*smp,1e-30)
    scale=1+self.sv*(fnp.sqrt(tv2/svp)-1); mean=(1-self.sm)*smp+self.sm*tm2
    z=(z-smp)*scale+mean
    mu,var=relu_mom(tm2,tv2)
   x=fnp.maximum(z,0)
   if not (self.sm or self.sv):
    pass
  fm=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fm[None,:]],axis=0)

spec=ContestSpec(width=256,depth=32,n_mlps=3,flop_budget=272_000_000_000,ground_truth_samples=120_000,seed=1008)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))
for sm,sv in [(0,0),(0.02,0),(0.05,0),(0.1,0),(0,0.05),(0,0.1),(0.02,0.05),(-0.02,0),(-0.05,0)]:
 res=evaluate_estimator(E(sm,sv),data); print('sm',sm,'sv',sv,'score',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'])

codex
I’m testing another sampler structure locally: split the same total sample budget into two independent antithetic, whitened blocks and concatenate them. This may reduce seed-specific copula artifacts while preserving the total forward rows.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
_INV_SQRT_TWO_PI=0.3989422804014327; _INV_TWO_PI=0.15915494309189535

def kcnt(b,w,d):
 p=d*(2*w*w+w)+w*w+48*w; fixed=13*w**3; k=(int(.23*b)-fixed)//p; k=int(max(32,min(1_000_000,100*1024*1024//(w*8),k))); return k-(k&1)
def first_block(seed,n,w0):
 width=w0.shape[0]; rng=fnp.random.default_rng(seed); u=rng.standard_normal((n,width)).astype(fnp.float32); cov=(u.T@u)/float(n)
 ch=fnp.linalg.cholesky(cov); wt=fnp.linalg.solve(ch.T,w0); fp=u@wt; order=fnp.argsort(fp,axis=0); probs=(fnp.arange(n,dtype=fnp.float32)+.5)/float(n); q=flops.stats.norm.ppf(probs).astype(fnp.float32)
 fs=fnp.sqrt(fnp.maximum(fnp.sum(w0*w0,axis=0),1e-30)); sm=q[:,None]*fs[None,:]; trans=fnp.empty_like(fp); fnp.put_along_axis(trans,order,sm,axis=0); return trans
def match(x,w0,w1):
 gram=w0.T@w0; fv=fnp.maximum(fnp.diag(gram),1e-30); fs=fnp.sqrt(fv); den=fs[:,None]*fs[None,:]
 corr=fnp.clip(gram/den,-1,1); rs=den*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(float(fnp.pi)-fnp.arccos(corr))*corr)*_INV_TWO_PI
 rm=fs*_INV_SQRT_TWO_PI; rc=rs-rm[:,None]*rm[None,:]; z=x@w1; tm=rm@w1; tv=fnp.maximum(fnp.sum((rc@w1)*w1,axis=0),1e-30)
 sm=fnp.mean(z,axis=0); sv=fnp.maximum(fnp.mean(z*z,axis=0)-sm*sm,1e-30); return fnp.maximum((z-sm)*fnp.sqrt(tv/sv)+(16*sm-15*tm),0)
class E(BaseEstimator):
 def __init__(self,m=1,offs=(0,)): self.m=m; self.offs=offs
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth; weights=mlp.weights; half=kcnt(budget,width,depth)//2
  if self.m==1:
   trans=first_block(mlp.seed,half,weights[0]); first=fnp.concatenate([trans,-trans],axis=0)
  else:
   n=(half//self.m); n-=n&1
   blocks=[]
   for i in range(self.m):
    trans=first_block(int(mlp.seed)+self.offs[i],n,weights[0]); blocks.append(trans); blocks.append(-trans)
   first=fnp.concatenate(blocks,axis=0)
  x=fnp.maximum(first,0); x=match(x,weights[0],weights[1])
  for ww in weights[2:]: x=fnp.maximum(x@ww,0)
  fm=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32); return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fm[None,:]],axis=0)

spec=ContestSpec(width=256,depth=32,n_mlps=4,flop_budget=272_000_000_000,ground_truth_samples=120_000,seed=1003)
t=time.time(); data=make_contest(spec); print('made',round(time.time()-t,1))

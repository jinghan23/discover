+def _is_prime(n: int) -> bool:
+    if n < 2:
+        return False
+    if n % 2 == 0:
+        return n == 2
+    d = 3
+    while d * d <= n:
+        if n % d == 0:
+            return False
+        d += 2
+    return True
+
+
+def _previous_prime(n: int) -> int:
+    n = max(2, int(n))
+    while not _is_prime(n):
+        n -= 1
+    return n
+
+
+def _factor_unique(n: int):
+    factors = []
+    d = 2
+    while d * d <= n:
+        if n % d == 0:
+            factors.append(d)
+            while n % d == 0:
+                n //= d
+        d += 1 if d == 2 else 2
+    if n > 1:
+        factors.append(n)
+    return factors
+
+
+def _primitive_root(p: int) -> int:
+    if p == 2:
+        return 1
+    factors = _factor_unique(p - 1)
+    g = 2
+    while True:

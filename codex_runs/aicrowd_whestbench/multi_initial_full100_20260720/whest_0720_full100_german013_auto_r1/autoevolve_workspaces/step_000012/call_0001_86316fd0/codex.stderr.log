@@ -14,8 +14,9 @@
 _INV_SQRT_TWO_PI = 0.3989422804014327
 _INV_TWO_PI = 0.15915494309189535
 _SECOND_MEAN_STRENGTH = -16.00
-_SECOND_VARIANCE_STRENGTH = 1.075
+_SECOND_VARIANCE_STRENGTH = 1.175
 _FIRST_TRANSPORT_BLEND = 0.006
+_DIAG_BLEND = 0.020
 
 
 def _column_norm(weight):
@@ -74,6 +75,28 @@
     return fnp.maximum(z, 0.0)
 
 
+def _diag_gaussian_final_mean(weights):
+    mean = None
+    variance = None
+    for i, weight in enumerate(weights):
+        weight_stats = fnp.asarray(weight, dtype=fnp.float64)
+        if i == 0:
+            pre_mean = fnp.zeros(weight.shape[1], dtype=fnp.float64)
+            pre_variance = fnp.maximum(fnp.sum(weight_stats * weight_stats, axis=0), 1e-30)
+        else:
+            pre_mean = mean @ weight_stats
+            pre_variance = fnp.maximum(variance @ (weight_stats * weight_stats), 1e-30)
+
+        scale = fnp.sqrt(pre_variance)
+        alpha = pre_mean / scale
+        cdf = flops.stats.norm.cdf(alpha)
+        density = fnp.exp(-0.5 * alpha * alpha) * _INV_SQRT_TWO_PI
+        mean = scale * density + pre_mean * cdf
+        second = (pre_variance + pre_mean * pre_mean) * cdf + pre_mean * scale * density
+        variance = fnp.maximum(second - mean * mean, 1e-30)
+    return fnp.asarray(mean, dtype=fnp.float32)
+
+
 class Estimator(BaseEstimator):
     def predict(self, mlp, budget):
         width = mlp.width
@@ -123,5 +146,7 @@
         final_mean = fnp.asarray(
             fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0), dtype=fnp.float32
         )
+        diag_mean = _diag_gaussian_final_mean(weights)
+        final_mean = final_mean + _DIAG_BLEND * (diag_mean - final_mean)
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


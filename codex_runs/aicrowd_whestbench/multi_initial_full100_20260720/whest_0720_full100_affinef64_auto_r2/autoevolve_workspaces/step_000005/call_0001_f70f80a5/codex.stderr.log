    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)*0.9999375

def true_mean(weights,n,seed,chunk=20000):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
    while done<n:

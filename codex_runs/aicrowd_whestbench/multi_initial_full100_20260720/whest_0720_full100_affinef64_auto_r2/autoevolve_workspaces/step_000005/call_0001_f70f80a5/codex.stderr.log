import numpy as np
from math import sqrt, pi

INV_SQRT_2PI=0.3989422804014327
PI=pi
TWO_PI=2*pi

def norm_cdf(x):
    # A&S approximation
    ax=np.abs(x)
    t=1.0/(1.0+0.2316419*ax)
    poly=((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t
    phi=np.exp(-0.5*ax*ax)*INV_SQRT_2PI
    c=1.0-phi*poly
    return np.where(x>=0,c,1.0-c)

def relu_gauss_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12))
    a=mu/sig
    return sig*np.exp(-0.5*a*a)*INV_SQRT_2PI + mu*norm_cdf(a)

def first_cov(W,var,mean):
    gram=W.T@W
    std=np.sqrt(np.maximum(var,1e-12))
    scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    second=scale*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    return second-mean[:,None]*mean[None,:]

def make_samples(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    u64=u.astype(np.float64)
    cov=(u64.T@u64)/(k//2)
    ev,V=np.linalg.eigh(cov)
    inv=(V/np.sqrt(np.maximum(ev,1e-6)))@V.T
    return (u64@inv).astype(np.float32)

def estimate(weights,samples,mode='base'):
    depth=len(weights); width=weights[0].shape[0]
    W=weights[0]
    var=np.sum(W*W,axis=0)
    mean=np.sqrt(var)*INV_SQRT_2PI
    z=samples@W
    x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],axis=0)
    if depth==1: return mean
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=var*(0.5-INV_SQRT_2PI**2)
    x=(x-sm)*np.sqrt(tv/sv)+mean
    C=first_cov(W,var,mean)
    W=weights[1]
    z=x@W
    tm=mean@W
    cw=C@W
    tv=np.maximum(np.sum(W*cw,axis=0),1e-8)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
    if mode=='gauss2':
        # generate standardized z, then set x by Gaussian marginal CDF? no
        pass
    x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in weights[2:-1]:
        x=np.maximum(x@W,0)
    if depth>2:
        W=weights[-1]
        z=x@W
        if mode=='final_gauss':
            zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
            return relu_gauss_mean(zm,zv)
        return np.maximum(z,0).mean(0)
    else:
        if mode=='final_gauss':
            # for depth 2, z was already final preact corrected; compute formula from target moments
            return relu_gauss_mean(tm,tv)
        return x.mean(0)

def true_mean(weights,n=800000,seed=1234,chunk=20000):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64); done=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0)
    return s/n

for width,depth,k,nmlp in [(32,6,65536,10),(64,8,131072,8),(64,16,131072,5)]:
  rng=np.random.default_rng(42+width+depth)
  samples=make_samples(width,k,777)
  mses={'base':[],'fg':[]}
  for i in range(nmlp):
    weights=[(rng.standard_normal((width,width))*sqrt(2/width)).astype(np.float32) for _ in range(depth)]
    t=true_mean(weights,n=300000 if width==64 else 500000,seed=1000+i)
    b=estimate(weights,samples,'base')*0.9999375
    g=estimate(weights,samples,'final_gauss')
    # optimal scale? use current only base
    mses['base'].append(np.mean((b-t)**2))
    mses['fg'].append(np.mean((g-t)**2))
  print('spec',width,depth,k,{m:float(np.mean(v)) for m,v in mses.items()}, 'ratio fg/base',np.mean(mses['fg'])/np.mean(mses['base']))

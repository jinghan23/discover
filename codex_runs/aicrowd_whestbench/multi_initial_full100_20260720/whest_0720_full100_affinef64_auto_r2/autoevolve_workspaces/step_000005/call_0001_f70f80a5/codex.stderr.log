import numpy as np
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi
w=256; d=32; B=272_000_000_000

def sample_count(frac):
 per=(2*d-1)*w*w+d*w+w*w; fixed=9*w**3+2*(2*w**3); k=(int(frac*B)-fixed)//per; return int(k-(k&1))

def first_cov(W,var,mean):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
 rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
 return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]

def make_samples(k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); u64=u.astype(np.float64); cov=u64.T@u64/(k//2); ev,V=np.linalg.eigh(cov); return (u64@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)

def est(weights,samples,scale=0.9999375):
 W=weights[0]; var=np.sum(W*W,0); mean=np.sqrt(var)*INV; z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(var*(0.5-INV*INV)/sv)+mean

import numpy as np
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi

def norm_ppf(p):
    # Acklam inverse normal CDF, vectorized
    a=[-3.969683028665376e+01,2.209460984245205e+02,-2.759285104469687e+02,1.383577518672690e+02,-3.066479806614716e+01,2.506628277459239e+00]
    b=[-5.447609879822406e+01,1.615858368580409e+02,-1.556989798598866e+02,6.680131188771972e+01,-1.328068155288572e+01]
    c=[-7.784894002430293e-03,-3.223964580411365e-01,-2.400758277161838e+00,-2.549732539343734e+00,4.374664141464968e+00,2.938163982698783e+00]
    d=[7.784695709041462e-03,3.224671290700398e-01,2.445134137142996e+00,3.754408661907416e+00]
    plow=0.02425; phigh=1-plow
    x=np.empty_like(p,dtype=np.float64)
    lo=p<plow; hi=p>phigh; mid=~(lo|hi)
    if np.any(lo):
        q=np.sqrt(-2*np.log(p[lo]));
        x[lo]=(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    if np.any(hi):
        q=np.sqrt(-2*np.log(1-p[hi]));
        x[hi]=-(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    if np.any(mid):
        q=p[mid]-0.5; r=q*q
        x[mid]=(((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q/(((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)
    return x

def first_cov(W,var,mean):
    gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    second=scale*(root+(PI-np.arccos(rho))*rho)/TWO
    return second-mean[:,None]*mean[None,:]

def make_random(width,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32); return whiten(u)

def make_lhs(width,k,seed):
    rng=np.random.default_rng(seed); n=k//2
    cols=[]
    jitter=rng.random((n,width),dtype=np.float64)
    for j in range(width):
        p=rng.permutation(n)
        cols.append((p+jitter[:,j]+0.5*0)/n)
    u=np.stack(cols,axis=1)
    z=norm_ppf(np.clip(u,1e-12,1-1e-12)).astype(np.float32)
    return whiten(z)

def make_lattice(width,k,seed):
    n=k//2

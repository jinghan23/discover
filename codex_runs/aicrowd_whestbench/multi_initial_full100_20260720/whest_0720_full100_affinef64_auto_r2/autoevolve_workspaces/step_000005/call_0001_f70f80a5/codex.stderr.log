import numpy as np, time
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi
B=272_000_000_000; width=256; depth=32; f=.143
per=(2*depth-1)*width*width+depth*width+width*width; fixed=9*width**3+2*(2*width**3)
k=(int(f*B)-fixed)//per; print('k',k,'per',per,'fixed',fixed)

def first_cov(W,var,mean):
    gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]

def whiten(u):
    u64=u.astype(np.float64); cov=u64.T@u64/u.shape[0]; ev,V=np.linalg.eigh(cov); return (u64@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)

def make_random(width,k,seed): return whiten(np.random.default_rng(seed).standard_normal((k//2,width)).astype(np.float32))

def make_lattice(width,k,seed):
    n=k//2; i=np.arange(n,dtype=np.float64)[:,None]+0.5; j=np.arange(width,dtype=np.float64)[None,:]+1.0
    shift1=((seed%104729)+0.5)/104729.0; shift2=(((seed//104729)%104729)+0.5)/104729.0
    a=np.sqrt(2.0+j*0.17320508075688773); b=np.sqrt(3.0+j*0.22360679774997896)
    u1=(i*a+0.37*j+shift1)%1.0; u2=(i*b+0.11*j+shift2)%1.0
    z=np.sqrt(-2*np.log(np.maximum(u1,1e-12)))*np.cos(2*pi*u2)
    return whiten(z.astype(np.float32))

def estimate(weights,samples,mode='base'):
    d=len(weights); W=weights[0]; var=np.sum(W*W,0); mean=np.sqrt(var)*INV
    z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
    if d==1:return mean
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(var*(0.5-INV*INV)/sv)+mean
    C=first_cov(W,var,mean); W=weights[1]; z=x@W; tm=mean@W; cw=C@W; tv=np.maximum(np.sum(W*cw,0),1e-8)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)*0.9999375

def true_mean(weights,n=250000,seed=99,chunk=4096):
    rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:x=np.maximum(x@W,0)
        s+=x.sum(0)
    return s/n

for seed in [101,202,303]:
    t0=time.time(); sr=make_random(width,k,777+seed); sl=make_lattice(width,k,777+seed); print('samples made',seed,time.time()-t0)
    rng=np.random.default_rng(seed); er=[]; el=[]
    for i in range(3):
        weights=[(rng.standard_normal((width,width))*sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        target=true_mean(weights,n=160000,seed=5000+seed*10+i,chunk=2048)
        pr=estimate(weights,sr); pl=estimate(weights,sl)
        er.append(np.mean((pr-target)**2)); el.append(np.mean((pl-target)**2))
        print(seed,i,er[-1],el[-1],el[-1]/er[-1])
    print('summary seed',seed,'random',np.mean(er),'lattice',np.mean(el),'ratio',np.mean(el)/np.mean(er))

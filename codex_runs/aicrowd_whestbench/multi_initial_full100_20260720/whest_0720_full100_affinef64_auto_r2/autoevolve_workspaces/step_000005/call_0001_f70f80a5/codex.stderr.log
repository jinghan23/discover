codex
A more substantial variance reduction is available from positive homogeneity: the whole ReLU MLP scales linearly with input norm, so we can sample only Gaussian directions on the unit sphere and multiply by the exact mean radius. I’m testing a spherical version of the current first/second moment-corrected estimator locally.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi
w=256; d=32; k=9202
radial_mean=math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
print('radial_mean',radial_mean)

def first_gauss_second(W,var):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
 rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
 return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def first_cov_gauss(W,var,mean): return first_gauss_second(W,var)-mean[:,None]*mean[None,:]

def make_gauss_samples(seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); u64=u.astype(np.float64); cov=u64.T@u64/(k//2); ev,V=np.linalg.eigh(cov); return (u64@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)

def make_sphere(seed,whiten=False):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); n=np.sqrt(np.maximum(np.sum(u*u,1,keepdims=True),1e-12)); s=(u/n).astype(np.float32)
 if whiten:
  s64=s.astype(np.float64); cov=s64.T@s64/s.shape[0]; ev,V=np.linalg.eigh(cov*w); A=(V/np.sqrt(np.maximum(ev,1e-6)))@V.T; s=(s64@A).astype(np.float32); n=np.sqrt(np.maximum(np.sum(s*s,1,keepdims=True),1e-12)); s=(s/n).astype(np.float32)
 return s

def est_base(weights,samples):
 W=weights[0]; var=np.sum(W*W,0); mean=np.sqrt(var)*INV; z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(var*(0.5-INV*INV)/sv)+mean
 C=first_cov_gauss(W,var,mean); W=weights[1]; z=x@W; tm=mean@W; cw=C@W; tv=np.maximum(np.sum(W*cw,0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
 for W in weights[2:]: x=np.maximum(x@W,0)
 return x.mean(0)*0.9999375

def est_sphere(weights,samples,scale=1.0):
 W=weights[0]; var_g=np.sum(W*W,0); mean_g=np.sqrt(var_g)*INV
 mean=mean_g/radial_mean
 z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-12)
 target_var=np.maximum(var_g*(0.5/w)-mean*mean,1e-12)
 x=(x-sm)*np.sqrt(target_var/sv)+mean
 if len(weights)>1:
  second_s=first_gauss_second(W,var_g)/w
  C=second_s-mean[:,None]*mean[None,:]
  W=weights[1]; z=x@W; tm=mean@W; cw=C@W; tv=np.maximum(np.sum(W*cw,0),1e-12)
  zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
  for W in weights[2:]: x=np.maximum(x@W,0)
 return x.mean(0)*radial_mean*scale

def est_sphere_naive(weights,samples,scale=1.0):
 x=np.concatenate([samples,-samples],0)
 for W in weights: x=np.maximum(x@W,0)
 return x.mean(0)*radial_mean*scale

def true(weights,n=180000,seed=1,chunk=2048):
 rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights:x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
for seed in [101,202,303]:
 sg=make_gauss_samples(777+seed); ss=make_sphere(777+seed,False); ssw=make_sphere(777+seed,True)
 rng=np.random.default_rng(seed); errs={'base':[],'sphere':[],'spherew':[],'snaive':[]}
 for i in range(4):
  weights=[(rng.standard_normal((w,w))*sqrt(2/w)).astype(np.float32) for _ in range(d)]
  t=true(weights,seed=7000+seed*10+i)
  preds={'base':est_base(weights,sg),'sphere':est_sphere(weights,ss,0.9999375),'spherew':est_sphere(weights,ssw,0.9999375),'snaive':est_sphere_naive(weights,ss,1.0)}
  for n,p in preds.items(): errs[n].append(np.mean((p-t)**2))
  print(seed,i,{n:errs[n][-1] for n in errs})
 print('summary',seed,{n:float(np.mean(v)) for n,v in errs.items()}, {n:float(np.mean(v)/np.mean(errs['base'])) for n,v in errs.items()})

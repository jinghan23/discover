width=256; depth=32; k=9202

def first_cov(W,var,mean):
    gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]

def whiten(u):

/bin/bash -lc "python - <<'PY'
import numpy as np, math
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi
w=256; d=32; k=9202; radial=math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def first_second(W,var):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
 rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
 return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def make_bank(seed,nfull):
 rng=np.random.default_rng(seed); n=nfull//2; u=rng.standard_normal((n,w)).astype(np.float32); u/=np.sqrt(np.maximum(np.sum(u*u,1,keepdims=True),1e-12))
 u64=u.astype(np.float64); cov=(u64.T@u64)*(w/n); ev,V=np.linalg.eigh(cov); h=(u64@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32); h/=np.sqrt(np.maximum(np.sum(h*h,1,keepdims=True),1e-12)); return h

def prep(banks,seed):
 # split full k evenly, ensure even per bank
 per=(k//banks)//2*2
 return [make_bank(seed+97*b,per) for b in range(banks)]

def est_one(weights,samples):
 W=weights[0]; var=np.sum(W*W,0); mean=np.sqrt(var)*(INV/radial); z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(var*(0.5/w)-mean*mean,1e-12); x=(x-sm)*np.sqrt(tv/sv)+mean
 fs=first_second(W,var)/w; C=fs-mean[:,None]*mean[None,:]; W=weights[1]; z=x@W; tm=mean@W; cw=C@W; tv=np.maximum(np.sum(W*cw,0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
 for W in weights[2:]: x=np.maximum(x@W,0)
 return x.mean(0)*radial

def est(weights,banks): return sum(est_one(weights,s) for s in banks)/len(banks)

def true(weights,n=120000,seed=1,chunk=2048):
 rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights:x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
for seed in [10,20,30]:
 sample_sets={b:prep(b,777+seed) for b in [1,2,4]}
 rng=np.random.default_rng(seed); errs={b:[] for b in sample_sets}
 for i in range(5):
  weights=[(rng.standard_normal((w,w))*sqrt(2/w)).astype(np.float32) for _ in range(d)]
  t=true(weights,seed=12000+seed+i)
  for b,ss in sample_sets.items(): errs[b].append(np.mean((est(weights,ss)-t)**2))
 print('seed',seed,{b:float(np.mean(v)) for b,v in errs.items()}, {b:float(np.mean(v)/np.mean(errs[1])) for b,v in errs.items()})

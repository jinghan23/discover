def make_random(seed): return whiten(np.random.default_rng(seed).standard_normal((k//2,width)).astype(np.float32))

def color(z,target_cov,target_mean):
    kk=z.shape[0]; zm=z.mean(0); c=(z-zm).astype(np.float64); S=c.T@c/kk
    ev,V=np.linalg.eigh((S+S.T)*0.5); A=(V/np.sqrt(np.maximum(ev,1e-8)))@V.T
    et,U=np.linalg.eigh((target_cov+target_cov.T)*0.5); B=(U*np.sqrt(np.maximum(et,1e-8)))@U.T
    return (c@A@B+target_mean).astype(np.float32)

def estimate(weights,samples,mode):

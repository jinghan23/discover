codex
Another useful local check is whether a cheap deterministic Gaussian/diagonal moment propagator is good enough to blend with Monte Carlo. If its bias is modest, a small blend can reduce sample variance; if the bias is large, the current pure MC path is safer.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from math import sqrt, pi
INV=0.3989422804014327; PI=pi; TWO=2*pi
width=256; depth=32; k=9202

def norm_cdf(x):
    ax=np.abs(x); t=1/(1+0.2316419*ax)
    poly=((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t
    phi=np.exp(-0.5*ax*ax)*INV; c=1-phi*poly
    return np.where(x>=0,c,1-c)

def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; phi=np.exp(-0.5*a*a)*INV; Phi=norm_cdf(a)
    m=sig*phi+mu*Phi; q=(mu*mu+var)*Phi+mu*sig*phi
    return m,np.maximum(q, m*m+1e-12)

def diag_est(weights):
    W=weights[0]; var=np.sum(W*W,0); m=np.sqrt(var)*INV; q=0.5*var
    for W in weights[1:]:
        mu=m@W; v=np.maximum((q-m*m)@(W*W),1e-12); m,q=relu_mom(mu,v)
    return m

def first_cov(W,var,mean):
    gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]

def whiten(u):
    u64=u.astype(np.float64); cov=u64.T@u64/u.shape[0]; ev,V=np.linalg.eigh(cov); return (u64@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)

def make_random(seed): return whiten(np.random.default_rng(seed).standard_normal((k//2,width)).astype(np.float32))

def mc_est(weights,samples):
    W=weights[0]; var=np.sum(W*W,0); mean=np.sqrt(var)*INV
    z=samples@W; x=np.concatenate([np.maximum(z,0),np.maximum(-z,0)],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(var*(0.5-INV*INV)/sv)+mean
    C=first_cov(W,var,mean); W=weights[1]; z=x@W; tm=mean@W; cw=C@W; tv=np.maximum(np.sum(W*cw,0),1e-8)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)*0.9999375

def true_mean(weights,n=160000,seed=99,chunk=2048):
    rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:x=np.maximum(x@W,0)
        s+=x.sum(0)
    return s/n

alphas=[0,0.02,0.05,0.1,0.2,0.5,1.0] # alpha diag + (1-alpha) mc? 
for seed in [11,22,33]:
    rng=np.random.default_rng(seed); samples=make_random(777+seed); errs={a:[] for a in alphas}; ed=[]; em=[]
    for i in range(4):
        weights=[(rng.standard_normal((width,width))*sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        t=true_mean(weights,seed=6000+seed*10+i)
        m=mc_est(weights,samples); d=diag_est(weights)
        em.append(np.mean((m-t)**2)); ed.append(np.mean((d-t)**2))
        for a in alphas:
            p=(1-a)*m+a*d
            errs[a].append(np.mean((p-t)**2))
    print('seed',seed,'mc',np.mean(em),'diag',np.mean(ed),'best',min((np.mean(v),a) for a,v in errs.items()), {a:float(np.mean(v)/np.mean(em)) for a,v in errs.items()})

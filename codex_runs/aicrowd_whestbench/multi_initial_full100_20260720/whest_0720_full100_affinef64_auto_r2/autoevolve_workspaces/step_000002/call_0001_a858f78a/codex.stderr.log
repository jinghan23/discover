+def _erf_approx(x):
+    sign = fnp.where(x < 0.0, -1.0, 1.0)
+    ax = fnp.abs(x)
+    t = 1.0 / (1.0 + 0.3275911 * ax)
+    poly = (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
+    return sign * (1.0 - poly * fnp.exp(-(ax * ax)))
+

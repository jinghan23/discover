 _FIRST_VARIANCE_FACTOR = 1.0
+_SECOND_VARIANCE_FACTOR = 1.0
+
+
+def _erf_approx(x):
+    sign = fnp.where(x < 0.0, -1.0, 1.0)
+    ax = fnp.abs(x)
+    t = 1.0 / (1.0 + 0.3275911 * ax)
+    poly = (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
+    return sign * (1.0 - poly * fnp.exp(-(ax * ax)))
+
+
+def _normal_relu_moments(mean, variance):
+    variance = fnp.maximum(variance, 1e-12)
+    sigma = fnp.sqrt(variance)
+    alpha = mean / sigma
+    cdf = 0.5 * (1.0 + _erf_approx(alpha * _INV_SQRT2))
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    relu_mean = sigma * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * sigma * pdf
+    relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 1e-8)
+    return relu_mean, relu_variance
 
 

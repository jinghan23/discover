 _WORST_CASE_ITEMSIZE = 8
 _SETUP_SEED_OFFSET = 3
 _INV_SQRT_2PI = 0.3989422804014327
+_INV_SQRT2 = 0.7071067811865476
 _FIRST_VARIANCE_FACTOR = 1.0
 
 
+def _erf_approx(x):
+    sign = fnp.where(x < 0.0, -1.0, 1.0)
+    ax = fnp.abs(x)
+    t = 1.0 / (1.0 + 0.3275911 * ax)
+    poly = (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t
+    return sign * (1.0 - poly * fnp.exp(-(ax * ax)))
+
+
+def _relu_normal_mean(mean, variance):
+    variance = fnp.maximum(variance, 1e-12)
+    sigma = fnp.sqrt(variance)
+    alpha = mean / sigma
+    cdf = 0.5 * (1.0 + _erf_approx(alpha * _INV_SQRT2))
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    return sigma * pdf + mean * cdf
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     per_sample = (2 * depth - 1) * width * width + depth * width + width * width
     fixed = 9 * width**3 + 2 * (2 * width**3)

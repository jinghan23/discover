    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(var*(0.5/w)-m1*m1,1e-12)
    x=(x-sm)*np.sqrt(tv/sv)+m1
    C=first_relu_second(W0,var)/w-m1[:,None]*m1[None,:]; W1=weights[1]
    z=x@W1; tm=m1@W1; tv=np.maximum(np.sum(W1*(C@W1),0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
    x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0)*r

def truth(weights,n,seed,batch=50000):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); cnt=0
    while cnt<n:

/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
PI=math.pi; TWO=2*math.pi; INV=1/math.sqrt(2*math.pi)

def Phi_tanh(x): return 0.5*(1+np.tanh(math.sqrt(2/math.pi)*(x+0.044715*x*x*x)))
def Phi_erf(x): return 0.5*(1+np.vectorize(math.erf)(x/math.sqrt(2)))
def relu_mean(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; return sig*np.exp(-0.5*a*a)*INV+mu*Phi_erf(a)
def relu_second_uni(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; Phi=Phi_erf(a); phi=np.exp(-0.5*a*a)*INV; return (var+mu*mu)*Phi+mu*sig*phi
def first_central(W):
 v=(W*W).sum(0); gram=W.T@W; s=np.sqrt(np.maximum(v,1e-12)); scale=s[:,None]*s[None,:]; rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); S=scale*(root+(PI-np.arccos(rho))*rho)/TWO; m=s*INV; return m,S-m[:,None]*m[None,:]

def relu_moments_gauss(mu,C,Q=20):
 w=len(mu); var=np.maximum(np.diag(C),1e-12); sig=np.sqrt(var); m=relu_mean(mu,var)
 rho=np.clip(C/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999)
 nodes,weights=np.polynomial.hermite.hermgauss(Q); zs=np.sqrt(2)*nodes; ws=weights/math.sqrt(math.pi)
 S=np.zeros((w,w))
 mu_j=mu[None,:]; sig_j=sig[None,:]
 for z,wt in zip(zs,ws):
   xpos=np.maximum(mu+sig*z,0)[:,None]
   cond_mu=mu_j+sig_j*rho*z
   cond_sig=sig_j*np.sqrt(np.maximum(1-rho*rho,1e-12))
   a=cond_mu/cond_sig
   y=cond_sig*np.exp(-0.5*a*a)*INV + cond_mu*Phi_erf(a)
   S += wt*xpos*y
 np.fill_diagonal(S,relu_second_uni(mu,var))
 C2=S-m[:,None]*m[None,:]
 return m,(C2+C2.T)*0.5

def gauss_full(ws,Q=20):
 # first layer exact central Gaussian
 m,C=first_central(ws[0])
 if len(ws)==1: return m
 for W in ws[1:]:
   mu=m@W; Cpre=W.T@C@W
   m,C=relu_moments_gauss(mu,Cpre,Q)
 return m

def truth(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); cnt=0
 while cnt<n:
  b=min(50000,n-cnt); cnt+=b; x=rng.standard_normal((b,w)).astype('float32')
  for W in ws: x=np.maximum(x@W,0)
  s+=x.astype('float64').sum(0)
 return s/n
for Q in [8,12,20]:
 print('Q',Q)
 for w,d in [(32,3),(32,4),(64,3),(64,4),(64,6),(128,4),(128,6)]:
  errs=[]; t0=time.time()
  reps=8 if w<128 else 4
  for rep in range(reps):
    rng=np.random.default_rng(13000+rep+w*11+d*19); ws=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
    t=truth([W.astype('float32') for W in ws],200000 if w<=64 else 100000,14000+rep)
    p=gauss_full(ws,Q)
    errs.append(np.mean((p-t)**2))
  print(' ',w,d,np.mean(errs),'time',time.time()-t0)

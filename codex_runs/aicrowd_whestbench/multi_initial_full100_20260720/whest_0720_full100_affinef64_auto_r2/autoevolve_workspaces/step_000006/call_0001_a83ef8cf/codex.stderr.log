import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def first_relu_second(weight, variance):
    gram=weight.T@weight
    std=np.sqrt(np.maximum(variance,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def make_samples(w,k,seed,whiten=True):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w)).astype(np.float32)
    u/=np.sqrt(np.maximum(np.sum(u*u,1,keepdims=True),1e-12))
    if whiten:
        u64=u.astype(np.float64)
        cov=(u64.T@u64)*(w/(k//2))
        vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
        inv=(vecs/np.sqrt(vals))@vecs.T
        u=(u64@inv).astype(np.float32)
        u/=np.sqrt(np.maximum(np.sum(u*u,1,keepdims=True),1e-12))
    return u

def current(weights,k=4096,seed=1,ff=1,sf=1,fs=1):
    d=len(weights); w=weights[0].shape[0]; r=radial_mean(w)
    u=make_samples(w,k,seed)
    W0=weights[0]; var=np.sum(W0*W0,0)
    m1=np.sqrt(var)*(INV/r)
    p=u@W0
    x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0)
    if d==1: return m1*r
    sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=np.maximum((var*(0.5/w)-m1*m1)*ff,1e-12)
    x=(x-sm)*np.sqrt(tv/sv)+m1
    W1=weights[1]
    fs2=first_relu_second(W0,var)/w; C=fs2-m1[:,None]*m1[None,:]
    z=x@W1; tm=m1@W1; cw=C@W1; tv=np.maximum(np.sum(W1*cw,0)*sf,1e-8)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
    x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0)*r*fs

def diag_gauss(weights):
    w=weights[0].shape[0]
    m=np.zeros(w); v=np.ones(w) # input independent diag variance

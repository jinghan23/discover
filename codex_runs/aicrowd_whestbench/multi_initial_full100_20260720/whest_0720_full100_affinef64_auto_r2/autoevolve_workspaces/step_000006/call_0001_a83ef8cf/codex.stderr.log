import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def first_relu_second(weight, variance):
    gram=weight.T@weight; std=np.sqrt(np.maximum(variance,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def make_white(w,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12))
    u64=u.astype(np.float64); cov=(u64.T@u64)*(w/(k//2)); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    u=(u64@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); return u

def make_orth(w,k,seed,mode):
    rng=np.random.default_rng(seed); half=k//2; blocks=(half+w-1)//w; rows=[]
    if mode=='orth1':
      A=rng.standard_normal((w,w)); Q,R=np.linalg.qr(A); Q*=np.sign(np.diag(R))[None,:]
      for b in range(blocks):
        s=rng.choice(np.array([-1.,1.]),size=(w,)).astype(np.float32)
        rows.append((Q*s).astype(np.float32))
    elif mode=='orthmix':
      bases=max(1,min(blocks,4))
      Qs=[]
      for i in range(bases):
        A=rng.standard_normal((w,w)); Q,R=np.linalg.qr(A); Q*=np.sign(np.diag(R))[None,:]; Qs.append(Q.astype(np.float32))
      for b in range(blocks):
        s=rng.choice(np.array([-1.,1.]),size=(w,)).astype(np.float32)
        rows.append(Qs[b%bases]*s)
    else:
      for b in range(blocks):
        A=rng.standard_normal((w,w)); Q,R=np.linalg.qr(A); Q*=np.sign(np.diag(R))[None,:]; rows.append(Q.astype(np.float32))
    return np.concatenate(rows,0)[:half]

def pred(weights,k=4096,seed=1,sampler='white'):
    d=len(weights); w=weights[0].shape[0]; r=radial_mean(w)

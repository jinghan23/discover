  for rep in range(12):
    rng=np.random.default_rng(1500+rep); weights=[rng.standard_normal((w,w)).astype(np.float32)/math.sqrt(w) for _ in range(d)]
    tr=truth(weights,200000 if w<=64 else 100000,1600+rep)
    for m in modes: res[m].append(np.mean((pred(weights,k,1700+rep,m)-tr)**2))
  print('case',w,d,k,'time',time.time()-t0); base=np.mean(res['white'])
  for m in modes: print(m,np.mean(res[m]),np.mean(res[m])/base)

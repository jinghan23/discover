/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype('float32'); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=u.astype('float64'); c=(u64.T@u64)*(w/(k//2)); e,V=np.linalg.eigh(c); e=np.maximum(e,1e-6); u=(u64@((V/np.sqrt(e))@V.T)).astype('float32'); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); return u
def metric(u):
 w=u.shape[1]; target4=3/(w*(w+2)); diag4=np.mean(u.astype('float64')**4,0); m4=np.mean((diag4-target4)**2)/(target4*target4)
 # random projection relu moments? coordinate abs moments target E|u_i| maybe approx not simple
 return m4
def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def first_relu_second(W,v):
 g=W.T@W; s=np.sqrt(np.maximum(v,1e-12)); sc=s[:,None]*s[None,:]; rho=np.clip(g/np.maximum(sc,1e-12),-1,1); return sc*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO
def pred_with_u(ws,u):
 w=ws[0].shape[0]; r=radial_mean(w); W0=ws[0]; v=(W0*W0).sum(0); m=np.sqrt(v)*(INV/r); p=u@W0; x=np.r_[np.maximum(p,0),np.maximum(-p,0)]; sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(v*(.5/w)-m*m,1e-12); x=(x-sm)*np.sqrt(tv/sv)+m; C=first_relu_second(W0,v)/w-m[:,None]*m[None,:]; W1=ws[1]; z=x@W1; tm=m@W1; tv=np.maximum(np.sum(W1*(C@W1),0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0); 
 for W in ws[2:]: x=np.maximum(x@W,0)
 return x.astype('float64').mean(0)*r
def truth(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); cnt=0
 while cnt<n:
  b=min(50000,n-cnt); cnt+=b; x=rng.standard_normal((b,w)).astype('float32')
  for W in ws: x=np.maximum(x@W,0)
  s+=x.astype('float64').sum(0)
 return s/n
for w,d,k in [(64,4,4096),(64,6,4096),(128,4,4096),(128,6,8192)]:
 us=[make(w,k,30000+s) for s in range(8)]; mets=[metric(u) for u in us]
 ws_list=[]; truths=[]
 for rep in range(8):
  rng=np.random.default_rng(31000+w+d*23+rep); ws=[rng.standard_normal((w,w)).astype('float32')/math.sqrt(w) for _ in range(d)]; ws_list.append(ws); truths.append(truth(ws,120000 if w<=64 else 70000,32000+rep))
 err_seed=[]
 for u in us:
  err=[]
  for ws,t in zip(ws_list,truths): err.append(np.mean((pred_with_u(ws,u)-t)**2))
  err_seed.append(np.mean(err))
 print('case',w,d,'metrics',mets,'errs',err_seed,'best_metric',np.argmin(mets),'best_err',np.argmin(err_seed),'ratio metricchoice/base3',err_seed[np.argmin(mets)]/err_seed[3])

/bin/bash -lc "python - <<'PY'
# Local screen: double reductions for first/second moment matching.
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def first_relu_second(W,v):
 g=W.T@W; s=np.sqrt(np.maximum(v,1e-12)); sc=s[:,None]*s[None,:]; rho=np.clip(g/np.maximum(sc,1e-12),-1,1); return sc*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO
def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype('float32'); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=u.astype('float64'); c=(u64.T@u64)*(w/(k//2)); e,V=np.linalg.eigh(c); e=np.maximum(e,1e-6); u=(u64@((V/np.sqrt(e))@V.T)).astype('float32'); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); return u
def pred(ws,k,seed,double_mom=False):
 w=ws[0].shape[0]; d=len(ws); r=radial_mean(w); W0=ws[0]; v=(W0*W0).sum(0); m=np.sqrt(v)*(INV/r); p=make(w,k,seed)@W0; x=np.r_[np.maximum(p,0),np.maximum(-p,0)].astype('float32')
 if d==1: return m*r
 if double_mom:
  xd=x.astype('float64'); sm=xd.mean(0).astype('float32'); sv=np.maximum((xd*xd).mean(0).astype('float32')-sm*sm,1e-6)
 else:
  sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
 tv=np.maximum(v*(.5/w)-m*m,1e-12); x=((x-sm)*np.sqrt(tv/sv)+m).astype('float32')
 C=first_relu_second(W0,v)/w-m[:,None]*m[None,:]; W1=ws[1]; z=x@W1; tm=m@W1; tv=np.maximum(np.sum(W1*(C@W1),0),1e-8)
 if double_mom:
  zd=z.astype('float64'); zm=zd.mean(0).astype('float32'); zv=np.maximum((zd*zd).mean(0).astype('float32')-zm*zm,1e-8)
 else:
  zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
 x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0).astype('float32')
 for W in ws[2:]: x=np.maximum(x@W,0)
 return x.astype('float64').mean(0)*r
def truth(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); cnt=0
 while cnt<n:
  b=min(50000,n-cnt); cnt+=b; x=rng.standard_normal((b,w)).astype('float32')
  for W in ws: x=np.maximum(x@W,0)
  s+=x.astype('float64').sum(0)
 return s/n
for w,d,k in [(64,4,4096),(64,6,4096),(128,4,4096),(128,6,8192),(256,4,4096)]:
 res=[[],[]]
 for rep in range(10 if w<256 else 5):
  rng=np.random.default_rng(24000+w+d*13+rep); ws=[rng.standard_normal((w,w)).astype('float32')/math.sqrt(w) for _ in range(d)]
  t=truth(ws,150000 if w<=64 else 80000 if w<=128 else 50000,25000+rep)
  for i,dm in enumerate([False,True]): res[i].append(np.mean((pred(ws,k,26000+rep,dm)-t)**2))
 print('case',w,d,'base',np.mean(res[0]),'doublemom',np.mean(res[1]),'ratio',np.mean(res[1])/np.mean(res[0]))

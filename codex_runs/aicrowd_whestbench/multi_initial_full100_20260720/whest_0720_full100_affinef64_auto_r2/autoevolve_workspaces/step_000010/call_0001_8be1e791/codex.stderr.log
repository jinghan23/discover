ys=[2.891536279321372,2.590767955130762,2.669205829437798]
# solve 3x3 using plain Python
A=[]
for x in xs: A.append([x*x,x,1])
# Gaussian elim
M=[row+[y] for row,y in zip(A,ys)]
for i in range(3):
    piv=M[i][i]
    for j in range(i,4): M[i][j]/=piv
    for k in range(3):
        if k==i: continue
        f=M[k][i]
        for j in range(i,4): M[k][j]-=f*M[i][j]
coef=[M[i][3] for i in range(3)]
a,b,c=coef
print(coef, -b/(2*a), a*(-b/(2*a))**2+b*(-b/(2*a))+c)

     return relu_mean, relu_second
 
 
+def _diagonal_mean_estimate(weights, width):
+    mean = fnp.zeros(width, dtype=fnp.float32)
+    variance = fnp.ones(width, dtype=fnp.float32)
+    second = variance
+    for weight in weights:
+        pre_mean = mean @ weight
+        centered = fnp.maximum(second - mean * mean, 0.0)
+        pre_variance = centered @ (weight * weight)
+        mean, second = _normal_relu_moments(pre_mean, pre_variance)
+    return mean
+
+
 class Estimator(BaseEstimator):

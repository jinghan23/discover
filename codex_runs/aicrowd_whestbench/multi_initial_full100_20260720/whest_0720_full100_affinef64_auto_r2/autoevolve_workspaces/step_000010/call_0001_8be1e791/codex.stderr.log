/bin/bash -lc "python - <<'PY'
import importlib.util
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

spec = importlib.util.spec_from_file_location('sub', 'submission.py')
sub = importlib.util.module_from_spec(spec)
spec.loader.exec_module(sub)

width=64; depth=32; budget=2_000_000_000; n_mlps=8; gt_samples=300_000
rng = fnp.random.default_rng(321)
mlps=[]; finals=[]
for i in range(n_mlps):
    mlp = sample_mlp(width, depth, rng, seed=2000+i)
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True):
        _, final, _ = sample_layer_statistics(mlp, gt_samples, rng=fnp.random.default_rng(7000+i))
    mlps.append(mlp); finals.append(final)
for blend in [0.0,0.002,0.005,0.01,0.02,-0.005,-0.01]:
    sub._DIAGONAL_FINAL_BLEND=blend
    est=sub.Estimator(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=42))
    total=0.0; raw=0.0; fl=0
    for mlp, final in zip(mlps, finals):
        with flops.BudgetContext(flop_budget=budget, quiet=True) as b:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2))
        raw += mse; total += mse*max(0.1, b.flops_used/budget); fl += b.flops_used
    print(blend, total/n_mlps, raw/n_mlps, fl//n_mlps)

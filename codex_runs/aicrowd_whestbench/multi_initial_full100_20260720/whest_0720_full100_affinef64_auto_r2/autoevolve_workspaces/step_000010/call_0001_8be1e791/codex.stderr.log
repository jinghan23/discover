import importlib.util
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

spec = importlib.util.spec_from_file_location('sub', 'submission.py')
sub = importlib.util.module_from_spec(spec)
spec.loader.exec_module(sub)

width=256; depth=128; budget=100_000_000_000; n_mlps=3; gt_samples=80_000
rng = fnp.random.default_rng(777)
mlps=[]; finals=[]
for i in range(n_mlps):
    mlp = sample_mlp(width, depth, rng, seed=4000+i)
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True):
        _, final, _ = sample_layer_statistics(mlp, gt_samples, rng=fnp.random.default_rng(11000+i))
    mlps.append(mlp); finals.append(final)
settings=[
 ('base',0.22,4,1,0.0,-0.02,1.0,0.0),
 ('frac23',0.232,4,1,0.0,-0.02,1.0,0.0),
 ('third-01',0.22,4,1,0.0,-0.01,1.0,0.0),
 ('third-03',0.22,4,1,0.0,-0.03,1.0,0.0),
 ('white3',0.22,3,1,0.0,-0.02,1.0,0.0),
 ('white5',0.22,5,1,0.0,-0.02,1.0,0.0),
 ('first099',0.22,4,1,0.0,-0.02,0.99,0.0),
 ('first101',0.22,4,1,0.0,-0.02,1.01,0.0),
]
for name,frac,wr,blocks,rad,third,firstvf,diagblend in settings:
    sub._BUDGET_FRACTION=frac; sub._WHITEN_ROUNDS=wr; sub._WHITEN_BLOCKS=blocks; sub._RADEMACHER_FRACTION=rad; sub._THIRD_MOMENT_BLEND=third; sub._FIRST_VARIANCE_FACTOR=firstvf; sub._DIAGONAL_FINAL_BLEND=diagblend
    est=sub.Estimator(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=42))
    total=0.0; raw=0.0; fl=0
    for mlp, final in zip(mlps, finals):
        with flops.BudgetContext(flop_budget=budget, quiet=True) as b:

import os, time, math
os.environ.setdefault('OPENBLAS_NUM_THREADS','4')
os.environ.setdefault('OMP_NUM_THREADS','4')
import numpy as np

INV=0.3989422804014327
PI=math.pi
TWO=2*math.pi

def radial_mean(w):
    return math.sqrt(2.0)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def normal_cdf_np(x):
    ax=np.abs(x)
    t=1/(1+0.2316419*ax)
    poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
    tail=INV*np.exp(-0.5*ax*ax)*poly
    return np.where(x>=0,1-tail,tail)

def normal_relu(mean,var):
    var=np.maximum(var,1e-12)
    std=np.sqrt(var)
    alpha=mean/std
    dens=INV*np.exp(-0.5*alpha*alpha)
    prob=normal_cdf_np(alpha)
    m=std*dens+mean*prob
    s=(var+mean*mean)*prob+mean*std*dens
    return m,s

def first_second(W,var):
    gram=W.T@W
    std=np.sqrt(np.maximum(var,1e-12))
    scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def make_half(count,w,seed,whiten=1):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((count,w), dtype=np.float32)
    half=u/np.sqrt(np.maximum(np.sum(u*u,axis=1,keepdims=True),1e-12))
    for _ in range(whiten):
        u64=half.astype(np.float64)
        cov=(u64.T@u64)*(w/count)
        vals,vecs=np.linalg.eigh(cov)
        vals=np.maximum(vals,1e-6)
        inv=(vecs/np.sqrt(vals))@vecs.T
        half=(u64@inv).astype(np.float32)
        half=half/np.sqrt(np.maximum(np.sum(half*half,axis=1,keepdims=True),1e-12))
    return half

def estimate(weights, half, params):
    W0=weights[0]; w=W0.shape[0]; d=len(weights); rm=radial_mean(w)
    first_var=np.sum(W0*W0,axis=0)
    first_mean=np.sqrt(first_var)*(INV/rm)
    proj=half@W0
    x=np.concatenate([np.maximum(proj,0),np.maximum(-proj,0)],axis=0).astype(np.float32)
    if d==1: return first_mean*rm
    sm=x.mean(axis=0); ss=(x*x).mean(axis=0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=np.maximum((first_var*(0.5/w)-first_mean*first_mean)*params.get('first_var_factor',1.0),1e-12)
    x=((x-sm)*np.sqrt(tv/sv)+first_mean).astype(np.float32)
    fs=first_second(W0,first_var)/w
    fcov=fs-first_mean[:,None]*first_mean[None,:]
    W=weights[1]
    z=x@W
    tm=first_mean@W
    cw=fcov@W
    tv=np.maximum(np.sum(W*cw,axis=0)*params.get('second_var_factor',1.0),1e-8)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
    x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0).astype(np.float32)
    second_mean, second_second = normal_relu(tm,tv)
    spb=params.get('second_post_blend',0.3)
    if spb:
        pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8)
        tpv=np.maximum(second_second-second_mean*second_mean,1e-8)
        bpm=pm*(1-spb)+second_mean*spb
        bpv=np.maximum(pv*(1-spb)+tpv*spb,1e-8)
        x=((x-pm)*np.sqrt(bpv/pv)+bpm).astype(np.float32)
    diag_mean=second_mean.copy(); diag_second=second_second.copy()
    third_moment=params.get('third_moment_blend',-0.02)
    third_post=params.get('third_post_blend',-0.01)
    final_blend=params.get('final_diag_blend',0.0)
    layer_blend=params.get('layer_moment_blend',0.0)
    decay=params.get('layer_decay',1.0)
    for li,W in enumerate(weights[2:], start=2):
        z=x@W
        use_blend = 0.0
        if li==2 and third_moment: use_blend=third_moment
        elif li>2 and layer_blend: use_blend=layer_blend*(decay**(li-3))
        if use_blend:
            zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
            dc=np.maximum(diag_second-diag_mean*diag_mean,1e-8)
            dm=diag_mean@W
            dv=np.maximum(dc@(W*W),1e-8)
            bm=zm*(1-use_blend)+dm*use_blend
            bv=np.maximum(zv*(1-use_blend)+dv*use_blend,1e-8)
            z=((z-zm)*np.sqrt(bv/zv)+bm).astype(np.float32)
            diag_mean,diag_second=normal_relu(bm,bv)
        elif final_blend or layer_blend or li==2:
            # keep diagonal moments approximately updated when needed
            dc=np.maximum(diag_second-diag_mean*diag_mean,1e-8)
            dm=diag_mean@W
            dv=np.maximum(dc@(W*W),1e-8)
            diag_mean,diag_second=normal_relu(dm,dv)
        x=np.maximum(z,0).astype(np.float32)
        if li==2 and third_post:
            pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8)
            tpv=np.maximum(diag_second-diag_mean*diag_mean,1e-8)
            bpm=pm*(1-third_post)+diag_mean*third_post
            bpv=np.maximum(pv*(1-third_post)+tpv*third_post,1e-8)
            x=((x-pm)*np.sqrt(bpv/pv)+bpm).astype(np.float32)
    sfm=x.astype(np.float64).mean(0).astype(np.float32)
    if final_blend:
        out=sfm*(1-final_blend)+diag_mean.astype(np.float32)*final_blend
    else:
        out=sfm
    return out*(rm*params.get('final_scale',1.0))

def sphere_ref(weights, half):
    x=np.concatenate([half, -half], axis=0).astype(np.float32)
    for W in weights:
        x=np.maximum(x@W,0).astype(np.float32)
    return x.astype(np.float64).mean(0).astype(np.float32)*radial_mean(weights[0].shape[0])


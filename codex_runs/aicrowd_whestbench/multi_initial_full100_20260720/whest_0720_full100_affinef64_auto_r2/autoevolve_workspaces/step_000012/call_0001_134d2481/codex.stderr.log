# Compact NumPy proxy for current estimator, sweeping sample count.
import os,time,math
os.environ.setdefault('OPENBLAS_NUM_THREADS','4')
os.environ.setdefault('OMP_NUM_THREADS','4')
import numpy as np
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
 ax=np.abs(x); t=1/(1+0.2316419*ax); poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
 tail=INV*np.exp(-0.5*ax*ax)*poly; return np.where(x>=0,1-tail,tail)
def relum(m,v):
 v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; den=INV*np.exp(-.5*a*a); p=cdf(a); return s*den+m*p,(v+m*m)*p+m*s*den
def fs(W,var):
 g=W.T@W; s=np.sqrt(np.maximum(var,1e-12)); sc=s[:,None]*s[None,:]; r=np.clip(g/np.maximum(sc,1e-12),-1,1); return sc*(np.sqrt(np.maximum(1-r*r,0))+(PI-np.arccos(r))*r)/TWO
def half(cnt,w,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((cnt,w),dtype=np.float32); h=u/np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=h.astype(np.float64); c=(u64.T@u64)*(w/cnt); vals,vecs=np.linalg.eigh(c); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u64@inv).astype(np.float32); return h/np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
def est(weights,h):
 w=weights[0].shape[0]; rm=rad(w); W0=weights[0]; fv=(W0*W0).sum(0); fm=np.sqrt(fv)*(INV/rm); pr=h@W0; x=np.concatenate([np.maximum(pr,0),np.maximum(-pr,0)],0).astype(np.float32)
 if len(weights)==1: return fm*rm
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(fv*(.5/w)-fm*fm,1e-12); x=((x-sm)*np.sqrt(tv/sv)+fm).astype(np.float32)
 fsec=fs(W0,fv)/w; fc=fsec-fm[:,None]*fm[None,:]; W=weights[1]; z=x@W; tm=fm@W; cw=fc@W; tv=np.maximum((W*cw).sum(0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0).astype(np.float32); sm2,ss2=relum(tm,tv)
 b=.3; pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(ss2-sm2*sm2,1e-8); x=((x-pm)*np.sqrt(np.maximum(pv*(1-b)+tpv*b,1e-8)/pv)+(pm*(1-b)+sm2*b)).astype(np.float32)
 for li,W in enumerate(weights[2:],start=2):
  z=x@W
  if li==2:
   mb=-.02; zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); dc=np.maximum(ss2-sm2*sm2,1e-8); dm=sm2@W; dv=np.maximum(dc@(W*W),1e-8); bm=zm*(1-mb)+dm*mb; bv=np.maximum(zv*(1-mb)+dv*mb,1e-8); z=((z-zm)*np.sqrt(bv/zv)+bm).astype(np.float32); sm2,ss2=relum(bm,bv)
  x=np.maximum(z,0).astype(np.float32)
  if li==2:
   pb=-.01; pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(ss2-sm2*sm2,1e-8); x=((x-pm)*np.sqrt(np.maximum(pv*(1-pb)+tpv*pb,1e-8)/pv)+(pm*(1-pb)+sm2*pb)).astype(np.float32)
 return x.astype(np.float64).mean(0).astype(np.float32)*rm
def ref(weights,h):
 x=np.concatenate([h,-h],0).astype(np.float32)
 for W in weights: x=np.maximum(x@W,0).astype(np.float32)
 return x.astype(np.float64).mean(0).astype(np.float32)*rad(weights[0].shape[0])
w=256; d=32; ks=[5124,6420,7714,9656,11598,12892,14962,18070,22600]
halves={k:half(k//2,w,12348) for k in ks}
hr=half(32768,w,9876)
rng=np.random.default_rng(42); errs={k:[] for k in ks}; t=time.time()
for i in range(5):

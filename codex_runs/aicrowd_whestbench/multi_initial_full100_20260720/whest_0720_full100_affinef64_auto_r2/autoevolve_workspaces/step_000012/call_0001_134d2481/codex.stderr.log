codex
Another variance-reduction option is empirical shrinkage across the 256 final neurons: if sample noise is larger than some neuron-level variation, a tiny shrink toward the layer mean can reduce MSE. I’ll screen that locally.
exec
/bin/bash -lc "python - <<'PY'
# Quick shrinkage screen using raw forward proxy: final vector toward its layer mean.
import os,math,time
os.environ.setdefault('OPENBLAS_NUM_THREADS','4')
os.environ.setdefault('OMP_NUM_THREADS','4')
import numpy as np

def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def half(cnt,w,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((cnt,w),dtype=np.float32); h=u/np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=h.astype(np.float64); c=(u64.T@u64)*(w/cnt); vals,vecs=np.linalg.eigh(c); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u64@inv).astype(np.float32); return h/np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
def forward(weights,h):
 x=np.concatenate([h,-h],0).astype(np.float32)
 for W in weights: x=np.maximum(x@W,0).astype(np.float32)
 return x.astype(np.float64).mean(0).astype(np.float32)*rad(weights[0].shape[0])
w=256;d=32;h=half(14962//2,w,12348);hr=half(65536//2,w,54321)
blends=[-.1,-.05,-.02,-.01,0,.01,.02,.05,.1,.2]
errs={b:[] for b in blends}; rng=np.random.default_rng(333); t=time.time()
for i in range(12):
 weights=[rng.standard_normal((w,w)).astype(np.float32)*math.sqrt(2/w) for _ in range(d)]
 p=forward(weights,h); r=forward(weights,hr); m=p.mean()
 for b in blends:
  pp=p*(1-b)+m*b
  errs[b].append(float(((pp-r)**2).mean()))
 print(i,'base',errs[0][-1],'best',min((errs[b][-1],b) for b in blends),'varp',float(p.var()),'elapsed',time.time()-t,flush=True)
print('avg')
base=np.mean(errs[0])
for b in blends: print(b,np.mean(errs[b]),np.mean(errs[b])/base)

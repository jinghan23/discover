INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
 ax=np.abs(x); t=1/(1+0.2316419*ax); poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))

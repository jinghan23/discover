+            + pre_mean * pre_std * density
+        )
+        post_variance = fnp.maximum(relu_second - mean * mean, 0.0)
+        covariance = fnp.outer(probability, probability) * pre_covariance
+        fnp.fill_diagonal(covariance, post_variance)
+    return mean
+

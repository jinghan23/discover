The public covariance estimator uses only the first-order ReLU covariance term. A second-order Price-theorem correction is cheap and may improve analytic variances without bivariate CDFs. I’ll prototype it locally and compare against the existing Monte Carlo estimate.
exec
/bin/bash -lc "python - <<'PY'
# Local test: second/third-order Price expansion covariance propagation.
import os,math,time
os.environ.setdefault('OPENBLAS_NUM_THREADS','4')
os.environ.setdefault('OMP_NUM_THREADS','4')
import numpy as np
INV=0.3989422804014327

def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
 ax=np.abs(x); t=1/(1+0.2316419*ax); poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
 tail=INV*np.exp(-.5*ax*ax)*poly; return np.where(x>=0,1-tail,tail)
def relu_m(m,v):
 v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; den=INV*np.exp(-.5*a*a); p=cdf(a); mean=s*den+m*p; second=(v+m*m)*p+m*s*den; return mean,second,p,den,a,s
def cov_est(weights,order=1):
 w=weights[0].shape[0]; mu=np.zeros(w,dtype=np.float64); cov=np.eye(w,dtype=np.float64)
 for Wf in weights:
  W=Wf.astype(np.float64); pm=W.T@mu; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-12); mean,sec,p,den,a,s=relu_m(pm,var); post=np.outer(p,p)*pc
  if order>=2:
   denom=np.maximum(np.outer(s,s),1e-12); rho_cov=(pc*pc)/denom
   post += 0.5*rho_cov*np.outer(den,den)
  if order>=3:
   denom=np.maximum(np.outer(var,var),1e-12); post += (pc*pc*pc/denom)*(np.outer(a*den,a*den)/6.0)
  np.fill_diagonal(post,np.maximum(sec-mean*mean,0))
  mu=mean; cov=post
 return mu.astype(np.float32)
def half(cnt,w,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((cnt,w),dtype=np.float32); h=u/np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=h.astype(np.float64); c=(u64.T@u64)*(w/cnt); vals,vecs=np.linalg.eigh(c); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u64@inv).astype(np.float32); return h/np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
def forward(weights,h):
 x=np.concatenate([h,-h],0).astype(np.float32)
 for W in weights: x=np.maximum(x@W,0).astype(np.float32)
 return x.astype(np.float64).mean(0).astype(np.float32)*rad(weights[0].shape[0])
w=256;d=32;h=half(14962//2,w,12348);hr=half(65536//2,w,123)
rng=np.random.default_rng(666); errs={'mc':[],'cov1':[],'cov2':[],'cov3':[]}; blends=[.01,.02,.05,.1,.2]; berr={b:[] for b in blends}; t=time.time()
for i in range(10):
 weights=[rng.standard_normal((w,w)).astype(np.float32)*math.sqrt(2/w) for _ in range(d)]
 r=forward(weights,hr); m=forward(weights,h); c1=cov_est(weights,1); c2=cov_est(weights,2); c3=cov_est(weights,3)
 for name,p in [('mc',m),('cov1',c1),('cov2',c2),('cov3',c3)]: errs[name].append(float(((p-r)**2).mean()))
 for b in blends: berr[b].append(float((((1-b)*m+b*c2-r)**2).mean()))
 print(i,{k:errs[k][-1] for k in errs},'bestblend',min((berr[b][-1],b) for b in blends),'elapsed',time.time()-t,flush=True)
print('avg')
for k in errs: print(k,np.mean(errs[k]),np.mean(errs[k])/np.mean(errs['mc']))
for b in blends: print('blend2',b,np.mean(berr[b]),np.mean(berr[b])/np.mean(errs['mc']))

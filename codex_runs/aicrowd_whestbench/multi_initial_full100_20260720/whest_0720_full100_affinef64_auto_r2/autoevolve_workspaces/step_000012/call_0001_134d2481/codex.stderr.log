 for li,W in enumerate(weights[2:],start=2):
  z=x@W
  if li==2:
   mb=-.02; zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); dc=np.maximum(ds-dm*dm,1e-8); am=dm@W; av=np.maximum(dc@(W*W),1e-8); bm=zm*(1-mb)+am*mb; bv=np.maximum(zv*(1-mb)+av*mb,1e-8); z=((z-zm)*np.sqrt(bv/zv)+bm).astype(np.float32); dm,ds=relum(bm,bv)
  x=np.maximum(z,0).astype(np.float32)
  if li==2:

One last structural idea is to use `mlp.seed` for a cheap per-MLP sign randomization of the cached spherical design. It keeps row norms and compute nearly unchanged, and it may reduce fixed-sample artifacts across the suite. I’ll screen coordinate-wise and element-wise sign flips locally.
exec
/bin/bash -lc "python - <<'PY'
# Screen per-MLP sign flips of cached directions with raw sphere forward proxy.
import os,math,time
os.environ.setdefault('OPENBLAS_NUM_THREADS','4')
os.environ.setdefault('OMP_NUM_THREADS','4')
import numpy as np

def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def half(cnt,w,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((cnt,w),dtype=np.float32); h=u/np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); u64=h.astype(np.float64); c=(u64.T@u64)*(w/cnt); vals,vecs=np.linalg.eigh(c); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u64@inv).astype(np.float32); return h/np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
def forward(weights,h):
 x=np.concatenate([h,-h],0).astype(np.float32)
 for W in weights: x=np.maximum(x@W,0).astype(np.float32)
 return x.astype(np.float64).mean(0).astype(np.float32)*rad(weights[0].shape[0])
w=256;d=32;cnt=14962//2;base=half(cnt,w,12348);href=half(65536//2,w,9876)
errs={'base':[],'coord':[],'elem':[]}; rng=np.random.default_rng(4444); t=time.time()
for i in range(10):
 weights=[rng.standard_normal((w,w)).astype(np.float32)*math.sqrt(2/w) for _ in range(d)]
 r=forward(weights,href)
 srng=np.random.default_rng(1000+i)
 coord=base*(srng.choice(np.array([-1,1],dtype=np.float32),size=(1,w)))
 elem=base*(srng.choice(np.array([-1,1],dtype=np.float32),size=base.shape))
 for n,h in [('base',base),('coord',coord),('elem',elem)]: errs[n].append(float(((forward(weights,h)-r)**2).mean()))
 print(i,{n:errs[n][-1] for n in errs},'elapsed',time.time()-t,flush=True)
print('avg')
for n in errs: print(n,np.mean(errs[n]),np.mean(errs[n])/np.mean(errs['base']))

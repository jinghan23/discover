 r=ref(weights,hr)
 for k,h in halves.items(): errs[k].append(float(((est(weights,h)-r)**2).mean()))
 print('mlp',i,{k:errs[k][-1] for k in ks},'elapsed',time.time()-t,flush=True)
print('avg')
for k in ks:
 frac={5124:.08,6420:.10,7714:.12,9656:.15,11598:.18,12892:.20,14962:.232,18070:.28,22600:.35}[k]

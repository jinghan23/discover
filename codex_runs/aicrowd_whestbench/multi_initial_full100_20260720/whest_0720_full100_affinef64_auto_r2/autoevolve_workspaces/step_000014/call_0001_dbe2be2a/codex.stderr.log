/bin/bash -lc "python - <<'PY'
import math,time
import torch
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench._simulation_torch import sample_layer_statistics_torch

INV=0.3989422804014327
PI=math.pi
TWO=2*math.pi

def radial_mean(width):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*(width+1.0))-math.lgamma(0.5*width))

def sample_count(budget,width,depth,frac=0.232,rounds=1):
    per=(2*depth-1)*width*width+depth*width+width*width
    fixed=rounds*9*width**3+2*(2*width**3)
    k=(int(frac*budget)-fixed)//max(per,1)
    maxb=100*1024*1024//max(width*8,1)
    k=int(max(32,min(1_000_000,maxb,k)))
    return k-(k&1)

def make_samples(width,k,seed=123,rounds=1):
    gen=torch.Generator().manual_seed(seed)
    count=k//2
    u=torch.randn((count,width),generator=gen,dtype=torch.float32)
    half=u/(u.square().sum(1,keepdim=True).clamp_min(1e-12).sqrt())
    for _ in range(rounds):
        u64=half.to(torch.float64)
        cov=(u64.T@u64)*(float(width)/float(count))
        evals,evecs=torch.linalg.eigh(cov)
        inv=(evecs/evals.clamp_min(1e-6).sqrt())@evecs.T
        half=(u64@inv).to(torch.float32)
        half=half/(half.square().sum(1,keepdim=True).clamp_min(1e-12).sqrt())
    return half

def normal_cdf(x):
    ax=x.abs(); t=1/(1+0.2316419*ax)
    poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
    tail=INV*torch.exp(-0.5*ax*ax)*poly
    return torch.where(x>=0,1-tail,tail)

def normal_relu(mean,var):
    var=var.clamp_min(1e-12); std=var.sqrt(); a=mean/std; den=INV*torch.exp(-0.5*a*a); p=normal_cdf(a)
    return std*den+mean*p, (var+mean*mean)*p+mean*std*den

def first_relu_second(w,var):
    gram=w.T@w
    std=var.clamp_min(1e-12).sqrt(); scale=std[:,None]*std[None,:]
    rho=(gram/scale.clamp_min(1e-12)).clamp(-1,1)
    root=(1-rho*rho).clamp_min(0).sqrt()
    return scale*(root+(PI-torch.acos(rho))*rho)/TWO

def predict_torch(weights, samples, params):
    width=weights[0].shape[0]; depth=len(weights); rm=radial_mean(width)
    fw=weights[0]
    fv=(fw*fw).sum(0)
    first_mean=fv.sqrt()*(INV/rm)
    proj=samples@fw
    x=torch.cat([proj.clamp_min(0), (-proj).clamp_min(0)],0)
    if depth==1:
        return first_mean*rm
    sm=x.mean(0); ss=(x*x).mean(0); sv=(ss-sm*sm).clamp_min(1e-6)
    tv=((fv*(0.5/width)-first_mean*first_mean)*params.get('first_var',1.0)).clamp_min(1e-12)
    x=(x-sm)*(tv/sv).sqrt()+first_mean
    fs=first_relu_second(fw,fv)/width
    fcov=fs-first_mean[:,None]*first_mean[None,:]
    sw=weights[1]
    z=x@sw
    tm=first_mean@sw
    cw=fcov@sw
    tv=((sw*cw).sum(0)*params.get('second_var',1.0)).clamp_min(1e-8)
    zm=z.mean(0); zs=(z*z).mean(0); zv=(zs-zm*zm).clamp_min(1e-8)
    x=((z-zm)*(tv/zv).sqrt()+tm).clamp_min(0)
    second_mean, second_second=normal_relu(tm,tv)
    spb=params.get('second_post',0.3)
    if spb:
        pm=x.mean(0); ps=(x*x).mean(0); pv=(ps-pm*pm).clamp_min(1e-8)
        tpv=(second_second-second_mean*second_mean).clamp_min(1e-8)
        bpm=pm*(1-spb)+second_mean*spb
        bpv=(pv*(1-spb)+tpv*spb).clamp_min(1e-8)
        x=(x-pm)*(bpv/pv).sqrt()+bpm
    for li,w in enumerate(weights[2:],start=2):
        z=x@w
        tmb=params.get('third_moment',-0.0175)
        if li==2 and tmb:
            zm=z.mean(0); zs=(z*z).mean(0); zv=(zs-zm*zm).clamp_min(1e-8)
            dc=(second_second-second_mean*second_mean).clamp_min(1e-8)
            mm=second_mean@w
            dv=(dc@(w*w)).clamp_min(1e-8)
            bm=zm*(1-tmb)+mm*tmb
            bv=(zv*(1-tmb)+dv*tmb).clamp_min(1e-8)
            z=(z-zm)*(bv/zv).sqrt()+bm
            second_mean,second_second=normal_relu(bm,bv)
        x=z.clamp_min(0)
        tpb=params.get('third_post',-0.01)
        if li==2 and tpb:
            pm=x.mean(0); ps=(x*x).mean(0); pv=(ps-pm*pm).clamp_min(1e-8)
            tpv=(second_second-second_mean*second_mean).clamp_min(1e-8)
            bpm=pm*(1-tpb)+second_mean*tpb
            bpv=(pv*(1-tpb)+tpv*tpb).clamp_min(1e-8)
            x=(x-pm)*(bpv/pv).sqrt()+bpm
    return x.to(torch.float64).mean(0).to(torch.float32)*(rm*params.get('scale',1.0))

# benchmark 3 mlps target 100k, prediction
width=256; depth=32; budget=272_000_000_000; frac=0.232; rounds=1; k=sample_count(budget,width,depth,frac,rounds)
print('k',k)
samples=make_samples(width,k,126,rounds)
mlps=[]
seedseq=fnp.random.SeedSequence(2026).spawn(10)
for i in range(3):
    rng=fnp.random.default_rng(seedseq[i])
    mlp=sample_mlp(width,depth,rng,seed=i+1)
    weights=torch.stack([torch.tensor(w,dtype=torch.float32) for w in mlp.weights])
    mlps.append(weights)

t0=time.time()
preds=[predict_torch(w,samples,{}) for w in mlps]
print('predict sec',time.time()-t0)
# target batch
wb=torch.stack(mlps)
gens=[torch.Generator().manual_seed(9000+i) for i in range(len(mlps))]
t0=time.time(); lm,fm,av=sample_layer_statistics_torch(wb,100000,gens,chunk_size=4096,compile=False); print('target sec',time.time()-t0)
mses=[float(((preds[i]-fm[i])**2).mean()) for i in range(len(mlps))]
print('mses',mses,'mean',sum(mses)/len(mses))

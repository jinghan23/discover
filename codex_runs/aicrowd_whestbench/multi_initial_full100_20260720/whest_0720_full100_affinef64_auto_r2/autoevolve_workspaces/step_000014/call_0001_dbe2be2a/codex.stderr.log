def get_samples(frac,rounds):
    key=(frac,rounds)
    if key not in sample_cache:
        k=sample_count(BUDGET,WIDTH,DEPTH,frac,rounds)
        sample_cache[key]=make_samples(WIDTH,k,126,rounds)
        print('made samples',key,k)
    return sample_cache[key]

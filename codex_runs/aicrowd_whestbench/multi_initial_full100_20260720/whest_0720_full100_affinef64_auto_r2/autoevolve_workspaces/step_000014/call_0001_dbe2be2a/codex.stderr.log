    proj=samples@fw; x=torch.cat([proj.clamp_min(0), (-proj).clamp_min(0)],0)
    sm=x.mean(0); ss=(x*x).mean(0); sv=(ss-sm*sm).clamp_min(1e-6)
    tv=((fv*(0.5/width)-first_mean*first_mean)*p.get('first_var',1.0)).clamp_min(1e-12)
    x=(x-sm)*(tv/sv).sqrt()+first_mean
    fs=first_relu_second(fw,fv)/width; fcov=fs-first_mean[:,None]*first_mean[None,:]
    sw=weights[1]; z=x@sw; tm=first_mean@sw; cw=fcov@sw
    tv=((sw*cw).sum(0)*p.get('second_var',1.0)).clamp_min(1e-8)
    zm=z.mean(0); zs=(z*z).mean(0); zv=(zs-zm*zm).clamp_min(1e-8)
    x=((z-zm)*(tv/zv).sqrt()+tm).clamp_min(0)
    second_mean, second_second=normal_relu(tm,tv)
    spb=p.get('second_post',0.3)
    if spb:
        pm=x.mean(0); ps=(x*x).mean(0); pv=(ps-pm*pm).clamp_min(1e-8)
        tpv=(second_second-second_mean*second_mean).clamp_min(1e-8)
        bpm=pm*(1-spb)+second_mean*spb; bpv=(pv*(1-spb)+tpv*spb).clamp_min(1e-8)
        x=(x-pm)*(bpv/pv).sqrt()+bpm
    for li,w in enumerate(weights[2:],start=2):
        z=x@w
        tmb=p.get('third_moment',-0.0175)
        if li==2 and tmb:
            zm=z.mean(0); zs=(z*z).mean(0); zv=(zs-zm*zm).clamp_min(1e-8)
            dc=(second_second-second_mean*second_mean).clamp_min(1e-8)
            mm=second_mean@w; dv=(dc@(w*w)).clamp_min(1e-8)
            bm=zm*(1-tmb)+mm*tmb; bv=(zv*(1-tmb)+dv*tmb).clamp_min(1e-8)
            z=(z-zm)*(bv/zv).sqrt()+bm
            second_mean,second_second=normal_relu(bm,bv)
        x=z.clamp_min(0)
        tpb=p.get('third_post',-0.01)
        if li==2 and tpb:
            pm=x.mean(0); ps=(x*x).mean(0); pv=(ps-pm*pm).clamp_min(1e-8)
            tpv=(second_second-second_mean*second_mean).clamp_min(1e-8)
            bpm=pm*(1-tpb)+second_mean*tpb; bpv=(pv*(1-tpb)+tpv*tpb).clamp_min(1e-8)
            x=(x-pm)*(bpv/pv).sqrt()+bpm
    return x.to(torch.float64).mean(0).to(torch.float32)*(rm*p.get('scale',1.0))

def score_variant(samples,p,frac):
    ms=[]
    for w,target in zip(weights_list,targets):
        pred=predict_torch(w,samples,p)
        ms.append(float(((pred-target)**2).mean()))
    raw=sum(ms)/len(ms)
    mult=max(0.1, frac)
    return raw,raw*mult


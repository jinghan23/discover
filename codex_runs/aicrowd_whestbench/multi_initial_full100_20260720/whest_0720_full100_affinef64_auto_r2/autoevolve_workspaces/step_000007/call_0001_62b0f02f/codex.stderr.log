/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*PI
def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def Phi(a): return 0.5*(1+np.vectorize(math.erf)(a/math.sqrt(2)))
def relu_m2(mu,var):
 std=np.sqrt(np.maximum(var,1e-12)); aa=mu/std; phi=INV*np.exp(-.5*aa*aa); c=Phi(aa); return std*phi+mu*c,(var+mu*mu)*c+mu*std*phi
def make(w,k,seed):
 rng=np.random.default_rng(seed); h=rng.standard_normal((k//2,w)).astype(np.float32); h/=np.maximum(np.linalg.norm(h,axis=1,keepdims=True),1e-12)
 for _ in range(4):
  u=h.astype(np.float64); cov=(u.T@u)*(w/len(h)); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u@inv).astype(np.float32); h/=np.maximum(np.linalg.norm(h,axis=1,keepdims=True),1e-12)

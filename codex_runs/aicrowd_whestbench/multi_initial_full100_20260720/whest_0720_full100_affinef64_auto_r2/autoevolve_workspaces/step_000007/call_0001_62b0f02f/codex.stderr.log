/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*PI

def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def whiten(half,width,rounds=4):
 for _ in range(rounds):
  u=half.astype(np.float64); cov=(u.T@u)*(width/len(half)); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; half=(u@inv).astype(np.float32); half/=np.maximum(np.linalg.norm(half,axis=1,keepdims=True),1e-12)
 return half
def make(width,k,seed,blocks=1):
 rng=np.random.default_rng(seed); n=k//2
 if blocks==1:
  half=rng.standard_normal((n,width)).astype(np.float32); half/=np.maximum(np.linalg.norm(half,axis=1,keepdims=True),1e-12); return whiten(half,width)
 sizes=[n//blocks]*blocks
 for i in range(n%blocks): sizes[i]+=1
 arr=[]
 for sz in sizes:
  # require at least width+1; fallback
  h=rng.standard_normal((sz,width)).astype(np.float32); h/=np.maximum(np.linalg.norm(h,axis=1,keepdims=True),1e-12); arr.append(whiten(h,width))
 return np.concatenate(arr,0)
def first_second(W,var):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]; rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); return scale*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO
def pred(weights,k=2048,blocks=1):
 w=weights[0].shape[0]; d=len(weights); rm=radial_mean(w); samples=make(w,k,123,blocks)
 W0=weights[0]; var=np.sum(W0*W0,0); fm=np.sqrt(var)*(INV/rm); proj=samples@W0; x=np.concatenate([np.maximum(proj,0),np.maximum(-proj,0)],0)
 if d==1: return fm*rm
 sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6); tv=np.maximum(var*(0.5/w)-fm*fm,1e-12); x=(x-sm)*np.sqrt(tv/sv)+fm
 fs=first_second(W0,var)/w; fc=fs-fm[:,None]*fm[None,:]; W=weights[1]; z=x@W; tm=fm@W; cw=fc@W; tv=np.maximum(np.sum(W*cw,0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
 for W in weights[2:]: x=np.maximum(x@W,0)
 return x.mean(0)*rm
def truth(weights,n=100000,seed=9):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; acc=np.zeros(w); done=0
 while done<n:
  b=min(10000,n-done); x=rng.standard_normal((b,w))
  for W in weights: x=np.maximum(x@W,0)
  acc+=x.sum(0); done+=b
 return acc/n
for width,depth,k in [(64,6,2048),(64,8,2048),(128,6,2048)]:
 vals=[]
 for seed in range(5):
  rng=np.random.default_rng(seed); weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]; t=truth(weights,seed=99+seed)
  vals.append([np.mean((pred(weights,k,b)-t)**2) for b in [1,2,4,8]])
 vals=np.mean(vals,0); print('case',width,depth,'mse blocks1,2,4,8',vals, vals/vals[0])

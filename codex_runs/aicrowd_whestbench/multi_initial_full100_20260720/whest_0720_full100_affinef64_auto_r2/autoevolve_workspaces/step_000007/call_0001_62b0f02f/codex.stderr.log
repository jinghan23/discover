/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=0.3989422804014327
PI=math.pi; TWO=2*math.pi

def radial_mean(w):
    return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def make_samples(width,k,seed,rounds=2):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    half=u/np.maximum(np.linalg.norm(u,axis=1,keepdims=True),1e-12)
    for _ in range(rounds):
        u64=half.astype(np.float64)
        cov=(u64.T@u64)*(width/(k//2))
        vals,vecs=np.linalg.eigh(cov)
        inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T
        half=(u64@inv).astype(np.float32)
        half=half/np.maximum(np.linalg.norm(half,axis=1,keepdims=True),1e-12)
    return half

def first_relu_second(weight, variance):
    gram=weight.T@weight
    std=np.sqrt(np.maximum(variance,1e-12))
    scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def phi_cdf(a):
    # numpy erf available
    return 0.5*(1+np.vectorize(math.erf)(a/math.sqrt(2)))

def relu_normal_mean(mu,var):
    std=np.sqrt(np.maximum(var,1e-12))
    a=mu/std
    phi=INV*np.exp(-0.5*a*a)
    Phi=0.5*(1+np.array([math.erf(x/math.sqrt(2)) for x in a.ravel()]).reshape(a.shape))
    return std*phi+mu*Phi

def pred(weights,k=2048,final_gauss=False,blend=0):
    w=weights[0].shape[0]; d=len(weights); rm=radial_mean(w)
    samples=make_samples(w,k,123,2)
    first=weights[0]
    var=np.sum(first*first,axis=0)
    fm=np.sqrt(var)*(INV/rm)
    proj=samples@first
    x=np.concatenate([np.maximum(proj,0),np.maximum(-proj,0)],0)
    if d==1: return fm*rm
    sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=np.maximum(var*(0.5/w)-fm*fm,1e-12)
    x=(x-sm)*np.sqrt(tv/sv)+fm
    if d>1:
        fs=first_relu_second(first,var)/w
        fc=fs-fm[:,None]*fm[None,:]
        W=weights[1]
        z=x@W
        tm=fm@W
        cw=fc@W
        tv=np.maximum(np.sum(W*cw,axis=0),1e-8)
        zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
        z=(z-zm)*np.sqrt(tv/zv)+tm
        if d==2 and final_gauss:
            gm=relu_normal_mean(tm,tv)
            smp=np.maximum(z,0).mean(0)
            return (blend*smp+(1-blend)*gm)*rm
        x=np.maximum(z,0)
    for idx,W in enumerate(weights[2:], start=2):
        z=x@W
        if final_gauss and idx==d-1:
            zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
            gm=relu_normal_mean(zm,zv)
            smp=np.maximum(z,0).mean(0)
            return (blend*smp+(1-blend)*gm)*rm
        x=np.maximum(z,0)
    return x.mean(0)*rm

def truth(weights,n=200000,seed=9,batch=20000):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    acc=np.zeros(w)
    done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,w))
        for W in weights: x=np.maximum(x@W,0)
        acc += x.sum(0); done += b
    return acc/n

for width,depth,k in [(32,4,1024),(64,6,1024),(64,8,2048),(128,6,1024)]:
    errs=[]
    for seed in range(5):
        rng=np.random.default_rng(seed)
        weights=[rng.standard_normal((width,width))/math.sqrt(width) for _ in range(depth)]
        t=truth(weights,n=100000,seed=100+seed,batch=10000)
        p=pred(weights,k=k,final_gauss=False)
        g=pred(weights,k=k,final_gauss=True,blend=0)
        b=pred(weights,k=k,final_gauss=True,blend=0.5)
        errs.append((np.mean((p-t)**2),np.mean((g-t)**2),np.mean((b-t)**2)))
    print('case',width,depth,k,'mean mse current,gauss,blend',np.mean(errs,0), 'ratios', np.mean(errs,0)/np.mean(errs,0)[0])

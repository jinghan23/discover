The 1% diagonal blend is worse (`2.76880e-07`), so I’ll remove it for the final candidate. I’m going to test one alternative direction set locally: randomized Rademacher/Hadamard-style directions, which can lower projection variance but changes the spherical distribution.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*PI
# Compare Gaussian-sphere directions vs Rademacher directions with same moment corrections.
def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def whiten(half,width,rounds=4):
 for _ in range(rounds):
  u=half.astype(np.float64); cov=(u.T@u)*(width/len(half)); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; half=(u@inv).astype(np.float32); half/=np.maximum(np.linalg.norm(half,axis=1,keepdims=True),1e-12)
 return half
def make(width,k,seed,kind):
 rng=np.random.default_rng(seed); n=k//2
 if kind=='normal':
  h=rng.standard_normal((n,width)).astype(np.float32); h/=np.maximum(np.linalg.norm(h,axis=1,keepdims=True),1e-12); return whiten(h,width)
 if kind=='rademacher':
  h=rng.choice([-1,1],size=(n,width)).astype(np.float32)/math.sqrt(width); return whiten(h,width)
 if kind=='mix':
  n1=n//2; h1=rng.standard_normal((n1,width)).astype(np.float32); h1/=np.maximum(np.linalg.norm(h1,axis=1,keepdims=True),1e-12); h2=rng.choice([-1,1],size=(n-n1,width)).astype(np.float32)/math.sqrt(width); return whiten(np.concatenate([h1,h2],0),width)
def first_second(W,var):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]; rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); return scale*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO
def pred(weights,k,kind):
 w=weights[0].shape[0]; rm=radial_mean(w); samples=make(w,k,123,kind); W0=weights[0]; var=np.sum(W0*W0,0); fm=np.sqrt(var)*(INV/rm); proj=samples@W0; x=np.concatenate([np.maximum(proj,0),np.maximum(-proj,0)],0)
 if len(weights)==1: return fm*rm

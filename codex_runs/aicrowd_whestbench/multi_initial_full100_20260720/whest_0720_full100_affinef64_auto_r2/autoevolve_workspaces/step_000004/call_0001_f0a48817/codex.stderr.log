    mlp=sample_mlp(width, depth, fnp.random.default_rng(33100+i), seed=34100+i)
    target=sample_layer_statistics(mlp,n_target,rng=fnp.random.default_rng(35100+i))[1]
    mlps.append(mlp); targets.append(fnp.asarray(target,dtype=fnp.float32))

    target=sample_layer_statistics(mlp,n_target,rng=fnp.random.default_rng(47100+i))[1]
    mlps.append(mlp); targets.append(fnp.asarray(target,dtype=fnp.float32))
print('"'targets ready')
for name,Cls in [('current',submission.Estimator),('secondpost',SecondPostMatch)]:
    est=Cls(); est.setup(SetupContext(width=width,depth=depth,flop_budget=budget,api_version='x',seed=123))
    ms=[]
    for mlp,t in zip(mlps,targets):
        p=fnp.asarray(est.predict(mlp,budget)[-1],dtype=fnp.float32)
        ms.append(float(fnp.mean((p-t)**2)))
    print(name, sum(ms)/len(ms), ms)

    target=sample_layer_statistics(mlp, n_target, rng=fnp.random.default_rng(6100+i))[1]
    mlps.append(mlp); targets.append(fnp.asarray(target,dtype=fnp.float32))
print('targets ready')

def eval_variant(f1, f2):
    submission._FIRST_VARIANCE_FACTOR=f1
    submission._SECOND_VARIANCE_FACTOR=f2
    submission._FINAL_SCALE=0.9999375
    est=submission.Estimator(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=123))

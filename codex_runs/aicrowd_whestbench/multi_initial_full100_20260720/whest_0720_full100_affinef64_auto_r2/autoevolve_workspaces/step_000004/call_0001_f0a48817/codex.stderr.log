/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

_INV_SQRT_2PI=0.3989422804014327
_SQRT_2_OVER_PI=0.7978845608028654

def phi(x):
    return _INV_SQRT_2PI * fnp.exp(-0.5 * x * x)

def Phi(x):
    return 0.5 * (1.0 + fnp.tanh(_SQRT_2_OVER_PI * (x + 0.044715 * x * x * x)))

def relu_moments(mu, var):
    std=fnp.sqrt(fnp.maximum(var,1e-12))
    a=mu/std
    c=Phi(a)
    p=phi(a)
    mean=std*p + mu*c
    second=(var+mu*mu)*c + mu*std*p
    v=fnp.maximum(second-mean*mean,1e-12)
    return mean,v

def diag_est(mlp):
    w=mlp.weights[0]
    var=fnp.sum(w*w, axis=0)
    mean=fnp.sqrt(var)*_INV_SQRT_2PI
    second=0.5*var
    act_var=fnp.maximum(second-mean*mean,1e-12)
    for w in mlp.weights[1:]:
        mu=mean @ w
        var=fnp.sum((w*w)*act_var[:,None], axis=0)
        mean, act_var=relu_moments(mu,var)
    return fnp.asarray(mean,dtype=fnp.float32)

width=256; depth=32; budget=272_000_000_000; n_target=250_000; n_mlps=5
est=submission.Estimator(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=123))
mc=[]; diag=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(15100+i), seed=16100+i)
    target=fnp.asarray(sample_layer_statistics(mlp, n_target, rng=fnp.random.default_rng(17100+i))[1],dtype=fnp.float32)
    targets.append(target)
    mc.append(fnp.asarray(est.predict(mlp,budget)[-1],dtype=fnp.float32))
    diag.append(diag_est(mlp))
print('ready')
for a in [-0.5,-0.2,0.0,0.05,0.1,0.2,0.4,0.6,0.8,0.9,0.95,1.0,1.05,1.1,1.2,1.5]:
    ms=[]
    for m,d,t in zip(mc,diag,targets):
        pred=m*a+d*(1.0-a)
        ms.append(float(fnp.mean((pred-t)**2)))
    print(a, sum(ms)/len(ms), ms)
# Also diag alone magnitude

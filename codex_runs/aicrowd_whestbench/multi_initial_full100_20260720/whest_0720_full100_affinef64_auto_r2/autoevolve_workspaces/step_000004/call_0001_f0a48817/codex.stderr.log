/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

_INV=0.3989422804014327

def norm_cdf(x):
    ax=fnp.abs(x); t=1.0/(1.0+0.2316419*ax)
    poly=(((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t)
    c=1.0-_INV*fnp.exp(-0.5*ax*ax)*poly
    return fnp.where(x>=0.0,c,1.0-c)

def relu_mom(mu,var):
    std=fnp.sqrt(fnp.maximum(var,1e-12)); a=mu/std
    phi=_INV*fnp.exp(-0.5*a*a); c=norm_cdf(a)
    mean=std*phi+mu*c
    second=(var+mu*mu)*c+mu*std*phi
    return mean, fnp.maximum(second-mean*mean,1e-8)

class SecondPostMatch(submission.Estimator):
    def predict(self, mlp, budget):
        width=mlp.width; depth=mlp.depth
        if (not hasattr(self,'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth):
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed); self._depth=depth
        fw=mlp.weights[0]
        fv=fnp.sum(fw*fw,axis=0); fm=fnp.sqrt(fv)*submission._INV_SQRT_2PI
        fp=self._samples@fw
        x=fnp.concatenate([fnp.maximum(fp,0.0),fnp.maximum(-fp,0.0)],axis=0)
        if depth==1:
            final=fm
        else:
            sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
            tv=fv*(0.5-submission._INV_SQRT_2PI*submission._INV_SQRT_2PI)
            x=(x-sm)*fnp.sqrt(tv/sv)+fm
            fc=submission._first_relu_covariance(fw,fv,fm)
            sw=mlp.weights[1]
            z=x@sw
            tm=fm@sw; cw=fc@sw
            tv2=fnp.maximum(fnp.sum(sw*cw,axis=0),1e-8)
            zm=fnp.mean(z,axis=0); zs=fnp.mean(z*z,axis=0); zv=fnp.maximum(zs-zm*zm,1e-8)
            pre=(z-zm)*fnp.sqrt(tv2/zv)+tm
            x=fnp.maximum(pre,0.0)
            gm, gv=relu_mom(tm,tv2)
            xm=fnp.mean(x,axis=0); xs=fnp.mean(x*x,axis=0); xv=fnp.maximum(xs-xm*xm,1e-8)
            x=(x-xm)*fnp.sqrt(gv/xv)+gm
            for w in mlp.weights[2:]:
                x=fnp.maximum(x@w,0.0)
            final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)*submission._FINAL_SCALE
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32), final[None,:]],axis=0)

width=256; depth=32; budget=272_000_000_000; n_target=220_000; n_mlps=5

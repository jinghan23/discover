codex
The network is positively homogeneous: `f(r * s) = r^depth * f(s)` for `r > 0`. That means we can integrate the Gaussian radius analytically and spend samples only on sphere directions. I’m testing that as a separate estimator locally; it may reduce a major source of Monte Carlo variance.
exec
/bin/bash -lc "python - <<'PY'
import math
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

class SphereEstimator(submission.Estimator):
    def setup(self, context):
        self._width=int(context.width); self._depth=int(context.depth)
        # current sample count for fair comparison
        self._samples=self._make_samples(self._width, submission._sample_count(int(context.flop_budget), self._width, self._depth), int(context.seed)+3)
        w=self._width; d=self._depth
        self._radial=math.exp((0.5*d)*math.log(2.0)+math.lgamma(0.5*(w+d))-math.lgamma(0.5*w)-0.5*d*math.log(float(w)))
    def _make_samples(self,width,k,seed):
        rng=fnp.random.default_rng(seed)
        u=rng.standard_normal((k//2,width), dtype=fnp.float32)
        u64=fnp.asarray(u,dtype=fnp.float64)
        norm=fnp.sqrt(fnp.maximum(fnp.sum(u64*u64,axis=1),1e-12))
        return fnp.asarray(u64*(math.sqrt(width)/norm)[:,None], dtype=fnp.float32)
    def predict(self, mlp, budget):
        width=mlp.width; depth=mlp.depth
        if not hasattr(self,'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
            self._width=width; self._depth=depth
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed)
            self._radial=math.exp((0.5*depth)*math.log(2.0)+math.lgamma(0.5*(width+depth))-math.lgamma(0.5*width)-0.5*depth*math.log(float(width)))
        x=fnp.concatenate([self._samples, -self._samples], axis=0)
        for w in mlp.weights:
            x=fnp.maximum(x @ w, 0.0)
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)*float(self._radial)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32), final[None,:]], axis=0)

class SphereWhitenEstimator(SphereEstimator):
    def _make_samples(self,width,k,seed):
        rng=fnp.random.default_rng(seed)
        u=rng.standard_normal((k//2,width), dtype=fnp.float32)
        y=fnp.asarray(u,dtype=fnp.float64)
        for _ in range(2):
            norm=fnp.sqrt(fnp.maximum(fnp.sum(y*y,axis=1),1e-12))
            y=y*(math.sqrt(width)/norm)[:,None]
            cov=(y.T@y)/float(k//2)
            ev,evec=fnp.linalg.eigh(cov)
            inv=(evec/fnp.sqrt(fnp.maximum(ev,1e-6)))@evec.T
            y=y@inv
        norm=fnp.sqrt(fnp.maximum(fnp.sum(y*y,axis=1),1e-12))
        y=y*(math.sqrt(width)/norm)[:,None]
        return fnp.asarray(y,dtype=fnp.float32)


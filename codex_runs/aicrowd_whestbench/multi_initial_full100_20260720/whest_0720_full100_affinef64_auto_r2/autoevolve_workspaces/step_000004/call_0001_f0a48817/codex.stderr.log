        if depth==1:
            final=fm
        else:
            x64=fnp.asarray(x,dtype=fnp.float64)
            sm=fnp.mean(x64,axis=0); ss=fnp.mean(x64*x64,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
            tv=fnp.asarray(fv*(0.5-submission._INV_SQRT_2PI*submission._INV_SQRT_2PI),dtype=fnp.float64)

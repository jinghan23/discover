import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

class FullSecond(submission.Estimator):
    def predict(self, mlp, budget):
        width=mlp.width; depth=mlp.depth
        if (not hasattr(self,'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth):
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed)
            self._depth=depth
        first_weight=mlp.weights[0]
        first_variance=fnp.sum(first_weight*first_weight, axis=0)
        first_mean=fnp.sqrt(first_variance)*submission._INV_SQRT_2PI
        first_projection=self._samples @ first_weight
        x=fnp.concatenate([fnp.maximum(first_projection,0.0),fnp.maximum(-first_projection,0.0)],axis=0)
        if depth==1:
            return fnp.concatenate([fnp.zeros((0,width),dtype=fnp.float32), first_mean[None,:]], axis=0)
        sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
        tv=first_variance*(0.5-submission._INV_SQRT_2PI*submission._INV_SQRT_2PI)
        x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
        first_cov=submission._first_relu_covariance(first_weight, first_variance, first_mean)
        second_weight=mlp.weights[1]
        z=x @ second_weight
        target_mean=first_mean @ second_weight
        covw=first_cov @ second_weight
        target_cov=second_weight.T @ covw
        z64=fnp.asarray(z,dtype=fnp.float64)
        z_mean=fnp.mean(z64,axis=0)
        zc=z64-z_mean
        sample_cov=(zc.T@zc)/float(z.shape[0])
        se, su=fnp.linalg.eigh(sample_cov)
        te, tu=fnp.linalg.eigh(target_cov)
        inv_s=(su/fnp.sqrt(fnp.maximum(se,1e-8)))@su.T
        sqrt_t=(tu*fnp.sqrt(fnp.maximum(te,1e-10)))@tu.T
        zmatch=fnp.asarray((zc@inv_s)@sqrt_t + target_mean, dtype=fnp.float32)
        x=fnp.maximum(zmatch,0.0)
        for weight in mlp.weights[2:]:
            x=fnp.maximum(x @ weight,0.0)
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)*submission._FINAL_SCALE
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32), final[None,:]],axis=0)


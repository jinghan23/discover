import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

width=256; depth=32; budget=272_000_000_000; n_target=200_000; n_mlps=4
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(11100+i), seed=12100+i)
    target=sample_layer_statistics(mlp, n_target, rng=fnp.random.default_rng(13100+i))[1]
    mlps.append(mlp); targets.append(fnp.asarray(target,dtype=fnp.float32))
print('targets ready')

class RawEstimator(submission.Estimator):
    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        return rng.standard_normal((k // 2, width), dtype=fnp.float32)

class RadialEstimator(submission.Estimator):
    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        u = rng.standard_normal((k // 2, width), dtype=fnp.float32)
        u64 = fnp.asarray(u, dtype=fnp.float64)
        r = fnp.sqrt(fnp.maximum(fnp.sum(u64 * u64, axis=1), 1e-12))
        covariance = (u64.T @ u64) / float(k // 2)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        y = u64 @ inverse_sqrt
        yr = fnp.sqrt(fnp.maximum(fnp.sum(y * y, axis=1), 1e-12))
        z = y * (r / yr)[:, None]
        # Light recenter and covariance correction after radial restoration.
        z = z - fnp.mean(z, axis=0)
        cov2 = (z.T @ z) / float(k // 2)
        ev2, evec2 = fnp.linalg.eigh(cov2)
        ev2 = fnp.maximum(ev2, 1e-6)
        inv2 = (evec2 / fnp.sqrt(ev2)) @ evec2.T
        return fnp.asarray(z @ inv2, dtype=fnp.float32)

class CenterWhitenEstimator(submission.Estimator):
    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        u = rng.standard_normal((k // 2, width), dtype=fnp.float32)
        u64 = fnp.asarray(u, dtype=fnp.float64)
        u64 = u64 - fnp.mean(u64, axis=0)
        covariance = (u64.T @ u64) / float(k // 2)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        return fnp.asarray(u64 @ inverse_sqrt, dtype=fnp.float32)

for name, Cls in [('current', submission.Estimator), ('raw', RawEstimator), ('centerwhite', CenterWhitenEstimator), ('radial', RadialEstimator)]:
    est=Cls(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=123))
    ms=[]
    for mlp,target in zip(mlps,targets):
        pred=fnp.asarray(est.predict(mlp,budget)[-1],dtype=fnp.float32)
        ms.append(float(fnp.mean((pred-target)**2)))
    print(name, sum(ms)/len(ms), ms)

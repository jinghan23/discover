from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import SetupContext
modspec=importlib.util.spec_from_file_location('subm_bfrac', pathlib.Path('submission.py'))
mod=importlib.util.module_from_spec(modspec); modspec.loader.exec_module(mod)
base={k:getattr(mod,k) for k in ['_BUDGET_FRACTION','_SECOND_POST_BLEND','_THIRD_POST_BLEND','_THIRD_MOMENT_BLEND','_FINAL_SCALE']}
specs=[
    ContestSpec(width=64, depth=8, n_mlps=8, flop_budget=2_000_000_000, ground_truth_samples=1_000_000, seed=3101, wall_time_limit_s=120.0),
    ContestSpec(width=64, depth=8, n_mlps=8, flop_budget=8_000_000_000, ground_truth_samples=1_000_000, seed=3102, wall_time_limit_s=120.0),
    ContestSpec(width=128, depth=8, n_mlps=6, flop_budget=8_000_000_000, ground_truth_samples=600_000, seed=3103, wall_time_limit_s=120.0),
]
print('making')
data=[]
for s in specs:
    t=time.time(); data.append(make_contest(s)); print('made',s.width,s.depth,s.flop_budget,round(time.time()-t,2))
for frac in [0.16,0.20,0.2318,0.27,0.32,0.38,0.45,0.55,0.7]:

/bin/bash -lc "python - <<'PY'
import importlib.util, pathlib, time, itertools
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import SetupContext
modspec=importlib.util.spec_from_file_location('subm_combo', pathlib.Path('submission.py'))
mod=importlib.util.module_from_spec(modspec); modspec.loader.exec_module(mod)
base={k:getattr(mod,k) for k in ['_BUDGET_FRACTION','_SECOND_POST_BLEND','_THIRD_POST_BLEND','_THIRD_MOMENT_BLEND','_FINAL_SCALE','_SECOND_VARIANCE_FACTOR','_FIRST_VARIANCE_FACTOR']}
specs=[
    ContestSpec(width=64, depth=4, n_mlps=10, flop_budget=800_000_000, ground_truth_samples=1_000_000, seed=4101, wall_time_limit_s=120.0),
    ContestSpec(width=64, depth=8, n_mlps=10, flop_budget=800_000_000, ground_truth_samples=1_000_000, seed=4102, wall_time_limit_s=120.0),
    ContestSpec(width=128, depth=4, n_mlps=8, flop_budget=2_000_000_000, ground_truth_samples=700_000, seed=4103, wall_time_limit_s=120.0),
]
print('making')
data=[]
for s in specs:
    t=time.time(); data.append(make_contest(s)); print('made',s.width,s.depth,round(time.time()-t,2))

def run(params):
    for k,v in base.items(): setattr(mod,k,v)
    for k,v in params.items(): setattr(mod,k,v)
    vals=[]
    for spec,cd in zip(specs,data):
        est=mod.Estimator(); est.setup(SetupContext(spec.width,spec.depth,spec.flop_budget,'local',seed=999))
        res=evaluate_estimator(est, cd)
        vals.append((res['adjusted_final_layer_score'],res['final_layer_mse'],res['mean_score_multiplier']))
    return sum(v[0] for v in vals)/len(vals), sum(v[1] for v in vals)/len(vals), vals
cands=[]
for sb,tmb,tpb,scale in itertools.product(
    [0.0,0.15,0.25,0.3,0.35,0.45],
    [-0.03,-0.018,-0.008,0.0,0.008,0.02],
    [-0.02,-0.01,0.0,0.01,0.02],
    [0.9997,0.99998,1.0001],
):
    # Skip known bad: moment blend zero with nonzero third post uses stale target moments.
    if tmb == 0.0 and tpb "'!= 0.0:
        continue
    params={'"'_SECOND_POST_BLEND':sb,'_THIRD_MOMENT_BLEND':tmb,'_THIRD_POST_BLEND':tpb,'_FINAL_SCALE':scale}
    adj,mse,vals=run(params)
    cands.append((adj,mse,params,vals))
for adj,mse,params,vals in sorted(cands)[:20]:
    print('top',adj,mse,params,'rows',[(round(a,8),round(m,8),round(mult,3)) for a,m,mult in vals])

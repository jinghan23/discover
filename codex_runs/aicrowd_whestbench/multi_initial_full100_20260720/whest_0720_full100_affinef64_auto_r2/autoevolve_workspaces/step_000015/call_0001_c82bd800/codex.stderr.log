import importlib.util, pathlib, time, itertools
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import SetupContext
path=pathlib.Path('submission.py')
modspec=importlib.util.spec_from_file_location('subm_search', path)
mod=importlib.util.module_from_spec(modspec); modspec.loader.exec_module(mod)
# Synthetic panels chosen to stress shallow/deep and moderate width.
specs=[
    ContestSpec(width=64, depth=4, n_mlps=8, flop_budget=400_000_000, ground_truth_samples=1_000_000, seed=2101, wall_time_limit_s=120.0),
    ContestSpec(width=64, depth=8, n_mlps=8, flop_budget=400_000_000, ground_truth_samples=1_000_000, seed=2102, wall_time_limit_s=120.0),
    ContestSpec(width=128, depth=4, n_mlps=6, flop_budget=1_000_000_000, ground_truth_samples=600_000, seed=2103, wall_time_limit_s=120.0),
]
print('making contests')
data=[]
for spec in specs:
    t=time.time(); data.append(make_contest(spec)); print('made',spec.width,spec.depth,'s',round(time.time()-t,2))
base={
    '_BUDGET_FRACTION': mod._BUDGET_FRACTION,
    '_SECOND_POST_BLEND': mod._SECOND_POST_BLEND,
    '_THIRD_POST_BLEND': mod._THIRD_POST_BLEND,
    '_THIRD_MOMENT_BLEND': mod._THIRD_MOMENT_BLEND,
    '_FINAL_SCALE': mod._FINAL_SCALE,
}

def run(params):
    for k,v in {**base, **params}.items(): setattr(mod,k,v)
    rows=[]
    for spec,cd in zip(specs,data):
        est=mod.Estimator(); est.setup(SetupContext(spec.width,spec.depth,spec.flop_budget,'local',seed=999))
        res=evaluate_estimator(est,cd)
        rows.append((res['adjusted_final_layer_score'],res['final_layer_mse'],res['mean_score_multiplier'],res['n_failed_mlps']))
    avg_adj=sum(r[0] for r in rows)/len(rows)
    avg_mse=sum(r[1] for r in rows)/len(rows)
    return avg_adj,avg_mse,rows

cands=[]
# Baseline and one-at-a-time sweeps.
param_grid=[]
param_grid.append({})
for v in [0.15,0.2,0.25,0.3,0.35,0.4,0.5,0.0]:
    param_grid.append({'_SECOND_POST_BLEND':v})
for v in [-0.05,-0.035,-0.025,-0.018,-0.012,-0.006,0.0,0.006,0.012]:
    param_grid.append({'_THIRD_MOMENT_BLEND':v})
for v in [-0.05,-0.03,-0.02,-0.01,-0.005,0.0,0.005,0.01]:
    param_grid.append({'_THIRD_POST_BLEND':v})
for v in [0.9995,0.9998,0.9999,0.99998,1.0,1.0001,1.0002,1.0005]:
    param_grid.append({'_FINAL_SCALE':v})
for v in [0.12,0.16,0.20,0.2318,0.27,0.32,0.40]:
    param_grid.append({'_BUDGET_FRACTION':v})
seen=set()
for params in param_grid:
    key=tuple(sorted(params.items()))
    if key in seen: continue
    seen.add(key)
    try:
        avg_adj,avg_mse,rows=run(params)
    except Exception as e:
        print('ERR',params,e); continue
    cands.append((avg_adj,avg_mse,params,rows))
    print('cand',params,'avg_adj',avg_adj,'avg_mse',avg_mse,'rows',[(round(a,8),round(m,8),round(mult,3),fail) for a,m,mult,fail in rows])
print('\\nTOP')
for avg_adj,avg_mse,params,rows in sorted(cands)[:12]:
    print(avg_adj,avg_mse,params,[(r[0],r[1],r[2],r[3]) for r in rows])

        est=mod.Estimator(); est.setup(SetupContext(spec.width,spec.depth,spec.flop_budget,'local',seed=999))
        res=evaluate_estimator(est,cd)
        rows.append((res['adjusted_final_layer_score'],res['final_layer_mse'],res['mean_score_multiplier'],res['mean_effective_compute'],res['n_failed_mlps']))
    print('frac',frac,'avg_adj',sum(r[0] for r in rows)/len(rows),'avg_mse',sum(r[1] for r in rows)/len(rows),'rows',[(round(a,8),round(m,8),round(mult,3),fail) for a,m,mult,eff,fail in rows])

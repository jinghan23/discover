/bin/bash -lc "python - <<'PY'
import math, time
import flopscope.numpy as fnp
from whestbench import BaseEstimator, SetupContext
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
INV=0.3989422804014327
class Diag(BaseEstimator):
    def predict(self, mlp, budget):
        rows=[]
        w0=mlp.weights[0]
        var=fnp.sum(w0*w0, axis=0)
        mean=fnp.sqrt(fnp.maximum(var,1e-12))*INV
        second=var*0.5
        rows.append(mean)
        for W in mlp.weights[1:]:
            centered=fnp.maximum(second-mean*mean,1e-12)
            zmean=mean@W
            zvar=fnp.maximum(centered@(W*W),1e-12)
            std=fnp.sqrt(zvar); alpha=zmean/std
            # use exact-ish erf if available? flopscope has erf?
            prob=0.5*(1.0+fnp.erf(alpha/math.sqrt(2.0))) if hasattr(fnp,'erf') else 0.5
            dens=INV*fnp.exp(-0.5*alpha*alpha)
            mean=std*dens+zmean*prob
            second=(zvar+zmean*zmean)*prob+zmean*std*dens
            rows.append(mean)
        return fnp.asarray(fnp.stack(rows), dtype=fnp.float32)
for width,depth,budget in [(64,4,800_000_000),(64,8,800_000_000),(128,4,2_000_000_000),(128,8,8_000_000_000)]:
    spec=ContestSpec(width=width, depth=depth, n_mlps=8, flop_budget=budget, ground_truth_samples=1_000_000 if width==64 else 600_000, seed=7200+width+depth, wall_time_limit_s=120.0)
    data=make_contest(spec)
    est=Diag(); est.setup(SetupContext(width,depth,budget,'local',seed=0))
    res=evaluate_estimator(est,data)
    print(width,depth,'adj',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'],'fail',res['n_failed_mlps'])

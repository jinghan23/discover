/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
w=64; d=8; b=1_000_000_000; n=8; gt=100_000; seed=7777
seq=fnp.random.SeedSequence(seed).spawn(3*n)
mlps=[]; targets=[]
for i in range(n):
    mlp=sample_mlp(w,d,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)

def evalv(flag):
    old=submission._FIRST_COVARIANCE_MATCH; submission._FIRST_COVARIANCE_MATCH=flag
    est=submission.Estimator(); est.setup(SetupContext(w,d,b,'x',seed=777))
    mses=[]; adjs=[]; utils=[]
    for mlp,t in zip(mlps,targets):
        with flops.BudgetContext(flop_budget=10**15, quiet=True) as ctx:
            p=est.predict(mlp,b)[-1]
        mse=float(fnp.mean((p-t)**2)); util=ctx.flops_used/b
        mses.append(mse); utils.append(util); adjs.append(mse*max(.1,util))
    submission._FIRST_COVARIANCE_MATCH=old
    print(flag,'mse',sum(mses)/n,'util',sum(utils)/n,'adj',sum(adjs)/n,mses)
evalv(False)
evalv(True)

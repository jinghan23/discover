codex
The next candidate is a true control variate rather than changing samples: carry a cheap diagonal Gaussian moment estimate to the final layer and blend it with the MC final mean. I’ll test this locally first because diagonal-only propagation can be biased in deep ReLU nets.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
# force best known settings in module for this synthetic run
submission._INPUT_SIGN_FLIP=False
submission._WHITEN_ROUNDS=1
submission._THIRD_MOMENT_BLEND=-0.02
width=64; depth=8; budget=1_000_000_000; n_mlps=8; gt=100_000; seed=666
seq=fnp.random.SeedSequence(seed).spawn(3*n_mlps)
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)

def predict_diagblend(est, mlp, budget, alpha):
    width=mlp.width; depth=mlp.depth
    if (not hasattr(est,'_samples') or est._samples.shape[1]"'!=width or getattr(est,'"'_depth',depth)"'!=depth):
        est._samples=est._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed)
        est._depth=depth; est._radial_mean=submission._radial_mean(width)
    first_weight=mlp.weights[0]
    first_variance=fnp.sum(first_weight*first_weight,axis=0)
    radial_mean=float(getattr(est,'"'_radial_mean',submission._radial_mean(width)))
    first_mean=fnp.sqrt(first_variance)*(submission._INV_SQRT_2PI/radial_mean)
    first_projection=est._samples@first_weight
    x=fnp.concatenate([fnp.maximum(first_projection,0.0),fnp.maximum(-first_projection,0.0)],axis=0)
    sample_mean=fnp.mean(x,axis=0); sample_second=fnp.mean(x*x,axis=0)
    sample_variance=fnp.maximum(sample_second-sample_mean*sample_mean,1e-6)
    target_variance=fnp.maximum(first_variance*(0.5/float(width))-first_mean*first_mean,1e-12)
    x=(x-sample_mean)*fnp.sqrt(target_variance/sample_variance)+first_mean
    if depth==1:
        return first_mean*radial_mean
    first_second=submission._first_relu_second(first_weight, first_variance)/float(width)
    first_covariance=first_second-first_mean[:,None]*first_mean[None,:]
    w=mlp.weights[1]
    z=x@w
    target_mean=first_mean@w
    covariance_weight=first_covariance@w
    target_variance=fnp.maximum(fnp.sum(w*covariance_weight,axis=0),1e-8)
    z_mean=fnp.mean(z,axis=0); z_second=fnp.mean(z*z,axis=0); z_variance=fnp.maximum(z_second-z_mean*z_mean,1e-8)
    x=fnp.maximum((z-z_mean)*fnp.sqrt(target_variance/z_variance)+target_mean,0.0)
    mm, ms=submission._normal_relu_moments(target_mean,target_variance)
    for layer_index,w in enumerate(mlp.weights[2:],start=2):
        z=x@w
        # sample correction same as current only at layer 2
        if layer_index==2 and submission._THIRD_MOMENT_BLEND:
            z_mean=fnp.mean(z,axis=0); z_second=fnp.mean(z*z,axis=0); z_variance=fnp.maximum(z_second-z_mean*z_mean,1e-8)
            centered=fnp.maximum(ms-mm*mm,1e-8)
            dm=mm@w; dv=fnp.maximum(centered@(w*w),1e-8)
            bm=z_mean*(1-submission._THIRD_MOMENT_BLEND)+dm*submission._THIRD_MOMENT_BLEND
            bv=z_variance*(1-submission._THIRD_MOMENT_BLEND)+dv*submission._THIRD_MOMENT_BLEND
            z=(z-z_mean)*fnp.sqrt(bv/z_variance)+bm
            mm,ms=submission._normal_relu_moments(bm,bv)
        else:
            centered=fnp.maximum(ms-mm*mm,1e-8)
            dm=mm@w; dv=fnp.maximum(centered@(w*w),1e-8)
            mm,ms=submission._normal_relu_moments(dm,dv)
        x=fnp.maximum(z,0.0)
    sample_final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
    return (sample_final*(1-alpha)+mm*alpha)*radial_mean

def evalalpha(alpha):
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=777))
    vals=[]
    for mlp,t in zip(mlps,targets):
        p=predict_diagblend(est,mlp,budget,alpha)
        vals.append(float(fnp.mean((p-t)**2)))
    print(alpha,sum(vals)/len(vals),vals)
for a in [-0.1,-0.05,-0.02,-0.01,0,0.01,0.02,0.05,0.1]:
    evalalpha(a)

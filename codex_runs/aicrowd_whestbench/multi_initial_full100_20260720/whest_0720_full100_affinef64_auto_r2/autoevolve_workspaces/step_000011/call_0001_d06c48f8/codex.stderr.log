import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission

width=64; depth=8; budget=1_000_000_000; n_mlps=6; gt=80_000; seed=24680
seq=fnp.random.SeedSequence(seed).spawn(3*n_mlps+1)
mlps=[]; targets=[]
print('build')
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)
print('eval')

def run(frac):
    old=submission._BUDGET_FRACTION
    submission._BUDGET_FRACTION=frac
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=777))
    adj=[]; mses=[]; utils=[]
    for mlp,t in zip(mlps,targets):
        with flops.BudgetContext(flop_budget=10**15, quiet=True) as ctx:
            p=est.predict(mlp,budget)[-1]
        mse=float(fnp.mean((p-t)**2)); util=ctx.flops_used/budget
        mses.append(mse); utils.append(util); adj.append(mse*max(0.1,util))
    submission._BUDGET_FRACTION=old
    print(frac,'k',submission._sample_count(budget,width,depth),'mse',sum(mses)/len(mses),'util',sum(utils)/len(utils),'adj',sum(adj)/len(adj))
for f in [0.08,0.10,0.12,0.16,0.20,0.232,0.26,0.30,0.36,0.45]:
    run(f)

import time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission

width=32; depth=8; budget=100_000_000; n_mlps=8; gt=120_000
seed=12345
ss=fnp.random.SeedSequence(seed).spawn(2*n_mlps+1)
mlps=[]; targets=[]
print('building data')
t0=time.time()
for i in range(n_mlps):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(ss[2*i]), seed=int(ss[2*i+1].generate_state(1)[0]))
    allm, final, avg = sample_layer_statistics(mlp, gt, rng=fnp.random.default_rng(ss[-1].spawn(n_mlps)[i] if False else ss[2*i+1]))
    mlps.append(mlp); targets.append(final)
    print('m',i)
print('data time', time.time()-t0)

def eval_variant(name, **params):
    # save
    old={k:getattr(submission,k) for k in params}
    for k,v in params.items(): setattr(submission,k,v)
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=777))
    vals=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,budget)[-1]
        vals.append(float(fnp.mean((p-t)**2)))
    for k,v in old.items(): setattr(submission,k,v)
    print(name, sum(vals)/len(vals), vals)

base_params={}
eval_variant('base')
for b in [-0.08,-0.05,-0.03,-0.02,-0.01,0.0,0.02,0.05]:
    eval_variant('blend '+str(b), _THIRD_MOMENT_BLEND=b)
for sf in [0.995,0.997,0.999,1.0,1.001,1.003,1.005]:
    eval_variant('scale '+str(sf), _FINAL_SCALE=sf)
for vf in [0.98,0.99,1.0,1.01,1.02,1.05]:
    eval_variant('v2 '+str(vf), _SECOND_VARIANCE_FACTOR=vf)

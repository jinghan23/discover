for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)

def evalv(label, **params):
    old={k:getattr(submission,k) for k in params}
    for k,v in params.items(): setattr(submission,k,v)
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=777))
    vals=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,budget)[-1]
        vals.append(float(fnp.mean((p-t)**2)))
    for k,v in old.items(): setattr(submission,k,v)
    print(label, sum(vals)/len(vals))

evalv('base')
for r in [0,1,2,3,4,5,6,8]:
    evalv('round '+str(r), _WHITEN_ROUNDS=r)
for rb in [0.05,0.1,0.2,0.5,1.0]:
    evalv('rad '+str(rb), _RADEMACHER_FRACTION=rb)
for blk in [1,2,4,8,16]:
    evalv('blocks '+str(blk), _WHITEN_BLOCKS=blk)
for off in range(0,8):
    evalv('off '+str(off), _SETUP_SEED_OFFSET=off)

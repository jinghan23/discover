import math
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
# best flags
submission._FIRST_COVARIANCE_MATCH=False
submission._INPUT_SIGN_FLIP=False
submission._FINAL_DIAGONAL_BLEND=0.0
submission._WHITEN_ROUNDS=1
submission._BUDGET_FRACTION=0.232
w=64; d=8; b=1_000_000_000; n=8; gt=100_000; seed=9999
seq=fnp.random.SeedSequence(seed).spawn(3*n)
mlps=[]; targets=[]
for i in range(n):
    mlp=sample_mlp(w,d,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)

def orth_block(self,rng,width,count):
    rows=[]
    remaining=count
    while remaining>0:
        a=rng.standard_normal((width,width), dtype=fnp.float32)
        q,r=fnp.linalg.qr(fnp.asarray(a,dtype=fnp.float64))
        # deterministic sign convention from R diagonal
        diag=fnp.where(fnp.diag(r)>=0.0,1.0,-1.0)
        q=q*diag[None,:]
        take=min(width,remaining)
        rows.append(fnp.asarray(q[:take],dtype=fnp.float32))
        remaining-=take
    half=fnp.concatenate(rows,axis=0) if len(rows)>1 else rows[0]
    # optional one global whitening/renorm like baseline
    for _ in range(submission._WHITEN_ROUNDS):
        u64=fnp.asarray(half,dtype=fnp.float64)
        covariance=(u64.T@u64)*(float(width)/float(count))
        eigenvalues,eigenvectors=fnp.linalg.eigh(covariance)
        eigenvalues=fnp.maximum(eigenvalues,1e-6)
        inv=(eigenvectors/fnp.sqrt(eigenvalues))@eigenvectors.T
        half=fnp.asarray(u64@inv,dtype=fnp.float32)
        norm=fnp.sqrt(fnp.maximum(fnp.sum(half*half,axis=1,keepdims=True),1e-12))
        half=half/norm
    return half

def evalv(label, monkey=False):
    old=submission.Estimator._make_sample_block
    if monkey: submission.Estimator._make_sample_block=orth_block
    est=submission.Estimator(); est.setup(SetupContext(w,d,b,'x',seed=777))
    vals=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,b)[-1]
        vals.append(float(fnp.mean((p-t)**2)))
    if monkey: submission.Estimator._make_sample_block=old
    print(label,sum(vals)/len(vals),vals)
evalv('baseline')
evalv('orth',True)

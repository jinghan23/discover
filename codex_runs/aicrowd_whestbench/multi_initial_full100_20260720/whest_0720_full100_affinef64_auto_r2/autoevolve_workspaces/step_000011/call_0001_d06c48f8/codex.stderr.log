Before paying for another official run, I’ll do a quick synthetic check of the sign-flip change against the same kind of generated MLPs.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
width=64; depth=8; budget=1_000_000_000; n_mlps=8; gt=100_000; seed=555
seq=fnp.random.SeedSequence(seed).spawn(3*n_mlps)
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(seq[3*i]),seed=int(seq[3*i+2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(seq[3*i+1]))
    mlps.append(mlp); targets.append(final)

def evalv(flag, off=11):
    old1=submission._INPUT_SIGN_FLIP; old2=submission._PREDICT_SEED_OFFSET
    submission._INPUT_SIGN_FLIP=flag; submission._PREDICT_SEED_OFFSET=off
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=777))
    vals=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,budget)[-1]
        vals.append(float(fnp.mean((p-t)**2)))
    submission._INPUT_SIGN_FLIP=old1; submission._PREDICT_SEED_OFFSET=old2
    print('flag',flag,'off',off,'mean',sum(vals)/len(vals),vals)
evalv(False)
for off in [0,1,3,7,11,17,29]:
    evalv(True,off)

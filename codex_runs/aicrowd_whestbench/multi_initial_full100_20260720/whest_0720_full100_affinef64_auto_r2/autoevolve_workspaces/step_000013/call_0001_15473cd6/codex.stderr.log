import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def radial_mean(w):
    return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def normal_cdf(x):
    # use erf? numpy lacks erf? use math? approximate
    ax=np.abs(x); t=1/(1+0.2316419*ax)
    poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
    tail=INV*np.exp(-0.5*ax*ax)*poly
    return np.where(x>=0,1-tail,tail)

def normal_relu(mean,var):
    var=np.maximum(var,1e-12); std=np.sqrt(var); a=mean/std
    dens=INV*np.exp(-0.5*a*a); p=normal_cdf(a)
    return std*dens+mean*p,(var+mean*mean)*p+mean*std*dens

def first_second(W,var):
    gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    return scale*(root+(PI-np.arccos(rho))*rho)/TWO

def make_dirs(rng,w,count,whiten=1):
    u=rng.standard_normal((count,w)).astype(np.float32)
    half=u/np.sqrt(np.maximum(np.sum(u*u,axis=1,keepdims=True),1e-12))
    for _ in range(whiten):
        u64=half.astype(np.float64)
        cov=(u64.T@u64)*(w/count)
        vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
        inv=(vecs/np.sqrt(vals))@vecs.T
        half=(u64@inv).astype(np.float32)
        half=half/np.sqrt(np.maximum(np.sum(half*half,axis=1,keepdims=True),1e-12))
    return half

def pred(weights, dirs, spb=0.3, tpb=-0.01, tmb=-0.02, fscale=1.0, svf=1.0, gen_diag=False):
    d=len(weights); w=weights[0].shape[0]; rm=radial_mean(w)
    W=weights[0]
    first_var=np.sum(W*W,axis=0)
    first_mean=np.sqrt(first_var)*(INV/rm)
    proj=dirs@W
    x=np.concatenate([np.maximum(proj,0),np.maximum(-proj,0)],axis=0)
    if d==1: return first_mean*rm
    sm=x.mean(0); ss=(x*x).mean(0); svar=np.maximum(ss-sm*sm,1e-6)
    targ=np.maximum(first_var*(0.5/w)-first_mean*first_mean,1e-12)
    x=(x-sm)*np.sqrt(targ/svar)+first_mean
    fs=first_second(W,first_var)/w
    fcov=fs-first_mean[:,None]*first_mean[None,:]
    W=weights[1]
    z=x@W; target_mean=first_mean@W; cw=fcov@W
    target_var=np.maximum(np.sum(W*cw,axis=0)*svf,1e-8)
    zm=z.mean(0); zs=(z*z).mean(0); zv=np.maximum(zs-zm*zm,1e-8)
    x=np.maximum((z-zm)*np.sqrt(target_var/zv)+target_mean,0)
    second_mean,second_second=normal_relu(target_mean,target_var)
    if spb:
        pm=x.mean(0); ps=(x*x).mean(0); pv=np.maximum(ps-pm*pm,1e-8)
        tpv=np.maximum(second_second-second_mean*second_mean,1e-8)
        bpm=pm*(1-spb)+second_mean*spb; bpv=pv*(1-spb)+tpv*spb; bpv=np.maximum(bpv,1e-8)
        x=(x-pm)*np.sqrt(bpv/pv)+bpm
    prev_mean, prev_second = second_mean, second_second
    for li,W in enumerate(weights[2:],start=2):
        z=x@W
        if (li==2 and tmb) or (gen_diag and li>=2 and tmb):
            zm=z.mean(0); zs=(z*z).mean(0); zv=np.maximum(zs-zm*zm,1e-8)
            cen=np.maximum(prev_second-prev_mean*prev_mean,1e-8)
            dm=prev_mean@W; dv=np.maximum(cen@(W*W),1e-8)
            bm=zm*(1-tmb)+dm*tmb; bv=zv*(1-tmb)+dv*tmb; bv=np.maximum(bv,1e-8)
            z=(z-zm)*np.sqrt(bv/zv)+bm
            nm,ns=normal_relu(bm,bv)
        else:
            nm=ns=None
        x=np.maximum(z,0)
        if (li==2 and tpb) or (gen_diag and li>=2 and tpb):
            if nm is None:
                zm=z.mean(0); zs=(z*z).mean(0); zv=np.maximum(zs-zm*zm,1e-8)
                nm,ns=normal_relu(zm,zv)
            pm=x.mean(0); ps=(x*x).mean(0); pv=np.maximum(ps-pm*pm,1e-8)
            tpv=np.maximum(ns-nm*nm,1e-8)
            bpm=pm*(1-tpb)+nm*tpb; bpv=pv*(1-tpb)+tpv*tpb; bpv=np.maximum(bpv,1e-8)
            x=(x-pm)*np.sqrt(bpv/pv)+bpm
        if nm is not None:
            prev_mean,prev_second=nm,ns
        else:
            prev_mean=x.mean(0); prev_second=(x*x).mean(0)
    return x.mean(0).astype(np.float64)*rm*fscale

def truth(weights, rng, n=131072, batch=8192):
    w=weights[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        b=min(batch,n-done)
        u=rng.standard_normal((b,w)).astype(np.float32)
        u=u/np.sqrt(np.maximum(np.sum(u*u,axis=1,keepdims=True),1e-12))
        x=u
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.sum(0)
        done += b
    return s/n*radial_mean(w)

def eval_consts(width=64,depth=8,k=4096,nmlp=8,ntruth=65536, variants=[]):
    rng=np.random.default_rng(123)
    dirs=make_dirs(np.random.default_rng(999),width,k//2,1)
    # common mlps/truths
    data=[]
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        t=truth(weights,np.random.default_rng(10000+i),ntruth)
        data.append((weights,t))
    for name,kw in variants:
        ms=[]
        for weights,t in data:
            p=pred(weights,dirs,**kw)
            ms.append(np.mean((p-t)**2))
        print(name, np.mean(ms), np.std(ms)/math.sqrt(len(ms)))

variants=[
('base',{}),
('spb0',{'spb':0.0}),('spb.15',{'spb':0.15}),('spb.5',{'spb':0.5}),('spb1',{'spb':1.0}),
('tpb0',{'tpb':0.0}),('tpb-.02',{'tpb':-0.02}),('tpb.02',{'tpb':0.02}),
('tmb0',{'tmb':0.0}),('tmb-.04',{'tmb':-0.04}),('tmb.02',{'tmb':0.02}),
('gen small',{'tmb':-0.01,'tpb':-0.005,'gen_diag':True}),
]
t=time.time(); eval_consts(64,8,4096,8,65536,variants); print('time',time.time()-t)

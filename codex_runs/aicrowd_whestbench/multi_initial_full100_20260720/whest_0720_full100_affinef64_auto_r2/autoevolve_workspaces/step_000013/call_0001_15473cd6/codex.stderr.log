I’m exploring one more algorithmic addition synthetically: a final-layer control variate from diagonal Gaussian moment propagation. It is biased, but a small blend can reduce Monte Carlo variance if its errors are correlated with the sample estimator.
exec
/bin/bash -lc "python - <<'PY'
# Synthetic estimate for blending sample final mean with diagonal analytic propagation.
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi
def rm(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
 ax=np.abs(x); t=1/(1+.2316419*ax); poly=t*(.319381530+t*(-.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429)))); tail=INV*np.exp(-.5*ax*ax)*poly; return np.where(x>=0,1-tail,tail)
def relu(m,v):
 v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; den=INV*np.exp(-.5*a*a); p=cdf(a); return s*den+m*p,(v+m*m)*p+m*s*den
def fs(W,var):
 g=W.T@W; st=np.sqrt(np.maximum(var,1e-12)); sc=st[:,None]*st[None,:]; r=np.clip(g/np.maximum(sc,1e-12),-1,1); return sc*(np.sqrt(np.maximum(1-r*r,0))+(PI-np.arccos(r))*r)/TWO
def dirs(w,k):
 rng=np.random.default_rng(1002); h=rng.standard_normal((k//2,w)).astype(np.float32); h/=np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12)); u=h.astype(float); cov=(u.T@u)*(w/(k//2)); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; h=(u@inv).astype(np.float32); h/=np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12)); return h
def sample_and_diag(weights,h):
 w=weights[0].shape[0]; rmean=rm(w); W=weights[0]; fv=(W*W).sum(0); fm=np.sqrt(fv)*(INV/rmean); fsecond_diag=fv*(.5/w); pr=h@W; x=np.concatenate([np.maximum(pr,0),np.maximum(-pr,0)]); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(fsecond_diag-fm*fm,1e-12); x=(x-sm)*np.sqrt(tv/sv)+fm; fsec=fs(W,fv)/w; fc=fsec-fm[:,None]*fm[None,:]; W=weights[1]; z=x@W; tm=fm@W; cw=fc@W; tv=np.maximum((W*cw).sum(0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0); m2,s2=relu(tm,tv); pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); x=(x-pm)*np.sqrt(np.maximum(pv*.7+tpv*.3,1e-8)/pv)+(pm*.7+m2*.3)
 diag_m,diag_s=m2,s2
 for li,W in enumerate(weights[2:],2):
  z=x@W
  if li==2:
   tmb=-.0175; zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); cen=np.maximum(m2*m2*0 + (s2-m2*m2),1e-8); dm=m2@W; dv=np.maximum(cen@(W*W),1e-8); bm=zm*(1-tmb)+dm*tmb; bv=np.maximum(zv*(1-tmb)+dv*tmb,1e-8); z=(z-zm)*np.sqrt(bv/zv)+bm; m2,s2=relu(bm,bv)
  x=np.maximum(z,0)
  if li==2:
   tpb=-.01; pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); x=(x-pm)*np.sqrt(np.maximum(pv*(1-tpb)+tpv*tpb,1e-8)/pv)+(pm*(1-tpb)+m2*tpb)
  # pure diagonal propagation from layer 2 moments
  if li>=2:
   dm=diag_m@W; dv=np.maximum((diag_s-diag_m*diag_m)@(W*W),1e-8); diag_m,diag_s=relu(dm,dv)
 return x.mean(0)*rmean, diag_m*rmean
def truth(weights,seed,n):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; batch=16384
 while done<n:
  b=min(batch,n-done); u=rng.standard_normal((b,w)).astype(np.float32); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); x=u
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=b
 return s/n*rm(w)
def run(width,depth,k,nmlp,ntruth):
 rng=np.random.default_rng(91); h=dirs(width,k); Ps=[]; Ds=[]; Ts=[]
 for i in range(nmlp):
  weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]; p,d=sample_and_diag(weights,h); t=truth(weights,5000+i,ntruth); Ps.append(p); Ds.append(d); Ts.append(t)
 P=np.concatenate(Ps); D=np.concatenate(Ds); T=np.concatenate(Ts)
 print('case',width,depth,'base',np.mean((P-T)**2),'diag',np.mean((D-T)**2))
 for b in [-.1,-.05,-.02,-.01,.01,.02,.05,.1]:
  M=P*(1-b)+D*b; print(b,np.mean((M-T)**2))
 # optimal beta for P + beta(D-P)
 X=D-P; beta=((T-P)*X).sum()/(X*X).sum(); print('optbeta',beta,np.mean((P+beta*X-T)**2))
for args in [(64,8,32768,16,131072),(64,16,32768,10,65536),(128,6,16384,10,65536)]: run(*args)

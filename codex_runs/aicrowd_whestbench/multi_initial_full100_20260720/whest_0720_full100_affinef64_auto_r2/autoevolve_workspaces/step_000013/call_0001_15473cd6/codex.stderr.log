import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def rm(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
 ax=np.abs(x); t=1/(1+.2316419*ax); poly=t*(.319381530+t*(-.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429)))); tail=INV*np.exp(-.5*ax*ax)*poly; return np.where(x>=0,1-tail,tail)
def relu(m,v):
 v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; den=INV*np.exp(-.5*a*a); p=cdf(a); return s*den+m*p,(v+m*m)*p+m*s*den
def fs(W,var):
 g=W.T@W; st=np.sqrt(np.maximum(var,1e-12)); sc=st[:,None]*st[None,:]; r=np.clip(g/np.maximum(sc,1e-12),-1,1); return sc*(np.sqrt(np.maximum(1-r*r,0))+(PI-np.arccos(r))*r)/TWO
def dirs(seed,w,k,rounds):
 rng=np.random.default_rng(seed); h=rng.standard_normal((k//2,w)).astype(np.float32); h/=np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
 for _ in range(rounds):
  u=h.astype(np.float64); cov=(u.T@u)*(w/(k//2)); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T; h=(u@inv).astype(np.float32); h/=np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12))
 return h
def pred(weights,h):
 w=weights[0].shape[0]; rmean=rm(w); W=weights[0]; fv=(W*W).sum(0); fm=np.sqrt(fv)*(INV/rmean); p=h@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(fv*(.5/w)-fm*fm,1e-12); x=(x-sm)*np.sqrt(tv/sv)+fm
 fsec=fs(W,fv)/w; fc=fsec-fm[:,None]*fm[None,:]; W=weights[1]; z=x@W; tm=fm@W; cw=fc@W; tv=np.maximum((W*cw).sum(0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0); m2,s2=relu(tm,tv)
 spb=.3; pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); bm=pm*(1-spb)+m2*spb; bv=np.maximum(pv*(1-spb)+tpv*spb,1e-8); x=(x-pm)*np.sqrt(bv/pv)+bm
 for li,W in enumerate(weights[2:],2):
  z=x@W
  if li==2:
   tmb=-.02; zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); cen=np.maximum(s2-m2*m2,1e-8); dm=m2@W; dv=np.maximum(cen@(W*W),1e-8); bm=zm*(1-tmb)+dm*tmb; bv=np.maximum(zv*(1-tmb)+dv*tmb,1e-8); z=(z-zm)*np.sqrt(bv/zv)+bm; m2,s2=relu(bm,bv)
  x=np.maximum(z,0)
  if li==2:
   tpb=-.01; pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); bm=pm*(1-tpb)+m2*tpb; bv=np.maximum(pv*(1-tpb)+tpv*tpb,1e-8); x=(x-pm)*np.sqrt(bv/pv)+bm
 return x.mean(0)*rmean
def truth(weights,seed,n):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; batch=16384
 while done<n:
  b=min(batch,n-done); u=rng.standard_normal((b,w)).astype(np.float32); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); x=u
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=b
 return s/n*rm(w)
width,depth,k,nmlp,ntruth=64,8,32768,12,262144
rng=np.random.default_rng(11); data=[]
for i in range(nmlp):
 weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
 data.append((weights,truth(weights,200+i,ntruth)))
for rounds in [0,1,2,3]:
 h=dirs(1002,width,k,rounds); es=[]
 cov=(h.astype(float).T@h.astype(float))*(width/(k//2)); print('round',rounds,'coverr',np.abs(cov-np.eye(width)).mean(),end=' ')

# Larger synthetic sweep, still using generated MLPs only.
import numpy as np, math, time
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def cdf(x):
    ax=np.abs(x); t=1/(1+0.2316419*ax); poly=t*(0.319381530+t*(-0.356563782+t*(1.781477937+t*(-1.821255978+t*1.330274429))))
    tail=INV*np.exp(-0.5*ax*x)*poly if False else INV*np.exp(-0.5*ax*ax)*poly
    return np.where(x>=0,1-tail,tail)
def relu_m(m,v):
    v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; den=INV*np.exp(-0.5*a*a); p=cdf(a); return s*den+m*p,(v+m*m)*p+m*s*den
def fsecond(W,var):
    g=W.T@W; st=np.sqrt(np.maximum(var,1e-12)); sc=st[:,None]*st[None,:]; r=np.clip(g/np.maximum(sc,1e-12),-1,1); root=np.sqrt(np.maximum(1-r*r,0)); return sc*(root+(PI-np.arccos(r))*r)/TWO
def dirs(seed,w,k):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); h=u/np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12))
    u64=h.astype(np.float64); cov=(u64.T@u64)*(w/(k//2)); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    h=(u64@inv).astype(np.float32); h=h/np.sqrt(np.maximum((h*h).sum(1,keepdims=True),1e-12)); return h
def pred(weights,h,spb=.3,tpb=-.01,tmb=-.02,fscale=1.0):
    d=len(weights); w=weights[0].shape[0]; rm=radial_mean(w); W=weights[0]; fv=(W*W).sum(0); fm=np.sqrt(fv)*(INV/rm); p=h@W
    x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=np.maximum(fv*(.5/w)-fm*fm,1e-12); x=(x-sm)*np.sqrt(tv/sv)+fm
    fs=fsecond(W,fv)/w; fc=fs-fm[:,None]*fm[None,:]; W=weights[1]; z=x@W; tm=fm@W; cw=fc@W; tv=np.maximum((W*cw).sum(0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0); m2,s2=relu_m(tm,tv)
    if spb:
        pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); bm=pm*(1-spb)+m2*spb; bv=np.maximum(pv*(1-spb)+tpv*spb,1e-8); x=(x-pm)*np.sqrt(bv/pv)+bm
    for li,W in enumerate(weights[2:],2):
        z=x@W
        if li==2 and tmb:
            zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); cen=np.maximum(s2-m2*m2,1e-8); dm=m2@W; dv=np.maximum(cen@(W*W),1e-8); bm=zm*(1-tmb)+dm*tmb; bv=np.maximum(zv*(1-tmb)+dv*tmb,1e-8); z=(z-zm)*np.sqrt(bv/zv)+bm; m2,s2=relu_m(bm,bv)
        x=np.maximum(z,0)
        if li==2 and tpb:
            pm=x.mean(0); pv=np.maximum((x*x).mean(0)-pm*pm,1e-8); tpv=np.maximum(s2-m2*m2,1e-8); bm=pm*(1-tpb)+m2*tpb; bv=np.maximum(pv*(1-tpb)+tpv*tpb,1e-8); x=(x-pm)*np.sqrt(bv/pv)+bm
    return x.mean(0)*rm*fscale
def truth(weights,seed,n=262144,batch=16384):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        b=min(batch,n-done); u=rng.standard_normal((b,w)).astype(np.float32); u/=np.sqrt(np.maximum((u*u).sum(1,keepdims=True),1e-12)); x=u
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=b
    return s/n*radial_mean(w)
def run(width,depth,k,nmlp,ntruth):
    rng=np.random.default_rng(321); h=dirs(999,width,k); data=[]
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        data.append((weights,truth(weights,1000+i,ntruth)))
    variants=[('base',{}),('spb.1',{'spb':.1}),('spb.15',{'spb':.15}),('spb.2',{'spb':.2}),('spb.4',{'spb':.4}),('tmb-.03',{'tmb':-.03}),('tmb-.04',{'tmb':-.04}),('tmb-.06',{'tmb':-.06}),('tpb-.02',{'tpb':-.02}),('combo',{'spb':.15,'tmb':-.04,'tpb':-.02})]
    print('case',width,depth,k,nmlp,ntruth)
    for name,kw in variants:
        e=[]
        for weights,t in data: e.append(((pred(weights,h,**kw)-t)**2).mean())
        print(name, float(np.mean(e)), float(np.std(e)/math.sqrt(len(e))))
for params in [(64,8,32768,12,262144),(128,6,16384,8,131072),(64,16,32768,8,131072)]:
    t=time.time(); run(*params); print('elapsed',time.time()-t)

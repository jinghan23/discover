/bin/bash -lc "python - <<'PY'
import numpy as np, time
INV=0.3989422804014327
SQRT2=np.sqrt(2.0)
try:
    from math import erf
    erfv=np.vectorize(erf)
except Exception:
    erfv=None

def norm_cdf(x):
    return 0.5*(1+erfv(x/SQRT2))

def make_samples(w,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w)).astype(np.float32)
    cov=(u.T@u)/(k//2)
    ev, Q=np.linalg.eigh(cov)
    inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def baseline(ws, samples):
    W=ws[0]
    first_var=np.sum(W*W,axis=0)
    first_mean=np.sqrt(first_var)*INV
    x=np.maximum(samples@W,0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=first_var*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+first_mean
    for W in ws[1:]:
        x=np.maximum(x@W,0)
    return x.mean(0)

def mm(ws, samples, blend=1.0, adjust=True):
    x=samples
    mean=None
    for li,W in enumerate(ws):
        z=x@W
        if li==0:
            mu=np.zeros(W.shape[1],np.float32)
            var=np.sum(W*W,axis=0)
        else:
            mu=mean@W
            d=z-mu
            var=np.maximum((d*d).mean(0),1e-6)
        sig=np.sqrt(var); a=mu/sig
        pdf=np.exp(-0.5*a*a)*INV
        cdf=norm_cdf(a)
        gmean=sig*pdf+mu*cdf
        second=(var+mu*mu)*cdf+mu*sig*pdf
        gvar=np.maximum(second-gmean*gmean,1e-6)
        y=np.maximum(z,0)
        sy=y.mean(0)
        if li==len(ws)-1:
            return (1-blend)*sy + blend*gmean
        if adjust:
            sv=np.maximum((y*y).mean(0)-sy*sy,1e-6)
            x=(y-sy)*np.sqrt(gvar/sv)+gmean
            mean=gmean
        else:
            x=y; mean=sy

def target(ws, n=20000, seed=99):
    rng=np.random.default_rng(seed)
    s=np.zeros(ws[0].shape[0], dtype=np.float64); done=0; chunk=4096
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
        for W in ws:
            x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n

w=128; d=32; k=4096; nets=5
samples=make_samples(w,k,123)
for blend in [0,0.25,0.5,0.75,1.0]:
  ms=[]
  for i in range(nets):
    rng=np.random.default_rng(i)
    ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
    t=target(ws, n=30000, seed=1000+i)
    b=baseline(ws,samples)
    m=mm(ws,samples,blend=blend,adjust=True)
    if blend==0: pass
    ms.append(((m-t)**2).mean())
  print('blend',blend,'mse',np.mean(ms))
# baseline once separately
ms=[]
for i in range(nets):
    rng=np.random.default_rng(i)
    ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
    t=target(ws, n=30000, seed=1000+i)
    b=baseline(ws,samples)
    ms.append(((b-t)**2).mean())
print('baseline',np.mean(ms))

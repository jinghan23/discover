codex
Another targeted correction is exact first-layer full covariance matching. The first pre-activations are truly Gaussian, so their post-ReLU covariance has a closed form; matching the probe cloud to that covariance may improve all downstream layers without imposing Gaussian assumptions later. I’ll test this idea locally on synthetic MLPs first.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
INV=0.3989422804014327; INV2PI=0.15915494309189535

def make_samples(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32)
 cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32)
 return np.concatenate([half,-half],0)

def first_cov_target(W):
 C=W.T@W; v=np.maximum(np.diag(C),1e-8); s=np.sqrt(v); outer=np.outer(s,s)
 rho=np.clip(C/np.maximum(outer,1e-8),-0.999999,0.999999)
 root=np.sqrt(np.maximum(1-rho*rho,0)); angle=np.arccos(rho)
 E=outer*(root+(np.pi-angle)*rho)*INV2PI
 m=s*INV
 Cov=E-np.outer(m,m)
 np.fill_diagonal(Cov, v*(0.5-INV*INV))
 return m, Cov

def baseline(ws, S, full=False):
 W=ws[0]
 x=np.maximum(S@W,0)
 if full:
  m,Ct=first_cov_target(W)
  xc=x-x.mean(0)
  Cs=xc.T@xc/x.shape[0]
  es,Qs=np.linalg.eigh((Cs+Cs.T)*0.5+1e-6*np.eye(W.shape[0]))
  et,Qt=np.linalg.eigh((Ct+Ct.T)*0.5+1e-6*np.eye(W.shape[0]))
  A=(Qs/np.sqrt(np.maximum(es,1e-8)))@Qs.T@(Qt*np.sqrt(np.maximum(et,0)))@Qt.T
  x=xc@A + m
 else:
  fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV
  sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
  x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)

def target(ws,n=50000,seed=99):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0; chunk=4096
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for w,k,nets in [(64,2048,10),(128,4096,5)]:
 S=make_samples(w,k,123)
 for full in [False,True]:
  ms=[]
  for i in range(nets):
   rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(32)]
   t=target(ws, n=40000, seed=1000+i)
   p=baseline(ws,S,full)
   ms.append(((p-t)**2).mean())
  print('w',w,'full',full,'mse',np.mean(ms),ms)

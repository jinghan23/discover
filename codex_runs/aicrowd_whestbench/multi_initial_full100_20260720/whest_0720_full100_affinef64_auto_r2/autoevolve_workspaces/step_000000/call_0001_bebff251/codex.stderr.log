import numpy as np, math, time
from numpy.polynomial.hermite import hermgauss
from math import erf
INV=0.3989422804014327; SQRT2=math.sqrt(2.0)
erfv=np.vectorize(erf)
def cdf(a): return 0.5*(1+erfv(a/SQRT2))
def relu_mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
 pdf=np.exp(-0.5*a*a)*INV; C=cdf(a)
 m=sig*pdf+mu*C
 sec=(var+mu*mu)*C+mu*sig*pdf
 return m, np.maximum(sec-m*m,1e-12)

def full_quad(ws, gh=5):
 nodes, weights=hermgauss(gh); xs=nodes*np.sqrt(2); wsgh=weights/np.sqrt(np.pi)
 w=ws[0].shape[0]; m=np.zeros(w); C=np.eye(w)
 for W in ws:
  mu=m@W; C=W.T@C@W; var=np.maximum(np.diag(C),1e-9); sig=np.sqrt(var)
  mean, diagvar=relu_mom(mu,var)
  outer=np.outer(sig,sig); rho=np.clip(C/np.maximum(outer,1e-9),-0.999999,0.999999); sr=np.sqrt(np.maximum(1-rho*rho,0))
  E=np.zeros((w,w))
  # vectorize over pairs, loop quadrature
  mui=mu[:,None]; muj=mu[None,:]; si=sig[:,None]; sj=sig[None,:]
  for a,wa in zip(xs,wsgh):
    xi=np.maximum(mui+si*a,0)
    for b,wb in zip(xs,wsgh):
      y=np.maximum(muj+sj*(rho*a+sr*b),0)
      E += (wa*wb)*(xi*y)
  C=E-np.outer(mean,mean)
  np.fill_diagonal(C, diagvar)
  C=(C+C.T)*0.5
  m=mean
 return m.astype(np.float32)
def diag_pred(ws):
 w=ws[0].shape[0]; m=np.zeros(w); v=np.ones(w)
 for W in ws:
  mu=m@W; var=v@(W*W); m,v=relu_mom(mu,var)
 return m.astype(np.float32)
def make_samples(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32)
 cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32)
 return np.concatenate([half,-half],0)
def mc(ws,S):
 W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV
 x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
 x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(ws,n=40000,seed=99):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0; chunk=4096
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for w,k,nets in [(64,2048,5),(128,4096,3)]:
 S=make_samples(w,k,123); Ms=[]; Ds=[]; Fs=[]; Ts=[]
 st=time.time()
 for i in range(nets):
  rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(32)]
  Ts.append(target(ws, n=50000 if w==64 else 30000, seed=1000+i)); Ms.append(mc(ws,S)); Ds.append(diag_pred(ws)); Fs.append(full_quad(ws,gh=5))
 print('w',w,'time',time.time()-st,'mc',np.mean([((m-t)**2).mean() for m,t in zip(Ms,Ts)]),'diag',np.mean([((d-t)**2).mean() for d,t in zip(Ds,Ts)]),'full',np.mean([((f-t)**2).mean() for f,t in zip(Fs,Ts)]))
 for b in [-0.05,-0.02,0,0.02,0.05,0.1,0.2]:
  print('blendF',b,np.mean([(((1-b)*m+b*f-t)**2).mean() for m,f,t in zip(Ms,Fs,Ts)]))

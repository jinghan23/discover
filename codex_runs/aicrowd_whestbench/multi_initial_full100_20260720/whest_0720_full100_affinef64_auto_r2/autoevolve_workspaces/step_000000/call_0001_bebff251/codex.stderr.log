/bin/bash -lc "python - <<'PY'
import numpy as np
INV=0.3989422804014327

def make(w,k,seed,blocks):
 rng=np.random.default_rng(seed); halves=[]; n_total=k//2; base=n_total//blocks
 for b in range(blocks):
  n=base + (1 if b < n_total - base*blocks else 0)
  u=rng.standard_normal((n,w)).astype(np.float32)
  cov=(u.T@u)/n; ev,Q=np.linalg.eigh(cov); halves.append((u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32))
 half=np.concatenate(halves,0)
 return np.concatenate([half,-half],0)
def pred(ws,S):
 W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV
 x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
 x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(ws,n=40000,seed=99):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0; chunk=4096
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for w,k,nets in [(128,4096,10),(256,4096,5)]:
 weights=[]; targets=[]
 for i in range(nets):
  rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(32)]
  weights.append(ws); targets.append(target(ws, n=40000 if w==128 else 25000, seed=1000+i))
 print('w',w)
 for blocks in [1,2,4,8,16]:
  if k//2//blocks <= w: continue
  S=make(w,k,123,blocks)
  ms=[((pred(ws,S)-t)**2).mean() for ws,t in zip(weights,targets)]
  print(blocks,np.mean(ms),ms)

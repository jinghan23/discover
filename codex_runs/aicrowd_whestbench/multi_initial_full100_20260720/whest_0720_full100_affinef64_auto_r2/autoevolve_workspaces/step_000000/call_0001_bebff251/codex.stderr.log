import numpy as np
INV=0.3989422804014327

def make(kind,w,k,seed):
 rng=np.random.default_rng(seed); n=k//2
 if kind=='gauss':
  u=rng.standard_normal((n,w)).astype(np.float32); cov=(u.T@u)/n; ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32)
 elif kind=='radem':
  half=rng.choice(np.array([-1,1],dtype=np.float32), size=(n,w))
  cov=(half.T@half)/n; ev,Q=np.linalg.eigh(cov); half=(half@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32)
 elif kind=='radem_raw':
  half=rng.choice(np.array([-1,1],dtype=np.float32), size=(n,w))
 return np.concatenate([half,-half],0)
def pred(ws,S):
 W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV; x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(ws,n,seed):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0
 while done<n:
  m=min(4096,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
w=256;k=4096;nets=10;weights=[];targets=[]
for i in range(nets):
 rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(32)]
 weights.append(ws); targets.append(target(ws,25000,1000+i))
for kind in ['gauss','radem','radem_raw']:
 S=make(kind,w,k,123); ms=[((pred(ws,S)-t)**2).mean() for ws,t in zip(weights,targets)]
 print(kind,np.mean(ms),ms)

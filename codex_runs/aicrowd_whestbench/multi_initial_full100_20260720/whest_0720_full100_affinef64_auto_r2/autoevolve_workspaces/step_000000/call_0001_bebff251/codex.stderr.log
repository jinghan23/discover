from __future__ import annotations

from pathlib import Path  # noqa: F401  (used by the commented weight-loading example)

import flopscope.numpy as fnp

from whestbench import BaseEstimator, MLP, SetupContext


class Estimator(BaseEstimator):
    def setup(self, ctx: SetupContext) -> None:
        # setup() runs once, off the FLOP budget. Package the FOLDER
        # (`whest package --estimator .`) and every file beside estimator.py is
        # bundled automatically and extracted to ctx.submission_dir on the grader.
        # Load weights there:
        #
        #   weights = fnp.load(Path(ctx.submission_dir) / "weights.npz")  # 0 FLOPs
        #   self._W = weights["W"]
        #
        # You can also split your code across modules — siblings ship + import fine
        # in folder mode. (Packaging the single file, `--estimator estimator.py`,
        # ships ONLY this file — no siblings, no weights.)
        #
        # The grader sandbox has only flopscope (flopscope.numpy as fnp), the
        # whestbench API, and the Python stdlib — no third-party packages
        # (numpy, scipy, torch, …) and no requirements.txt install. Do heavier
        # work offline and ship the result as a pickle-free .npz (loaded above).
        self._ctx = ctx

    def predict(self, mlp: MLP, budget: int) -> fnp.ndarray:
        _ = budget
        return fnp.zeros((mlp.depth, mlp.width))


def makehalf(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32); return half
def had(W,rev=False):
 A=W[::-1].copy() if rev else W.copy(); n=A.shape[0]; h=1
 while h<n:
  B=A.reshape(-1,2*h,A.shape[1]); a=B[:,:h,:].copy(); b=B[:,h:2*h,:].copy(); B[:,:h,:]=a+b; B[:,h:2*h,:]=a-b; h*=2
 return A/np.sqrt(n)
def pred(ws,H,frac=0,rev=True):
 W=ws[0]; n=H.shape[0]; n2=int(n*frac); parts=[]
 if n-n2>0:
  z=H[:n-n2]@W; parts += [np.maximum(z,0), np.maximum(-z,0)]

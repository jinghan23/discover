/bin/bash -lc "python - <<'PY'
import numpy as np
INV=0.3989422804014327

def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32); return np.concatenate([half,-half],0)
def pred(ws,S,mode='none',seed=0):
 W0=ws[0]
 if mode=='sign':
  rng=np.random.default_rng(seed); signs=rng.choice(np.array([-1,1],dtype=np.float32), size=W0.shape[0]); W0=signs[:,None]*W0
 elif mode=='perm':
  rng=np.random.default_rng(seed); p=rng.permutation(W0.shape[0]); W0=W0[p]
 elif mode=='signperm':
  rng=np.random.default_rng(seed); p=rng.permutation(W0.shape[0]); signs=rng.choice(np.array([-1,1],dtype=np.float32), size=W0.shape[0]); W0=signs[:,None]*W0[p]
 W=W0; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV; x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)

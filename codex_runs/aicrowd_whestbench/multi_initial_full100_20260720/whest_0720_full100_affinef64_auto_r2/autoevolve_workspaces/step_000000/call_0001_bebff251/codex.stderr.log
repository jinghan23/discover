codex
A more structural variance reduction applies here: the whole no-bias ReLU network is positively homogeneous, so the Gaussian input radius can be integrated out analytically. I’m testing sphere-direction probes scaled by the exact mean Gaussian radius.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=0.3989422804014327

def er_mean_radius(w):
 return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def make(kind,w,k,seed):
 rng=np.random.default_rng(seed); n=k//2; u=rng.standard_normal((n,w)).astype(np.float32)
 if kind=='gauss_whiten':
  half=u
 elif kind.startswith('sphere'):
  r=np.linalg.norm(u,axis=1,keepdims=True); half=u/np.maximum(r,1e-12)*er_mean_radius(w)
 if kind in ['gauss_whiten','sphere_whiten','sphere_whiten_rescale']:
  cov=(half.T@half)/n; ev,Q=np.linalg.eigh(cov); half=(half@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32)
  if kind=='sphere_whiten_rescale':
   rr=np.linalg.norm(half,axis=1,keepdims=True); half=(half/np.maximum(rr,1e-12)*er_mean_radius(w)).astype(np.float32)
 return np.concatenate([half,-half],0)

def baseline(ws,S):
 W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV
 x=np.maximum(S@W,0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
 x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)

def rawforward(ws,S):
 x=S
 for W in ws: x=np.maximum(x@W,0)
 return x.mean(0)

def target(ws,n=50000,seed=99):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0; chunk=4096
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for w,k,nets in [(128,4096,5),(256,4096,3)]:
 print('w',w,'rmean',er_mean_radius(w),'sqrtw',math.sqrt(w))
 Ss={kind:make(kind,w,k,123) for kind in ['gauss_whiten','sphere','sphere_whiten','sphere_whiten_rescale']}
 for kind,S in Ss.items():
  for corr in [True,False]:
   ms=[]
   for i in range(nets):
    rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(32)]
    t=target(ws, n=30000 if w==256 else 50000, seed=1000+i)
    p=baseline(ws,S) if corr else rawforward(ws,S)
    ms.append(((p-t)**2).mean())
   print(kind,'corr' if corr else 'raw',np.mean(ms),ms)

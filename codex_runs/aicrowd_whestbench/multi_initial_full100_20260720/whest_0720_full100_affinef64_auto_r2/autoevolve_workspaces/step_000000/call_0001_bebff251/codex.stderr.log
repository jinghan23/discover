def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32); return np.concatenate([half,-half],0)
def forward(ws,S):
 W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV; x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x
def cv_pred(ws,S,scale,beta_mode='est'):
 y=forward(ws,S); ym=y.mean(0)
 V=ws[0].astype(np.float64)

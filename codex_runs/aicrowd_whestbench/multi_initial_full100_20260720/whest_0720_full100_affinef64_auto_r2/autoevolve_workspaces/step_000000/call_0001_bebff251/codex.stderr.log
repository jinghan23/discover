codex
I’m checking fixed Hadamard rotations locally next. They are deterministic orthogonal rotations, so they avoid per-MLP random orientation luck while still probing a different high-order structure of the same Gaussian integral.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
INV=0.3989422804014327

def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); ev,Q=np.linalg.eigh(cov); half=(u@((Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T)).astype(np.float32); return np.concatenate([half,-half],0)
def had(W):
 A=W.copy(); h=1
 n=A.shape[0]
 while h<n:
  B=A.reshape(-1,2*h,A.shape[1]); a=B[:,:h,:].copy(); b=B[:,h:2*h,:].copy(); B[:,:h,:]=a+b; B[:,h:2*h,:]=a-b; h*=2
 return A/np.sqrt(n)
def pred(ws,S,mode='none'):
 W=ws[0]
 if mode=='had': W=had(W)
 elif mode=='revhad': W=had(W[::-1])
 fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV; x=np.maximum(S@W,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+fm
 for W in ws[1:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(ws,n,seed):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0
 while done<n:
  m=min(4096,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)

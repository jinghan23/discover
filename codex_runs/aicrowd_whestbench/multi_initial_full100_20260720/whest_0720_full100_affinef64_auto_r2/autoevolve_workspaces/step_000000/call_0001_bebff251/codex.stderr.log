/bin/bash -lc "python - <<'PY'
import numpy as np, time
from scipy.stats import qmc, norm
INV=0.3989422804014327

def whiten_half(u):
    cov=(u.T@u)/u.shape[0]
    ev,Q=np.linalg.eigh(cov)
    inv=(Q/np.sqrt(np.maximum(ev,1e-6)))@Q.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def samples(kind,w,k,seed):
    n=k//2
    if kind=='rand':
      rng=np.random.default_rng(seed); u=rng.standard_normal((n,w)).astype(np.float32)
    elif kind=='sobol':
      sampler=qmc.Sobol(d=w, scramble=True, seed=seed)
      uu=sampler.random(n)
      uu=np.clip(uu,1e-7,1-1e-7)
      u=norm.ppf(uu).astype(np.float32)
    elif kind=='lhs':
      sampler=qmc.LatinHypercube(d=w, scramble=True, seed=seed)
      uu=sampler.random(n)
      u=norm.ppf(uu).astype(np.float32)
    return whiten_half(u)

def baseline(ws, samples):
    W=ws[0]; fv=np.sum(W*W,0); fm=np.sqrt(fv)*INV
    x=np.maximum(samples@W,0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=fv*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+fm
    for W in ws[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def target(ws,n=40000,seed=99):
 rng=np.random.default_rng(seed); s=np.zeros(ws[0].shape[0]); done=0; chunk=4096
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,ws[0].shape[0])).astype(np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
w=128; d=32; k=4096; nets=5
Ss={kind:samples(kind,w,k,123) for kind in ['rand','sobol','lhs']}
for kind,S in Ss.items():
 ms=[]
 for i in range(nets):
  rng=np.random.default_rng(i); ws=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
  t=target(ws, n=50000, seed=1000+i)
  p=baseline(ws,S)
  ms.append(((p-t)**2).mean())
 print(kind, np.mean(ms), ms)

  zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)

def sphere(Ws,k=4096,seed=0,whiten=False,renorm=False,calib1=False,calib2=False):
 w=Ws[0].shape[0]; samples=make_sphere(w,k,seed,whiten,renorm); scale=mean_radius(w)/math.sqrt(w)
 W=Ws[0]; var=np.sum(W*W,axis=0); mean=np.sqrt(var)*INV
 p=samples@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0)
 if calib1:

/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def make(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)); cov=u.T@u/(k//2); ev,U=np.linalg.eigh(cov); return u@((U/np.sqrt(np.maximum(ev,1e-6)))@U.T)
def fcov(W,var,mean):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]; rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]
def mat_sqrt(cov, inv=False):
 ev,U=np.linalg.eigh((cov+cov.T)/2); ev=np.maximum(ev,1e-9); vals=1/np.sqrt(ev) if inv else np.sqrt(ev); return (U*vals)@U.T
def pred(Ws,k,seed,mode='diag'):
 w=Ws[0].shape[0]; s=make(w,k,seed); W=Ws[0]; var=(W*W).sum(0); mean=np.sqrt(var)*INV; p=s@W; x=np.r_[np.maximum(p,0),np.maximum(-p,0)]
 if len(Ws)==1:return mean
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); av=var*(.5-INV*INV); x=(x-sm)*np.sqrt(av/sv)+mean
 cov=fcov(W,var,mean); W2=Ws[1]; z=x@W2; tm=mean@W2; cw=cov@W2; tv=np.maximum((W2*cw).sum(0),1e-8); zm=z.mean(0)
 if mode=='diag':
  zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); z=(z-zm)*np.sqrt(tv/zv)+tm
 elif mode=='full':
  target=W2.T@cw; zc=z-zm; sc=zc.T@zc/z.shape[0]
  trans=mat_sqrt(sc,True)@mat_sqrt(target,False)
  z=zc@trans+tm
 elif mode=='fullclip':
  target=W2.T@cw; zc=z-zm; sc=zc.T@zc/z.shape[0]
  trans=mat_sqrt(sc,True)@mat_sqrt(target,False)
  z=zc@trans+tm
 x=np.maximum(z,0)
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)
def true(Ws,n,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; s=np.zeros(w); c=0
 for _ in range((n+19999)//20000):
  b=min(20000,n-c); x=rng.standard_normal((b,w));
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); c+=b
 return s/c
for w,d,k in [(16,5,1024),(32,6,4096),(64,5,4096),(64,8,8192)]:
 rng=np.random.default_rng(31); acc={n:[] for n in ['diag','full','full_halfk']}
 for tr in range(6):
  Ws=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; t=true(Ws,140000 if w<64 else 70000,100+tr)
  acc['diag'].append(np.mean((pred(Ws,k,tr,'diag')-t)**2)); acc['full'].append(np.mean((pred(Ws,k,tr,'full')-t)**2)); acc['full_halfk'].append(np.mean((pred(Ws,k//2,tr,'full')-t)**2))
 print('case',w,d,k,{n:float(np.mean(v)) for n,v in acc.items()})
PY" in /opt/tiger/discover/workspace

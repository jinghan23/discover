import numpy as np

INV=np.float64(0.3989422804014327); PI=np.pi; TWO=2*np.pi

def make_samples(width,k,seed=0):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    u64=u.astype(np.float64)
    cov=u64.T@u64/(k//2)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    return (u64@inv).astype(np.float32)

def first_cov(W,var,mean):
    gram=W.T@W
    std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
    rho=np.clip(gram/np.maximum(scale,1e-12),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    second=scale*(root+(PI-np.arccos(rho))*rho)/TWO
    return second-mean[:,None]*mean[None,:]

def current(Ws,k=4096,seed=0):
    w=Ws[0].shape[0]; d=len(Ws); samples=make_samples(w,k,seed)
    W=Ws[0]; var=np.sum(W*W,axis=0); mean=np.sqrt(var)*INV
    p=samples@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=var*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+mean
    if d>1:
        cov=first_cov(W,var,mean); W=Ws[1]; z=x@W
        tm=mean@W; cw=cov@W; tv=np.maximum(np.sum(W*cw,axis=0),1e-8)
        zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
        x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in Ws[2:]: x=np.maximum(x@W,0)
    return x.mean(0)

def diag_gauss_moments(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
    # Phi via erf
    Phi=0.5*(1+np.vectorize(__import__('math').erf)(a/np.sqrt(2)))
    phi=INV*np.exp(-0.5*a*a)
    m=sig*phi+mu*Phi
    second=(var+mu*mu)*Phi+mu*sig*phi
    return m, np.maximum(second-m*m,1e-12)

def diag_calib(Ws,k=4096,seed=0, start=2, blend=1.0):
    w=Ws[0].shape[0]; d=len(Ws); samples=make_samples(w,k,seed)
    W=Ws[0]; var=np.sum(W*W,axis=0); mean=np.sqrt(var)*INV
    p=samples@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    act_var=var*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(act_var/sv)+mean
    if d>1:
        cov=first_cov(W,var,mean); W=Ws[1]; z=x@W
        pre_mean=mean@W; cw=cov@W; pre_var=np.maximum(np.sum(W*cw,axis=0),1e-8)
        zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
        x=np.maximum((z-zm)*np.sqrt(pre_var/zv)+pre_mean,0)
        mean, act_var = diag_gauss_moments(pre_mean, pre_var)
    for li,W in enumerate(Ws[2:], start=2):
        z=x@W
        pre_mean=mean@W
        pre_var=np.maximum(act_var@(W*W),1e-8)
        if li>=start:
            zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
            # blend in log variance and mean? simple target blend
            tm=blend*pre_mean+(1-blend)*zm
            tv=np.exp(blend*np.log(pre_var)+(1-blend)*np.log(zv))
            z=(z-zm)*np.sqrt(tv/zv)+tm
        x=np.maximum(z,0)
        mean, act_var = diag_gauss_moments(pre_mean, pre_var)
    return x.mean(0)

def covmatch_first(Ws,k=4096,seed=0):
    w=Ws[0].shape[0]; d=len(Ws); samples=make_samples(w,k,seed)
    W=Ws[0]; var=np.sum(W*W,axis=0); mean=np.sqrt(var)*INV
    p=samples@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0).astype(np.float64)
    cov=first_cov(W,var,mean)
    xc=x-x.mean(0)
    sc=xc.T@xc/x.shape[0]
    ev, U=np.linalg.eigh(sc); ev=np.maximum(ev,1e-8)
    tv,V=np.linalg.eigh((cov+cov.T)/2); tv=np.maximum(tv,1e-10)
    trans=(U/np.sqrt(ev))@U.T@(V*np.sqrt(tv))@V.T
    x=xc@trans+mean
    # maybe no relu preserved positivity lost, use as activation values can negative after affine; bad?
    # clip? 
    x=np.maximum(x,0) # try preserving activation support but ruins covariance
    if d>1:
        W=Ws[1]; z=x@W
        tm=mean@W; cw=cov@W; tv=np.maximum(np.sum(W*cw,axis=0),1e-8)
        zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8)
        x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
    for W in Ws[2:]: x=np.maximum(x@W,0)
    return x.mean(0)

def true_mc(Ws,n=400000,seed=123):
    rng=np.random.default_rng(seed); w=Ws[0].shape[0]
    batch=20000; s=np.zeros(w); count=0
    for _ in range((n+batch-1)//batch):
        b=min(batch,n-count); x=rng.standard_normal((b,w))
        for W in Ws: x=np.maximum(x@W,0)
        s+=x.sum(0); count+=b
    return s/count

for w,d,k in [(16,5,1024),(32,6,4096),(64,5,4096)]:
  rng=np.random.default_rng(42)
  ms=[]
  for trial in range(5):
    Ws=[rng.standard_normal((w,w))/np.sqrt(w) for _ in range(d)]
    t=true_mc(Ws,n=200000 if w<=32 else 100000,seed=100+trial)
    preds={
      'cur':current(Ws,k,trial),
      'diag1':diag_calib(Ws,k,trial,2,1.0),
      'diag05':diag_calib(Ws,k,trial,2,0.5),
      'diag025':diag_calib(Ws,k,trial,2,0.25),
      'diag3_05':diag_calib(Ws,k,trial,3,0.5),
      'cov1':covmatch_first(Ws,k,trial),
    }
    ms.append({name:np.mean((p-t)**2) for name,p in preds.items()})
  print('case',w,d,k)
  for name in ms[0]: print(name, np.mean([m[name] for m in ms]))

  # activation for sphere scaled sqrtw; target Gaussian mean. Adjust x before subsequent layers in scaled units? Match mean after scale.
  sample_mean=x.mean(0); sample_second=(x*x).mean(0); sample_var=np.maximum(sample_second-sample_mean*sample_mean,1e-6)
  # Need target direction activation moments? Gaussian variance radial removed. Use target mean/scale for direction; no exact var. Try target Gaussian var/scale"'^2.
  target_mean=mean/scale; target_var=var*(.5-INV*INV)/(scale*scale)
  x=(x-sample_mean)*np.sqrt(target_var/sample_var)+target_mean

import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def mean_radius(w): return math.sqrt(2.0)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

def make_normal(w,k,seed=0):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)); cov=u.T@u/(k//2); ev,U=np.linalg.eigh(cov); return u@((U/np.sqrt(np.maximum(ev,1e-6)))@U.T)

def make_sphere(w,k,seed=0,whiten=False,renorm=False):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)); r=np.sqrt((u*u).sum(1,keepdims=True)); v=u/np.maximum(r,1e-12)*math.sqrt(w)
 if whiten:
  cov=v.T@v/(k//2); ev,U=np.linalg.eigh(cov); v=v@((U/np.sqrt(np.maximum(ev,1e-6)))@U.T)
 if renorm:
  r=np.sqrt((v*v).sum(1,keepdims=True)); v=v/np.maximum(r,1e-12)*math.sqrt(w)
 return v

def first_cov(W,var,mean):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]
 rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
 return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]

def current(Ws,k=4096,seed=0):
 w=Ws[0].shape[0]; samples=make_normal(w,k,seed); W=Ws[0]; var=np.sum(W*W,axis=0); mean=np.sqrt(var)*INV
 p=samples@W; x=np.concatenate([np.maximum(p,0),np.maximum(-p,0)],0)
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=var*(.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+mean
 if len(Ws)>1:

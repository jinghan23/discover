# Reuse simplified current/sphere from earlier to test blends
import numpy as np, math
INV=0.3989422804014327; PI=math.pi; TWO=2*math.pi

def mean_radius(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def make_normal(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)); cov=u.T@u/(k//2); ev,U=np.linalg.eigh(cov); return u@((U/np.sqrt(np.maximum(ev,1e-6)))@U.T)
def make_sphere(w,k,seed):
 u=make_normal(w,k,seed); r=np.sqrt((u*u).sum(1,keepdims=True)); return u/np.maximum(r,1e-12)*math.sqrt(w)
def fcov(W,var,mean):
 gram=W.T@W; std=np.sqrt(np.maximum(var,1e-12)); scale=std[:,None]*std[None,:]; rho=np.clip(gram/np.maximum(scale,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); return scale*(root+(PI-np.arccos(rho))*rho)/TWO-mean[:,None]*mean[None,:]
def cur(Ws,k,seed):
 w=Ws[0].shape[0]; s=make_normal(w,k,seed); W=Ws[0]; var=(W*W).sum(0); mean=np.sqrt(var)*INV; p=s@W; x=np.r_[np.maximum(p,0),np.maximum(-p,0)]
 if len(Ws)==1:return mean
 sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=var*(.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+mean
 cov=fcov(W,var,mean); W=Ws[1]; z=x@W; tm=mean@W; cw=cov@W; tv=np.maximum((W*cw).sum(0),1e-8); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
 for W in Ws[2:]: x=np.maximum(x@W,0)
 return x.mean(0)
def sph(Ws,k,seed):
 w=Ws[0].shape[0]; s=make_sphere(w,k,seed); scale=mean_radius(w)/math.sqrt(w); x=None
 for W in Ws:
  if x is None: x=np.maximum(np.r_[s,-s]@W,0)
  else: x=np.maximum(x@W,0)
 return x.mean(0)*scale
def true(Ws,n,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; s=np.zeros(w); c=0
 for _ in range((n+19999)//20000):
  b=min(20000,n-c); x=rng.standard_normal((b,w));
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); c+=b
 return s/c
for w,d,k in [(16,5,1024),(32,6,4096),(64,5,4096),(64,8,8192)]:
 rng=np.random.default_rng(19); names=['cur','sph','b05','b1','b2','bneg']; acc={n:[] for n in names}
 for tr in range(8):
  Ws=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; t=true(Ws,160000 if w<64 else 80000,900+tr); c=cur(Ws,k,tr); s=sph(Ws,k,tr)
  preds={'cur':c,'sph':s,'b05':.95*c+.05*s,'b1':.9*c+.1*s,'b2':.8*c+.2*s,'bneg':1.05*c-.05*s}
  for n,p in preds.items(): acc[n].append(np.mean((p-t)**2))
 print('case',w,d,k)
 for n,v in acc.items(): print(n,float(np.mean(v)))

  zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-8); x=np.maximum((z-zm)*np.sqrt(tv/zv)+tm,0)
  start=2
 else:
  start=1
 for W in Ws[start:]: x=np.maximum(x@W,0)
 return x.mean(0)*scale

def true(Ws,n,seed):

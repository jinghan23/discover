/bin/bash -lc "python - <<'PY'
import importlib.util, time, gc
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext

for w,d,B,n,gt in [(64,32,16_000_000_000,12,120_000),(128,32,64_000_000_000,8,80_000),(256,32,256_000_000_000,5,50_000)]:
    spec=ContestSpec(width=w, depth=d, n_mlps=n, flop_budget=B, ground_truth_samples=gt, seed=4040+w, wall_time_limit_s=30.0)
    print('--- spec',w,d,'making')
    t=time.time(); data=make_contest(spec); print('contest',time.time()-t)
    for full in [False, True]:
        for frac in ([0.143] if not full else [0.125,0.135,0.143]):
            sub_spec=importlib.util.spec_from_file_location('sub','submission.py')
            sub=importlib.util.module_from_spec(sub_spec); sub_spec.loader.exec_module(sub)
            sub._SECOND_FULL_COVARIANCE=full
            sub._BUDGET_FRACTION=frac
            est=sub.Estimator(); est.setup(SetupContext(width=w, depth=d, flop_budget=B, api_version='x', seed=999))
            t=time.time(); res=evaluate_estimator(est,data); print('full',full,'frac',frac,'adj',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'],'time',time.time()-t)
            gc.collect()

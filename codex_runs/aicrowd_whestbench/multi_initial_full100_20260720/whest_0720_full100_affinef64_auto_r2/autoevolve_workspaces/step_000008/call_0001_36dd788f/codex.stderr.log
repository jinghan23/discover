/bin/bash -lc "python - <<'PY'
import importlib.util, time, gc, math
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext

def orth_samples(width,count,seed):
    rng=fnp.random.default_rng(seed)
    blocks=[]
    remaining=count
    while remaining>=width:
        a=rng.standard_normal((width,width), dtype=fnp.float32)
        q,r=fnp.linalg.qr(a)
        signs=fnp.where(fnp.diag(r)>=0.0,1.0,-1.0)
        q=q*signs[None,:]
        blocks.append(fnp.asarray(q,dtype=fnp.float32))
        remaining-=width
    if remaining>0:
        u=rng.standard_normal((remaining,width), dtype=fnp.float32)
        norm=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-12))
        blocks.append(u/norm)
    return fnp.concatenate(blocks,axis=0)

for w,d,B,n,gt in [(128,32,64_000_000_000,8,80_000),(256,32,256_000_000_000,5,50_000)]:
    spec=ContestSpec(width=w, depth=d, n_mlps=n, flop_budget=B, ground_truth_samples=gt, seed=10000+w, wall_time_limit_s=30.0)
    print('--- spec',w,'making'); t=time.time(); data=make_contest(spec); print('contest',time.time()-t)
    for kind in ['current','orth']:
        sub_spec=importlib.util.spec_from_file_location('sub','submission.py')
        sub=importlib.util.module_from_spec(sub_spec); sub_spec.loader.exec_module(sub)
        est=sub.Estimator(); est.setup(SetupContext(width=w, depth=d, flop_budget=B, api_version='x', seed=999))
        if kind=='orth':
            est._samples=orth_samples(w, est._samples.shape[0], 999+sub._SETUP_SEED_OFFSET)
        res=evaluate_estimator(est,data)
        print(kind,'adj',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'])
        gc.collect()

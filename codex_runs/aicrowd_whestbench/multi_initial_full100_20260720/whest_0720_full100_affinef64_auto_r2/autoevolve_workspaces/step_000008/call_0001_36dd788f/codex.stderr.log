codex
Orthogonal blocks improve two synthetic suites substantially. I’m timing setup for larger widths to make sure this design fits the setup timeout before testing it in the blackbox.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope.numpy as fnp

def orth_samples(width,count,seed):
    rng=fnp.random.default_rng(seed)
    blocks=[]; remaining=count
    while remaining>=width:
        a=rng.standard_normal((width,width), dtype=fnp.float32)
        q,r=fnp.linalg.qr(a)
        signs=fnp.where(fnp.diag(r)>=0.0,1.0,-1.0)
        q=q*signs[None,:]
        blocks.append(fnp.asarray(q,dtype=fnp.float32)); remaining-=width
    if remaining>0:
        u=rng.standard_normal((remaining,width), dtype=fnp.float32)
        norm=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-12))
        blocks.append(u/norm)
    return fnp.concatenate(blocks,axis=0)
for w,c in [(256,4300),(512,4300),(1024,4300)]:
    t=time.time(); s=orth_samples(w,c,1002); print(w,s.shape,'time',time.time()-t)

    t=time.time(); res=evaluate_estimator(est,data); print(label,val,'samples',est._samples.shape,'adj',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'],'mult',res['mean_score_multiplier'],'setup?','time',time.time()-t)

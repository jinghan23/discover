/bin/bash -lc "python - <<'PY'
import importlib.util, time, gc
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext

matches=[0.0,0.25,0.5]
for w,d,B,n,gt,seeds in [(128,32,64_000_000_000,6,60_000,[6101,6102,6103]),(256,32,256_000_000_000,4,40_000,[6201,6202,6203])]:
    sums={m:0.0 for m in matches}; mses={m:0.0 for m in matches}
    print('--- avg spec',w)
    for seed in seeds:
        spec=ContestSpec(width=w, depth=d, n_mlps=n, flop_budget=B, ground_truth_samples=gt, seed=seed, wall_time_limit_s=30.0)
        t=time.time(); data=make_contest(spec); print(' seed',seed,'contest',time.time()-t)
        for m in matches:
            sub_spec=importlib.util.spec_from_file_location('sub','submission.py')
            sub=importlib.util.module_from_spec(sub_spec); sub_spec.loader.exec_module(sub)
            sub._SECOND_POST_MATCH=m
            est=sub.Estimator(); est.setup(SetupContext(width=w, depth=d, flop_budget=B, api_version='x', seed=999))
            res=evaluate_estimator(est,data)
            sums[m]+=res['adjusted_final_layer_score']; mses[m]+=res['final_layer_mse']
            print('  match',m,'adj',res['adjusted_final_layer_score'],'mse',res['final_layer_mse'])
            gc.collect()
    for m in matches:
        print('AVG match',m,'adj',sums[m]/len(seeds),'mse',mses[m]/len(seeds))

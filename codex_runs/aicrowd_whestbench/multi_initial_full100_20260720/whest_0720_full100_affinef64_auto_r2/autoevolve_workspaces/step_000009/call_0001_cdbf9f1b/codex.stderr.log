    mlp=sample_mlp(w,d,fnp.random.default_rng(101000+i),seed=102000+i)
    _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(103000+i))
    mlps.append(mlp); targets.append(final)
est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777))
cov=CovariancePropagationEstimator(); mean=MeanPropagationEstimator()

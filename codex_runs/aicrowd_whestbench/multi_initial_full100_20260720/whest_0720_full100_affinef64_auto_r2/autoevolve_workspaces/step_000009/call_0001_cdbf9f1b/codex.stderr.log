codex
I’m sweeping `_FIRST_VARIANCE_FACTOR` and `_SECOND_VARIANCE_FACTOR` locally. These affect early moment matching, which often dominates deep ReLU propagation error.
exec
/bin/bash -lc "python - <<'PY'
import importlib.util
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
w=256; d=32; b=272_000_000_000; target_n=120000; n_mlps=4
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(w,d,fnp.random.default_rng(91000+i),seed=92000+i)
    _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(93000+i))
    mlps.append(mlp); targets.append(final)

def score(f1,f2):
    sub._FIRST_VARIANCE_FACTOR=f1; sub._SECOND_VARIANCE_FACTOR=f2
    est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777))
    ms=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,b)[-1]
        ms.append(float(fnp.mean((p-t)**2)))
    return sum(ms)/len(ms)
for f1 in [0.90,0.95,0.98,1.0,1.02,1.05,1.10]:
    print('f1',f1,'mse',score(f1,1.0),flush=True)
for f2 in [0.90,0.95,0.98,1.0,1.02,1.05,1.10]:
    print('f2',f2,'mse',score(1.0,f2),flush=True)
print('grid')
for f1 in [0.96,0.98,1.0,1.02,1.04]:
  row=[]
  for f2 in [0.96,0.98,1.0,1.02,1.04]:
    row.append(score(f1,f2))
  print('f1',f1,' '.join(f'{x:.3e}' for x in row),flush=True)

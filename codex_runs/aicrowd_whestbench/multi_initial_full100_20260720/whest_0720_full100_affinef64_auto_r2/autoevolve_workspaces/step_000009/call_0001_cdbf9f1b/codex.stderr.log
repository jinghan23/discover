 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
@@ -23,8 +23,12 @@
 _WHITEN_ROUNDS = 4
 _WHITEN_BLOCKS = 1
 _DIAG_BLEND = 0.0
+_COV_BLEND = 0.0
 _RADEMACHER_FRACTION = 0.0
-_THIRD_MOMENT_BLEND = 0.025
+_THIRD_MOMENT_BLEND = -0.025
+_LATE_MOMENT_BLEND = 0.0
+_FINAL_MOMENT_BLEND = 0.0
+_COV_RESCALE_THRESHOLD = 1e100
 
 
 def _sample_count(budget: int, width: int, depth: int) -> int:
@@ -89,6 +93,32 @@
     return mean
 
 
+def _covariance_gaussian_final(mlp):
+    width = mlp.width
+    mean = fnp.zeros(width, dtype=fnp.float32)
+    covariance = fnp.eye(width, dtype=fnp.float32)
+    log_scale = 0.0
+    for weight in mlp.weights:
+        diagonal = fnp.diag(covariance)
+        max_variance = float(fnp.max(fnp.asarray(diagonal)))
+        if max_variance > _COV_RESCALE_THRESHOLD:
+            scale = float(fnp.sqrt(max_variance))
+            mean = mean / scale
+            covariance = covariance / (scale * scale)
+            log_scale += float(fnp.log(scale))
+        pre_mean = mean @ weight
+        pre_covariance = weight.T @ covariance @ weight
+        pre_variance = fnp.maximum(fnp.diag(pre_covariance), 1e-12)
+        mean, second = _normal_relu_moments(pre_mean, pre_variance)
+        centered = fnp.maximum(second - mean * mean, 0.0)
+        probability = _normal_cdf(pre_mean / fnp.sqrt(pre_variance))
+        covariance = pre_covariance * (probability[:, None] * probability[None, :])
+        fnp.fill_diagonal(covariance, centered)
+    if log_scale:
+        mean = mean * float(math.exp(log_scale))
+    return mean
+
+
 class Estimator(BaseEstimator):
     def setup(self, context):
         self._width = int(context.width)

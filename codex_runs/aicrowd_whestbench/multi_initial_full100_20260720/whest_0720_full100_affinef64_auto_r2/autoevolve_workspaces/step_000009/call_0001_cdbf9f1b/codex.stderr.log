                 )
                 z = (z - z_mean) * fnp.sqrt(blended_variance / z_variance) + blended_mean
+            elif layer_index > 2 and _LATE_MOMENT_BLEND:
+                z_mean = fnp.mean(z, axis=0)
+                z_second = fnp.mean(z * z, axis=0)
+                z_variance = fnp.maximum(z_second - z_mean * z_mean, 1e-8)
+                diagonal_centered = fnp.maximum(
+                    analytic_second - analytic_mean * analytic_mean,
+                    1e-8,
+                )
+                diagonal_mean = analytic_mean @ weight
+                diagonal_variance = fnp.maximum(diagonal_centered @ (weight * weight), 1e-8)
+                blended_mean = (
+                    z_mean * (1.0 - _LATE_MOMENT_BLEND)
+                    + diagonal_mean * _LATE_MOMENT_BLEND
+                )
+                blended_variance = (
+                    z_variance * (1.0 - _LATE_MOMENT_BLEND)
+                    + diagonal_variance * _LATE_MOMENT_BLEND
+                )
+                z = (z - z_mean) * fnp.sqrt(blended_variance / z_variance) + blended_mean
+            if _FINAL_MOMENT_BLEND and layer_index == depth - 1:
+                z_mean = fnp.mean(z, axis=0)
+                z_second = fnp.mean(z * z, axis=0)
+                z_variance = fnp.maximum(z_second - z_mean * z_mean, 1e-8)
+                diagonal_centered = fnp.maximum(
+                    analytic_second - analytic_mean * analytic_mean,
+                    1e-8,
+                )
+                diagonal_mean = analytic_mean @ weight
+                diagonal_variance = fnp.maximum(diagonal_centered @ (weight * weight), 1e-8)
+                blended_mean = (

import importlib.util, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
w=256; d=32; b=272_000_000_000; n_mlps=2; target_n=80000
print('building targets',w,d,b,target_n,flush=True)
mlps=[]; targets=[]
for i in range(n_mlps):
    t0=time.time()
    mlp=sample_mlp(w,d,fnp.random.default_rng(7000+i),seed=8000+i)
    _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(9000+i))
    print('target',i,'sec',time.time()-t0,flush=True)
    mlps.append(mlp); targets.append(final)
for frac in [0.12,0.16,0.18,0.20,0.22,0.24,0.27,0.30]:
    sub._BUDGET_FRACTION=frac
    t0=time.time(); est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777)); setup=time.time()-t0
    ms=[]; ratios=[]
    for mlp,t in zip(mlps,targets):
        with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as bc:
            p=est.predict(mlp,b)[-1]
        ms.append(float(fnp.mean((p-t)**2))); ratios.append(bc.flops_used/b)
    mse=sum(ms)/len(ms); ratio=sum(ratios)/len(ratios)
    print('frac',frac,'k',est._samples.shape[0]*2,'setup',setup,'mse',mse,'ratio',ratio,'adj',mse*max(.1,ratio),flush=True)

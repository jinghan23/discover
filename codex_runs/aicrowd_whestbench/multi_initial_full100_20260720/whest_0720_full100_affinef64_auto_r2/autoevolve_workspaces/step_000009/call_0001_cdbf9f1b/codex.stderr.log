/bin/bash -lc "python - <<'PY'
import importlib.util, time
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def eval_spec(w,d,b,n_mlps=3,target_n=80000):
    print('### spec',w,d,b,'target_n',target_n,flush=True)
    mlps=[]; targets=[]
    for i in range(n_mlps):
        rng=fnp.random.default_rng(1000+i)
        mlp=sample_mlp(w,d,rng,seed=2000+i)
        trng=fnp.random.default_rng(3000+i)
        _, final, _ = sample_layer_statistics(mlp,target_n,rng=trng)
        mlps.append(mlp); targets.append(final)
    base_frac=sub._BUDGET_FRACTION
    for frac in [0.075,0.09,0.105,0.12,0.143,0.17,0.22]:
        sub._BUDGET_FRACTION=frac
        est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=999))
        mses=[]
        for mlp,t in zip(mlps,targets):
            p=est.predict(mlp,b)[-1]
            mses.append(float(fnp.mean((p-t)**2)))
        k=est._samples.shape[0]*2
        print('frac',frac,'k',k,'mse',sum(mses)/len(mses),'adj@max(frac,.1)',(sum(mses)/len(mses))*max(frac,0.1),flush=True)
    sub._BUDGET_FRACTION=base_frac

eval_spec(64,16,10**9,n_mlps=3,target_n=60000)
eval_spec(128,16,10**10,n_mlps=2,target_n=40000)

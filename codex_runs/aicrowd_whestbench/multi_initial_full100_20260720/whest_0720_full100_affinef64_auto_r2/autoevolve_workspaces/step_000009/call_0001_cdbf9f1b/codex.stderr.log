codex
I’m sweeping `_WHITEN_BLOCKS` locally at the competition-like shape. More blocks keep covariance control within blocks but change high-order angular coverage.
exec
/bin/bash -lc "python - <<'PY'
import importlib.util, time
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
w=256; d=32; b=272_000_000_000; target_n=120000; n_mlps=3
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(w,d,fnp.random.default_rng(41000+i),seed=42000+i)
    _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(43000+i))
    mlps.append(mlp); targets.append(final)
for blocks in [1,2,3,4,6,8,12,16,24,32]:
    sub._WHITEN_BLOCKS=blocks
    t0=time.time(); est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777)); setup=time.time()-t0
    ms=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,b)[-1]
        ms.append(float(fnp.mean((p-t)**2)))
    print('blocks',blocks,'actual_half',est._samples.shape[0],'setup',setup,'mse',sum(ms)/len(ms),flush=True)
PY" in /opt/tiger/discover/workspace

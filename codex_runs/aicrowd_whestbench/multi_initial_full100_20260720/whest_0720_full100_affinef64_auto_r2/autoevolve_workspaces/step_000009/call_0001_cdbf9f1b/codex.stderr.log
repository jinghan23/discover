import importlib.util
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def eval_spec(w,d,b,n_mlps,target_n):
    print('###',w,d,b,flush=True)
    mlps=[]; targets=[]
    for i in range(n_mlps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(4100+i),seed=5100+i)
        _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(6100+i))
        mlps.append(mlp); targets.append(final)
    for frac in [0.12,0.16,0.20,0.22,0.25,0.30,0.36,0.45,0.60]:
        sub._BUDGET_FRACTION=frac
        est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777))
        ms=[]; fl=[]
        for mlp,t in zip(mlps,targets):
            with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as bc:
                p=est.predict(mlp,b)[-1]
            ms.append(float(fnp.mean((p-t)**2))); fl.append(bc.flops_used/b)
        mse=sum(ms)/len(ms); ratio=sum(fl)/len(fl)
        print('frac',frac,'k',est._samples.shape[0]*2,'mse',mse,'ratio',ratio,'adj',mse*max(0.1,ratio),flush=True)

eval_spec(64,16,10**9,5,80000)

/bin/bash -lc "python - <<'PY'
import importlib.util, time
import flopscope.numpy as fnp
from whestbench import SetupContext, sample_mlp, sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','/opt/tiger/discover/workspace/submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
w=256; d=32; b=272_000_000_000; target_n=120000; n_mlps=3
mlps=[]; targets=[]
for i in range(n_mlps):
    mlp=sample_mlp(w,d,fnp.random.default_rng(51000+i),seed=52000+i)
    _, final, _=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(53000+i))
    mlps.append(mlp); targets.append(final)
for frac in [0.0,0.02,0.05,0.1,0.2,0.35,0.5,0.75,1.0]:
    sub._RADEMACHER_FRACTION=frac
    est=sub.Estimator(); est.setup(SetupContext(w,d,b,'local',seed=777))
    ms=[]
    for mlp,t in zip(mlps,targets):
        p=est.predict(mlp,b)[-1]
        ms.append(float(fnp.mean((p-t)**2)))
    print('rademacher',frac,'mse',sum(ms)/len(ms),flush=True)

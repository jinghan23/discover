+                )
+                z = (z - z_mean) * fnp.sqrt(blended_variance / z_variance) + blended_mean
             x = fnp.maximum(z, 0.0)
+            if (_LATE_MOMENT_BLEND or _FINAL_MOMENT_BLEND) and layer_index < depth - 1:
+                centered = fnp.maximum(analytic_second - analytic_mean * analytic_mean, 1e-8)
+                analytic_mean, analytic_second = _normal_relu_moments(
+                    analytic_mean @ weight,
+                    fnp.maximum(centered @ (weight * weight), 1e-8),
+                )
 
         final_mean = fnp.asarray(
             fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0),
@@ -232,5 +309,8 @@
         if _DIAG_BLEND:
             diagonal_mean = _diagonal_gaussian_final(mlp)
             final_mean = final_mean * (1.0 - _DIAG_BLEND) + diagonal_mean * _DIAG_BLEND
+        if _COV_BLEND:
+            covariance_mean = _covariance_gaussian_final(mlp)
+            final_mean = final_mean * (1.0 - _COV_BLEND) + covariance_mean * _COV_BLEND
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


import numpy as np, math, time
INV=0.3989422804014327; TWO=6.283185307179586

def make_samples(w,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w)).astype(np.float32)
    cov=(u.T@u)/(k//2)
    vals, vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def first_mom(W):
    C=W.T@W
    v=np.maximum(np.diag(C),1e-30)
    s=np.sqrt(v)
    m=s*INV
    denom=s[:,None]*s[None,:]
    corr=np.clip(C/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO
    Acov=(second-m[:,None]*m[None,:])
    return m.astype(np.float32), ((Acov+Acov.T)*0.5).astype(np.float32), v.astype(np.float32)

def baseline(weights,k,seed,factor=1.0):
    S=make_samples(weights[0].shape[0],k,seed)
    m1,C1,v1=first_mom(weights[0])
    x=np.maximum(S@weights[0],0)
    if len(weights)==1: return m1
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=v1*(0.5-INV*INV)*factor
    x=(x-sm)*np.sqrt(tv/sv)+m1
    W=weights[1]
    pre=x@W
    sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
    tm=m1@W
    tv=np.maximum(np.sum(W*(C1@W),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for W in weights[2:]:
        x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def full2(weights,k,seed,factor=1.0):
    S=make_samples(weights[0].shape[0],k,seed)
    m1,C1,v1=first_mom(weights[0])
    x=np.maximum(S@weights[0],0)
    if len(weights)==1: return m1
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=v1*(0.5-INV*INV)*factor
    x=(x-sm)*np.sqrt(tv/sv)+m1
    W=weights[1]
    pre=x@W
    sm=pre.mean(0)
    cen=(pre-sm).astype(np.float64)
    Cs=(cen.T@cen)/k
    tm=m1@W
    Ct=(W.T@C1@W).astype(np.float64)
    eps=1e-6*np.mean(np.diag(Ct))
    try:
      Ls=np.linalg.cholesky(Cs+np.eye(Cs.shape[0])*eps)
      Lt=np.linalg.cholesky(Ct+np.eye(Cs.shape[0])*eps)
      white=np.linalg.solve(Ls, cen.T).T
      pre=(white@Lt.T+tm).astype(np.float32)
    except Exception as e:
      sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
      tv=np.maximum(np.diag(Ct),1e-7)
      pre=(pre-sm)*np.sqrt(tv/sv)+tm
    x=np.maximum(pre,0)
    for W in weights[2:]:
        x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def target(weights,N,seed=1234,chunk=16384):
    rng=np.random.default_rng(seed); s=None; n=0
    for start in range(0,N,chunk):
        m=min(chunk,N-start)
        x=rng.standard_normal((m,weights[0].shape[0])).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        ss=x.astype(np.float64).sum(0)
        s=ss if s is None else s+ss; n+=m
    return (s/n).astype(np.float32)

for width,depth,k,N,nmlp in [(64,8,4096,200000,10),(128,8,4096,100000,5),(64,16,4096,100000,5)]:
    rng=np.random.default_rng(42)
    mb=[]; mf=[]
    t0=time.time()
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        tgt=target(weights,N,seed=1000+i)
        b=baseline(weights,k,seed=2000+i)
        f=full2(weights,max(64,k//2),seed=2000+i) # assume half k due cost
        mb.append(np.mean((b-tgt)**2)); mf.append(np.mean((f-tgt)**2))
    print('spec',width,depth,'k',k,'N',N,'base',np.mean(mb),'full2 halfk',np.mean(mf),'ratio',np.mean(mf)/np.mean(mb),'time',time.time()-t0)

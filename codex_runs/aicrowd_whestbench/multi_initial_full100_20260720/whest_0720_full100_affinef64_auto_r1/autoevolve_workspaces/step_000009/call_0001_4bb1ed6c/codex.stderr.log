         ) * 0.5
         return mean, activation_covariance, variance
 
+    def _covprop_final(self, weights, width):
+        mean = fnp.zeros(width, dtype=fnp.float32)
+        covariance = fnp.eye(width, dtype=fnp.float32)
+        for weight in weights:
+            pre_mean = mean @ weight
+            pre_covariance = weight.T @ covariance @ weight
+            pre_variance = fnp.maximum(fnp.diag(pre_covariance), 1e-12)
+            scale = fnp.sqrt(pre_variance)
+            alpha = pre_mean / scale
+            phi = flops.stats.norm.pdf(alpha)
+            capital_phi = flops.stats.norm.cdf(alpha)
+            mean = pre_mean * capital_phi + scale * phi
+            second = (
+                (pre_mean * pre_mean + pre_variance) * capital_phi
+                + pre_mean * scale * phi
+            )
+            post_variance = fnp.maximum(second - mean * mean, 0.0)
+            gain = fnp.where(scale > 1e-12, capital_phi, 0.0)
+            covariance = fnp.outer(gain, gain) * pre_covariance
+            fnp.fill_diagonal(covariance, post_variance)
+        return mean
+
     def predict(self, mlp, budget):
         width = mlp.width
         depth = mlp.depth
@@ -143,5 +167,11 @@
             fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0),
             dtype=fnp.float32,
         )
+        if _COVPROP_BLEND != 0.0:
+            prior = self._covprop_final(mlp.weights, width)
+            final_mean = (
+                (1.0 - _COVPROP_BLEND) * final_mean
+                + _COVPROP_BLEND * prior
+            )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


import numpy as np, math, time
INV=0.3989422804014327; TWO=6.283185307179586; SQRT2=math.sqrt(2.0)

def norm_pdf(a): return INV*np.exp(-0.5*a*a)
def norm_cdf(a):
    # Abramowitz-Stegun approximation
    sign=np.where(a<0,-1.0,1.0); x=np.abs(a)/SQRT2
    t=1.0/(1.0+0.3275911*x)
    y=1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*np.exp(-x*x)
    return 0.5*(1.0+sign*y)
def relu_mom(mu,var):
    var=np.maximum(var,1e-12); s=np.sqrt(var); a=mu/s; Phi=norm_cdf(a); phi=norm_pdf(a); m=mu*Phi+s*phi; second=(mu*mu+var)*Phi+mu*s*phi; return m.astype(np.float32),np.maximum(second-m*m,1e-8).astype(np.float32)
def make_samples(w,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); C=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(C); vals=np.maximum(vals,1e-6); half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([half,-half])
def first_mom(W):
    C=W.T@W; v=np.maximum(np.diag(C),1e-30); s=np.sqrt(v); m=s*INV; den=s[:,None]*s[None,:]; r=np.clip(C/den,-1,1); sec=den*(np.sqrt(np.maximum(1-r*r,0))+(np.pi-np.arccos(r))*r)/TWO; Ac=sec-m[:,None]*m[None,:]; return m.astype(np.float32),((Ac+Ac.T)*.5).astype(np.float32),v.astype(np.float32)
def base(weights,k,seed):
    S=make_samples(weights[0].shape[0],k,seed); m1,C1,v1=first_mom(weights[0]); x=np.maximum(S@weights[0],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=v1*(.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+m1; W=weights[1]; pre=x@W; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=m1@W; tv=np.maximum(np.sum(W*(C1@W),0),1e-7); x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0); 
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)
def diagcorr(weights,k,seed):
    S=make_samples(weights[0].shape[0],k,seed); m1,C1,v1=first_mom(weights[0]); x=np.maximum(S@weights[0],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); var1=v1*(.5-INV*INV); x=(x-sm)*np.sqrt(var1/sv)+m1
    W=weights[1]; pre=x@W; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=m1@W; tv=np.maximum(np.sum(W*(C1@W),0),1e-7); pre=(pre-sm)*np.sqrt(tv/sv)+tm; x=np.maximum(pre,0); mu,var=relu_mom(tm,tv)
    for W in weights[2:]:
        pre=x@W; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=mu@W; tv=np.maximum((W*W).T@var,1e-7); pre=(pre-sm)*np.sqrt(tv/sv)+tm; x=np.maximum(pre,0); mu,var=relu_mom(tm,tv)
    return x.mean(0)
def target(weights,N,seed):
    rng=np.random.default_rng(seed); s=0; n=0
    for st in range(0,N,8192):
      m=min(8192,N-st); x=rng.standard_normal((m,weights[0].shape[0])).astype(np.float32)
      for W in weights: x=np.maximum(x@W,0)
      s=s+x.astype(np.float64).sum(0); n+=m
    return s/n
for spec in [(64,8,4096,100000,10),(64,16,4096,100000,8),(128,8,4096,80000,5)]:
    width,depth,k,N,nmlp=spec; rng=np.random.default_rng(7); mb=[]; md=[]

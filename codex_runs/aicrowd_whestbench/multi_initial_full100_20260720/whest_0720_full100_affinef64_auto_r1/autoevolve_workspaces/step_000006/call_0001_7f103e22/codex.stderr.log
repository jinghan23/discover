def relu_mv(mu,var):
 var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig; P=Phi(a); p=phi(a); mean=sig*p+mu*P; second=(mu*mu+var)*P+mu*sig*p; return mean,fnp.maximum(second-mean*mean,1e-12)

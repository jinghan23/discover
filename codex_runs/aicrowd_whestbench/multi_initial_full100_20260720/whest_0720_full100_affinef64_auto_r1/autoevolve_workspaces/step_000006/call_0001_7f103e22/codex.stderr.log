import time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission

_INV_SQRT_2PI=0.3989422804014327

def phi(x): return _INV_SQRT_2PI*fnp.exp(-0.5*x*x)
def Phi(x):
    ax=fnp.abs(x)
    t=1.0/(1.0+0.2316419*ax)
    poly=(((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t)
    c=1.0-phi(ax)*poly
    return fnp.where(x>=0.0,c,1.0-c)
def relu_gauss_mean_var(mu,var):
    var=fnp.maximum(var,1e-12)
    sig=fnp.sqrt(var)
    a=mu/sig
    P=Phi(a); p=phi(a)
    mean=sig*p+mu*P
    second=(mu*mu+var)*P+mu*sig*p
    return mean,fnp.maximum(second-mean*mean,1e-12)

def first_layer_moments(weight):
    return submission.Estimator()._first_layer_moments(weight)

def baseline_with_samples(mlp,budget,samples):
    width=mlp.width; depth=mlp.depth
    first_weight=mlp.weights[0]
    first_mean, first_covariance, first_variance = submission.Estimator()._first_layer_moments(first_weight)
    x=fnp.maximum(samples@first_weight,0.0)
    if depth==1: return first_mean
    sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
    tv=first_variance*(0.5-_INV_SQRT_2PI*_INV_SQRT_2PI)
    x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
    w=mlp.weights[1]
    pre=x@w
    sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-7)
    tm=first_mean@w
    tv=fnp.maximum(fnp.sum(w*(first_covariance@w),axis=0),1e-7)
    pre=(pre-sm)*fnp.sqrt(tv/sv)+tm
    x=fnp.maximum(pre,0.0)
    for w in mlp.weights[2:]:
        x=fnp.maximum(x@w,0.0)
    return fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)

def final_gauss(mlp,samples,alpha=1.0):
    width=mlp.width; depth=mlp.depth
    first_weight=mlp.weights[0]
    first_mean, first_covariance, first_variance = submission.Estimator()._first_layer_moments(first_weight)
    x=fnp.maximum(samples@first_weight,0.0)
    sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
    tv=first_variance*(0.5-_INV_SQRT_2PI*_INV_SQRT_2PI)
    x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
    if depth==1: return first_mean
    w=mlp.weights[1]
    pre=x@w
    sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-7)
    tm=first_mean@w
    tv=fnp.maximum(fnp.sum(w*(first_covariance@w),axis=0),1e-7)
    x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
    if depth==2:
        # smooth this final distribution using exact Gaussian moments
        gm,_=relu_gauss_mean_var(tm,tv)
        raw=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        return (1-alpha)*raw+alpha*gm
    for w in mlp.weights[2:-1]:
        x=fnp.maximum(x@w,0.0)
    pre=x@mlp.weights[-1]
    pm=fnp.mean(pre,axis=0)
    ps=fnp.mean(pre*pre,axis=0)
    pv=fnp.maximum(ps-pm*pm,1e-9)
    raw=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(pre,0.0),dtype=fnp.float64),axis=0),dtype=fnp.float32)
    gm,_=relu_gauss_mean_var(pm,pv)
    return (1-alpha)*raw+alpha*gm

def layerwise_smooth(mlp,samples,blend=1.0, exact_second=True):
    width=mlp.width; depth=mlp.depth
    first_weight=mlp.weights[0]
    first_mean, first_covariance, first_variance = submission.Estimator()._first_layer_moments(first_weight)
    x=fnp.maximum(samples@first_weight,0.0)
    sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
    target_mean=first_mean
    target_var=first_variance*(0.5-_INV_SQRT_2PI*_INV_SQRT_2PI)
    x=(x-sm)*fnp.sqrt(target_var/sv)+target_mean
    if depth==1: return first_mean
    for li,w in enumerate(mlp.weights[1:],start=1):
        pre=x@w
        sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-9)
        if li==1 and exact_second:
            pm=first_mean@w
            pv=fnp.maximum(fnp.sum(w*(first_covariance@w),axis=0),1e-9)
            pre=(pre-sm)*fnp.sqrt(pv/sv)+pm
            sm=pm; sv=pv
        gm,gv=relu_gauss_mean_var(sm,sv)
        raw=fnp.maximum(pre,0.0)
        rm=fnp.mean(raw,axis=0); rs=fnp.mean(raw*raw,axis=0); rv=fnp.maximum(rs-rm*rm,1e-9)
        target_m=(1.0-blend)*rm+blend*gm
        target_v=(1.0-blend)*rv+blend*gv
        x=(raw-rm)*fnp.sqrt(target_v/rv)+target_m
    return fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)


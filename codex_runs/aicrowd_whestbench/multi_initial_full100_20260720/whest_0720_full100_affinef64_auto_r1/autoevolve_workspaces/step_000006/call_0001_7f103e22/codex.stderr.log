import time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
_INV_SQRT_2PI=0.3989422804014327

def phi(x): return _INV_SQRT_2PI*fnp.exp(-0.5*x*x)
def Phi(x):
    ax=fnp.abs(x); t=1.0/(1.0+0.2316419*ax)
    poly=(((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t)
    c=1.0-phi(ax)*poly
    return fnp.where(x>=0.0,c,1.0-c)
def relu_gauss_mean(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig
    return sig*phi(a)+mu*Phi(a)

def preds(mlp,samples,alpha):
    first_weight=mlp.weights[0]
    first_mean, first_covariance, first_variance = submission.Estimator()._first_layer_moments(first_weight)
    x=fnp.maximum(samples@first_weight,0.0)
    if mlp.depth==1: return first_mean
    sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
    tv=first_variance*(0.5-_INV_SQRT_2PI*_INV_SQRT_2PI)
    x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
    w=mlp.weights[1]
    pre=x@w
    sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-7)
    tm=first_mean@w
    tv=fnp.maximum(fnp.sum(w*(first_covariance@w),axis=0),1e-7)
    x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
    if mlp.depth==2:
        raw=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        gm=relu_gauss_mean(tm,tv)
        return (1-alpha)*raw+alpha*gm
    for w in mlp.weights[2:-1]:
        x=fnp.maximum(x@w,0.0)
    pre=x@mlp.weights[-1]
    raw=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(pre,0.0),dtype=fnp.float64),axis=0),dtype=fnp.float32)
    pm=fnp.mean(pre,axis=0); ps=fnp.mean(pre*pre,axis=0); pv=fnp.maximum(ps-pm*pm,1e-9)
    gm=relu_gauss_mean(pm,pv)
    return (1-alpha)*raw+alpha*gm

width=256; depth=32; budget=272_000_000_000; gt=1_000_000
est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'1.0',seed=777))
print('k',est._samples.shape)

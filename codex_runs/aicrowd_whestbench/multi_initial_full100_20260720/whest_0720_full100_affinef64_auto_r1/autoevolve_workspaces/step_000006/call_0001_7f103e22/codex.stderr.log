            on_mlp_done=lambda i: progress(
                {"phase": "ground_truth", "completed": i, "total": spec.n_mlps}
            ),
        )
    else:
        data = make_contest(spec)
    t0 = _time.time()
    result = evaluate_estimator(_DEFAULT_ESTIMATOR, data)
    elapsed = _time.time() - t0


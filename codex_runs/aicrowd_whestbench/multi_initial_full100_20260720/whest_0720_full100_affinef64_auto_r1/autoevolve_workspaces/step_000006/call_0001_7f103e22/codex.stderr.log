The analytic prototype needs careful handling of nonzero preactivation means. I’m using the Plackett integral for the bivariate CDF and closed-form truncated first/second moments, with exact diagonal replacement for stability.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics

_INV_SQRT_2PI=0.3989422804014327
_TWO_PI=6.283185307179586
_SQRT2PI=2.5066282746310002
# 8-point Gauss-Legendre nodes/weights on [-1,1]
_NODES=[-0.9602898564975363,-0.7966664774136267,-0.5255324099163290,-0.1834346424956498,0.1834346424956498,0.5255324099163290,0.7966664774136267,0.9602898564975363]
_WEIGHTS=[0.1012285362903763,0.2223810344533745,0.3137066458778873,0.3626837833783620,0.3626837833783620,0.3137066458778873,0.2223810344533745,0.1012285362903763]

def phi(x):
    return _INV_SQRT_2PI*fnp.exp(-0.5*x*x)

def Phi(x):
    ax=fnp.abs(x)
    t=1.0/(1.0+0.2316419*ax)
    poly=(((((1.330274429*t-1.821255978)*t+1.781477937)*t-0.356563782)*t+0.319381530)*t)
    c=1.0-phi(ax)*poly
    return fnp.where(x>=0.0,c,1.0-c)

def Phi2(a,b,r):
    r=fnp.clip(r,-0.999,0.999)
    p=Phi(a)*Phi(b)
    integ=0.0
    aa=a*a; bb=b*b; ab=a*b
    for x,w in zip(_NODES,_WEIGHTS):
        t=0.5*r*(x+1.0)
        om=fnp.maximum(1.0-t*t,1e-12)
        dens=fnp.exp(-(aa-2.0*t*ab+bb)/(2.0*om))/( _TWO_PI*fnp.sqrt(om))
        integ=integ+w*dens
    return fnp.clip(p+0.5*r*integ,0.0,1.0)

def relu_moments(mu,cov):
    var=fnp.maximum(fnp.diag(cov),1e-12)
    sig=fnp.sqrt(var)
    a=mu/sig
    Pa=Phi(a)
    phia=phi(a)
    mean=sig*phia+mu*Pa
    second_diag=(mu*mu+var)*Pa+mu*sig*phia
    denom=sig[:,None]*sig[None,:]
    r=fnp.clip(cov/denom,-0.999,0.999)
    ar=a[:,None]; ac=a[None,:]
    sir=fnp.sqrt(fnp.maximum(1.0-r*r,1e-12))
    A=phi(ar)*Phi((ac-r*ar)/sir)
    B=phi(ac)*Phi((ar-r*ac)/sir)
    P=Phi2(ar,ac,r)
    om=fnp.maximum(1.0-r*r,1e-12)
    pdf2=fnp.exp(-(ar*ar-2.0*r*ar*ac+ac*ac)/(2.0*om))/(_TWO_PI*fnp.sqrt(om))
    Iu=A+r*B
    Iv=B+r*A
    Iuv=r*P+om*pdf2-r*ar*A-r*ac*B
    second=(mu[:,None]*mu[None,:])*P+(mu[:,None]*sig[None,:])*Iv+(mu[None,:]*sig[:,None])*Iu+denom*Iuv
    eye=fnp.eye(mu.shape[0],dtype=second.dtype)
    second=second*(1.0-eye)+second_diag[:,None]*eye
    cov2=second-mean[:,None]*mean[None,:]
    cov2=(cov2+cov2.T)*0.5
    return mean,cov2

def analytic(mlp):
    w0=mlp.weights[0]
    pre_cov=w0.T@w0
    mu=fnp.zeros(mlp.width)
    means=[]
    for wi,w in enumerate(mlp.weights):
        if wi==0:
            pre_mu=fnp.zeros(mlp.width)
            pre_cov=w.T@w
        else:
            pre_mu=mu@w
            pre_cov=w.T@cov@w
        mu,cov=relu_moments(pre_mu,pre_cov)
        means.append(mu)
    return fnp.asarray(fnp.stack(means),dtype=fnp.float32)

for width,depth,gt in [(32,8,200000),(64,8,100000),(128,16,30000)]:
    rng=fnp.random.default_rng(123)
    mses=[]
    t0=time.time()
    for i in range(3):
        mlp=sample_mlp(width,depth,rng,seed=1000+i)
        target=sample_layer_statistics(mlp,gt,fnp.random.default_rng(9000+i))[0]
        pred=analytic(mlp)
        mse=float(fnp.mean((pred[-1]-target[-1])**2))
        mses.append(mse)
    print('spec',width,depth,gt,'mse',mses,'mean',sum(mses)/len(mses),'time',time.time()-t0)

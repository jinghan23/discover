import time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics, SetupContext
import submission
_INV=0.3989422804014327

def pred(mlp,samples,mode):
 e=submission.Estimator(); fw=mlp.weights[0]; fm,fc,fv=e._first_layer_moments(fw); x=fnp.maximum(samples@fw,0.0)
 sm=fnp.mean(x,axis=0); xc=x-sm
 if mode=='diag':
  ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6); tv=fv*(0.5-_INV*_INV); x=xc*fnp.sqrt(tv/sv)+fm
 elif mode=='full':
  k=x.shape[0]; sc=(xc.T@xc)/float(k); evals,evecs=fnp.linalg.eigh(sc); evals=fnp.maximum(evals,1e-7); cevals,cevecs=fnp.linalg.eigh(fc); cevals=fnp.maximum(cevals,1e-9)
  invsqrt=(evecs/fnp.sqrt(evals))@evecs.T; sqrtc=(cevecs*fnp.sqrt(cevals))@cevecs.T
  a=invsqrt@sqrtc
  x=xc@a+fm
 elif mode=='shrinkfull':
  k=x.shape[0]; ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6); tv=fv*(0.5-_INV*_INV); xd=xc*fnp.sqrt(tv/sv)+fm
  xcd=xd-fnp.mean(xd,axis=0); sc=(xcd.T@xcd)/float(k); evals,evecs=fnp.linalg.eigh(sc); evals=fnp.maximum(evals,1e-7); cevals,cevecs=fnp.linalg.eigh(fc); cevals=fnp.maximum(cevals,1e-9)
  invsqrt=(evecs/fnp.sqrt(evals))@evecs.T; sqrtc=(cevecs*fnp.sqrt(cevals))@cevecs.T
  xf=xcd@(invsqrt@sqrtc)+fm
  x=0.5*xd+0.5*xf
 w=mlp.weights[1]; pre=x@w

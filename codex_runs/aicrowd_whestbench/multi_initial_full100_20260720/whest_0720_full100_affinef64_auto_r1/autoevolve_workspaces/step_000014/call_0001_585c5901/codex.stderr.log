 _SETUP_SEED_OFFSET = 3
 _INV_SQRT_2PI = 0.3989422804014327
 _TWO_PI = 6.283185307179586
+_FINAL_GAUSS_BLEND = 1.0
+
+
+def _normal_cdf(x):
+    ax = fnp.maximum(x, -x)
+    t = 1.0 / (1.0 + 0.2316419 * ax)
+    poly = (
+        (
+            (
+                ((1.330274429 * t - 1.821255978) * t + 1.781477937)
+                * t
+                - 0.356563782
+            )
+            * t
+            + 0.319381530
+        )
+        * t
+    )
+    tail = fnp.exp(-0.5 * ax * ax) * _INV_SQRT_2PI * poly
+    cdf_pos = 1.0 - tail
+    return fnp.where(x >= 0.0, cdf_pos, tail)
+
+
+def _relu_gaussian_mean(mean, variance):
+    scale = fnp.sqrt(fnp.maximum(variance, 1e-30))
+    z = mean / scale
+    return mean * _normal_cdf(z) + scale * fnp.exp(-0.5 * z * z) * _INV_SQRT_2PI
 
 
 def _sample_count(budget: int, width: int, depth: int) -> int:
@@ -106,11 +133,18 @@
             0.0,
         )
 
-        for weight in mlp.weights[2:]:
+        for weight in mlp.weights[2:-1]:
             x = fnp.maximum(x @ weight, 0.0)
 
+        if depth > 2:
+            preactivation = x @ mlp.weights[-1]
+        sample_mean = fnp.mean(preactivation, axis=0)
+        sample_second = fnp.mean(preactivation * preactivation, axis=0)
+        sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-7)
+        sample_final = fnp.mean(fnp.maximum(preactivation, 0.0), axis=0)
+        gaussian_final = _relu_gaussian_mean(sample_mean, sample_variance)
         final_mean = fnp.asarray(
-            fnp.mean(x, axis=0),
+            sample_final + _FINAL_GAUSS_BLEND * (gaussian_final - sample_final),
             dtype=fnp.float32,
         )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)


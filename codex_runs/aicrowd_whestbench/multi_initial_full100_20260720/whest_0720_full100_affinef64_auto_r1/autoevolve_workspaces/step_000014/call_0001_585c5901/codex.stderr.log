        for i, w in enumerate(self.weights):
            shape = tuple(w.shape) if hasattr(w, "shape") else ()
            if shape != (self.width, self.width):
                raise ValueError(
                    f"Weight matrix {i} has shape {shape}, expected ({self.width}, {self.width})."
                )


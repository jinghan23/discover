 _INV_SQRT_2PI = 0.3989422804014327
 _TWO_PI = 6.283185307179586
+_FINAL_GAUSS_BLEND = 0.25
+
+
+def _normal_cdf(x):
+    ax = fnp.maximum(x, -x)
+    t = 1.0 / (1.0 + 0.2316419 * ax)
+    poly = (
+        (
+            (
+                ((1.330274429 * t - 1.821255978) * t + 1.781477937)
+                * t
+                - 0.356563782
+            )
+            * t
+            + 0.319381530
+        )
+        * t
+    )
+    tail = fnp.exp(-0.5 * ax * ax) * _INV_SQRT_2PI * poly
+    cdf_pos = 1.0 - tail
+    return fnp.where(x >= 0.0, cdf_pos, tail)
+
 
+def _relu_gaussian_mean(mean, variance):
+    scale = fnp.sqrt(fnp.maximum(variance, 1e-30))
+    z = mean / scale
+    return mean * _normal_cdf(z) + scale * fnp.exp(-0.5 * z * z) * _INV_SQRT_2PI
+
 

I’m testing a grouped estimator: split the same total sample budget into independently whitened antithetic blocks, run the existing calibration per block, and average block predictions. Setup cost rises, but predict FLOPs stay close to the same; sometimes this reduces nonlinear finite-sample bias.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
import submission

class Grouped(submission.Estimator):
    def __init__(self,groups): self.groups=groups
    def setup(self,context):
        self._width=int(context.width); self._depth=int(context.depth); self._groups=self.groups
        k=submission._sample_count(int(context.flop_budget),self._width,self._depth)
        kg=max(32,(k//self.groups) & ~1)
        self._samples_list=[self._make_samples(self._width,kg,int(context.seed)+3+97*g) for g in range(self.groups)]
    def predict(self,mlp,budget):
        width=mlp.width; depth=mlp.depth
        if not hasattr(self,'_samples_list') or self._samples_list[0].shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
            k=submission._sample_count(budget,width,depth); kg=max(32,(k//self.groups)&~1)
            self._samples_list=[self._make_samples(width,kg,int(mlp.seed)+97*g) for g in range(self.groups)]; self._depth=depth
        first_weight=mlp.weights[0]
        first_mean, first_covariance, first_variance=self._first_layer_moments(first_weight)
        outs=[]
        for samples in self._samples_list:
            x=fnp.maximum(samples@first_weight,0.0)
            if depth==1:
                outs.append(first_mean); continue
            sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
            tv=first_variance*(0.5-submission._INV_SQRT_2PI*submission._INV_SQRT_2PI)*submission._FIRST_VARIANCE_FACTOR
            x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
            w=mlp.weights[1]; pre=x@w
            sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-7)
            tm=first_mean@w; tv=fnp.maximum(fnp.sum(w*(first_covariance@w),axis=0),1e-7)
            x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
            for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
            outs.append(fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32))
        final=fnp.asarray(fnp.mean(fnp.stack(outs),axis=0),dtype=fnp.float32)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),final[None,:]],axis=0)

cases=[]
for width, depth, budget, gt, n in [(16,6,100_000_000,3_000_000,4),(32,6,300_000_000,2_000_000,3),(64,6,1_000_000_000,800_000,2),(128,8,2_000_000_000,300_000,2)]:
 print('"'make',width, flush=True); spec=ContestSpec(width=width,depth=depth,n_mlps=n,flop_budget=budget,ground_truth_samples=gt,seed=2468,wall_time_limit_s=30.0); cases.append((spec,make_contest(spec)))
for frac in [0.146,0.32,0.45,0.6]:
 submission._BUDGET_FRACTION=frac
 for groups in [1,2,4,8]:
  cls=submission.Estimator if groups==1 else (lambda g=groups: Grouped(g))
  vals=[]; ms=[]; mult=[]; fail=0
  for spec,data in cases:
   est=cls() if groups==1 else Grouped(groups)
   est.setup(SetupContext(width=spec.width,depth=spec.depth,flop_budget=spec.flop_budget,api_version='x',seed=2468))
   res=evaluate_estimator(est,data); vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier']); fail+=res['n_failed_mlps']
  print('frac',frac,'groups',groups,'score',sum(vals)/len(vals),'mse',sum(ms)/len(ms),'mult',mult,'fail',fail, flush=True)

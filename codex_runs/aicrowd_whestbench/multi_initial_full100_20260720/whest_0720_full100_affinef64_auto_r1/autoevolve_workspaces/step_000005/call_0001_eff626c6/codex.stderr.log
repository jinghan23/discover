/bin/bash -lc "python - <<'PY'
import math
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
import submission
_INV=0.3989422804014327; _TWO_PI=6.283185307179586; _VARFAC=0.5-_INV*_INV

def _first(weight):
 cov=weight.T@weight; var=fnp.maximum(fnp.diag(cov),1e-30); scale=fnp.sqrt(var); mean=scale*_INV
 denom=scale[:,None]*scale[None,:]; corr=fnp.clip(cov/denom,-1,1)
 sec=denom*(fnp.sqrt(fnp.maximum(1-corr*corr,0))+(fnp.pi-fnp.arccos(corr))*corr)/_TWO_PI
 ac=sec-mean[:,None]*mean[None,:]; ac=(ac+ac.T)*0.5
 return mean,ac,var

def full_match(x,tm,tc):
 n=x.shape[0]; sm=fnp.mean(x,axis=0); xc=x-sm; cov=(xc.T@xc)/float(n); cov=(cov+cov.T)*0.5
 ev,U=fnp.linalg.eigh(cov); ev=fnp.maximum(ev,1e-7)
 et,V=fnp.linalg.eigh((tc+tc.T)*0.5); et=fnp.maximum(et,1e-8)
 return fnp.asarray((xc@((U/fnp.sqrt(ev))@U.T))@((V*fnp.sqrt(et))@V.T)+tm,dtype=fnp.float32)
class SphereFull(submission.Estimator):
 def _make_samples(self,width,k,seed):
  rng=fnp.random.default_rng(seed); u=rng.standard_normal((k//2,width),dtype=fnp.float32)
  n=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1),1e-20))[:,None]
  half=fnp.asarray(u*(math.sqrt(width)/n),dtype=fnp.float32)
  return fnp.concatenate([half,-half],axis=0)
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth
  if not hasattr(self,'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
   self._samples=self._make_samples(width,submission._sample_count(budget,width,depth),mlp.seed); self._depth=depth
  fm,fc,fv=_first(mlp.weights[0]); x=fnp.maximum(self._samples@mlp.weights[0],0.0)
  if depth==1: return fnp.concatenate([fnp.zeros((0,width),dtype=fnp.float32),fm[None,:]],axis=0)
  x=full_match(x,fm,fc)
  w=mlp.weights[1]; pre=x@w
  sm=fnp.mean(pre,axis=0); sv=fnp.maximum(fnp.mean(pre*pre,axis=0)-sm*sm,1e-7)
  tm=fm@w; tv=fnp.maximum(fnp.sum(w*(fc@w),axis=0),1e-7)
  x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
  for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
  final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),final[None,:]],axis=0)

cases=[]
for width, depth, budget, gt, n in [(16,6,100_000_000,3_000_000,4),(32,6,300_000_000,2_000_000,3),(64,6,1_000_000_000,800_000,2),(128,8,2_000_000_000,300_000,2)]:
 print('"'make',width, flush=True); spec=ContestSpec(width=width,depth=depth,n_mlps=n,flop_budget=budget,ground_truth_samples=gt,seed=765,wall_time_limit_s=30.0); cases.append((spec,make_contest(spec)))
for frac in [0.146,0.32,0.45,0.6]:
 submission._BUDGET_FRACTION=frac
 for cls,name in [(submission.Estimator,'current'),(SphereFull,'spherefull')]:
  vals=[]; ms=[]; fail=0
  for spec,data in cases:
   est=cls(); est.setup(SetupContext(width=spec.width,depth=spec.depth,flop_budget=spec.flop_budget,api_version='x',seed=765))
   res=evaluate_estimator(est,data); vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); fail+=res['n_failed_mlps']
  print('frac',frac,name,'mean',sum(vals)/len(vals),'mse',sum(ms)/len(ms),'fail',fail, flush=True)

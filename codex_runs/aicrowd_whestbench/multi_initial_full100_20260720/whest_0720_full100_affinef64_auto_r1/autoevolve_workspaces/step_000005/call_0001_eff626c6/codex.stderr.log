codex
A useful structural property here is positive homogeneity: the whole ReLU MLP scales linearly with input radius. I’m testing sphere-direction sampling, which integrates the Gaussian radius analytically and may cut Monte Carlo variance without extra layers of computation.
exec
/bin/bash -lc "python - <<'PY'
import math
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
from whestbench import BaseEstimator
import submission

# robust scalar approximation/exact via math for synthetic class
def rmean(w):
    return math.sqrt(2.0)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def sample_count(budget,w,d,frac):
    per=d*(2*w*w+w)+w*w
    fixed=4*w*w # normalization-ish
    k=(int(frac*budget)-fixed)//max(per,1)
    k=max(32,min(1_000_000, (100*1024*1024)//max(w*8,1), k))
    return int(k-(k&1))
class Sphere(BaseEstimator):
    def __init__(self,frac=0.146): self.frac=frac
    def setup(self,ctx):
        self._width=int(ctx.width); self._depth=int(ctx.depth)
        self._samples=self._make(self._width,sample_count(int(ctx.flop_budget),self._width,self._depth,self.frac),int(ctx.seed)+3)
    def _make(self,w,k,seed):
        rng=fnp.random.default_rng(seed)
        u=rng.standard_normal((k//2,w),dtype=fnp.float32)
        n=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1),1e-20))[:,None]
        half=fnp.asarray(u*(rmean(w)/n),dtype=fnp.float32)
        return fnp.concatenate([half,-half],axis=0)
    def predict(self,mlp,budget):
        if not hasattr(self,'_samples') or self._samples.shape[1]"'!=mlp.width or getattr(self,'"'_depth',mlp.depth)"'!=mlp.depth:
            self._samples=self._make(mlp.width,sample_count(budget,mlp.width,mlp.depth,self.frac),mlp.seed); self._depth=mlp.depth
        x=self._samples
        for w in mlp.weights: x=fnp.maximum(x@w,0.0)
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        return fnp.concatenate([fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32), final[None,:]],axis=0)

class SphereCorr(submission.Estimator):
    def _make_samples(self,width,k,seed):
        rng=fnp.random.default_rng(seed)
        u=rng.standard_normal((k//2,width),dtype=fnp.float32)
        n=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1),1e-20))[:,None]
        # radius sqrt(width) gives covariance about I before existing moment corrections
        half=fnp.asarray(u*(math.sqrt(width)/n),dtype=fnp.float32)
        return fnp.concatenate([half,-half],axis=0)

cases=[]
for width, depth, budget, gt, n in [(16,6,100_000_000,3_000_000,4),(32,6,300_000_000,2_000_000,3),(64,6,1_000_000_000,800_000,2),(128,8,2_000_000_000,300_000,2)]:
 print('"'make',width, flush=True); spec=ContestSpec(width=width,depth=depth,n_mlps=n,flop_budget=budget,ground_truth_samples=gt,seed=654,wall_time_limit_s=30.0); cases.append((spec,make_contest(spec)))
for cls,name in [(submission.Estimator,'current'),(Sphere,'sphere'),(SphereCorr,'spherecorr')]:
 for frac in ([0.146,0.32,0.45,0.6] if name"'!='"'spherecorr' else [0.146,0.32,0.45,0.6]):
  submission._BUDGET_FRACTION=frac
  vals=[]; ms=[]; mult=[]; fail=0
  for spec,data in cases:
    est=cls(frac) if name=='sphere' else cls()
    est.setup(SetupContext(width=spec.width,depth=spec.depth,flop_budget=spec.flop_budget,api_version='x',seed=654))
    res=evaluate_estimator(est,data); vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier']); fail+=res['n_failed_mlps']
  print(name,'frac',frac,'mean',sum(vals)/len(vals),'mse',sum(ms)/len(ms),'mult',mult,'fail',fail, flush=True)

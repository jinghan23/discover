I’m testing a full-covariance calibration after the exact first layer. It costs extra matrix decompositions, but it may reduce the off-diagonal sampling error that downstream layers amplify.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
from whestbench import BaseEstimator
import submission

_INV=0.3989422804014327
_TWO_PI=6.283185307179586
_SQRT2OPI=0.7978845608028654
_VARFAC=0.5-_INV*_INV

def _phi(x): return _INV*fnp.exp(-0.5*x*x)
def _Phi(x): return 0.5*(1.0+fnp.tanh(_SQRT2OPI*(x+0.044715*x*x*x)))
def _relu_mom(mu,var):
    var=fnp.maximum(var,1e-20); sig=fnp.sqrt(var); a=mu/sig; p=_Phi(a); q=_phi(a)
    mean=sig*q+mu*p
    sec=(var+mu*mu)*p+mu*sig*q
    return mean, fnp.maximum(sec-mean*mean,1e-20)

def _first(weight):
    cov=weight.T@weight
    var=fnp.maximum(fnp.diag(cov),1e-30); scale=fnp.sqrt(var); mean=scale*_INV
    denom=scale[:,None]*scale[None,:]
    corr=fnp.clip(cov/denom,-1.0,1.0)
    second=denom*(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(fnp.pi-fnp.arccos(corr))*corr)/_TWO_PI
    acov=(second-mean[:,None]*mean[None,:]); acov=(acov+acov.T)*0.5
    return mean, acov, var

def _full_match(x, target_mean, target_cov):
    n=x.shape[0]
    sm=fnp.mean(x,axis=0)
    xc=x-sm
    cov=(xc.T@xc)/float(n)
    ev, U=fnp.linalg.eigh((cov+cov.T)*0.5)
    ev=fnp.maximum(ev,1e-7)
    et, V=fnp.linalg.eigh((target_cov+target_cov.T)*0.5)
    et=fnp.maximum(et,1e-7)
    inv=(U/fnp.sqrt(ev))@U.T
    root=(V*fnp.sqrt(et))@V.T
    return fnp.asarray((xc@inv)@root+target_mean, dtype=fnp.float32)

class Full1(submission.Estimator):
    def predict(self,mlp,budget):
        width=mlp.width; depth=mlp.depth
        if not hasattr(self,'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed); self._depth=depth
        fm,fc,fv=_first(mlp.weights[0])
        x=fnp.maximum(self._samples@mlp.weights[0],0.0)
        if depth==1: return fnp.concatenate([fnp.zeros((0,width),dtype=fnp.float32),fm[None,:]],axis=0)
        x=_full_match(x,fm,fc)
        w=mlp.weights[1]
        pre=x@w
        sm=fnp.mean(pre,axis=0); sv=fnp.maximum(fnp.mean(pre*pre,axis=0)-sm*sm,1e-7)
        tm=fm@w; tv=fnp.maximum(fnp.sum(w*(fc@w),axis=0),1e-7)
        x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
        for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),final[None,:]],axis=0)

class Gauss2(submission.Estimator):
    def predict(self,mlp,budget):
        width=mlp.width; depth=mlp.depth
        if not hasattr(self,'"'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed); self._depth=depth
        fm,fc,fv=_first(mlp.weights[0])
        x=fnp.maximum(self._samples@mlp.weights[0],0.0)
        if depth==1: return fnp.concatenate([fnp.zeros((0,width),dtype=fnp.float32),fm[None,:]],axis=0)
        sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6)
        tv=fv*_VARFAC
        x=(x-sm)*fnp.sqrt(tv/sv)+fm
        w=mlp.weights[1]; pre=x@w
        sm=fnp.mean(pre,axis=0); ss=fnp.mean(pre*pre,axis=0); sv=fnp.maximum(ss-sm*sm,1e-7)
        tm=fm@w; tv=fnp.maximum(fnp.sum(w*(fc@w),axis=0),1e-7)
        pre=(pre-sm)*fnp.sqrt(tv/sv)+tm
        x=fnp.maximum(pre,0.0)
        gm,gv=_relu_mom(tm,tv)
        xm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-xm*xm,1e-7)
        x=(x-xm)*fnp.sqrt(gv/xv)+gm
        for w in mlp.weights[2:]: x=fnp.maximum(x@w,0.0)
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),final[None,:]],axis=0)

class EveryGauss(submission.Estimator):
    def predict(self,mlp,budget):
        width=mlp.width; depth=mlp.depth
        if not hasattr(self,'"'_samples') or self._samples.shape[1]"'!=width or getattr(self,'"'_depth',depth)"'!=depth:
            self._samples=self._make_samples(width, submission._sample_count(budget,width,depth), mlp.seed); self._depth=depth
        fm,fc,fv=_first(mlp.weights[0])
        x=fnp.maximum(self._samples@mlp.weights[0],0.0)
        sm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-sm*sm,1e-7)
        x=(x-sm)*fnp.sqrt((fv*_VARFAC)/xv)+fm
        for idx,w in enumerate(mlp.weights[1:], start=1):
            pre=x@w
            pm=fnp.mean(pre,axis=0); pv=fnp.maximum(fnp.mean(pre*pre,axis=0)-pm*pm,1e-7)
            if idx==1:
                tm=fm@w; tv=fnp.maximum(fnp.sum(w*(fc@w),axis=0),1e-7)
                pre=(pre-pm)*fnp.sqrt(tv/pv)+tm; pm=tm; pv=tv
            gm,gv=_relu_mom(pm,pv)
            xr=fnp.maximum(pre,0.0)
            xm=fnp.mean(xr,axis=0); xv=fnp.maximum(fnp.mean(xr*xr,axis=0)-xm*xm,1e-7)
            x=(xr-xm)*fnp.sqrt(gv/xv)+gm
        final=fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)

/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
from whestbench import BaseEstimator
import submission

_INV=0.3989422804014327
_VARFAC=0.5-_INV*_INV
_SQRT2OPI=0.7978845608028654

def _phi(x):
    return _INV * fnp.exp(-0.5*x*x)
def _Phi(x):
    return 0.5*(1.0+fnp.tanh(_SQRT2OPI*(x+0.044715*x*x*x)))
def _relu_mom(mu,var):
    var=fnp.maximum(var,1e-20)
    sig=fnp.sqrt(var)
    a=mu/sig
    p=_Phi(a)
    q=_phi(a)
    mean=sig*q+mu*p
    second=(var+mu*mu)*p+mu*sig*q
    return mean, fnp.maximum(second-mean*mean,1e-20)
class Diag(BaseEstimator):
    def setup(self,context): pass
    def predict(self,mlp,budget):
        w=mlp.weights[0]
        pre_var=fnp.sum(w*w,axis=0)
        m=fnp.sqrt(fnp.maximum(pre_var,1e-20))*_INV
        v=pre_var*_VARFAC
        for w in mlp.weights[1:]:
            mu=m@w
            var=v@(w*w)
            m,v=_relu_mom(mu,var)
        return fnp.concatenate([fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32), fnp.asarray(m,dtype=fnp.float32)[None,:]], axis=0)

cases=[]
for width, depth, budget, gt, n in [(32,6,200_000_000,500_000,5),(64,6,500_000_000,300_000,3),(64,8,800_000_000,200_000,3),(128,8,1_000_000_000,100_000,2)]:
    print('make', width, depth, flush=True)
    spec=ContestSpec(width=width, depth=depth, n_mlps=n, flop_budget=budget, ground_truth_samples=gt, seed=888, wall_time_limit_s=30.0)
    cases.append((spec,make_contest(spec)))
for cls,name in [(Diag,'diag'),(submission.Estimator,'current')]:
    vals=[]; mses=[]; mult=[]
    for spec,data in cases:
        est=cls();
        try: est.setup(SetupContext(width=spec.width,depth=spec.depth,flop_budget=spec.flop_budget,api_version='x',seed=888))
        except Exception: pass
        res=evaluate_estimator(est,data)
        vals.append(res['adjusted_final_layer_score']); mses.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier'])
    print(name,'scoremean',sum(vals)/len(vals),'scores',vals,'mse',mses,'mult',mult)

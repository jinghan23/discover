/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
from whestbench import BaseEstimator
import submission
_INV=0.3989422804014327; _VARFAC=0.5-_INV*_INV; _SQRT2OPI=0.7978845608028654

def _Phi(x): return 0.5*(1.0+fnp.tanh(_SQRT2OPI*(x+0.044715*x*x*x)))
def _phi(x): return _INV*fnp.exp(-0.5*x*x)
def relu_mom(mu,var):
 var=fnp.maximum(var,1e-20); sig=fnp.sqrt(var); a=mu/sig; p=_Phi(a); q=_phi(a)
 mean=sig*q+mu*p; sec=(var+mu*mu)*p+mu*sig*q
 return mean, fnp.maximum(sec-mean*mean,1e-20)
def diag_pred(mlp):
 w=mlp.weights[0]; pv=fnp.sum(w*w,axis=0); m=fnp.sqrt(fnp.maximum(pv,1e-20))*_INV; v=pv*_VARFAC
 for w in mlp.weights[1:]:
  mu=m@w; var=v@(w*w); m,v=relu_mom(mu,var)
 return m
class Blend(submission.Estimator):
 def __init__(self,a,mode): self.a=a; self.mode=mode
 def predict(self,mlp,budget):
  raw=super().predict(mlp,budget)
  mc=raw[-1]
  if self.mode=='diag': base=diag_pred(mlp)
  else: base=fnp.ones(mlp.width,dtype=fnp.float32)*_INV*fnp.sqrt(2.0) # 1/sqrt(pi)
  final=fnp.asarray((1.0-self.a)*mc+self.a*base,dtype=fnp.float32)
  return fnp.concatenate([fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32), final[None,:]],axis=0)


import numpy as np, time
W=256; D=32; NGT=200_000; NMLP=4
INV=0.3989422804014327; TWO_PI=6.283185307179586

def make_weights(seedseq):
    r=np.random.default_rng(seedseq)
    return [(r.standard_normal((W,W),dtype=np.float32)*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]

def make_white(k,seed):
    r=np.random.default_rng(seed); u=r.standard_normal((k//2,W),dtype=np.float32)
    cov=(u.T@u)/float(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
    return np.concatenate([half,-half],0)

def make_raw(k,seed):
    r=np.random.default_rng(seed); u=r.standard_normal((k//2,W),dtype=np.float32)
    return np.concatenate([u,-u],0)

def first_mom(w):
    cov=w.T@w; var=np.maximum(np.diag(cov),1e-30); sc=np.sqrt(var); mean=sc*INV
    den=sc[:,None]*sc[None,:]; corr=np.clip(cov/den,-1,1)
    sec=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI
    ac=(sec-mean[:,None]*mean[None,:]); return mean.astype(np.float32),((ac+ac.T)*0.5).astype(np.float32),var.astype(np.float32)

def estimate(weights,samples,cal1=True,cal2=True):
    fm,fc,fv=first_mom(weights[0])
    x=np.maximum(samples@weights[0],0)
    if cal1:
        sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
        tv=fv*(0.5-INV*INV)*0.98
        x=(x-sm)*np.sqrt(tv/sv)+fm
    if not cal2:
        for w in weights[1:]: x=np.maximum(x@w,0)
        return x.astype(np.float64).mean(0).astype(np.float32)
    pre=x@weights[1]
    sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
    tm=fm@weights[1]; tv=np.maximum(np.sum(weights[1]*(fc@weights[1]),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for w in weights[2:]: x=np.maximum(x@w,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def target(weights, seedseq):
    r=np.random.default_rng(seedseq); s=np.zeros(W,dtype=np.float64); done=0
    while done<NGT:
        m=min(8192,NGT-done); x=r.standard_normal((m,W),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return (s/NGT).astype(np.float32)

ss=np.random.SeedSequence(777).spawn(3*NMLP)
rows=[]
for i in range(NMLP):
    weights=make_weights(ss[3*i]); tgt=target(weights,ss[3*i+1]); est_seed=int(ss[3*i+2].generate_state(1)[0]); rows.append((weights,tgt,est_seed)); print('made',i,flush=True)

per_sample=D*(2*W*W+W)+W*W; fixed=13*W**3
for kind, maker in [('white',make_white),('raw',make_raw)]:
  for K in [4096,8192,12288,14990,20000,30000,40000]:
    ms=[]; t0=time.time()
    for weights,tgt,seed in rows:
      y=estimate(weights,maker(K,seed+3))
      ms.append(float(np.mean((y-tgt)**2)))
    frac=(fixed+K*per_sample)/272_000_000_000
    print(kind,'K',K,'mse',np.mean(ms),'adj~',np.mean(ms)*max(0.1,frac),'frac',frac,'time',time.time()-t0,flush=True)

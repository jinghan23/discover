 _SETUP_BANK_SIZE = 10
 _INV_SQRT_2PI = 0.3989422804014327
 _TWO_PI = 6.283185307179586
+_SQRT_2_OVER_PI = 0.7978845608028654
+_GELU_CDF_CUBIC = 0.044715
 _FIRST_VARIANCE_FACTOR = 0.98
+_MODEL_BLEND = 0.0
 
 
 def _sample_count(budget: int, width: int, depth: int) -> int:
@@ -80,6 +83,26 @@
         ) * 0.5
         return mean, activation_covariance, variance
 
+    def _normal_relu_moments(self, mean, variance):
+        variance = fnp.maximum(variance, 1e-12)
+        scale = fnp.sqrt(variance)
+        alpha = mean / scale
+        alpha2 = alpha * alpha
+        phi = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha2)
+        cdf_arg = _SQRT_2_OVER_PI * (
+            alpha + _GELU_CDF_CUBIC * alpha * alpha2
+        )
+        cdf = 0.5 * (1.0 + fnp.tanh(cdf_arg))
+        relu_mean = scale * phi + mean * cdf
+        second = (variance + mean * mean) * cdf + mean * scale * phi
+        relu_variance = fnp.maximum(second - relu_mean * relu_mean, 1e-12)
+        return relu_mean, relu_variance, cdf
+
+    def _linearized_relu_covariance(self, covariance, variance, gate):
+        covariance = covariance * (gate[:, None] * gate[None, :])
+        covariance = covariance + fnp.diag(variance - fnp.diag(covariance))
+        return (covariance + covariance.T) * 0.5
+
     def predict(self, mlp, budget):
         width = mlp.width
         depth = mlp.depth

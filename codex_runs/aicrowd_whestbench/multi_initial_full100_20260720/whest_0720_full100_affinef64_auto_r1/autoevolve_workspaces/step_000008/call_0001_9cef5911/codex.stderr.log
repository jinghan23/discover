codex
Another possible variance reduction is shrinkage toward a cheap diagonal moment-propagation estimate. I’ll screen that locally first, because if the diagonal model is too biased, even a small blend can hurt.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, time
W=256; D=32; NGT=200_000; K=14990; NMLP=4
INV=0.3989422804014327; TWO_PI=6.283185307179586; SQRT2PI=0.7978845608028654

def cdf_approx(a): return 0.5*(1+np.tanh(SQRT2PI*(a+0.044715*a*a*a)))
def diag_est(weights):
    m=np.zeros(W,dtype=np.float32); v=np.ones(W,dtype=np.float32)
    for w in weights:
        mu=m@w
        var=np.maximum(v@(w*w),1e-12)
        sc=np.sqrt(var); a=mu/sc; phi=INV*np.exp(-0.5*a*a); cdf=cdf_approx(a)
        mean=sc*phi+mu*cdf
        sec=(var+mu*mu)*cdf+mu*sc*phi
        v=np.maximum(sec-mean*mean,1e-12).astype(np.float32); m=mean.astype(np.float32)
    return m

def make_samples(seed):
    r=np.random.default_rng(seed); u=r.standard_normal((K//2,W),dtype=np.float32)
    cov=(u.T@u)/float(K//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
    return np.concatenate([half,-half],0)
def first_mom(w):
    cov=w.T@w; var=np.maximum(np.diag(cov),1e-30); sc=np.sqrt(var); mean=sc*INV
    den=sc[:,None]*sc[None,:]; corr=np.clip(cov/den,-1,1)
    sec=den*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI
    ac=(sec-mean[:,None]*mean[None,:]); return mean.astype(np.float32),((ac+ac.T)*0.5).astype(np.float32),var.astype(np.float32)
def estimate(weights,samples):
    fm,fc,fv=first_mom(weights[0]); x=np.maximum(samples@weights[0],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)*0.98
    x=(x-sm)*np.sqrt(tv/sv)+fm
    pre=x@weights[1]; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@weights[1]; tv=np.maximum(np.sum(weights[1]*(fc@weights[1]),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for w in weights[2:]: x=np.maximum(x@w,0)
    return x.astype(np.float64).mean(0).astype(np.float32)
def target(weights, ss):
    r=np.random.default_rng(ss); s=np.zeros(W,dtype=np.float64); done=0
    while done<NGT:
        n=min(8192,NGT-done); x=r.standard_normal((n,W),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=n
    return (s/NGT).astype(np.float32)
ss=np.random.SeedSequence(2026).spawn(3*NMLP)
Ys=[]; Ds=[]; Ts=[]
for i in range(NMLP):
    r=np.random.default_rng(ss[3*i]); weights=[(r.standard_normal((W,W),dtype=np.float32)*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
    seed=int(ss[3*i+2].generate_state(1)[0])
    Ys.append(estimate(weights,make_samples(seed+3)))
    Ds.append(diag_est(weights))
    Ts.append(target(weights,ss[3*i+1])); print('done',i,flush=True)
Y=np.concatenate(Ys).astype(np.float64); Dg=np.concatenate(Ds).astype(np.float64); T=np.concatenate(Ts).astype(np.float64)
print('base',np.mean((Y-T)**2),'diag',np.mean((Dg-T)**2))
# optimal blend y+b*(d-y)
R=Dg-Y; b=-(R@(Y-T))/(R@R)
print('opt b',b)
for b0 in [-.2,-.1,-.05,0,.02,.05,.1,.2,b]:
    P=Y+b0*(Dg-Y); print('b',b0,'mse',np.mean((P-T)**2))
PY" in /opt/tiger/discover/workspace

/bin/bash -lc "python - <<'PY'
import numpy as np, time

W=256; D=32; NGT=200_000; K=14990; NMLP=3
INV=0.3989422804014327; TWO_PI=6.283185307179586

def make_samples(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width),dtype=np.float32)
    cov=(u.T@u)/float(k//2)
    vals, vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],axis=0)

def first_mom(w):
    cov=w.T@w
    var=np.maximum(np.diag(cov),1e-30)
    sc=np.sqrt(var)
    mean=sc*INV
    denom=sc[:,None]*sc[None,:]
    corr=np.clip(cov/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI
    acov=(second-mean[:,None]*mean[None,:])
    acov=(acov+acov.T)*0.5
    return mean.astype(np.float32), acov.astype(np.float32), var.astype(np.float32)

def estimate(weights, samples, fvf=0.98):
    fm, fcov, fvar=first_mom(weights[0])
    x=np.maximum(samples@weights[0],0)
    sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=fvar*(0.5-INV*INV)*fvf
    x=(x-sm)*np.sqrt(tv/sv)+fm
    pre=x@weights[1]
    sm=pre.mean(0); ss=(pre*pre).mean(0); sv=np.maximum(ss-sm*sm,1e-7)
    tm=fm@weights[1]
    tv=np.maximum(np.sum(weights[1]*(fcov@weights[1]),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for w in weights[2:]: x=np.maximum(x@w,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def target(weights, seed, n=NGT, chunk=8192):
    rng=np.random.default_rng(seed)
    s=np.zeros(W,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,W),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return (s/n).astype(np.float32)

ss=np.random.SeedSequence(12345).spawn(3*NMLP)
rows=[]
for i in range(NMLP):
    wrng=np.random.default_rng(ss[3*i])
    weights=[(wrng.standard_normal((W,W),dtype=np.float32)*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
    est_seed=int(ss[3*i+2].generate_state(1)[0])
    samples=make_samples(W,K,est_seed+3)
    t0=time.time(); y=estimate(weights,samples,0.98); print('est',i,time.time()-t0,flush=True)
    t0=time.time(); tgt=target(weights, ss[3*i+1], NGT); print('target',i,time.time()-t0,flush=True)
    rows.append((y,tgt,weights,samples))

for fvf in [0.94,0.96,0.98,1.0,1.02]:
    ms=[]; dots=[]
    for y0,tgt,weights,samples in rows:
        y=estimate(weights,samples,fvf)
        ms.append(np.mean((y-tgt)**2))
    print('fvf',fvf,'mse',np.mean(ms),ms)
ys=np.concatenate([r[0] for r in rows]).astype(np.float64)
ts=np.concatenate([r[1] for r in rows]).astype(np.float64)
opt=(ys@ts)/(ys@ys)
print('scale opt',opt)
for s in [0.96,0.98,0.99,1.0,1.01,1.02,1.04,opt]:
    print('scale',s,'mse',np.mean((s*ys-ts)**2))

def make_samples(width,k,seed,whiten=True):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32)
 if whiten:
  C=(u.T@u)/(k//2); ev,V=np.linalg.eigh(C.astype(float)); u=(u@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)
 return np.concatenate([u,-u],0)

def pred_corr(ws,samples):
 W0=ws[0]; fv=np.sum(W0.astype(float)**2,0); fm=np.sqrt(fv)*INV
 x=samples@W0; np.maximum(x,0,out=x); xd=x.astype(float); sm=xd.mean(0); sv=np.maximum((xd*xd).mean(0)-sm*sm,1e-6)
 x=((x-sm)*np.sqrt(fv*(0.5-INV*INV)/sv)+fm).astype(np.float32)
 for W in ws[1:]: x=x@W; np.maximum(x,0,out=x)
 return x.mean(0,dtype=np.float64)

def pred_radial(ws,samples, mode='none'):
 width=ws[0].shape[0]; rmean=chi_mean(width); W0=ws[0]

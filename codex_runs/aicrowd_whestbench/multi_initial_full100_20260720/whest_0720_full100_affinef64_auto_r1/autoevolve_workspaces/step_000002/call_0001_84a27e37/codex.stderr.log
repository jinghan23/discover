 if mode"'!='"'none':
  fv=np.sum(W0.astype(float)**2,0); fm=np.sqrt(fv)*INV
  xd=x.astype(float); sm=xd.mean(0)
  if mode=='meanmul':
   x=(xd*(fm/np.maximum(sm,1e-12))).astype(np.float32)
  elif mode=='affine':
   sv=np.maximum((xd*xd).mean(0)-sm*sm,1e-6)
   tv=fv*(0.5-INV*INV) # radial second differs tiny
   x=((xd-sm)*np.sqrt(tv/sv)+fm).astype(np.float32)
 for W in ws[1:]: x=x@W; np.maximum(x,0,out=x)
 return x.mean(0,dtype=np.float64)


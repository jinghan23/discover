import numpy as np, math, time
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)

def weights(width, depth, rng): return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def true_mean(ws,n,seed,chunk=20000):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w), dtype=np.float32)
  for W in ws: x=x@W; np.maximum(x,0,out=x)
  s += x.sum(axis=0,dtype=np.float64)
 return s/n
def make_random(width,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32); C=(u.T@u)/(k//2)
 ev,V=np.linalg.eigh(C.astype(float)); half=(u@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)
 return np.concatenate([half,-half],0)
def relu_mom(m,v):
 v=np.maximum(v,1e-12); sig=np.sqrt(v); a=m/sig; phi=INV*np.exp(-0.5*a*a); Phi=ndtr(a)
 mean=m*Phi+sig*phi; e2=(m*m+v)*Phi+m*sig*phi; var=np.maximum(e2-mean*mean,1e-8)
 return mean,var
def pred_layercorr(ws,samples,ncorr=1, use_pre_gauss=True, shrink=1.0):
 x=samples
 for li,W in enumerate(ws):
  pre=x@W
  x=np.maximum(pre,0)
  if li < ncorr:
   xd=x.astype(float); sm=xd.mean(0); sv=np.maximum((xd*xd).mean(0)-sm*sm,1e-8)
   if li==0 and not use_pre_gauss:
    fv=np.sum(W.astype(float)**2,0); tm=np.sqrt(fv)*INV; tv=fv*(0.5-INV*INV)
   else:
    pd=pre.astype(float); pm=pd.mean(0); pv=np.maximum((pd*pd).mean(0)-pm*pm,1e-12); tm,tv=relu_mom(pm,pv)
   if shrink"'!=1.0:
    # partially shift/scale toward Gaussian moments
    target_m=sm + shrink*(tm-sm)
    target_v=sv*((tv/np.maximum(sv,1e-8))**shrink)
   else:
    target_m,target_v=tm,tv
   x=((xd-sm)*np.sqrt(target_v/sv)+target_m).astype(np.float32)
 return x.mean(0,dtype=np.float64)

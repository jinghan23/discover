import numpy as np, math, time
from scipy.special import ndtri

INV = 1/math.sqrt(2*math.pi)

def weights(width, depth, rng):
    return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]

def true_mean(ws, n, seed=0, chunk=20000):
    rng=np.random.default_rng(seed)
    width=ws[0].shape[0]
    s=np.zeros(width, dtype=np.float64)
    done=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width), dtype=np.float32)
        for w in ws:
            x=x@w; np.maximum(x,0,out=x)
        s += x.sum(axis=0, dtype=np.float64)
    return (s/n).astype(np.float64)

def make_random(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/(k//2)
    ev, V=np.linalg.eigh(cov.astype(np.float64))
    ev=np.maximum(ev,1e-6)
    inv=(V/np.sqrt(ev))@V.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],axis=0)

def make_lhs(width,k,seed):
    rng=np.random.default_rng(seed)
    n=k//2
    a=np.empty((n,width), dtype=np.float32)
    # antithetic full uses p and 1-p if include -half after ppf; use p in (0,1)
    jitter=rng.random((n,width), dtype=np.float32)
    for j in range(width):
        perm=rng.permutation(n).astype(np.float32)
        a[:,j]=(perm+jitter[:,j])/n
    u=ndtri(a).astype(np.float32)
    cov=(u.T@u)/n
    ev,V=np.linalg.eigh(cov.astype(np.float64)); ev=np.maximum(ev,1e-6)
    inv=(V/np.sqrt(ev))@V.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],axis=0)

def pred_base(ws, samples, first_var_factor=1.0):
    W0=ws[0]
    fv=np.sum(W0*W0, axis=0, dtype=np.float64)
    fm=np.sqrt(fv)*INV
    x=samples@W0; np.maximum(x,0,out=x)
    sm=x.mean(axis=0, dtype=np.float64)
    ss=(x.astype(np.float64)*x.astype(np.float64)).mean(axis=0)
    sv=np.maximum(ss-sm*sm,1e-6)
    tv=fv*(0.5-INV*INV)*first_var_factor
    x=((x-sm)*np.sqrt(tv/sv)+fm).astype(np.float32)
    for W in ws[1:]:
        x=x@W; np.maximum(x,0,out=x)
    return x.mean(axis=0, dtype=np.float64)

def relu_cov_from_pre(C):
    q=np.maximum(np.diag(C).astype(np.float64),1e-12)
    sd=np.sqrt(q)
    denom=np.outer(sd,sd)
    rho=np.clip(C/denom, -1.0, 1.0)
    theta=np.arccos(rho)
    E=denom/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
    m=sd*INV
    T=E-np.outer(m,m)
    np.fill_diagonal(T, q*(0.5-INV*INV))
    return m,T

def pred_full1(ws,samples, alpha=1.0):
    W0=ws[0]
    C=W0.T@W0
    tm,T=relu_cov_from_pre(C.astype(np.float64))
    x=samples@W0; np.maximum(x,0,out=x)
    sm=x.mean(axis=0, dtype=np.float64)
    xc=x.astype(np.float64)-sm
    S=(xc.T@xc)/x.shape[0]
    # shrink T covariance correction? alpha 1 full, 0 diagonal? Blend transform target cov with sample diag? not here
    ev,V=np.linalg.eigh(S); ev=np.maximum(ev,1e-6)
    inv=(V/np.sqrt(ev))@V.T
    et,Ut=np.linalg.eigh(T); et=np.maximum(et,1e-8)
    sqrtT=(Ut*np.sqrt(et))@Ut.T
    x=(xc@inv@sqrtT+tm).astype(np.float32)
    for W in ws[1:]:
        x=x@W; np.maximum(x,0,out=x)
    return x.mean(axis=0, dtype=np.float64)

def run(width=128, depth=32, k=4096, nmlp=8, ntrue=200000):
    base_s=make_random(width,k,123)
    lhs_s=make_lhs(width,k,123)
    rows=[]; t=time.time()
    for i in range(nmlp):
        rng=np.random.default_rng(1000+i)
        ws=weights(width,depth,rng)
        truth=true_mean(ws,ntrue,seed=2000+i)
        vals={}
        for name,s in [('base',base_s),('lhs',lhs_s)]:
            vals[name]=np.mean((pred_base(ws,s)-truth)**2)
        vals['full1']=np.mean((pred_full1(ws,base_s)-truth)**2)
        vals['lhs_full1']=np.mean((pred_full1(ws,lhs_s)-truth)**2)
        rows.append(vals)
        print(i, vals, 'elapsed', time.time()-t, flush=True)
    print('means')
    for name in rows[0]:
        print(name, np.mean([r[name] for r in rows]), 'median', np.median([r[name] for r in rows]))

run()

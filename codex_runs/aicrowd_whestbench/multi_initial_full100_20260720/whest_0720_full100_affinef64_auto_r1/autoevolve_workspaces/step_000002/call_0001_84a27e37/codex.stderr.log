from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)
def weights(width, depth, rng): return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def true_mean(ws,n,seed,chunk=20000):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws: x=x@W; np.maximum(x,0,out=x)
  s+=x.sum(0,dtype=np.float64)
 return s/n
def cov_prop(ws, order=1, coeff=0.5, cliprho=None):
 w=ws[0].shape[0]; mu=np.zeros(w); cov=np.eye(w); scale=1.0
 for W in ws:
  md=np.max(np.diag(cov))
  if md>1e50:
   s=math.sqrt(md); mu=mu/s; cov=cov/(s*s); scale*=s
  mup=W.T@mu; cp=W.T@cov@W; var=np.maximum(np.diag(cp),1e-12); sig=np.sqrt(var); a=mup/sig
  phi=INV*np.exp(-0.5*a*a); Phi=ndtr(a)
  mu=mup*Phi+sig*phi
  e2=(mup*mup+var)*Phi+mup*sig*phi; varpost=np.maximum(e2-mu*mu,0)
  covpost=np.outer(Phi,Phi)*cp
  if order>=2:
   denom=np.outer(sig,sig)
   term=(cp*cp/np.maximum(denom,1e-20))*np.outer(phi,phi)*coeff
   if cliprho is not None:
    rho=np.abs(cp/np.maximum(denom,1e-20)); term=np.where(rho<cliprho,term,term) # no clip
   covpost += term
  np.fill_diagonal(covpost,varpost)
  cov=covpost

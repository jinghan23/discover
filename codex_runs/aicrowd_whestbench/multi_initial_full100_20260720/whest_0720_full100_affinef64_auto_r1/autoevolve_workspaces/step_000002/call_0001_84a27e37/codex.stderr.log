import numpy as np, math, time
INV=1/math.sqrt(2*math.pi)

def weights(width, depth, rng):
    return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]

def true_mean(ws, n, seed=0, chunk=10000):
    rng=np.random.default_rng(seed); width=ws[0].shape[0]; s=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width), dtype=np.float32)
        for w in ws:
            x=x@w; np.maximum(x,0,out=x)
        s += x.sum(axis=0, dtype=np.float64)
    return s/n

def make_random(width,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/(k//2); ev,V=np.linalg.eigh(cov.astype(np.float64)); ev=np.maximum(ev,1e-6)
    half=(u@((V/np.sqrt(ev))@V.T)).astype(np.float32)
    return np.concatenate([half,-half],axis=0)

def pred_base(ws, samples):
    W0=ws[0]; fv=np.sum(W0.astype(np.float64)**2,axis=0); fm=np.sqrt(fv)*INV
    x=samples@W0; np.maximum(x,0,out=x)
    xd=x.astype(np.float64); sm=xd.mean(axis=0); sv=np.maximum((xd*xd).mean(axis=0)-sm*sm,1e-6)
    tv=fv*(0.5-INV*INV)
    x=((x-sm)*np.sqrt(tv/sv)+fm).astype(np.float32)
    for W in ws[1:]:
        x=x@W; np.maximum(x,0,out=x)
    return x.mean(axis=0,dtype=np.float64)

def relu_cov(C):
    q=np.maximum(np.diag(C).astype(np.float64),1e-12); sd=np.sqrt(q); den=np.outer(sd,sd)
    rho=np.clip(C/den,-1,1); th=np.arccos(rho)
    E=den/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-th)*rho)
    m=sd*INV; T=E-np.outer(m,m); np.fill_diagonal(T, q*(0.5-INV*INV)); return m,T

def pred_full1(ws,samples):
    W0=ws[0]; tm,T=relu_cov((W0.T@W0).astype(np.float64))
    x=samples@W0; np.maximum(x,0,out=x)
    xd=x.astype(np.float64); sm=xd.mean(axis=0); xc=xd-sm; S=(xc.T@xc)/x.shape[0]
    ev,V=np.linalg.eigh(S); ev=np.maximum(ev,1e-6); inv=(V/np.sqrt(ev))@V.T
    et,U=np.linalg.eigh(T); et=np.maximum(et,1e-8); sqrtT=(U*np.sqrt(et))@U.T
    x=(xc@inv@sqrtT+tm).astype(np.float32)
    for W in ws[1:]: x=x@W; np.maximum(x,0,out=x)
    return x.mean(axis=0,dtype=np.float64)


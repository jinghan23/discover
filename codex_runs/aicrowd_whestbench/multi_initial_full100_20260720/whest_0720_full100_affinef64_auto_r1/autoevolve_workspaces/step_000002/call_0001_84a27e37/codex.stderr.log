import numpy as np, math, time
from scipy.special import gammaln
INV=1/math.sqrt(2*math.pi)

def chi_mean(n): return math.sqrt(2)*math.exp(gammaln((n+1)/2)-gammaln(n/2))
def weights(width, depth, rng): return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def true_mean(ws,n,seed,chunk=20000):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws: x=x@W; np.maximum(x,0,out=x)
  s += x.sum(axis=0,dtype=np.float64)
 return s/n
def make_samples(width,k,seed,whiten=True):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32)
 if whiten:
  C=(u.T@u)/(k//2); ev,V=np.linalg.eigh(C.astype(float)); u=(u@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)
 return np.concatenate([u,-u],0)
def forward(ws,samples):
 x=samples.copy()
 for W in ws: x=x@W; np.maximum(x,0,out=x)
 return x
def pred_corr(ws,samples):
 W0=ws[0]; fv=np.sum(W0.astype(float)**2,0); fm=np.sqrt(fv)*INV
 x=samples@W0; np.maximum(x,0,out=x); xd=x.astype(float); sm=xd.mean(0); sv=np.maximum((xd*xd).mean(0)-sm*sm,1e-6)
 x=((x-sm)*np.sqrt(fv*(0.5-INV*INV)/sv)+fm).astype(np.float32)
 for W in ws[1:]: x=x@W; np.maximum(x,0,out=x)
 return x.mean(0,dtype=np.float64)
def pred_norm_cv(ws,samples):
 y=forward(ws,samples).astype(float); norms=np.sqrt(np.sum(samples.astype(float)**2,axis=1)); rmean=chi_mean(samples.shape[1])
 mn=norms.mean(); vc=np.mean((norms-mn)**2)
 my=y.mean(0); cov=((norms-mn)[:,None]*(y-my)).mean(0)
 beta=cov/max(vc,1e-12)
 return my - beta*(mn-rmean)
def pred_div(ws,samples):
 y=forward(ws,samples).astype(float); norms=np.sqrt(np.sum(samples.astype(float)**2,axis=1)); return (y/np.maximum(norms[:,None],1e-12)).mean(0)*chi_mean(samples.shape[1])

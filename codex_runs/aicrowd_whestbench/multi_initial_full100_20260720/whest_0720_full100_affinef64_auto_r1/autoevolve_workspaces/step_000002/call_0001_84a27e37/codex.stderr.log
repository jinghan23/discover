codex
Full covariance matching at the first layer is not worth carrying forward: on the competition-like local test it was worse overall. I’m moving to a control-variate/shrinkage idea, combining the sampled network estimate with analytic moment propagation.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)

def weights(width, depth, rng): return [(rng.standard_normal((width,width)).astype(np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]

def true_mean(ws,n,seed,chunk=10000):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws: x=x@W; np.maximum(x,0,out=x)
  s += x.sum(axis=0,dtype=np.float64)
 return s/n

def make_random(width,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32); C=(u.T@u)/(k//2)
 ev,V=np.linalg.eigh(C.astype(float)); half=(u@((V/np.sqrt(np.maximum(ev,1e-6)))@V.T)).astype(np.float32)
 return np.concatenate([half,-half],0)

def pred_base(ws,samples):
 W0=ws[0]; fv=np.sum(W0.astype(float)**2,0); fm=np.sqrt(fv)*INV
 x=samples@W0; np.maximum(x,0,out=x); xd=x.astype(float); sm=xd.mean(0); sv=np.maximum((xd*xd).mean(0)-sm*sm,1e-6)
 x=((x-sm)*np.sqrt(fv*(0.5-INV*INV)/sv)+fm).astype(np.float32)
 for W in ws[1:]: x=x@W; np.maximum(x,0,out=x)
 return x.mean(0,dtype=np.float64)

def diag_prop(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w)
 for W in ws:
  mup=W.T@mu; vp=(W*W).T@var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mup/sig
  phi=INV*np.exp(-0.5*a*a); Phi=ndtr(a)
  mu=mup*Phi+sig*phi
  ez2=(mup*mup+vp)*Phi+mup*sig*phi
  var=np.maximum(ez2-mu*mu,0)
 return mu

def cov_prop(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); cov=np.eye(w); log_scale=0.0
 for W in ws:
  md=np.max(np.diag(cov))
  if md>1e100:
   s=math.sqrt(md); mu=mu/s; cov=cov/(s*s); log_scale+=math.log(s)
  mup=W.T@mu; cp=W.T@cov@W; vp=np.maximum(np.diag(cp),1e-12); sig=np.sqrt(vp); a=mup/sig
  phi=INV*np.exp(-0.5*a*a); Phi=ndtr(a)
  mu=mup*Phi+sig*phi
  ez2=(mup*mup+vp)*Phi+mup*sig*phi; var=np.maximum(ez2-mu*mu,0)
  gain=np.where(sig>1e-12,Phi,0); cov=np.outer(gain,gain)*cp; np.fill_diagonal(cov,var)
 return mu*math.exp(log_scale)

width=256; depth=32; k=9250; ntrue=300000; nmlp=6; s=make_random(width,k,126)
rows=[]; t=time.time()
for i in range(nmlp):
 ws=weights(width,depth,np.random.default_rng(100+i)); tr=true_mean(ws,ntrue,300+i); b=pred_base(ws,s); d=diag_prop(ws); c=cov_prop(ws)
 vals={'base':np.mean((b-tr)**2),'diag':np.mean((d-tr)**2),'cov':np.mean((c-tr)**2)}
 for alpha in [0.1,0.2,0.3,0.5,0.7,0.9]:
  p=alpha*b+(1-alpha)*c; vals[f'mc{alpha}cov']=np.mean((p-tr)**2)
 rows.append(vals); print(i, vals, 'elapsed', time.time()-t, flush=True)
print('means')
for name in rows[0]: print(name, np.mean([r[name] for r in rows]))

 vals={f:np.mean((pred(ws,s,f)-tr)**2) for f in factors}
 rows.append(vals); print(i, vals, 'best', min(vals,key=vals.get), 'elapsed', time.time()-t, flush=True)
print('means')
for f in factors: print(f, np.mean([r[f] for r in rows]), 'median', np.median([r[f] for r in rows]))

import numpy as np, time
INV=np.float64(1/np.sqrt(2*np.pi))

def make_samples(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/(k//2)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    invsqrt=(vecs/np.sqrt(vals))@vecs.T
    half=(u@invsqrt).astype(np.float32)
    return np.concatenate([half,-half],0)

def gen(width,depth,seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2/width)
    return [(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]

def true_mean(weights,n=500000,seed=999,chunk=50000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(width,dtype=np.float64); c=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.astype(np.float64).sum(0); c+=m
    return (s/c).astype(np.float32)

def exact_first(W):
    Sig=W.T@W
    v=np.diag(Sig).copy(); s=np.sqrt(np.maximum(v,1e-30))
    mean=s*INV
    denom=np.outer(s,s); r=np.divide(Sig,denom,out=np.zeros_like(Sig),where=denom>0)
    r=np.clip(r,-1,1)
    sec=denom/(2*np.pi)*(np.sqrt(np.maximum(0,1-r*r))+(np.pi-np.arccos(r))*r)
    cov=sec-np.outer(mean,mean)
    cov=(cov+cov.T)*0.5
    return mean.astype(np.float32), cov.astype(np.float32), v.astype(np.float32)

def current(weights,samples):
    W0=weights[0]; depth=len(weights); width=W0.shape[0]
    fv=np.sum(W0*W0,axis=0); fm=np.sqrt(fv)*INV
    x=np.maximum(samples@W0,0)
    if depth==1: return fm.astype(np.float32)
    sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=fv*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+fm
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def fullcov(weights,samples):
    W0=weights[0]; depth=len(weights)
    fm,C,_=exact_first(W0)
    x=np.maximum(samples@W0,0).astype(np.float32)
    if depth==1: return fm
    sm=x.mean(0); X=(x-sm).astype(np.float32)
    S=(X.T@X)/x.shape[0]
    S=(S+S.T)*0.5
    vals,vecs=np.linalg.eigh(S.astype(np.float64)); vals=np.maximum(vals,1e-7)
    Sinv=(vecs/np.sqrt(vals))@vecs.T
    d,V=np.linalg.eigh(C.astype(np.float64)); d=np.maximum(d,1e-10)
    Csqrt=(V*np.sqrt(d))@V.T
    A=Sinv@Csqrt
    x=(X.astype(np.float64)@A + fm).astype(np.float32)
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def diag_exact_sec(weights,samples):
    # after first relu, sample y for second? maybe no
    return current(weights,samples)

for width,depth,k,nref,nmlp in [(32,4,8192,400000,8),(64,6,8192,300000,5),(64,8,32768,300000,3)]:

/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
INV=0.3989422804014327; VARFAC=0.5-INV*INV

def make_samples(width,k,seed):
    rng=fnp.random.default_rng(seed)
    u=rng.standard_normal((k//2,width), dtype=fnp.float32)
    covariance=(u.T@u)/float(k//2)
    eigenvalues,eigenvectors=fnp.linalg.eigh(covariance)
    eigenvalues=fnp.maximum(eigenvalues,1e-6)
    inv=(eigenvectors/fnp.sqrt(eigenvalues))@eigenvectors.T
    half=fnp.asarray(u@inv,dtype=fnp.float32)
    return fnp.concatenate([half,-half],axis=0)

def exact_first(weight):
    sigma=weight.T@weight
    variance=fnp.maximum(fnp.diag(sigma), 1e-30)
    scale=fnp.sqrt(variance)
    mean=scale*INV
    denom=scale[:,None]*scale[None,:]
    corr=fnp.clip(sigma/denom, -1.0, 1.0)
    one_minus=fnp.maximum(1.0-corr*corr,0.0)
    second=denom*(fnp.sqrt(one_minus)+(float(fnp.pi)-fnp.arccos(corr))*corr)/(2.0*float(fnp.pi))
    covariance=(second - mean[:,None]*mean[None,:])
    covariance=(covariance+covariance.T)*0.5
    return mean, covariance, variance

def pred_full(mlp,samples):
    w0=mlp.weights[0]
    mean,cov,var=exact_first(w0)
    x=fnp.maximum(samples@w0, 0.0)
    if mlp.depth==1:
        return mean
    sm=fnp.mean(x,axis=0)
    xc=x-sm
    sample_cov=(xc.T@xc)/float(samples.shape[0])
    sample_cov=(sample_cov+sample_cov.T)*0.5
    e,u=fnp.linalg.eigh(sample_cov)
    e=fnp.maximum(e,1e-7)
    invsqrt=(u/fnp.sqrt(e))@u.T
    d,v=fnp.linalg.eigh(cov)
    d=fnp.maximum(d,1e-10)
    sqrtcov=(v*fnp.sqrt(d))@v.T
    transform=invsqrt@sqrtcov
    x=fnp.asarray(xc@transform + mean, dtype=fnp.float32)
    for weight in mlp.weights[1:]:
        x=fnp.maximum(x@weight,0.0)
    return fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)

def pred_current(mlp,samples):
    w0=mlp.weights[0]
    first_variance=fnp.sum(w0*w0,axis=0); first_mean=fnp.sqrt(first_variance)*INV
    x=fnp.maximum(samples@w0,0.0)
    if mlp.depth==1: return first_mean
    sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); sv=fnp.maximum(ss-sm*sm,1e-6); tv=first_variance*VARFAC
    x=(x-sm)*fnp.sqrt(tv/sv)+first_mean
    for weight in mlp.weights[1:]: x=fnp.maximum(x@weight,0.0)
    return fnp.asarray(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),dtype=fnp.float32)

for w,d,k in [(32,4,15578),(64,6,27158),(64,8,20764),(128,4,9682),(64,8,32768)]:
    rng=fnp.random.default_rng(123); mlp=sample_mlp(w,d,rng,seed=1); samples=make_samples(w,k,99)
    for name,fn in [('cur',pred_current),('full',pred_full)]:
        with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as bc:
            p=fn(mlp,samples)
        print('case',w,d,k,name,'flops',bc.flops_used,'per_sample',bc.flops_used/k)

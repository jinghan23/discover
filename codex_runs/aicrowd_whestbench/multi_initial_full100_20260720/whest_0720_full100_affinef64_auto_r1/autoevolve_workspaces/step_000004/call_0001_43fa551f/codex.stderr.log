INV=1/np.sqrt(2*np.pi)
VARFAC=0.5-INV*INV

def make_samples(width,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
    return np.concatenate([half,-half],0)

def gen(w,d,seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]

def true_mean(weights,n=300000,seed=1):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); c=0
    for st in range(0,n,50000):
        m=min(50000,n-st); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); c+=m
    return s/c

def exact_first(W):
    Sig=W.T@W; v=np.diag(Sig).copy(); sd=np.sqrt(np.maximum(v,1e-30)); mean=sd*INV
    den=np.outer(sd,sd); r=np.divide(Sig,den,out=np.zeros_like(Sig),where=den>0); r=np.clip(r,-1,1)
    sec=den/(2*np.pi)*(np.sqrt(np.maximum(0,1-r*r))+(np.pi-np.arccos(r))*r)
    C=(sec-np.outer(mean,mean)); return mean.astype(np.float32), ((C+C.T)*0.5).astype(np.float32), v.astype(np.float32)

def relu_gauss_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
    # use erf from np for local
    Phi=0.5*(1+np.vectorize(np.math.erf)(a/np.sqrt(2)))
    return sig*INV*np.exp(-0.5*a*a)+mu*Phi

def base_first(W0,samples):
    fv=np.sum(W0*W0,axis=0); fm=np.sqrt(fv)*INV
    x=np.maximum(samples@W0,0)
    sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-6)
    tv=fv*VARFAC
    return (x-sm)*np.sqrt(tv/sv)+fm, fm.astype(np.float32)

def current(weights,samples):
    x,fm=base_first(weights[0],samples)
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def pre2(weights,samples, analytic2=False, adjust_x2_mean=False):
    if len(weights)==1: return np.sqrt(np.sum(weights[0]*weights[0],0))*INV
    W0=weights[0]; W1=weights[1]
    x,fm=base_first(W0,samples)
    fm2,C,_=exact_first(W0)
    y=x@W1
    sm=y.mean(0); ss=(y*y).mean(0); sv=np.maximum(ss-sm*sm,1e-8)
    mu=fm2@W1
    var=np.sum(W1*(C@W1),axis=0)
    var=np.maximum(var,1e-8)
    if analytic2 and len(weights)==2:
        return relu_gauss_mean(mu,var)
    y=(y-sm)*np.sqrt(var/sv)+mu
    x=np.maximum(y,0)
    if adjust_x2_mean:
        # shift x mean to gaussian formula while preserving centered sample
        gm=relu_gauss_mean(mu,var)
        x=x-x.mean(0)+gm
        x=np.maximum(x,0) # maybe not
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)


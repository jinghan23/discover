def phi(x): return INV*np.exp(-0.5*x*x)
def Phi2_series(a,b,r,order=5):
    pa=Phi(a); pb=Phi(b); base=pa*pb; ph=phi(a)*phi(b); res=base
    if order>=1: res += ph*r
    if order>=2: res += ph*(r*r*0.5*a*b)
    if order>=3: res += ph*(r**3/6.0*(a*a-1)*(b*b-1))
    if order>=4: res += ph*(r**4/24.0*(a*a*a-3*a)*(b*b*b-3*b))
    if order>=5: res += ph*(r**5/120.0*(a**4-6*a*a+3)*(b**4-6*b*b+3))
    return np.clip(res,0,1)
def relu_moments_gauss(mu,S,order=5):

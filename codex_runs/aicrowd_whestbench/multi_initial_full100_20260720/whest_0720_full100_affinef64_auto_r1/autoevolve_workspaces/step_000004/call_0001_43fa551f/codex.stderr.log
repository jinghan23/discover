    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

def pre2(weights,samples, analytic2=False, adjust_x2_mean=False):
    if len(weights)==1: return np.sqrt(np.sum(weights[0]*weights[0],0))*INV
    W0=weights[0]; W1=weights[1]
    x,fm=base_first(W0,samples)
    fm2,C,_=exact_first(W0)
    y=x@W1
    sm=y.mean(0); ss=(y*y).mean(0); sv=np.maximum(ss-sm*sm,1e-8)
    mu=fm2@W1
    var=np.sum(W1*(C@W1),axis=0); var=np.maximum(var,1e-8)
    if analytic2 and len(weights)==2:
        return relu_gauss_mean(mu,var)
    y=(y-sm)*np.sqrt(var/sv)+mu
    x=np.maximum(y,0)
    if adjust_x2_mean:
        gm=relu_gauss_mean(mu,var)
        x=x-x.mean(0)+gm
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.mean(0)

def fullcov(weights,samples):
    W0=weights[0]; fm,C,_=exact_first(W0); x=np.maximum(samples@W0,0)
    if len(weights)==1: return fm
    sm=x.mean(0); X=x-sm; S=(X.T@X)/len(x); S=(S+S.T)*.5
    vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-7); Sinv=(vecs/np.sqrt(vals))@vecs.T
    d,V=np.linalg.eigh(C); d=np.maximum(d,1e-10); Csqrt=(V*np.sqrt(d))@V.T
    x=(X@(Sinv@Csqrt)+fm).astype(np.float32)
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

for width,depth,k,nref,nmlp in [(32,2,8192,600000,10),(32,4,8192,500000,10),(64,4,8192,400000,6),(64,8,32768,300000,5),(128,4,8192,200000,3)]:
    print('case',width,depth,k)
    samples=make_samples(width,k,123)
    names=['cur','pre2','pre2adj','full']+(['pre2ana'] if depth==2 else [])
    ms={n:[] for n in names}; t=time.time()
    for i in range(nmlp):
        weights=gen(width,depth,1000+i); tgt=true_mean(weights,nref,2000+i)
        funcs={'cur':current,'pre2':pre2,'pre2adj':lambda w,s:pre2(w,s,adjust_x2_mean=True),'full':fullcov,'pre2ana':lambda w,s:pre2(w,s,analytic2=True)}
        for n in names:
            p=funcs[n](weights,samples); ms[n].append(np.mean((p-tgt)**2))
    print({n:float(np.mean(ms[n])) for n in names}, 'med',{n:float(np.median(ms[n])) for n in names}, 'time',time.time()-t)

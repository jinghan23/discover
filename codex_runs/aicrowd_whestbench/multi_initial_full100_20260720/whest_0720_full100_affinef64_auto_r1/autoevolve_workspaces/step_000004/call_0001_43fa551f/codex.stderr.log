# Evaluate synthetic proxy seed selection correlation on local random suites
import numpy as np
INV=1/np.sqrt(2*np.pi); VARFAC=.5-INV*INV

def make_samples(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); e,V=np.linalg.eigh(cov); e=np.maximum(e,1e-6); h=(u@((V/np.sqrt(e))@V.T)).astype(np.float32); return np.concatenate([h,-h],0)
def exact_first(W):
 Sig=W.T@W; v=np.diag(Sig); sd=np.sqrt(np.maximum(v,1e-30)); m=sd*INV; den=np.outer(sd,sd); r=np.divide(Sig,den,out=np.zeros_like(Sig),where=den>0); r=np.clip(r,-1,1); sec=den/(2*np.pi)*(np.sqrt(np.maximum(0,1-r*r))+(np.pi-np.arccos(r))*r); C=sec-np.outer(m,m); return m,(C+C.T)*.5,v
def pred(weights,S):
 W0=weights[0]; m,C,fv=exact_first(W0); x=np.maximum(S@W0,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(fv*VARFAC/sv)+m
 if len(weights)>1:
  W=weights[1]; y=x@W; ysm=y.mean(0); ysv=np.maximum((y*y).mean(0)-ysm*ysm,1e-7); ymu=m@W; yvar=np.maximum(np.sum(W*(C@W),axis=0),1e-7); x=np.maximum((y-ysm)*np.sqrt(yvar/ysv)+ymu,0)
  for W in weights[2:]: x=np.maximum(x@W,0)
 return x.mean(0)
def gen(w,d,seed):
 rng=np.random.default_rng(seed); sc=np.sqrt(2/w); return [(rng.standard_normal((w,w))*sc).astype(np.float32) for _ in range(d)]
def true_mean(weights,n,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); c=0
 for st in range(0,n,50000):
  m=min(50000,n-st); x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); c+=m
 return s/c
w=64; d=8; k=20764; C=6; offsets=list(range(C)); Ss={o:make_samples(w,k,42+o) for o in offsets}
# actual suite MSE for offsets
actual={o:[] for o in offsets}
for i in range(8):
 weights=gen(w,d,1000+i); tgt=true_mean(weights,300000,2000+i)
 for o,S in Ss.items(): actual[o].append(np.mean((pred(weights,S)-tgt)**2))
actual_mean={o:float(np.mean(v)) for o,v in actual.items()}
print('actual',actual_mean,'best',min(actual_mean,key=actual_mean.get))
for nproxy in [1,2,4]:
 for pseed in [3000,4000,5000,6000,7000]:
  errs={o:0.0 for o in offsets}
  for j in range(nproxy):
   weights=gen(w,d,pseed+j)
   ps={o:pred(weights,Ss[o]) for o in offsets}; ref=sum(ps.values())/len(ps)
   for o,p in ps.items(): errs[o]+=float(np.mean((p-ref)**2))
  choice=min(errs,key=errs.get)
  print('proxy',nproxy,pseed,'choice',choice,'actual',actual_mean[choice],'errs',errs)

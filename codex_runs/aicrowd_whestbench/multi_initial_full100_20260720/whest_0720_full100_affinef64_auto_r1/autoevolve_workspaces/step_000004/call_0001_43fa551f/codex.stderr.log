  norms=np.sqrt(np.sum(half*half,axis=1,keepdims=True)); half=(half*(np.sqrt(w)/np.maximum(norms,1e-20))).astype(np.float32)
  cov=(half.T@half)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); half=(half@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
 norms=np.sqrt(np.sum(half*half,axis=1,keepdims=True)); half=(half*(np.sqrt(w)/np.maximum(norms,1e-20))).astype(np.float32)
 return np.concatenate([half,-half],0)

def gen(w,d,seed):
 rng=np.random.default_rng(seed); sc=np.sqrt(2/w); return [(rng.standard_normal((w,w))*sc).astype(np.float32) for _ in range(d)]
def true_mean(weights,n=400000,seed=1):

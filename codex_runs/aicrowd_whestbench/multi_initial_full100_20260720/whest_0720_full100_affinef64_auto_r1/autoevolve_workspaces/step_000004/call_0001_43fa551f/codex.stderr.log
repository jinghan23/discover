import numpy as np, time
INV=1/np.sqrt(2*np.pi); VARFAC=0.5-INV*INV

def whiten_ant(u):
    cov=(u.T@u)/u.shape[0]; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
    return np.concatenate([half,-half],0)

def samples_rand(width,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32); return whiten_ant(u)

def samples_lattice(width,k,seed,mode=0):
    rng=np.random.default_rng(seed); n=k//2
    i=(np.arange(n,dtype=np.float64)[:,None]+0.5)
    j=np.arange(width,dtype=np.float64)[None,:]
    shift1=rng.random((1,width)); shift2=rng.random((1,width))
    if mode==0:
        a1=np.sqrt(j+2.0); a2=np.sqrt(j+width+3.0)
    elif mode==1:
        a1=(2*j+1)/(width*2+1); a2=(2*j+width+3)/(width*3+1)
    elif mode==2:
        a1=np.sqrt((j+1)*12.9898+78.233); a2=np.sqrt((j+1)*39.3467+11.135)
    elif mode==3:
        # odd integer permutation-ish
        a1=(2*j+1); a2=(2*j+3)
    u1=np.mod(i*a1+shift1,1.0); u2=np.mod(i*a2+shift2,1.0)
    u1=np.clip(u1,1e-7,1-1e-7)
    z=np.sqrt(-2*np.log(u1))*np.cos(2*np.pi*u2)
    return whiten_ant(z.astype(np.float32))

def gen(w,d,seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]

def true_mean(weights,n=300000,seed=1):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); c=0
    for st in range(0,n,50000):
        m=min(50000,n-st); x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); c+=m
    return s/c

def current(weights,samples):
    W0=weights[0]; fv=np.sum(W0*W0,axis=0); fm=np.sqrt(fv)*INV
    x=np.maximum(samples@W0,0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    x=(x-sm)*np.sqrt((fv*VARFAC)/sv)+fm
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)

for width,depth,k,nref,nmlp in [(32,4,8192,500000,20),(64,6,8192,400000,10),(64,8,32768,300000,6)]:
    print('case',width,depth,k)
    sample_sets={'rand':samples_rand(width,k,123)}
    for m in range(4): sample_sets[f'lat{m}']=samples_lattice(width,k,123,m)
    ms={n:[] for n in sample_sets}; t=time.time()
    for i in range(nmlp):
        weights=gen(width,depth,1000+i); tgt=true_mean(weights,nref,2000+i)
        for n,samp in sample_sets.items(): ms[n].append(np.mean((current(weights,samp)-tgt)**2))
    print({n:float(np.mean(v)) for n,v in ms.items()})
    print('med',{n:float(np.median(v)) for n,v in ms.items()},'time',time.time()-t)

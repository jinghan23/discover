def pred(weights,s,pre2=False,alpha=1.0,start_shrink=2):
 W0=weights[0]; fv=np.sum(W0*W0,0); fm=np.sqrt(fv)*INV; x=np.maximum(s@W0,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(fv*VARFAC/sv)+fm
 layer=1
 if len(weights)==1: return fm
 if pre2:
  mean,C,_=exact_first(W0); W=weights[1]; y=x@W; ysm=y.mean(0); ysv=np.maximum((y*y).mean(0)-ysm*ysm,1e-7); ymu=mean@W; yvar=np.maximum(np.sum(W*(C@W),axis=0),1e-7); x=np.maximum((y-ysm)*np.sqrt(yvar/ysv)+ymu,0); layer=2; ws=weights[2:]

/bin/bash -lc "python - <<'PY'
# Local layerwise Gaussian target nudges, using scipy/numpy for development only
import numpy as np, math, time
try:
 from scipy.special import erf
except Exception: erf=np.vectorize(math.erf)
INV=1/np.sqrt(2*np.pi); VARFAC=.5-INV*INV

def Phi(x): return 0.5*(1+erf(x/np.sqrt(2)))
def phi(x): return INV*np.exp(-.5*x*x)
def relu_mom(mu,S):
 v=np.maximum(np.diag(S),1e-12); sig=np.sqrt(v); a=mu/sig; ph=phi(a); Ph=Phi(a); m=sig*ph+mu*Ph
 si=sig[:,None]; sj=sig[None,:]; ai=a[:,None]; bj=a[None,:]; mui=mu[:,None]; muj=mu[None,:]
 r=np.clip(S/(si*sj),-.999,.999); q=np.maximum(1-r*r,1e-9); sq=np.sqrt(q); P=np.clip(Ph[:,None]*Ph[None,:]+r*ph[:,None]*ph[None,:],0,1)
 expterm=np.exp(-(ai*ai-2*r*ai*bj+bj*bj)/(2*q))/(2*np.pi)
 sec=(mui*muj+si*sj*r)*P+mui*sj*ph[None,:]*Phi((ai-r*bj)/sq)+muj*si*ph[:,None]*Phi((bj-r*ai)/sq)+si*sj*sq*expterm
 idx=np.arange(len(mu)); sec[idx,idx]=(v+mu*mu)*Ph+mu*sig*ph; C=sec-np.outer(m,m); C=(C+C.T)*.5; C[idx,idx]=np.maximum(np.diag(C),1e-10)
 return m,C
def exact_first(W):
 Sig=W.T@W; v=np.diag(Sig); sd=np.sqrt(np.maximum(v,1e-30)); m=sd*INV; den=np.outer(sd,sd); r=np.divide(Sig,den,out=np.zeros_like(Sig),where=den>0); r=np.clip(r,-1,1); sec=den/(2*np.pi)*(np.sqrt(np.maximum(0,1-r*r))+(np.pi-np.arccos(r))*r); C=sec-np.outer(m,m); return m,(C+C.T)*.5,v
def gauss_layers(weights):
 m,C,v=exact_first(weights[0]); out=[(m,C)]
 for W in weights[1:]:
  mu=m@W; S=W.T@C@W; m,C=relu_mom(mu,(S+S.T)*.5); out.append((m,C))
 return out
def make_samples(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); e,V=np.linalg.eigh(cov); e=np.maximum(e,1e-6); h=(u@((V/np.sqrt(e))@V.T)).astype(np.float32); return np.concatenate([h,-h],0)
def pred(weights,s,beta=0.0,varbeta=0.0,finalblend=0.0):
 gl=gauss_layers(weights) if (beta or varbeta or finalblend) else None
 W0=weights[0]; m,C,fv=exact_first(W0); x=np.maximum(s@W0,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(fv*VARFAC/sv)+m
 if beta or varbeta:
  gm,gC=gl[0]; gv=np.diag(gC); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-7); x=x+beta*(gm-sm); x=(x-x.mean(0))*np.sqrt((1-varbeta)+varbeta*np.maximum(gv,1e-7)/sv)+x.mean(0)
 start=1
 if len(weights)>1:
  W=weights[1]; y=x@W; ysm=y.mean(0); ysv=np.maximum((y*y).mean(0)-ysm*ysm,1e-7); ymu=m@W; yvar=np.maximum(np.sum(W*(C@W),axis=0),1e-7); x=np.maximum((y-ysm)*np.sqrt(yvar/ysv)+ymu,0); start=2
  if beta or varbeta:
   gm,gC=gl[1]; gv=np.diag(gC); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-7); x=x+beta*(gm-sm); x=(x-x.mean(0))*np.sqrt((1-varbeta)+varbeta*np.maximum(gv,1e-7)/sv)+x.mean(0)
 for li,W in enumerate(weights[start:],start=start):
  x=np.maximum(x@W,0)
  if beta or varbeta:
   gm,gC=gl[li]; gv=np.diag(gC); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-7); x=x+beta*(gm-sm); x=(x-x.mean(0))*np.sqrt((1-varbeta)+varbeta*np.maximum(gv,1e-7)/sv)+x.mean(0)
 p=x.mean(0)
 if finalblend:
  p=p+finalblend*(gl[-1][0]-p)
 return p
def gen(w,d,seed):
 rng=np.random.default_rng(seed); sc=np.sqrt(2/w); return [(rng.standard_normal((w,w))*sc).astype(np.float32) for _ in range(d)]
def true_mean(weights,n,seed):

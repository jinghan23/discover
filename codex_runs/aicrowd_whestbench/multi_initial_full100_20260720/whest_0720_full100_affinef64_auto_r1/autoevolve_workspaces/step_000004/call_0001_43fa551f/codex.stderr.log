 return s/c

def current(weights,s):
 W0=weights[0]; fv=np.sum(W0*W0,axis=0); fm=np.sqrt(fv)*INV; x=np.maximum(s@W0,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); x=(x-sm)*np.sqrt(fv*VARFAC/sv)+fm
 for W in weights[1:]: x=np.maximum(x@W,0)
 return x.mean(0)

def sphere_pred(weights,s,mode='raw'):
 x=s

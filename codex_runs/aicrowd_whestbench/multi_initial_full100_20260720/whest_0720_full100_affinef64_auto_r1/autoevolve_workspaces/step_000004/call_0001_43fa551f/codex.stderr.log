import numpy as np, time, math
INV=1/np.sqrt(2*np.pi); VARFAC=0.5-INV*INV

def gamma(w,d):
 return math.exp(0.5*d*math.log(2.0/w)+math.lgamma(0.5*(w+d))-math.lgamma(0.5*w))

def make_rand_whiten(w,k,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); half=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([half,-half],0)

def make_sphere(w,k,seed,whiten=False,renorm=True):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32)
 if whiten:
  cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
 norms=np.sqrt(np.sum(u*u,axis=1,keepdims=True)); half=(u*(np.sqrt(w)/np.maximum(norms,1e-20))).astype(np.float32)
 if whiten and renorm:
  # maybe second whitening + renorm

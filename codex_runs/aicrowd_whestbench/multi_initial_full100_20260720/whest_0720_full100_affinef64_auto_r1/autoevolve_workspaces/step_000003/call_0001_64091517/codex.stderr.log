from __future__ import annotations

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_BUDGET_FRACTION = 0.146
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = 3
_POOL_COUNT = 1
_POOL_SEED_STRIDE = 9_973
_WHITEN_SAMPLES = True
_COUNT_SETUP_FIXED = True
_FIRST_MOMENTS_FLOAT64 = False
_FIRST_VARIANCE_FLOAT64 = False
_FINAL_MEAN_FLOAT64 = True
_SECOND_LAYER_EXACT_MARGINAL = False
_FINAL_SCALE = 1.0
_INV_2PI = 0.15915494309189535
_PI = 3.141592653589793
_SQRT_2_OVER_PI = 0.7978845608028654
_CDF_CUBIC = 0.044715
_INV_SQRT_2PI = 0.3989422804014327
_FIRST_VARIANCE_FACTOR = 1.0


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3) if _COUNT_SETUP_FIXED else 0
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    return k - (k & 1)


def _split_count(total: int, pools: int) -> int:
    k = max(_MIN_SAMPLES, total // max(1, pools))
    return k - (k & 1)


def _normal_cdf_approx(x):
    return 0.5 * (
        1.0
        + fnp.tanh(_SQRT_2_OVER_PI * (x + _CDF_CUBIC * x * x * x))
    )


def _relu_normal_moments(mean, variance):
    variance = fnp.maximum(variance, 1e-8)
    sigma = fnp.sqrt(variance)
    alpha = mean / sigma
    cdf = _normal_cdf_approx(alpha)
    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
    relu_mean = sigma * pdf + mean * cdf
    relu_second = (mean * mean + variance) * cdf + mean * sigma * pdf
    return relu_mean, fnp.maximum(relu_second - relu_mean * relu_mean, 1e-8)


class Estimator(BaseEstimator):
    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._set_samples(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )

    def _set_samples(self, width, k, seed):
        if _POOL_COUNT <= 1:
            self._samples = self._make_samples(width, k, seed)
        else:
            pool_k = _split_count(k, _POOL_COUNT)
            self._samples = tuple(
                self._make_samples(width, pool_k, seed + i * _POOL_SEED_STRIDE)
                for i in range(_POOL_COUNT)
            )

    def _samples_width(self):
        samples = self._samples[0] if isinstance(self._samples, tuple) else self._samples
        return samples.shape[1]

    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        u = rng.standard_normal((k // 2, width), dtype=fnp.float32)
        if not _WHITEN_SAMPLES:
            return fnp.concatenate([u, -u], axis=0)
        covariance = (u.T @ u) / float(k // 2)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        half = fnp.asarray(u @ inverse_sqrt, dtype=fnp.float32)
        return fnp.concatenate([half, -half], axis=0)

    def _first_relu_covariance(self, first_weight, first_variance, first_mean):
        first_std = fnp.sqrt(first_variance)
        denominator = fnp.maximum(first_std[:, None] * first_std[None, :], 1e-12)
        correlation = (first_weight.T @ first_weight) / denominator
        correlation = fnp.maximum(fnp.minimum(correlation, 1.0), -1.0)
        root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
        angle = fnp.arccos(correlation)
        second = denominator * (root + (_PI - angle) * correlation) * _INV_2PI
        return second - first_mean[:, None] * first_mean[None, :]

    def _correct_second_layer(self, x, first_weight, first_variance, first_mean, weight):
        preactivation = x @ weight
        first_covariance = self._first_relu_covariance(
            first_weight, first_variance, first_mean
        )
        target_pre_mean = first_mean @ weight
        target_pre_variance = fnp.sum((first_covariance @ weight) * weight, axis=0)
        target_mean, target_variance = _relu_normal_moments(
            target_pre_mean, target_pre_variance
        )

        y = fnp.maximum(preactivation, 0.0)
        sample_mean = fnp.mean(y, axis=0)
        sample_second = fnp.mean(y * y, axis=0)
        sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-6)
        return fnp.asarray(
            (y - sample_mean) * fnp.sqrt(target_variance / sample_variance) + target_mean,
            dtype=fnp.float32,
        )

    def _predict_from_samples(self, samples, mlp, first_variance, first_mean):
        x = fnp.maximum(samples @ mlp.weights[0], 0.0)

        if _FIRST_MOMENTS_FLOAT64:
            x_for_moments = fnp.asarray(x, dtype=fnp.float64)
            sample_mean = fnp.mean(x_for_moments, axis=0)
            sample_second = fnp.mean(x_for_moments * x_for_moments, axis=0)
        else:
            sample_mean = fnp.mean(x, axis=0)
            sample_second = fnp.mean(x * x, axis=0)
        sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-6)
        target_variance = (
            first_variance
            * (0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI)
            * _FIRST_VARIANCE_FACTOR
        )
        x = fnp.asarray(
            (x - sample_mean) * fnp.sqrt(target_variance / sample_variance) + first_mean,
            dtype=fnp.float32,
        )

        if _SECOND_LAYER_EXACT_MARGINAL and mlp.depth > 2:
            x = self._correct_second_layer(
                x, mlp.weights[0], first_variance, first_mean, mlp.weights[1]
            )
            remaining_weights = mlp.weights[2:]
        else:
            remaining_weights = mlp.weights[1:]

        for weight in remaining_weights:
            x = fnp.maximum(x @ weight, 0.0)

        if _FINAL_MEAN_FLOAT64:
            return fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0)
        return fnp.mean(x, axis=0)

    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        if (
            not hasattr(self, "_samples")
            or self._samples_width() != width
            or getattr(self, "_depth", depth) != depth
        ):
            self._set_samples(width, _sample_count(budget, width, depth), mlp.seed)
            self._depth = depth

        first_weight = mlp.weights[0]
        if _FIRST_VARIANCE_FLOAT64:
            first_variance = fnp.asarray(
                fnp.sum(fnp.asarray(first_weight * first_weight, dtype=fnp.float64), axis=0),
                dtype=fnp.float32,
            )
        else:
            first_variance = fnp.sum(first_weight * first_weight, axis=0)
        first_mean = fnp.sqrt(first_variance) * _INV_SQRT_2PI

        if depth == 1:
            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
            return fnp.concatenate([zero_rows, first_mean[None, :]], axis=0)

        if isinstance(self._samples, tuple):
            total = fnp.zeros(width, dtype=fnp.float64)
            for samples in self._samples:
                total = total + self._predict_from_samples(
                    samples, mlp, first_variance, first_mean
                )
            final_mean = fnp.asarray(total / float(len(self._samples)), dtype=fnp.float32)
        else:
            final_mean = fnp.asarray(
                self._predict_from_samples(
                    self._samples, mlp, first_variance, first_mean
                ),
                dtype=fnp.float32,
            )

        final_mean = fnp.asarray(final_mean * _FINAL_SCALE, dtype=fnp.float32)
        zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


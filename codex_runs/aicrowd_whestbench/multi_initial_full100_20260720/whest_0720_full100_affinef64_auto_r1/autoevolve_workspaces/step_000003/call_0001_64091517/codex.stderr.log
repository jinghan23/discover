from __future__ import annotations

import math

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_BUDGET_FRACTION = 0.146
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = 4
_INV_SQRT_2PI = 0.3989422804014327
_INV_2PI = 0.15915494309189535
_PI = 3.141592653589793
_FIRST_VARIANCE_FACTOR = 1.0
_FULL_FIRST_COVARIANCE = False
_DIAG_BLEND = 0.0
_PREDICT_SIGN_FLIP = False
_PREDICT_SEED_OFFSET = 11
_FINAL_GAUSSIAN_BLEND = 0.0
_LAYER_GAUSSIAN_CORRECTION = 0.0
_SPHERICAL_SAMPLES = False
_FIRST_LAYER_CORRECTION = True
_HADAMARD_SAMPLES = False
_SQRT_2_OVER_PI = 0.7978845608028654
_CDF_CUBIC = 0.044715


def _normal_cdf_approx(x):
    return 0.5 * (
        1.0
        + fnp.tanh(_SQRT_2_OVER_PI * (x + _CDF_CUBIC * x * x * x))
    )


def _relu_normal_mean(mean, variance):
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-8))
    alpha = mean / sigma
    cdf = _normal_cdf_approx(alpha)
    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
    return sigma * pdf + mean * cdf


def _relu_normal_moments(mean, variance):
    variance = fnp.maximum(variance, 1e-8)
    sigma = fnp.sqrt(variance)
    alpha = mean / sigma
    cdf = _normal_cdf_approx(alpha)
    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
    relu_mean = sigma * pdf + mean * cdf
    relu_second = (mean * mean + variance) * cdf + mean * sigma * pdf
    return relu_mean, fnp.maximum(relu_second - relu_mean * relu_mean, 1e-8)


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    if _FULL_FIRST_COVARIANCE:
        fixed += 20 * width**3
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    return k - (k & 1)


def _mean_gaussian_radius(width: int) -> float:
    return math.sqrt(2.0) * math.exp(
        math.lgamma(0.5 * (width + 1)) - math.lgamma(0.5 * width)
    )


def _is_power_of_two(value: int) -> bool:
    return value > 0 and (value & (value - 1)) == 0


class Estimator(BaseEstimator):
    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._samples = self._make_samples(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )

    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        if _HADAMARD_SAMPLES and _is_power_of_two(width):
            u = self._make_hadamard_samples(width, k // 2, rng)
        else:
            u = rng.standard_normal((k // 2, width), dtype=fnp.float32)
        covariance = (u.T @ u) / float(k // 2)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        half = fnp.asarray(u @ inverse_sqrt, dtype=fnp.float32)
        if _SPHERICAL_SAMPLES:
            radius = _mean_gaussian_radius(width)
            norms = fnp.sqrt(fnp.sum(half * half, axis=1))
            half = fnp.asarray(half * (radius / norms)[:, None], dtype=fnp.float32)
        return fnp.concatenate([half, -half], axis=0)

    def _make_hadamard_samples(self, width, half_count, rng):
        rows = [[1.0]]
        size = 1
        while size < width:
            rows = [row + row for row in rows] + [row + [-value for value in row] for row in rows]
            size *= 2
        hadamard = fnp.asarray(rows, dtype=fnp.float32) / math.sqrt(width)
        blocks = []
        block_count = (half_count + width - 1) // width
        for _ in range(block_count):
            signs = 2.0 * rng.integers(0, 2, size=(width,)).astype(fnp.float32) - 1.0
            blocks.append(hadamard * signs[None, :])
        directions = fnp.concatenate(blocks, axis=0)[:half_count]
        radius_noise = rng.standard_normal((half_count, width), dtype=fnp.float32)
        radii = fnp.sqrt(fnp.sum(radius_noise * radius_noise, axis=1))
        return fnp.asarray(directions * radii[:, None], dtype=fnp.float32)

    def _match_first_covariance(self, x, first_weight, first_variance, first_mean):
        k = x.shape[0]
        centered = x - fnp.mean(x, axis=0)
        sample_covariance = (centered.T @ centered) / float(k)
        sample_eigenvalues, sample_eigenvectors = fnp.linalg.eigh(sample_covariance)
        sample_eigenvalues = fnp.maximum(sample_eigenvalues, 1e-6)
        sample_inverse_sqrt = (
            sample_eigenvectors / fnp.sqrt(sample_eigenvalues)
        ) @ sample_eigenvectors.T

        first_std = fnp.sqrt(first_variance)
        denominator = fnp.maximum(first_std[:, None] * first_std[None, :], 1e-12)
        correlation = (first_weight.T @ first_weight) / denominator
        correlation = fnp.maximum(fnp.minimum(correlation, 1.0), -1.0)
        root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
        angle = fnp.arccos(correlation)
        target_second = (
            denominator
            * (root + (_PI - angle) * correlation)
            * _INV_2PI
        )
        target_covariance = target_second - first_mean[:, None] * first_mean[None, :]
        target_eigenvalues, target_eigenvectors = fnp.linalg.eigh(target_covariance)
        target_eigenvalues = fnp.maximum(target_eigenvalues, 1e-6)
        target_sqrt = (
            target_eigenvectors * fnp.sqrt(target_eigenvalues)
        ) @ target_eigenvectors.T
        return fnp.asarray((centered @ sample_inverse_sqrt) @ target_sqrt + first_mean, dtype=fnp.float32)

    def _diagonal_mean(self, mlp, first_mean, first_variance):
        mean = first_mean
        second = 0.5 * first_variance
        for weight in mlp.weights[1:]:
            variance = fnp.maximum(second - mean * mean, 1e-8)
            pre_mean = mean @ weight
            pre_variance = variance @ (weight * weight)
            sigma = fnp.sqrt(fnp.maximum(pre_variance, 1e-8))
            alpha = pre_mean / sigma
            cdf = _normal_cdf_approx(alpha)
            pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
            mean = sigma * pdf + pre_mean * cdf
            second = (pre_mean * pre_mean + pre_variance) * cdf + pre_mean * sigma * pdf
        return mean

    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        if (
            not hasattr(self, "_samples")
            or self._samples.shape[1] != width
            or getattr(self, "_depth", depth) != depth
        ):
            self._samples = self._make_samples(
                width,
                _sample_count(budget, width, depth),
                mlp.seed,
            )
            self._depth = depth

        first_weight = mlp.weights[0]
        first_variance = fnp.sum(first_weight * first_weight, axis=0)
        first_mean = fnp.sqrt(first_variance) * _INV_SQRT_2PI

        if _PREDICT_SIGN_FLIP:
            rng = fnp.random.default_rng(int(mlp.seed) + _PREDICT_SEED_OFFSET)
            signs = 2.0 * rng.integers(0, 2, size=(width,)).astype(fnp.float32) - 1.0
            first_projection_weight = first_weight * signs[:, None]
        else:
            first_projection_weight = first_weight

        x = fnp.maximum(self._samples @ first_projection_weight, 0.0)
        if depth == 1:
            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
            return fnp.concatenate([zero_rows, first_mean[None, :]], axis=0)

        if not _FIRST_LAYER_CORRECTION:
            pass
        elif _FULL_FIRST_COVARIANCE:
            x = self._match_first_covariance(x, first_weight, first_variance, first_mean)
        else:
            sample_mean = fnp.mean(x, axis=0)
            sample_second = fnp.mean(x * x, axis=0)
            sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-6)
            target_variance = (
                first_variance
                * (0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI)
                * _FIRST_VARIANCE_FACTOR
            )
            x = (x - sample_mean) * fnp.sqrt(target_variance / sample_variance) + first_mean

        if _FINAL_GAUSSIAN_BLEND == 0.0:
            if _LAYER_GAUSSIAN_CORRECTION == 0.0:
                for weight in mlp.weights[1:]:
                    x = fnp.maximum(x @ weight, 0.0)
            else:
                for weight in mlp.weights[1:-1]:
                    preactivation = x @ weight
                    pre_mean = fnp.mean(preactivation, axis=0)
                    pre_second = fnp.mean(preactivation * preactivation, axis=0)
                    target_mean, target_variance = _relu_normal_moments(
                        pre_mean, pre_second - pre_mean * pre_mean
                    )
                    y = fnp.maximum(preactivation, 0.0)
                    sample_mean = fnp.mean(y, axis=0)
                    sample_second = fnp.mean(y * y, axis=0)
                    sample_variance = fnp.maximum(
                        sample_second - sample_mean * sample_mean, 1e-8
                    )
                    if _LAYER_GAUSSIAN_CORRECTION != 1.0:
                        correction = _LAYER_GAUSSIAN_CORRECTION
                        target_mean = sample_mean + correction * (target_mean - sample_mean)
                        target_variance = sample_variance + correction * (
                            target_variance - sample_variance
                        )
                    x = (y - sample_mean) * fnp.sqrt(
                        fnp.maximum(target_variance, 1e-8) / sample_variance
                    ) + target_mean
                x = fnp.maximum(x @ mlp.weights[-1], 0.0)
            final_mean = fnp.asarray(
                fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0),
                dtype=fnp.float32,
            )
        else:
            for weight in mlp.weights[1:-1]:
                x = fnp.maximum(x @ weight, 0.0)
            final_preactivation = x @ mlp.weights[-1]
            pre_mean = fnp.mean(final_preactivation, axis=0)
            pre_second = fnp.mean(final_preactivation * final_preactivation, axis=0)
            gaussian_mean = _relu_normal_mean(pre_mean, pre_second - pre_mean * pre_mean)
            if _FINAL_GAUSSIAN_BLEND == 1.0:
                final_mean = fnp.asarray(gaussian_mean, dtype=fnp.float32)
            else:
                sample_mean = fnp.asarray(
                    fnp.mean(
                        fnp.asarray(fnp.maximum(final_preactivation, 0.0), dtype=fnp.float64),
                        axis=0,
                    ),
                    dtype=fnp.float32,
                )
                final_mean = fnp.asarray(
                    (1.0 - _FINAL_GAUSSIAN_BLEND) * sample_mean
                    + _FINAL_GAUSSIAN_BLEND * gaussian_mean,
                    dtype=fnp.float32,
                )
        if _DIAG_BLEND != 0.0:
            diag_mean = self._diagonal_mean(mlp, first_mean, first_variance)
            final_mean = fnp.asarray(
                (1.0 - _DIAG_BLEND) * final_mean + _DIAG_BLEND * diag_mean,
                dtype=fnp.float32,
            )
        zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


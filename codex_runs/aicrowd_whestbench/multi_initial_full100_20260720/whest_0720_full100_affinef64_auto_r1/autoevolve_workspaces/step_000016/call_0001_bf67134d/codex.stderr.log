codex
I’ll test a radial reweighting locally: whiten the Gaussian half-samples, replace row norms with chi-square radii, then rewhiten. This keeps covariance exact while restoring more Gaussian-like radial variation.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; TWO=6.283185307179586

def whiten(u):
 c=(u.T@u)/float(u.shape[0]); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); return fnp.asarray(u@((v/fnp.sqrt(e))@v.T),dtype=fnp.float32)

def make(w,k,seed,radial=False):
 r=fnp.random.default_rng(seed); u=r.standard_normal((k//2,w), dtype=fnp.float32); h=whiten(u)
 if radial:
  radii=fnp.sqrt(r.chisquare(float(w), size=(k//2,)).astype(fnp.float32))
  norms=fnp.sqrt(fnp.maximum(fnp.sum(h*h,axis=1),1e-12))
  h=whiten(h*(radii/norms)[:,None])
 return fnp.concatenate([h,-h],0)

def fm(weight):
 c=weight.T@weight; var=fnp.maximum(fnp.diag(c),1e-30); s=fnp.sqrt(var); m=s*INV; d=s[:,None]*s[None,:]; r=fnp.clip(c/d,-1,1); sec=d*(fnp.sqrt(fnp.maximum(1-r*r,0))+(fnp.pi-fnp.arccos(r))*r)/TWO; ac=sec-m[:,None]*m[None,:]; return m,(ac+ac.T)*.5

def pred(mlp,s):
 m,c=fm(mlp.weights[0]); x=fnp.maximum(s@mlp.weights[0],0); w=mlp.weights[1]; pre=x@w; sm=fnp.mean(pre,0); ss=fnp.mean(pre*pre,0); sv=fnp.maximum(ss-sm*sm,1e-7); tm=m@w; tv=fnp.maximum(fnp.sum(w*(c@w),0),1e-7); x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0); 
 for w in mlp.weights[2:]: x=fnp.maximum(x@w,0)
 return fnp.mean(x,0)
for width,depth,k in [(128,128,440),(256,128,600),(128,32,1078),(64,128,440)]:
 print('case',width,depth,k)
 vals={'base':[],'rad':[]}
 samples={name:make(width,k,3,rad) for name,rad in [('base',False),('rad',True)]}
 for i in range(5):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i); t=sample_layer_statistics(mlp,120000,rng=fnp.random.default_rng(3000+i))[1]
  for name,s in samples.items(): vals[name].append(float(fnp.mean((pred(mlp,s)-t)**2)))
 print({k:sum(v)/len(v) for k,v in vals.items()})

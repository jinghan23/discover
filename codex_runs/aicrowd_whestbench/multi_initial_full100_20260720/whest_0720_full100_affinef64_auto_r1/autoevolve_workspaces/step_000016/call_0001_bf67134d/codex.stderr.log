/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope.numpy as fnp
import flopscope.stats as fst
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; TWO=6.283185307179586

def make(w,k,seed):
 r=fnp.random.default_rng(seed); u=r.standard_normal((k//2,w), dtype=fnp.float32); c=(u.T@u)/float(k//2); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); h=fnp.asarray(u@((v/fnp.sqrt(e))@v.T),dtype=fnp.float32); return fnp.concatenate([h,-h],0)

def fm(weight):
 c=weight.T@weight; var=fnp.maximum(fnp.diag(c),1e-30); s=fnp.sqrt(var); m=s*INV; d=s[:,None]*s[None,:]; r=fnp.clip(c/d,-1,1); sec=d*(fnp.sqrt(fnp.maximum(1-r*r,0))+(fnp.pi-fnp.arccos(r))*r)/TWO; ac=sec-m[:,None]*m[None,:]; return m,(ac+ac.T)*.5

def relu_mean(mu,var):
 sig=fnp.sqrt(fnp.maximum(var,1e-12)); a=mu/sig; phi=fnp.exp(-0.5*a*a)*INV; Phi=fst.norm.cdf(a); return sig*phi+mu*Phi

def pred(mlp,s,final_gauss=False):
 m,c=fm(mlp.weights[0]); x=fnp.maximum(s@mlp.weights[0],0); 
 if mlp.depth==1: return m
 w=mlp.weights[1]; pre=x@w; sm=fnp.mean(pre,0); ss=fnp.mean(pre*pre,0); sv=fnp.maximum(ss-sm*sm,1e-7); tm=m@w; tv=fnp.maximum(fnp.sum(w*(c@w),0),1e-7); x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0)
 if final_gauss and mlp.depth==2:
  return relu_mean(tm,tv)
 for w in mlp.weights[2:-1]: x=fnp.maximum(x@w,0)
 if mlp.depth>=3 and final_gauss:
  pre=x@mlp.weights[-1]; pm=fnp.mean(pre,0); ps=fnp.mean(pre*pre,0); pv=fnp.maximum(ps-pm*pm,1e-7); return relu_mean(pm,pv)
 for w in mlp.weights[-1:] if mlp.depth>=3 else []: x=fnp.maximum(x@w,0)
 return fnp.mean(x,0)
for width,depth,k in [(128,128,440),(256,128,600),(128,32,1078),(64,128,440),(128,4,5000)]:
 print('case',width,depth,k)
 s=make(width,k,3); vals={'mc':[],'gauss':[]}
 for i in range(5):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i); t=sample_layer_statistics(mlp,120000,rng=fnp.random.default_rng(3000+i))[1]
  for fg,name in [(False,'mc'),(True,'gauss')]:
   p=pred(mlp,s,fg); vals[name].append(float(fnp.mean((p-t)**2)))
 print({k:sum(v)/len(v) for k,v in vals.items()})

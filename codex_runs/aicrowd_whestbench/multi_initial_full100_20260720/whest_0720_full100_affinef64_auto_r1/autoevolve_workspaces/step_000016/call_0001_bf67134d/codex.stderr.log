/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; TWO=6.283185307179586

def make(w,k,seed):
 r=fnp.random.default_rng(seed); u=r.standard_normal((k//2,w), dtype=fnp.float32); c=(u.T@u)/float(k//2); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); h=fnp.asarray(u@((v/fnp.sqrt(e))@v.T),dtype=fnp.float32); return fnp.concatenate([h,-h],0)

def fm(weight):
 c=weight.T@weight; var=fnp.maximum(fnp.diag(c),1e-30); s=fnp.sqrt(var); m=s*INV; d=s[:,None]*s[None,:]; r=fnp.clip(c/d,-1,1); sec=d*(fnp.sqrt(fnp.maximum(1-r*r,0))+(fnp.pi-fnp.arccos(r))*r)/TWO; ac=sec-m[:,None]*m[None,:]; return m,(ac+ac.T)*.5

def pred(mlp,s):
 m,c=fm(mlp.weights[0]); x=fnp.maximum(s@mlp.weights[0],0); w=mlp.weights[1]; pre=x@w; sm=fnp.mean(pre,0); ss=fnp.mean(pre*pre,0); sv=fnp.maximum(ss-sm*sm,1e-7); tm=m@w; tv=fnp.maximum(fnp.sum(w*(c@w),0),1e-7); x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0); 
 for w in mlp.weights[2:]: x=fnp.maximum(x@w,0)
 return fnp.mean(x,0)
for width,depth,k in [(128,128,440),(256,128,600),(128,32,1078)]:
 print('case',width,depth,k)
 s=make(width,k,3)
 dots=[]; pp=[]; tt=[]; mses=[]
 for i in range(5):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i)
  t=sample_layer_statistics(mlp,150000,rng=fnp.random.default_rng(3000+i))[1]
  p=pred(mlp,s)
  dots.append(float(fnp.sum(p*t))); pp.append(float(fnp.sum(p*p))); tt.append(float(fnp.sum(t*t))); mses.append(float(fnp.mean((p-t)**2)))
 opt=sum(dots)/sum(pp)
 print('opt_scale',opt,'avg_mse',sum(mses)/len(mses),'scale_mses',[(a, sum(float(fnp.mean(((a*pred(sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i),s))-sample_layer_statistics(sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i),150000,rng=fnp.random.default_rng(3000+i))[1])**2)) for i in []) ) for a in []])
 print('norm target/pred', (sum(tt)/sum(pp))**0.5)

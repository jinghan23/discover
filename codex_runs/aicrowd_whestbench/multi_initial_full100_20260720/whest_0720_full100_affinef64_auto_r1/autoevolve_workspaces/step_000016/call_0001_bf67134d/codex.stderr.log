from __future__ import annotations
import flopscope.numpy as fnp
import flopscope.stats as fst
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

_BUDGET_FRACTION = 0.236
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 4
_SETUP_SEED_OFFSET = 3
_INV_SQRT_2PI = 0.3989422804014327
_TWO_PI = 6.283185307179586

def sample_count(budget,width,depth):
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    return k - (k & 1)

def make_current(width,k,seed):
    rng=fnp.random.default_rng(seed)
    u=rng.standard_normal((k//2,width), dtype=fnp.float32)
    cov=(u.T@u)/float(k//2)
    ev,evec=fnp.linalg.eigh(cov)
    ev=fnp.maximum(ev,1e-6)
    inv=(evec/fnp.sqrt(ev))@evec.T
    half=fnp.asarray(u@inv, dtype=fnp.float32)
    return fnp.concatenate([half,-half],axis=0)

def make_lhs(width,k,seed):
    rng=fnp.random.default_rng(seed)
    n=k//2
    # midpoint stratified normal scores, clipped away from tails only by midpoint
    q=(fnp.arange(n, dtype=fnp.float32)+0.5)/float(n)
    z=fst.norm.ppf(q).astype(fnp.float32)
    cols=[]
    for j in range(width):
        cols.append(z[rng.permutation(n)])
    u=fnp.stack(cols, axis=1)
    cov=(u.T@u)/float(n)
    ev,evec=fnp.linalg.eigh(cov)
    ev=fnp.maximum(ev,1e-6)
    inv=(evec/fnp.sqrt(ev))@evec.T
    half=fnp.asarray(u@inv, dtype=fnp.float32)
    return fnp.concatenate([half,-half],axis=0)

def first_mom(weight):
    cov=weight.T@weight
    var=fnp.maximum(fnp.diag(cov),1e-30)
    scale=fnp.sqrt(var)
    mean=scale*_INV_SQRT_2PI
    denom=scale[:,None]*scale[None,:]
    corr=fnp.clip(cov/denom,-1.0,1.0)
    second=denom*(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(fnp.pi-fnp.arccos(corr))*corr)/_TWO_PI
    acov=(second-mean[:,None]*mean[None,:])
    acov=(acov+acov.T)*0.5
    return mean,acov

def pred(mlp,samples):
    w0=mlp.weights[0]
    m1,c1=first_mom(w0)
    x=fnp.maximum(samples@w0,0.0)
    if mlp.depth==1: return m1
    w=mlp.weights[1]
    pre=x@w
    sm=fnp.mean(pre,axis=0)
    ss=fnp.mean(pre*pre,axis=0)
    sv=fnp.maximum(ss-sm*sm,1e-7)
    tm=m1@w
    tv=fnp.maximum(fnp.sum(w*(c1@w),axis=0),1e-7)
    x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0.0)
    for w in mlp.weights[2:]:
        x=fnp.maximum(x@w,0.0)
    return fnp.mean(x,axis=0)

width=64; depth=32; budget=1_000_000_000
k=sample_count(budget,width,depth)
print('k',k)
errs={'cur':[], 'lhs':[]}
for i in range(3):
    rng=fnp.random.default_rng(1000+i)
    mlp=sample_mlp(width, depth, rng, seed=2000+i)
    _, target, _ = sample_layer_statistics(mlp, 200000, rng=fnp.random.default_rng(3000+i))
    for name,maker in [('cur',make_current),('lhs',make_lhs)]:
        samples=maker(width,k,42)
        p=pred(mlp,samples)
        mse=float(fnp.mean((p-target)**2))
        errs[name].append(mse)
        print(i,name,mse)
print('avg', {k:sum(v)/len(v) for k,v in errs.items()})

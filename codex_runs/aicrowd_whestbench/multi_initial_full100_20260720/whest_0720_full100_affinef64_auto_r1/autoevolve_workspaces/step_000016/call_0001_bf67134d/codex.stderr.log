from __future__ import annotations
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

_BUDGET_FRACTION=0.236
_INV=0.3989422804014327
_TWO=6.283185307179586

def sc(b,w,d):
 per=d*(2*w*w+w)+w*w; fixed=9*w**3+2*(2*w**3); k=(int(_BUDGET_FRACTION*b)-fixed)//per; return int(max(32,min(1000000,100*1024*1024//(w*4),k))) & ~1

def make(w,k,seed):
 rng=fnp.random.default_rng(seed); u=rng.standard_normal((k//2,w), dtype=fnp.float32); c=(u.T@u)/float(k//2); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); inv=(v/fnp.sqrt(e))@v.T; h=fnp.asarray(u@inv,dtype=fnp.float32); return fnp.concatenate([h,-h],axis=0)

def fm(weight):
 c=weight.T@weight; var=fnp.maximum(fnp.diag(c),1e-30); s=fnp.sqrt(var); m=s*_INV; d=s[:,None]*s[None,:]; r=fnp.clip(c/d,-1,1); sec=d*(fnp.sqrt(fnp.maximum(1-r*r,0))+(fnp.pi-fnp.arccos(r))*r)/_TWO; ac=sec-m[:,None]*m[None,:]; return m,(ac+ac.T)*.5

def pred(mlp,s):
 m,c=fm(mlp.weights[0]); x=fnp.maximum(s@mlp.weights[0],0); w=mlp.weights[1]; pre=x@w; sm=fnp.mean(pre,0); ss=fnp.mean(pre*pre,0); sv=fnp.maximum(ss-sm*sm,1e-7); tm=m@w; tv=fnp.maximum(fnp.sum(w*(c@w),0),1e-7); x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0); 
 for w in mlp.weights[2:]: x=fnp.maximum(x@w,0)
 return fnp.mean(x,0)

for width,depth,budget in [(64,128,2_000_000_000),(128,128,8_000_000_000)]:
 k=sc(budget,width,depth); print('case',width,depth,'k',k)
 mlps=[]; targets=[]
 for i in range(3):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i); mlps.append(mlp); targets.append(sample_layer_statistics(mlp,100000,rng=fnp.random.default_rng(3000+i))[1])
 vals=[]
 for off in range(10):
  s=make(width,k,off)
  e=[]
  for mlp,t in zip(mlps,targets):
   p=pred(mlp,s); e.append(float(fnp.mean((p-t)**2)))
  vals.append((sum(e)/len(e),off,e))
 print('best', sorted(vals)[:5])
 print('off3', [v for v in vals if v[1]==3])

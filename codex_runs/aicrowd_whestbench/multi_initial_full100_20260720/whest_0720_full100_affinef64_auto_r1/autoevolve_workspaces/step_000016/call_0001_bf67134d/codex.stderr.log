INV=0.3989422804014327; TWO=6.283185307179586

def make_anti(w,k,seed):
 r=fnp.random.default_rng(seed); u=r.standard_normal((k//2,w), dtype=fnp.float32); c=(u.T@u)/float(k//2); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); h=fnp.asarray(u@((v/fnp.sqrt(e))@v.T),dtype=fnp.float32); return fnp.concatenate([h,-h],0)

def make_full(w,k,seed):
 r=fnp.random.default_rng(seed); u=r.standard_normal((k,w), dtype=fnp.float32); u=u-fnp.mean(u,axis=0); c=(u.T@u)/float(k); e,v=fnp.linalg.eigh(c); e=fnp.maximum(e,1e-6); return fnp.asarray(u@((v/fnp.sqrt(e))@v.T), dtype=fnp.float32)

def fm(weight):
 c=weight.T@weight; var=fnp.maximum(fnp.diag(c),1e-30); s=fnp.sqrt(var); m=s*INV; d=s[:,None]*s[None,:]; r=fnp.clip(c/d,-1,1); sec=d*(fnp.sqrt(fnp.maximum(1-r*r,0))+(fnp.pi-fnp.arccos(r))*r)/TWO; ac=sec-m[:,None]*m[None,:]; return m,(ac+ac.T)*.5

def pred(mlp,s):
 m,c=fm(mlp.weights[0]); x=fnp.maximum(s@mlp.weights[0],0); w=mlp.weights[1]; pre=x@w; sm=fnp.mean(pre,0); ss=fnp.mean(pre*pre,0); sv=fnp.maximum(ss-sm*sm,1e-7); tm=m@w; tv=fnp.maximum(fnp.sum(w*(c@w),0),1e-7); x=fnp.maximum((pre-sm)*fnp.sqrt(tv/sv)+tm,0); 
 for w in mlp.weights[2:]: x=fnp.maximum(x@w,0)
 return fnp.mean(x,0)
for width,depth,k in [(64,128,440),(128,128,440),(128,32,1078)]:
 print('case',width,depth,k)
 mlps=[]; targets=[]
 for i in range(3):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(1000+i),seed=2000+i); mlps.append(mlp); targets.append(sample_layer_statistics(mlp,100000,rng=fnp.random.default_rng(3000+i))[1])
 for name,mk in [('anti',make_anti),('full',make_full)]:
  s=mk(width,k,3)
  es=[]
  for mlp,t in zip(mlps,targets): es.append(float(fnp.mean((pred(mlp,s)-t)**2)))
  print(name, sum(es)/len(es), es)

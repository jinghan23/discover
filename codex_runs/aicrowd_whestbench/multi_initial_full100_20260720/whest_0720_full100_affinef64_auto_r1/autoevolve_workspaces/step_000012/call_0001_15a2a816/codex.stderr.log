+        target_values = fnp.maximum(target_values, 1e-8)
+        inverse_sqrt = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
+        sqrt_target = (target_vectors * fnp.sqrt(target_values)) @ target_vectors.T
+        return fnp.asarray(centered @ (inverse_sqrt @ sqrt_target) + target_mean, dtype=fnp.float32)

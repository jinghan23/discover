    def _first_layer_moments(self, weight):
        covariance = weight.T @ weight
        variance = fnp.maximum(fnp.diag(covariance), 1e-30)
        scale = fnp.sqrt(variance)
        mean = scale * _INV_SQRT_2PI
        denom = scale[:, None] * scale[None, :]
        corr = fnp.clip(covariance / denom, -1.0, 1.0)
        second = (
            denom
            * (
                fnp.sqrt(fnp.maximum(1.0 - corr * corr, 0.0))
                + (fnp.pi - fnp.arccos(corr)) * corr
            )
            / _TWO_PI
        )
        activation_covariance = second - mean[:, None] * mean[None, :]
        activation_covariance = (
            activation_covariance + activation_covariance.T
        ) * 0.5
        return mean, activation_covariance, variance

    def _match_full_covariance(self, x, target_mean, target_covariance):
        sample_mean = fnp.mean(x, axis=0)
        centered = x - sample_mean
        k = x.shape[0]
        sample_covariance = (centered.T @ centered) / float(k)
        sample_covariance = (sample_covariance + sample_covariance.T) * 0.5
        target_covariance = (target_covariance + target_covariance.T) * 0.5
        sample_values, sample_vectors = fnp.linalg.eigh(sample_covariance)
        target_values, target_vectors = fnp.linalg.eigh(target_covariance)
        sample_values = fnp.maximum(sample_values, 1e-7)
        target_values = fnp.maximum(target_values, 1e-8)
        inverse_sqrt = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
        sqrt_target = (target_vectors * fnp.sqrt(target_values)) @ target_vectors.T
        return fnp.asarray(centered @ (inverse_sqrt @ sqrt_target) + target_mean, dtype=fnp.float32)

    def _normal_cdf(self, x):
        return 0.5 * (
            1.0
            + fnp.tanh(_SQRT_2_OVER_PI * (x + 0.044715 * x * x * x))
        )

    def _relu_normal_moments(self, mean, variance):
        variance = fnp.maximum(variance, 1e-8)
        scale = fnp.sqrt(variance)
        alpha = mean / scale
        density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
        cdf = self._normal_cdf(alpha)
        relu_mean = scale * density + mean * cdf
        relu_second = (variance + mean * mean) * cdf + mean * scale * density
        relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 1e-8)
        return relu_mean, relu_variance

    def _diag_gaussian_final(self, mlp, first_mean, first_covariance, first_variance):
        variance = first_variance * (0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI)
        mean = first_mean
        if mlp.depth == 1:
            return mean
        weight = mlp.weights[1]
        pre_mean = mean @ weight
        pre_variance = fnp.maximum(
            fnp.sum(weight * (first_covariance @ weight), axis=0),
            1e-8,
        )
        mean, variance = self._relu_normal_moments(pre_mean, pre_variance)


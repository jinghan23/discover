+            covariance = pre_covariance * (cdf[:, None] * cdf[None, :])
+            covariance = covariance + fnp.diag(relu_variance - fnp.diag(covariance))
+            covariance = (covariance + covariance.T) * 0.5
+            mean = relu_mean
+        return mean

diff --git a/submission.py b/submission.py
index 4ad1975ddadf15598dd7d4e077542048ab1ddc46..ac8451a37101e6bfac5addff110b8d1515244379
--- a/submission.py
+++ b/submission.py
@@ -10,7 +10,9 @@
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _WORST_CASE_ITEMSIZE = 4
 _SETUP_SEED_OFFSET = 3
+_FINAL_GAUSSIAN_BLEND = 0.15
 _INV_SQRT_2PI = 0.3989422804014327
+_SQRT_2_OVER_PI = 0.7978845608028654
 _TWO_PI = 6.283185307179586
 
 
@@ -23,6 +25,18 @@
     return k - (k & 1)
 
 
+def _normal_relu_mean(mean, variance):
+    scale = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = mean / scale
+    alpha2 = alpha * alpha
+    cdf = 0.5 * (
+        1.0
+        + fnp.tanh(_SQRT_2_OVER_PI * (alpha + 0.044715 * alpha * alpha2))
+    )
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha2)
+    return scale * pdf + mean * cdf
+
+
 class Estimator(BaseEstimator):
     def setup(self, context):
         self._width = int(context.width)
@@ -99,18 +113,35 @@
             fnp.sum(second_weight * (first_covariance @ second_weight), axis=0),
             1e-7,
         )
-        x = fnp.maximum(
+        calibrated = (
             (preactivation - sample_mean)
             * fnp.sqrt(target_variance / sample_variance)
-            + target_mean,
-            0.0,
+            + target_mean
         )
+        x = fnp.maximum(calibrated, 0.0)
+        if depth == 2:
+            sample_final = fnp.mean(x, axis=0)
+            gaussian_final = _normal_relu_mean(target_mean, target_variance)
+            final_mean = fnp.asarray(
+                sample_final
+                + _FINAL_GAUSSIAN_BLEND * (gaussian_final - sample_final),
+                dtype=fnp.float32,
+            )
+            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
+            return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)
 
-        for weight in mlp.weights[2:]:
+        for weight in mlp.weights[2:-1]:
             x = fnp.maximum(x @ weight, 0.0)
 
+        preactivation = x @ mlp.weights[-1]
+        x = fnp.maximum(preactivation, 0.0)
+        sample_mean = fnp.mean(preactivation, axis=0)
+        sample_second = fnp.mean(preactivation * preactivation, axis=0)
+        sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-7)
+        sample_final = fnp.mean(x, axis=0)
+        gaussian_final = _normal_relu_mean(sample_mean, sample_variance)
         final_mean = fnp.asarray(
-            fnp.mean(x, axis=0),
+            sample_final + _FINAL_GAUSSIAN_BLEND * (gaussian_final - sample_final),
             dtype=fnp.float32,
         )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)


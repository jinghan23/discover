+        sample_mean = fnp.mean(values, axis=0)
+        centered = values - sample_mean
+        k = values.shape[0]
+        sample_covariance = (centered.T @ centered) / float(k)
+        sample_covariance = (sample_covariance + sample_covariance.T) * 0.5
+        target_covariance = (target_covariance + target_covariance.T) * 0.5
+
+        sample_eigenvalues, sample_eigenvectors = fnp.linalg.eigh(sample_covariance)
+        target_eigenvalues, target_eigenvectors = fnp.linalg.eigh(target_covariance)
+        sample_eigenvalues = fnp.maximum(sample_eigenvalues, _COV_EPS)
+        target_eigenvalues = fnp.maximum(target_eigenvalues, _COV_EPS)
+
+        inverse_sqrt = (
+            sample_eigenvectors / fnp.sqrt(sample_eigenvalues)
+        ) @ sample_eigenvectors.T
+        target_sqrt = (
+            target_eigenvectors * fnp.sqrt(target_eigenvalues)
+        ) @ target_eigenvectors.T
+        return centered @ (inverse_sqrt @ target_sqrt) + target_mean
+
     def predict(self, mlp, budget):

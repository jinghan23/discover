diff --git a/submission.py b/submission.py
index 4ad1975ddadf15598dd7d4e077542048ab1ddc46..939ea0850a5011e1ccd3adf0a1fb16bbfe4d16cf
--- a/submission.py
+++ b/submission.py
@@ -10,6 +10,7 @@
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _WORST_CASE_ITEMSIZE = 4
 _SETUP_SEED_OFFSET = 3
+_SIGN_SEED_OFFSET = 17
 _INV_SQRT_2PI = 0.3989422804014327
 _TWO_PI = 6.283185307179586
 
@@ -80,6 +81,12 @@
                 int(mlp.seed) + _SETUP_SEED_OFFSET,
             )
         samples = self._samples
+        rng = fnp.random.default_rng(int(mlp.seed) + _SIGN_SEED_OFFSET)
+        signs = fnp.asarray(
+            2 * rng.integers(0, 2, size=(width,)) - 1,
+            dtype=fnp.float32,
+        )
+        samples = samples * signs[None, :]
 
         first_weight = mlp.weights[0]
         first_mean, first_covariance = self._first_layer_moments(first_weight)


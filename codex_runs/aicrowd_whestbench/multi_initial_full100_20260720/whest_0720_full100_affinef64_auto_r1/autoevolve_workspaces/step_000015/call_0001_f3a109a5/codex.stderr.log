+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    relu_mean = scale * pdf + mean * cdf
+    relu_second = (mean * mean + variance) * cdf + mean * scale * pdf
+    relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 1e-12)
+    return relu_mean, relu_variance

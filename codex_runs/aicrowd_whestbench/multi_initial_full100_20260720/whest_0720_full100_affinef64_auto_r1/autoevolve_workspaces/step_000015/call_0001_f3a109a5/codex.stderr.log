+def _normal_cdf(x):
+    z = fnp.abs(x) * _SQRT1_2
+    t = 1.0 / (1.0 + _ERF_P * z)
+    poly = (
+        (
+            (
+                ((_ERF_A5 * t + _ERF_A4) * t + _ERF_A3)
+                * t
+                + _ERF_A2

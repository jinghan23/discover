+def _normal_cdf(x):
+    positive = x >= 0.0
+    z = fnp.where(positive, x, -x)
+    t = 1.0 / (1.0 + 0.2316419 * z)
+    polynomial = t * (
+        0.319381530
+        + t
+        * (
+            -0.356563782

+def _first_relu_covariance(weight, variance, mean):
+    gram = weight.T @ weight
+    scale = fnp.sqrt(variance[:, None] * variance[None, :])
+    correlation = fnp.clip(gram / fnp.maximum(scale, 1e-12), -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second = (
+        scale
+        * (
+            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+            + (fnp.pi - angle) * correlation
+        )
+        / (2.0 * fnp.pi)
+    )
+    return second - mean[:, None] * mean[None, :]
+
+
+def _normal_cdf(x):
+    positive = x >= 0.0
+    z = fnp.where(positive, x, -x)
+    t = 1.0 / (1.0 + 0.2316419 * z)
+    polynomial = t * (
+        0.319381530
+        + t
+        * (
+            -0.356563782
+            + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))
+        )

+def _relu_second_from_kernel(kernel):
+    variance = fnp.maximum(fnp.diag(kernel), 1e-12)
+    scale = fnp.sqrt(variance[:, None] * variance[None, :])
+    correlation = fnp.clip(kernel / fnp.maximum(scale, 1e-12), -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second = (
+        scale
+        * (
+            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+            + (fnp.pi - angle) * correlation
+        )
+        / (2.0 * fnp.pi)
+    )
+    mean = fnp.sqrt(variance) * _INV_SQRT_2PI
+    return mean, second
+

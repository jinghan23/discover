+def _first_relu_covariance(weight, variance, mean):
+    gram = weight.T @ weight
+    scale = fnp.sqrt(variance[:, None] * variance[None, :])
+    correlation = fnp.clip(gram / fnp.maximum(scale, 1e-12), -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second = (
+        scale
+        * (
+            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+            + (fnp.pi - angle) * correlation
+        )
+        / (2.0 * fnp.pi)
+    )
+    return second - mean[:, None] * mean[None, :]
+
+
+def _normal_cdf(x):
+    positive = x >= 0.0
+    z = fnp.where(positive, x, -x)
+    t = 1.0 / (1.0 + 0.2316419 * z)
+    polynomial = t * (
+        0.319381530
+        + t
+        * (
+            -0.356563782
+            + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))
+        )
+    )
+    cdf = 1.0 - _INV_SQRT_2PI * fnp.exp(-0.5 * z * z) * polynomial
+    return fnp.where(positive, cdf, 1.0 - cdf)
+
+
+def _relu_normal_mean(mean, variance):
+    std = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = mean / std
+    density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    return std * density + mean * _normal_cdf(alpha)
+
+
+def _relu_second_from_kernel(kernel):
+    variance = fnp.maximum(fnp.diag(kernel), 1e-12)
+    scale = fnp.sqrt(variance[:, None] * variance[None, :])
+    correlation = fnp.clip(kernel / fnp.maximum(scale, 1e-12), -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second = (
+        scale
+        * (
+            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+            + (fnp.pi - angle) * correlation
+        )
+        / (2.0 * fnp.pi)
+    )
+    mean = fnp.sqrt(variance) * _INV_SQRT_2PI
+    return mean, second
+
+
+def _full_zero_mean_final(mlp):
+    moment = fnp.eye(mlp.width, dtype=fnp.float32)
+    mean = fnp.zeros((mlp.width,), dtype=fnp.float32)
+    for weight in mlp.weights:
+        kernel = weight.T @ (moment @ weight)
+        mean, moment = _relu_second_from_kernel(kernel)
+    return fnp.asarray(mean, dtype=fnp.float32)
+

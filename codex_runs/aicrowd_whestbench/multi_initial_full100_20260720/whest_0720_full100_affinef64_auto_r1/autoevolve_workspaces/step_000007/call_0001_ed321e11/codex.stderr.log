def _resolve_mlp_range(n_mlps: int, mlp_range: Optional[Tuple[int, int]]) -> Tuple[int, int]:
    if mlp_range is None:
        return (0, n_mlps)
    start, end = mlp_range
    if not (0 <= start < end <= n_mlps):
        raise ValueError(
            f"mlp_range {mlp_range!r} invalid for n_mlps={n_mlps}; need 0 <= start < end <= n_mlps."
        )
    return (start, end)



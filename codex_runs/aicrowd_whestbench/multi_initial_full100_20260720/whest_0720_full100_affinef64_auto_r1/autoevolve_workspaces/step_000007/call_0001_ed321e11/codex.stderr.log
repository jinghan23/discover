import numpy as np, math, time
INV=0.3989422804014327
TWO_PI=6.283185307179586

def chi_mean(w):
    return math.sqrt(2.0)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))

def make_gauss(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/float(k//2)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def make_sphere(width,k,seed,whiten=False,scale_mode='chi'):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    n=np.sqrt(np.sum(u*u,axis=1,keepdims=True))
    d=u/np.maximum(n,1e-12)
    if whiten:
        cov=(d.T@d)/float(k//2)
        vals,vecs=np.linalg.eigh(cov)
        vals=np.maximum(vals,1e-8)
        inv=(vecs/np.sqrt(vals))@vecs.T
        d=(d@inv)/math.sqrt(width)
    scale=chi_mean(width) if scale_mode=='chi' else math.sqrt(width)
    half=(d*scale).astype(np.float32)
    return np.concatenate([half,-half],0)

def first_mom(W):
    cov=W.T@W
    var=np.maximum(np.diag(cov),1e-30)
    scale=np.sqrt(var)
    mean=scale*INV
    denom=scale[:,None]*scale[None,:]
    corr=np.clip(cov/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/TWO_PI
    acov=(second-mean[:,None]*mean[None,:])
    return mean.astype(np.float32), ((acov+acov.T)*.5).astype(np.float32), var.astype(np.float32)

def est(weights,samples,mode='current'):
    depth=len(weights); width=weights[0].shape[0]
    fm,fc,fv=first_mom(weights[0])
    x=np.maximum(samples@weights[0],0)
    if depth==1: return fm
    if mode in ['current','sphere','spherew']:
        sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
        tv=fv*(0.5-INV*INV)
        x=(x-sm)*np.sqrt(tv/sv)+fm
        W=weights[1]
        pre=x@W
        sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
        tm=fm@W
        tv=np.maximum(np.sum(W*(fc@W),axis=0),1e-7)
        x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
        for W in weights[2:]:
            x=np.maximum(x@W,0)
    elif mode=='raw':
        for W in weights[1:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def target(weights,n=400000,batch=20000,seed=123):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    c=chi_mean(w)
    s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(batch,n-done)
        u=rng.standard_normal((m,w)).astype(np.float32)
        u/=np.sqrt(np.sum(u*u,axis=1,keepdims=True))
        x=u*c
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return (s/n).astype(np.float32)

def run(width=64,depth=16,k=100000,nmlp=5):
    rng=np.random.default_rng(999)
    modes=['gauss_current','sphere_rawcorr','spherew_rawcorr','sphere_raw','gauss_raw']
    errs={m:[] for m in modes}
    t=time.time()
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        ref=target(weights,n=300000,seed=1000+i)
        samples={
            'gauss_current': make_gauss(width,k,2000+i),
            'sphere_rawcorr': make_sphere(width,k,2000+i,False,'chi'),
            'spherew_rawcorr': make_sphere(width,k,2000+i,True,'chi'),
            'sphere_raw': make_sphere(width,k,2000+i,False,'chi'),
            'gauss_raw': make_gauss(width,k,2000+i),
        }
        for m in modes:
            mode='raw' if m in ['sphere_raw','gauss_raw'] else 'current'
            pred=est(weights,samples[m],mode)
            errs[m].append(float(np.mean((pred-ref)**2)))
        print('i',i,{m:errs[m][-1] for m in modes}, flush=True)
    print('avg')
    for m in modes:
        print(m, np.mean(errs[m]), np.std(errs[m])/math.sqrt(nmlp))
    print('time',time.time()-t)

for params in [(32,8,200000,4),(64,16,100000,4)]:
    print('PARAMS',params)
    run(*params)

INV=0.3989422804014327; TWO_PI=6.283185307179586

def pdf(a): return INV*np.exp(-0.5*a*a)
def cdf(a): return 0.5*(1+np.tanh(0.7978845608028654*(a+0.044715*a*a*a)))
def make_gauss(width,k,seed):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/float(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32); return np.concatenate([half,-half],0)
def first_mom(W):
    cov=W.T@W; var=np.maximum(np.diag(cov),1e-30); sc=np.sqrt(var); mean=sc*INV; denom=sc[:,None]*sc[None,:]; corr=np.clip(cov/denom,-1,1)
    sec=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/TWO_PI; ac=sec-mean[:,None]*mean[None,:]
    return mean.astype(np.float32), ((ac+ac.T)*.5).astype(np.float32), var.astype(np.float32)
def current_hidden(weights,samples, stop_before_final=False):
    depth=len(weights); fm,fc,fv=first_mom(weights[0]); x=np.maximum(samples@weights[0],0)
    if depth==1: return None,fm
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tv/sv)+fm
    W=weights[1]; pre=x@W; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@W; tv=np.maximum(np.sum(W*(fc@W),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    if depth==2: return None,x.astype(np.float64).mean(0).astype(np.float32)
    for W in weights[2:-1]: x=np.maximum(x@W,0)
    return x, None
def est(weights,samples,mode='sample', blend=0.0):
    if len(weights)==1: return first_mom(weights[0])[0]
    x,_=current_hidden(weights,samples)
    W=weights[-1]; pre=x@W
    relu=np.maximum(pre,0).astype(np.float64).mean(0)
    if mode=='sample': return relu.astype(np.float32)
    mu=pre.astype(np.float64).mean(0); sec=(pre.astype(np.float64)*pre.astype(np.float64)).mean(0); var=np.maximum(sec-mu*mu,1e-12); sig=np.sqrt(var); a=mu/sig
    gauss=mu*cdf(a)+sig*pdf(a)
    if mode=='gauss': return gauss.astype(np.float32)
    return ((1-blend)*relu+blend*gauss).astype(np.float32)
def chi_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def target(weights,n=300000,batch=15000,seed=123):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; c=chi_mean(w); s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(batch,n-done); u=rng.standard_normal((m,w)).astype(np.float32); u/=np.sqrt(np.sum(u*u,1,keepdims=True)); x=u*c
        for W in weights: x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return (s/n).astype(np.float32)
def run(width,depth,k,nmlp):
    rng=np.random.default_rng(42); modes=['sample','gauss','b25','b50','b75']; errs={m:[] for m in modes}
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        ref=target(weights, n=400000 if width<=64 else 150000, seed=500+i)
        samples=make_gauss(width,k,700+i)
        preds={'sample':est(weights,samples,'sample'), 'gauss':est(weights,samples,'gauss'), 'b25':est(weights,samples,'blend',.25), 'b50':est(weights,samples,'blend',.5), 'b75':est(weights,samples,'blend',.75)}
        row={m:float(np.mean((preds[m]-ref)**2)) for m in modes}; print('i',i,row,flush=True)
        for m in modes: errs[m].append(row[m])
    print('avg');
    for m in modes: print(m,np.mean(errs[m]))
print('small'); run(32,8,200000,5)
print('med'); run(64,16,100000,5)
print('default-ish'); run(128,24,30000,3)

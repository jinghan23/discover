codex
Next I’m testing a deeper moment-matching variant: keep a full covariance Gaussian approximation through all layers, and use it to rescale each sampled preactivation before ReLU. The risk is approximation bias in deep layers, so I’ll screen it synthetically first.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=0.3989422804014327; TWO_PI=6.283185307179586
SQRT2=math.sqrt(2.0)

def norm_pdf(a): return INV*np.exp(-0.5*a*a)
def norm_cdf(a): return 0.5*(1.0+np.vectorize(math.erf)(a/math.sqrt(2.0)))
# vectorize slow, use approximation maybe

def cdf_fast(x):
    # GELU tanh approximation for Phi
    return 0.5*(1.0+np.tanh(0.7978845608028654*(x+0.044715*x*x*x)))

def make_gauss(width,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,width)).astype(np.float32)
    cov=(u.T@u)/float(k//2)
    vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def first_mom(W):
    cov=W.T@W; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV
    denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/TWO_PI
    acov=(second-mean[:,None]*mean[None,:]); return mean.astype(np.float32), ((acov+acov.T)*.5).astype(np.float32), var.astype(np.float32)

def relu_gauss_mom(pre_mu, pre_cov):
    var=np.maximum(np.diag(pre_cov),1e-12)
    sig=np.sqrt(var); a=pre_mu/sig
    Phi=cdf_fast(a); phi=norm_pdf(a)
    mu=pre_mu*Phi+sig*phi
    ez2=(pre_mu*pre_mu+var)*Phi+pre_mu*sig*phi
    var_post=np.maximum(ez2-mu*mu,1e-12)
    gain=Phi
    cov=(gain[:,None]*gain[None,:])*pre_cov
    np.fill_diagonal(cov,var_post)
    return mu.astype(np.float32), ((cov+cov.T)*.5).astype(np.float32)

def est_current(weights,samples):
    depth=len(weights); fm,fc,fv=first_mom(weights[0]); x=np.maximum(samples@weights[0],0)
    if depth==1: return fm
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+fm
    W=weights[1]; pre=x@W; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
    tm=fm@W; tv=np.maximum(np.sum(W*(fc@W),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for W in weights[2:]: x=np.maximum(x@W,0)
    return x.astype(np.float64).mean(0).astype(np.float32)

def est_deepcorr(weights,samples, start=2, strength=1.0, mean_only=False):
    depth=len(weights); fm,fc,fv=first_mom(weights[0]); x=np.maximum(samples@weights[0],0)
    if depth==1: return fm
    # target post layer1 exact diagonal, full cov exact
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(tv/sv)+fm
    mu=fm; cov=fc
    for li,W in enumerate(weights[1:], start=1):
        pre=x@W
        pre_mu=mu@W
        pre_cov=W.T@cov@W
        pre_var=np.maximum(np.diag(pre_cov),1e-7)
        if li>=1 and li < depth: # all pre before relu
            sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
            if mean_only:
                adj=pre - sm + pre_mu
            else:
                ratio=np.sqrt(pre_var/sv)
                # blend correction ratio/mean to reduce bias
                adj=(pre-sm)*(1+strength*(ratio-1)) + (sm + strength*(pre_mu-sm))
            x=np.maximum(adj,0)
        else:
            x=np.maximum(pre,0)
        # update gaussian approx post moments for next layer
        mu,cov=relu_gauss_mom(pre_mu,pre_cov)
    return x.astype(np.float64).mean(0).astype(np.float32)

def chi_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def target(weights,n=300000,batch=15000,seed=123):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; c=chi_mean(w); s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(batch,n-done); u=rng.standard_normal((m,w)).astype(np.float32); u/=np.sqrt(np.sum(u*u,1,keepdims=True)); x=u*c
        for W in weights: x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return (s/n).astype(np.float32)

def run(width=64,depth=16,k=100000,nmlp=5):
    rng=np.random.default_rng(1234)
    modes=['current','deep1','deep05','deep025','meanonly']
    errs={m:[] for m in modes}
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        ref=target(weights,n=300000,seed=900+i)
        samples=make_gauss(width,k,700+i)
        preds={
            'current': est_current(weights,samples),
            'deep1': est_deepcorr(weights,samples, strength=1.0),
            'deep05': est_deepcorr(weights,samples, strength=0.5),
            'deep025': est_deepcorr(weights,samples, strength=0.25),
            'meanonly': est_deepcorr(weights,samples, mean_only=True),
        }
        print('i',i,{m:float(np.mean((preds[m]-ref)**2)) for m in modes}, flush=True)
        for m in modes: errs[m].append(float(np.mean((preds[m]-ref)**2)))
    print('avg')
    for m in modes: print(m, np.mean(errs[m]))
print('small'); run(32,8,200000,4)
print('med'); run(64,16,100000,4)

/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=1/math.sqrt(2*math.pi)
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=400000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def samples(w,k,seed=123):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([u,-u],0)
def final_samples(W,k):
 s=samples(W[0].shape[0],k,123); fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(s@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 for M in W[1:]: x=np.maximum(x@M,0)
 return x
def estim(y,mode):
 if mode=='mean': return y.mean(0)
 if mode.startswith('win'):
  q=float(mode[3:]); hi=np.quantile(y,q,axis=0); return np.minimum(y,hi).mean(0)
 if mode.startswith('trim'):
  q=float(mode[4:]); lo=np.quantile(y,q,axis=0); hi=np.quantile(y,1-q,axis=0); yy=np.clip(y,lo,hi); return yy.mean(0)
 if mode.startswith('mom'):
  b=int(mode[3:]); n=y.shape[0]//b*b; means=y[:n].reshape(b,n//b,y.shape[1]).mean(1); return np.median(means,axis=0)
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5)]:
 print('case',w,d)
 modes=['mean','win0.999','win0.995','win0.99','trim0.001','trim0.005','mom4','mom8','mom16']
 errs={m:[] for m in modes}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w>=128 else 400000,2000+i); y=final_samples(W,k)
  for m in modes: errs[m].append(np.mean((estim(y,m)-t)**2))
 for m in modes: print(m,np.mean(errs[m]))

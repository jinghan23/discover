codex
Another cheap variance probe is an MLP-seeded orthogonal symmetry: flip sample coordinates by random signs before the first layer. This preserves the Gaussian law and exact covariance but changes the finite quadrature orientation per MLP. I’m testing signs locally first.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=1/math.sqrt(2*math.pi)
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=300000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def samples(w,k,seed=123):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([u,-u],0)
def pred(W,k,sign_seed=None,perm=False):
 s=samples(W[0].shape[0],k,123); w=W[0].shape[0]
 if sign_seed is not None:
  rng=np.random.default_rng(sign_seed); signs=np.where(rng.standard_normal(w)>0,1.0,-1.0).astype(np.float32); s=s*signs
  if perm:
   p=rng.permutation(w); s=s[:,p]
 fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(s@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 for M in W[1:]: x=np.maximum(x@M,0)
 return x.mean(0)
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5),(256,8,8192,4)]:
 print('case',w,d,k)
 names=['base','sign0','signi','signperm']
 errs={n:[] for n in names}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w<128 else 200000,2000+i)
  vals={'base':pred(W,k,None),'sign0':pred(W,k,777),'signi':pred(W,k,5000+i),'signperm':pred(W,k,5000+i,True)}
  for n,p in vals.items(): errs[n].append(np.mean((p-t)**2))
 for n in names: print(n,np.mean(errs[n]))

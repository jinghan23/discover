codex
A vectorized Latin-hypercube normal design might reduce sample variance, but it needs inverse-normal quantiles in setup. I’m testing the idea locally with SciPy quantiles first; if it helps, I can implement the approximation using `flopscope.numpy`.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.special import ndtri
INV=1/math.sqrt(2*math.pi)
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=300000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def whiten(u):
 cov=(u.T@u)/u.shape[0]; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); return (u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
def samples(w,k,kind,seed=123):
 rng=np.random.default_rng(seed); h=k//2
 if kind=='gauss':
  u=rng.standard_normal((h,w)).astype(np.float32)
 elif kind=='lhs':
  q=ndtri((np.arange(h)+0.5)/h).astype(np.float32)
  u=np.empty((h,w),np.float32)
  for j in range(w): u[:,j]=q[rng.permutation(h)]
 elif kind=='lhs_shift':
  q=ndtri((np.arange(h)+0.5)/h).astype(np.float32)
  p=rng.permutation(h)
  base=q[p]
  shifts=rng.integers(0,h,size=w)
  u=np.empty((h,w),np.float32)
  for j,sh in enumerate(shifts): u[:,j]=np.roll(base,sh)
 elif kind=='lhs_sign':
  q=ndtri((np.arange(h)+0.5)/h).astype(np.float32)
  u=np.empty((h,w),np.float32)
  for j in range(w):
   u[:,j]=q[rng.permutation(h)]
  # random orthogonal-ish signs? no
 u=whiten(u)
 return np.concatenate([u,-u],0)
def prop(W,samp):
 fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(samp@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 for M in W[1:]: x=np.maximum(x@M,0)
 return x.mean(0)
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5)]:
 print('case',w,d,k)
 names=['gauss','lhs','lhs_shift']
 errs={n:[] for n in names}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w<128 else 200000,2000+i)
  for n in names: errs[n].append(np.mean((prop(W,samples(w,k,n,123))-t)**2))
 for n in names: print(n,np.mean(errs[n]))

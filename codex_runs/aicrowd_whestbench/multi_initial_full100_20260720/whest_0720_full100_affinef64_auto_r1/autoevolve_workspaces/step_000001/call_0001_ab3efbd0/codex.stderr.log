/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=1/math.sqrt(2*math.pi)
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=300000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def whiten(u):
 cov=(u.T@u)/u.shape[0]; vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); return (u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32)
def samples(w,k,seed=123,blocks=1):
 rng=np.random.default_rng(seed); h=k//2; parts=[]; base=h//blocks
 for b in range(blocks):
  n=base if b<blocks-1 else h-base*(blocks-1)
  # ensure n >= w+2 for stable whitening
  u=rng.standard_normal((n,w)).astype(np.float32)
  parts.append(whiten(u))
 u=np.concatenate(parts,0)
 return np.concatenate([u,-u],0)
def prop(W,samp):
 fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(samp@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 for M in W[1:]: x=np.maximum(x@M,0)
 return x.mean(0)
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5),(256,8,8192,4)]:
 print('case',w,d,k)
 errs={b:[] for b in [1,2,4,8] if k//2//b>w+4}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w<128 else 200000,2000+i)
  for b in errs:
   p=prop(W,samples(w,k,123,b)); errs[b].append(np.mean((p-t)**2))
 for b,v in errs.items(): print('blocks',b,np.mean(v))

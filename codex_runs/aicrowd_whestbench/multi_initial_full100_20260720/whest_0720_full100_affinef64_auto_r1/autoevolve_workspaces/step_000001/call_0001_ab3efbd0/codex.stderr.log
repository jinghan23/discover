codex
A cheaper possible correction is only at the final layer: use the sample preactivation mean/variance to compute a Gaussian ReLU moment and blend it with the empirical final mean. I’m testing that locally because it adds only O(width) pointwise work after the existing final matmul.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)
def relu_mean(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; return sig*np.exp(-0.5*a*a)*INV + mu*ndtr(a)
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=300000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def samples(w,k,seed=123):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([u,-u],0)
def pred(W,k,alpha=0.0,cv=False):
 s=samples(W[0].shape[0],k,123); fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(s@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 if len(W)==1: return fm
 for M in W[1:-1]: x=np.maximum(x@M,0)
 z=x@W[-1]; y=np.maximum(z,0); sample=y.mean(0)
 if alpha==0 and not cv: return sample
 mu=z.mean(0); var=np.maximum((z*z).mean(0)-mu*mu,1e-8); gm=relu_mean(mu,var)
 if cv:
  # sample Gaussian control? draw? no
  return sample + alpha*(gm - sample) # blend same
 return (1-alpha)*sample + alpha*gm
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5),(256,8,8192,4)]:
 print('case',w,d,k)
 alphas=[-0.5,-0.25,-0.1,0,0.05,0.1,0.2,0.5,1.0]
 errs={a:[] for a in alphas}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w<128 else 200000,2000+i)
  for a in alphas: errs[a].append(np.mean((pred(W,k,a)-t)**2))
 best=min(alphas,key=lambda a:np.mean(errs[a]))
 for a in alphas: print(a,np.mean(errs[a]))
 print('best',best)

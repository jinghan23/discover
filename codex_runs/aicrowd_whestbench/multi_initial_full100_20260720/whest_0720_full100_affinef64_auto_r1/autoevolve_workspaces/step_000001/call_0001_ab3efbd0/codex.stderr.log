/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)
def relu_mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; Phi=ndtr(a); phi=np.exp(-0.5*a*a)*INV
 m=sig*phi+mu*Phi; sec=(var+mu*mu)*Phi+mu*sig*phi; return m,sec
def first_exact(W0):
 K=W0.T@W0; q=np.maximum(np.diag(K),1e-30); scale=np.sqrt(np.outer(q,q)); rho=np.clip(K/scale,-1,1); S=scale*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi); m=np.sqrt(q)*INV; C=S-np.outer(m,m); return m,C
def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=300000,seed=0,chunk=20000):
 rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w); done=0
 for st in range(0,n,chunk):
  k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
  for M in W: x=np.maximum(x@M,0)
  s+=x.sum(0); done+=k
 return s/done
def samples(w,k,seed=123):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); u=(u@((vecs/np.sqrt(vals))@vecs.T)).astype(np.float32); return np.concatenate([u,-u],0)
def pred(W,k,mode='base',blend=1):
 s=samples(W[0].shape[0],k,123); fw=W[0]; fv=(fw*fw).sum(0); fm=np.sqrt(fv)*INV; x=np.maximum(s@fw,0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-8); tar=fv*(0.5-INV*INV); x=(x-sm)*np.sqrt(tar/sv)+fm
 if len(W)==1: return fm
 if mode"'!='"'base':
  m1,C1=first_exact(W[0]); W1=W[1]; mu=m1@W1; var=np.sum((C1@W1)*W1,axis=0); gm,gs=relu_mom(mu,var); gv=np.maximum(gs-gm*gm,1e-8)
  y=np.maximum(x@W1,0); ys=y.mean(0); yv=np.maximum((y*y).mean(0)-ys*ys,1e-8)
  if mode=='mean': y=y + blend*(gm-ys)
  elif mode=='var': y=(y-ys)*np.sqrt((blend*gv+(1-blend)*yv)/yv)+(blend*gm+(1-blend)*ys)
  x=y
  rest=W[2:]
 else:
  rest=W[1:]
 for M in rest: x=np.maximum(x@M,0)
 return x.mean(0)
for w,d,k,nnet in [(64,8,4096,20),(128,8,4096,10),(64,16,4096,10),(128,16,4096,5)]:
 print('case',w,d)
 configs=[('base',0),('mean',0.25),('mean',0.5),('mean',1),('var',0.25),('var',0.5),('var',1)]
 errs={c:[] for c in configs}
 for i in range(nnet):
  W=make_weights(w,d,np.random.default_rng(1000+i)); t=true_mc(W,300000 if w<128 else 200000,2000+i)
  for c in configs: errs[c].append(np.mean((pred(W,k,c[0],c[1])-t)**2))
 for c in configs: print(c,np.mean(errs[c]))

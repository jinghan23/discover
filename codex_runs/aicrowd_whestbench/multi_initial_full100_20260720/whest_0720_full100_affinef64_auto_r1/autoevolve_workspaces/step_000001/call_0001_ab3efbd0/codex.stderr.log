A promising cheap comparator is diagonal Gaussian moment propagation: it is biased because it ignores hidden covariance, but it may be useful as a control variate or blend with sample propagation. I’m benchmarking that against the current estimator on synthetic He MLPs.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=1/math.sqrt(2*math.pi)
SQRT2=math.sqrt(2)

def norm_cdf(x):
    # use erf vectorized via scipy if available
    try:
        import scipy.special as sp
        return sp.ndtr(x)
    except Exception:
        return 0.5*(1+np.vectorize(math.erf)(x/SQRT2))

def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-30))
    a=mu/sig
    Phi=norm_cdf(a)
    phi=np.exp(-0.5*a*a)*INV
    mean=sig*phi+mu*Phi
    second=(var+mu*mu)*Phi+mu*sig*phi
    return mean, second

def make_weights(w,d,rng):
    return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]

def true_mc(W,n=500000,seed=0,chunk=20000):
    rng=np.random.default_rng(seed)
    w=W[0].shape[0]
    s=np.zeros(w,dtype=np.float64); ss=np.zeros(w,dtype=np.float64); done=0
    for st in range(0,n,chunk):
        k=min(chunk,n-st)
        x=rng.standard_normal((k,w)).astype(np.float32)
        for M in W:
            x=np.maximum(x@M,0)
        s+=x.sum(0); ss+=(x.astype(np.float64)**2).sum(0); done+=k
    return (s/done).astype(np.float64), (ss/done-s/done*s/done).mean()

def make_samples(w,k,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w)).astype(np.float32)
    cov=(u.T@u)/(k//2)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    inv=(vecs/np.sqrt(vals))@vecs.T
    half=(u@inv).astype(np.float32)
    return np.concatenate([half,-half],0)

def current(W,k=10000,seed=1):
    samples=make_samples(W[0].shape[0],k,seed)
    fw=W[0]
    first_var=np.sum(fw*fw,axis=0)
    first_mean=np.sqrt(first_var)*INV
    x=np.maximum(samples@fw,0)
    sm=x.mean(0); s2=(x*x).mean(0); sv=np.maximum(s2-sm*sm,1e-6)
    target=first_var*(0.5-INV*INV)
    x=(x-sm)*np.sqrt(target/sv)+first_mean
    for M in W[1:]: x=np.maximum(x@M,0)
    return x.mean(0)

def diag_prop(W):
    w=W[0].shape[0]
    m=np.zeros(w); second=np.ones(w)
    for M in W:
        mu=m@M
        var=(second-m*m)@(M*M)
        m,second=relu_mom(mu,var)
    return m

def current_blend_diag(W,k=10000,seed=1,alpha=0.0):
    cm=current(W,k,seed); dm=diag_prop(W)
    return (1-alpha)*cm+alpha*dm

def layer_gauss_rescale(W,k=10000,seed=1,mode='hidden'):
    samples=make_samples(W[0].shape[0],k,seed)
    # initial x standard normal samples exactly covariance 1, mean 0
    x=samples
    for li,M in enumerate(W):
        z=x@M
        y=np.maximum(z,0)
        # exact-ish sample pre moments, Gaussian relu target
        mu=z.mean(0)
        var=np.maximum((z*z).mean(0)-mu*mu,1e-8)
        gm,gs=relu_mom(mu,var)
        gv=np.maximum(gs-gm*gm,1e-8)
        if li==len(W)-1:
            if mode=='final_g':
                return gm
            if mode=='final_blend':
                sm=y.mean(0)
                return 0.5*sm+0.5*gm
            return y.mean(0)
        sm=y.mean(0); sv=np.maximum((y*y).mean(0)-sm*sm,1e-8)
        y=(y-sm)*np.sqrt(gv/sv)+gm
        x=y
    return x.mean(0)

for w,d,k,ntrue,nnet in [(64,8,4096,300000,20),(128,8,4096,200000,10),(64,16,4096,300000,10),(128,16,4096,200000,5)]:
    print('case',w,d,k)
    errs={'cur':[],'diag':[],'rescale':[],'rescale_fg':[]}
    for i in range(nnet):
        rng=np.random.default_rng(1000+i)
        W=make_weights(w,d,rng)
        t,_=true_mc(W,n=ntrue,seed=2000+i,chunk=20000)
        for name,p in [('cur',current(W,k,3000)),('diag',diag_prop(W)),('rescale',layer_gauss_rescale(W,k,3000,'hidden')),('rescale_fg',layer_gauss_rescale(W,k,3000,'final_g'))]:
            errs[name].append(np.mean((p-t)**2))
    for name,v in errs.items(): print(name, np.mean(v), 'rmse', math.sqrt(np.mean(v)))

import numpy as np, math, time
INV=1/math.sqrt(2*math.pi)

def rmean(n): return math.sqrt(2)*math.exp(math.lgamma((n+1)/2)-math.lgamma(n/2))

def make_weights(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def true_mc(W,n=500000,seed=0,chunk=20000):
    rng=np.random.default_rng(seed); w=W[0].shape[0]; s=np.zeros(w,dtype=np.float64); done=0
    for st in range(0,n,chunk):
        k=min(chunk,n-st); x=rng.standard_normal((k,w)).astype(np.float32)
        for M in W: x=np.maximum(x@M,0)
        s+=x.sum(0); done+=k
    return s/done

def make_gauss(w,k,seed,whiten=True):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32)
    if whiten:
        cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T; u=(u@inv).astype(np.float32)
    return np.concatenate([u,-u],0)

def make_sphere(w,k,seed,whiten=False,scale='rmean'):
    rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w)).astype(np.float32)
    u=u/np.sqrt(np.sum(u*u,axis=1,keepdims=True))
    if scale=='rmean': c=rmean(w)
    elif scale=='sqrtw': c=math.sqrt(w)
    else: c=1.0
    u=(u*c).astype(np.float32)
    if whiten:
        cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T; u=(u@inv*c).astype(np.float32) # maybe wrong scale
    return np.concatenate([u,-u],0)

def propagate(W,samples,first_match=True,radial_factor=1.0):
    fw=W[0]
    first_var=np.sum(fw*fw,axis=0); first_mean=np.sqrt(first_var)*INV
    x=np.maximum(samples@fw,0)
    if first_match:
        sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
        target=first_var*(0.5-INV*INV)
        x=(x-sm)*np.sqrt(target/sv)+first_mean
        rf=1.0
    else:
        rf=radial_factor
    for M in W[1:]: x=np.maximum(x@M,0)
    return rf*x.mean(0)

def est(W,k,kind):
    w=W[0].shape[0]
    if kind=='gauss': return propagate(W,make_gauss(w,k,123,True),True)
    if kind=='gauss_nowhite': return propagate(W,make_gauss(w,k,123,False),True)
    if kind=='sphere_match': return propagate(W,make_sphere(w,k,123,False,'rmean'),True)
    if kind=='sphere_direct': return propagate(W,make_sphere(w,k,123,False,'rmean'),False,1.0)
    if kind=='sphere_sqrt_rf': return propagate(W,make_sphere(w,k,123,False,'sqrtw'),False,rmean(w)/math.sqrt(w))
    if kind=='sphere_sqrt_match': return propagate(W,make_sphere(w,k,123,False,'sqrtw'),True)

for w,d,k,ntrue,nnet in [(64,8,4096,400000,20),(128,8,4096,300000,12),(64,16,4096,400000,12),(128,16,4096,250000,6),(256,8,4096,150000,4)]:
    print('case',w,d,k,'rmean/sqrt',rmean(w)/math.sqrt(w))
    names=['gauss','gauss_nowhite','sphere_direct','sphere_sqrt_rf','sphere_match','sphere_sqrt_match']
    errs={n:[] for n in names}
    for i in range(nnet):
        W=make_weights(w,d,np.random.default_rng(1000+i))
        t=true_mc(W,ntrue,2000+i)
        for n in names:
            p=est(W,k,n); errs[n].append(np.mean((p-t)**2))
    for n in names: print(n, np.mean(errs[n]))

+        preactivation_variance = fnp.maximum(
+            preactivation_second - preactivation_mean * preactivation_mean,
+            1e-6,
+        )
+        preactivation_scale = fnp.sqrt(preactivation_variance)
+        standardized = preactivation_mean / preactivation_scale
+        cdf = 0.5 * (
+            1.0
+            + fnp.tanh(
+                _SQRT_2_OVER_PI
+                * (standardized + _GELU_CDF_CUBIC * standardized * standardized * standardized)
+            )
+        )
+        density = fnp.exp(-0.5 * standardized * standardized) * _INV_SQRT_2PI
+        gaussian_mean = preactivation_scale * density + preactivation_mean * cdf
+        final_mean = fnp.asarray(
+            final_mean + _FINAL_GAUSSIAN_BLEND * (gaussian_mean - final_mean),
+            dtype=fnp.float32,
+        )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


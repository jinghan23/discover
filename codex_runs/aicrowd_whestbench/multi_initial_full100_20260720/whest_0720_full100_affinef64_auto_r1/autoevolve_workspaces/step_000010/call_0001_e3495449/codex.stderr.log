INV=0.3989422804014327; TWO_PI=6.283185307179586
W=256; D=32; NT=120000; NMLP=2
rng=np.random.default_rng(321)

def sample_count(frac):
    B=272_000_000_000; w=W; d=D
    per=d*(2*w*w+w)+w*w; fixed=13*w**3
    k=(int(frac*B)-fixed)//per
    k=max(32,min(1000000,100*1024*1024//(w*8),k)); return int(k-(k&1))

def make_samples(k,seed):
    r=np.random.default_rng(seed); u=r.standard_normal((k//2,W), dtype=np.float32)
    cov=(u.T@u).astype(np.float64)/(k//2)
    ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T
    h=(u@inv).astype(np.float32)
    return np.concatenate([h,-h])

def first_mom(W0):
    cov=W0.T@W0; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV
    denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI
    ac=(second-mean[:,None]*mean[None,:]); return mean.astype(np.float32),((ac+ac.T)*.5).astype(np.float32),var.astype(np.float32)

def est(ws,samples,fac):
    fm,fc,fv=first_mom(ws[0])
    x=np.maximum(samples@ws[0],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*fac
    x=(x-sm)*np.sqrt(tv/sv)+fm
    sw=ws[1]; pre=x@sw; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
    tm=fm@sw; tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for ww in ws[2:]: x=np.maximum(x@ww,0)
    return x.astype(np.float64).mean(0).astype(np.float32)


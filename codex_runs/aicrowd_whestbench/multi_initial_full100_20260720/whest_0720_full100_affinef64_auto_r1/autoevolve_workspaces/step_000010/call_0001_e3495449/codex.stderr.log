import numpy as np, time
INV=0.3989422804014327; TWO_PI=6.283185307179586
W=160; D=24; K=12000; NT=180000; NMLP=5
rng=np.random.default_rng(444)

def make_samples(seed):
 r=np.random.default_rng(seed); u=r.standard_normal((K//2,W),dtype=np.float32); cov=(u.T@u).astype(np.float64)/(K//2); ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; h=(u@inv).astype(np.float32); return np.concatenate([h,-h])
samples=make_samples(1003)

def first_mom(W0):
 cov=W0.T@W0; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV; denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1); second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI; ac=second-mean[:,None]*mean[None,:]; return mean.astype(np.float32),((ac+ac.T)*.5).astype(np.float32),var.astype(np.float32)

def full_match(x,mean,target_cov,factor=1.0):
 sm=x.mean(0); xc=x-sm; sc=(xc.T@xc)/x.shape[0]; sc=(sc+sc.T)*.5
 evs,Us=np.linalg.eigh(sc.astype(np.float64)); evt,Vt=np.linalg.eigh((target_cov*factor).astype(np.float64)); evs=np.maximum(evs,1e-8); evt=np.maximum(evt,1e-9)
 A=(Us/np.sqrt(evs))@Us.T@(Vt*np.sqrt(evt))@Vt.T
 return (xc@A+mean).astype(np.float32)

def est(ws,mode,factor=1.0):
 fm,fc,fv=first_mom(ws[0]); x=np.maximum(samples@ws[0],0)
 if mode=='diag':
  sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*.99; x=(x-sm)*np.sqrt(tv/sv)+fm
 elif mode=='full':
  x=full_match(x,fm,fc,factor)
 elif mode=='full_diag_after':
  x=full_match(x,fm,fc,factor); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*.99; x=(x-sm)*np.sqrt(tv/sv)+fm
 sw=ws[1]; pre=x@sw; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@sw; tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7); x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
 for ww in ws[2:]: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def target(ws,seed):
 rr=np.random.default_rng(seed); s=np.zeros(W,dtype=np.float64); n=0; chunk=9000
 for st in range(0,NT,chunk):
  m=min(chunk,NT-st); x=rr.standard_normal((m,W),dtype=np.float32)
  for ww in ws: x=np.maximum(x@ww,0)
  s+=x.astype(np.float64).sum(0); n+=m
 return (s/n).astype(np.float32)
modes=[('diag',1),('full',1),('full',.99),('full',.98),('full_diag_after',1)]
errs={m:[] for m in modes}; t=time.time()
for i in range(NMLP):
 ws=[(rng.standard_normal((W,W))*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]

/bin/bash -lc "python - <<'PY'
import numpy as np, time
INV=0.3989422804014327; TWO_PI=6.283185307179586
W=160; D=24; K=12000; NT=160000; NMLP=4
rng=np.random.default_rng(333)

def whiten(u):
 cov=(u.T@u).astype(np.float64)/u.shape[0]; ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; return (u@inv).astype(np.float32)
def make(kind,seed):
 r=np.random.default_rng(seed); n=K//2
 if kind=='global':
  half=whiten(r.standard_normal((n,W),dtype=np.float32))
 elif kind=='plain':
  half=r.standard_normal((n,W),dtype=np.float32)
 elif kind.startswith('block'):
  b=int(kind[5:]); parts=[]; rem=n
  while rem>0:
   m=min(b,rem); parts.append(whiten(r.standard_normal((m,W),dtype=np.float32))); rem-=m
  half=np.concatenate(parts,0)
 elif kind=='sphere':
  u=r.standard_normal((n,W),dtype=np.float32); norm=np.sqrt((u*u).sum(1,keepdims=True)); half=u/np.maximum(norm,1e-12)*np.sqrt(W); half=whiten(half)
 elif kind=='radial':
  u=r.standard_normal((n,W),dtype=np.float32); norm=np.sqrt((u*u).sum(1,keepdims=True)); dirs=u/np.maximum(norm,1e-12); radii=np.sqrt(r.chisquare(W,size=(n,1))).astype(np.float32); half=whiten(dirs*radii)
 else: raise ValueError
 return np.concatenate([half,-half]).astype(np.float32)

def first_mom(W0):
 cov=W0.T@W0; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV; denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1); second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI; ac=second-mean[:,None]*mean[None,:]; return mean.astype(np.float32),((ac+ac.T)*.5).astype(np.float32),var.astype(np.float32)
def est(ws,samples):
 fm,fc,fv=first_mom(ws[0]); x=np.maximum(samples@ws[0],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*.99; x=(x-sm)*np.sqrt(tv/sv)+fm; sw=ws[1]; pre=x@sw; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@sw; tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7); x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0); 
 for ww in ws[2:]: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def target(ws,seed):
 rr=np.random.default_rng(seed); s=np.zeros(W,dtype=np.float64); chunk=8000; n=0
 for st in range(0,NT,chunk):
  m=min(chunk,NT-st); x=rr.standard_normal((m,W),dtype=np.float32)
  for ww in ws: x=np.maximum(x@ww,0)
  s+=x.astype(np.float64).sum(0); n+=m
 return (s/n).astype(np.float32)
kinds=['global','plain','block512','block1024','block2048','sphere','radial']
samps={k:make(k,1000+i) for i,k in enumerate(kinds)}
errs={k:[] for k in kinds}; t=time.time()
for i in range(NMLP):
 ws=[(rng.standard_normal((W,W))*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 y=target(ws,700+i); print('target',i,time.time()-t)
 for k in kinds:
  e=np.mean((est(ws,samps[k])-y)**2); errs[k].append(e)
 print({k:errs[k][-1] for k in kinds})
for k in kinds: print('mean',k,np.mean(errs[k]))

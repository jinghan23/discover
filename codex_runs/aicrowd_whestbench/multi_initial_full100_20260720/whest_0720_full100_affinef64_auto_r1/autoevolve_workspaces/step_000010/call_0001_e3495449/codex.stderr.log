import numpy as np
from scipy.special import ndtr
import time
INV=0.3989422804014327; TWO_PI=6.283185307179586
BUDGET=272_000_000_000; FRAC=.236; W=128; D=20
# scaled k as current formula for default budget? use same k formula with width/depth and scale budget proportional to w"'^2*d? just fixed k 15000
K=12000; NT=120000; NMLP=4
rng=np.random.default_rng(123)

def make_samples(w,k,seed):
    r=np.random.default_rng(seed)
    u=r.standard_normal((k//2,w), dtype=np.float32)
    cov=(u.T@u).astype(np.float64)/(k//2)
    evals,evecs=np.linalg.eigh(cov)
    inv=(evecs/np.sqrt(np.maximum(evals,1e-6)))@evecs.T
    h=(u@inv).astype(np.float32)
    return np.concatenate([h,-h],0)

def first_mom(W0):
    cov=W0.T@W0
    var=np.maximum(np.diag(cov),1e-30)
    scale=np.sqrt(var); mean=scale*INV
    denom=scale[:,None]*scale[None,:]
    corr=np.clip(cov/denom,-1,1)
    second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI
    acov=(second-mean[:,None]*mean[None,:]); acov=(acov+acov.T)*.5
    return mean.astype(np.float32),acov.astype(np.float32),var.astype(np.float32)

def est(weights,b):
    samples=make_samples(W,K,999)
    fm,fc,fv=first_mom(weights[0])
    x=np.maximum(samples@weights[0],0)
    sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6)
    tv=fv*(0.5-INV*INV)*0.99
    x=(x-sm)*np.sqrt(tv/sv)+fm
    sw=weights[1]
    pre=x@sw
    sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7)
    tm=fm@sw
    tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7)
    x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
    for ww in weights[2:-1]:
        x=np.maximum(x@ww,0)
    pre=x@weights[-1]
    emp=np.maximum(pre,0).mean(0)
    mu=pre.mean(0); var=np.maximum((pre*pre).mean(0)-mu*mu,1e-7); sig=np.sqrt(var); a=mu/sig
    gau=mu*ndtr(a)+sig*INV*np.exp(-0.5*a*a)
    return ((1-b)*emp+b*gau).astype(np.float32)

def target(weights):
    s=np.zeros(W,dtype=np.float64); n=0; rr=np.random.default_rng(777)
    chunk=10000

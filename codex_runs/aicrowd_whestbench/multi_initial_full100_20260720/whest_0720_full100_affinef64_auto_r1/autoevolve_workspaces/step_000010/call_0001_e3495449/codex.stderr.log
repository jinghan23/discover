import numpy as np, math, time
from scipy.special import gammaln
INV=0.3989422804014327; TWO_PI=6.283185307179586
W=256; D=32; K=14988; NT=300000; NMLP=5; RAD=math.sqrt(2)*math.exp(gammaln((W+1)/2)-gammaln(W/2)); rng=np.random.default_rng(1111)

def whiten(u):
 cov=(u.T@u).astype(np.float64)/u.shape[0]; ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; return (u@inv).astype(np.float32)
def make(kind,seed):
 r=np.random.default_rng(seed); u=r.standard_normal((K//2,W),dtype=np.float32)
 if kind=='current': h=whiten(u)
 elif kind=='current_norm':
  h=whiten(u); n=np.sqrt((h*h).sum(1,keepdims=True)); h=h/np.maximum(n,1e-12)*RAD
 elif kind=='raw_norm':
  n=np.sqrt((u*u).sum(1,keepdims=True)); h=u/np.maximum(n,1e-12)*RAD
 elif kind=='whiten_norm_whiten':
  h=whiten(u); n=np.sqrt((h*h).sum(1,keepdims=True)); h=h/np.maximum(n,1e-12)*math.sqrt(W); h=whiten(h)
 return np.concatenate([h,-h]).astype(np.float32)
samps={k:make(k,1003+i) for i,k in enumerate(['current','current_norm','raw_norm','whiten_norm_whiten'])}

def first_mom(W0):
 cov=W0.T@W0; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV; denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1); second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI; ac=second-mean[:,None]*mean[None,:]; return mean.astype(np.float32),((ac+ac.T)*.5).astype(np.float32),var.astype(np.float32)
def est_current_alg(ws,samples):
 fm,fc,fv=first_mom(ws[0]); x=np.maximum(samples@ws[0],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*.99; x=(x-sm)*np.sqrt(tv/sv)+fm; sw=ws[1]; pre=x@sw; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@sw; tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7); x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0)
 for ww in ws[2:]: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def forward(ws,samples):
 x=samples
 for ww in ws: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def target(ws,seed):
 rr=np.random.default_rng(seed); s=np.zeros(W,dtype=np.float64); n=0; chunk=10000
 for st in range(0,NT,chunk):
  m=min(chunk,NT-st); x=rr.standard_normal((m,W),dtype=np.float32)
  for ww in ws: x=np.maximum(x@ww,0)
  s+=x.astype(np.float64).sum(0); n+=m
 return (s/n).astype(np.float32)
keys=[]
for kind in samps:
 keys.append(('alg',kind)); keys.append(('raw',kind))
errs={k:[] for k in keys}; t=time.time()
for i in range(NMLP):
 ws=[(rng.standard_normal((W,W))*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 y=target(ws,1700+i); print('target',i,time.time()-t)
 for kind,s in samps.items():
  errs[('alg',kind)].append(np.mean((est_current_alg(ws,s)-y)**2))
  errs[('raw',kind)].append(np.mean((forward(ws,s)-y)**2))
 print({str(k):errs[k][-1] for k in keys})
for k in keys: print('mean',k,np.mean(errs[k]))

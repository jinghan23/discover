codex
A more promising structural observation: with no biases, the ReLU MLP is positively homogeneous, so Gaussian expectation separates into a radial mean times a uniform-sphere direction expectation. That means radial randomness is pure variance for the final mean. I’m testing a sphere-direction estimator against the current hybrid.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, time, math
INV=0.3989422804014327; TWO_PI=6.283185307179586
W=256; D=32; K=14988; NT=300000; NMLP=5
rng=np.random.default_rng(777)
# E chi_w approx; exact via scipy gammaln
from scipy.special import gammaln
RAD=math.sqrt(2)*math.exp(gammaln((W+1)/2)-gammaln(W/2))
print('rad',RAD,'sqrt',math.sqrt(W))

def make_current(seed):
 r=np.random.default_rng(seed); u=r.standard_normal((K//2,W),dtype=np.float32); cov=(u.T@u).astype(np.float64)/(K//2); ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; h=(u@inv).astype(np.float32); return np.concatenate([h,-h])
def make_sphere(seed, whiten=False, scale=RAD):
 r=np.random.default_rng(seed); u=r.standard_normal((K//2,W),dtype=np.float32); n=np.sqrt((u*u).sum(1,keepdims=True)); h=u/np.maximum(n,1e-12)*scale
 if whiten:
  cov=(h.T@h).astype(np.float64)/(K//2); ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; h=(h@inv*(scale/math.sqrt(W))).astype(np.float32) # restore covariance scale E[R]"'^2/w? maybe
 return np.concatenate([h,-h]).astype(np.float32)
cur_samp=make_current(1003); sph=make_sphere(2003,False); sphw=make_sphere(2003,True)

def first_mom(W0):
 cov=W0.T@W0; var=np.maximum(np.diag(cov),1e-30); scale=np.sqrt(var); mean=scale*INV; denom=scale[:,None]*scale[None,:]; corr=np.clip(cov/denom,-1,1); second=denom*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-np.arccos(corr))*corr)/TWO_PI; ac=second-mean[:,None]*mean[None,:]; return mean.astype(np.float32),((ac+ac.T)*.5).astype(np.float32),var.astype(np.float32)
def est_current(ws):
 samples=cur_samp; fm,fc,fv=first_mom(ws[0]); x=np.maximum(samples@ws[0],0); sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-6); tv=fv*(.5-INV*INV)*.99; x=(x-sm)*np.sqrt(tv/sv)+fm; sw=ws[1]; pre=x@sw; sm=pre.mean(0); sv=np.maximum((pre*pre).mean(0)-sm*sm,1e-7); tm=fm@sw; tv=np.maximum(np.sum(sw*(fc@sw),axis=0),1e-7); x=np.maximum((pre-sm)*np.sqrt(tv/sv)+tm,0);
 for ww in ws[2:]: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def est_forward(ws,samples):
 x=samples
 for ww in ws: x=np.maximum(x@ww,0)
 return x.astype(np.float64).mean(0).astype(np.float32)
def target(ws,seed):
 rr=np.random.default_rng(seed); s=np.zeros(W,dtype=np.float64); n=0; chunk=10000
 for st in range(0,NT,chunk):
  m=min(chunk,NT-st); x=rr.standard_normal((m,W),dtype=np.float32)
  for ww in ws: x=np.maximum(x@ww,0)
  s+=x.astype(np.float64).sum(0); n+=m
 return (s/n).astype(np.float32)
errs={k:[] for k in ['"'current','sphere','spherew','gauss_plain']}; gauss_plain=np.random.default_rng(3003).standard_normal((K,W),dtype=np.float32)
t=time.time()
for i in range(NMLP):
 ws=[(rng.standard_normal((W,W))*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 y=target(ws,1300+i); print('target',i,time.time()-t)
 preds={'current':est_current(ws),'sphere':est_forward(ws,sph),'spherew':est_forward(ws,sphw),'gauss_plain':est_forward(ws,gauss_plain)}
 for k,p in preds.items(): errs[k].append(np.mean((p-y)**2))
 print({k:errs[k][-1] for k in errs})
for k in errs: print('mean',k,np.mean(errs[k]))

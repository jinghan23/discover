    def predict(self, mlp, budget: int) -> fnp.ndarray:
        n_samples = _sample_count(budget, mlp.width, mlp.depth)
        half_samples = n_samples // 2
        exact_first_mean = _exact_first_layer_mean(mlp.weights[0])
        radius_mean = _mean_chi(mlp.width)

        if (
            hasattr(self, "_direction_pool")
            and mlp.width == self._setup_width
            and half_samples == self._setup_half_samples
            and self._direction_pool
        ):
            best_error = None
            best_activations = None
            best_sample_mean = None
            for half_directions, whitening in self._direction_pool:
                paired_directions = fnp.concatenate(
                    (half_directions, -half_directions), axis=0
                )
                candidate_inputs = paired_directions * radius_mean
                first_weight = whitening @ mlp.weights[0]
                candidate_activations = fnp.maximum(
                    candidate_inputs @ first_weight, 0.0
                )
                candidate_mean = fnp.mean(candidate_activations, axis=0)
                if len(self._direction_pool) == 1:
                    best_activations = candidate_activations
                    best_sample_mean = candidate_mean
                    break
                mean_error = float(
                    fnp.mean(
                        (candidate_mean - exact_first_mean)
                        * (candidate_mean - exact_first_mean)
                    )
                )
                if best_error is None or mean_error < best_error:
                    best_error = mean_error
                    best_activations = candidate_activations
                    best_sample_mean = candidate_mean
            activations = best_activations
            first_sample_mean = best_sample_mean
        else:
            rng = fnp.random.default_rng(int(mlp.seed))
            half_directions = _lattice_half_directions(half_samples, mlp.width, rng)
            whitening = _angular_whitening_transform(half_directions)
            first_weight = whitening @ mlp.weights[0]
            paired_directions = fnp.concatenate((half_directions, -half_directions), axis=0)
            activations = paired_directions * radius_mean
            activations = fnp.maximum(activations @ first_weight, 0.0)
            first_sample_mean = fnp.mean(activations, axis=0)

        rows = []
        rows.append(exact_first_mean)

        first_activations = activations
        first_mean_correction = exact_first_mean - first_sample_mean
        mean_correction = first_mean_correction
        for layer_index, weights in enumerate(mlp.weights[1:], start=1):
            preactivations = activations @ weights
            gate_mean = fnp.mean(preactivations > 0.0, axis=0)
            activations = fnp.maximum(preactivations, 0.0)
            mean_correction = (mean_correction @ weights) * gate_mean
            base_row = fnp.mean(activations, axis=0)
            corrected_row = base_row + _GATE_MEAN_CORRECTION * mean_correction
            if _SAMPLE_GAUSSIAN_BLEND != 0.0:
                pre_mean = fnp.mean(preactivations, axis=0)
                pre_variance = fnp.maximum(
                    fnp.mean(preactivations * preactivations, axis=0)
                    - pre_mean * pre_mean,
                    1e-24,
                )
                smoothed_row = (
                    _relu_gaussian_mean(pre_mean, pre_variance)
                    + _GATE_MEAN_CORRECTION * mean_correction
                )
                corrected_row = (
                    (1.0 - _SAMPLE_GAUSSIAN_BLEND) * corrected_row
                    + _SAMPLE_GAUSSIAN_BLEND * smoothed_row
                )
            rows.append(corrected_row)

            if layer_index == mlp.depth - 1 and _FIRST_LAYER_CV_BLEND != 0.0:
                centered_first = first_activations - first_sample_mean
                centered_final = activations - base_row
                covariance_scale = 1.0 / float(n_samples)
                control_gram = centered_first.T @ centered_first * covariance_scale
                control_cross = centered_first.T @ centered_final * covariance_scale
                ridge = _FIRST_LAYER_CV_RIDGE * fnp.mean(fnp.diag(control_gram))
                coefficients = fnp.linalg.solve(
                    control_gram + fnp.eye(mlp.width) * ridge,
                    control_cross,
                )
                cv_row = base_row + first_mean_correction @ coefficients
                rows[-1] = (
                    (1.0 - _FIRST_LAYER_CV_BLEND) * rows[-1]
                    + _FIRST_LAYER_CV_BLEND * cv_row
                )

        qmc_rows = fnp.stack(rows, axis=0)
        analytic_rows = _linearized_gaussian_rows(mlp.weights, mlp.width)


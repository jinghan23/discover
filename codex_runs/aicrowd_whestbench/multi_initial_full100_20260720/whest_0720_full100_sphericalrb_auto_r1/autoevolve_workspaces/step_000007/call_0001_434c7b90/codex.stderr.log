+        first_sample_mean = fnp.mean(first_activations, axis=0)
+        first_mean_correction = exact_first_mean - first_sample_mean
+        mean_correction = first_mean_correction
+        for layer_index, weights in enumerate(mlp.weights[1:], start=1):
             preactivations = activations @ weights
+            pre_mean = fnp.mean(preactivations, axis=0)
+            pre_variance = fnp.maximum(
+                fnp.mean(preactivations * preactivations, axis=0) - pre_mean * pre_mean,
+                1e-24,
+            )
             gate_mean = fnp.mean(preactivations > 0.0, axis=0)
             activations = fnp.maximum(preactivations, 0.0)
             mean_correction = (mean_correction @ weights) * gate_mean
             base_row = fnp.mean(activations, axis=0)
-            rows.append(base_row + _GATE_MEAN_CORRECTION * mean_correction)
+            corrected_row = base_row + _GATE_MEAN_CORRECTION * mean_correction
+            if _SAMPLE_GAUSSIAN_BLEND != 0.0:
+                smoothed_row = (
+                    _relu_gaussian_mean(pre_mean, pre_variance)
+                    + _GATE_MEAN_CORRECTION * mean_correction
+                )
+                corrected_row = (
+                    (1.0 - _SAMPLE_GAUSSIAN_BLEND) * corrected_row
+                    + _SAMPLE_GAUSSIAN_BLEND * smoothed_row
+                )
+            rows.append(corrected_row)

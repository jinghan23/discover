from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from whestbench.sdk import SetupContext
import submission

# quick proxy across public profiler sizes; uses generated data only.
for width, depth, budget, n_truth, n_mlps in [
    (64, 32, int(1e8), 200000, 3),

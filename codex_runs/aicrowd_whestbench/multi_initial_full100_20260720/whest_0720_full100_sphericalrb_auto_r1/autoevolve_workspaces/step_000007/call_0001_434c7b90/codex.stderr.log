/bin/bash -lc "python - <<'PY'
import time, math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from whestbench.sdk import SetupContext
import submission
flops.configure(symmetry_warnings=False)

width=128; depth=32; budget=10**11; n_truth=500_000; n_mlps=8
mlps=[]; finals=[]
print('generating targets')
t=time.time()
for i in range(n_mlps):
    ss=fnp.random.SeedSequence(9000+i).spawn(3)
    mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[0]),seed=int(ss[2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,n_truth,fnp.random.default_rng(ss[1]))
    mlps.append(mlp); finals.append(final)
print('targets_s',time.time()-t)

def eval_params(gate, blend, shifts=2, frac=0.1024, offset=0):
    submission._GATE_MEAN_CORRECTION=gate
    submission._ANALYTIC_BLEND=blend
    submission._QMC_SHIFTS=shifts
    submission._TARGET_FLOP_FRACTION=frac
    submission._SETUP_SEED_OFFSET=offset
    est=submission.Estimator(); est.setup(SetupContext(width,depth,budget,'x',seed=1234))
    ms=[]
    for mlp, final in zip(mlps, finals):
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True):
            pred=est.predict(mlp,budget)
        ms.append(float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2)))
    return sum(ms)/len(ms), ms

results=[]
for gate in [0.85,1.0,1.08,1.13,1.18,1.25,1.35]:
  for blend in [0.0,0.025,0.05,0.075,0.10,0.15]:
    mean,ms=eval_params(gate,blend)
    results.append((mean,gate,blend,2,ms))
    print('grid',gate,blend,mean)
print('top correction')
for r in sorted(results)[:10]: print(r[:4])

best_gate=sorted(results)[0][1]; best_blend=sorted(results)[0][2]
for shifts in [1,2,3,4,6,8]:
    mean,ms=eval_params(best_gate,best_blend,shifts=shifts)
    print('shifts',shifts,mean,ms)
for frac in [0.085,0.09,0.095,0.1,0.1024,0.105,0.11,0.12,0.14]:
    mean,ms=eval_params(best_gate,best_blend,shifts=2,frac=frac)
    print('frac',frac,'samples',submission._sample_count(budget,width,depth),'mse',mean)

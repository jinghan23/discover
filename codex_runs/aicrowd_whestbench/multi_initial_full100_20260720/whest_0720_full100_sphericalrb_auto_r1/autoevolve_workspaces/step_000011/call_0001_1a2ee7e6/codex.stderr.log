# Compact synthetic: avg correction at n vs pathwise at n/2.
# Uses one moderate case to decide whether an official run is worth spending.
import math, numpy as np
from scipy.special import ndtri
TAIL=1e-9; EIGF=1e-8

def ggold(w):
 r=2.; e=1/(w+1.)
 for _ in range(40): r=(1+r)**e
 inv=1/r; a=[]; v=inv
 for _ in range(w): a.append(v); v*=inv
 return np.array(a)
def dirs(half,w,rng):
 g=ggold(w); out=[]; base=half//2; rem=half-base*2
 for i in range(2):
  n=base+(i<rem); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
  z=ndtri(np.clip(u,TAIL,1-TAIL)); out.append(z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None])
 return np.concatenate(out)
def wh(d):
 n,w=d.shape; vals,vecs=np.linalg.eigh(d.T@d*(w/n)); vals=np.maximum(vals,EIGF); return (vecs/np.sqrt(vals))@vecs.T
def mchi(d):
 hd=.5*d; return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))
def ef(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def pred(ws,n,seed,mode,c):
 w=ws[0].shape[0]; rng=np.random.default_rng(seed); h=dirs(n//2,w,rng); T=wh(h)
 a=np.concatenate([h,-h])*mchi(w); a=np.maximum(a@(T@ws[0]),0); corr=ef(ws[0])-a.mean(0)
 if mode=='path': delta=np.zeros_like(a)+corr[None,:]
 for W in ws[1:]:
  pre=a@W; gate=pre>0; a=np.maximum(pre,0)
  if mode=='avg': corr=(corr@W)*gate.mean(0)
  else: delta=(delta@W)*gate
 return a.mean(0)+(c*(corr if mode=='avg' else delta.mean(0)))
def targ(ws,ns,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<ns:
  n=min(25000,ns-done); x=rng.standard_normal((n,w))
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/ns
def run(width,depth,n,nmlp,mc):
 rng=np.random.default_rng(9); scale=math.sqrt(2/width); ea=[]; ep=[]
 for k in range(nmlp):
  ws=[rng.standard_normal((width,width))*scale for _ in range(depth)]; t=targ(ws,mc,100+k)
  ea.append(((pred(ws,n,300+k,'avg',0.95)-t)**2).mean())
  ep.append(((pred(ws,n//2,300+k,'path',1.1)-t)**2).mean())
 print(width,depth,'avg n',n,np.mean(ea),'path n/2',np.mean(ep))
run(64,8,512,6,200000)
run(64,16,512,4,160000)
run(128,8,256,3,100000)

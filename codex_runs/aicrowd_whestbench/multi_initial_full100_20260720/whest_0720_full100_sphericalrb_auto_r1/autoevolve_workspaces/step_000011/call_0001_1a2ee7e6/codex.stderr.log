/bin/bash -lc "python - <<'PY'
# Synthetic check for pathwise correction vs average-gate correction.
import math, time
import numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIGF=1e-8

def gen_golden(w):
    r=2.0; e=1/(w+1)
    for _ in range(40): r=(1+r)**e
    inv=1/r; out=[]; v=inv
    for _ in range(w): out.append(v); v*=inv
    return np.array(out)

def dirs(half,w,rng):
    g=gen_golden(w); blocks=[]; base=half//2; rem=half-base*2
    for i in range(2):
        n=base+(i<rem); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
        z=ndtri(np.clip(u,TAIL,1-TAIL)); rr=np.sqrt(np.maximum((z*z).sum(1),1e-24)); blocks.append(z/rr[:,None])
    return np.concatenate(blocks)

def whiten(d):
    n,w=d.shape; vals,vecs=np.linalg.eigh(d.T@d*(w/n)); vals=np.maximum(vals,EIGF)
    return (vecs/np.sqrt(vals))@vecs.T

def mean_chi(d):
    hd=.5*d; return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))

def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def pred(ws,n,seed,mode='avg',c=0.95):
    w=ws[0].shape[0]; rng=np.random.default_rng(seed); h=dirs(n//2,w,rng); T=whiten(h)
    a=np.concatenate([h,-h])*mean_chi(w); a=np.maximum(a@(T@ws[0]),0); ef=exact_first(ws[0]); rows=[ef]
    mc=ef-a.mean(0)
    if mode=='path': delta=np.zeros_like(a)+mc[None,:]
    for W in ws[1:]:
        pre=a@W; gate=pre>0; a=np.maximum(pre,0); base=a.mean(0)
        if mode=='avg':
            mc=(mc@W)*gate.mean(0); rows.append(base+c*mc)
        elif mode=='path':
            delta=(delta@W)*gate; rows.append(base+c*delta.mean(0))
        elif mode=='none': rows.append(base)
    return np.stack(rows)

def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; sums=np.zeros((len(ws),w)); done=0
    while done<ns:
        n=min(25000,ns-done); x=rng.standard_normal((n,w))

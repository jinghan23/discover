# Local comparison of linearized off-diagonal covariance vs zero-mean ReLU covariance in analytic blend.
import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIGF=1e-8

def zero_cov(pre):
 var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); sc=sd[:,None]*sd[None,:]
 corr=np.clip(pre/sc,-1,1); sec=sc*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
 m=sd/math.sqrt(2*math.pi); return sec-m[:,None]*m[None,:]
def analytic(ws,mode):
 w=ws[0].shape[0]; mean=np.zeros(w); cov=np.eye(w); rows=[]; c=1/math.sqrt(2*math.pi)
 for li,W in enumerate(ws):
  pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); st=pm/sd
  gate=norm.cdf(st); dens=np.exp(-.5*st*st)*c
  nm=sd*dens+pm*gate; sec=((pm*pm+var)*gate+pm*sd*dens); nv=np.maximum(sec-nm*nm,1e-24)
  if li==0 or mode=='zero':
   zc=zero_cov(pc); cov=zc+np.diag(nv-np.diag(zc))
  else:
   lc=pc*gate[:,None]*gate[None,:]; cov=lc+np.diag(nv-np.diag(lc))
  mean=nm; rows.append(nm)
 return np.stack(rows)
def ggold(w):
 r=2.; e=1/(w+1.)
 for _ in range(40): r=(1+r)**e
 inv=1/r; out=[]; v=inv
 for _ in range(w): out.append(v); v*=inv
 return np.array(out)
def dirs(half,w,rng):
 g=ggold(w); out=[]; base=half//2; rem=half-base*2
 for i in range(2):
  n=base+(i<rem); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
  z=ndtri(np.clip(u,TAIL,1-TAIL)); out.append(z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None])
 return np.concatenate(out)
def wh(d):
 n,w=d.shape; vals,vecs=np.linalg.eigh(d.T@d*(w/n)); vals=np.maximum(vals,EIGF); return (vecs/np.sqrt(vals))@vecs.T
def mchi(d):
 hd=.5*d; return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))
def ef(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def qmc(ws,n,seed,gc=.95):
 w=ws[0].shape[0]; rng=np.random.default_rng(seed); h=dirs(n//2,w,rng); T=wh(h)
 a=np.concatenate([h,-h])*mchi(w); a=np.maximum(a@(T@ws[0]),0); rows=[ef(ws[0])]; corr=rows[0]-a.mean(0)
 for W in ws[1:]:
  pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(a.mean(0)+gc*corr)
 return np.stack(rows)
def target(ws,ns,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros((len(ws),w)); done=0
 while done<ns:
  n=min(25000,ns-done); x=rng.standard_normal((n,w))
  for i,W in enumerate(ws): x=np.maximum(x@W,0); s[i]+=x.sum(0)
  done+=n
 return s/ns
def run(width,depth,n,nmlp,mc):
 rng=np.random.default_rng(77); scale=math.sqrt(2/width); print('case',width,depth,n)
 errs={'lin':[],'zero':[]}
 for k in range(nmlp):
  ws=[rng.standard_normal((width,width))*scale for _ in range(depth)]; tg=target(ws,mc,10+k); q=qmc(ws,n,20+k)
  for m in errs:
   p=.932*q+.068*analytic(ws,m); errs[m].append(((p[-1]-tg[-1])**2).mean())
 print({m:float(np.mean(v)) for m,v in errs.items()})
run(32,8,512,8,300000)
run(64,8,512,4,200000)
run(64,16,512,3,160000)

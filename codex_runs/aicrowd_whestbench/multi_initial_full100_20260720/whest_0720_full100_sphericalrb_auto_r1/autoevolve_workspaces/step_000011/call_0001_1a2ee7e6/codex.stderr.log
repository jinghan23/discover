import math, time
import numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIGF=1e-8

def gen_golden(w):
    r=2.0; e=1.0/(w+1.0)
    for _ in range(40): r=(1+r)**e
    inv=1/r; vals=[]; v=inv
    for _ in range(w): vals.append(v); v*=inv
    return np.array(vals)

def dirs(half,w,rng,shifts=2):
    g=gen_golden(w); blocks=[]; base=half//shifts; rem=half-base*shifts
    for s in range(shifts):
        n=base+(s<rem); sh=rng.random(w); idx=np.arange(n)[:,None]
        u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL)
        z=ndtri(u); rr=np.sqrt(np.maximum((z*z).sum(1),1e-24)); blocks.append(z/rr[:,None])
    return np.concatenate(blocks)

def whiten(d):
    n,w=d.shape; vals,vecs=np.linalg.eigh(d.T@d*(w/n)); vals=np.maximum(vals,EIGF)
    return (vecs/np.sqrt(vals))@vecs.T

def mean_chi(d):
    hd=.5*d; return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))

def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def zero_cov(pre):
    var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    sec=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    m=sd/math.sqrt(2*math.pi); return sec-m[:,None]*m[None,:]

def lin(weights):
    w=weights[0].shape[0]; mean=np.zeros(w); cov=np.eye(w); rows=[]; c=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); st=pm/sd
        gate=norm.cdf(st); dens=np.exp(-.5*st*st)*c
        nm=sd*dens+pm*gate; sec=((pm*pm+var)*gate+pm*sd*dens); nv=np.maximum(sec-nm*nm,1e-24)
        if li==0: cov=zero_cov(pc)
        else:
            lc=pc*gate[:,None]*gate[None,:]; cov=lc+np.diag(nv-np.diag(lc))
        mean=nm; rows.append(nm)
    return np.stack(rows)

def pred(weights,n,seed,gc,bl,mode='corr'):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); h=dirs(n//2,w,rng,2); T=whiten(h)
    a=np.concatenate([h,-h])*mean_chi(w); a=np.maximum(a@(T@weights[0]),0)
    ef=exact_first(weights[0]); rows=[ef]
    mc=ef-a.mean(0)
    for W in weights[1:]:
        pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); base=a.mean(0)
        if mode=='corr':
            mc=(mc@W)*gate; rows.append(base+gc*mc)
        elif mode=='nocorr': rows.append(base)
    q=np.stack(rows)
    if bl: q=(1-bl)*q+bl*lin(weights)
    return q

def target(weights,ns,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; sums=np.zeros((len(weights),w)); done=0; chunk=20000
    while done<ns:
        n=min(chunk,ns-done); x=rng.standard_normal((n,w))
        for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
        done+=n
    return sums/ns

def sweep(width,depth,n,nmlp,mc):
    rng=np.random.default_rng(321); scale=math.sqrt(2/width); cases=[]
    t=time.time()
    for k in range(nmlp):
        ws=[rng.standard_normal((width,width))*scale for _ in range(depth)]
        cases.append((ws,target(ws,mc,7000+k)))
    print('case',width,depth,n,'target_time',round(time.time()-t,2))
    variants=[]
    for gc in [0.7,0.9,1.0,1.05,1.1,1.2,1.4,1.8]:
        for bl in [0,0.02,0.04,0.06,0.068,0.08,0.1,0.14,0.2]: variants.append((gc,bl,'corr'))
    variants += [(0,bl,'nocorr') for bl in [0,0.04,0.068,0.1,0.2]]
    res=[]
    for v in variants:
        errs=[]
        for k,(ws,tg) in enumerate(cases):
            p=pred(ws,n,9000+k,v[0],v[1],v[2])
            errs.append(((p[-1]-tg[-1])**2).mean())
        res.append((np.mean(errs),v))
    res.sort(key=lambda x:x[0])
    for e,v in res[:15]: print(e,v)
    cur=(1.05,0.068,'corr')
    for i,(e,v) in enumerate(res):
        if v==cur: print('current',i,e); break

sweep(64,8,512,4,200000)
sweep(64,16,512,3,160000)

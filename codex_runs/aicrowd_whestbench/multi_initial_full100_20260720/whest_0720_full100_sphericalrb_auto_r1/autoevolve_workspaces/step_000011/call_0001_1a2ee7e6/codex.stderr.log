QMC_SHIFTS=2

def gen_golden(width):
    ratio=2.0; exponent=1.0/(width+1.0)
    for _ in range(40): ratio=(1+ratio)**exponent
    inv=1.0/ratio
    vals=[]; v=inv
    for _ in range(width): vals.append(v); v*=inv
    return np.array(vals,dtype=np.float64)

def lattice_normals(n,width,rng):
    g=gen_golden(width)
    shift=rng.random(width)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*g[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    return ndtri(u)

def qmc_dirs(n,width,rng):
    z=lattice_normals(n,width,rng)
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def lattice_half(half,width,rng,shifts=2):
    base=half//shifts; rem=half-base*shifts
    return np.concatenate([qmc_dirs(base+(i<rem),width,rng) for i in range(shifts)],axis=0)

def whitening(dirs):
    n,w=dirs.shape
    m=dirs.T@dirs*(w/n)
    vals, vecs=np.linalg.eigh(m)
    vals=np.maximum(vals,EIGF)
    return (vecs/np.sqrt(vals))@vecs.T

def mean_chi(d):
    hd=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(hd+0.5)-math.lgamma(hd))

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def zero_cov(pre):
    var=np.maximum(np.diag(pre),1e-24)
    sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    second=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    mean=sd/math.sqrt(2*math.pi)
    return second-mean[:,None]*mean[None,:]

def lin_rows(weights,width):
    mean=np.zeros(width,dtype=np.float64)
    cov=np.eye(width,dtype=np.float64)
    rows=[]; normc=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W
        var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); std=pm/sd
        gate=norm.cdf(std); dens=np.exp(-0.5*std*std)*normc
        nm=sd*dens+pm*gate
        sec=((pm*pm+var)*gate+pm*sd*dens)
        nv=np.maximum(sec-nm*nm,1e-24)
        if li==0: cov=zero_cov(pc)
        else:
            lc=pc*gate[:,None]*gate[None,:]
            cov=lc+np.diag(nv-np.diag(lc))
        mean=nm; rows.append(mean)
    return np.stack(rows)

def pred(weights,n,seed,gate_c=1.05,blend=0.068,mode='corr',shifts=2,whiten=True):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    half=n//2
    hd=lattice_half(half,width,rng,shifts)
    T=whitening(hd) if whiten else np.eye(width)
    paired=np.concatenate([hd,-hd],axis=0)
    act=paired*mean_chi(width)
    rows=[]
    act=np.maximum(act@(T@weights[0]),0)
    ef=exact_first(weights[0]); rows.append(ef)
    if mode=='none':
        mean_corr=np.zeros(width)
    else:
        mean_corr=ef-act.mean(axis=0)
    if mode=='add_first':
        act=act+mean_corr
    elif mode=='scale_first':
        sm=act.mean(axis=0); act=act*(ef/np.maximum(sm,1e-12))
        mean_corr=np.zeros(width)
    for W in weights[1:]:
        pre=act@W
        gate=(pre>0).mean(axis=0)
        act=np.maximum(pre,0)
        if mode=='corr':
            mean_corr=(mean_corr@W)*gate
            row=act.mean(axis=0)+gate_c*mean_corr
        else:
            row=act.mean(axis=0)
        rows.append(row)
    q=np.stack(rows)
    if blend:
        a=lin_rows(weights,width)
        q=(1-blend)*q+blend*a
    return q

def target(weights,nsamp=500000,seed=999,chunk=50000):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]; d=len(weights)
    sums=np.zeros((d,w),dtype=np.float64)
    done=0
    while done<nsamp:
        n=min(chunk,nsamp-done)
        x=rng.standard_normal((n,w)).astype(np.float64)
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(axis=0)
        done+=n
    return sums/nsamp

def run(width=32,depth=8,n=512,nmlp=8,mc=300000):
    rng=np.random.default_rng(123)
    Ws=[]; tg=[]
    scale=math.sqrt(2/width)
    t0=time.time()
    for k in range(nmlp):
        weights=[rng.standard_normal((width,width)).astype(np.float64)*scale for _ in range(depth)]
        Ws.append(weights); tg.append(target(weights,mc,seed=1000+k,chunk=50000))
    print('targets',time.time()-t0)
    variants=[]
    for gc in [0,0.5,0.9,1.0,1.05,1.1,1.2,1.4]:
      for bl in [0,0.03,0.05,0.068,0.09,0.12,0.18]:
        variants.append(('corr',gc,bl,2,True))
    for mode in ['none','add_first','scale_first']:
      for bl in [0,0.03,0.068,0.12]: variants.append((mode,0,bl,2,True))
    for shifts in [1,2,4,8]: variants.append(('corr',1.05,0.068,shifts,True))
    for wh in [False]: variants.append(('corr',1.05,0.068,2,wh))
    res=[]
    for var in variants:
        errs=[]
        for k,weights in enumerate(Ws):
            p=pred(weights,n,seed=2000+k,gate_c=var[1],blend=var[2],mode=var[0],shifts=var[3],whiten=var[4])
            errs.append(np.mean((p[-1]-tg[k][-1])**2))
        res.append((np.mean(errs),var))
    res.sort(key=lambda x:x[0])
    for e,v in res[:20]: print(e,v)
    print('current rank', [i for i,(e,v) in enumerate(res) if v==('corr',1.05,0.068,2,True)][:1])


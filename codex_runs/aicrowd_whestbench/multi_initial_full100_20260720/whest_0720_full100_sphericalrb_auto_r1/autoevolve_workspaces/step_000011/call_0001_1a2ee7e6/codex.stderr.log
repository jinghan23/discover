# Local random-rotation check for the spherical lattice.
import math, numpy as np
from scipy.special import ndtri
TAIL=1e-9; EIGF=1e-8

def ggold(w):
 r=2.; e=1/(w+1.)
 for _ in range(40): r=(1+r)**e

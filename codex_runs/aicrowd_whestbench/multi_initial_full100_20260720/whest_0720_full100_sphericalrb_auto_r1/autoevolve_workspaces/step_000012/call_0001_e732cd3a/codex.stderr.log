import time, math
import numpy as np

TARGET_FRACTION=0.096
TAIL=1e-9
QMC_SHIFTS=2

def sample_count(budget,width,depth):
    half_lattice_per_sample=(89*width+3*width+2)//2
    layer_per_sample=depth*(2*width*width+2*width)
    cov_per_sample=width*width
    per=half_lattice_per_sample+layer_per_sample+cov_per_sample
    fixed=13*width**3+8*width
    bl=(int(TARGET_FRACTION*budget)-fixed)//max(per,1)
    mem=100*1024*1024//max(width*8,1)
    cnt=max(32,min(bl,mem))
    return int(cnt)-(int(cnt)&1)

def gen(width):
    ratio=2.0; exp=1.0/(width+1.0)
    for _ in range(40): ratio=(1+ratio)**exp
    inv=1/ratio
    vals=[]; v=inv
    for _ in range(width): vals.append(v); v*=inv
    return np.array(vals)

def norm_ppf(u):
    # use scipy if available
    from scipy.stats import norm
    return norm.ppf(u)

def dirs(n,width,rng):
    g=gen(width); idx=np.arange(n)[:,None].astype(float); shift=rng.random(width)
    u=(idx*g[None,:]+shift[None,:])%1.0
    z=norm_ppf(np.clip(u,TAIL,1-TAIL))
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def half_dirs(half,width,rng):
    base=half//QMC_SHIFTS; rem=half-base*QMC_SHIFTS
    return np.concatenate([dirs(base+(i<rem),width,rng) for i in range(QMC_SHIFTS)],0)

def whiten(D):
    n,w=D.shape
    M=D.T@D*(w/n)
    ev,V=np.linalg.eigh(M)
    ev=np.maximum(ev,1e-8)
    return (V/np.sqrt(ev))@V.T

def mean_chi(d):
    return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def zero_cov(pre):
    var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    second=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    mean=sd/math.sqrt(2*math.pi)
    return second-mean[:,None]*mean[None,:]

def analytic(weights,width):
    from scipy.stats import norm
    mean=np.zeros(width,dtype=np.float64); cov=np.eye(width,dtype=np.float64); rows=[]; normalizer=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pre_mean=mean@W; pre_cov=W.T@cov@W; var=np.maximum(np.diag(pre_cov),1e-24); sd=np.sqrt(var); st=pre_mean/sd
        gate=norm.cdf(st); dens=np.exp(-0.5*st*st)*normalizer
        nxt=sd*dens+pre_mean*gate
        second=(pre_mean*pre_mean+var)*gate+pre_mean*sd*dens
        nv=np.maximum(second-nxt*nxt,1e-24)
        if li==0: cov=zero_cov(pre_cov)
        else:
            lin=pre_cov*gate[:,None]*gate[None,:]
            cov=lin+np.diag(nv-np.diag(lin))
        mean=nxt; rows.append(mean)
    return np.stack(rows)

def pred(weights, seed, state_shift=0.0, corrcoef=0.94, blend=0.065, n=128):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2; D=half_dirs(half,width,rng); Wh=whiten(D); D=D@Wh
    X=np.concatenate([D,-D],0)*mean_chi(width)
    rows=[]; A=np.maximum(X@weights[0],0); ex=exact_first(weights[0]); rows.append(ex)
    corr=ex-A.mean(0)
    if state_shift:
        A=A+state_shift*corr[None,:]
        corr=(1-state_shift)*corr
    for W in weights[1:]:
        pre=A@W; gate=(pre>0).mean(0); A=np.maximum(pre,0)
        corr=(corr@W)*gate
        base=A.mean(0); row=base+corrcoef*corr; rows.append(row)
        if state_shift:
            A=A+state_shift*corr[None,:]
            corr=(1-state_shift)*corr
    q=np.stack(rows); an=analytic(weights,width)
    return (1-blend)*q+blend*an

def target(weights, n=200000, batch=20000, seed=123):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; depth=len(weights); sums=[np.zeros(width) for _ in range(depth)]; done=0
    while done<n:
        b=min(batch,n-done); X=rng.standard_normal((b,width)).astype(np.float64)
        for i,W in enumerate(weights):
            X=np.maximum(X@W,0)
            sums[i]+=X.sum(0)
        done+=b
    return np.stack([s/n for s in sums])

for width,depth,budget,nmlp in [(64,32,10**9,4),(64,64,10**9,3),(128,16,10**9,3),(256,8,3_000_000_000,2)]:
    n=sample_count(budget,width,depth)
    print('spec',width,depth,'n',n, flush=True)
    scores={s:[] for s in [0,0.1,0.25,0.5,1.0]}
    rng=np.random.default_rng(2026)
    t0=time.time()
    for m in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
        tar=target(weights, n=50000 if width>=128 else 100000, seed=1000+m)
        for s in scores:
            pr=pred(weights, seed=2000+m, state_shift=s, n=n)
            scores[s].append(((pr[-1]-tar[-1])**2).mean())
    print({s:float(np.mean(v)) for s,v in scores.items()}, 'time', time.time()-t0, flush=True)

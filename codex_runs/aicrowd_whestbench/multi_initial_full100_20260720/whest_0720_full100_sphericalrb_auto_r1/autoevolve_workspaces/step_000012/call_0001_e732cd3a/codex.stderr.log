                        limit_bytes = int(memory_limit_mb) * 1024 * 1024
                        _resource.setrlimit(_resource.RLIMIT_AS, (limit_bytes, limit_bytes))
                    except (ImportError, ValueError, OSError, AttributeError) as e:
                        sys.stderr.write(

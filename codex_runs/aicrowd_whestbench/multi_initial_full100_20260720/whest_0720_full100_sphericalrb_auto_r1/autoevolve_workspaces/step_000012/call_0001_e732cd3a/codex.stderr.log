# Compact synthetic comparison for first-layer diagonal moment matching.
import math, numpy as np
from scipy.stats import norm
TAIL=1e-9; QMC_SHIFTS=2

def gen(w):
    r=2.0; e=1/(w+1)
    for _ in range(40): r=(1+r)**e
    inv=1/r; vals=[]; v=inv
    for _ in range(w): vals.append(v); v*=inv
    return np.array(vals)
def dirs(n,w,rng):
    idx=np.arange(n)[:,None].astype(float); u=(idx*gen(w)[None,:]+rng.random(w)[None,:])%1
    z=norm.ppf(np.clip(u,TAIL,1-TAIL)); rr=np.sqrt(np.maximum((z*z).sum(1),1e-24)); return z/rr[:,None]
def half_dirs(half,w,rng):
    base=half//QMC_SHIFTS; rem=half-base*QMC_SHIFTS
    return np.concatenate([dirs(base+(i<rem),w,rng) for i in range(QMC_SHIFTS)])
def whiten(D):
    n,w=D.shape; M=D.T@D*(w/n); ev,V=np.linalg.eigh(M); ev=np.maximum(ev,1e-8); return (V/np.sqrt(ev))@V.T
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def analytic(weights):
    w=weights[0].shape[0]; mean=np.zeros(w); cov=np.eye(w); rows=[]; normz=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); a=pm/sd
        gate=norm.cdf(a); dens=np.exp(-0.5*a*a)*normz; nm=sd*dens+pm*gate
        sec=(pm*pm+var)*gate+pm*sd*dens; nv=np.maximum(sec-nm*nm,1e-24)
        if li==0:
            # exact zero cov
            s=sd[:,None]*sd[None,:]; corr=np.clip(pc/s,-1,1)
            second=s*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
            m=sd/math.sqrt(2*math.pi); cov=second-m[:,None]*m[None,:]
        else:
            lin=pc*gate[:,None]*gate[None,:]; cov=lin+np.diag(nv-np.diag(lin))
        mean=nm; rows.append(mean)
    return np.stack(rows)
def pred(weights,n=128,diag=False,corrcoef=0.94,blend=0.065,seed=1):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); D=half_dirs(n//2,w,rng); D=D@whiten(D)
    X=np.concatenate([D,-D])*mean_chi(w); A=np.maximum(X@weights[0],0); ex=exact_first(weights[0]); rows=[ex]
    if diag:
        mh=A.mean(0); varh=np.maximum(((A-mh)**2).mean(0),1e-24); vpre=(weights[0]*weights[0]).sum(0)
        vare=np.maximum(vpre*(0.5-1/(2*math.pi)),1e-24)
        A=(A-mh)*np.sqrt(vare/varh)+ex
        corr=np.zeros(w)
    else:
        corr=ex-A.mean(0)
    for W in weights[1:]:
        pre=A@W; gate=(pre>0).mean(0); A=np.maximum(pre,0); corr=(corr@W)*gate; base=A.mean(0); rows.append(base+corrcoef*corr)
    return (1-blend)*np.stack(rows)+blend*analytic(weights)
def target(weights,n=100000,batch=10000):
    rng=np.random.default_rng(333); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]; done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,w))
        for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
        done+=b
    return np.stack([s/n for s in sums])
for width,depth,n,rep in [(64,32,338,5),(64,64,170,3),(128,16,124,3),(256,8,60,2)]:
    rng=np.random.default_rng(77); vals={'base':[],'diag':[]}
    for j in range(rep):
        weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
        tar=target(weights,n=50000 if width>=128 else 100000)
        for k,d in [('base',False),('diag',True)]:
            pr=pred(weights,n=n,diag=d,seed=100+j); vals[k].append(((pr[-1]-tar[-1])**2).mean())
    print(width,depth,{k:float(np.mean(v)) for k,v in vals.items()}, flush=True)

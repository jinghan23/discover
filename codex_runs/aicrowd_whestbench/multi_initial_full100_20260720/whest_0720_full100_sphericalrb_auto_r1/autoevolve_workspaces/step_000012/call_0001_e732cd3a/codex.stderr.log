import math, time
import numpy as np
from scipy.stats import norm
# Reuse compact random MC to compare analytic covariance propagation variants, not official data.

def zero_cov(pre):
    var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    second=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    mean=sd/math.sqrt(2*math.pi)
    return second-mean[:,None]*mean[None,:]

def analytic(weights, mode):
    w=weights[0].shape[0]; mean=np.zeros(w); cov=np.eye(w); rows=[]; normalizer=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); a=pm/sd
        gate=norm.cdf(a); dens=np.exp(-0.5*a*a)*normalizer
        nm=sd*dens+pm*gate
        second=(pm*pm+var)*gate+pm*sd*dens
        nv=np.maximum(second-nm*nm,1e-24)
        if li==0 or mode=='zeroall':
            c=zero_cov(pc)
            c=c+np.diag(nv-np.diag(c))
            cov=c
        elif mode=='shrinkzero':
            z=zero_cov(pc); lin=pc*gate[:,None]*gate[None,:]
            # mix where means small use zero, means positive use lin-ish
            strength=np.sqrt(gate[:,None]*gate[None,:])
            c=strength*lin+(1-strength)*z
            cov=c+np.diag(nv-np.diag(c))
        else:
            lin=pc*gate[:,None]*gate[None,:]
            cov=lin+np.diag(nv-np.diag(lin))
        mean=nm; rows.append(mean)
    return np.stack(rows)

def target(weights,n=100000,batch=10000):
    rng=np.random.default_rng(123); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]; done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,w))
        for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
        done+=b
    return np.stack([s/n for s in sums])
for spec in [(64,32,5),(64,64,3),(128,16,3),(256,8,2)]:
    width,depth,nmlp=spec; rng=np.random.default_rng(9); vals={m:[] for m in ['lin','zeroall','shrinkzero']}; t=time.time()
    for j in range(nmlp):
        weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
        tar=target(weights,n=50000 if width>=128 else 100000)
        for m in vals:
            pr=analytic(weights,m)
            vals[m].append(((pr[-1]-tar[-1])**2).mean())
    print(spec,{k:float(np.mean(v)) for k,v in vals.items()},'time',time.time()-t, flush=True)

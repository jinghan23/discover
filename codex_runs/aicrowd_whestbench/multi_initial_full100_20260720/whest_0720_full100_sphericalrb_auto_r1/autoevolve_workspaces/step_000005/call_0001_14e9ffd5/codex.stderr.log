import time
from types import SimpleNamespace
import numpy as np
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def np_forward_means(weights, n=500000, seed=123, batch=50000):
    rng=np.random.default_rng(seed)
    depth=len(weights); width=weights[0].shape[0]
    sums=[np.zeros(width,dtype=np.float64) for _ in range(depth)]
    done=0
    for start in range(0,n,batch):
        m=min(batch,n-start)
        x=rng.standard_normal((m,width), dtype=np.float32)
        for i,w in enumerate(weights):
            x=np.maximum(x@w,0)
            sums[i]+=x.sum(axis=0,dtype=np.float64)
        done+=m
    return np.stack([s/done for s in sums]).astype(np.float32)

def run(width=64, depth=8, n_mlps=3, budget=100_000_000_000, refn=1000000):
    print('sample_count', submission._sample_count(budget,width,depth))
    cases=[]
    ss=fnp.random.SeedSequence(2026).spawn(n_mlps*2)
    for i in range(n_mlps):
        mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[2*i]),seed=int(ss[2*i+1].generate_state(1)[0]))
        ref=np_forward_means([np.asarray(w,dtype=np.float32) for w in mlp.weights], refn, 300+i, batch=100000)
        cases.append((mlp,ref))
    vals=[]
    for gc in [0.75,0.9,1.0,1.125,1.25,1.4,1.6]:
      for ab in [0,0.02,0.05,0.08,0.12,0.2,0.35]:
        submission._GATE_MEAN_CORRECTION=gc; submission._ANALYTIC_BLEND=ab
        est=submission.Estimator(); est.setup(SimpleNamespace(width=width,depth=depth,flop_budget=budget,seed=42))
        ms=[]
        for mlp,ref in cases:
            p=np.asarray(est.predict(mlp,budget),dtype=np.float32)
            ms.append(((p[-1]-ref[-1])**2).mean())
        vals.append((float(np.mean(ms)),gc,ab))
        print('gc',gc,'ab',ab,'mse',vals[-1][0], flush=True)
    print('best');
    for x in sorted(vals)[:12]: print(x)

st=time.time(); run(); print('time',time.time()-st)

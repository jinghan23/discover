/bin/bash -lc "python - <<'PY'
import numpy as np
from types import SimpleNamespace
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def ref_means(weights,n=400000,seed=1,batch=100000):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; depth=len(weights)
 sums=[np.zeros(width,dtype=np.float64) for _ in range(depth)]
 for start in range(0,n,batch):
  m=min(batch,n-start); x=rng.standard_normal((m,width), dtype=np.float32)
  for i,w in enumerate(weights):
   x=np.maximum(x@w,0); sums[i]+=x.sum(axis=0,dtype=np.float64)
 return np.stack([s/n for s in sums]).astype(np.float32)

def score(transform_name,width=64,depth=32,budget=100_000_000_000,n_mlps=2):
 ss=fnp.random.SeedSequence(551).spawn(n_mlps*2); cases=[]
 for i in range(n_mlps):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[2*i]),seed=int(ss[2*i+1].generate_state(1)[0]))
  cases.append((mlp,ref_means([np.asarray(w,dtype=np.float32) for w in mlp.weights],seed=70+i)))
 orig=submission._angular_whitening_transform
 if transform_name=='identity':
  submission._angular_whitening_transform=lambda directions: fnp.eye(directions.shape[1], dtype=fnp.float64)
 elif transform_name=='diag':
  def diag(directions):
   n,w=directions.shape
   sm=fnp.sum(directions*directions,axis=0)*(float(w)/float(n))
   sm=fnp.maximum(sm,1e-8)
   return fnp.diag(1.0/fnp.sqrt(sm))
  submission._angular_whitening_transform=diag
 elif transform_name=='half':
  def half(directions):
   n,w=directions.shape
   scaled=directions.T@directions*(float(w)/float(n))
   vals,vecs=fnp.linalg.eigh(scaled); vals=fnp.maximum(vals,1e-8)
   return (vecs / fnp.sqrt(fnp.sqrt(vals))) @ vecs.T
  submission._angular_whitening_transform=half
 submission._ANALYTIC_BLEND=0.05; submission._GATE_MEAN_CORRECTION=1.125
 est=submission.Estimator(); est.setup(SimpleNamespace(width=width,depth=depth,flop_budget=budget,seed=42))
 ms=[]
 for mlp,ref in cases:
  p=np.asarray(est.predict(mlp,budget),dtype=np.float32)
  ms.append(((p[-1]-ref[-1])**2).mean())
 submission._angular_whitening_transform=orig
 return float(np.mean(ms))
for w,d in [(64,16),(64,32),(32,32)]:
 print('case',w,d)
 for name in ['full','half','diag','identity']:
  print(name, score(name,w,d), flush=True)

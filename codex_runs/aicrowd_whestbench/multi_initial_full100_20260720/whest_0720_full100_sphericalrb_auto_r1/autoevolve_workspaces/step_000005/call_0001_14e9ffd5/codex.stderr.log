/bin/bash -lc "python - <<'PY'
import time, math
from types import SimpleNamespace
import numpy as np
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission


def np_forward_means(weights, n=200000, seed=123, batch=20000):
    rng=np.random.default_rng(seed)
    depth=len(weights); width=weights[0].shape[0]
    sums=[np.zeros(width,dtype=np.float64) for _ in range(depth)]
    done=0
    for start in range(0,n,batch):
        m=min(batch,n-start)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for i,w in enumerate(weights):
            x=x@w
            x=np.maximum(x,0)
            sums[i]+=x.sum(axis=0,dtype=np.float64)
        done+=m
    return np.stack([s/done for s in sums]).astype(np.float32)

def eval_consts(width=64, depth=8, n_mlps=4, budget=100_000_000, refn=120000):
    cases=[]
    master=fnp.random.SeedSequence(777).spawn(n_mlps*2)
    for i in range(n_mlps):
        mlp=sample_mlp(width, depth, fnp.random.default_rng(master[2*i]), seed=int(master[2*i+1].generate_state(1)[0]))
        weights=[np.asarray(w,dtype=np.float32) for w in mlp.weights]
        ref=np_forward_means(weights, n=refn, seed=9000+i, batch=20000)
        cases.append((mlp,ref))
    results=[]
    for gc in [0.75,0.9,1.0,1.05,1.125,1.25,1.4]:
      for ab in [0.0,0.02,0.05,0.08,0.12,0.2]:

import math, numpy as np
from types import SimpleNamespace
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def ref_means(weights,n=500000,seed=1,batch=100000):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; depth=len(weights)
 sums=[np.zeros(width,dtype=np.float64) for _ in range(depth)]
 for start in range(0,n,batch):
  m=min(batch,n-start); x=rng.standard_normal((m,width), dtype=np.float32)
  for i,w in enumerate(weights):
   x=np.maximum(x@w,0); sums[i]+=x.sum(axis=0,dtype=np.float64)
 return np.stack([s/n for s in sums]).astype(np.float32)

def pred_variant(mlp,budget,mode):
 n=submission._sample_count(budget,mlp.width,mlp.depth); half=n//2
 rng=fnp.random.default_rng(int(mlp.seed))
 half_dirs=submission._lattice_half_directions(half,mlp.width,rng)
 whitening=submission._angular_whitening_transform(half_dirs)
 paired=fnp.concatenate((half_dirs,-half_dirs),axis=0)
 acts=paired*submission._mean_chi(mlp.width)
 acts=fnp.maximum(acts@(whitening@mlp.weights[0]),0.0)
 exact=submission._exact_first_layer_mean(mlp.weights[0])
 rows=[exact]
 sm=fnp.mean(acts,axis=0)
 if mode=='scale':
  acts=acts*(exact/fnp.maximum(sm,1e-12))
  for W in mlp.weights[1:]:
   acts=fnp.maximum(acts@W,0.0); rows.append(fnp.mean(acts,axis=0))
 elif mode=='shift':
  acts=acts+(exact-sm)
  for W in mlp.weights[1:]:
   acts=fnp.maximum(acts@W,0.0); rows.append(fnp.mean(acts,axis=0))
 elif mode=='clipshift':
  acts=fnp.maximum(acts+(exact-sm),0.0)
  for W in mlp.weights[1:]:
   acts=fnp.maximum(acts@W,0.0); rows.append(fnp.mean(acts,axis=0))
 elif mode=='baseline':
  corr=exact-sm
  for W in mlp.weights[1:]:
   pre=acts@W; gate=fnp.mean(pre>0.0,axis=0); acts=fnp.maximum(pre,0.0)
   corr=(corr@W)*gate; rows.append(fnp.mean(acts,axis=0)+1.125*corr)
 q=fnp.stack(rows,axis=0)
 an=submission._linearized_gaussian_rows(mlp.weights,mlp.width)
 return np.asarray((0.95*q+0.05*an),dtype=np.float32)

def run(width,depth,budget,n_mlps=3):
 print('case',width,depth,'sample',submission._sample_count(budget,width,depth))
 ss=fnp.random.SeedSequence(7777).spawn(n_mlps*2); cases=[]
 for i in range(n_mlps):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[2*i]),seed=int(ss[2*i+1].generate_state(1)[0]))
  cases.append((mlp,ref_means([np.asarray(w,dtype=np.float32) for w in mlp.weights],seed=200+i)))
 for mode in ['baseline','scale','shift','clipshift']:
  ms=[]
  for mlp,ref in cases:
   p=pred_variant(mlp,budget,mode); ms.append(((p[-1]-ref[-1])**2).mean())
  print(mode,float(np.mean(ms)),flush=True)
for wd in [(64,16),(64,32),(32,32)]: run(*wd,100_000_000_000)

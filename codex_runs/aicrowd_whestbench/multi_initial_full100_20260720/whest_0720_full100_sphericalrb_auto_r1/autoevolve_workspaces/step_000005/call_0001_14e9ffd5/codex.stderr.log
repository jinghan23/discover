codex
I’m evaluating a low-overhead idea locally: use the two existing randomized lattice shifts as sub-estimates and slightly reweight them based on first-layer moment error. This adds reductions, not extra forward passes, if it works.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def ref_means(weights,n=500000,seed=1,batch=100000):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; depth=len(weights)
 sums=[np.zeros(width,dtype=np.float64) for _ in range(depth)]
 for start in range(0,n,batch):
  m=min(batch,n-start); x=rng.standard_normal((m,width), dtype=np.float32)
  for i,w in enumerate(weights): x=np.maximum(x@w,0); sums[i]+=x.sum(axis=0,dtype=np.float64)
 return np.stack([s/n for s in sums]).astype(np.float32)

def pred_weighted(mlp,budget,alpha=0.0):
 n=submission._sample_count(budget,mlp.width,mlp.depth); half=n//2
 rng=fnp.random.default_rng(int(mlp.seed))
 hd=submission._lattice_half_directions(half,mlp.width,rng); wh=submission._angular_whitening_transform(hd)
 base=half//2; rem=half-base*2; counts=[base+(1 if s<rem else 0) for s in range(2)]
 starts=[0,counts[0]]
 acts=fnp.concatenate((hd,-hd),axis=0)*submission._mean_chi(mlp.width)
 acts=fnp.maximum(acts@(wh@mlp.weights[0]),0.0)
 exact=submission._exact_first_layer_mean(mlp.weights[0])
 block_metrics=[]
 for st,c in zip(starts,counts):
  bm=(fnp.sum(acts[st:st+c],axis=0)+fnp.sum(acts[half+st:half+st+c],axis=0))/(2*c)
  err=bm-exact
  block_metrics.append(float(fnp.mean(err*err)))
 inv=np.array([1.0/(1e-30+m) for m in block_metrics]); w=inv/inv.sum()
 rows=[exact]; corr=exact-fnp.mean(acts,axis=0)
 for W in mlp.weights[1:]:
  pre=acts@W; gate=fnp.mean(pre>0,axis=0); acts=fnp.maximum(pre,0)
  corr=(corr@W)*gate
  full=fnp.mean(acts,axis=0)+1.125*corr
  if alpha:
   bm0=(fnp.sum(acts[0:counts[0]],axis=0)+fnp.sum(acts[half:half+counts[0]],axis=0))/(2*counts[0])
   st=counts[0]; c=counts[1]
   bm1=(fnp.sum(acts[st:st+c],axis=0)+fnp.sum(acts[half+st:half+st+c],axis=0))/(2*c)
   weighted=bm0*w[0]+bm1*w[1]+1.125*corr
   full=(1-alpha)*full+alpha*weighted
  rows.append(full)
 q=fnp.stack(rows,axis=0); an=submission._linearized_gaussian_rows(mlp.weights,mlp.width)
 return np.asarray(0.95*q+0.05*an,dtype=np.float32)

def run(width,depth,budget,n_mlps=4):
 print('\\ncase',width,depth,'n',submission._sample_count(budget,width,depth))
 ss=fnp.random.SeedSequence(1234).spawn(n_mlps*2); cases=[]
 for i in range(n_mlps):
  mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[2*i]),seed=int(ss[2*i+1].generate_state(1)[0]))
  cases.append((mlp,ref_means([np.asarray(w,dtype=np.float32) for w in mlp.weights],seed=500+i)))
 for alpha in [0,0.1,0.25,0.5,1.0]:
  ms=[]
  for mlp,ref in cases:
   p=pred_weighted(mlp,budget,alpha); ms.append(((p[-1]-ref[-1])**2).mean())
  print('alpha',alpha,'mse',float(np.mean(ms)),flush=True)
for wd in [(64,16),(64,32),(32,32)]: run(*wd,100_000_000_000)

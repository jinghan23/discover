/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIGF=1e-8; GATE=1.05; BLEND=.05

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p,dtype=float)
def genvec(w,kind,rng):
 if kind=='sqrt_primes': return np.sqrt(primes(w))%1
 if kind=='golden':
  phi=(1+5**.5)/2; return (phi**-np.arange(1,w+1))%1
 if kind=='sqrt_primes_phi':
  phi=(1+5**.5)/2; return (np.sqrt(primes(w))*phi)%1
 if kind=='random': return rng.random(w)
 if kind=='sin': return (np.sin(np.arange(1,w+1)*12.9898)*43758.5453)%1
 raise ValueError(kind)
def dirs(n,w,r,kind):
 g=genvec(w,kind,r); sh=r.random(w); idx=np.arange(n,dtype=float)[:,None]
 z=ndtri(np.clip((idx*g[None,:]+sh[None,:])%1,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def half(h,w,r,kind): return np.concatenate([dirs(h//2+(i<h%2),w,r,kind) for i in range(2)],0)
def white(d):
 n,w=d.shape; M=d.T@d*(w/n); vals,vecs=np.linalg.eigh(M); vals=np.maximum(vals,EIGF); return (vecs/np.sqrt(vals))@vecs.T
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def ef(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def zcov(pre):
 var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]; corr=np.clip(pre/scale,-1,1)
 sec=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi); m=sd/math.sqrt(2*math.pi)
 return sec-m[:,None]*m[None,:]
def analytic(weights,w):
 mean=np.zeros(w,np.float32); cov=np.eye(w,dtype=np.float32); rows=[]; normc=1/math.sqrt(2*math.pi)
 for li,W in enumerate(weights):
  pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd; gate=norm.cdf(z); dens=np.exp(-.5*z*z)*normc
  nm=sd*dens+pm*gate; sec=(pm*pm+var)*gate+pm*sd*dens; nv=np.maximum(sec-nm*nm,1e-24)
  if li==0: cov=zcov(pc)
  else:
   lin=pc*gate[:,None]*gate[None,:]; cov=lin+np.diag(nv-np.diag(lin))
  mean=nm; rows.append(mean)
 return np.stack(rows)
def estimate(weights,N,seed,kind):
 w=weights[0].shape[0]; r=np.random.default_rng(seed); d=half(N//2,w,r,kind); first=white(d)@weights[0]
 A=np.concatenate([d,-d],0)*mchi(w); rows=[]; A=np.maximum(A@first,0); exact=ef(weights[0]); rows.append(exact); corr=exact-A.mean(0)
 for W in weights[1:]:
  pre=A@W; gate=(pre>0).mean(0); A=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(A.mean(0)+GATE*corr)
 q=np.stack(rows); return ((1-BLEND)*q+BLEND*analytic(weights,w)).astype(np.float32)
def target(weights,M,seed):
 w=weights[0].shape[0]; r=np.random.default_rng(seed); sums=[np.zeros(w) for _ in weights]; done=0; chunk=8192
 while done<M:
  n=min(chunk,M-done); X=r.standard_normal((n,w)).astype(np.float32)
  for i,W in enumerate(weights): X=np.maximum(X@W,0); sums[i]+=X.astype(float).sum(0)
  done+=n
 return (np.stack(sums)/M).astype(np.float32)
def run(width,depth,N,M,nmlp):
 opts=['sqrt_primes','golden','sqrt_primes_phi','random','sin']; rng=np.random.default_rng(321+width+depth); scores={o:[] for o in opts}
 for m in range(nmlp):
  weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
  tgt=target(weights,M,6000+m)
  for o in opts:
   pred=estimate(weights,N,1000+m,o); scores[o].append(((pred[-1]-tgt[-1])**2).mean())
 base=np.mean(scores['sqrt_primes']); print('case',width,depth,N,'base',base)
 for o in sorted(opts,key=lambda k:np.mean(scores[k])): print(o,np.mean(scores[o]),np.mean(scores[o])/base)
for c in [(32,16,1024,131072,6),(64,16,512,65536,5),(64,32,256,65536,4),(128,16,256,32768,3)]: run(*c)

import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm

TAIL=1e-9
EIGF=1e-8
QMC_SHIFTS=2
GATE=1.05
BLEND=0.05

def first_primes(count):
    primes=[]; cand=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>cand: break
            if cand%p==0: ok=False; break
        if ok: primes.append(cand)
        cand+=1
    return np.array(primes)

def lattice_normals(n,width,rng):
    roots=np.sqrt(first_primes(width).astype(np.float64))
    gen=roots-np.floor(roots)
    shift=rng.random(width)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    return ndtri(u)

def qmc_dirs(n,width,rng):
    z=lattice_normals(n,width,rng)
    r=np.sqrt(np.maximum((z*z).sum(1),1e-24))
    return z/r[:,None]

def half_dirs(half,width,rng,shifts=2):
    base=half//shifts; rem=half-base*shifts
    return np.concatenate([qmc_dirs(base+(i<rem),width,rng) for i in range(shifts)],0)

def whitening(d):
    n,w=d.shape
    M=d.T@d*(w/n)
    vals,vecs=np.linalg.eigh(M)
    vals=np.maximum(vals,EIGF)
    return (vecs/np.sqrt(vals))@vecs.T

def mean_chi(d):
    return math.sqrt(2)*math.exp(math.lgamma(0.5*d+0.5)-math.lgamma(0.5*d))

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def zero_cov(pre):
    var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    second=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    mean=sd/math.sqrt(2*math.pi)
    return second-mean[:,None]*mean[None,:]

def analytic(weights,width):
    mean=np.zeros(width,np.float32); cov=np.eye(width,dtype=np.float32); rows=[]; normalizer=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd
        gate=norm.cdf(z); dens=np.exp(-0.5*z*z)*normalizer
        nm=sd*dens+pm*gate
        sec=(pm*pm+var)*gate+pm*sd*dens
        nv=np.maximum(sec-nm*nm,1e-24)
        if li==0: cov=zero_cov(pc)
        else:
            lin=pc*gate[:,None]*gate[None,:]
            cov=lin+np.diag(nv-np.diag(lin))
        mean=nm; rows.append(mean)
    return np.stack(rows).astype(np.float32)

def estimate(weights,N,seed,variant):
    width=weights[0].shape[0]; half=N//2; rng=np.random.default_rng(seed)
    d=half_dirs(half,width,rng,2); white=whitening(d); fw=white@weights[0]
    dirs=np.concatenate([d,-d],0); A=dirs*mean_chi(width)
    rows=[]; A=np.maximum(A@fw,0); ef=exact_first(weights[0]); rows.append(ef)
    if variant=='scale_first':
        sm=A.mean(0); A=A*(ef/np.maximum(sm,1e-12))[None,:]; corr=np.zeros_like(ef)
    else:
        corr=ef-A.mean(0)
    for W in weights[1:]:
        pre=A@W; gate=(pre>0).mean(0); A=np.maximum(pre,0); base=A.mean(0)
        corr=(corr@W)*gate
        row=base+GATE*corr
        if variant=='scale_each':
            scale=np.maximum(row,0)/np.maximum(base,1e-12)
            A=A*scale[None,:]
            corr=np.zeros_like(corr)
        rows.append(row)
    q=np.stack(rows)
    return ((1-BLEND)*q+BLEND*analytic(weights,width)).astype(np.float32)

def target(weights,M,seed):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed)
    # direct gaussian MC chunks
    sums=[np.zeros(width,np.float64) for _ in weights]
    done=0; chunk=8192
    while done<M:
        n=min(chunk,M-done); X=rng.standard_normal((n,width)).astype(np.float32)
        for i,W in enumerate(weights):
            X=np.maximum(X@W,0)
            sums[i]+=X.astype(np.float64).sum(0)
        done+=n
    return (np.stack(sums)/M).astype(np.float32)

for width,depth,N,M,nmlp in [(32,16,1024,131072,8),(64,16,512,65536,6),(64,32,256,65536,4),(128,16,256,32768,3)]:
    rng=np.random.default_rng(1234+width+depth)
    scores={v:[] for v in ['current','scale_first','scale_each']}
    for m in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        tgt=target(weights,M,999+m)
        for v in scores:
            pred=estimate(weights,N,10000+m,v)
            scores[v].append(((pred[-1]-tgt[-1])**2).mean())
    print('case',width,depth,N,M)
    for v,a in scores.items(): print(v, np.mean(a), 'rel', np.mean(a)/np.mean(scores['current']))

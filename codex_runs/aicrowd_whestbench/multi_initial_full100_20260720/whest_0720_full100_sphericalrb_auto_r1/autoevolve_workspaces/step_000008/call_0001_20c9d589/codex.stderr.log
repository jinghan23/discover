    mean=np.zeros(w,np.float32); cov=np.eye(w,dtype=np.float32); rows=[]; normc=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd; gate=norm.cdf(z); dens=np.exp(-.5*z*z)*normc
        nm=sd*dens+pm*gate; sec=(pm*pm+var)*gate+pm*sd*dens; nv=np.maximum(sec-nm*nm,1e-24)
        if li==0: cov=zero_cov(pc)
        else:
            lin=pc*gate[:,None]*gate[None,:]; cov=lin+np.diag(nv-np.diag(lin))
        mean=nm; rows.append(mean)
    return np.stack(rows).astype(np.float32)
def estimate(weights,N,seed,gatecorr,blend,shifts,usewhite=True):
    w=weights[0].shape[0]; half=N//2; rng=np.random.default_rng(seed); d=half_dirs(half,w,rng,shifts); first=weights[0]
    if usewhite: first=whitening(d)@first
    A=np.concatenate([d,-d],0)*mean_chi(w); rows=[]; A=np.maximum(A@first,0); ef=exact_first(weights[0]); rows.append(ef); corr=ef-A.mean(0)
    for W in weights[1:]:
        pre=A@W; gate=(pre>0).mean(0); A=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(A.mean(0)+gatecorr*corr)
    q=np.stack(rows)
    if blend==0: return q.astype(np.float32)
    return ((1-blend)*q+blend*analytic(weights,w)).astype(np.float32)
def target(weights,M,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); sums=[np.zeros(w,np.float64) for _ in weights]; done=0; chunk=8192
    while done<M:
        n=min(chunk,M-done); X=rng.standard_normal((n,w)).astype(np.float32)
        for i,W in enumerate(weights): X=np.maximum(X@W,0); sums[i]+=X.astype(np.float64).sum(0)
        done+=n
    return (np.stack(sums)/M).astype(np.float32)

def run_case(width,depth,N,M,nmlp):
    rng=np.random.default_rng(777+width*3+depth); mlps=[]; tgts=[]
    for m in range(nmlp):
        weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        mlps.append(weights); tgts.append(target(weights,M,9000+m))
    configs=[]
    for g in [0.9,1.0,1.05,1.1,1.2]: configs.append((f'g{g}',g,0.05,2,True))
    for b in [0,0.02,0.05,0.08,0.1,0.15]: configs.append((f'b{b}',1.05,b,2,True))
    for s in [1,2,4,8]: configs.append((f's{s}',1.05,0.05,s,True))
    configs.append(('nowhite',1.05,0.05,2,False))
    out={name:[] for name,_,_,_,_ in configs}
    for m,weights in enumerate(mlps):
        for name,g,b,s,uw in configs:
            pred=estimate(weights,N,1000+m,g,b,s,uw); out[name].append(((pred[-1]-tgts[m][-1])**2).mean())
    base=np.mean(out['g1.05'])
    print('case',width,depth,N,'base',base)
    for name in sorted(out, key=lambda k: np.mean(out[k])):
        print(name, np.mean(out[name]), np.mean(out[name])/base)

for c in [(32,16,1024,131072,8),(64,16,512,65536,6),(64,32,256,65536,4),(128,16,256,32768,3)]: run_case(*c)

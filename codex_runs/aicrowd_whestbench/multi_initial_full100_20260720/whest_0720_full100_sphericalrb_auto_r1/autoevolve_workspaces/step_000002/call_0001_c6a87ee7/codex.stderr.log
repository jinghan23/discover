 m1,S1=exact_h1_m_s(weights[0]); sm=x.mean(0); delta1=m1-sm; rows=[m1]
 v1=delta1.copy(); v2=None
 for li,W in enumerate(weights[1:], start=1):
  pre=x@W; gm=(pre>0).mean(0); base=np.maximum(pre,0).mean(0)
  v1=(v1@W)*gm
  corr=b1*v1

import math, time
import numpy as np
from scipy.stats import norm
TAIL=1e-11
# helper copies compact

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng):
 g=np.sqrt(primes(w)); g-=np.floor(g); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def getH(n,w,seed,sh=2):
 rng=np.random.default_rng(seed); half=n//2; base=half//sh; rem=half-base*sh
 return np.concatenate([dirs(base+(i<rem),w,rng) for i in range(sh)],0)
def wh(D):
 n,w=D.shape; S=D.T@D*(w/n); vals,vec=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vec/np.sqrt(vals))@vec.T

def est(weights,n,seed=0,mode='cur',beta=1.0):
 w=weights[0].shape[0]; H=getH(n,w,seed); T=wh(H); D=np.concatenate([H,-H]); x=D*mchi(w); x=np.maximum(x@(T@weights[0]),0)
 exact=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi); sm=x.mean(0); delta=exact-sm; rows=[exact]
 v=delta.copy()
 for W in weights[1:]:
  pre=x@W; gate_mean=(pre>0).mean(0); x=np.maximum(pre,0); base=x.mean(0)
  if mode=='gate':
   v=(v@W)*gate_mean; rows.append(base+beta*v)
  else: rows.append(base)
 return np.stack(rows)

def target(weights,n,seed,chunk=8000):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return np.stack([s/n for s in sums])

for w,d,N,TN in [(64,32,1550,300000),(128,32,3100,120000)]:
 betas=[.25,.5,.75,1.0,1.25]
 vals={b:[] for b in ['cur']+betas}
 for mi in range(8 if w==64 else 4):
  rng=np.random.default_rng(2000+mi); scale=math.sqrt(2/w); weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
  tgt=target(weights,TN,seed=3000+mi)[-1]
  cur=est(weights,N,seed=4000+mi,mode='cur')[-1]; vals['cur'].append(((cur-tgt)**2).mean())
  for b in betas:
   pr=est(weights,N,seed=4000+mi,mode='gate',beta=b)[-1]; vals[b].append(((pr-tgt)**2).mean())
 print('spec',w)
 for k,v in vals.items(): print(k, np.mean(v), np.std(v)/len(v)**.5)

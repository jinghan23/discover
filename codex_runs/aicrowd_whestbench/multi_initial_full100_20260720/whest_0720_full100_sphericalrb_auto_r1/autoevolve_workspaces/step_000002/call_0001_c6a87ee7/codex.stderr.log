   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
P256=primes(256)
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng):
 p=P256 if w==256 else primes(w); g=np.sqrt(p); g-=np.floor(g)
 u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def H(n,w,seed,sh=2):
 rng=np.random.default_rng(seed); half=n//2; base=half//sh; rem=half-base*sh
 return np.concatenate([dirs(base+(i<rem),w,rng) for i in range(sh)],0)
def wh(D):
 n,w=D.shape; S=D.T@D*(w/n); vals,vec=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vec/np.sqrt(vals))@vec.T
def est(weights,n=6322,seed=0,beta=0):
 w=weights[0].shape[0]; HH=H(n,w,seed); T=wh(HH); D=np.concatenate([HH,-HH]); x=D*mchi(w); x=np.maximum(x@(T@weights[0]),0)
 exact=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi); delta=exact-x.mean(0); v=delta.copy(); rows=[exact]
 for W in weights[1:]:
  pre=x@W; gm=(pre>0).mean(0); x=np.maximum(pre,0); base=x.mean(0)
  if beta:
   v=(v@W)*gm; rows.append(base+beta*v)
  else: rows.append(base)
 return np.stack(rows)
def target_mc(weights,n=200000,seed=0,chunk=4096):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return np.stack([s/n for s in sums])

t0=time.time(); vals=[]
for mi in range(2):
 rng=np.random.default_rng(7000+mi); scale=math.sqrt(2/256); weights=[rng.standard_normal((256,256))*scale for _ in range(32)]
 tgt=target_mc(weights, n=150000, seed=8000+mi, chunk=2048)[-1]
 row=[]
 for beta in [0,.25,.5,.75,1,1.25,1.5]:
  p=est(weights,6322,seed=9000+mi,beta=beta)[-1]
  row.append(((p-tgt)**2).mean())
 print('mi',mi,row)
 vals.append(row)
print('mean',np.mean(vals,0),'elapsed',time.time()-t0)

+def _is_power_of_two(value: int) -> bool:
+    return value > 0 and (value & (value - 1)) == 0
+
+
+def _hadamard_matrix(width: int) -> fnp.ndarray:
+    matrix = fnp.ones((1, 1), dtype=fnp.float64)
+    while matrix.shape[0] < width:
+        top = fnp.concatenate((matrix, matrix), axis=1)
+        bottom = fnp.concatenate((matrix, -matrix), axis=1)
+        matrix = fnp.concatenate((top, bottom), axis=0)
+    return matrix / fnp.sqrt(float(width))
+
+
+def _hadamard_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
+    base = _hadamard_matrix(width)
+    blocks = []
+    remaining = n_samples
+    while remaining > 0:
+        signs = fnp.where(rng.random(width) < 0.5, -1.0, 1.0)
+        permutation = rng.permutation(width)
+        block = (base * signs[None, :])[:, permutation]
+        if remaining >= width:
+            blocks.append(block)
+            remaining -= width
+        else:
+            rows = rng.choice(width, size=remaining, replace=False)
+            blocks.append(block[rows])
+            remaining = 0
+    return fnp.concatenate(blocks, axis=0)

import math, time
import numpy as np
from scipy.stats import norm
TAIL=1e-11

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
PR={}
def getp(w):
 if w not in PR: PR[w]=primes(w)
 return PR[w]
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng):
 g=np.sqrt(getp(w)); g-=np.floor(g); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def H(n,w,seed,sh=2):
 rng=np.random.default_rng(seed); half=n//2; base=half//sh; rem=half-base*sh
 return np.concatenate([dirs(base+(i<rem),w,rng) for i in range(sh)],0)
def wh(D):
 n,w=D.shape; S=D.T@D*(w/n); vals,vec=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vec/np.sqrt(vals))@vec.T
def relu_gauss(mu,var):
 var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; return mu*norm.cdf(a)+sig*norm.pdf(a)
def exact_h1_m_s(W0):
 w=W0.shape[0]; norms=np.sqrt(np.maximum((W0*W0).sum(0),1e-30)); gram=W0.T@W0
 rho=np.clip(gram/(norms[:,None]*norms[None,:]),-1,1)
 k=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
 S=(mchi(w)**2/float(w))*(norms[:,None]*norms[None,:])*k
 m=norms/math.sqrt(2*math.pi)
 return m,S
def est(weights,n,seed=0,b1=0,b2=0):

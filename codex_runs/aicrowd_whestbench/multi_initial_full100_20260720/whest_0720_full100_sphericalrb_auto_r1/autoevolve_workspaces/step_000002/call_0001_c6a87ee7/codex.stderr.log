+        signs = fnp.where(rng.random(width) < 0.5, -1.0, 1.0)
+        permutation = rng.permutation(width)
+        block = (base * signs[None, :])[:, permutation]
+        if remaining >= width:
+            blocks.append(block)
+            remaining -= width
+        else:
+            rows = rng.choice(width, size=remaining, replace=False)
+            blocks.append(block[rows])
+            remaining = 0
+    return fnp.concatenate(blocks, axis=0)

import math, time
import numpy as np
from scipy.stats import norm

TAIL=1e-11
FLOP_FRAC=.1005

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def mean_chi(d):
    hd=.5*d
    return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))

def lattice_normals(n,w,rng):
    roots=np.sqrt(first_primes(w).astype(np.float64))
    gen=roots-np.floor(roots)
    shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    return norm.ppf(u)

def qmc_dirs(n,w,rng):
    z=lattice_normals(n,w,rng)
    r=np.sqrt(np.maximum((z*z).sum(1),1e-24))
    return z/r[:,None]

def whiten(D):
    n,w=D.shape
    S=D.T@D*(w/n)
    vals,vecs=np.linalg.eigh(S)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def sample_count(budget,w,d,frac=.1005):
    half=(89*w+3*w+2)//2
    layer=d*(2*w*w+2*w)
    cov=w*w
    per=half+layer+cov
    fixed=13*w**3+8*w
    c=(int(frac*budget)-fixed)//max(per,1)
    c=max(32,c)
    return int(c)-(int(c)&1)

def est(weights, seed=0, budget=272_000_000_000, shifts=2, recenter=0, frac=.1005):
    d=len(weights); w=weights[0].shape[0]
    n=sample_count(budget,w,d,frac)
    half=n//2; rng=np.random.default_rng(seed)
    base=half//shifts; rem=half-base*shifts
    blocks=[]
    for i in range(shifts):
        bc=base+(i<rem)
        blocks.append(qmc_dirs(bc,w,rng))
    HD=np.concatenate(blocks,0)
    T=whiten(HD)
    first=T@weights[0]
    D=np.concatenate([HD,-HD],0)
    x=D*mean_chi(w)
    rows=[]
    x=np.maximum(x@first,0)
    exact=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)
    rows.append(exact)
    if recenter>=1:
        x=x+(exact-x.mean(0))
        if recenter==2: x=np.maximum(x,0)
    for W in weights[1:]:
        x=np.maximum(x@W,0)
        rows.append(x.mean(0))
    return np.stack(rows), n

def target(weights, n=300000, seed=123, chunk=5000):
    rng=np.random.default_rng(seed); d=len(weights); w=weights[0].shape[0]
    sums=[np.zeros(w,dtype=np.float64) for _ in range(d)]
    done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,w)).astype(np.float64)
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(0)
        done+=m
    return np.stack([s/done for s in sums])

def run(w=64,d=32,n_mlp=8,target_n=200000):
    print('spec',w,d,n_mlp,target_n)
    variants=[('sh1',dict(shifts=1)),('sh2',dict(shifts=2)),('sh4',dict(shifts=4)),('rec1',dict(shifts=2,recenter=1)),('rec2',dict(shifts=2,recenter=2)),('frac15',dict(shifts=2,frac=.150)),('frac20',dict(shifts=2,frac=.200))]
    mses={k:[] for k,_ in variants}; ns={}
    t0=time.time()
    for mi in range(n_mlp):
        rng=np.random.default_rng(1000+mi)
        scale=math.sqrt(2/w)
        weights=[(rng.standard_normal((w,w))*scale).astype(np.float64) for _ in range(d)]
        tgt=target(weights,target_n,seed=2000+mi,chunk=8000)[-1]
        for k,kw in variants:
            pred,n=est(weights,seed=3000+mi,budget=int(272e9*(w/256)**3),**kw)  # rough scaled budget? maybe keep samples similar?
            ns[k]=n
            mses[k].append(((pred[-1]-tgt)**2).mean())
        print(mi, {k: f'{np.mean(v):.3g}' for k,v in mses.items() if v}, 'n', ns)
    print('elapsed',time.time()-t0)
    for k in mses:
        print(k, ns[k], np.mean(mses[k]), np.std(mses[k])/math.sqrt(len(mses[k])))


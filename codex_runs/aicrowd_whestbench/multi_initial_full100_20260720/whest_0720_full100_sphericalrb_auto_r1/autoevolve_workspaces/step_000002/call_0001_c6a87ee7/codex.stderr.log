import math, time
import numpy as np
from scipy.stats import norm
TAIL=1e-11

def first_primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok: p.append(x)
  x+=1
 return np.array(p)
def mean_chi(d):
 hd=.5*d; return math.sqrt(2)*math.exp(math.lgamma(hd+.5)-math.lgamma(hd))
def dirs(n,w,rng):
 gen=np.sqrt(first_primes(w)); gen=gen-np.floor(gen)
 idx=np.arange(n)[:,None]
 u=(idx*gen[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def whiten(D):
 n,w=D.shape; S=D.T@D*(w/n); vals,vec=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vec/np.sqrt(vals))@vec.T
def make_dirs(n,w,seed=0,shifts=2):
 rng=np.random.default_rng(seed); half=n//2; base=half//shifts; rem=half-base*shifts
 H=np.concatenate([dirs(base+(i<rem),w,rng) for i in range(shifts)],0); return H

def est_current(weights,n=1550,seed=0):
 w=weights[0].shape[0]; H=make_dirs(n,w,seed,2); T=whiten(H); D=np.concatenate([H,-H],0); x=D*mean_chi(w); x=np.maximum(x@(T@weights[0]),0); rows=[np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)]
 for W in weights[1:]: x=np.maximum(x@W,0); rows.append(x.mean(0))
 return np.stack(rows)

def est_linmean(weights,n=775,seed=0):
 w=weights[0].shape[0]; H=make_dirs(n,w,seed,2); T=whiten(H); D=np.concatenate([H,-H],0); x=D*mean_chi(w); x=np.maximum(x@(T@weights[0]),0)
 exact=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)
 delta=exact-x.mean(0)
 corr=np.broadcast_to(delta,(x.shape[0],w)).copy()
 rows=[exact]
 for W in weights[1:]:
  pre=x@W; pc=corr@W; gate=pre>0; x=np.maximum(pre,0); corr=np.where(gate,pc,0); rows.append(x.mean(0)+corr.mean(0))
 return np.stack(rows)

def est_shiftlin(weights,n=775,seed=0):
 # shifted recompute and linear? not used
 return est_linmean(weights,n,seed)

def target(weights,n=300000,seed=1,chunk=10000):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; d=len(weights); sums=[np.zeros(w) for _ in range(d)]
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return np.stack([s/n for s in sums])

for w,d in [(64,32),(128,32)]:
 vals=[]
 for mi in range(6 if w==64 else 3):
  rng=np.random.default_rng(500+mi); scale=math.sqrt(2/w); weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
  tgt=target(weights, n=300000 if w==64 else 120000, seed=800+mi, chunk=6000)[-1]
  cur=est_current(weights, n=1550 if w==64 else 3100, seed=900+mi)[-1]
  lin=est_linmean(weights, n=(1550 if w==64 else 3100)//2, seed=900+mi)[-1]
  linfull=est_linmean(weights, n=(1550 if w==64 else 3100), seed=900+mi)[-1]
  vals.append([((cur-tgt)**2).mean(), ((lin-tgt)**2).mean(), ((linfull-tgt)**2).mean()])
  print('mi',mi,vals[-1])
 vals=np.array(vals)
 print('spec',w,d,'current lin_half lin_full mean',vals.mean(0),'se',vals.std(0)/len(vals)**.5)

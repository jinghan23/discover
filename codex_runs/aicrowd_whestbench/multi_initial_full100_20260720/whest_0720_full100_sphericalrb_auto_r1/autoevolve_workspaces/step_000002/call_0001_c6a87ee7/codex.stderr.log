codex
Another possible variance-reduction route is an orthogonal Hadamard spherical design. Width 256 is a power of two, so repeated signed Hadamard blocks give exact norms and near-exact covariance with no inverse-CDF noise. I’ll test it locally before considering an official run.
exec
/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
from scipy.stats import norm
TAIL=1e-11
PR={}
def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
def getp(w):
 if w not in PR: PR[w]=primes(w)
 return PR[w]
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def hadamard(w):
 H=np.array([[1.0]])
 while H.shape[0]<w:
  H=np.block([[H,H],[H,-H]])
 return H/np.sqrt(w)
def had_dirs(n,w,rng):
 H=hadamard(w); blocks=[]; left=n
 while left>0:

# Compare Hadamard with/without permutations on local synthetic cases.
import math, numpy as np
from scipy.stats import norm
TAIL=1e-11

def hadamard(w):
 H=np.array([[1.0]])
 while H.shape[0]<w: H=np.block([[H,H],[H,-H]])
 return H/np.sqrt(w)
def had_dirs(n,w,rng,perm=True):
 H=hadamard(w); out=[]; left=n
 while left>0:
  signs=rng.choice([-1.0,1.0],size=w)
  B=H*signs[None,:]
  if perm: B=B[:,rng.permutation(w)]
  take=min(left,w)
  if perm:
   rows=rng.choice(w,size=take,replace=False) if take<w else np.arange(w)
   out.append(B[rows])
  else:
   out.append(B[:take])
  left-=take
 return np.vstack(out)
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def est(weights,n,seed=0,perm=True):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); H=had_dirs(n//2,w,rng,perm); D=np.concatenate([H,-H]); x=D*mchi(w); x=np.maximum(x@weights[0],0); rows=[np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)]
 for W in weights[1:]: x=np.maximum(x@W,0); rows.append(x.mean(0))

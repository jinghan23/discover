  print('spec',w,'mi',mi,{k:float(vals[k][-1]) for k in vals})
 print('SUMMARY spec',w,'elapsed',time.time()-t0)
 for k,v in vals.items(): print(k,np.mean(v),np.std(v)/len(v)**.5)

   mu_s=sm@W
   e2_s=(pre*pre).mean(0)
   var_s=np.maximum(e2_s-mu_s*mu_s,1e-12)
   mu_e=m1@W
   e2_e=np.sum((S1@W)*W,axis=0)
   var_e=np.maximum(e2_e-mu_e*mu_e,1e-12)
   d2=relu_gauss(mu_e,var_e)-relu_gauss(mu_s,var_s)
   v2=d2.copy(); corr += b2*v2
  elif v2 is not None:
   v2=(v2@W)*gm; corr += b2*v2
  x=np.maximum(pre,0); rows.append(base+corr)
 return np.stack(rows)
def target(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return np.stack([s/n for s in sums])

for w,d,N,TN,cases in [(64,32,1550,300000,8),(128,32,3100,120000,4),(256,32,6322,100000,2)]:
 variants=[('"'cur',0,0),('b1.35',.35,0),('b2.5',0,.5),('b21',0,1),('both',.35,.5),('both1',.35,1)]
 vals={k:[] for k,_,_ in variants}

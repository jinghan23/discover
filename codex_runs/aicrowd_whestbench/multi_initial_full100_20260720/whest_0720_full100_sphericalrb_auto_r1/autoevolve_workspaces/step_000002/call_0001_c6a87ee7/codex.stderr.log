codex
Precomputing a small pool of QMC direction sets in `setup` could save per-MLP FLOPs and keep the multiplier at the 0.1 floor. Before implementing that, I’ll run a local check to see whether reusing fixed direction sets hurts estimator variance.
exec
/bin/bash -lc "python - <<'PY'
# Local comparison: per-MLP shifted lattice vs reused fixed lattice pool.
import math, numpy as np
from scipy.stats import norm
TAIL=1e-11; PR={}
def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
def getp(w):
 if w not in PR: PR[w]=primes(w)
 return PR[w]
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs_block(n,w,rng):
 g=np.sqrt(getp(w)); g-=np.floor(g); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def makeH(N,w,seed):
 rng=np.random.default_rng(seed); half=N//2; base=half//2; rem=half-base*2
 return np.concatenate([dirs_block(base+(i<rem),w,rng) for i in range(2)])
def wh(H):
 n,w=H.shape; S=H.T@H*(w/n); vals,vec=np.linalg.eigh(S); return (vec/np.sqrt(np.maximum(vals,1e-8)))@vec.T
def est(weights,N,seed=None,HT=None):
 w=weights[0].shape[0]
 if HT is None:
  H=makeH(N,w,seed); T=wh(H)
 else: H,T=HT
 x=np.concatenate([H,-H])*mchi(w); x=np.maximum(x@(T@weights[0]),0)
 for W in weights[1:]: x=np.maximum(x@W,0)
 return x.mean(0)
def target(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w)
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
for w,d,N,TN,cases in [(128,32,3100,200000,8),(256,32,6322,150000,4)]:
 pool=[(makeH(N,w,1000+k), None) for k in range(4)]; pool=[(H,wh(H)) for H,_ in pool]
 vals={'per':[],'pool1':[],'pool4':[]}
 for mi in range(cases):
  rng=np.random.default_rng(101000+w+mi); scale=math.sqrt(2/w); weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
  t=target(weights,TN,102000+mi)
  vals['per'].append(((est(weights,N,seed=103000+mi)-t)**2).mean())
  vals['pool1'].append(((est(weights,N,HT=pool[0])-t)**2).mean())
  vals['pool4'].append(((est(weights,N,HT=pool[mi%4])-t)**2).mean())
 print('spec',w)
 for k,v in vals.items(): print(k,np.mean(v),np.std(v)/len(v)**.5)

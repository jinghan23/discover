+def _lattice_half_directions(half_samples: int, width: int, rng) -> fnp.ndarray:
+    base_count = half_samples // _QMC_SHIFTS
+    remainder = half_samples - base_count * _QMC_SHIFTS
+    direction_blocks = []
+    for shift_index in range(_QMC_SHIFTS):

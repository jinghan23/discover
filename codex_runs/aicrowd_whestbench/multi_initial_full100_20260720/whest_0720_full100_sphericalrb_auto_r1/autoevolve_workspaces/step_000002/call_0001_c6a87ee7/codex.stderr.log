# Quick numpy synthetic: compare diagonal/cov-ish Gaussian propagation with spherical QMC.
import math, time
import numpy as np
from scipy.stats import norm

# Functions for analytic Gaussian moment propagation (diagonal) and target.
def diag_est(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); rows=[]
    for W in weights:
        mu_pre=W.T@mu
        var_pre=(W*W).T@var
        var_pre=np.maximum(var_pre,1e-12)
        sig=np.sqrt(var_pre)
        a=mu_pre/sig
        phi=norm.pdf(a); Phi=norm.cdf(a)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy())
    return np.stack(rows)

def cov_est(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); cov=np.eye(w); rows=[]
    for W in weights:
        mu_pre=W.T@mu
        cov_pre=W.T@cov@W
        var_pre=np.maximum(np.diag(cov_pre),1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig
        phi=norm.pdf(a); Phi=norm.cdf(a)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var_post=np.maximum(ez2-mu*mu,0)
        gain=np.where(sig>1e-12,Phi,0)
        cov=np.outer(gain,gain)*cov_pre
        np.fill_diagonal(cov,var_post)
        rows.append(mu.copy())
    return np.stack(rows)

def target(weights,n=300000,seed=1,chunk=10000):
    rng=np.random.default_rng(seed); d=len(weights); w=weights[0].shape[0]
    sums=[np.zeros(w) for _ in range(d)]
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,w))
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0); sums[i]+=x.sum(0)
    return np.stack([s/n for s in sums])

for w,d in [(64,32),(128,32)]:
    vals=[]
    for mi in range(3):
        rng=np.random.default_rng(100+mi); scale=math.sqrt(2/w)
        weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
        tgt=target(weights, n=200000 if w==64 else 80000, seed=900+mi, chunk=5000)
        de=diag_est(weights); ce=cov_est(weights)
        vals.append((((de[-1]-tgt[-1])**2).mean(), ((ce[-1]-tgt[-1])**2).mean()))
    print('spec',w,d,'diag,cov',np.mean(vals,0), 'se',np.std(vals,0)/len(vals)**.5)

+    base = _hadamard_matrix(width)
+    blocks = []
+    remaining = n_samples
+    while remaining > 0:
+        signs = fnp.where(rng.random(width) < 0.5, -1.0, 1.0)
+        permutation = rng.permutation(width)
+        block = (base * signs[None, :])[:, permutation]
+        if remaining >= width:
+            blocks.append(block)
+            remaining -= width
+        else:

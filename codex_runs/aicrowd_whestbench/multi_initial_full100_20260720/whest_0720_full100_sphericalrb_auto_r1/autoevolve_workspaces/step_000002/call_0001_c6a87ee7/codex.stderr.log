/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy.stats import norm
TAIL=1e-11; PR={}
def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
def getp(w):
 if w not in PR: PR[w]=primes(w)
 return PR[w]
def mchi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng):
 g=np.sqrt(getp(w)); g-=np.floor(g); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1
 z=norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def est_rows(weights,N,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); half=N//2; base=half//2; rem=half-base*2
 H=np.concatenate([dirs(base+(i<rem),w,rng) for i in range(2)]); S=H.T@H*(w/H.shape[0]); vals,vec=np.linalg.eigh(S); T=(vec/np.sqrt(np.maximum(vals,1e-8)))@vec.T
 x=np.concatenate([H,-H])*mchi(w); x=np.maximum(x@(T@weights[0]),0)
 for W in weights[1:]: x=np.maximum(x@W,0)
 return x, half
def target(weights,n,seed,chunk=4096):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w)
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
for w,d,N,TN,cases in [(64,32,1550,300000,10),(128,32,3100,200000,6),(256,32,6322,120000,3)]:
 alphas=[-.5,-.25,0,.25,.5,.75,1.0]
 vals={a:[] for a in alphas}
 for mi in range(cases):
  rng=np.random.default_rng(91000+w+mi); scale=math.sqrt(2/w); weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
  A,half=est_rows(weights,N,92000+mi); full=A.mean(0); m=half//2
  nested=np.concatenate([A[:m],A[half:half+m]],0).mean(0)
  t=target(weights,TN,93000+mi)
  for a in alphas:
   p=full+a*(full-nested); vals[a].append(((p-t)**2).mean())
 print('spec',w)
 for a,v in vals.items(): print(a,np.mean(v),np.std(v)/len(v)**.5)

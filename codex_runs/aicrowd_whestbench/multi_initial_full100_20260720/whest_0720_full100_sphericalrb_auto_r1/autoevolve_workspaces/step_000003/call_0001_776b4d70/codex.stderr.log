def sample_count(B,w,d,target):
 half=(89*w+3*w+2)//2; layer=d*(2*w*w+2*w); cov=w*w; per=half+layer+cov; fixed=13*w**3+8*w; n=(int(target*B)-fixed)//max(per,1); n=max(32,min(n,100*1024*1024//(w*8))); return int(n)-(int(n)&1)
def flops_est(n,w,d):
 # rough measured formula from ops? 2w3 first transform + d*(2nw2) + (d-1)*2w2 correction + O
 return 2*w**3 + d*2*n*w*w + (d-1)*2*w*w + (4*d*n*w) + 2*w*w
for target in [0.1024,0.12,0.13,0.15,0.2]:
 print('target',target)

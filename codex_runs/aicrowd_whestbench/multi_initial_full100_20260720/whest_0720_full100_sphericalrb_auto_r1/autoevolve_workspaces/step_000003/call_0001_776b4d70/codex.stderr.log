/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
def gen_prime(w): return np.sqrt(primes(w))%1
def gen_phi(w):
 g=1.5
 for _ in range(30):
  # solve g"'^(w+1)=g+1
  f=g**(w+1)-g-1; df=(w+1)*g**w-1; g-=f/df
 a=1/g
 return np.array([(a**(j+1))%1 for j in range(w)])
def gen_phi2(w):
 phi=(math.sqrt(5)+1)/2
 return np.array([(1/(phi**(j+1)))%1 for j in range(w)])
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng,gen,sh=2):
 g=gen(w); blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*g+rng.random(w))%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def pred(weights,n,seed,gen):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng,gen); h=hd@white(hd); x=np.concatenate([h,-h])*mean_chi(w); a=np.maximum(x@weights[0],0); ef=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); corr=ef-a.mean(0)
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); corr=(corr@W)*gate
 return a.mean(0)+1.125*corr
def target(weights,N=150000,seed=0,batch=50000):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=b
 return s/N
def bench(w,d,n,T=10):
 gens={'"'prime':gen_prime,'gphi':gen_phi,'phi':gen_phi2}
 vals={k:[] for k in gens}
 for t in range(T):
  rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; tar=target(weights,seed=2000+t)
  for k,g in gens.items(): vals[k].append(((pred(weights,n,3000+t,g)-tar)**2).mean())
 print('\\nCASE',w,d,n)
 for mean,med,k in sorted((np.mean(v),np.median(v),k) for k,v in vals.items()): print(k,mean,med)
for c in [(32,8,506),(64,8,114),(64,8,1314),(128,8,304),(128,4,608)]: bench(*c)

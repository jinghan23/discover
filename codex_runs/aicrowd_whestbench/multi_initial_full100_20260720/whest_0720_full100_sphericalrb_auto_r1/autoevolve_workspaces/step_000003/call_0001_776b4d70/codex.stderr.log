I’m now testing orthogonal direction sets. They are more expensive to set up, but prediction can reuse them just like the current cached lattice directions, and they may reduce angular sampling error for a fixed sample count.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def primes(count):
 p=[]; c=2
 while len(p)<count:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
P={}
def gen(w):
 if w not in P:P[w]=np.sqrt(primes(w))%1
 return P[w]
def mean_chi(d):return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs_lattice(n,w,rng,sh=2):
 blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*gen(w)[None,:]+rng.random(w)[None,:])%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def dirs_rand(n,w,rng):
 z=rng.standard_normal((n,w)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def dirs_orth(n,w,rng):
 blocks=[]; remain=n
 while remain>0:
  A=rng.standard_normal((w,w)); Q,R=np.linalg.qr(A); # fix signs
  Q=Q*np.sign(np.diag(R))[None,:]
  # rows of Q are orthonormal; uniform under Haar too
  take=min(remain,w); blocks.append(Q[:take]); remain-=take
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def pred(weights,n,seed,kind='lattice',wh=True,sh=2,corr=1.125):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed)
 if kind=='lattice': hd=dirs_lattice(n//2,w,rng,sh)
 elif kind=='orth': hd=dirs_orth(n//2,w,rng)
 else: hd=dirs_rand(n//2,w,rng)
 T=white(hd) if wh else np.eye(w); x=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(x@(T@weights[0]),0); ef=exact_first(weights[0]); rows=[ef]; mc=ef-a.mean(0)
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); mc=(mc@W)*gate; rows.append(a.mean(0)+corr*mc)
 return np.array(rows)
def target(weights,N=200000,seed=0,batch=50000):
 w=weights[0].shape[0]; sums=np.zeros((len(weights),w)); rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=b
 return sums/N
def bench(w,d,n,T=12):
 cfg=[('lat2w',dict(kind='lattice',sh=2,wh=True)),('lat1w',dict(kind='lattice',sh=1,wh=True)),('lat4w',dict(kind='lattice',sh=4,wh=True)),('randw',dict(kind='rand',wh=True)),('orth',dict(kind='orth',wh=False)),('orthw',dict(kind='orth',wh=True)),('rand',dict(kind='rand',wh=False))]
 vals={k:[] for k,_ in cfg}
 for t in range(T):
  rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; tar=target(weights,N=200000 if w<=64 else 100000,seed=2000+t)
  for k,kw in cfg:
   pr=pred(weights,n,seed=3000+t,**kw); vals[k].append(((pr[-1]-tar[-1])**2).mean())
 print('\\nCASE',w,d,n)
 for mean,med,k in sorted((np.mean(v),np.median(v),k) for k,v in vals.items()): print(k,mean,med)
for c in [(32,8,128),(64,8,256),(128,8,512),(64,4,256),(128,4,512)]: bench(*c,T=16)

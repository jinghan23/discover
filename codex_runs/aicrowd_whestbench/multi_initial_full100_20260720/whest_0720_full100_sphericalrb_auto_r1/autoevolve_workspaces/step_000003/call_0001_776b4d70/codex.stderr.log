import numpy as np, math, time

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def mean_chi(d):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*d+0.5)-math.lgamma(0.5*d))

def lattice_normals(n,w,rng,tail=1e-11):
    roots=np.sqrt(first_primes(w))
    gen=roots-np.floor(roots)
    shift=rng.random(w)
    idx=np.arange(n)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    u=np.clip(u,tail,1-tail)
    from scipy.stats import norm
    return norm.ppf(u)

def qmc_dirs(n,w,rng,shifts=2):
    blocks=[]; base=n//shifts; rem=n-base*shifts
    for i in range(shifts):
        c=base+(i<rem)
        z=lattice_normals(c,w,rng)
        z=z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
        blocks.append(z)
    return np.concatenate(blocks,0)

def whitening(dirs):
    n,w=dirs.shape
    S=dirs.T@dirs*(w/n)
    e,V=np.linalg.eigh(S)
    e=np.maximum(e,1e-8)
    return (V/np.sqrt(e))@V.T

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def current(weights,n=256,seed=0,gate_corr=1.125,shifts=2,white=True):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2
    hd=qmc_dirs(half,w,rng,shifts=shifts)
    T=whitening(hd) if white else np.eye(w)
    x=np.concatenate([hd,-hd])*mean_chi(w)
    acts=np.maximum(x@(T@weights[0]),0)
    rows=[]; ef=exact_first(weights[0]); rows.append(ef)
    mc=ef-acts.mean(0)
    for W in weights[1:]:
        pre=acts@W
        gate=(pre>0).mean(0)
        acts=np.maximum(pre,0)
        mc=(mc@W)*gate
        rows.append(acts.mean(0)+gate_corr*mc)
    return np.array(rows)

def diag(weights):
    rows=[]
    # input mean 0 second 1 independent
    m=None; q=None
    for li,W in enumerate(weights):
        if li==0:
            mu=np.zeros(W.shape[1]); var=(W*W).sum(0)
        else:
            mu=m@W
            var=(q-m*m)@(W*W)
            var=np.maximum(var,1e-30)
        sig=np.sqrt(var); a=mu/sig
        # Phi/phi
        from scipy.special import ndtr
        Phi=ndtr(a); phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
        m=sig*phi+mu*Phi
        second=(mu*mu+var)*Phi+mu*sig*phi
        q=second
        rows.append(m)
    return np.array(rows)

def mc_target(weights,N=200000,seed=123,batch=20000):
    w=weights[0].shape[0]; d=len(weights)
    sums=np.zeros((d,w)); rng=np.random.default_rng(seed); done=0
    while done<N:
        b=min(batch,N-done); x=rng.standard_normal((b,w));
        for li,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[li]+=x.sum(0)
        done+=b
    return sums/N

def trial(w=32,d=8,n=256,std='he',T=20):
    ratios=[]; mses=[]
    for t in range(T):
        rng=np.random.default_rng(1000+t)
        scale=(math.sqrt(2/w) if std=='he' else 1/math.sqrt(w))
        weights=[rng.standard_normal((w,w))*scale for _ in range(d)]
        target=mc_target(weights,N=100000,seed=2000+t,batch=20000)
        cur=current(weights,n=n,seed=3000+t)
        dg=diag(weights)
        # try blends final only all rows same alpha
        vals=[]
        for a in [0,0.25,0.5,0.75,1,1.1,1.25,1.5]:
            pred=cur*a+dg*(1-a)
            vals.append(((pred[-1]-target[-1])**2).mean())
        mses.append(vals)
    print('w d n',w,d,n,std)
    arr=np.array(mses)
    print('alphas', [0,0.25,0.5,0.75,1,1.1,1.25,1.5])
    print('mean', arr.mean(0))
    print('median', np.median(arr,0))

for w,d,n in [(16,6,128),(32,8,256),(64,8,256),(64,16,512)]:
    trial(w,d,n,'he',T=5)

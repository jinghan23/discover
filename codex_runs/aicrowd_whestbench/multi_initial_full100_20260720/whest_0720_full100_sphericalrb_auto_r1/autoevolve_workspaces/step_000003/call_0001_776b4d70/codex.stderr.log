 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng,shifts=sh,kind=kind); T=white(hd) if wh else np.eye(w); x=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(x@(T@weights[0]),0); ef=exact_first(weights[0]); rows=[ef]; mc=ef-a.mean(0)
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); mc=(mc@W)*gate; rows.append(a.mean(0)+corr*mc)
 return np.array(rows)
def target(weights,N=300000,seed=99,batch=50000):
 w=weights[0].shape[0]; sums=np.zeros((len(weights),w)); rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=b
 return sums/N
def bench(cases,T=20):
 for w,d,n in cases:
  cfg=[]
  for corr in [0,.25,.5,.75,.9,1.0,1.05,1.1,1.125,1.15,1.2,1.3]: cfg.append(('c'+str(corr),dict(corr=corr)))
  for sh in [1,2,3,4,6,8]: cfg.append(('s'+str(sh),dict(sh=sh,corr=1.125)))
  cfg += [('nowh',dict(wh=False,corr=1.125)),('rand',dict(kind='random',corr=1.125))]
  vals={k:[] for k,_ in cfg}
  for t in range(T):
   rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
   tar=target(weights,N=200000 if w<=64 else 100000,seed=2000+t)
   for k,kw in cfg:
    pr=pred(weights,n=n,seed=3000+t,**kw); vals[k].append(((pr[-1]-tar[-1])**2).mean())
  print('\\nCASE',w,d,n)
  best=[]
  for k,v in vals.items():
   arr=np.array(v); best.append((arr.mean(),np.median(arr),k))
  for mean,med,k in sorted(best)[:12]: print(k,mean,med)

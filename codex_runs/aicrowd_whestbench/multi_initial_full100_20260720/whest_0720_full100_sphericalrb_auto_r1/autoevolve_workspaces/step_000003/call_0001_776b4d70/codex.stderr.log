Since current prediction FLOPs often sit below the 0.1 multiplier floor, increasing samples can be nearly free in score terms. I’m testing sample scaling on synthetic cases to see whether QMC error falls fast enough to justify a higher target fraction.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
P={}
def gen(w):
 if w not in P:P[w]=np.sqrt(primes(w))%1
 return P[w]
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng,sh=2):
 blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*gen(w)[None,:]+rng.random(w)[None,:])%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def pred(weights,n,seed,sh=2):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng,sh=sh); T=white(hd); x=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(x@(T@weights[0]),0); ef=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); mc=ef-a.mean(0)
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); mc=(mc@W)*gate
 return a.mean(0)+1.125*mc
def target(weights,N=300000,seed=0,batch=50000):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=b
 return s/N
def bench(w,d,n0,T=20):
 mults=[0.5,0.75,1,1.25,1.5,2,3,4]
 vals={m:[] for m in mults}
 for t in range(T):
  rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; tar=target(weights,N=200000 if w<=64 else 100000,seed=2000+t)
  for m in mults:
   n=max(32,int(n0*m)//2*2); pr=pred(weights,n,3000+t); vals[m].append(((pr-tar)**2).mean())
 print('\\nCASE',w,d,n0)
 base=np.mean(vals[1])
 for m in mults:
  mean=np.mean(vals[m]); adj=mean*max(0.1,0.09*m) # assume base frac .09
  print(m, 'mse',mean,'ratio',mean/base,'adj_rel',adj/(base*0.1))
for c in [(32,8,128),(64,8,256),(128,8,512),(64,4,256),(128,4,512)]: bench(*c,T=12)

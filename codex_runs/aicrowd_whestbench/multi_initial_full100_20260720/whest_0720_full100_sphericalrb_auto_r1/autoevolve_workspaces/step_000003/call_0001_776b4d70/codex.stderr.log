import numpy as np, math
from scipy.stats import norm

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
P={}
def gen(w):
 if w not in P:P[w]=np.sqrt(primes(w))%1
 return P[w]
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng,sh=2):
 blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*gen(w)+rng.random(w))%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def pred(weights,n,seed,sh):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng,sh=sh); x=np.concatenate([hd@white(hd),-(hd@white(hd))])*mean_chi(w); a=np.maximum(x@weights[0],0); ef=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); corr=ef-a.mean(0)
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); corr=(corr@W)*gate
 return a.mean(0)+1.125*corr
def target(weights,N=150000,seed=0,batch=50000):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=b
 return s/N
def bench(w,d,n,T=16):
 vals={sh:[] for sh in [1,2,3,4,6,8]}
 for t in range(T):
  rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; tar=target(weights,seed=2000+t)
  for sh in vals: vals[sh].append(((pred(weights,n,3000+t,sh)-tar)**2).mean())
 print('\\nCASE',w,d,n)
 for sh,v in sorted((sh,np.mean(v),np.median(v)) for sh,v in vals.items()): print(sh,v)
for c in [(32,8,506),(64,8,114),(64,8,1314),(128,8,304),(128,4,608)]: bench(*c,T=10)

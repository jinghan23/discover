codex
One promising low-cost correction is to keep the same propagated samples, but estimate each neuron’s ReLU mean from the sample preactivation mean and variance under a one-dimensional Gaussian approximation. I’m testing it as a final-row variance reducer and as a blend with the raw sample mean.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm
from scipy.special import ndtr

def primes(count):
 p=[]; c=2
 while len(p)<count:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
P={}
def gen(w):
 if w not in P: P[w]=np.sqrt(primes(w))%1
 return P[w]
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng,sh=2):
 blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*gen(w)[None,:]+rng.random(w)[None,:])%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def relu_gauss(mu,var):
 sig=np.sqrt(np.maximum(var,1e-30)); a=mu/sig; return sig*np.exp(-0.5*a*a)/math.sqrt(2*math.pi)+mu*ndtr(a)
def pred(weights,n=256,seed=0,corr=1.125,beta=0.0,final_beta=None):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng,2); x=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(x@(white(hd)@weights[0]),0); ef=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); rows=[ef]; mc=ef-a.mean(0)
 for li,W in enumerate(weights[1:],1):
  pre=a@W; gate=(pre>0).mean(0); raw=np.maximum(pre,0); base=raw.mean(0); gauss=relu_gauss(pre.mean(0), pre.var(0))
  a=raw; mc=(mc@W)*gate; corrected=base+corr*mc
  b=beta if final_beta is None or li<len(weights)-1 else final_beta
  rows.append((1-b)*corrected + b*gauss)
 return np.array(rows)
def target(weights,N=200000,seed=99,batch=50000):
 w=weights[0].shape[0]; sums=np.zeros((len(weights),w)); rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=b
 return sums/N
def bench(w,d,n,T=20,scale='xavier'):
 cfg=[]
 for beta in [-.5,-.25,0,.1,.25,.5,.75,1.0,1.25]: cfg.append(('allb'+str(beta),dict(beta=beta)))
 for fb in [-.5,-.25,0,.1,.25,.5,.75,1.0,1.25]: cfg.append(('finalb'+str(fb),dict(beta=0,final_beta=fb)))
 vals={k:[] for k,_ in cfg}
 for t in range(T):
  rng=np.random.default_rng(1000+t); sc=1/math.sqrt(w) if scale=='xavier' else math.sqrt(2/w); weights=[rng.standard_normal((w,w))*sc for _ in range(d)]; tar=target(weights,N=200000 if w<=64 else 100000,seed=2000+t)
  for k,kw in cfg:
   pr=pred(weights,n=n,seed=3000+t,**kw); vals[k].append(((pr[-1]-tar[-1])**2).mean())
 print('\\nCASE',w,d,n,scale)
 for mean,med,k in sorted((np.mean(v),np.median(v),k) for k,v in vals.items())[:12]: print(k,mean,med)
for case in [(32,8,128),(64,8,256),(128,8,512),(64,4,256),(128,4,512)]: bench(*case,T=12)

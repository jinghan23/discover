codex
Another inexpensive correction is first-layer moment matching: after the exact first ReLU mean, also rescale sampled first-layer columns to match the exact first-layer variance before propagating deeper. I’m testing whether that reduces downstream error or distorts the sample distribution too much.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
P={}
def gen(w):
 if w not in P:P[w]=np.sqrt(primes(w))%1
 return P[w]
def mean_chi(d):return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def dirs(n,w,rng,sh=2):
 blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  c=base+(i<rem); u=(np.arange(c)[:,None]*gen(w)+rng.random(w))%1; u=np.clip(u,1e-11,1-1e-11); z=norm.ppf(u); z/=np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]; blocks.append(z)
 return np.concatenate(blocks)
def white(D):
 n,w=D.shape; e,V=np.linalg.eigh(D.T@D*(w/n)); e=np.maximum(e,1e-8); return (V/np.sqrt(e))@V.T
def first_mom(W):
 s2=(W*W).sum(0); m=np.sqrt(s2)/math.sqrt(2*math.pi); q=0.5*s2; v=q-m*m; return m,v
def pred(weights,n,seed,mode='base',corr=1.125):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); hd=dirs(n//2,w,rng); T=white(hd); x=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(x@(T@weights[0]),0); m1,v1=first_mom(weights[0]); rows=[m1]; mc=m1-a.mean(0)
 if mode in ['diag','diag_center']:
  sm=a.mean(0); sv=np.maximum((a*a).mean(0)-sm*sm,1e-30); scale=np.sqrt(np.maximum(v1,1e-30)/sv)
  if mode=='diag_center': a=(a-sm)*scale+m1
  else: a=a*scale # matches second not mean maybe
 for W in weights[1:]: pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); mc=(mc@W)*gate; rows.append(a.mean(0)+corr*mc)
 return np.array(rows)
def target(weights,N=200000,seed=0,batch=50000):
 w=weights[0].shape[0]; sums=np.zeros((len(weights),w)); rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); x=rng.standard_normal((b,w))
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=b
 return sums/N
def bench(w,d,n,T=16):
 cfg=['base','diag','diag_center']
 vals={k:[] for k in cfg}
 for t in range(T):
  rng=np.random.default_rng(1000+t); weights=[rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]; tar=target(weights,N=200000 if w<=64 else 100000,seed=2000+t)
  for k in cfg: vals[k].append(((pred(weights,n,3000+t,k)[-1]-tar[-1])**2).mean())
 print('\\nCASE',w,d,n)
 for k,v in vals.items(): print(k,np.mean(v),np.median(v))
for c in [(32,8,128),(64,8,256),(128,8,512),(64,4,256),(128,4,512)]: bench(*c)

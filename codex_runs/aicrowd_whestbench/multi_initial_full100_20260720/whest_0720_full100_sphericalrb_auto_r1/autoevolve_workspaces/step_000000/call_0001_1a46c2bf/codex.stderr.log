diff --git a/submission.py b/submission.py
index b3190fbc63eb01d3732da03700499c3b33b6b1c3..3333dcd6b9b121671a461ecf15b367e3093e9532
--- a/submission.py
+++ b/submission.py
@@ -347,6 +347,7 @@
     """Half-lattice antithetic spherical RQMC with angular moment matching."""
 
     target_flop_fraction = 0.10
+    final_control_ridge = 1e-8
 
     def predict(self, mlp, budget: int) -> fnp.ndarray:
         n_samples = whitened_antithetic_sample_count(
@@ -373,10 +374,27 @@
 
         rows = []
         activations = fnp.maximum(activations @ first_weight, 0.0)
-        rows.append(_exact_first_layer_mean(mlp.weights[0]))
-        for weights in mlp.weights[1:]:
+        exact_first_mean = _exact_first_layer_mean(mlp.weights[0])
+        first_sample_mean = fnp.mean(activations, axis=0)
+        first_centered = activations - first_sample_mean[None, :]
+        gram = first_centered.T @ first_centered
+        ridge = (
+            self.final_control_ridge
+            * fnp.sum(first_centered * first_centered)
+            / float(mlp.width)
+        )
+        gram = gram + ridge * fnp.eye(mlp.width)
+        first_mean_error = first_sample_mean - exact_first_mean
+
+        rows.append(exact_first_mean)
+        for layer_index, weights in enumerate(mlp.weights[1:], start=1):
             activations = fnp.maximum(activations @ weights, 0.0)
-            rows.append(fnp.mean(activations, axis=0))
+            row = fnp.mean(activations, axis=0)
+            if layer_index == mlp.depth - 1:
+                cross = first_centered.T @ (activations - row[None, :])
+                coefficients = fnp.linalg.solve(gram, cross)
+                row = row - first_mean_error @ coefficients
+            rows.append(row)
 
         return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
 


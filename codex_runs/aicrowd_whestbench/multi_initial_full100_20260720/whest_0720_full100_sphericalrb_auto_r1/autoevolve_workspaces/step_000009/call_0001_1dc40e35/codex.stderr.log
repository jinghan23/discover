import math, numpy as np
from scipy.stats import norm
TAIL=1e-9; WHITEN=1e-8
# reuse small funcs
def primes(k):
 p=[]; c=2
 while len(p)<k:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def dirs_lattice(n,w,rng):
 gen=np.sqrt(primes(w))%1; blocks=[]; base=n//2; rem=n-2*base
 for i in range(2):
  m=base+(i<rem); u=(np.arange(m)[:,None]*gen[None,:]+rng.random(w)[None,:])%1; z=norm.ppf(np.clip(u,TAIL,1-TAIL)); blocks.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(blocks)
def dirs_lhs(n,w,rng):
 U=np.empty((n,w))
 # one independent jitter per cell and dim
 for j in range(w):
  U[:,j]=(rng.permutation(n)+rng.random(n))/n
 U=np.clip(U,TAIL,1-TAIL); Z=norm.ppf(U); return Z/np.sqrt((Z*Z).sum(1))[:,None]
def dirs_lhs_shift(n,w,rng,blocks=2):
 # split in blocks, each LHS
 out=[]; base=n//blocks; rem=n-base*blocks
 for b in range(blocks):
  out.append(dirs_lhs(base+(b<rem),w,rng))
 return np.concatenate(out)
def whiten(D):
 n,w=D.shape; M=D.T@D*(w/n); val,vec=np.linalg.eigh(M); return (vec/np.sqrt(np.maximum(val,WHITEN)))@vec.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def est(weights,n,seed,mode='lat'):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); D={'lat':dirs_lattice,'lhs':dirs_lhs,'lhs2':lambda n,w,r: dirs_lhs_shift(n,w,r,2),'lhs4':lambda n,w,r: dirs_lhs_shift(n,w,r,4)}[mode](n//2,w,rng); T=whiten(D); A=np.concatenate([D,-D])*mean_chi(w); A=np.maximum(A@(T@weights[0]),0); ef=exact_first(weights[0]); corr=ef-A.mean(0); rows=[ef]
 for W in weights[1:]:
  P=A@W; g=(P>0).mean(0); A=np.maximum(P,0); corr=(corr@W)*g; rows.append(A.mean(0)+1.05*corr)
 return np.stack(rows)
def tgt(weights,m,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); total=np.zeros((len(weights),w)); done=0; bsz=10000
 while done<m:
  b=min(bsz,m-done); z=rng.standard_normal((b,w)); z=z/np.sqrt((z*z).sum(1))[:,None]*mean_chi(w); A=z
  for i,W in enumerate(weights): A=np.maximum(A@W,0); total[i]+=A.sum(0)
  done+=b
 return total/m
for w,d,n,seeds in [(16,8,512,20),(32,12,512,8),(64,8,512,4)]:
 vals={m:[] for m in ['lat','lhs','lhs2','lhs4']}
 for s in range(seeds):
  rng=np.random.default_rng(100+s); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]; y=tgt(weights,60000,900+s)
  for m in vals:
   e=est(weights,n,1234+s,m); vals[m].append(((e[-1]-y[-1])**2).mean())
 base=np.mean(vals['lat']); print('\\ncase',w,d,base)
 for m,v in vals.items(): print(m, np.mean(v)/base, end=' ')
 print()

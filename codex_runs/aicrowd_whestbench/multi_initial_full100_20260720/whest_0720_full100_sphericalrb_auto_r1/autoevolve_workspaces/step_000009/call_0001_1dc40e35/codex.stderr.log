import math, numpy as np
from scipy.stats import norm

TAIL=1e-9
WHITEN=1e-8

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def lattice_normals(n,w,rng,shift=None):
    roots=np.sqrt(first_primes(w))
    gen=roots-np.floor(roots)
    if shift is None: shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    return norm.ppf(u)

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def directions(half,w,rng,shifts=2):
    base=half//shifts; rem=half-base*shifts; blocks=[]
    for i in range(shifts):
        m=base+(i<rem)
        z=lattice_normals(m,w,rng)
        r=np.sqrt(np.maximum((z*z).sum(1),1e-24))
        blocks.append(z/r[:,None])
    return np.concatenate(blocks,0)

def whitening(D):
    n,w=D.shape
    M=D.T@D*(w/n)
    vals,vecs=np.linalg.eigh(M)
    vals=np.maximum(vals,WHITEN)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def zero_cov(C):
    var=np.maximum(np.diag(C),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]
    corr=np.clip(C/scale,-1,1)
    sec=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    m=sd/math.sqrt(2*math.pi)
    return sec-m[:,None]*m[None,:]

def analytic(weights,w,second=False):
    mean=np.zeros(w); cov=np.eye(w); rows=[]; normalizer=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd
        gate=norm.cdf(z); dens=np.exp(-0.5*z*z)*normalizer
        nm=sd*dens+pm*gate
        sec=(pm*pm+var)*gate+pm*sd*dens
        nv=np.maximum(sec-nm*nm,1e-24)
        if li==0:
            cov=zero_cov(pc)
        else:
            lin=pc*gate[:,None]*gate[None,:]
            if second:
                add=0.5*(pc*pc)*(dens[:,None]*dens[None,:])/(sd[:,None]*sd[None,:])
                lin=lin+add
            cov=lin+np.diag(nv-np.diag(lin))
        mean=nm; rows.append(mean)
    return np.stack(rows)

def estimate(weights,n,seed,gate_corr=1.05,blend=0.05,scale_first=False,scale_each=False,second_corr=False,analytic_second=False,qmc_shifts=2):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2
    D=directions(half,w,rng,qmc_shifts); T=whitening(D); W0=T@weights[0]
    A=np.concatenate([D,-D],0)*mean_chi(w)
    rows=[]; A=np.maximum(A@W0,0)
    ef=exact_first(weights[0]); rows.append(ef)
    sample=A.mean(0); mcorr=ef-sample
    if scale_first:
        s=ef/np.maximum(sample,1e-12); A=A*s[None,:]; mcorr=ef-A.mean(0)
    normc=1/math.sqrt(2*math.pi)
    for W in weights[1:]:
        P=A@W
        delta=mcorr@W
        gate=(P>0).mean(0)
        outcorr=delta*gate
        if second_corr:
            sd=np.sqrt(np.maximum(P.var(0),1e-24)); mu=P.mean(0); z=mu/sd
            dens=np.exp(-0.5*z*z)*normc/sd
            outcorr=outcorr+0.5*delta*delta*dens
        A=np.maximum(P,0)
        base=A.mean(0)
        row=base+gate_corr*outcorr
        rows.append(row)
        mcorr=row-base # or outcorr? current coefficient included? current updates mean_correction before coeff? current mcorr = delta*gate, rows add coeff*mcorr; next uses unscaled mcorr. 
        # match current behavior: next mcorr should outcorr, not coeff*outcorr
        mcorr=outcorr
        if scale_each:
            s=row/np.maximum(base,1e-12); A=A*s[None,:]
            mcorr=row-A.mean(0)
    q=np.stack(rows)
    if blend:
        an=analytic(weights,w,second=analytic_second)
        q=(1-blend)*q+blend*an
    return q

def target(weights,m,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed)
    # use random directions + radial mean for exact expectation estimate
    batch=20000; total=np.zeros((len(weights),w)); done=0
    while done<m:
        b=min(batch,m-done)
        z=rng.standard_normal((b,w)); r=np.sqrt(np.maximum((z*z).sum(1),1e-24)); A=z/r[:,None]*mean_chi(w)
        for i,W in enumerate(weights):
            A=np.maximum(A@W,0); total[i]+=A.sum(0)
        done+=b
    return total/m

def run(w=32,d=8,n=512,seeds=10,scale=math.sqrt(2)):
    configs=[
      ('base',{}),('blend0',{'blend':0}),('blend02',{'blend':0.02}),('blend10',{'blend':0.10}),('gate1',{'gate_corr':1.0}),('gate11',{'gate_corr':1.1}),('scale1',{'scale_first':True}),('scale_each',{'scale_first':True,'scale_each':True}),('secondcorr',{'second_corr':True}),('an2',{'analytic_second':True}),('an2b10',{'analytic_second':True,'blend':0.10}),('sh1',{'qmc_shifts':1}),('sh4',{'qmc_shifts':4}),]
    vals={name:[] for name,_ in configs}
    for s in range(seeds):
        rng=np.random.default_rng(1000+s)
        weights=[rng.standard_normal((w,w))*scale/math.sqrt(w) for _ in range(d)]
        tgt=target(weights,50000,9000+s)
        for name,kw in configs:
            est=estimate(weights,n,1234+s,**kw)
            vals[name].append(((est[-1]-tgt[-1])**2).mean())
        print('seed',s, {k: f'{np.mean(v):.2e}' for k,v in vals.items() if v})
    print('FINAL')
    base=np.mean(vals['base'])
    for k,v in vals.items():
        print(k, np.mean(v), 'rel', np.mean(v)/base)


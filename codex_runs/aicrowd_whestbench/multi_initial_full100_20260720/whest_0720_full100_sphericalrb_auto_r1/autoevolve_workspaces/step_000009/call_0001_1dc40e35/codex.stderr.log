# Reports relative final-layer MSE for hyperparameter variants; no evaluator data is touched.
import math, numpy as np
from scipy.stats import norm
TAIL=1e-9; WHITEN=1e-8

def primes(k):
 p=[]; c=2
 while len(p)<k:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def dirs(n,w,rng,sh=2):
 gen=np.sqrt(primes(w))%1; blocks=[]; base=n//sh; rem=n-base*sh
 for i in range(sh):
  m=base+(i<rem); u=(np.arange(m)[:,None]*gen[None,:]+rng.random(w)[None,:])%1
  z=norm.ppf(np.clip(u,TAIL,1-TAIL)); r=np.sqrt((z*z).sum(1)); blocks.append(z/r[:,None])
 return np.concatenate(blocks)
def whiten(D):
 n,w=D.shape; M=D.T@D*(w/n); val,vec=np.linalg.eigh(M); val=np.maximum(val,WHITEN); return (vec/np.sqrt(val))@vec.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def zero_cov(C):
 var=np.maximum(np.diag(C),1e-24); sd=np.sqrt(var); sc=sd[:,None]*sd[None,:]; rho=np.clip(C/sc,-1,1)
 sec=sc*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi); m=sd/math.sqrt(2*math.pi); return sec-m[:,None]*m[None,:]
def analytic(weights,w):
 mean=np.zeros(w); cov=np.eye(w); rows=[]; normalizer=1/math.sqrt(2*math.pi)
 for li,W in enumerate(weights):
  pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd; gate=norm.cdf(z); dens=np.exp(-.5*z*z)*normalizer
  nm=sd*dens+pm*gate; sec=(pm*pm+var)*gate+pm*sd*dens; nv=np.maximum(sec-nm*nm,1e-24)
  if li==0: cov=zero_cov(pc)
  else:
   lin=pc*gate[:,None]*gate[None,:]; cov=lin+np.diag(nv-np.diag(lin))
  mean=nm; rows.append(mean)
 return np.stack(rows)
def est(weights,n,seed,gate=1.05,blend=.05,sh=2,tail=1e-9,offset=0):
 global TAIL; old=TAIL; TAIL=tail
 w=weights[0].shape[0]; rng=np.random.default_rng((seed+offset)&0xffffffff); D=dirs(n//2,w,rng,sh); T=whiten(D); A=np.concatenate([D,-D])*mean_chi(w); A=np.maximum(A@(T@weights[0]),0); rows=[]; ef=exact_first(weights[0]); rows.append(ef); corr=ef-A.mean(0)
 for W in weights[1:]:
  P=A@W; g=(P>0).mean(0); A=np.maximum(P,0); corr=(corr@W)*g; rows.append(A.mean(0)+gate*corr)
 q=np.stack(rows); TAIL=old
 if blend: q=(1-blend)*q+blend*analytic(weights,w)
 return q
def tgt(weights,m,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); total=np.zeros((len(weights),w)); bsz=10000; done=0
 while done<m:
  b=min(bsz,m-done); z=rng.standard_normal((b,w)); z=z/np.sqrt((z*z).sum(1))[:,None]*mean_chi(w); A=z
  for i,W in enumerate(weights): A=np.maximum(A@W,0); total[i]+=A.sum(0)
  done+=b
 return total/m
configs=[('base',{}),('gate0.9',{'gate':.9}),('gate1',{'gate':1.0}),('gate1.1',{'gate':1.1}),('blend0',{'blend':0}),('blend.02',{'blend':.02}),('blend.08',{'blend':.08}),('sh1',{'sh':1}),('sh3',{'sh':3}),('sh4',{'sh':4}),('tail1e-6',{'tail':1e-6}),('off1',{'offset':1}),('off17',{'offset':17})]
for w,d,n,seeds,mc in [(16,8,512,20,80000),(32,12,512,8,60000),(64,8,512,4,50000),(64,16,512,4,40000)]:

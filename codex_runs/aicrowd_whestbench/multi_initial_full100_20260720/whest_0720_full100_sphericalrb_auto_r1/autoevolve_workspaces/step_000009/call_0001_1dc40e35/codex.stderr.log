import math, numpy as np
from scipy.stats import norm
TAIL=1e-9; WHITEN=1e-8; normalizer=1/math.sqrt(2*math.pi)
def primes(k):
 p=[]; c=2
 while len(p)<k:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def dirs(n,w,rng):
 gen=np.sqrt(primes(w))%1; out=[]; base=n//2; rem=n-2*base
 for i in range(2):
  m=base+(i<rem); u=(np.arange(m)[:,None]*gen+rng.random(w))%1; z=norm.ppf(np.clip(u,TAIL,1-TAIL)); out.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(out)
def whiten(D):
 n,w=D.shape; M=D.T@D*(w/n); val,vec=np.linalg.eigh(M); return (vec/np.sqrt(np.maximum(val,WHITEN)))@vec.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def zero_cov(C):
 var=np.maximum(np.diag(C),1e-24); sd=np.sqrt(var); sc=sd[:,None]*sd[None,:]; rho=np.clip(C/sc,-1,1)
 sec=sc*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi); m=sd/math.sqrt(2*math.pi); return sec-m[:,None]*m[None,:]
def analytic(weights,w):
 mean=np.zeros(w); cov=np.eye(w); rows=[]
 for li,W in enumerate(weights):
  pm=mean@W; pc=W.T@cov@W; var=np.maximum(np.diag(pc),1e-24); sd=np.sqrt(var); z=pm/sd; gate=norm.cdf(z); dens=np.exp(-.5*z*z)*normalizer
  nm=sd*dens+pm*gate; sec=(pm*pm+var)*gate+pm*sd*dens; nv=np.maximum(sec-nm*nm,1e-24)
  if li==0: cov=zero_cov(pc)
  else:
   lin=pc*gate[:,None]*gate[None,:]; cov=lin+np.diag(nv-np.diag(lin))
  mean=nm; rows.append(mean)
 return np.stack(rows)
def est(weights,n,seed,a=0,gain=1.1,finalblend=.05):
 w=weights[0].shape[0]; an=analytic(weights,w); rng=np.random.default_rng(seed); D=dirs(n//2,w,rng); T=whiten(D); A=np.concatenate([D,-D])*mean_chi(w); A=np.maximum(A@(T@weights[0]),0); ef=exact_first(weights[0]); corr=ef-A.mean(0); rows=[ef]
 for li,W in enumerate(weights[1:], start=1):
  P=A@W; g=(P>0).mean(0); A=np.maximum(P,0); base=A.mean(0); qc=(corr@W)*g; ac=an[li]-base; corr=(1-a)*qc+a*ac; rows.append(base+gain*corr)
 q=np.stack(rows); return (1-finalblend)*q+finalblend*an
def tgt(weights,m,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); total=np.zeros((len(weights),w)); done=0; bsz=10000
 while done<m:
  b=min(bsz,m-done); z=rng.standard_normal((b,w)); z=z/np.sqrt((z*z).sum(1))[:,None]*mean_chi(w); A=z
  for i,W in enumerate(weights): A=np.maximum(A@W,0); total[i]+=A.sum(0)
  done+=b
 return total/m
alphas=[0,.02,.05,.1,.2]
for w,d,n,seeds in [(16,8,512,20),(32,12,512,8),(64,8,512,4),(64,16,512,4)]:
 vals={a:[] for a in alphas}
 for s in range(seeds):
  rng=np.random.default_rng(100+s); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]; y=tgt(weights,60000,900+s)
  for a in alphas:
   e=est(weights,n,1234+s,a); vals[a].append(((e[-1]-y[-1])**2).mean())
 base=np.mean(vals[0]); print('\\ncase',w,d,base)
 for a,v in vals.items(): print(a, f'{np.mean(v)/base:.3f}', end=' ')
 print()

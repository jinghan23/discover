codex
I’m testing a nonlinear version of the mean correction locally: use a Gaussian ReLU moment to estimate how a corrected preactivation mean changes the post-ReLU mean, instead of only multiplying by the empirical gate.
exec
/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy.stats import norm
TAIL=1e-9; WHITEN=1e-8; normalizer=1/math.sqrt(2*math.pi)
def primes(k):
 p=[]; c=2
 while len(p)<k:
  ok=True
  for q in p:
   if q*q>c: break
   if c%q==0: ok=False; break
  if ok:p.append(c)
  c+=1
 return np.array(p)
def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def dirs(n,w,rng):
 gen=np.sqrt(primes(w))%1; out=[]; base=n//2; rem=n-2*base
 for i in range(2):
  m=base+(i<rem); u=(np.arange(m)[:,None]*gen+rng.random(w))%1; z=norm.ppf(np.clip(u,TAIL,1-TAIL)); out.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(out)
def whiten(D):
 n,w=D.shape; M=D.T@D*(w/n); val,vec=np.linalg.eigh(M); return (vec/np.sqrt(np.maximum(val,WHITEN)))@vec.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def relu_gauss(mu,sd):
 z=mu/sd; return sd*np.exp(-.5*z*z)*normalizer + mu*norm.cdf(z)
def est(weights,n,seed,mode='gate',gain=1.1):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); D=dirs(n//2,w,rng); T=whiten(D); A=np.concatenate([D,-D])*mean_chi(w); A=np.maximum(A@(T@weights[0]),0); ef=exact_first(weights[0]); corr=ef-A.mean(0); rows=[ef]
 for W in weights[1:]:
  P=A@W; delta=corr@W
  if mode=='gaussshift':
   mu=P.mean(0); sd=np.sqrt(np.maximum(P.var(0),1e-24)); c=relu_gauss(mu+delta,sd)-relu_gauss(mu,sd)
  elif mode=='blendshift':
   g=(P>0).mean(0); c1=delta*g; mu=P.mean(0); sd=np.sqrt(np.maximum(P.var(0),1e-24)); c2=relu_gauss(mu+delta,sd)-relu_gauss(mu,sd); c=.5*c1+.5*c2
  else:
   c=delta*(P>0).mean(0)
  A=np.maximum(P,0); corr=c; rows.append(A.mean(0)+gain*corr)
 return np.stack(rows)
def tgt(weights,m,seed):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); total=np.zeros((len(weights),w)); done=0; bsz=10000
 while done<m:
  b=min(bsz,m-done); z=rng.standard_normal((b,w)); z=z/np.sqrt((z*z).sum(1))[:,None]*mean_chi(w); A=z
  for i,W in enumerate(weights): A=np.maximum(A@W,0); total[i]+=A.sum(0)
  done+=b
 return total/m
for w,d,n,seeds in [(16,8,512,20),(32,12,512,8),(64,8,512,4),(64,16,512,4)]:
 vals={m:[] for m in ['gate','gaussshift','blendshift']}
 for s in range(seeds):
  rng=np.random.default_rng(100+s); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]; y=tgt(weights,60000,900+s)
  for m in vals:
   e=est(weights,n,1234+s,m); vals[m].append(((e[-1]-y[-1])**2).mean())
 base=np.mean(vals['gate']); print('\\ncase',w,d,base)
 for m,v in vals.items(): print(m, np.mean(v)/base, end=' ')
 print()
PY" in /opt/tiger/discover/workspace

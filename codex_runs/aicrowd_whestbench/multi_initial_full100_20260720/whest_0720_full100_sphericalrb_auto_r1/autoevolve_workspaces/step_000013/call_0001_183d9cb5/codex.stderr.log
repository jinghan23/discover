+    2.07684797867783,
+    3.2054290028564703,
+    4.5127458633997835,
+)
+_GH_WEIGHTS = (
+    2.2345844007746576e-05,
+    0.0027891413212317653,
+    0.04991640676521791,
+    0.2440975028949394,
+    0.4063492063492064,
+    0.2440975028949394,
+    0.04991640676521791,
+    0.0027891413212317653,

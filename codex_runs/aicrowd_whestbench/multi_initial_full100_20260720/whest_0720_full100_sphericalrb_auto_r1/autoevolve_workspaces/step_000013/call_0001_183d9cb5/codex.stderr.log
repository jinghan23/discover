 _ANALYTIC_BLEND = 0.075
 _SETUP_DIRECTION_SETS = 1
 _SETUP_SEED_OFFSET = 0
+_GH_NODES = (
+    -4.5127458633997835,
+    -3.2054290028564703,
+    -2.07684797867783,

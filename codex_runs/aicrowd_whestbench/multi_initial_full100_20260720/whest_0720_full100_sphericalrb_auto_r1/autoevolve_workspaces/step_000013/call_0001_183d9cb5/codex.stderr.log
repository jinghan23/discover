+)
 
 
 def _sample_count(budget: int, width: int, depth: int) -> int:
@@ -107,6 +129,40 @@
     return second_moment - mean[:, None] * mean[None, :]
 
 
+def _quadrature_relu_covariance(
+    pre_mean: fnp.ndarray,
+    pre_covariance: fnp.ndarray,
+    next_mean: fnp.ndarray,
+    next_variance: fnp.ndarray,
+) -> fnp.ndarray:
+    variance = fnp.maximum(fnp.diag(pre_covariance), 1e-24)
+    standard_deviation = fnp.sqrt(variance)
+    scale = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(pre_covariance / scale, -1.0, 1.0)
+    residual = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 1e-12))
+
+    nodes = fnp.array(_GH_NODES, dtype=fnp.float32)[:, None, None]
+    weights = fnp.array(_GH_WEIGHTS, dtype=fnp.float32)[:, None, None]
+    density_normalizer = 1.0 / fnp.sqrt(2.0 * fnp.pi)
+
+    x_value = pre_mean[None, :, None] + standard_deviation[None, :, None] * nodes
+    x_positive = fnp.maximum(x_value, 0.0)
+    conditional_deviation = standard_deviation[None, None, :] * residual[None, :, :]
+    conditional_mean = (
+        pre_mean[None, None, :]
+        + standard_deviation[None, None, :] * correlation[None, :, :] * nodes
+    )
+    standardized = conditional_mean / fnp.maximum(conditional_deviation, 1e-12)
+    gate = flops.stats.norm.cdf(standardized)
+    density = fnp.exp(-0.5 * standardized * standardized) * density_normalizer
+    y_positive_mean = conditional_deviation * density + conditional_mean * gate
+
+    second_moment = fnp.sum(weights * x_positive * y_positive_mean, axis=0)
+    covariance = second_moment - next_mean[:, None] * next_mean[None, :]
+    covariance = 0.5 * (covariance + covariance.T)
+    return covariance + fnp.diag(next_variance - fnp.diag(covariance))
+
+
 def _linearized_gaussian_rows(weights: list[fnp.ndarray], width: int) -> fnp.ndarray:
     mean = fnp.zeros(width, dtype=fnp.float32)
     covariance = fnp.eye(width, dtype=fnp.float32)
@@ -132,9 +188,11 @@
         if layer_index == 0:
             covariance = _zero_mean_relu_covariance(pre_covariance)
         else:
-            linearized_covariance = pre_covariance * gate[:, None] * gate[None, :]
-            covariance = linearized_covariance + fnp.diag(
-                next_variance - fnp.diag(linearized_covariance)
+            covariance = _quadrature_relu_covariance(
+                pre_mean,
+                pre_covariance,
+                next_mean,
+                next_variance,
             )
         mean = next_mean
         rows.append(mean)


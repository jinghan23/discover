     return fnp.concatenate(direction_blocks, axis=0)
 
 
+def _orthogonal_half_directions(half_samples: int, width: int, rng) -> fnp.ndarray:
+    direction_blocks = []
+    remaining = half_samples
+    while remaining > 0:
+        normal_matrix = rng.standard_normal((width, width))
+        q_matrix, r_matrix = fnp.linalg.qr(normal_matrix)
+        signs = fnp.sign(fnp.diag(r_matrix))
+        q_matrix = q_matrix * signs[None, :]
+        take = min(remaining, width)
+        direction_blocks.append(q_matrix[:take, :])
+        remaining -= take
+    return fnp.concatenate(direction_blocks, axis=0)
+
+
 def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
     n_samples, width = directions.shape
     scaled_second_moment = directions.T @ directions * (float(width) / float(n_samples))

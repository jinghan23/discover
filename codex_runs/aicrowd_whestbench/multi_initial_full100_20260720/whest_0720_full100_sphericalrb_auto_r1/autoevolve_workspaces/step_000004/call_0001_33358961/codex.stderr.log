        u=(idx*gen+sh)%1; z=ndtri(np.clip(u,TAIL,1-TAIL)); r=np.sqrt((z*z).sum(1))
        outs.append(z/r[:,None])
    return np.concatenate(outs)

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))

def qmc(weights,n=2048,seed=0,gain=1.125):
    w=weights[0].shape[0]; half=n//2; D=dirs(half,w,np.random.default_rng(seed)); S=D.T@D*(w/half); vals,vecs=np.linalg.eigh(S); M=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T
    x=np.concatenate([D,-D])*mean_chi(w); x=np.maximum(x@(M@weights[0]),0); exact=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); rows=[exact]; corr=exact-x.mean(0)
    for W in weights[1:]:
        pre=x@W; gate=(pre>0).mean(0); x=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(x.mean(0)+gain*corr)
    return np.stack(rows)

def full_lin(weights):
    w=weights[0].shape[0]; m=np.zeros(w); C=np.eye(w); rows=[]; inv=1/math.sqrt(2*math.pi)
    for W in weights:
        mu=m@W
        Cz=W.T@C@W
        var=np.maximum(np.diag(Cz),1e-30)
        sig=np.sqrt(var); a=mu/sig
        Phi=0.5*(1+erf(a/math.sqrt(2))); phi=np.exp(-0.5*a*a)*inv
        out=sig*phi+mu*Phi
        second=(mu*mu+var)*Phi+mu*sig*phi
        v=np.maximum(second-out*out,1e-30)
        G=np.outer(Phi,Phi)*Cz
        np.fill_diagonal(G,v)
        m=out; C=G; rows.append(m.copy())
    return np.stack(rows)


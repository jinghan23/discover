/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
from scipy.special import ndtri, erf

TAIL=1e-11

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def lattice_normals(n,w,rng,shifts=2):
    roots=np.sqrt(first_primes(w)); gen=roots-np.floor(roots)
    blocks=[]
    base=n//shifts; rem=n-base*shifts
    for si in range(shifts):
        m=base+(si<rem)
        shift=rng.random(w)
        idx=np.arange(m,dtype=np.float64)[:,None]
        u=(idx*gen[None,:]+shift[None,:])%1.0
        u=np.clip(u, TAIL, 1-TAIL)
        z=ndtri(u)
        r=np.sqrt(np.maximum((z*z).sum(1),1e-24))
        blocks.append(z/r[:,None])
    return np.concatenate(blocks,0)

def mean_chi(d):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*d+0.5)-math.lgamma(0.5*d))

def qmc_est(weights,n=2048,seed=0,gain=1.125,whiten=True,shifts=2):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed)
    half=n//2
    dirs=lattice_normals(half,w,rng,shifts=shifts)
    if whiten:
        S=dirs.T@dirs*(w/half)
        vals,vecs=np.linalg.eigh(S)
        M=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T
        first=M@weights[0]
    else:
        first=weights[0]
    x=np.concatenate([dirs,-dirs],0)*mean_chi(w)
    rows=[]
    x=np.maximum(x@first,0)
    exact=np.sqrt((weights[0]*weights[0]).sum(0))/math.sqrt(2*math.pi)
    rows.append(exact)
    corr=exact-x.mean(0)
    for W in weights[1:]:
        pre=x@W
        gate=(pre>0).mean(0)
        x=np.maximum(pre,0)
        corr=(corr@W)*gate
        rows.append(x.mean(0)+gain*corr)
    return np.stack(rows)

def diag_prop(weights):
    w=weights[0].shape[0]
    m=np.zeros(w); v=np.ones(w)
    rows=[]
    invsqrt2=1/math.sqrt(2)
    invsqrt2pi=1/math.sqrt(2*math.pi)
    for W in weights:
        mu=m@W
        # independent activation approximation
        var=(v)@(W*W)
        sig=np.sqrt(np.maximum(var,1e-30))
        a=mu/sig
        Phi=0.5*(1+erf(a/math.sqrt(2)))
        phi=np.exp(-0.5*a*a)*invsqrt2pi
        out_m=sig*phi+mu*Phi
        second=(mu*mu+var)*Phi+mu*sig*phi
        v=np.maximum(second-out_m*out_m,1e-30)
        m=out_m
        rows.append(m.copy())
    return np.stack(rows)

def mc_target(weights,n=100000,seed=123,chunk=20000):
    w=weights[0].shape[0]; d=len(weights)
    sums=np.zeros((d,w),dtype=np.float64); done=0
    rng=np.random.default_rng(seed)

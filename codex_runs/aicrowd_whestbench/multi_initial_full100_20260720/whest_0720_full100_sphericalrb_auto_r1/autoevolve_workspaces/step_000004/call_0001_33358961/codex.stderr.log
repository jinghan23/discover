/bin/bash -lc "python - <<'PY'
# offline whitening/no-whitening comparison against high-qmc reference
import math,numpy as np
from scipy.special import ndtri
TAIL=1e-11; P=None
def primes(n):
 ps=[]; c=2
 while len(ps)<n:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps)
def dirs(n,w,rng):
 global P
 if P is None: P=np.sqrt(primes(w))%1
 outs=[]; base=n//2; rem=n-base*2
 for si in range(2):
  m=base+(si<rem); idx=np.arange(m,dtype=np.float64)[:,None]; sh=rng.random(w); z=ndtri(np.clip((idx*P+sh)%1,TAIL,1-TAIL)); outs.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(outs)
def chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def qmc(weights,n,seed,whiten=True,gain=1.125):
 w=weights[0].shape[0]; D=dirs(n//2,w,np.random.default_rng(seed)); first=weights[0]
 if whiten:
  S=D.T@D*(w/(n//2)); vals,vecs=np.linalg.eigh(S); M=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T; first=M@first
 x=np.concatenate([D,-D])*chi(w); x=np.maximum(x@first,0); exact=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi); corr=exact-x.mean(0)
 for W in weights[1:]:
  pre=x@W; gate=(pre>0).mean(0); x=np.maximum(pre,0); corr=(corr@W)*gate
 return x.mean(0)+gain*corr
vals={'white':[],'nowhite':[]}
for i in range(8):
 rng=np.random.default_rng(1000+i); weights=[rng.standard_normal((256,256))*math.sqrt(2/256) for _ in range(32)]
 ref=qmc(weights,32768,9000+i,True)
 for wh,name in [(True,'white'),(False,'nowhite')]:
  p=qmc(weights,6440,3000+i,wh); vals[name].append(((p-ref)**2).mean())
 print('done',i, flush=True)
for k,v in vals.items(): print(k,np.mean(v),np.median(v),v)

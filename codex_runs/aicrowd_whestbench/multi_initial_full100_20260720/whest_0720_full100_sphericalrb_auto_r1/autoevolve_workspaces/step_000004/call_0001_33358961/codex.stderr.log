from scipy.special import ndtri
TAIL=1e-11; P=None
def primes(n):
 ps=[]; c=2
 while len(ps)<n:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps)
def dirs(n,w,rng):
 global P
 if P is None: P=np.sqrt(primes(w))%1
 outs=[]; base=n//2; rem=n-base*2
 for si in range(2):
  m=base+(si<rem); idx=np.arange(m,dtype=np.float64)[:,None]; sh=rng.random(w); z=ndtri(np.clip((idx*P+sh)%1,TAIL,1-TAIL)); outs.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(outs)
def chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def relu_cov_first(W):
 C=W.T@W; s=np.sqrt(np.maximum(np.diag(C),1e-30)); rho=C/(s[:,None]*s[None,:]); rho=np.clip(rho,-1,1); theta=np.arccos(rho); S=(s[:,None]*s[None,:])*(np.sin(theta)+(math.pi-theta)*rho)/(2*math.pi); m=s/math.sqrt(2*math.pi); return m,S-np.outer(m,m)
def qmc(weights,n,seed,mode='base',gain=1.125):
 w=weights[0].shape[0]; D=dirs(n//2,w,np.random.default_rng(seed)); S=D.T@D*(w/(n//2)); vals,vecs=np.linalg.eigh(S); M=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T
 x=np.concatenate([D,-D])*chi(w); x=np.maximum(x@(M@weights[0]),0); exact=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi)

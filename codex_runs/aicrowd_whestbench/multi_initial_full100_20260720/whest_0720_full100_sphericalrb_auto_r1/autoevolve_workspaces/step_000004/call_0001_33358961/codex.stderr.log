codex
One cheap control variate is to modify the sample cloud itself after the first layer so its first-layer means match the exact Gaussian means, instead of only correcting output rows afterward. I’m testing that offline because it changes downstream gates and could either help or introduce bias.
exec
/bin/bash -lc "python - <<'PY'
# compare first-layer rescaling variants at width 256 against high-qmc reference
import math,time,numpy as np
from scipy.special import ndtri
TAIL=1e-11; P=None
def primes(n):
 ps=[]; c=2
 while len(ps)<n:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps)
def dirs(n,w,rng):
 global P
 if P is None: P=np.sqrt(primes(w))%1
 outs=[]; base=n//2; rem=n-base*2
 for si in range(2):
  m=base+(si<rem); idx=np.arange(m,dtype=np.float64)[:,None]; sh=rng.random(w)
  z=ndtri(np.clip((idx*P+sh)%1,TAIL,1-TAIL)); outs.append(z/np.sqrt((z*z).sum(1))[:,None])
 return np.concatenate(outs)
def chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def qmc(weights,n,seed,gain=1.125,mode='corr',gamma=1.0):
 w=weights[0].shape[0]; D=dirs(n//2,w,np.random.default_rng(seed)); S=D.T@D*(w/(n//2)); vals,vecs=np.linalg.eigh(S); M=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T
 x=np.concatenate([D,-D])*chi(w); x=np.maximum(x@(M@weights[0]),0); exact=np.sqrt((weights[0]**2).sum(0))/math.sqrt(2*math.pi)
 if mode.startswith('scale'):
  sm=np.maximum(x.mean(0),1e-12); ratio=exact/sm; x=x*(ratio**gamma); corr=exact-x.mean(0)
 else:
  corr=exact-x.mean(0)
 for W in weights[1:]:

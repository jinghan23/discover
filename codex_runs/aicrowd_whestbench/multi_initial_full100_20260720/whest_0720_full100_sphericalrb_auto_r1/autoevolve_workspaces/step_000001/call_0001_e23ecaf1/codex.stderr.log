--- a/submission.py
+++ b/submission.py
@@ -104,6 +104,35 @@
     return count - (count & 1)
 
 
+def random_whitened_antithetic_sample_count(
+    budget: int,
+    width: int,
+    depth: int,
+    target_fraction: float,
+) -> int:
+    """Choose an even count for pseudo-random antithetic spherical sampling."""
+
+    half_random_per_sample = (16 * width + 3 * width + 2) // 2
+    layer_per_sample = depth * (2 * width * width + 2 * width)
+    covariance_per_sample = width * width
+    per_sample = half_random_per_sample + layer_per_sample + covariance_per_sample
+    fixed = 13 * width**3 + 8 * width
+    budget_limited = (
+        int(float(target_fraction) * budget) - fixed
+    ) // max(per_sample, 1)
+    memory_limited = _MAX_WORKING_SET_BYTES // max(
+        width * _FLOAT32_ITEMSIZE,
+        1,
+    )
+    count = int(
+        max(
+            _MIN_ANTITHETIC_SAMPLES,
+            min(budget_limited, memory_limited),
+        )
+    )
+    return count - (count & 1)
+
+
 def _first_primes(count: int) -> tuple[int, ...]:
     primes: list[int] = []
     candidate = 2
@@ -228,6 +257,58 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _exact_zero_mean_relu_covariance(covariance: fnp.ndarray) -> fnp.ndarray:
+    variance = fnp.maximum(fnp.diagonal(covariance), 1e-24)
+    standard_deviation = fnp.sqrt(variance)
+    correlation = covariance / fnp.maximum(
+        standard_deviation[:, None] * standard_deviation[None, :],
+        1e-24,
+    )
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second_moment = (
+        standard_deviation[:, None]
+        * standard_deviation[None, :]
+        * (fnp.sin(angle) + (fnp.pi - angle) * correlation)
+        / (2.0 * fnp.pi)
+    )
+    mean = standard_deviation / fnp.sqrt(2.0 * fnp.pi)
+    return second_moment - mean[:, None] * mean[None, :]
+
+
+def _structured_gaussian_means(mlp) -> list[fnp.ndarray]:
+    mean = fnp.zeros(mlp.width)
+    covariance = fnp.eye(mlp.width)
+    rows = []
+    identity = fnp.eye(mlp.width)
+    for layer_index, weights in enumerate(mlp.weights):
+        pre_mean = weights.T @ mean
+        pre_covariance = weights.T @ covariance @ weights
+        pre_variance = fnp.maximum(fnp.diagonal(pre_covariance), 1e-12)
+        pre_sigma = fnp.sqrt(pre_variance)
+        alpha = pre_mean / pre_sigma
+        density = flops.stats.norm.pdf(alpha)
+        probability = flops.stats.norm.cdf(alpha)
+        mean = pre_mean * probability + pre_sigma * density
+        second_moment = (
+            (pre_mean * pre_mean + pre_variance) * probability
+            + pre_mean * pre_sigma * density
+        )
+        variance = fnp.maximum(second_moment - mean * mean, 0.0)
+        if layer_index == 0:
+            covariance = _exact_zero_mean_relu_covariance(pre_covariance)
+        else:
+            covariance = (
+                probability[:, None]
+                * probability[None, :]
+                * pre_covariance
+                * (1.0 - identity)
+                + variance[:, None] * identity
+            )
+        rows.append(mean)
+    return rows
+
+
 def _forward_means(mlp, activations, *, radial_control=None):
     rows = []
     control_mean = None
@@ -400,6 +481,44 @@
         return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
 
 
+class _RandomWhitenedAntitheticRaoBlackwellEstimator(BaseEstimator):
+    """Pseudo-random antithetic spherical samples with angular whitening."""
+
+    target_flop_fraction = 0.106
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = random_whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(mlp.seed)
+        normals = rng.standard_normal(
+            (half_samples, mlp.width),
+            dtype=fnp.float32,
+        )
+        radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
+        half_directions = normals / radii[:, None]
+        whitening = _angular_whitening_transform(half_directions)
+        first_weight = whitening @ mlp.weights[0]
+        paired_directions = fnp.concatenate(
+            (half_directions, -half_directions),
+            axis=0,
+        )
+        activations = paired_directions * _mean_chi(mlp.width)
+
+        rows = []
+        activations = fnp.maximum(activations @ first_weight, 0.0)
+        rows.append(_exact_first_layer_mean(mlp.weights[0]))
+        for weights in mlp.weights[1:]:
+            activations = fnp.maximum(activations @ weights, 0.0)
+            rows.append(fnp.mean(activations, axis=0))
+
+        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
+
+
 class WhitenedAntitheticRaoBlackwell10Estimator(
     _WhitenedAntitheticRaoBlackwellEstimator
 ):
@@ -531,5 +650,8 @@
     qmc_shifts = 4
 
 
-class Estimator(WhitenedAntitheticRaoBlackwell6688TwoShiftEstimator):
-    """6688-sample whitened-antithetic RQMC split over two shifts."""
+class Estimator(BaseEstimator):
+    """Structured Gaussian ReLU moment propagation baseline."""
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        return fnp.asarray(fnp.stack(_structured_gaussian_means(mlp), axis=0), dtype=fnp.float32)


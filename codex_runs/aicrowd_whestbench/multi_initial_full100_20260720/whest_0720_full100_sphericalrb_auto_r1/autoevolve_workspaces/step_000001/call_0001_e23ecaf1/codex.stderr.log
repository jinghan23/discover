+def _generalized_golden_generator(width: int) -> tuple[float, ...]:
+    low = 1.0
+    high = 2.0
+    exponent = width + 1
+    for _ in range(64):
+        middle = 0.5 * (low + high)
+        if middle**exponent < middle + 1.0:
+            low = middle
+        else:
+            high = middle
+    reciprocal = 1.0 / (0.5 * (low + high))
+    values = []
+    value = 1.0
+    for _ in range(width):
+        value = (value * reciprocal) % 1.0
+        values.append(value)
+    return tuple(values)

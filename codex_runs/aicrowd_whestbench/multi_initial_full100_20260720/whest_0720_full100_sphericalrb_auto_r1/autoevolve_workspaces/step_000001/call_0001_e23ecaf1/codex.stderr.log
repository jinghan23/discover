+def _exact_zero_mean_relu_covariance(covariance: fnp.ndarray) -> fnp.ndarray:
+    variance = fnp.maximum(fnp.diagonal(covariance), 1e-24)
+    standard_deviation = fnp.sqrt(variance)
+    correlation = covariance / fnp.maximum(
+        standard_deviation[:, None] * standard_deviation[None, :],
+        1e-24,
+    )
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    angle = fnp.arccos(correlation)
+    second_moment = (
+        standard_deviation[:, None]
+        * standard_deviation[None, :]
+        * (fnp.sin(angle) + (fnp.pi - angle) * correlation)
+        / (2.0 * fnp.pi)
+    )
+    mean = standard_deviation / fnp.sqrt(2.0 * fnp.pi)
+    return second_moment - mean[:, None] * mean[None, :]

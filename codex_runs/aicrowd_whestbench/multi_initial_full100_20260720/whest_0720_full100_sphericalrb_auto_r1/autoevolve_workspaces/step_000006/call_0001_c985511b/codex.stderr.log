codex
I’m going to avoid broad dataset-related paths and just use `sample_mlp` plus direct Monte Carlo for synthetic targets. That gives a cheap sandbox to compare estimator variants before committing to a long blackbox evaluation.
exec
/bin/bash -lc "python - <<'PY'
from submission import _sample_count
for w in [16,32,64,128,256]:
  for d in [4,8,16,32,64]:
    for b in [10_000_000,100_000_000,1_000_000_000,10_000_000_000]:
      n=_sample_count(b,w,d)
      if 64 <= n <= 200000:
        pass
    
print('sample counts')
for w,d,b in [(32,8,1_000_000_000),(64,16,10_000_000_000),(128,32,100_000_000_000),(64,32,10_000_000_000),(128,16,100_000_000_000),(256,16,1_000_000_000_000)]:
  print(w,d,b,_sample_count(b,w,d))

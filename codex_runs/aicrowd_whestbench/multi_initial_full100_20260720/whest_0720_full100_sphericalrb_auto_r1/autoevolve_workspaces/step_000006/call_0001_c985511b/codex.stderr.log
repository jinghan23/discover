+                (1.0 - _EMPIRICAL_GAUSSIAN_BLEND) * corrected_row
+                + _EMPIRICAL_GAUSSIAN_BLEND * gaussian_row
+            )
 
         qmc_rows = fnp.stack(rows, axis=0)
         analytic_rows = _linearized_gaussian_rows(mlp.weights, mlp.width)


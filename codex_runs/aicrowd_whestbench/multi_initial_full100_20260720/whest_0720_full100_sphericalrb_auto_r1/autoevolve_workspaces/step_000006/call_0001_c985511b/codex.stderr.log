         rows.append(exact_first_mean)
 
         mean_correction = exact_first_mean - fnp.mean(activations, axis=0)
+        normalizer = 1.0 / fnp.sqrt(2.0 * fnp.pi)
         for weights in mlp.weights[1:]:
             preactivations = activations @ weights
+            pre_mean = fnp.mean(preactivations, axis=0)
+            pre_second_moment = fnp.mean(preactivations * preactivations, axis=0)
+            pre_variance = fnp.maximum(
+                pre_second_moment - pre_mean * pre_mean,
+                1e-24,
+            )
+            pre_standard_deviation = fnp.sqrt(pre_variance)
+            standardized = pre_mean / pre_standard_deviation
+            gaussian_gate = flops.stats.norm.cdf(standardized)
+            gaussian_density = (
+                fnp.exp(-0.5 * standardized * standardized) * normalizer
+            )
+            pre_mean_correction = mean_correction @ weights
+            gaussian_row = (
+                pre_standard_deviation * gaussian_density
+                + pre_mean * gaussian_gate
+                + _GATE_MEAN_CORRECTION * pre_mean_correction * gaussian_gate
+            )
             gate_mean = fnp.mean(preactivations > 0.0, axis=0)
             activations = fnp.maximum(preactivations, 0.0)
-            mean_correction = (mean_correction @ weights) * gate_mean
+            mean_correction = pre_mean_correction * gate_mean
             base_row = fnp.mean(activations, axis=0)
-            rows.append(base_row + _GATE_MEAN_CORRECTION * mean_correction)
+            corrected_row = base_row + _GATE_MEAN_CORRECTION * mean_correction
+            rows.append(
+                (1.0 - _EMPIRICAL_GAUSSIAN_BLEND) * corrected_row
+                + _EMPIRICAL_GAUSSIAN_BLEND * gaussian_row
+            )
 
         qmc_rows = fnp.stack(rows, axis=0)
         analytic_rows = _linearized_gaussian_rows(mlp.weights, mlp.width)


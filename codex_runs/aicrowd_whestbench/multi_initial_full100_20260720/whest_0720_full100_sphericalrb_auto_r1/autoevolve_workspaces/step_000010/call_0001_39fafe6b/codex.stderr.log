# Local test for first-layer covariance control variate on generated MLPs.
import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIG=1e-8
P={}
def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p,float)
def getp(w):
 if w not in P:P[w]=primes(w)
 return P[w]
def half(n,w,rng,sh=2):
 gen=np.sqrt(getp(w))%1; base=n//sh; rem=n-base*sh; out=[]
 for i in range(sh):
  m=base+(i<rem); idx=np.arange(m,dtype=float)[:,None]; u=(idx*gen[None,:]+rng.random(w)[None,:])%1; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); r=np.sqrt(np.maximum((z*z).sum(1),1e-24)); out.append(z/r[:,None])
 return np.concatenate(out)
def wh(d):
 n,w=d.shape; vals,vecs=np.linalg.eigh(d.T@d*(w/n)); vals=np.maximum(vals,EIG); return (vecs/np.sqrt(vals))@vecs.T
def chi(w):
 h=.5*w; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def exact1(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def relu_second(pre):
 v=np.maximum(np.diag(pre),1e-24); s=np.sqrt(v); scale=s[:,None]*s[None,:]; c=np.clip(pre/scale,-1,1); return scale*(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
def exact_cov(W):
 sec=relu_second(W.T@W); m=exact1(W); return sec-m[:,None]*m[None,:]
def analytic(ws):
 w=ws[0].shape[0]; m=np.zeros(w); C=np.eye(w); rows=[]; nc=1/math.sqrt(2*math.pi)
 for li,W in enumerate(ws):
  pm=m@W; PC=W.T@C@W; v=np.maximum(np.diag(PC),1e-24); s=np.sqrt(v); z=pm/s; g=norm.cdf(z); den=np.exp(-.5*z*z)*nc; nm=s*den+pm*g; sec=((pm*pm+v)*g+pm*s*den); nv=np.maximum(sec-nm*nm,1e-24)
  if li==0:C=exact_cov(W)
  else:
   lin=PC*g[:,None]*g[None,:]; C=lin+np.diag(nv-np.diag(lin))
  m=nm; rows.append(m)
 return np.stack(rows)
def pred(ws,n=8192,cov=False,mc_scale=1.05,vc_scale=1.0,blend=.05,seed=0):
 w=ws[0].shape[0]; hd=half(n//2,w,np.random.default_rng(seed),2); a=np.concatenate([hd,-hd])*chi(w); a=np.maximum(a@(wh(hd)@ws[0]),0)
 ef=exact1(ws[0]); rows=[ef]; dm=ef-a.mean(0)
 if cov:
  sm=a.mean(0); sC=(a.T@a)/n-sm[:,None]*sm[None,:]; dC=exact_cov(ws[0])-sC
 for W in ws[1:]:
  pre=a@W; pm=pre.mean(0); pv=np.maximum((pre*pre).mean(0)-pm*pm,1e-24); sig=np.sqrt(pv); gate=(pre>0).mean(0); den=np.exp(-.5*(pm/sig)**2)/math.sqrt(2*math.pi)
  a=np.maximum(pre,0); base=a.mean(0)
  dmp=dm@W
  if cov:
   dCp=W.T@dC@W; dv=np.diag(dCp); dm_next=gate*dmp + vc_scale*den/(2*sig)*dv
   # covariance update for propagation
   dsecond=2*base*dmp + gate*dv
   dvar=dsecond-2*base*dm_next
   dC=dCp*gate[:,None]*gate[None,:]
   dC=dC.copy(); np.fill_diagonal(dC,dvar)
   dm=dm_next
  else:
   dm=dmp*gate
  rows.append(base+mc_scale*dm)
 q=np.stack(rows); an=analytic(ws); return (1-blend)*q+blend*an
def ref(ws,n=1200000,seed=0,chunk=32768):

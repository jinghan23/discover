import math, time
import numpy as np
from scipy.special import ndtri
from scipy.stats import norm

TAIL=1e-9
EIG_FLOOR=1e-8

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes, dtype=np.float64)

def lattice_normals(n, w, rng):
    roots=np.sqrt(first_primes(w)); gen=roots-np.floor(roots)
    shift=rng.random(w)
    idx=np.arange(n, dtype=np.float64)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    u=np.clip(u, TAIL, 1-TAIL)
    return ndtri(u)

def qmc_dirs(n,w,rng):
    z=lattice_normals(n,w,rng)
    r=np.sqrt(np.maximum((z*z).sum(1),1e-24))
    return z/r[:,None]

def half_dirs(half,w,rng,shifts=2):
    base=half//shifts; rem=half-base*shifts
    return np.concatenate([qmc_dirs(base+(i<rem),w,rng) for i in range(shifts)],0)

def whitening(dirs):
    n,w=dirs.shape
    sm=dirs.T@dirs*(w/n)
    vals,vecs=np.linalg.eigh(sm)
    vals=np.maximum(vals,EIG_FLOOR)
    return (vecs/np.sqrt(vals))@vecs.T

def mean_chi(w):
    h=0.5*w
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def zero_mean_relu_cov(pre):
    var=np.maximum(np.diag(pre),1e-24)
    sd=np.sqrt(var)
    scale=sd[:,None]*sd[None,:]
    corr=np.clip(pre/scale,-1,1)
    sec=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    mean=sd/math.sqrt(2*math.pi)
    return sec-mean[:,None]*mean[None,:]

def analytic_rows(weights):
    w=weights[0].shape[0]
    mean=np.zeros(w,dtype=np.float64)
    cov=np.eye(w,dtype=np.float64)
    rows=[]
    normalizer=1/math.sqrt(2*math.pi)
    for li,W in enumerate(weights):
        pre_mean=mean@W
        pre_cov=W.T@cov@W
        var=np.maximum(np.diag(pre_cov),1e-24)
        sd=np.sqrt(var)
        z=pre_mean/sd
        gate=norm.cdf(z)
        den=np.exp(-0.5*z*z)*normalizer
        nxt=sd*den+pre_mean*gate
        sec=((pre_mean*pre_mean+var)*gate+pre_mean*sd*den)
        nxtvar=np.maximum(sec-nxt*nxt,1e-24)
        if li==0:
            cov=zero_mean_relu_cov(pre_cov)
        else:
            lin=pre_cov*gate[:,None]*gate[None,:]
            cov=lin+np.diag(nxtvar-np.diag(lin))
        mean=nxt
        rows.append(mean)
    return np.stack(rows)

def qmc_parts(weights, n=1024, shifts=2, seed=0):
    w=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    hd=half_dirs(n//2,w,rng,shifts)
    wh=whitening(hd)
    dirs=np.concatenate([hd,-hd],0)
    a=dirs*mean_chi(w)
    rows=[]; corr_rows=[]
    a=np.maximum(a@(wh@weights[0]),0)
    ef=exact_first(weights[0])
    rows.append(ef)
    corr_rows.append(np.zeros_like(ef))
    corr=ef-a.mean(0)
    for W in weights[1:]:
        pre=a@W
        gate=(pre>0).mean(0)
        a=np.maximum(pre,0)
        corr=(corr@W)*gate
        rows.append(a.mean(0))
        corr_rows.append(corr.copy())
    return np.stack(rows), np.stack(corr_rows)

def sample_ref(weights, n=2000000, seed=0, chunk=32768):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]; d=len(weights)
    sums=[np.zeros(w,dtype=np.float64) for _ in weights]
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(0)
        done+=m
    return np.stack(sums)/n

W=64;D=8;NMLP=12;ALG_N=1024;REF_N=1000000

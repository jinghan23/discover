  else:
   lin=PC*g[:,None]*g[None,:]; C=lin+np.diag(nv-np.diag(lin))
  m=nm; rows.append(m)
 return np.stack(rows)
def qmc(ws,n=8192,seed=0):
 w=ws[0].shape[0]; hd=half(n//2,w,np.random.default_rng(seed)); a=np.concatenate([hd,-hd])*chi(w); a=np.maximum(a@(wh(hd)@ws[0]),0); ef=exact1(ws[0]); rows=[ef]; corr=ef-a.mean(0)
 for W in ws[1:]:
  pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(a.mean(0)+1.05*corr)
 return np.stack(rows)
def ref(ws,n=1200000,seed=0,chunk=32768):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; sums=[np.zeros(w) for _ in ws]; done=0
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=m
 return np.stack(sums)/n
W=64;D=8;N=10; rng=np.random.default_rng(44); items=[]
for i in range(N):

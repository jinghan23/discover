# Reuse a compact benchmark to compare QMC shift/sample-count choices.
import math, time
import numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIG=1e-8

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p,float)
P_CACHE={}
def getp(w):
 if w not in P_CACHE:P_CACHE[w]=primes(w)
 return P_CACHE[w]
def dirs(n,w,rng,shifts):
 blocks=[]; base=n//shifts; rem=n-base*shifts; gen=np.sqrt(getp(w))%1.0
 for i in range(shifts):
  m=base+(i<rem); shift=rng.random(w); idx=np.arange(m,dtype=float)[:,None]
  u=(idx*gen[None,:]+shift[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL)
  z=ndtri(u); r=np.sqrt(np.maximum((z*z).sum(1),1e-24)); blocks.append(z/r[:,None])
 return np.concatenate(blocks)
def wh(d):
 n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,EIG); return (vecs/np.sqrt(vals))@vecs.T
def chi(w):
 h=.5*w; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def exact1(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def zero_cov(pre):
 var=np.maximum(np.diag(pre),1e-24); sd=np.sqrt(var); scale=sd[:,None]*sd[None,:]; corr=np.clip(pre/scale,-1,1)
 sec=scale*(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi); m=sd/math.sqrt(2*math.pi)
 return sec-m[:,None]*m[None,:]
def analytic(weights):
 w=weights[0].shape[0]; m=np.zeros(w); c=np.eye(w); rows=[]; normc=1/math.sqrt(2*math.pi)
 for li,W in enumerate(weights):
  pm=m@W; pc=W.T@c@W; v=np.maximum(np.diag(pc),1e-24); s=np.sqrt(v); z=pm/s; g=norm.cdf(z); den=np.exp(-.5*z*z)*normc
  nm=s*den+pm*g; sec=((pm*pm+v)*g+pm*s*den); nv=np.maximum(sec-nm*nm,1e-24)
  if li==0:c=zero_cov(pc)
  else:
   lin=pc*g[:,None]*g[None,:]; c=lin+np.diag(nv-np.diag(lin))
  m=nm; rows.append(m)
 return np.stack(rows)
def qpred(weights,n,shifts,seed,g=1.05,b=.05):
 w=weights[0].shape[0]; hd=dirs(n//2,w,np.random.default_rng(seed),shifts); Wt=wh(hd)@weights[0]; a=np.concatenate([hd,-hd])*chi(w); rows=[]
 a=np.maximum(a@Wt,0); ef=exact1(weights[0]); rows.append(ef); corr=ef-a.mean(0)
 for W in weights[1:]:
  pre=a@W; gate=(pre>0).mean(0); a=np.maximum(pre,0); corr=(corr@W)*gate; rows.append(a.mean(0)+g*corr)
 q=np.stack(rows); an=analytic(weights); return (1-b)*q+b*an
def ref(weights,n=1500000,seed=0,chunk=32768):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; sums=[np.zeros(w) for _ in weights]; done=0
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=m
 return np.stack(sums)/n
W=64;D=8;N=8; rng=np.random.default_rng(42); mlps=[]; refs=[]
for i in range(N):
 weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float64) for _ in range(D)]
 mlps.append(weights); refs.append(ref(weights,seed=900+i)[-1])
for n in [512,1024,2048,4096,8192]:
 for sh in [1,2,4,8]:
  if n//2 < sh: continue
  ms=[]
  for weights,t in zip(mlps,refs):
   p=qpred(weights,n,sh,seed=2026)[-1]
   ms.append(np.mean((p-t)**2))
  print(n,sh,float(np.mean(ms)))

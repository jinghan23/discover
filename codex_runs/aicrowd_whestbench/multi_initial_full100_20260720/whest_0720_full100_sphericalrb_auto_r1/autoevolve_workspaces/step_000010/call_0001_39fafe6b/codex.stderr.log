  m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
  done+=m
 return np.stack(sums)/n

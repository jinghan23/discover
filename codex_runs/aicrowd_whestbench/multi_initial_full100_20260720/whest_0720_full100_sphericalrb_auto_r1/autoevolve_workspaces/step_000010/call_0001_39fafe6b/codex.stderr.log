import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-9; EIG=1e-8
P={}
def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p,float)
def gp(w):
 if w not in P:P[w]=primes(w)
 return P[w]
def half(n,w,rng):
 gen=np.sqrt(gp(w))%1; out=[]; base=n//2; rem=n-2*base
 for i in range(2):

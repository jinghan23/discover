def exact1(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def zero_cov(pre):
 v=np.maximum(np.diag(pre),1e-24); s=np.sqrt(v); scale=s[:,None]*s[None,:]; c=np.clip(pre/scale,-1,1); sec=scale*(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi); m=s/math.sqrt(2*math.pi); return sec-m[:,None]*m[None,:]
def analytic(ws,variant='lin'):
 w=ws[0].shape[0]; m=np.zeros(w); C=np.eye(w); rows=[]; nc=1/math.sqrt(2*math.pi)
 for li,W in enumerate(ws):
  pm=m@W; PC=W.T@C@W; v=np.maximum(np.diag(PC),1e-24); s=np.sqrt(v); z=pm/s; g=norm.cdf(z); den=np.exp(-.5*z*z)*nc; nm=s*den+pm*g; sec=((pm*pm+v)*g+pm*s*den); nv=np.maximum(sec-nm*nm,1e-24)
  if li==0 or variant=='zero':
   C=zero_cov(PC)

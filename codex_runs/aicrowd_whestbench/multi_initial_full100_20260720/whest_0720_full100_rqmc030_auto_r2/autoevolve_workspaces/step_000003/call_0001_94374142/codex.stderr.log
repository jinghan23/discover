/bin/bash -lc "python - <<'PY'
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_splitcv(mlp,budget):
    n=submission._sample_count(budget,mlp.width,mlp.depth); nper=max(1,n//2)
    est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
    gen,mr,ident,zero=est._constants_for_width(mlp.width)
    rng=fnp.random.default_rng(mlp.seed); base=rng.random(mlp.width)
    uni=fnp.concatenate((submission._lattice_uniforms(nper,gen,base),submission._lattice_uniforms(nper,gen,1-base)),axis=0)
    uni=1-fnp.abs(2*uni-1); uni=fnp.clip(uni,1e-11,1-1e-11)
    x=flops.stats.norm.ppf(uni); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    rows=[]; first=None; final=mlp.depth-1
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            rows.append(submission._exact_first_layer_mean(w)); first=x
        elif li==final:
            em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
            vals=[]
            for start in (0,nper):
                xb=x[start:start+nper]
                fb=first[start:start+nper]
                fm=fnp.mean(xb,axis=0); cf=xb-fm[None,:]
                am=fnp.mean(fb,axis=0); cx=fb-em[None,:]
                beta=fnp.linalg.solve(cov,(cx.T@cf)/nper)
                vals.append(mr*(fm-(am-em)@beta))
            rows.append((vals[0]+vals[1])*0.5)
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
for cfg in [(32,8,5_000_000_000,900000,6),(32,4,3_000_000_000,1000000,6),(64,4,10_000_000_000,600000,5),(16,4,1_000_000_000,1000000,6)]:
    w,d,b,tn,reps=cfg; scores={'cur':[],'split':[]}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(111000+127*i+w),seed=77777+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(112000+i))
        est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
        scores['cur'].append(mse(est.predict(mlp,b),target))
        scores['split'].append(mse(pred_splitcv(mlp,b),target))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for k,a in scores.items(): print(k,sum(a)/len(a),a)

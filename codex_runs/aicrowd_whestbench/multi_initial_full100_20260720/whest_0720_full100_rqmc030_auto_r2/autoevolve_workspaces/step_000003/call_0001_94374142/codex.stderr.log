                    control_covariance = control_covariance + (
                        _SCALAR_CONTROL_RIDGE
                        * first_activations.shape[0]
                        * fnp.eye(control_covariance.shape[0], dtype=fnp.float64)
                    )
                    cross_covariance = centered_control.T @ centered_final

# Compare seed offsets and shift counts synthetically at larger n against high-MC targets.
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_param(mlp,budget,shift_count=2,seed_offset=0,tail=1e-11):
    n_samples=submission._sample_count(budget,mlp.width,mlp.depth)
    n_per=max(1,n_samples//shift_count); actual=n_per*shift_count
    use_vector=actual>=mlp.width
    rng=fnp.random.default_rng(mlp.seed+seed_offset)
    gen=submission._lattice_generator(mlp.width); base=rng.random(mlp.width)
    parts=[]
    for si in range(shift_count):
        if si==0: sh=base
        elif si==1: sh=1.0-base
        else: sh=rng.random(mlp.width)
        parts.append(submission._lattice_uniforms(n_per,gen,sh))
    uniforms=fnp.concatenate(tuple(parts),axis=0)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
    uniforms=fnp.clip(uniforms,tail,1.0-tail)
    x=flops.stats.norm.ppf(uniforms); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    mr=submission._mean_standard_normal_radius(mlp.width)
    rows=[]; zero=fnp.zeros(mlp.width,dtype=fnp.float64); final=mlp.depth-1; first=None
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            rows.append(submission._exact_first_layer_mean(w)); first=x
        elif li==final:
            fm=fnp.mean(x,axis=0); cf=x-fm[None,:]
            if use_vector:
                em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr)
                am=fnp.mean(first,axis=0); cx=first-em[None,:]
                beta=fnp.linalg.solve(cov,(cx.T@cf)/first.shape[0])
                corr=(am-em)@beta
                rows.append(mr*(fm-corr))
            else: rows.append(mr*fm)
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))

configs=[(16,4,1_000_000_000,1000000,6),(32,4,3_000_000_000,1000000,5),(32,8,5_000_000_000,800000,5),(64,4,10_000_000_000,600000,4)]
variants=[('cur',2,0),('seed1',2,1),('seed7',2,7),('sh1',1,0),('sh4',4,0),('sh3',3,0)]
for cfg in configs:
    w,d,b,tn,reps=cfg
    scores={name:[] for name,_,_ in variants}
    t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(50000+101*i+w),seed=22222+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(60000+i))
        for name,sc,so in variants:
            scores[name].append(mse(pred_param(mlp,b,sc,so),target))
    print('cfg',cfg,'n',submission._sample_count(b,w,d),'time',round(time.time()-t,1))
    for name in scores:
        a=scores[name]; print(name,sum(a)/len(a),a)

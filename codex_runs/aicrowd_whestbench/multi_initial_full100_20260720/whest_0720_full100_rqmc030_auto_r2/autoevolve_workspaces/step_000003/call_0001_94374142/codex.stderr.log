import math, time
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission

# Analytic Gaussian full-cov propagation for comparison.
def relu_kernel(cov):
    diag = fnp.maximum(fnp.diag(cov), 0.0)
    sd = fnp.sqrt(diag)
    outer = sd[:,None] * sd[None,:]
    corr = fnp.clip(cov / fnp.maximum(outer, 1e-300), -1.0, 1.0)
    return outer * (fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0)) + (fnp.pi - fnp.arccos(corr))*corr) / (2.0*fnp.pi)

def analytic(mlp):
    cov = fnp.eye(mlp.width, dtype=fnp.float64)
    rows=[]
    for w in mlp.weights:
        pre = w.T @ cov @ w
        diag = fnp.maximum(fnp.diag(pre),0.0)
        rows.append(fnp.sqrt(diag)/(fnp.sqrt(2.0*fnp.pi)))
        cov = relu_kernel(pre)
    return fnp.stack(rows)

def mse(a,b):
    d = fnp.asarray(a[-1], dtype=fnp.float64)-fnp.asarray(b[-1], dtype=fnp.float64)
    return float(fnp.mean(d*d))

for width, depth, budget, target_n, reps in [(16,4,10_000_000,300000,5),(32,4,30_000_000,200000,4),(32,8,50_000_000,200000,4),(64,4,100_000_000,120000,3),(64,8,150_000_000,100000,3)]:
    cur=[]; ana=[]; blend05=[]; blend02=[]; ns=[]
    t0=time.time()
    for i in range(reps):
        rng=fnp.random.default_rng(1000+17*i+width*depth)
        mlp=sample_mlp(width, depth, rng, seed=2000+i)
        target,_,_=sample_layer_statistics(mlp, target_n, fnp.random.default_rng(3000+i))
        pcur=submission.Estimator().predict(mlp,budget)
        pana=analytic(mlp)
        cur.append(mse(pcur,target)); ana.append(mse(pana,target))
        blend05.append(mse(0.5*fnp.asarray(pcur)+0.5*fnp.asarray(pana), target))
        blend02.append(mse(0.8*fnp.asarray(pcur)+0.2*fnp.asarray(pana), target))
        ns.append(submission._sample_count(budget,width,depth))
    print('cfg',width,depth,'budget',budget,'n',ns[0],'time',round(time.time()-t0,1))
    for name, arr in [('cur',cur),('ana',ana),('b05',blend05),('b02ana',blend02)]:
        print(' ',name, sum(arr)/len(arr), arr)

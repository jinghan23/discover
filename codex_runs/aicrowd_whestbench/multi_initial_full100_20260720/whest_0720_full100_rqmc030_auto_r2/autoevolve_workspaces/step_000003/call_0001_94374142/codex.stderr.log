import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def predict_diag(mlp,budget, controls='sq'):
    n_samples=submission._sample_count(budget,mlp.width,mlp.depth)
    n_per=max(1,n_samples//2); actual=n_per*2
    rng=fnp.random.default_rng(mlp.seed); gen=submission._lattice_generator(mlp.width); shift=rng.random(mlp.width)
    uniforms=fnp.concatenate((submission._lattice_uniforms(n_per,gen,shift),submission._lattice_uniforms(n_per,gen,1.0-shift)),axis=0)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0); uniforms=fnp.clip(uniforms,submission._TAIL_CLIP,1-submission._TAIL_CLIP)
    x=flops.stats.norm.ppf(uniforms); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    mr=submission._mean_standard_normal_radius(mlp.width); rows=[]; final=mlp.depth-1; zero=fnp.zeros(mlp.width,dtype=fnp.float64)
    first=None; pre0=None
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            row=submission._exact_first_layer_mean(w); rows.append(row); first=x; pre0=pre
        elif li==final:
            fm=fnp.mean(x,axis=0); cy=x-fm[None,:]
            em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr)
            am=fnp.mean(first,axis=0); cx=first-em[None,:]
            beta=fnp.linalg.solve(cov,(cx.T@cy)/first.shape[0])
            corr=(am-em)@beta
            res=cy-cx@beta; res=res-fnp.mean(res,axis=0)[None,:]
            ns=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
            if 'sq' in controls:
                z=first*first; ez=ns/(2.0*mlp.width); zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                var=fnp.sum(cz*cz,axis=0)+1e-8*first.shape[0]
                gamma=(cz.T@res)/var[:,None]
                corr=corr+(zm-ez)@gamma
            if 'pre' in controls:
                z=pre0*pre0; ez=ns/mlp.width; zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                var=fnp.sum(cz*cz,axis=0)+1e-8*first.shape[0]
                gamma=(cz.T@res)/var[:,None]
                corr=corr+(zm-ez)@gamma
            if 'cub' in controls:
                z=first*first*first; ez=(submission._sphere_relu_third_moment_scale(mlp.width)*(ns*fnp.sqrt(ns)))
                zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                var=fnp.sum(cz*cz,axis=0)+1e-8*first.shape[0]
                gamma=(cz.T@res)/var[:,None]
                corr=corr+(zm-ez)@gamma
            rows.append(mr*(fm-corr))
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))

for cfg in [(16,4,100_000_000,1000000,8),(32,4,300_000_000,800000,6),(32,8,500_000_000,700000,6),(64,4,1_000_000_000,400000,5),(64,8,1_500_000_000,300000,5)]:
    width,depth,budget,target_n,reps=cfg
    scores={m:[] for m in ['cur','sq','sqpre','sqcub']}
    t=time.time()
    for i in range(reps):
        mlp=sample_mlp(width,depth,fnp.random.default_rng(30000+97*i+width),seed=11111+i)
        target,_,_=sample_layer_statistics(mlp,target_n,fnp.random.default_rng(70000+i))
        scores['cur'].append(mse(submission.Estimator().predict(mlp,budget),target))
        scores['sq'].append(mse(predict_diag(mlp,budget,'sq'),target))
        scores['sqpre'].append(mse(predict_diag(mlp,budget,'sqpre'),target))
        scores['sqcub'].append(mse(predict_diag(mlp,budget,'sqcub'),target))
    print('cfg',cfg,'n',submission._sample_count(budget,width,depth),'time',round(time.time()-t,1))
    for m,a in scores.items(): print(m, sum(a)/len(a), a)

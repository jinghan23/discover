import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
orig=submission._TARGET_FLOP_FRACTION
fractions=[0.11,0.14,0.158,0.18,0.22,0.28]
for cfg in [(32,8,5_000_000_000,900000,4),(32,4,3_000_000_000,1000000,4),(64,4,10_000_000_000,600000,3)]:
    w,d,b,tn,reps=cfg
    accum={f:[] for f in fractions}; comp={f:[] for f in fractions}
    t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(71000+103*i+w),seed=33333+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(72000+i))
        for f in fractions:
            submission._TARGET_FLOP_FRACTION=f
            with flops.budget(10**15,quiet=True) as bc:
                p=submission.Estimator().predict(mlp,b)
            accum[f].append(mse(p,target))
            comp[f].append(max(0.1,(bc.flops_used+1e11*bc.residual_wall_time_s)/b))
    print('cfg',cfg,'time',round(time.time()-t,1))

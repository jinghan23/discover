import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_tail(mlp,budget,tail,ridge=1e-8):
    oldt, oldr = submission._TAIL_CLIP, submission._VECTOR_CONTROL_RIDGE
    submission._TAIL_CLIP=tail; submission._VECTOR_CONTROL_RIDGE=ridge
    p=submission.Estimator().predict(mlp,budget)
    submission._TAIL_CLIP=oldt; submission._VECTOR_CONTROL_RIDGE=oldr
    return p

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
orig_f=submission._TARGET_FLOP_FRACTION; submission._TARGET_FLOP_FRACTION=0.14
variants=[('t1e-9',1e-9,1e-8),('t1e-11',1e-11,1e-8),('t1e-13',1e-13,1e-8),('t1e-7',1e-7,1e-8),('r1e-9',1e-11,1e-9),('r1e-7',1e-11,1e-7),('r1e-6',1e-11,1e-6)]
for cfg in [(32,8,5_000_000_000,900000,5),(32,4,3_000_000_000,1000000,5),(64,4,10_000_000_000,600000,4)]:
    w,d,b,tn,reps=cfg
    scores={n:[] for n,_,_ in variants}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(81000+107*i+w),seed=44444+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(82000+i))
        for name,tail,ridge in variants:
            scores[name].append(mse(pred_tail(mlp,b,tail,ridge),target))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for name,a in scores.items(): print(name,sum(a)/len(a),a)
submission._TARGET_FLOP_FRACTION=orig_f

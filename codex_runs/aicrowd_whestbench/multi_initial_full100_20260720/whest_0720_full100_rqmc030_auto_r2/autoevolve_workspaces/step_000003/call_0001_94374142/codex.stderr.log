def sample_layer_statistics_chunk_count(width: int, n_samples: int) -> int:
    """Return how many chunks ``sample_layer_statistics`` will process."""
    chunk_size = _pick_chunk_size(width)
    return (n_samples + chunk_size - 1) // chunk_size



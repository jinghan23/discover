/bin/bash -lc "python - <<'PY'
# High-sample current vs exact antipodal pairing at fraction 0.14.
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_antidir(mlp,budget):
    n=submission._sample_count(budget,mlp.width,mlp.depth); nb=max(1,n//2); actual=2*nb
    rng=fnp.random.default_rng(mlp.seed); gen, mr, ident, zero = submission.Estimator()._constants_for_width(mlp.width); shift=rng.random(mlp.width)
    uni=submission._lattice_uniforms(nb,gen,shift); uni=1.0-fnp.abs(2.0*uni-1.0); uni=fnp.clip(uni,1e-11,1-1e-11)
    dirs=flops.stats.norm.ppf(uni); r=fnp.sqrt(fnp.sum(dirs*dirs,axis=1))[:,None]; dirs=dirs/fnp.maximum(r,1e-30)
    x=fnp.concatenate((dirs,-dirs),axis=0)
    rows=[]; first=None; final=mlp.depth-1
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            rows.append(submission._exact_first_layer_mean(w)); first=x
        elif li==final:
            fm=fnp.mean(x,axis=0); cf=x-fm[None,:]
            em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
            am=fnp.mean(first,axis=0); cx=first-em[None,:]
            beta=fnp.linalg.solve(cov,(cx.T@cf)/x.shape[0]); corr=(am-em)@beta
            rows.append(mr*(fm-corr))
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
for cfg in [(32,8,5_000_000_000,900000,6),(32,4,3_000_000_000,1000000,6),(64,4,10_000_000_000,600000,5),(16,4,1_000_000_000,1000000,6)]:
    w,d,b,tn,reps=cfg; scores={'cur':[],'anti':[]}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(101000+113*i+w),seed=66666+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(102000+i))
        est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
        scores['cur'].append(mse(est.predict(mlp,b),target))
        scores['anti'].append(mse(pred_antidir(mlp,b),target))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for k,a in scores.items(): print(k,sum(a)/len(a),a)

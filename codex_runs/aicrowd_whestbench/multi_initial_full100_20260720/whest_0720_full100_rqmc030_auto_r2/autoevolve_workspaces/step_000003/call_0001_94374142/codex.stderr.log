        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(152000+i))
        for s in scales:
            scores[s].append(mse(pred_scale(mlp,b,s),target))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for s in scales:

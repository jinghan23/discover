# Faster local scale refinement around/below 0.75.
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_scale(mlp,budget,scale):
    old=submission._VECTOR_CONTROL_SCALE
    submission._VECTOR_CONTROL_SCALE=scale
    est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
    p=est.predict(mlp,budget)
    submission._VECTOR_CONTROL_SCALE=old
    return p

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
scales=[0.35,0.5,0.6,0.7,0.75,0.8,0.9,1.0]
for cfg in [(32,8,5_000_000_000,900000,5),(32,4,3_000_000_000,1000000,5),(64,4,10_000_000_000,600000,4),(16,4,1_000_000_000,1000000,5)]:

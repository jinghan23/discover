/bin/bash -lc "python - <<'PY'
import math, warnings, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

# Reuse submission helpers/control code with selectable initial directions.
def predict_with_dirs(mlp, budget, mode):
    n_samples = submission._sample_count(budget, mlp.width, mlp.depth)
    rng = fnp.random.default_rng(mlp.seed)
    generator = submission._lattice_generator(mlp.width)
    if mode == 'current':
        n_per_shift=max(1,n_samples//2); actual=n_per_shift*2
        base_shift=rng.random(mlp.width)
        uniforms=fnp.concatenate((submission._lattice_uniforms(n_per_shift,generator,base_shift),submission._lattice_uniforms(n_per_shift,generator,1.0-base_shift)),axis=0)
        uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
        uniforms=fnp.clip(uniforms, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
        activations=flops.stats.norm.ppf(uniforms)
        radii=fnp.sqrt(fnp.sum(activations*activations,axis=1))[:,None]
        activations=activations/fnp.maximum(radii,1e-30)
    elif mode == 'antidir':
        n_base=max(1,n_samples//2); actual=n_base*2
        shift=rng.random(mlp.width)
        uniforms=submission._lattice_uniforms(n_base,generator,shift)
        uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
        uniforms=fnp.clip(uniforms, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
        dirs=flops.stats.norm.ppf(uniforms)
        radii=fnp.sqrt(fnp.sum(dirs*dirs,axis=1))[:,None]
        dirs=dirs/fnp.maximum(radii,1e-30)
        activations=fnp.concatenate((dirs, -dirs), axis=0)
    elif mode == 'anticomp':
        n_base=max(1,n_samples//2); actual=n_base*2
        shift=rng.random(mlp.width)
        uniforms=submission._lattice_uniforms(n_base,generator,shift)
        uniforms=fnp.concatenate((uniforms,1.0-uniforms),axis=0)
        uniforms=fnp.clip(uniforms, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
        activations=flops.stats.norm.ppf(uniforms)
        radii=fnp.sqrt(fnp.sum(activations*activations,axis=1))[:,None]
        activations=activations/fnp.maximum(radii,1e-30)
    else:
        raise ValueError
    actual=activations.shape[0]
    mean_radius=submission._mean_standard_normal_radius(mlp.width)
    use_vector_control=actual >= mlp.width
    rows=[]; zero=fnp.zeros(mlp.width,dtype=fnp.float64); final=mlp.depth-1
    first_row=None; first_act=None; first_preact_sq=None
    for li,w in enumerate(mlp.weights):
        pre=activations@w
        activations=fnp.maximum(pre,0.0)
        if li==0:
            first_row=submission._exact_first_layer_mean(w)
            first_act=activations
            if not use_vector_control:
                first_preact_sq=fnp.sum(pre*pre,axis=1)
            rows.append(first_row)
        elif li==final:
            fm=fnp.mean(activations,axis=0); centered_final=activations-fm[None,:]
            if use_vector_control:
                em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mean_radius)
                am=fnp.mean(first_act,axis=0)
                cf=first_act-em[None,:]
                cc=(cf.T@centered_final)/first_act.shape[0]
                coef=fnp.linalg.solve(cov,cc)
                corr=(am-em)@coef
                rows.append(mean_radius*(fm-corr))
            else:
                rows.append(mean_radius*fm)
        else:
            rows.append(zero)
    return fnp.stack(rows,axis=0)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))

for cfg in [(16,4,100_000_000,1000000,6),(32,4,300_000_000,800000,5),(32,8,500_000_000,700000,5),(64,4,1_000_000_000,400000,4)]:
    width,depth,budget,target_n,reps=cfg
    scores={m:[] for m in ['current','antidir','anticomp']}
    t=time.time()
    for i in range(reps):
        mlp=sample_mlp(width,depth,fnp.random.default_rng(10000+97*i+width),seed=12345+i)
        target,_,_=sample_layer_statistics(mlp,target_n,fnp.random.default_rng(80000+i))
        for m in scores:
            p = submission.Estimator().predict(mlp,budget) if m=='current' else predict_with_dirs(mlp,budget,m)
            scores[m].append(mse(p,target))
    print('cfg',cfg,'n',submission._sample_count(budget,width,depth),'time',round(time.time()-t,1))
    for m,a in scores.items(): print(m, sum(a)/len(a), a)

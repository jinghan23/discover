codex
A more principled extra control is the first-layer preactivation vector. Its exact sphere mean and covariance with the first ReLU vector are available, so I’m testing an exact `[ReLU(z), z]` vector control locally with measured compute.
exec
/bin/bash -lc "python - <<'PY'
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def pred_augpre(mlp,budget):
    est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
    n=submission._sample_count(budget,mlp.width,mlp.depth); nper=max(1,n//2); actual=nper*2
    rng=fnp.random.default_rng(mlp.seed); gen,mr,ident,zero=est._constants_for_width(mlp.width); base=rng.random(mlp.width)
    uni=fnp.concatenate((submission._lattice_uniforms(nper,gen,base),submission._lattice_uniforms(nper,gen,1-base)),axis=0)
    uni=1-fnp.abs(2*uni-1); uni=fnp.clip(uni,1e-11,1-1e-11)
    x=flops.stats.norm.ppf(uni); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    rows=[]; first=None; pre0=None; final=mlp.depth-1
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            rows.append(submission._exact_first_layer_mean(w)); first=x; pre0=pre
        elif li==final:
            fm=fnp.mean(x,axis=0); cy=x-fm[None,:]
            # exact augmented covariance for controls [relu(z), z] on unit sphere.
            gram=mlp.weights[0].T@mlp.weights[0]
            ns=fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0),0.0)
            sd=fnp.sqrt(ns); outer=sd[:,None]*sd[None,:]
            corr=fnp.clip(gram/fnp.maximum(outer,1e-300),-1.0,1.0)
            kernel=(fnp.sqrt(fnp.maximum(1-corr*corr,0.0))+(fnp.pi-fnp.arccos(corr))*corr)/(2*fnp.pi)
            ex=sd/(fnp.sqrt(2*fnp.pi)*mr)
            exx=outer*kernel/mlp.width
            covxx=exx-ex[:,None]*ex[None,:]
            covxz=gram/(2.0*mlp.width)
            covzz=gram/mlp.width
            top=fnp.concatenate((covxx,covxz),axis=1)
            bot=fnp.concatenate((covxz.T,covzz),axis=1)
            cov=fnp.concatenate((top,bot),axis=0)+1e-8*fnp.eye(2*mlp.width,dtype=fnp.float64)
            controls=fnp.concatenate((first,pre0),axis=1)
            em=fnp.concatenate((ex,fnp.zeros(mlp.width,dtype=fnp.float64)),axis=0)
            cm=fnp.mean(controls,axis=0); cc=controls-em[None,:]
            beta=fnp.linalg.solve(cov,(cc.T@cy)/actual)
            corrmean=(cm-em)@beta
            rows.append(mr*(fm-corrmean))
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
for cfg in [(32,8,5_000_000_000,900000,5),(32,4,3_000_000_000,1000000,5),(64,4,10_000_000_000,600000,4),(16,4,1_000_000_000,1000000,5)]:
    w,d,b,tn,reps=cfg; vals={'cur':[],'augpre':[]}; comps={'cur':[],'augpre':[]}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(131000+137*i+w),seed=99999+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(132000+i))
        est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
        with flops.budget(10**15,quiet=True) as bc:
            p=est.predict(mlp,b)
        vals['cur'].append(mse(p,target)); comps['cur'].append(max(0.1,(bc.flops_used+1e11*bc.residual_wall_time_s)/b))
        with flops.budget(10**15,quiet=True) as bc:
            p=pred_augpre(mlp,b)
        vals['augpre'].append(mse(p,target)); comps['augpre'].append(max(0.1,(bc.flops_used+1e11*bc.residual_wall_time_s)/b))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for k in vals:
        m=sum(vals[k])/len(vals[k]); c=sum(comps[k])/len(comps[k]); print(k,'mse',m,'mult',c,'prod',m*c,'vals',vals[k])

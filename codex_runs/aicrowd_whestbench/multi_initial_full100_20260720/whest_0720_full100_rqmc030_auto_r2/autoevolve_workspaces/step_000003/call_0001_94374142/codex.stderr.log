/bin/bash -lc "python - <<'PY'
import warnings, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def exact_scalar_controls(weight, first_row, mean_radius, width):
    ns=fnp.sum(weight*weight,axis=0)
    return fnp.stack((
        0.5*fnp.sum(ns)/width,
        submission._sphere_relu_third_moment_scale(width)*fnp.sum(ns*fnp.sqrt(ns)),
        1.5*fnp.sum(ns*ns)/(width*(width+2)),
        fnp.sum(ns)/width,
        3.0*fnp.sum(ns*ns)/(width*(width+2)),
    ))

def predict_vscalar(mlp,budget, mode):
    n_samples=submission._sample_count(budget,mlp.width,mlp.depth)
    n_per=max(1,n_samples//submission._SHIFT_COUNT); actual=n_per*submission._SHIFT_COUNT
    use_vector=actual>=mlp.width
    rng=fnp.random.default_rng(mlp.seed)
    gen=submission._lattice_generator(mlp.width); shift=rng.random(mlp.width)
    uniforms=fnp.concatenate(tuple(submission._lattice_uniforms(n_per,gen,shift if si==0 else 1.0-shift) for si in range(submission._SHIFT_COUNT)),axis=0)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
    uniforms=fnp.clip(uniforms, submission._TAIL_CLIP,1-submission._TAIL_CLIP)
    activations=flops.stats.norm.ppf(uniforms)
    radii=fnp.sqrt(fnp.sum(activations*activations,axis=1))[:,None]
    activations=activations/fnp.maximum(radii,1e-30)
    mean_radius=submission._mean_standard_normal_radius(mlp.width)
    rows=[]; final=mlp.depth-1; zero=fnp.zeros(mlp.width,dtype=fnp.float64)
    first_act=None; first_pre=None; first_row=None
    for li,w in enumerate(mlp.weights):
        pre=activations@w
        activations=fnp.maximum(pre,0.0)
        if li==0:
            first_row=submission._exact_first_layer_mean(w); first_act=activations; first_pre=pre; rows.append(first_row)
        elif li==final:
            fm=fnp.mean(activations,axis=0); centered_final=activations-fm[None,:]
            if use_vector:
                em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mean_radius)
                am=fnp.mean(first_act,axis=0)
                cx=first_act-em[None,:]
                cc=(cx.T@centered_final)/first_act.shape[0]
                beta=fnp.linalg.solve(cov,cc)
                corr=(am-em)@beta
                if mode=='vscalar':
                    s2=fnp.sum(first_act*first_act,axis=1)
                    s3=fnp.sum(first_act*first_act*first_act,axis=1)
                    s4=fnp.sum(first_act*first_act*first_act*first_act,axis=1)
                    ps2=fnp.sum(first_pre*first_pre,axis=1)
                    ps4=fnp.sum(first_pre*first_pre*first_pre*first_pre,axis=1)
                    z=fnp.stack((s2,s3,s4,ps2,ps4),axis=1)
                    ez=exact_scalar_controls(mlp.weights[0],first_row,mean_radius,mlp.width)
                    zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                    # residualize final against vector control approximately.
                    res=centered_final-cx@beta
                    res=res-fnp.mean(res,axis=0)[None,:]
                    covz=cz.T@cz + 1e-8*first_act.shape[0]*fnp.eye(5,dtype=fnp.float64)
                    cross=cz.T@res
                    gamma=fnp.linalg.solve(covz,cross)
                    corr=corr+(zm-ez)@gamma
                elif mode=='aug2w':
                    # add per-neuron squares as controls in one sample covariance solve.
                    z=fnp.concatenate((first_act, first_act*first_act), axis=1)
                    ns=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
                    ez=fnp.concatenate((em, ns/(2.0*mlp.width)), axis=0)
                    zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                    covz=cz.T@cz + 1e-7*first_act.shape[0]*fnp.eye(2*mlp.width,dtype=fnp.float64)
                    cross=cz.T@centered_final
                    gamma=fnp.linalg.solve(covz,cross)
                    corr=(zm-ez)@gamma
                rows.append(mean_radius*(fm-corr))
            else:
                rows.append(mean_radius*fm)
        else: rows.append(zero)
    return fnp.stack(rows,axis=0)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))

for cfg in [(16,4,100_000_000,1000000,6),(32,4,300_000_000,800000,5),(32,8,500_000_000,700000,5),(64,4,1_000_000_000,400000,4),(64,8,1_500_000_000,300000,4)]:
    width,depth,budget,target_n,reps=cfg
    scores={m:[] for m in ['cur','vscalar','aug2w']}
    t=time.time()
    for i in range(reps):
        mlp=sample_mlp(width,depth,fnp.random.default_rng(20000+97*i+width),seed=54321+i)
        target,_,_=sample_layer_statistics(mlp,target_n,fnp.random.default_rng(90000+i))
        scores['cur'].append(mse(submission.Estimator().predict(mlp,budget),target))
        for m in ['vscalar','aug2w']:
            scores[m].append(mse(predict_vscalar(mlp,budget,m),target))
    print('cfg',cfg,'n',submission._sample_count(budget,width,depth),'time',round(time.time()-t,1))
    for m,a in scores.items(): print(m, sum(a)/len(a), a)

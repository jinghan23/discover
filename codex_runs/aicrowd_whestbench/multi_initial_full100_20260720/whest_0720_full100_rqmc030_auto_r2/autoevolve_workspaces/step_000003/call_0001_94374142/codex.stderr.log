# High-sample diagonal square/cubic controls with measured compute.
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def predict_diag(mlp,budget):
    est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
    n=submission._sample_count(budget,mlp.width,mlp.depth); nper=max(1,n//2); actual=nper*2
    rng=fnp.random.default_rng(mlp.seed); gen,mr,ident,zero=est._constants_for_width(mlp.width); base=rng.random(mlp.width)
    uni=fnp.concatenate((submission._lattice_uniforms(nper,gen,base),submission._lattice_uniforms(nper,gen,1-base)),axis=0)
    uni=1-fnp.abs(2*uni-1); uni=fnp.clip(uni,1e-11,1-1e-11)
    x=flops.stats.norm.ppf(uni); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    rows=[]; first=None; final=mlp.depth-1
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0:
            rows.append(submission._exact_first_layer_mean(w)); first=x
        elif li==final:
            fm=fnp.mean(x,axis=0); cy=x-fm[None,:]
            em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
            am=fnp.mean(first,axis=0); cx=first-em[None,:]
            beta=fnp.linalg.solve(cov,(cx.T@cy)/actual); corr=(am-em)@beta
            res=cy-cx@beta; res=res-fnp.mean(res,axis=0)[None,:]
            ns=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
            # square and cubic diagonal controls.
            for z, ez in (
                (first*first, ns/(2.0*mlp.width)),
                (first*first*first, submission._sphere_relu_third_moment_scale(mlp.width)*(ns*fnp.sqrt(ns))),
            ):
                zm=fnp.mean(z,axis=0); cz=z-zm[None,:]
                var=fnp.sum(cz*cz,axis=0)+1e-8*actual
                gamma=(cz.T@res)/var[:,None]
                corr=corr+(zm-ez)@gamma
            rows.append(mr*(fm-corr))
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
for cfg in [(32,8,5_000_000_000,900000,5),(32,4,3_000_000_000,1000000,5),(64,4,10_000_000_000,600000,4)]:
    w,d,b,tn,reps=cfg; vals={'cur':[],'diag':[]}; comps={'cur':[],'diag':[]}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(121000+131*i+w),seed=88888+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(122000+i))
        est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
        with flops.budget(10**15,quiet=True) as bc:
            p=est.predict(mlp,b)
        vals['cur'].append(mse(p,target)); comps['cur'].append(max(0.1,(bc.flops_used+1e11*bc.residual_wall_time_s)/b))
        with flops.budget(10**15,quiet=True) as bc:
            p=predict_diag(mlp,b)
        vals['diag'].append(mse(p,target)); comps['diag'].append(max(0.1,(bc.flops_used+1e11*bc.residual_wall_time_s)/b))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for k in vals:
        m=sum(vals[k])/len(vals[k]); c=sum(comps[k])/len(comps[k]); print(k,'mse',m,'mult',c,'prod',m*c,'vals',vals[k])

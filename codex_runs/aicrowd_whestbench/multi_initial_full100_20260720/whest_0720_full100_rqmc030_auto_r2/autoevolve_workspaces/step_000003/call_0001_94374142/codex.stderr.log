import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

def lattice(n,g,shift,off):
    idx=(fnp.arange(n,dtype=fnp.float64)+off)[:,None]
    u=idx*g[None,:]+shift[None,:]
    return u-fnp.floor(u)

def pred_off(mlp,budget,off):
    n=submission._sample_count(budget,mlp.width,mlp.depth); nper=max(1,n//2); actual=2*nper
    rng=fnp.random.default_rng(mlp.seed); gen=submission._lattice_generator(mlp.width); base=rng.random(mlp.width)
    uni=fnp.concatenate((lattice(nper,gen,base,off),lattice(nper,gen,1.0-base,off)),axis=0)
    uni=1.0-fnp.abs(2.0*uni-1.0); uni=fnp.clip(uni,1e-11,1-1e-11)
    x=flops.stats.norm.ppf(uni); r=fnp.sqrt(fnp.sum(x*x,axis=1))[:,None]; x=x/fnp.maximum(r,1e-30)
    mr=submission._mean_standard_normal_radius(mlp.width); rows=[]; zero=fnp.zeros(mlp.width,dtype=fnp.float64); final=mlp.depth-1; first=None
    for li,w in enumerate(mlp.weights):
        pre=x@w; x=fnp.maximum(pre,0.0)
        if li==0: rows.append(submission._exact_first_layer_mean(w)); first=x
        elif li==final:
            fm=fnp.mean(x,axis=0); cf=x-fm[None,:]
            em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr)
            am=fnp.mean(first,axis=0); cx=first-em[None,:]
            beta=fnp.linalg.solve(cov,(cx.T@cf)/first.shape[0]); corr=(am-em)@beta
            rows.append(mr*(fm-corr))
        else: rows.append(zero)
    return fnp.stack(rows)

def mse(a,b):
    d=fnp.asarray(a[-1],dtype=fnp.float64)-fnp.asarray(b[-1],dtype=fnp.float64)
    return float(fnp.mean(d*d))
orig=submission._TARGET_FLOP_FRACTION; submission._TARGET_FLOP_FRACTION=0.14
for cfg in [(32,8,5_000_000_000,900000,6),(32,4,3_000_000_000,1000000,6),(64,4,10_000_000_000,600000,5),(16,4,1_000_000_000,1000000,6)]:
    w,d,b,tn,reps=cfg; offs=[0.0,0.5,0.25,0.75]
    scores={o:[] for o in offs}; t=time.time()
    for i in range(reps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(91000+109*i+w),seed=55555+i)
        target,_,_=sample_layer_statistics(mlp,tn,fnp.random.default_rng(92000+i))
        for o in offs:
            p=submission.Estimator().predict(mlp,b) if o==0.0 else pred_off(mlp,b,o)
            scores[o].append(mse(p,target))
    print('cfg',cfg,'time',round(time.time()-t,1))
    for o,a in scores.items(): print(o,sum(a)/len(a),a)
submission._TARGET_FLOP_FRACTION=orig

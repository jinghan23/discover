import math, time
import numpy as np
W=256;D=32;N=100000;NMLP=5
rng0=np.random.default_rng(121000)
vars=[]; means=[]; t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(122000+i)
 weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 srng=np.random.default_rng(123000+i)
 total=np.zeros(W); total2=np.zeros(W); done=0; chunk=2500
 while done<N:
  m=min(chunk,N-done); x=srng.standard_normal((m,W)).astype(np.float32)
  for A in weights: x=np.maximum(x@A,0)
  xf=x.astype(np.float64); total+=xf.sum(0); total2+=(xf*xf).sum(0); done+=m
 mean=total/N; var=total2/N-mean*mean
 vars.append(var.mean()); means.append(np.mean(mean*mean))
 print(i,'avg_var',vars[-1],'noise_floor_mse',vars[-1]/(100*100*256),'elapsed',round(time.time()-t,1))
print('mean avg_var',np.mean(vars),'target_noise_floor',np.mean(vars)/(100*100*256))

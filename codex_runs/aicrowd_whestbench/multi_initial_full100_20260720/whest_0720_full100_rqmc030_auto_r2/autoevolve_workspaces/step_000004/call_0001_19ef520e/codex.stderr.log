# Local ridge sweep at width 256.
import math,time
import numpy as np
from scipy.special import ndtri
W=256;D=32;N=9000;REF=60000;NMLP=5;TAIL=1e-11

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W)); g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed):
 rng=np.random.default_rng(seed); n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
 z=np.concatenate(arr); return z/np.linalg.norm(z,axis=1,keepdims=True)
def cov_base(W0):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR); return em,out*k/W-em[:,None]*em[None,:]
def parts(weights,seed):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
 fm=x.mean(0); cf=x-fm; em,ec=cov_base(weights[0]); cfst=first-em[None,:]
 cross=(cfst.T@cf)/N; delta=first.mean(0)-em
 return fm,ec,cross,delta
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=3000
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W)); x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return MR*total/REF
ridges=[0,1e-10,1e-9,1e-8,1e-7,1e-6,1e-5]; s={r:[] for r in ridges};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(81000+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,82000+i); fm,ec,cross,delta=parts(weights,83000+i)
 for rg in ridges:
  coef=np.linalg.solve(ec+rg*np.eye(W),cross); p=MR*(fm-.763*(delta@coef)); s[rg].append(np.mean((p-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for rg,a in s.items():
 arr=np.array(a); print(rg,arr.mean(),arr.std(ddof=1)/math.sqrt(len(arr)))

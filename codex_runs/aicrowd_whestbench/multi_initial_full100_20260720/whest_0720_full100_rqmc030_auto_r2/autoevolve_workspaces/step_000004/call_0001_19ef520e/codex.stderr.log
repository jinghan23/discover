I’m testing input-sphere moment corrections locally: recenter or whiten the direction set before the network. This is another way to reduce finite lattice error without changing the estimator’s main structure.
exec
/bin/bash -lc "python - <<'PY'
# Input direction mean/cov correction local test.
import math,time
import numpy as np
from scipy.special import ndtri
W=128;D=32;N=9000;REF=100000;NMLP=8;TAIL=1e-11;RIDGE=1e-8

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W));g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed,mode):
 rng=np.random.default_rng(seed);n2=N//2;idx=np.arange(n2)[:,None];sh=rng.random(W);arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1;u=1-np.abs(2*u-1);u=np.clip(u,TAIL,1-TAIL);arr.append(ndtri(u))
 z=np.concatenate(arr);x=z/np.linalg.norm(z,axis=1,keepdims=True)
 if mode=='center':
  x=x-x.mean(0)[None,:]; x=x/np.linalg.norm(x,axis=1,keepdims=True)
 elif mode=='whiten':
  x=x-x.mean(0)[None,:]; S=x.T@x/N+1e-8*np.eye(W); L=np.linalg.cholesky(S); x=np.linalg.solve(L,x.T).T/math.sqrt(W); x=x/np.linalg.norm(x,axis=1,keepdims=True)
 elif mode=='whiten_nonorm':
  x=x-x.mean(0)[None,:]; S=x.T@x/N+1e-8*np.eye(W); L=np.linalg.cholesky(S); x=np.linalg.solve(L,x.T).T/math.sqrt(W)
 return x
def first_mom(W0):
 gram=W0.T@W0;ns=np.maximum(np.sum(W0*W0,0),0);sd=np.sqrt(ns);out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1);k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR);cov=out*k/W-em[:,None]*em[None,:]
 return em,cov+RIDGE*np.eye(W)
def est(weights,seed,mode):
 x=dirs(seed,mode)
 for li,A in enumerate(weights):
  pre=x@A;x=np.maximum(pre,0)
  if li==0:first=x.copy()
 fm=x.mean(0);cf=x-fm;em,ec=first_mom(weights[0]);cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N);return MR*(fm-.763*((first.mean(0)-em)@coef))
def ref(weights,seed):
 rng=np.random.default_rng(seed);total=np.zeros(W);done=0;chunk=5000
 while done<REF:
  m=min(chunk,REF-done);x=rng.standard_normal((m,W));x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights:x=np.maximum(x@A,0)
  total+=x.sum(0);done+=m
 return MR*total/REF
modes=['none','center','whiten','whiten_nonorm'];s={m:[] for m in modes};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(171000+i);weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,172000+i)
 for m in modes:s[m].append(np.mean((est(weights,173000+i,m)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for m,a in s.items():
 a=np.array(a);print(f'{m:14s} {a.mean():.6e} se {a.std(ddof=1)/math.sqrt(len(a)):.2e}')

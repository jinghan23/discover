/bin/bash -lc "python - <<'PY'
# Width-256 focused synthetic check: current vs raw antithetic vs current+scalar, low reference N for signal only.
import math, time
import numpy as np
from scipy.special import ndtri
W=256; D=32; N=9000; REF=40000; NMLP=3; TAIL=1e-11; RIDGE=1e-8

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W)); g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed,mode):
 rng=np.random.default_rng(seed)
 if mode=='current':
  n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
  for s in (sh,1-sh):
   u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
  z=np.concatenate(arr)
 elif mode=='rawanti':
  n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); u=(idx*g[None,:]+sh[None,:])%1; u=np.clip(u,TAIL,1-TAIL); z0=ndtri(u); z=np.concatenate([z0,-z0])
 elif mode=='rawsingle':
  idx=np.arange(N)[:,None]; sh=rng.random(W); u=(idx*g[None,:]+sh[None,:])%1; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u)
 else: raise ValueError
 return z/np.linalg.norm(z,axis=1,keepdims=True)
def cov(W0):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR); return em,out*k/W-em[:,None]*em[None,:]+RIDGE*np.eye(W)
def est(weights,seed,mode):
 x=dirs(seed,mode)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
 fm=x.mean(0); cf=x-fm; em,ec=cov(weights[0]); cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N); return MR*(fm-.763*((first.mean(0)-em)@coef))
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=2500
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W)); x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return MR*total/REF
scores={k:[] for k in ['current','rawanti','rawsingle']}; t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(500+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,600+i)
 for mode in scores: scores[mode].append(np.mean((est(weights,700+i,mode)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1),{k:scores[k][-1] for k in scores})
print('RESULTS')
for k,a in scores.items():
 a=np.array(a); print(k,a.mean(),a.std(ddof=1)/math.sqrt(len(a)))

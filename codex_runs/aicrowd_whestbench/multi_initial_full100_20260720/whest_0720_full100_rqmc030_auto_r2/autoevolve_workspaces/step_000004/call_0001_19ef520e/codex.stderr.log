# Compare float64 vs float32 estimator forward against float32 MC reference.
import math,time
import numpy as np
from scipy.special import ndtri
W=128;D=32;N=9000;REF=100000;NMLP=10;TAIL=1e-11;RIDGE=1e-8

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W));g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed,dtype):
 rng=np.random.default_rng(seed);n2=N//2;idx=np.arange(n2)[:,None];sh=rng.random(W);arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1;u=1-np.abs(2*u-1);u=np.clip(u,TAIL,1-TAIL);arr.append(ndtri(u))
 z=np.concatenate(arr);z=z/np.linalg.norm(z,axis=1,keepdims=True);return z.astype(dtype)
def first_mom(W0):
 Wd=W0.astype(float);gram=Wd.T@Wd;ns=np.maximum(np.sum(Wd*Wd,0),0);sd=np.sqrt(ns);out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1);k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR);cov=out*k/W-em[:,None]*em[None,:]
 return em,cov+RIDGE*np.eye(W)
def est(weights,seed,dtype):
 x=dirs(seed,dtype)
 for li,A in enumerate(weights):
  pre=x@A;x=np.maximum(pre,0)
  if li==0:first=x.copy()
 fm=x.astype(float).mean(0);cf=x.astype(float)-fm;em,ec=first_mom(weights[0]);cfst=first.astype(float)-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N);return MR*(fm-.763*((first.astype(float).mean(0)-em)@coef))
def ref(weights,seed):
 rng=np.random.default_rng(seed);total=np.zeros(W);done=0;chunk=5000
 while done<REF:
  m=min(chunk,REF-done);x=rng.standard_normal((m,W)).astype(np.float32)
  for A in weights:x=np.maximum(x@A,0)
  xf=x.astype(float);total+=xf.sum(0);done+=m
 return total/REF
s={'f64':[],'f32':[]};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(161000+i);weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 r=ref(weights,162000+i)
 for dt,name in [(np.float64,'f64'),(np.float32,'f32')]:s[name].append(np.mean((est(weights,163000+i,dt)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')

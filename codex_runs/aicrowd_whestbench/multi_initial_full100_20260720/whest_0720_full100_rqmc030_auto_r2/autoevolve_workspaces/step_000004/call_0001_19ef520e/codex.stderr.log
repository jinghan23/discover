import math, time
import numpy as np
from scipy.special import ndtri

TARGET_N=9000
REF_N=200000
WIDTH=64
DEPTH=32
NMLP=8
VECTOR_SCALE=0.763
RIDGE=1e-8
TAIL=1e-11


def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def mean_radius(w):
    return math.sqrt(2)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

def sphere_cubic_scale(w):
    er3=(2.0**1.5)*math.exp(math.lgamma(0.5*(w+3))-math.lgamma(0.5*w))
    return math.sqrt(2/math.pi)/er3

def gen_dirs(n,w,seed,mode):
    rng=np.random.default_rng(seed)
    if mode=='random':
        z=rng.standard_normal((n,w))
    else:
        g=np.sqrt(first_primes(w)); g=g-np.floor(g)
        if mode=='current':
            n2=n//2; shift=rng.random(w)
            arr=[]
            for s in (shift,1-shift):
                idx=np.arange(n2)[:,None]
                u=(idx*g[None,:]+s[None,:])%1.0
                u=1-np.abs(2*u-1)
                u=np.clip(u,TAIL,1-TAIL)
                arr.append(ndtri(u))
            z=np.concatenate(arr,axis=0)
        elif mode=='tent_antithetic':
            n2=n//2; shift=rng.random(w); idx=np.arange(n2)[:,None]
            u=(idx*g[None,:]+shift[None,:])%1.0
            u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL)
            z0=ndtri(u); z=np.concatenate([z0,-z0],axis=0)
        elif mode=='raw_antithetic':
            n2=n//2; shift=rng.random(w); idx=np.arange(n2)[:,None]
            u=(idx*g[None,:]+shift[None,:])%1.0
            u=np.clip(u,TAIL,1-TAIL)
            z0=ndtri(u); z=np.concatenate([z0,-z0],axis=0)
        elif mode=='single_tent':
            shift=rng.random(w); idx=np.arange(n)[:,None]
            u=(idx*g[None,:]+shift[None,:])%1.0
            u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL)
            z=ndtri(u)
        else:
            raise ValueError(mode)
    r=np.linalg.norm(z,axis=1,keepdims=True)
    return z/np.maximum(r,1e-30)

def first_exact_cov(W0):
    w=W0.shape[0]
    gram=W0.T@W0
    ns=np.maximum(np.sum(W0*W0,axis=0),0)
    sd=np.sqrt(ns)
    outer=sd[:,None]*sd[None,:]
    corr=np.clip(gram/np.maximum(outer,1e-300),-1,1)
    kern=(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    second=outer*kern/w
    mr=mean_radius(w)
    mean=sd/(math.sqrt(2*math.pi)*mr)
    cov=second-mean[:,None]*mean[None,:]+RIDGE*np.eye(w)
    return mean,cov

def exact_scalars(W0):
    w=W0.shape[0]; ns=np.sum(W0*W0,axis=0); mr=mean_radius(w)
    first_row=np.sqrt(ns)/math.sqrt(2*math.pi)
    return np.array([
        np.sum(first_row)/mr,
        0.5*np.sum(ns)/w,
        sphere_cubic_scale(w)*np.sum(ns*np.sqrt(ns)),
        1.5*np.sum(ns*ns)/(w*(w+2)),
        np.sum(ns)/w,
        0.5*w,
    ])

def estimate(weights,seed,mode='current',scale=VECTOR_SCALE,scalar=False,scalar_residual=False):
    w=weights[0].shape[0]; mr=mean_radius(w)
    x=gen_dirs(TARGET_N,w,seed,mode)
    first=None; pre1=None
    for li,W in enumerate(weights):
        pre=x@W
        x=np.maximum(pre,0)
        if li==0:
            first=x.copy(); pre1=pre.copy()
    final_mean=x.mean(axis=0); centered_final=x-final_mean
    emean,ecov=first_exact_cov(weights[0])
    fmean=first.mean(axis=0)
    centered_first=first-emean[None,:]
    cross=centered_first.T@centered_final/first.shape[0]
    coef=np.linalg.solve(ecov,cross)
    correction=(fmean-emean)@coef
    pred=mr*(final_mean-scale*correction)
    if scalar:
        controls=np.stack([
            first.sum(axis=1),
            np.sum(first*first,axis=1),
            np.sum(first*first*first,axis=1),
            np.sum(first*first*first*first,axis=1),
            np.sum(pre1*pre1,axis=1),
            np.sum(pre1>0,axis=1),
        ],axis=1)
        cmean=controls.mean(axis=0)
        ccent=controls-cmean[None,:]
        ycent=centered_final
        if scalar_residual:
            ycent=centered_final - centered_first@coef*scale
        cc=ccent.T@ccent + 1e-8*first.shape[0]*np.eye(controls.shape[1])
        cy=ccent.T@ycent
        b=np.linalg.solve(cc,cy)
        corr=(cmean-exact_scalars(weights[0]))@b
        pred=pred-mr*corr
    return pred

def reference(weights,seed,n=REF_N):
    w=weights[0].shape[0]; mr=mean_radius(w)
    rng=np.random.default_rng(seed+999123)
    total=np.zeros(w)
    chunk=10000; done=0
    while done<n:
        m=min(chunk,n-done)
        z=rng.standard_normal((m,w)); z/=np.linalg.norm(z,axis=1,keepdims=True)
        x=z
        for W in weights:
            x=np.maximum(x@W,0)
        total+=x.sum(axis=0); done+=m
    return mr*total/n

modes=['current','single_tent','tent_antithetic','raw_antithetic','random']
variants=[]
for mode in modes:
    variants.append((mode,{},))
variants += [('current_scalar',{'mode':'current','scalar':True}),('current_scalar_resid',{'mode':'current','scalar':True,'scalar_residual':True})]
for sc in [0.6,0.7,0.8,0.9,1.0]:
    variants.append((f'scale{sc}',{'mode':'current','scale':sc}))

scores={name:[] for name,_ in variants}
t0=time.time()
for i in range(NMLP):
    rng=np.random.default_rng(1000+i)
    weights=[(rng.standard_normal((WIDTH,WIDTH))*math.sqrt(2/WIDTH)).astype(np.float64) for _ in range(DEPTH)]
    ref=reference(weights,20000+i)
    for name,kw in variants:
        pred=estimate(weights,30000+i,**kw)
        scores[name].append(np.mean((pred-ref)**2))
    print('mlp',i,'elapsed',time.time()-t0)
print('RESULTS')
for name in scores:
    arr=np.array(scores[name])
    print(name,arr.mean(),arr.std()/math.sqrt(len(arr)))

/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
from scipy.special import ndtr, ndtri
W=128; D=32; N=9000; REF=100000; NMLP=8; TAIL=1e-11; RIDGE=1e-8
# Helpers copied compactly

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W)); g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed):
 rng=np.random.default_rng(seed); n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
 z=np.concatenate(arr); return z/np.linalg.norm(z,axis=1,keepdims=True)
def first_kernel(W0, sphere=False):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 if sphere:
  mean=sd/(math.sqrt(2*math.pi)*MR); second=out*k/W
 else:
  mean=sd/math.sqrt(2*math.pi); second=out*k
 return mean, second-mean[:,None]*mean[None,:]
def rqmc(weights,seed,scale=.763):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
 fm=x.mean(0); cf=x-fm; em,ec=first_kernel(weights[0],sphere=True); ec+=RIDGE*np.eye(W); cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N); return MR*(fm-scale*((first.mean(0)-em)@coef))
def relu_mom(mean,var):
 std=np.sqrt(np.maximum(var,1e-30)); a=mean/std; phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi); Phi=ndtr(a)
 m=std*phi+mean*Phi
 s=(var+mean*mean)*Phi+mean*std*phi
 return m,s
def diag(weights,full_first=False, layer2_full=False):
 W0=weights[0]; ns=np.sum(W0*W0,0); mean=np.sqrt(ns)/math.sqrt(2*math.pi); second=.5*ns; var=second-mean*mean
 cov1=None
 if layer2_full and len(weights)>1:
  _,cov1=first_kernel(W0,sphere=False)
 for li,A in enumerate(weights[1:], start=1):
  pre_mean=mean@A
  if li==1 and cov1 is not None:
   pre_var=np.sum((A.T@cov1)*A.T,axis=1) # diag A.T cov A
  else:
   pre_var=var@(A*A)
  mean,second=relu_mom(pre_mean,pre_var); var=np.maximum(second-mean*mean,0)
 return mean
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=5000
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W));
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return total/REF
variants=['rqmc','diag','diagfull2','blend05','blend08','blend09','blend095','blend098']
s={v:[] for v in variants}; t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(12000+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,13000+i); q=rqmc(weights,14000+i); d=diag(weights); d2=diag(weights,layer2_full=True)
 vals={'rqmc':q,'diag':d,'diagfull2':d2}
 for a in [.5,.8,.9,.95,.98]: vals[f'blend{str(a).replace(\".\",\"\")}']=a*q+(1-a)*d2
 for v,p in vals.items(): s[v].append(np.mean((p-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for v,a in s.items():
 a=np.array(a); print(f'{v:10s} {a.mean():.6e} se {a.std(ddof=1)/math.sqrt(len(a)):.2e}')

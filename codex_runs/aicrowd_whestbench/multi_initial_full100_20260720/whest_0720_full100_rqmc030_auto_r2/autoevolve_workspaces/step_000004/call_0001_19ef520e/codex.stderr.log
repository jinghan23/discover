  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return MR*total/REF
s={'comp':[],'ind':[]};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(61000+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,62000+i)
 for m in s: s[m].append(np.mean((est(weights,63000+i,m)-r)**2))

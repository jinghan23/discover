# Synthetic test for final-layer Gaussianized ReLU moment blend.
import math, time
import numpy as np
from scipy.special import ndtr, ndtri
W=128; D=32; N=9000; REF=100000; NMLP=12; TAIL=1e-11; RIDGE=1e-8

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W)); g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def relu_mom(mu,var):
 std=np.sqrt(np.maximum(var,1e-30)); a=mu/std; phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi); Phi=ndtr(a); return std*phi+mu*Phi
def dirs(seed):
 rng=np.random.default_rng(seed); n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
 z=np.concatenate(arr); return z/np.linalg.norm(z,axis=1,keepdims=True)
def cov(W0):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR); return em,out*k/W-em[:,None]*em[None,:]+RIDGE*np.eye(W)
def est_parts(weights,seed):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
  if li==D-1: final_pre=pre.copy()
 fm=x.mean(0); cf=x-fm; em,ec=cov(weights[0]); cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N); corr=(first.mean(0)-em)@coef
 rq=MR*(fm-.763*corr)
 pm=final_pre.mean(0); pv=final_pre.var(0)
 ga=MR*relu_mom(pm,pv)
 # CV correction applied to gaussianized raw mean as if same first mean error
 gacv=MR*(relu_mom(pm,pv)-.763*corr)
 return rq,ga,gacv
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=5000
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W))
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return total/REF
alphas=[0, .5, .8, .9, .95, .98, 1.0]
keys=['rq','ga','gacv']+[f'blend{a}' for a in alphas]
s={k:[] for k in keys}; t=time.time()
for i in range(NMLP):

# Random quadratic first-layer controls local test.
import math,time
import numpy as np
from scipy.special import ndtri
W=128;D=32;N=9000;REF=100000;NMLP=10;TAIL=1e-11;RIDGE=1e-8

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W));g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed):
 rng=np.random.default_rng(seed);n2=N//2;idx=np.arange(n2)[:,None];sh=rng.random(W);arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1;u=1-np.abs(2*u-1);u=np.clip(u,TAIL,1-TAIL);arr.append(ndtri(u))
 z=np.concatenate(arr);return z/np.linalg.norm(z,axis=1,keepdims=True)
def first_mom(W0):
 gram=W0.T@W0;ns=np.maximum(np.sum(W0*W0,0),0);sd=np.sqrt(ns);out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1);k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR);cov=out*k/W-em[:,None]*em[None,:]
 return em,cov+RIDGE*np.eye(W)
def est(weights,seed,k=0,scaleq=1.0):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A;x=np.maximum(pre,0)
  if li==0:first=x.copy()
 fm=x.mean(0);cf=x-fm;em,ec=first_mom(weights[0]);cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/N); pred=MR*(fm-.763*((first.mean(0)-em)@coef))
 if k:
  rng=np.random.default_rng(seed+777); R=rng.standard_normal((W,k)); R/=np.linalg.norm(R,axis=0,keepdims=True)
  P=cfst@R; Q=P*P; qm=Q.mean(0); Qc=Q-qm[None,:]
  exact=np.sum(R*(ec@R),axis=0) # includes ridge tiny
  beta=np.linalg.solve(Qc.T@Qc+1e-8*N*np.eye(k), Qc.T@cf)
  pred=pred-MR*scaleq*((qm-exact)@beta)
 return pred
def ref(weights,seed):
 rng=np.random.default_rng(seed);total=np.zeros(W);done=0;chunk=5000
 while done<REF:
  m=min(chunk,REF-done);x=rng.standard_normal((m,W));x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights:x=np.maximum(x@A,0)
  total+=x.sum(0);done+=m
 return MR*total/REF
vars=[('base',0,1),('q4',4,1),('q8',8,1),('q16',16,1),('q8s05',8,.5),('q8s02',8,.2),('q8s-05',8,-.5)];s={n:[] for n,_,__ in vars};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(141000+i);weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,142000+i)
 for n,k,sc in vars:s[n].append(np.mean((est(weights,143000+i,k,sc)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for n,a in s.items():
 a=np.array(a);print(f'{n:8s} {a.mean():.6e} se {a.std(ddof=1)/math.sqrt(len(a)):.2e}')

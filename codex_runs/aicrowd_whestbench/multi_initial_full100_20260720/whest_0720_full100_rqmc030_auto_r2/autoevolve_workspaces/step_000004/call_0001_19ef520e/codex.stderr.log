                            exact_square_mean,
                            exact_cubic_mean,
                            exact_fourth_mean,
                            exact_preactivation_square_mean,
                        )
                    )
                    correction = (control_mean - exact_controls) @ coefficients
                    rows.append(mean_radius * (final_mean - correction))

            else:
                rows.append(zero_row)

        return fnp.stack(rows, axis=0)


# Local orthogonal-direction test at width 128.
import math, time
import numpy as np
from scipy.special import ndtri
W=128; D=32; N=8960; REF=100000; NMLP=8; TAIL=1e-11; RIDGE=1e-8

def primes(c):
 p=[]; x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W)); g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed,mode):
 rng=np.random.default_rng(seed)
 if mode=='lattice':
  n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
  for s in (sh,1-sh):
   u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
  z=np.concatenate(arr); return z/np.linalg.norm(z,axis=1,keepdims=True)
 if mode=='orth':
  rows=[]
  while len(rows)*W<N:
   A=rng.standard_normal((W,W)); Q,R=np.linalg.qr(A); Q=Q*np.sign(np.diag(R))[None,:]
   rows.append(Q)
  z=np.concatenate(rows,axis=0)[:N]
  return z
 if mode=='orthanti':
  rows=[]
  while len(rows)*2*W<N:
   A=rng.standard_normal((W,W)); Q,R=np.linalg.qr(A); Q=Q*np.sign(np.diag(R))[None,:]
   rows += [Q,-Q]
  return np.concatenate(rows,axis=0)[:N]
 if mode=='random':
  z=rng.standard_normal((N,W)); return z/np.linalg.norm(z,axis=1,keepdims=True)
def cov(W0):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR); return em,out*k/W-em[:,None]*em[None,:]+RIDGE*np.eye(W)
def est(weights,seed,mode):
 x=dirs(seed,mode)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
 fm=x.mean(0); cf=x-fm; em,ec=cov(weights[0]); cfst=first-em[None,:]
 coef=np.linalg.solve(ec,(cfst.T@cf)/len(x)); return MR*(fm-.763*((first.mean(0)-em)@coef))
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=5000
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W)); x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return MR*total/REF
modes=['lattice','orth','orthanti','random']; s={m:[] for m in modes}; t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(31000+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,32000+i)
 for m in modes: s[m].append(np.mean((est(weights,33000+i,m)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for m,a in s.items():
 a=np.array(a); print(f'{m:10s} {a.mean():.6e} se {a.std(ddof=1)/math.sqrt(len(a)):.2e}')

codex
A stronger variance-reduction idea is to moment-match the sampled first-layer activations before propagating deeper: force the first-layer sample mean, or mean and covariance, to the exact first-layer sphere moments. I’ll test this locally because it changes the estimator bias/variance tradeoff substantially.
exec
/bin/bash -lc "python - <<'PY'
# Test first-layer moment matching before remaining forward.
import math,time
import numpy as np
from scipy.special import ndtri
W=128;D=32;N=9000;REF=100000;NMLP=8;TAIL=1e-11;RIDGE=1e-7

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W));g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed):
 rng=np.random.default_rng(seed);n2=N//2;idx=np.arange(n2)[:,None];sh=rng.random(W);arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1;u=1-np.abs(2*u-1);u=np.clip(u,TAIL,1-TAIL);arr.append(ndtri(u))
 z=np.concatenate(arr);return z/np.linalg.norm(z,axis=1,keepdims=True)
def first_mom(W0):
 gram=W0.T@W0;ns=np.maximum(np.sum(W0*W0,0),0);sd=np.sqrt(ns);out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1);k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR);cov=out*k/W-em[:,None]*em[None,:]
 return em,cov
def current(weights,seed):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A;x=np.maximum(pre,0)
  if li==0:first=x.copy()

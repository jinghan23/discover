# Compare exact vs sample first-layer covariance in vector control.
import math,time
import numpy as np
from scipy.special import ndtri
W=128;D=32;N=9000;REF=100000;NMLP=10;TAIL=1e-11;RIDGE=1e-8

def primes(c):
 p=[];x=2
 while len(p)<c:
  ok=True
  for q in p:
   if q*q>x: break
   if x%q==0: ok=False; break
  if ok:p.append(x)
  x+=1
 return np.array(p)
g=np.sqrt(primes(W));g-=np.floor(g)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
MR=mr(W)
def dirs(seed):
 rng=np.random.default_rng(seed); n2=N//2; idx=np.arange(n2)[:,None]; sh=rng.random(W); arr=[]
 for s in (sh,1-sh):
  u=(idx*g[None,:]+s[None,:])%1; u=1-np.abs(2*u-1); u=np.clip(u,TAIL,1-TAIL); arr.append(ndtri(u))
 z=np.concatenate(arr); return z/np.linalg.norm(z,axis=1,keepdims=True)
def cov(W0):
 gram=W0.T@W0; ns=np.maximum(np.sum(W0*W0,0),0); sd=np.sqrt(ns); out=sd[:,None]*sd[None,:]
 c=np.clip(gram/np.maximum(out,1e-300),-1,1); k=(np.sqrt(np.maximum(1-c*c,0))+(math.pi-np.arccos(c))*c)/(2*math.pi)
 em=sd/(math.sqrt(2*math.pi)*MR); return em,out*k/W-em[:,None]*em[None,:]+RIDGE*np.eye(W)
def est(weights,seed,mode,scale=.763):
 x=dirs(seed)
 for li,A in enumerate(weights):
  pre=x@A; x=np.maximum(pre,0)
  if li==0: first=x.copy()
 fm=x.mean(0); cf=x-fm; em,ec=cov(weights[0]); cfst=first-em[None,:]
 cross=cfst.T@cf
 if mode=='exact': coef=np.linalg.solve(ec,cross/N)
 else:
  sample_cov=cfst.T@cfst+RIDGE*N*np.eye(W); coef=np.linalg.solve(sample_cov,cross)
 return MR*(fm-scale*((first.mean(0)-em)@coef))
def ref(weights,seed):
 rng=np.random.default_rng(seed); total=np.zeros(W); done=0; chunk=5000
 while done<REF:
  m=min(chunk,REF-done); x=rng.standard_normal((m,W)); x/=np.linalg.norm(x,axis=1,keepdims=True)
  for A in weights: x=np.maximum(x@A,0)
  total+=x.sum(0); done+=m
 return MR*total/REF
vars=[('exact',.763),('sample',.763),('sample1',1.0),('sample05',.5)]; s={v:[] for v,_ in vars};t=time.time()
for i in range(NMLP):
 rng=np.random.default_rng(91000+i); weights=[(rng.standard_normal((W,W))*math.sqrt(2/W)).astype(float) for _ in range(D)]
 r=ref(weights,92000+i)
 for name,sc in vars:
  mode='sample' if name.startswith('sample') else 'exact'; s[name].append(np.mean((est(weights,93000+i,mode,sc)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for k,a in s.items():
 arr=np.array(a); print(k,arr.mean(),arr.std(ddof=1)/math.sqrt(len(arr)))

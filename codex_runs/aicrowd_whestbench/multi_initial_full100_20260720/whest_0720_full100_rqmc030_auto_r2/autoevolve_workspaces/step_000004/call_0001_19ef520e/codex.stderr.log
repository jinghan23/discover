 r=ref(weights,72000+i); fm,corr=parts(weights,73000+i)
 for a in scales: s[a].append(np.mean((MR*(fm-a*corr)-r)**2))
 print('mlp',i,'elapsed',round(time.time()-t,1))
print('RESULTS')
for a,v in s.items():
 arr=np.array(v); print(a,arr.mean(),arr.std(ddof=1)/math.sqrt(len(arr)))

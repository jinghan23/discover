+    second_moment = (safe_variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    relu_variance = fnp.maximum(second_moment - relu_mean * relu_mean, 0.0)
+    return relu_mean, relu_variance
+
+
+def _diagonal_gaussian_final_mean(mlp) -> fnp.ndarray:
+    first_norm_squared = fnp.maximum(
+        fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0), 0.0
+    )
+    mean = fnp.sqrt(first_norm_squared) / fnp.sqrt(2.0 * fnp.pi)
+    variance = fnp.maximum(
+        0.5 * first_norm_squared - mean * mean,
+        0.0,
+    )
+    for weight in mlp.weights[1:]:
+        preactivation_mean = mean @ weight
+        preactivation_variance = variance @ (weight * weight)
+        mean, variance = _relu_gaussian_mean_and_variance(
+            preactivation_mean, preactivation_variance
+        )
+    return mean
+

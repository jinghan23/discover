+def _relu_gaussian_mean_and_variance(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    safe_variance = fnp.maximum(variance, 1e-300)

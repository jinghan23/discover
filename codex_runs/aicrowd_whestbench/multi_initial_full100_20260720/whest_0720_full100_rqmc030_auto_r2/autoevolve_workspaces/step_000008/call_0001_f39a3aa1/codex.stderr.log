/bin/bash -lc "python - <<'PY'
import time, math, warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')

width=256; depth=32; budget=272_000_000_000
mlp=sample_mlp(width, depth, fnp.random.default_rng(202605), seed=999)
means, final, avg = sample_layer_statistics(mlp, 150_000, rng=fnp.random.default_rng(202606))
print('target_noise', avg/150000)

def exact_h2_mean(weight):
    norm_squared = fnp.maximum(fnp.sum(weight * weight, axis=0), 0.0)
    return norm_squared / (2.0 * weight.shape[0])

def predict_h2(mlp, budget, frac=0.10, scale=1.0, ridge=1e-7, powers=2):
    old_frac=submission._TARGET_FLOP_FRACTION
    submission._TARGET_FLOP_FRACTION=frac
    n_samples=submission._sample_count(budget, mlp.width, mlp.depth)
    submission._TARGET_FLOP_FRACTION=old_frac
    n_per_shift=max(1,n_samples//submission._SHIFT_COUNT)
    actual=n_per_shift*submission._SHIFT_COUNT
    rng=fnp.random.default_rng(mlp.seed + submission._SEED_OFFSET)
    gen=submission._lattice_generator(mlp.width)
    mean_radius=submission._mean_standard_normal_radius(mlp.width)
    base_shift=rng.random(mlp.width)
    uniforms=fnp.concatenate(tuple(submission._lattice_uniforms(n_per_shift, gen, base_shift if si==0 else 1.0-base_shift) for si in range(submission._SHIFT_COUNT)), axis=0)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
    uniforms=fnp.clip(uniforms, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
    acts=flops.stats.norm.ppf(uniforms)
    radii=fnp.sqrt(fnp.sum(acts*acts, axis=1))[:,None]
    acts=acts/fnp.maximum(radii, 1e-30)
    first=None
    for li,w in enumerate(mlp.weights):
        pre=acts @ w
        acts=fnp.maximum(pre, 0.0)
        if li==0:
            first=acts
        if li==mlp.depth-1:
            final_acts=acts
    final_mean=fnp.mean(final_acts, axis=0)
    controls_list=[first]
    exact_list=[submission._exact_first_layer_mean(mlp.weights[0]) / mean_radius]
    first_sq=first*first
    controls_list.append(first_sq)
    exact_list.append(exact_h2_mean(mlp.weights[0]))
    if powers>=3:
        controls_list.append(first_sq*first)
        ns=fnp.maximum(fnp.sum(mlp.weights[0]*mlp.weights[0], axis=0), 0.0)
        controls_list.append(first_sq*first*first)
        exact3=submission._sphere_relu_third_moment_scale(mlp.width)*ns*fnp.sqrt(ns)
        exact4=1.5*ns*ns/(mlp.width*(mlp.width+2))
        exact_list.append(exact3)
        exact_list.append(exact4)
    controls=fnp.concatenate(tuple(controls_list), axis=1)
    exact=fnp.concatenate(tuple(exact_list), axis=0)
    n=controls.shape[0]
    half=n//2
    def coeff(train):
        c=controls[train]
        y=final_acts[train]
        cm=fnp.mean(c, axis=0)
        ym=fnp.mean(y, axis=0)
        cc=c-cm[None,:]
        yy=y-ym[None,:]
        cov=(cc.T@cc)/c.shape[0]
        cov=cov+ridge*fnp.eye(cov.shape[0], dtype=fnp.float64)
        cross=(cc.T@yy)/c.shape[0]
        return fnp.linalg.solve(cov, cross)
    b1=coeff(slice(0,half)); b2=coeff(slice(half,n))
    m1=fnp.mean(controls[:half], axis=0)
    m2=fnp.mean(controls[half:], axis=0)
    correction=0.5*((m1-exact)@b2 + (m2-exact)@b1)
    return mean_radius*(final_mean-scale*correction)

# baseline current at 0.10 and 0.14
for frac in [0.10,0.14]:
    submission._TARGET_FLOP_FRACTION=frac
    est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        pred=est.predict(mlp,budget)
    mse=float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2))
    eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
    print('base frac',frac,'mse',mse,'adj',mse*max(.1,eff),'eff',eff)

for frac in [0.07,0.10,0.14]:
  for scale in [0.5,0.8,1.0,1.2]:
    t=time.time()
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        pred=predict_h2(mlp,budget,frac=frac,scale=scale,ridge=1e-6,powers=2)
    mse=float(fnp.mean((fnp.asarray(pred, dtype=fnp.float32)-final)**2))
    eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
    print('h2 frac',frac,'scale',scale,'mse',mse,'adj',mse*max(.1,eff),'eff',eff,'time',time.time()-t)

for scale in [0.5,0.8,1.0]:
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        pred=predict_h2(mlp,budget,frac=0.10,scale=scale,ridge=1e-5,powers=3)
    mse=float(fnp.mean((fnp.asarray(pred, dtype=fnp.float32)-final)**2))
    eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
    print('h1234 scale',scale,'mse',mse,'adj',mse*max(.1,eff),'eff',eff)

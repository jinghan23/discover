While offset `1` is being scored, I’m sweeping offsets locally over public random MLPs. This is mainly to choose the next blackbox offset if the first one is competitive.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission
width=256; depth=32; budget=272_000_000_000
orig_offset=submission._SEED_OFFSET
orig_anti=submission._ANTIPODAL_DIRECTIONS
submission._ANTIPODAL_DIRECTIONS=False
offsets=[0,1,2,3,5,8,13,21,34]
acc={o:[0.0,0.0] for o in offsets}
for k in range(3):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(20000+k), seed=21000+k)
    means, final, avg=sample_layer_statistics(mlp, 120_000, rng=fnp.random.default_rng(22000+k))
    print('mlp',k,'noise',avg/120000)
    for o in offsets:
        submission._SEED_OFFSET=o
        est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((fnp.asarray(pred[-1],dtype=fnp.float32)-final)**2)); eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget; adj=mse*max(.1,eff)
        acc[o][0]+=mse; acc[o][1]+=adj
        print(' ',o,mse,adj)
print('avg')
for o,v in sorted(acc.items(), key=lambda kv: kv[1][1]):
    print(o,v[0]/3,v[1]/3)
submission._SEED_OFFSET=orig_offset
submission._ANTIPODAL_DIRECTIONS=orig_anti

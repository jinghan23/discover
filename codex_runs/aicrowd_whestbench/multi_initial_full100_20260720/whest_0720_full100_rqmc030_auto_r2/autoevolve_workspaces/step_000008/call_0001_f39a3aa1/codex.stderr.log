/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from whestbench.estimators import MeanPropagationEstimator, CovariancePropagationEstimator
import submission

width=256; depth=32; budget=272_000_000_000
mlps=[sample_mlp(width, depth, fnp.random.default_rng(3000+i), seed=4000+i) for i in range(3)]
for k,mlp in enumerate(mlps):
    means, final, avg=sample_layer_statistics(mlp, 120_000, rng=fnp.random.default_rng(5000+k))
    print('MLP',k,'noise',avg/120000)
    preds=[]
    labels=[]
    costs=[]
    for label,est in [('mean',MeanPropagationEstimator()),('cov',CovariancePropagationEstimator())]:
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            p=est.predict(mlp,budget)
        preds.append(fnp.asarray(p[-1], dtype=fnp.float64)); labels.append(label); costs.append((ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget)
    est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        p=est.predict(mlp,budget)
    preds.append(fnp.asarray(p[-1], dtype=fnp.float64)); labels.append('qmc'); costs.append((ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget)
    for lab,pred,cost in zip(labels,preds,costs):
        mse=float(fnp.mean((fnp.asarray(pred,dtype=fnp.float32)-final)**2)); print(lab,'mse',mse,'eff',cost,'adj',mse*max(.1,cost))
    for a in [0.05,0.1,0.2,0.35,0.5,0.75]:
        blend=(1-a)*preds[2]+a*preds[1]
        mse=float(fnp.mean((fnp.asarray(blend,dtype=fnp.float32)-final)**2)); print('blend cov a',a,'mse',mse)

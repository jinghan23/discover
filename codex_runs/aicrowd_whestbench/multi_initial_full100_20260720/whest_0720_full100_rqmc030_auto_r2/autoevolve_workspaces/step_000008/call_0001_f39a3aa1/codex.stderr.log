I’m testing another control variate locally: a normalized collapsed linear-network ReLU control, `ReLU(u @ (W0...WL))`, whose exact sphere mean and covariance are available. It is cheap relative to the forward pass and may capture deep path structure not present in first-layer controls.
exec
/bin/bash -lc "python - <<'PY'
import warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')
width=256; depth=32; budget=272_000_000_000

def collapsed_weight(mlp):
    product=fnp.asarray(mlp.weights[0], dtype=fnp.float64)
    for w in mlp.weights[1:]:
        product=product @ fnp.asarray(w, dtype=fnp.float64)
    norms=fnp.sqrt(fnp.maximum(fnp.sum(product*product, axis=0), 1e-300))
    return product / norms[None,:]

def base_samples(mlp,budget):
    n_samples=submission._sample_count(budget, mlp.width, mlp.depth)
    n_per_shift=max(1,n_samples//2)
    rng=fnp.random.default_rng(mlp.seed)
    gen=submission._lattice_generator(mlp.width)
    mean_radius=submission._mean_standard_normal_radius(mlp.width)
    identity=fnp.eye(mlp.width,dtype=fnp.float64)
    base_shift=rng.random(mlp.width)
    uniforms=fnp.concatenate((submission._lattice_uniforms(n_per_shift,gen,base_shift),submission._lattice_uniforms(n_per_shift,gen,1.0-base_shift)),axis=0)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
    uniforms=fnp.clip(uniforms,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
    dirs=flops.stats.norm.ppf(uniforms)
    radii=fnp.sqrt(fnp.sum(dirs*dirs,axis=1))[:,None]
    dirs=dirs/fnp.maximum(radii,1e-30)
    acts=dirs
    first=None
    for li,w in enumerate(mlp.weights):
        pre=acts@w; acts=fnp.maximum(pre,0.0)
        if li==0: first=acts
    return dirs, first, acts, mean_radius, identity

def cv_correct(control, exact_mean, exact_cov, y, scale):
    ymean=fnp.mean(y,axis=0)
    centered_y=y-ymean[None,:]
    centered_c=control-exact_mean[None,:]
    n=control.shape[0]; half=n//2
    s1=slice(0,half); s2=slice(half,n)
    cross1=(centered_c[s1].T@centered_y[s1])/half
    cross2=(centered_c[s2].T@centered_y[s2])/(n-half)
    b1=fnp.linalg.solve(exact_cov,cross1)
    b2=fnp.linalg.solve(exact_cov,cross2)
    m1=fnp.mean(control[s1],axis=0); m2=fnp.mean(control[s2],axis=0)
    corr=0.5*((m1-exact_mean)@b2+(m2-exact_mean)@b1)
    return ymean-scale*corr

def predict_collapsed(mlp,budget,mode,scale1=0.763,scale2=1.0):
    dirs, first, final, mean_radius, identity=base_samples(mlp,budget)
    ymean=fnp.mean(final,axis=0)
    if mode in ('first','both'):
        em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mean_radius,identity)
        ymean=cv_correct(first,em,cov,final,scale1)
    if mode in ('collapsed','both'):
        cw=collapsed_weight(mlp)
        c=fnp.maximum(dirs@cw,0.0)
        em,cov=submission._first_layer_direction_mean_and_covariance(cw,mean_radius,identity)
        # apply to original final, or residual? use final for correction, add to already corrected mean by subtracting scale2*corr relative to raw
        raw=fnp.mean(final,axis=0)
        corrected=cv_correct(c,em,cov,final,scale2)
        if mode=='collapsed':
            ymean=corrected
        else:
            ymean=ymean + (corrected - raw)
    return mean_radius*ymean

modes=[('none',0,0),('first',0.763,0),('collapsed',0,0.5),('collapsed',0,1.0),('both',0.763,0.25),('both',0.763,0.5),('both',0.763,1.0)]
acc={m:[0.0,0.0,0.0] for m in modes}
for k in range(4):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(26000+k), seed=27000+k)
    means, final, avg=sample_layer_statistics(mlp, 100_000, rng=fnp.random.default_rng(28000+k))
    print('mlp',k,'noise',avg/100000)
    for mode,s1,s2 in modes:
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=predict_collapsed(mlp,budget,mode,s1,s2)
        mse=float(fnp.mean((fnp.asarray(pred,dtype=fnp.float32)-final)**2)); eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget; adj=mse*max(.1,eff)
        acc[(mode,s1,s2)][0]+=mse; acc[(mode,s1,s2)][1]+=adj; acc[(mode,s1,s2)][2]+=eff
        print(' ',mode,s1,s2,'mse',mse,'adj',adj,'eff',eff)
print('avg')
for m,v in sorted(acc.items(), key=lambda kv: kv[1][1]):
    print(m,v[0]/4,v[1]/4,v[2]/4)

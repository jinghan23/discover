/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission
width=256; depth=32; budget=272_000_000_000
orig_shift=submission._SHIFT_COUNT
orig_anti=submission._ANTIPODAL_DIRECTIONS
submission._ANTIPODAL_DIRECTIONS=False
shifts=[1,2,4,6,8]
acc={s:[0.0,0.0,0.0] for s in shifts}
for k in range(4):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(23000+k), seed=24000+k)
    means, final, avg=sample_layer_statistics(mlp, 100_000, rng=fnp.random.default_rng(25000+k))
    print('mlp',k,'noise',avg/100000)
    for s in shifts:
        submission._SHIFT_COUNT=s
        est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((fnp.asarray(pred[-1],dtype=fnp.float32)-final)**2)); eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget; adj=mse*max(.1,eff)
        acc[s][0]+=mse; acc[s][1]+=adj; acc[s][2]+=eff
        print(' ',s,'nactual',(submission._sample_count(budget,width,depth)//s)*s,'mse',mse,'adj',adj,'eff',eff)
print('avg')
for s,v in sorted(acc.items(), key=lambda kv: kv[1][1]):
    print(s,v[0]/4,v[1]/4,v[2]/4)
submission._SHIFT_COUNT=orig_shift
submission._ANTIPODAL_DIRECTIONS=orig_anti

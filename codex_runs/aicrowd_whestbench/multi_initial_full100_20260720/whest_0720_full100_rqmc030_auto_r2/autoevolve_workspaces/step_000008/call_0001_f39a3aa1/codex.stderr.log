/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest
import submission

width=256; depth=32; budget=272_000_000_000

def seed_map(seed,n=20):
    streams=fnp.random.SeedSequence(seed).spawn(3*n)
    d={}
    for i in range(n):
        est=int(streams[3*i+2].generate_state(1)[0])
        d[est]=streams[3*i+1]
    return d

def full_first_mean_cov(w):
    gram=w.T@w
    ns=fnp.maximum(fnp.sum(w*w,axis=0),0.0)
    sd=fnp.sqrt(ns)
    outer=sd[:,None]*sd[None,:]
    corr=fnp.clip(gram/fnp.maximum(outer,1e-300),-1.0,1.0)
    kernel=(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(fnp.pi-fnp.arccos(corr))*corr)/(2.0*fnp.pi)
    second=outer*kernel
    mean=sd/fnp.sqrt(2.0*fnp.pi)
    cov=second-mean[:,None]*mean[None,:]+1e-8*fnp.eye(w.shape[0],dtype=fnp.float64)
    return mean,cov

def predict_target_mc(mlp,seq,n_samples,cv=True):
    rng=fnp.random.default_rng(seq)
    x=fnp.array(rng.standard_normal((n_samples,mlp.width), dtype=fnp.float32))
    first=None
    for li,w in enumerate(mlp.weights):
        x=fnp.maximum(x@w,0.0)
        if li==0: first=fnp.asarray(x,dtype=fnp.float64)
    final=fnp.asarray(x,dtype=fnp.float64)
    mean=fnp.mean(final,axis=0)
    if cv:
        em,cov=full_first_mean_cov(mlp.weights[0])
        cf=first-em[None,:]
        yf=final-mean[None,:]
        half=n_samples//2; s1=slice(0,half); s2=slice(half,n_samples)
        b1=fnp.linalg.solve(cov,(cf[s1].T@yf[s1])/half)
        b2=fnp.linalg.solve(cov,(cf[s2].T@yf[s2])/(n_samples-half))
        m1=fnp.mean(first[s1],axis=0); m2=fnp.mean(first[s2],axis=0)
        corr=0.5*((m1-em)@b2+(m2-em)@b1)
        mean=mean-0.763*corr
    return mean

for Ntarget in [10_000,100_000]:
    print('Ntarget',Ntarget)
    spec=ContestSpec(width=width, depth=depth, n_mlps=3, flop_budget=budget, ground_truth_samples=Ntarget, seed=424242)
    data=make_contest(spec)
    smap=seed_map(spec.seed,10)
    for i,mlp in enumerate(data.mlps):
        target=data.final_targets[i]
        est=submission.Estimator(); est.setup(type('C',(),{'seed':spec.seed})())
        old_shift=submission._SHIFT_COUNT; old_anti=submission._ANTIPODAL_DIRECTIONS; old_scale=submission._VECTOR_CONTROL_SCALE
        submission._SHIFT_COUNT=2; submission._ANTIPODAL_DIRECTIONS=False; submission._VECTOR_CONTROL_SCALE=0.763
        p=est.predict(mlp,budget)[-1]
        print(' mlp',i,'rqmc',float(fnp.mean((fnp.asarray(p,dtype=fnp.float32)-target)**2)))
        for n in [3000,6000,9000,15000]:
            for cv in [False,True]:
                pred=predict_target_mc(mlp,smap[mlp.seed],n,cv=cv)
                print('  mc',n,'cv',cv,float(fnp.mean((fnp.asarray(pred,dtype=fnp.float32)-target)**2)))
        submission._SHIFT_COUNT=old_shift; submission._ANTIPODAL_DIRECTIONS=old_anti; submission._VECTOR_CONTROL_SCALE=old_scale

codex
I’m also checking a Halton-style low-discrepancy generator using only `flopscope.numpy` operations. If its overhead is acceptable and local error improves, it could be a real algorithmic alternative to the rank-1 lattice.
exec
/bin/bash -lc "python - <<'PY'
import time, warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission
warnings.filterwarnings('ignore', message='.*Symmetry lost.*')
width=256; depth=32; budget=272_000_000_000
primes=submission._first_primes(width)

def halton_uniforms(n, shift):
    idx=fnp.arange(1, n+1, dtype=fnp.float64)
    cols=[]
    for base in primes:
        basef=float(base)
        x=idx
        f=1.0/basef
        r=fnp.zeros(n,dtype=fnp.float64)
        # enough because n <= 1e5
        while f > 1.0/(basef*(n+1)):
            q=fnp.floor(x/basef)
            digit=x-basef*q
            r=r+f*digit
            x=q
            f=f/basef
        cols.append(r)
    u=fnp.stack(tuple(cols),axis=1)
    u=u+shift[None,:]
    return u-fnp.floor(u)

def predict_halton(mlp,budget,frac=0.14):
    old=submission._TARGET_FLOP_FRACTION; submission._TARGET_FLOP_FRACTION=frac
    n=submission._sample_count(budget,mlp.width,mlp.depth); submission._TARGET_FLOP_FRACTION=old
    rng=fnp.random.default_rng(mlp.seed)
    mean_radius=submission._mean_standard_normal_radius(mlp.width)
    identity=fnp.eye(mlp.width,dtype=fnp.float64)
    shift=rng.random(mlp.width)
    uniforms=halton_uniforms(n, shift)
    uniforms=1.0-fnp.abs(2.0*uniforms-1.0)
    uniforms=fnp.clip(uniforms,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
    acts=flops.stats.norm.ppf(uniforms)
    radii=fnp.sqrt(fnp.sum(acts*acts,axis=1))[:,None]
    acts=acts/fnp.maximum(radii,1e-30)
    first=None
    for li,w in enumerate(mlp.weights):
        pre=acts@w; acts=fnp.maximum(pre,0.0)
        if li==0: first=acts
    final=acts
    final_mean=fnp.mean(final,axis=0)
    centered_final=final-final_mean[None,:]
    em,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mean_radius,identity)
    centered_first=first-em[None,:]
    half=first.shape[0]//2
    s1=slice(0,half); s2=slice(half,first.shape[0])
    cross1=(centered_first[s1].T@centered_final[s1])/half
    cross2=(centered_first[s2].T@centered_final[s2])/(first.shape[0]-half)
    b1=fnp.linalg.solve(cov,cross1); b2=fnp.linalg.solve(cov,cross2)
    m1=fnp.mean(first[s1],axis=0); m2=fnp.mean(first[s2],axis=0)
    corr=0.5*((m1-em)@b2+(m2-em)@b1)
    return mean_radius*(final_mean-submission._VECTOR_CONTROL_SCALE*corr)

for k in range(3):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(30000+k), seed=31000+k)
    means, final, avg=sample_layer_statistics(mlp, 100_000, rng=fnp.random.default_rng(32000+k))
    print('mlp',k,'noise',avg/100000)
    est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
    # force current default maybe shift4? set two, no anti
    oldshift=submission._SHIFT_COUNT; oldanti=submission._ANTIPODAL_DIRECTIONS; oldscale=submission._VECTOR_CONTROL_SCALE
    submission._SHIFT_COUNT=2; submission._ANTIPODAL_DIRECTIONS=False; submission._VECTOR_CONTROL_SCALE=0.763
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        p=est.predict(mlp,budget)
    mse=float(fnp.mean((fnp.asarray(p[-1],dtype=fnp.float32)-final)**2)); eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
    print(' lattice',mse,mse*max(.1,eff),eff)
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        p=predict_halton(mlp,budget,frac=0.14)
    mse=float(fnp.mean((fnp.asarray(p,dtype=fnp.float32)-final)**2)); eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
    print(' halton',mse,mse*max(.1,eff),eff)
    submission._SHIFT_COUNT=oldshift; submission._ANTIPODAL_DIRECTIONS=oldanti; submission._VECTOR_CONTROL_SCALE=oldscale

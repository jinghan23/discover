index 79f88ec593d0746b46e5acc10992d44a3a5f9f57..9dd2f3416d0928719a1711274fb2dadf19ba6df7
--- a/submission.py
+++ b/submission.py
@@ -21,6 +21,8 @@
 _VECTOR_CONTROL_RIDGE = 1e-8
 _VECTOR_CONTROL_SCALE = 0.763
 _SCALAR_CONTROL_RIDGE = 1e-8
+_COVARIANCE_BLEND = 0.05
+_COV_RESCALE_THRESHOLD = 1e100
 
 
 def _first_primes(count: int) -> tuple[int, ...]:
@@ -93,6 +95,52 @@
     return math.sqrt(2.0 / math.pi) / mean_radius_cubed
 
 
+def _covariance_propagation_final_mean(mlp) -> fnp.ndarray:
+    width = mlp.width
+    mu = fnp.zeros(width)
+    covariance = fnp.eye(width)
+    log_scale = 0.0
+
+    for weight in mlp.weights:
+        covariance_diagonal = fnp.diag(covariance)
+        max_variance = float(fnp.max(fnp.asarray(covariance_diagonal)))
+        if max_variance > _COV_RESCALE_THRESHOLD:
+            scale = float(fnp.sqrt(max_variance))
+            mu = mu / scale
+            covariance = covariance / (scale * scale)
+            log_scale += float(fnp.log(scale))
+
+        preactivation_mean = weight.T @ mu
+        preactivation_covariance = weight.T @ covariance @ weight
+        preactivation_variance = fnp.maximum(fnp.diag(preactivation_covariance), 1e-12)
+        preactivation_standard_deviation = fnp.sqrt(preactivation_variance)
+
+        alpha = preactivation_mean / preactivation_standard_deviation
+        density = flops.stats.norm.pdf(alpha)
+        distribution = flops.stats.norm.cdf(alpha)
+
+        mu = (
+            preactivation_mean * distribution
+            + preactivation_standard_deviation * density
+        )
+        second_moment = (
+            (preactivation_mean * preactivation_mean + preactivation_variance)
+            * distribution
+            + preactivation_mean * preactivation_standard_deviation * density
+        )
+        post_variance = fnp.maximum(second_moment - mu * mu, 0.0)
+
+        gain = fnp.where(
+            preactivation_standard_deviation > 1e-12, distribution, 0.0
+        )
+        covariance = fnp.multiply(
+            fnp.outer(gain, gain), preactivation_covariance
+        )
+        fnp.fill_diagonal(covariance, post_variance)
+
+    return mu * float(fnp.exp(log_scale))
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     lattice_per_sample = 89 * width
     sphere_per_sample = 4 * width


codex
While that authoritative run is active, I’m using synthetic tests to tune the blend and fraction together. The useful question is whether the covariance blend should replace some QMC samples or be paid as extra compute.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

width=256; depth=32; budget=272_000_000_000
orig_frac=submission._TARGET_FLOP_FRACTION
orig_blend=submission._COVARIANCE_BLEND
orig_scale=submission._VECTOR_CONTROL_SCALE
pairs=[(0.12,0.03),(0.12,0.05),(0.13,0.03),(0.13,0.05),(0.14,0.03),(0.14,0.05),(0.15,0.03),(0.10,0.05),(0.14,0.0)]
acc={p:[0.0,0.0,0.0] for p in pairs}
for k in range(4):
    mlp=sample_mlp(width, depth, fnp.random.default_rng(7000+k), seed=8000+k)
    means, final, avg=sample_layer_statistics(mlp, 90_000, rng=fnp.random.default_rng(9000+k))
    print('mlp',k,'noise',avg/90000)
    for frac,blend in pairs:
        submission._TARGET_FLOP_FRACTION=frac
        submission._COVARIANCE_BLEND=blend
        est=submission.Estimator(); est.setup(type('C',(),{'seed':1})())
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2))
        eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/budget
        adj=mse*max(.1,eff)
        acc[(frac,blend)][0]+=mse; acc[(frac,blend)][1]+=adj; acc[(frac,blend)][2]+=eff
        print(' ',frac,blend,'mse',mse,'adj',adj,'eff',eff)
print('averages')
for p,v in sorted(acc.items(), key=lambda kv: kv[1][1]):
    print(p,'avg_mse',v[0]/4,'avg_adj',v[1]/4,'avg_eff',v[2]/4)
submission._TARGET_FLOP_FRACTION=orig_frac
submission._COVARIANCE_BLEND=orig_blend
submission._VECTOR_CONTROL_SCALE=orig_scale
PY" in /opt/tiger/discover/workspace

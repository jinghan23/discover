+def _first_layer_square_direction_mean_and_covariance(
+    first_weight: fnp.ndarray,
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    width = first_weight.shape[0]
+    gram = first_weight.T @ first_weight
+    norm_squared = fnp.maximum(fnp.sum(first_weight * first_weight, axis=0), 0.0)
+    norm_squared_outer = norm_squared[:, None] * norm_squared[None, :]
+    correlation = fnp.clip(
+        gram / fnp.maximum(fnp.sqrt(norm_squared_outer), 1e-300), -1.0, 1.0
+    )
+    angle = fnp.arccos(correlation)
+    sine = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    arc_cosine_order_two = (
+        3.0 * sine * correlation
+        + (fnp.pi - angle) * (1.0 + 2.0 * correlation * correlation)
+    )
+    second_moment = (
+        norm_squared_outer
+        * arc_cosine_order_two
+        / (2.0 * fnp.pi * width * (width + 2))
+    )
+    mean = norm_squared / (2.0 * width)
+    covariance = second_moment - mean[:, None] * mean[None, :]
+    covariance = covariance + _SQUARE_VECTOR_CONTROL_RIDGE * fnp.eye(
+        width, dtype=fnp.float64
+    )
+    return mean, covariance
+
+

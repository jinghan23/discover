--- a/submission.py
+++ b/submission.py
@@ -16,9 +16,10 @@
 _TAIL_CLIP = 1e-11
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _FLOAT64_ITEMSIZE = 8
-_VECTOR_CONTROL_MIN_SAMPLE_FACTOR = 1000000000
+_VECTOR_CONTROL_MIN_SAMPLE_FACTOR = 1
 _VECTOR_CONTROL_RIDGE = 1e-8
 _SCALAR_CONTROL_RIDGE = 1e-8
+_ANALYTIC_ONLY = True
 
 
 def _first_primes(count: int) -> tuple[int, ...]:
@@ -113,8 +114,39 @@
     return int(max(1, min(n_samples, max_samples_by_bytes)))
 
 
+def _relu_gaussian_mean_and_second(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    standard_deviation = fnp.sqrt(fnp.maximum(variance, 0.0))
+    safe_standard_deviation = fnp.maximum(standard_deviation, 1e-300)
+    alpha = mean / safe_standard_deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    return relu_mean, relu_second
+
+
+def _diag_gaussian_rows(mlp) -> fnp.ndarray:
+    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
+    variance = fnp.ones(mlp.width, dtype=fnp.float64)
+    rows = []
+    for weight in mlp.weights:
+        preactivation_mean = mean @ weight
+        preactivation_variance = variance @ (weight * weight)
+        mean, second = _relu_gaussian_mean_and_second(
+            preactivation_mean, preactivation_variance
+        )
+        variance = fnp.maximum(second - mean * mean, 0.0)
+        rows.append(mean)
+    return fnp.stack(rows, axis=0)
+
+
 class Estimator(BaseEstimator):
     def predict(self, mlp, budget):
+        if _ANALYTIC_ONLY:
+            return _diag_gaussian_rows(mlp)
+
         n_samples = _sample_count(budget, mlp.width, mlp.depth)
         n_per_shift = max(1, n_samples // _SHIFT_COUNT)
         rng = fnp.random.default_rng(mlp.seed + _SEED_OFFSET)


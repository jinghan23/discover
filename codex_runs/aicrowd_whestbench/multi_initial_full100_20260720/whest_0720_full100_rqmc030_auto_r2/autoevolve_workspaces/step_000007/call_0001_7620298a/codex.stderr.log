codex
I’m prototyping a deeper control variate locally: estimate the second-layer mean with many cheap shallow passes, then use second-layer activations as an additional control for the final layer. This targets the dominant final-layer error without needing hidden targets.
exec
/bin/bash -lc "python - <<'PY'
import time, math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def directions(n_samples, seed, shifts=2):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); nps=max(1,n_samples//shifts)
    u=fnp.concatenate(tuple(submission._lattice_uniforms(nps,gen,(rng.random(W) if i>1 else (rng.random(W) if i==0 else 1.0-base))) if False else () ),axis=0)

def make_dirs(n_samples, seed, shifts=2):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); base=rng.random(W); nps=max(1,n_samples//shifts)
    parts=[]
    for i in range(shifts):
        shift=base if i==0 else (1.0-base if i==1 else rng.random(W))
        u=submission._lattice_uniforms(nps,gen,shift)
        u=1.0-fnp.abs(2.0*u-1.0)
        u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        parts.append(u)
    u=fnp.concatenate(tuple(parts),axis=0)
    a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]
    return a/fnp.maximum(r,1e-30), mr, ident

def full_forward(mlp, n, seed):
    a,mr,ident=make_dirs(n, seed)
    first=None; c2=None
    for li,w in enumerate(mlp.weights):
        a=fnp.maximum(a@w,0.0)
        if li==0: first=a
        if li==1: c2=a
    return a, first, c2, mr, ident

def shallow_c2_mean(mlp, n, seed, exact_a1_mean, a1_cov, mr):
    a,_,_=make_dirs(n, seed)
    for li,w in enumerate(mlp.weights[:2]):
        a=fnp.maximum(a@w,0.0)
        if li==0: first=a
    c2=a
    # control c2 by first-layer exact direction mean
    c2_mean=fnp.mean(c2,axis=0)
    centered_c2=c2-c2_mean[None,:]
    centered_first=first-exact_a1_mean[None,:]
    cross=centered_first.T@centered_c2/first.shape[0]
    beta=fnp.linalg.solve(a1_cov,cross)
    corr=(fnp.mean(first,axis=0)-exact_a1_mean)@beta
    return c2_mean-corr

def predict_l2cv(mlp, n_full, n_c2, seed, scale2):
    final, first, c2, mr, ident=full_forward(mlp,n_full,seed)
    final_mean=fnp.mean(final,axis=0); centered_final=final-final_mean[None,:]
    exact_a1,a1_cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
    centered_first=first-exact_a1[None,:]
    # current cross-fit first control
    h=first.shape[0]//2; s1=slice(0,h); s2=slice(h,first.shape[0])
    cov1=(centered_first[s1].T@centered_final[s1])/h; cov2=(centered_first[s2].T@centered_final[s2])/(first.shape[0]-h)
    b1=fnp.linalg.solve(a1_cov,cov1); b2=fnp.linalg.solve(a1_cov,cov2)
    corr1=0.5*((fnp.mean(first[s1],axis=0)-exact_a1)@b2+(fnp.mean(first[s2],axis=0)-exact_a1)@b1)
    # c2 ref
    c2_ref=shallow_c2_mean(mlp,n_c2,seed+99991,exact_a1,a1_cov,mr)
    c2_mean=fnp.mean(c2,axis=0)
    centered_c2=c2-c2_mean[None,:]
    cov_c=centered_c2.T@centered_c2 + 1e-8*c2.shape[0]*fnp.eye(W,dtype=fnp.float64)
    cross_c=centered_c2.T@centered_final
    beta_c=fnp.linalg.solve(cov_c,cross_c)
    corr2=(c2_mean-c2_ref)@beta_c
    return mr*(final_mean-0.763*corr1-scale2*corr2)

def ref_est(mlp,n,seed):
    a,mr,_=make_dirs(n,seed,shifts=4)
    for w in mlp.weights: a=fnp.maximum(a@w,0.0)
    return fnp.mean(a,axis=0)*mr
rng=fnp.random.default_rng(314159); mlps=[sample_mlp(W,D,rng,seed=9000+i) for i in range(2)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,21000+i)); print('ref',i,time.time()-t)
base=submission.Estimator(); base.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
base_ms=[float(fnp.mean((base.predict(m,B)[-1]-r)**2)) for m,r in zip(mlps,refs)]
print('base',sum(base_ms)/len(base_ms),base_ms)
for nf,nc in [(6430,20000),(6430,40000),(7716,30000),(9002,20000),(9002,40000)]:
    for sc in [0.25,0.5,0.75,1.0]:
        ms=[]; t0=time.time()
        for m,r in zip(mlps,refs):
            p=predict_l2cv(m,nf,nc,m.seed,sc)
            ms.append(float(fnp.mean((p-r)**2)))
        print('nf nc sc',nf,nc,sc,'mse',sum(ms)/len(ms),'mses',ms,'time',time.time()-t0)

/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def ref_est(mlp,n,seed):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); parts=[]; shifts=4; nps=n//shifts
    for _ in range(shifts):
        u=submission._lattice_uniforms(nps,gen,rng.random(W)); u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights: a=fnp.maximum(a@w,0.0)
        parts.append(a)
    return fnp.mean(fnp.concatenate(tuple(parts),axis=0),axis=0)*mr
rng=fnp.random.default_rng(271828); mlps=[sample_mlp(W,D,rng,seed=10000+i) for i in range(3)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,23000+i)); print('ref',i,time.time()-t)
# candidate l2
est=submission.Estimator(); est.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
ms=[]
for m,r in zip(mlps,refs):
    p=est.predict(m,B)[-1]
    ms.append(float(fnp.mean((p-r)**2)))
print('candidate_l2',sum(ms)/len(ms),ms)
# temporarily disable l2 and use baseline 0.14 equivalent by monkeypatching
submission._TARGET_FLOP_FRACTION=0.14
submission._LAYER2_CONTROL_FLOP_FRACTION=0.0
est2=submission.Estimator(); est2.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
ms=[]
for m,r in zip(mlps,refs):
    p=est2.predict(m,B)[-1]
    ms.append(float(fnp.mean((p-r)**2)))
print('baseline_like',sum(ms)/len(ms),ms)

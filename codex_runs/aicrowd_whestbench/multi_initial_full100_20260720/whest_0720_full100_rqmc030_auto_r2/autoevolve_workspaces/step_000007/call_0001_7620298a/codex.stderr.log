codex
I’m checking whether the public analytic propagation estimators have enough correlation with the final target to be useful as a shrinkage prior. If they are far off, mixing them into QMC would only add bias.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
from whestbench.estimators import MeanPropagationEstimator, CovariancePropagationEstimator
import submission
W=256;D=32;B=272_000_000_000

def ref_est(mlp, n, seed):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); parts=[]; shifts=4; nps=n//shifts
    for _ in range(shifts):
        u=submission._lattice_uniforms(nps,gen,rng.random(W)); u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        a=submission.flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights: a=fnp.maximum(a@w,0.0)
        parts.append(a)
    return fnp.mean(fnp.concatenate(tuple(parts),axis=0),axis=0)*mr
rng=fnp.random.default_rng(909); mlps=[sample_mlp(W,D,rng,seed=7000+i) for i in range(2)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,17000+i)); print('ref',i,time.time()-t)
base=submission.Estimator(); base.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
mean_est=MeanPropagationEstimator(); cov_est=CovariancePropagationEstimator()
for label, maker in [('qmc', lambda m: base.predict(m,B)[-1]),('mean',lambda m: mean_est.predict(m,B)[-1]),('cov',lambda m: cov_est.predict(m,B)[-1])]:
    ms=[]
    for m,r in zip(mlps,refs):
        p=maker(m); ms.append(float(fnp.mean((p-r)**2)))
    print(label, sum(ms)/len(ms), ms)
# Mix qmc with covariance and mean
for label, est2 in [('mean',mean_est),('cov',cov_est)]:
    preds=[]
    q=[]; a=[]
    for m in mlps:
        q.append(base.predict(m,B)[-1]); a.append(est2.predict(m,B)[-1])
    for alpha in [-0.2,-0.1,-0.05,0.02,0.05,0.1,0.2,0.4]:
        ms=[]
        for qi,ai,r in zip(q,a,refs):
            p=(1-alpha)*qi+alpha*ai
            ms.append(float(fnp.mean((p-r)**2)))
        print('mix',label,alpha,sum(ms)/len(ms))

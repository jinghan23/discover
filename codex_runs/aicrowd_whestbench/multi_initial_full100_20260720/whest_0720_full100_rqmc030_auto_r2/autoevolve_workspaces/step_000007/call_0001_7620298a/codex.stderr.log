import time, math, importlib
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission

W=256; D=32; B=272_000_000_000

def sphere_estimate(mlp, n_samples, seed):
    gen, mean_radius, identity, zero = submission.Estimator()._constants_for_width(W)
    rng=fnp.random.default_rng(seed)
    shifts=4
    n_per=max(1,n_samples//shifts)
    acts=[]
    for si in range(shifts):
        shift=rng.random(W)
        u=submission._lattice_uniforms(n_per, gen, shift)
        u=1.0-fnp.abs(2.0*u-1.0)
        u=fnp.clip(u, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
        z=submission.flops.stats.norm.ppf(u)
        r=fnp.sqrt(fnp.sum(z*z, axis=1))[:,None]
        a=z/fnp.maximum(r,1e-30)
        for weight in mlp.weights:
            a=fnp.maximum(a@weight,0.0)
        acts.append(a)
    final=fnp.mean(fnp.concatenate(tuple(acts),axis=0),axis=0)*mean_radius
    return final

# generate mlps
rng=fnp.random.default_rng(2026)
mlps=[sample_mlp(W,D,rng,seed=1000+i) for i in range(3)]
print('building refs')
refs=[]
t0=time.time()
for i,m in enumerate(mlps):
    refs.append(sphere_estimate(m,65536,9000+i))
    print('ref',i,'done',time.time()-t0)

fractions=[0.08,0.10,0.12,0.14,0.16,0.18,0.22]
scales=[0.65,0.72,0.763,0.82,0.90,1.00]
# quick evaluate one dimension: baseline scale, varying fraction
for frac in fractions:
    submission._TARGET_FLOP_FRACTION=frac
    submission._VECTOR_CONTROL_SCALE=0.763
    est=submission.Estimator(); est.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
    mses=[]
    for m,ref in zip(mlps,refs):
        pred=est.predict(m,B)[-1]
        mses.append(float(fnp.mean((pred-ref)**2)))
    n=submission._sample_count(B,W,D)
    print('frac',frac,'n',n,'mse',sum(mses)/len(mses),'adj~',sum(mses)/len(mses)*max(.1,frac))

# scale at current frac
for scale in scales:
    submission._TARGET_FLOP_FRACTION=0.14
    submission._VECTOR_CONTROL_SCALE=scale
    est=submission.Estimator(); est.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))

+
+    exact_first_direction_mean, first_direction_covariance = (
+        _first_layer_direction_mean_and_covariance(
+            mlp.weights[0], mean_radius, identity
+        )
+    )
+    centered_first_direction = first_activations - exact_first_direction_mean[None, :]
+    centered_second = second_activations - second_mean[None, :]
+    cross_covariance = (
+        centered_first_direction.T @ centered_second
+    ) / first_activations.shape[0]
+    coefficients = fnp.linalg.solve(first_direction_covariance, cross_covariance)
+    correction = (
+        fnp.mean(first_activations, axis=0) - exact_first_direction_mean
+    ) @ coefficients
+    return second_mean - correction
+
+

     return int(max(1, min(n_samples, max_samples_by_bytes)))
 
 
+def _layer2_control_sample_count(budget: int, width: int, depth: int) -> int:
+    if depth <= 2:
+        return 0
+    lattice_per_sample = 89 * width
+    sphere_per_sample = 4 * width
+    forward_per_sample = 2 * (2 * width * width + width)
+    covariance_per_sample = 2 * width * width + 10 * width
+    per_sample = (
+        lattice_per_sample
+        + sphere_per_sample
+        + forward_per_sample
+        + covariance_per_sample
+    )
+    fixed = 2 * width * width + 8 * width
+    n_samples = (int(_LAYER2_CONTROL_FLOP_FRACTION * budget) - fixed) // per_sample
+    max_samples_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _FLOAT64_ITEMSIZE, 1)
+    return int(max(0, min(n_samples, max_samples_by_bytes)))
+
+
+def _sphere_lattice_directions(
+    n_samples: int,
+    width: int,
+    generator: fnp.ndarray,
+    rng,
+) -> fnp.ndarray:
+    n_per_shift = max(1, n_samples // _SHIFT_COUNT)
+    base_shift = rng.random(width)
+    uniforms = fnp.concatenate(
+        tuple(
+            _lattice_uniforms(
+                n_per_shift,
+                generator,
+                base_shift
+                if shift_index == 0
+                else (
+                    1.0 - base_shift if shift_index == 1 else rng.random(width)
+                ),
+            )
+            for shift_index in range(_SHIFT_COUNT)
+        ),
+        axis=0,
+    )
+    uniforms = 1.0 - fnp.abs(2.0 * uniforms - 1.0)
+    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
+    directions = flops.stats.norm.ppf(uniforms)
+    radii = fnp.sqrt(fnp.sum(directions * directions, axis=1))[:, None]
+    return directions / fnp.maximum(radii, 1e-30)
+
+
+def _estimate_second_layer_direction_mean(
+    mlp,
+    n_samples: int,
+    generator: fnp.ndarray,
+    mean_radius: float,
+    identity: fnp.ndarray,
+) -> fnp.ndarray:
+    rng = fnp.random.default_rng(mlp.seed + _LAYER2_CONTROL_SEED_OFFSET)
+    activations = _sphere_lattice_directions(n_samples, mlp.width, generator, rng)

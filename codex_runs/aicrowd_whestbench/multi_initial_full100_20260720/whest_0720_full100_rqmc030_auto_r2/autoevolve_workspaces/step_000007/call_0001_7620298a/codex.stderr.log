I’m exploring one more algorithmic idea locally: screen a few candidate lattice shifts using first-layer moment error, then spend the full-depth pass only on the best shift. The first-layer moments are exactly known, so this does not use target information.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def dirs_from_shift(n_per, gen, shift):
    u=fnp.concatenate((submission._lattice_uniforms(n_per,gen,shift), submission._lattice_uniforms(n_per,gen,1.0-shift)), axis=0)
    u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
    a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]
    return a/fnp.maximum(r,1e-30)

def estimate_screen(mlp,K):
    n=submission._sample_count(B,W,D); n_per=n//2
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(mlp.seed)
    exact_first_dir, cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
    best=None; best_err=None; best_first=None
    for k in range(K):
        shift=rng.random(W)
        d=dirs_from_shift(n_per,gen,shift)
        first=fnp.maximum(d@mlp.weights[0],0.0)
        err=float(fnp.mean((fnp.mean(first,axis=0)-exact_first_dir)**2))
        if best_err is None or err<best_err:
            best_err=err; best=d; best_first=first
    a=best_first
    first=best_first
    for w in mlp.weights[1:]: a=fnp.maximum(a@w,0.0)
    final=a; final_mean=fnp.mean(final,axis=0); centered_final=final-final_mean[None,:]
    centered_first=first-exact_first_dir[None,:]
    h=first.shape[0]//2; s1=slice(0,h); s2=slice(h,first.shape[0])
    cc1=(centered_first[s1].T@centered_final[s1])/h; cc2=(centered_first[s2].T@centered_final[s2])/(first.shape[0]-h)
    b1=fnp.linalg.solve(cov,cc1); b2=fnp.linalg.solve(cov,cc2)
    corr=0.5*((fnp.mean(first[s1],axis=0)-exact_first_dir)@b2+(fnp.mean(first[s2],axis=0)-exact_first_dir)@b1)
    return mr*(final_mean-0.763*corr), best_err

def ref_est(mlp,n,seed):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); parts=[]; shifts=4; nps=n//shifts
    for _ in range(shifts):
        u=submission._lattice_uniforms(nps,gen,rng.random(W)); u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights: a=fnp.maximum(a@w,0.0)
        parts.append(a)
    return fnp.mean(fnp.concatenate(tuple(parts),axis=0),axis=0)*mr
rng=fnp.random.default_rng(4444); mlps=[sample_mlp(W,D,rng,seed=11000+i) for i in range(3)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,25000+i)); print('ref',i,time.time()-t)
base=submission.Estimator(); base.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
base_ms=[float(fnp.mean((base.predict(m,B)[-1]-r)**2)) for m,r in zip(mlps,refs)]
print('base',sum(base_ms)/len(base_ms),base_ms)
for K in [2,3,4]:
    ms=[]; errs=[]; t0=time.time()
    for m,r in zip(mlps,refs):
        p,e=estimate_screen(m,K); errs.append(e); ms.append(float(fnp.mean((p-r)**2)))
    print('K',K,'mse',sum(ms)/len(ms),'mses',ms,'errs',errs,'time',time.time()-t0)

codex
I’m prototyping an adaptive shrinkage on the existing cross-fit correction. It uses the disagreement between the two cross-fit halves as a per-output noise estimate, so it can shrink unstable corrections more than stable ones.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def baseline_components(mlp):
    n=submission._sample_count(B,W,D); nps=n//2
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(mlp.seed)
    base=rng.random(W)
    u=fnp.concatenate((submission._lattice_uniforms(nps,gen,base), submission._lattice_uniforms(nps,gen,1.0-base)),axis=0)
    u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
    a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
    first=None
    for li,w in enumerate(mlp.weights):
        a=fnp.maximum(a@w,0.0)
        if li==0: first=a
    final=a; fm=fnp.mean(final,axis=0); cf=final-fm[None,:]
    exact,cov=submission._first_layer_direction_mean_and_covariance(mlp.weights[0],mr,ident)
    centered=first-exact[None,:]
    h=first.shape[0]//2; s1=slice(0,h); s2=slice(h,first.shape[0])
    cc1=(centered[s1].T@cf[s1])/h; cc2=(centered[s2].T@cf[s2])/(first.shape[0]-h)
    b1=fnp.linalg.solve(cov,cc1); b2=fnp.linalg.solve(cov,cc2)
    corr1=(fnp.mean(first[s1],axis=0)-exact)@b2
    corr2=(fnp.mean(first[s2],axis=0)-exact)@b1
    raw=0.5*(corr1+corr2); diff=corr1-corr2
    return fm, raw, diff, mr

def pred_adapt(mlp,k,base_scale=1.0):
    fm,raw,diff,mr=baseline_components(mlp)
    shrink=(raw*raw)/(raw*raw+k*diff*diff+1e-30)
    return mr*(fm-base_scale*shrink*raw)

def ref_est(mlp,n,seed):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); parts=[]; shifts=4; nps=n//shifts
    for _ in range(shifts):
        u=submission._lattice_uniforms(nps,gen,rng.random(W)); u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights: a=fnp.maximum(a@w,0.0)
        parts.append(a)
    return fnp.mean(fnp.concatenate(tuple(parts),axis=0),axis=0)*mr
rng=fnp.random.default_rng(5555); mlps=[sample_mlp(W,D,rng,seed=12000+i) for i in range(3)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,27000+i)); print('ref',i,time.time()-t)
base=submission.Estimator(); base.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
base_ms=[float(fnp.mean((base.predict(m,B)[-1]-r)**2)) for m,r in zip(mlps,refs)]
print('base global0.763',sum(base_ms)/len(base_ms),base_ms)
# cache components
comps=[baseline_components(m) for m in mlps]
for bs in [0.8,1.0,1.2]:
  for k in [0.05,0.1,0.25,0.5,1.0,2.0]:
    ms=[]
    for (fm,raw,diff,mr),r in zip(comps,refs):
      shrink=(raw*raw)/(raw*raw+k*diff*diff+1e-30)
      p=mr*(fm-bs*shrink*raw)
      ms.append(float(fnp.mean((p-r)**2)))
    print('bs k',bs,k,'mse',sum(ms)/len(ms),ms)

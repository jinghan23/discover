diff --git a/submission.py b/submission.py
index 79f88ec593d0746b46e5acc10992d44a3a5f9f57..e4018ebb426f85b52b6fad99f637531bbc58246d
--- a/submission.py
+++ b/submission.py
@@ -41,8 +41,17 @@
 
 
 def _lattice_generator(width: int) -> fnp.ndarray:
-    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
-    return roots - fnp.floor(roots)
+    phi = 1.0
+    inverse_dimension = 1.0 / (width + 1)
+    for _ in range(24):
+        phi = (1.0 + phi) ** inverse_dimension
+    alpha = 1.0 / phi
+    values = []
+    value = alpha
+    for _ in range(width):

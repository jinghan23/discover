/bin/bash -lc "python - <<'PY'
import time, math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def exact_first_gaussian(weight):
    gram=weight.T@weight
    ns=fnp.maximum(fnp.sum(weight*weight,axis=0),0.0)
    sd=fnp.sqrt(ns)
    out=sd[:,None]*sd[None,:]
    corr=fnp.clip(gram/fnp.maximum(out,1e-300),-1.0,1.0)
    kern=(fnp.sqrt(fnp.maximum(1.0-corr*corr,0.0))+(fnp.pi-fnp.arccos(corr))*corr)/(2.0*fnp.pi)
    mean=sd/fnp.sqrt(2.0*fnp.pi)
    cov=out*kern-mean[:,None]*mean[None,:]
    return mean,cov

def cov_prior(mlp):
    mu,cov=exact_first_gaussian(mlp.weights[0])
    for w in mlp.weights[1:]:
        mu_pre=w.T@mu
        cov_pre=w.T@cov@w
        var=fnp.maximum(fnp.diag(cov_pre),1e-12)
        sig=fnp.sqrt(var)
        alpha=mu_pre/sig
        phi=flops.stats.norm.pdf(alpha); Phi=flops.stats.norm.cdf(alpha)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var)*Phi+mu_pre*sig*phi
        var_post=fnp.maximum(ez2-mu*mu,0.0)
        gain=fnp.where(sig>1e-12, Phi, 0.0)
        cov=fnp.outer(gain,gain)*cov_pre
        fnp.fill_diagonal(cov,var_post)
    return mu

def ref_est(mlp,n,seed):
    est=submission.Estimator(); gen,mr,ident,zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed); parts=[]; shifts=4; nps=n//shifts
    for _ in range(shifts):
        u=submission._lattice_uniforms(nps,gen,rng.random(W)); u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        a=flops.stats.norm.ppf(u); r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]; a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights: a=fnp.maximum(a@w,0.0)
        parts.append(a)
    return fnp.mean(fnp.concatenate(tuple(parts),axis=0),axis=0)*mr
rng=fnp.random.default_rng(12345); mlps=[sample_mlp(W,D,rng,seed=8000+i) for i in range(2)]
refs=[]; t=time.time()
for i,m in enumerate(mlps): refs.append(ref_est(m,65536,19000+i)); print('ref',i,time.time()-t)
base=submission.Estimator(); base.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
qs=[]; cs=[]
for m in mlps: qs.append(base.predict(m,B)[-1]); cs.append(cov_prior(m))
for label,preds in [('qmc',qs),('cov_exact1',cs)]:
    ms=[float(fnp.mean((p-r)**2)) for p,r in zip(preds,refs)]
    print(label,sum(ms)/len(ms),ms)
for alpha in [-0.1,-0.05,0.01,0.02,0.05,0.08,0.1,0.15,0.2]:
    ms=[float(fnp.mean((((1-alpha)*q+alpha*c)-r)**2)) for q,c,r in zip(qs,cs,refs)]
    print('mix',alpha,sum(ms)/len(ms),ms)

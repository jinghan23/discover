/bin/bash -lc "python - <<'PY'
import time
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.runner import SetupContext
import submission
W=256;D=32;B=272_000_000_000

def sphere_estimate(mlp, n_samples, seed):
    est=submission.Estimator(); gen, mean_radius, identity, zero=est._constants_for_width(W)
    rng=fnp.random.default_rng(seed)
    shifts=4; n_per=n_samples//shifts
    finals=[]
    for si in range(shifts):
        shift=rng.random(W)
        u=submission._lattice_uniforms(n_per, gen, shift)
        u=1.0-fnp.abs(2.0*u-1.0)
        u=fnp.clip(u, submission._TAIL_CLIP, 1.0-submission._TAIL_CLIP)
        a=submission.flops.stats.norm.ppf(u)
        r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]
        a=a/fnp.maximum(r,1e-30)
        for w in mlp.weights:
            a=fnp.maximum(a@w,0.0)
        finals.append(a)
    return fnp.mean(fnp.concatenate(tuple(finals),axis=0),axis=0)*mean_radius
rng=fnp.random.default_rng(777)
mlps=[sample_mlp(W,D,rng,seed=5000+i) for i in range(3)]
refs=[]; t=time.time()
for i,m in enumerate(mlps):
    refs.append(sphere_estimate(m,65536,12000+i)); print('ref',i,time.time()-t)
for flag in [False, True]:
    submission._USE_PREACTIVATION_VECTOR_CONTROL=flag
    submission._TARGET_FLOP_FRACTION=0.14
    est=submission.Estimator(); est.setup(SetupContext(width=W,depth=D,flop_budget=B,api_version='x',seed=42))
    mses=[]
    for m,ref in zip(mlps,refs):
        p=est.predict(m,B)[-1]
        mses.append(float(fnp.mean((p-ref)**2)))
    print('pre_control',flag,'mse',sum(mses)/len(mses),mses)

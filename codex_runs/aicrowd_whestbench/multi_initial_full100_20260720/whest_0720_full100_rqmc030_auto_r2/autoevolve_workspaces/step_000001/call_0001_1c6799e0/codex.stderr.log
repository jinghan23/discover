The vector-control variants are incremental. I’m also testing deterministic moment propagation as a possible shrinkage baseline, since a biased low-variance estimate can beat pure sampling under a tight compute floor.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def wsamp(w,d,seed):
    rng=np.random.default_rng(seed); sc=math.sqrt(2/w); return [rng.standard_normal((w,w))*sc for _ in range(d)]
def fw(ws,x):
    a=x
    for W in ws: a=np.maximum(a@W,0)
    return a
def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<ns:
        n=min(50000,ns-done); s+=fw(ws,rng.standard_normal((n,w))).sum(0); done+=n
    return s/done
def relu_mom(m,v):
    s=np.sqrt(np.maximum(v,1e-30)); a=m/s; Phi=norm.cdf(a); phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
    mu=s*phi+m*Phi
    q=(v+m*m)*Phi+m*s*phi
    return mu,q
def diag_prop(ws):
    w=ws[0].shape[0]
    mu=np.zeros(w); q=np.ones(w) # input independent moments
    rows=[]
    for W in ws:
        m=mu@W
        v=(q-mu*mu)@(W*W)
        mu,q=relu_mom(m,v)
        rows.append(mu.copy())
    return rows[-1]
def diag_prop2(ws):
    # use raw second q for z2 ignoring covariance: E[z"'^2]=q@(W''^2), var=E[z''^2]-mean''^2 maybe can be negative clipped
    w=ws[0].shape[0]
    mu=np.zeros(w); q=np.ones(w)
    for W in ws:
        m=mu@W
        e2=q@(W*W)
        v=np.maximum(e2-m*m,1e-30)
        mu,q=relu_mom(m,v)
    return mu
for w,d,ns in [(32,8,1000000),(32,16,800000),(64,16,500000),(64,32,400000),(128,16,300000),(128,32,250000)]:
    print('"'\\nCONFIG',w,d); vals=[]; vals2=[]; meanmag=[]
    for mi in range(8):
        ws=wsamp(w,d,500+mi); tgt=target(ws,ns,900+mi)
        p=diag_prop(ws); p2=diag_prop2(ws)
        vals.append(np.mean((p-tgt)**2)); vals2.append(np.mean((p2-tgt)**2)); meanmag.append(np.mean(tgt*tgt))
    print('diag var',np.mean(vals),'med',np.median(vals))
    print('diag e2',np.mean(vals2),'med',np.median(vals2))
    print('target mean sq',np.mean(meanmag))

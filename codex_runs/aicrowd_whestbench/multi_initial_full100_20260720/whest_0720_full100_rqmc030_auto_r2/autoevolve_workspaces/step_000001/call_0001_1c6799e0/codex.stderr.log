        u=(idx*gen+rng.random(w))%1.0; arr.append(u)
    u=np.concatenate(arr)[:nb]
    z=norm.ppf(np.clip(u,tail,1-tail)); z/=np.maximum(np.linalg.norm(z,axis=1,keepdims=True),1e-30)
    if ant: z=np.concatenate([z,-z])[:n]

+    mean_radius_cubed = (2.0 ** 1.5) * math.exp(
+        math.lgamma(0.5 * (width + 3)) - math.lgamma(0.5 * width)
+    )
+    return math.sqrt(2.0 / math.pi) / mean_radius_cubed

                split_configs=split_configs,
                hf_kwargs=hf_kwargs,
                is_local=is_local,
            )
            _METADATA_BY_DS[member] = _merge_metadata_for_split(md, name)
            dsd[name] = member
        _register_dsd_metadata(dsd, md)
        return dsd


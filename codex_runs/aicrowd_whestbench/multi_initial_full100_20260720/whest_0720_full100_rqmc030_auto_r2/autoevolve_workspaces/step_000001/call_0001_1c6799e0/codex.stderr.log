        for sh in [1,2,4]:
            pred=estimate(weights,n,seed=mi,shifts=sh,kind='scalar',antithetic=True)
            mses[f'scalar_ant{sh}'].append(np.mean((pred-tgt)**2))
    for k,v in mses.items():
        arr=np.array(v,float)
        print(k, np.nanmean(arr), 'med', np.nanmedian(arr), 'nan', np.isnan(arr).sum())

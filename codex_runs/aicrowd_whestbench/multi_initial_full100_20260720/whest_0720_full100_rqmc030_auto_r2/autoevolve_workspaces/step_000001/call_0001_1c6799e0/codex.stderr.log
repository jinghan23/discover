codex
I’m checking a more stable version of the vector control: use exact first-layer covariance from the ReLU kernel instead of estimating the control Gram matrix from the same samples. That should reduce overfit and FLOP overhead.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm

def first_primes(count):
    ps=[]; c=2
    while len(ps)<count:
        ok=True
        for p in ps:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: ps.append(c)
        c+=1
    return np.array(ps,float)
P={}
def dirs(n,w,seed,shifts=2):
    if w not in P: P[w]=first_primes(w)
    rng=np.random.default_rng(seed); gen=np.sqrt(P[w])%1; nps=max(1,n//shifts); chunks=[]
    for _ in range(shifts): chunks.append((np.arange(nps)[:,None]*gen+rng.random(w))%1)
    u=np.concatenate(chunks)[:n]; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); z/=np.maximum(np.linalg.norm(z,axis=1,keepdims=True),1e-30); return z
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
def wsamp(w,d,seed):
    rng=np.random.default_rng(seed); sc=math.sqrt(2/w); return [rng.standard_normal((w,w))*sc for _ in range(d)]
def fw(ws,x,save=False):
    a=x; a1=p1=None
    for i,W in enumerate(ws):
        p=a@W; a=np.maximum(p,0)
        if save and i==0: a1=a.copy(); p1=p.copy()
    return (a,a1,p1) if save else a
def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<ns:
        n=min(50000,ns-done); s+=fw(ws,rng.standard_normal((n,w))).sum(0); done+=n
    return s/done
def exact_a_cov(W):
    w=W.shape[0]; gram=W.T@W; norm2=np.diag(gram); sig=np.sqrt(np.maximum(norm2,0)); denom=np.maximum(np.outer(sig,sig),1e-300); rho=np.clip(gram/denom,-1,1)
    kernel=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
    second=denom*kernel/w
    mu=sig/(math.sqrt(2*math.pi)*mr(w))
    cov=second-np.outer(mu,mu)
    return mu,cov,gram,norm2
def est(ws,n,seed,kind='scalar',ridge=1e-8):
    w=ws[0].shape[0]; x=dirs(n,w,seed); y,a1,p1=fw(ws,x,True); ym=y.mean(0); mrad=mr(w); W=ws[0]
    mu_a,cov_a,gram,n2=exact_a_cov(W); first=mu_a*mrad
    # scalar current sample controls
    def scalar_correct(y):
        controls=np.column_stack([a1.sum(1),(a1*a1).sum(1),(a1**4).sum(1),(p1*p1).sum(1)])
        ex=np.array([mu_a.sum(),.5*n2.sum()/w,1.5*np.sum(n2*n2)/(w*(w+2)),n2.sum()/w])
        cm=controls.mean(0); X=controls-cm; Y=y-y.mean(0); G=X.T@X; G.flat[::5]+=ridge*n
        beta=np.linalg.solve(G,X.T@Y); return y.mean(0)-(cm-ex)@beta, Y-X@beta
    if kind=='none': return mrad*ym
    if kind=='a_exact':
        X=a1-mu_a; Y=y-ym; cross=X.T@Y/n; G=cov_a.copy(); G.flat[::w+1]+=ridge
        beta=np.linalg.solve(G,cross); return mrad*(ym-(a1.mean(0)-mu_a)@beta)
    if kind=='p_exact':
        X=p1; Y=y-ym; cross=X.T@Y/n; G=gram/w; G=G.copy(); G.flat[::w+1]+=ridge
        beta=np.linalg.solve(G,cross); return mrad*(ym-p1.mean(0)@beta)
    if kind=='pa_exact':
        mu=np.concatenate([np.zeros(w),mu_a]); C=np.column_stack([p1,a1]); X=C-mu; Y=y-ym; cross=X.T@Y/n
        G=np.empty((2*w,2*w)); G[:w,:w]=gram/w; G[:w,w:]=gram/(2*w); G[w:,:w]=gram.T/(2*w); G[w:,w:]=cov_a
        G.flat[::2*w+1]+=ridge
        beta=np.linalg.solve(G,cross); return mrad*(ym-(C.mean(0)-mu)@beta)
    if kind=='scalar':
        corr,_=scalar_correct(y); return mrad*corr
    if kind=='scalar_then_a_exact':
        ycorr_s, residual=scalar_correct(y)  # residual centered sphere y after scalar
        # beta on residual vs a1 using exact cov
        cross=(a1-mu_a).T@residual/n; G=cov_a.copy(); G.flat[::w+1]+=ridge
        beta=np.linalg.solve(G,cross); return mrad*(ycorr_s-(a1.mean(0)-mu_a)@beta)
    if kind=='sample_a':
        C=np.column_stack([a1.sum(1),(a1*a1).sum(1),(a1**4).sum(1),(p1*p1).sum(1),a1])
        ex=np.concatenate([[mu_a.sum(),.5*n2.sum()/w,1.5*np.sum(n2*n2)/(w*(w+2)),n2.sum()/w],mu_a])
        cm=C.mean(0); X=C-cm; Y=y-ym; m=C.shape[1]; G=X.T@X; G.flat[::m+1]+=ridge*n; beta=np.linalg.solve(G,X.T@Y); return mrad*(ym-(cm-ex)@beta)

configs=[(64,16,4096,600000),(64,32,4096,400000),(128,16,2048,350000),(128,32,2048,250000)]
kinds=['none','scalar','a_exact','p_exact','pa_exact','scalar_then_a_exact','sample_a']
for w,d,n,ns in configs:
    print('\\nCONFIG',w,d,n,flush=True); res={k:[] for k in kinds}
    for mi in range(5):
        ws=wsamp(w,d,300+mi); tgt=target(ws,ns,1000+mi)
        for k in kinds:
            try: pred=est(ws,n,mi,k)
            except Exception as e: print('err',k,e); pred=np.full(w,np.nan)
            res[k].append(np.nanmean((pred-tgt)**2))
    for k,v in res.items(): print(k,float(np.nanmean(v)),'med',float(np.nanmedian(v)))

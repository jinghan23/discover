import numpy as np, math
from scipy.stats import norm
P={}
def primes(c):
    if c not in P:
        ps=[]; x=2
        while len(ps)<c:
            ok=True
            for p in ps:
                if p*p>x: break
                if x%p==0: ok=False; break
            if ok: ps.append(x)
            x+=1
        P[c]=np.array(ps,float)
    return P[c]
def dirs(n,w,seed):
    rng=np.random.default_rng(seed); gen=np.sqrt(primes(w))%1; nps=max(1,n//2); u=np.concatenate([(np.arange(nps)[:,None]*gen+rng.random(w))%1 for _ in range(2)])[:n]
    z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.maximum(np.linalg.norm(z,axis=1,keepdims=True),1e-30)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
def wsamp(w,d,s):
    rng=np.random.default_rng(s); return [rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
def fw(ws,x,save=False):
    a=x; a1=p1=None
    for i,W in enumerate(ws):
        p=a@W; a=np.maximum(p,0)
        if save and i==0: a1=a.copy(); p1=p.copy()
    return (a,a1,p1) if save else a
def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<ns:
        n=min(50000,ns-done); s+=fw(ws,rng.standard_normal((n,w))).sum(0); done+=n
    return s/done
def scalar_pred(ws,y,a1,p1):
    w=ws[0].shape[0]; ym=y.mean(0); n2=np.sum(ws[0]*ws[0],0); first=np.sqrt(n2)/math.sqrt(2*math.pi); mrad=mr(w)
    C=np.column_stack([a1.sum(1),(a1*a1).sum(1),(a1**4).sum(1),(p1*p1).sum(1)]); ex=np.array([first.sum()/mrad,.5*n2.sum()/w,1.5*np.sum(n2*n2)/(w*(w+2)),n2.sum()/w])
    cm=C.mean(0); X=C-cm; Y=y-ym; beta=np.linalg.solve(X.T@X+1e-8*y.shape[0]*np.eye(4),X.T@Y); return ym-(cm-ex)@beta
def pred(ws,n,seed,mode):
    w=ws[0].shape[0]; x=dirs(n,w,seed); y,a1,p1=fw(ws,x,True); ym=y.mean(0); mrad=mr(w); n2=np.sum(ws[0]*ws[0],0); mu1=np.sqrt(n2)/(math.sqrt(2*math.pi)*mrad)
    base=scalar_pred(ws,y,a1,p1) if 'scalar' in mode else ym
    if 'lin' not in mode: return mrad*base
    for gate in [0.5]: pass
    B=ws[1].copy() if len(ws)>1 else np.eye(w)
    # include a 0.5 derivative after every remaining ReLU, including final layer output gate, variants below
    if mode.endswith('allhalf'):
        B=0.5*B
        for W in ws[2:]: B=B@(0.5*W)
    elif mode.endswith('hiddenhalf'):
        for W in ws[2:-1]: B=B@(0.5*W)
        if len(ws)>2: B=B@ws[-1]
    elif mode.endswith('nohalf'):
        for W in ws[2:]: B=B@W
    elif mode.endswith('decay'):
        B=0.5*B
        for W in ws[2:]: B=B@(0.5*W)
    h=a1@B; eh=mu1@B; ch=h-h.mean(0); cy=y-y.mean(0)
    if 'diag' in mode:
        beta=np.sum(ch*cy,axis=0)/(np.sum(ch*ch,axis=0)+1e-8*n)
        corr=(h.mean(0)-eh)*beta
        return mrad*(base-corr)
    else:
        C=h; cm=C.mean(0); X=C-cm; Y=y-y.mean(0); G=X.T@X+1e-8*n*np.eye(w); beta=np.linalg.solve(G,X.T@Y); corr=(cm-eh)@beta; return mrad*(base-corr)
configs=[(64,16,4096,400000),(64,32,4096,300000),(128,16,2048,250000),(128,32,2048,200000)]
modes=['scalar','lin_diag_allhalf','scalar_lin_diag_allhalf','scalar_lin_diag_hiddenhalf','scalar_lin_diag_nohalf','scalar_lin_full_allhalf']
for w,d,n,ns in configs:
    print('\\nCONFIG',w,d); res={m:[] for m in modes}
    for mi in range(5):
        ws=wsamp(w,d,6000+mi); tgt=target(ws,ns,7000+mi)
        for m in modes:
            try: pr=pred(ws,n,mi,m)
            except Exception as e: print('err',m,e); pr=np.full(w,np.nan)
            res[m].append(np.nanmean((pr-tgt)**2))
    for m,v in res.items(): print(m,np.mean(v),np.median(v))

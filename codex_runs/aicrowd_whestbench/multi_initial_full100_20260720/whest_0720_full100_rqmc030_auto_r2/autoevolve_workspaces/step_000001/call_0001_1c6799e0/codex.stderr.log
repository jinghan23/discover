    z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.maximum(np.linalg.norm(z,axis=1,keepdims=True),1e-30)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
def wsamp(w,d,s):
    rng=np.random.default_rng(s); return [rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
def fw(ws,x,save=False):
    a=x; a1=p1=None
    for i,W in enumerate(ws):
        p=a@W; a=np.maximum(p,0)
        if save and i==0: a1=a.copy(); p1=p.copy()
    return (a,a1,p1) if save else a
def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<ns:
        n=min(50000,ns-done); s+=fw(ws,rng.standard_normal((n,w))).sum(0); done+=n
    return s/done
def preds(ws,n,seed):
    w=ws[0].shape[0]; x=dirs(n,w,seed); y,a1,p1=fw(ws,x,True); ym=y.mean(0); mrad=mr(w); n2=np.sum(ws[0]*ws[0],0); first=np.sqrt(n2)/math.sqrt(2*math.pi)
    C=np.column_stack([a1.sum(1),(a1*a1).sum(1),(a1**4).sum(1),(p1*p1).sum(1)])
    ex=np.array([first.sum()/mrad,.5*n2.sum()/w,1.5*np.sum(n2*n2)/(w*(w+2)),n2.sum()/w])
    cm=C.mean(0); X=C-cm; Y=y-ym; beta=np.linalg.solve(X.T@X+1e-8*n*np.eye(4),X.T@Y); scalar=mrad*(ym-(cm-ex)@beta)
    W=ws[0]; gram=W.T@W; sig=np.sqrt(np.maximum(n2,0)); den=np.maximum(np.outer(sig,sig),1e-300); rho=np.clip(gram/den,-1,1)

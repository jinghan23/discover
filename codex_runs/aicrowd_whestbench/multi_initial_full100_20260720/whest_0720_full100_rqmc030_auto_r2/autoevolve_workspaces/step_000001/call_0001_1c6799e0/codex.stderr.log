# Local tent transform comparison for the original scalar estimator.
import numpy as np, math
from scipy.stats import norm
P={}
def primes(c):
    if c not in P:
        ps=[]; x=2
        while len(ps)<c:
            ok=True
            for p in ps:
                if p*p>x: break
                if x%p==0: ok=False; break
            if ok: ps.append(x)
            x+=1
        P[c]=np.array(ps,float)
    return P[c]
def dirs(n,w,seed,tent=False):
    rng=np.random.default_rng(seed); gen=np.sqrt(primes(w))%1; nps=max(1,n//2); u=np.concatenate([(np.arange(nps)[:,None]*gen+rng.random(w))%1 for _ in range(2)])[:n]
    if tent: u=1-np.abs(2*u-1)
    z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.maximum(np.linalg.norm(z,axis=1,keepdims=True),1e-30)
def mr(w): return math.sqrt(2)*math.exp(math.lgamma(.5*(w+1))-math.lgamma(.5*w))
def wsamp(w,d,s):
    rng=np.random.default_rng(s); return [rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
def fw(ws,x,save=False):
    a=x; a1=p1=None
    for i,W in enumerate(ws):
        p=a@W; a=np.maximum(p,0)
        if save and i==0: a1=a.copy(); p1=p.copy()
    return (a,a1,p1) if save else a
def target(ws,ns,seed):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<ns:
        n=min(50000,ns-done); s+=fw(ws,rng.standard_normal((n,w))).sum(0); done+=n
    return s/done
def est(ws,n,seed,tent):
    w=ws[0].shape[0]; x=dirs(n,w,seed,tent); y,a1,p1=fw(ws,x,True); ym=y.mean(0); n2=np.sum(ws[0]*ws[0],0); first=np.sqrt(n2)/math.sqrt(2*math.pi); mrad=mr(w)
    C=np.column_stack([a1.sum(1),(a1*a1).sum(1),(a1**4).sum(1),(p1*p1).sum(1)]); ex=np.array([first.sum()/mrad,.5*n2.sum()/w,1.5*np.sum(n2*n2)/(w*(w+2)),n2.sum()/w])
    cm=C.mean(0); X=C-cm; Y=y-ym; beta=np.linalg.solve(X.T@X+1e-8*n*np.eye(4),X.T@Y); return mrad*(ym-(cm-ex)@beta)
for w,d,n,ns in [(64,16,4096,300000),(64,32,4096,250000),(128,16,2048,220000),(128,32,2048,180000)]:
    print('\\nCONFIG',w,d); res={False:[],True:[]}
    for mi in range(5):
        ws=wsamp(w,d,8000+mi); tgt=target(ws,ns,9000+mi)
        for tent in res: res[tent].append(np.mean((est(ws,n,mi,tent)-tgt)**2))
    for tent,v in res.items(): print('tent',tent,np.mean(v),np.median(v))

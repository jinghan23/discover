import numpy as np, math, time
from scipy.stats import norm


def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes, dtype=np.float64)

def lattice_dirs(n_total,w,seed,shifts=2,tail=1e-11,antithetic=False):
    rng=np.random.default_rng(seed)
    gen=np.sqrt(first_primes(w))%1.0
    if antithetic:
        n_base=(n_total+1)//2
    else:
        n_base=n_total
    nps=max(1,n_base//shifts)
    chunks=[]
    for _ in range(shifts):
        idx=np.arange(nps,dtype=np.float64)[:,None]
        sh=rng.random(w)
        u=(idx*gen[None,:]+sh[None,:])%1.0
        chunks.append(u)
    u=np.concatenate(chunks,axis=0)[:n_base]
    z=norm.ppf(np.clip(u,tail,1-tail))
    r=np.linalg.norm(z,axis=1,keepdims=True)
    dirs=z/np.maximum(r,1e-30)
    if antithetic:
        dirs=np.concatenate([dirs,-dirs],axis=0)[:n_total]
    return dirs

def mean_radius(w):
    return math.sqrt(2)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

def forward_all(weights,x):
    a=x
    first_a=first_p=None
    for i,W in enumerate(weights):
        p=a@W
        a=np.maximum(p,0)
        if i==0:
            first_a=a.copy(); first_p=p.copy()
    return a, first_a, first_p

def exact_first(W,w):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def estimate(weights, n, seed=0, shifts=2, kind='scalar', antithetic=False, ridge=1e-10):
    w=weights[0].shape[0]
    dirs=lattice_dirs(n,w,seed,shifts=shifts,antithetic=antithetic)
    y,a1,p1=forward_all(weights,dirs)
    mr=mean_radius(w)
    frow=exact_first(weights[0],w)
    ymean=y.mean(0)
    if kind=='none':
        return mr*ymean
    controls=[]; exact=[]
    if kind in ('scalar','scalar_more','veca','vecap','veca2','vecall','vecdiag'):
        # scalar controls matching candidate
        controls += [a1.sum(1), (a1*a1).sum(1), (a1**4).sum(1), (p1*p1).sum(1)]
        norm2=np.sum(weights[0]*weights[0],axis=0)
        exact += [frow.sum()/mr, 0.5*np.sum(norm2)/w, 1.5*np.sum(norm2*norm2)/(w*(w+2)), np.sum(norm2)/w]
    if kind in ('scalar_more',):
        # add p1 fourth sum exact and total signed linear zero? maybe abs? exact p4=3 sum norm4/(w(w+2))
        norm2=np.sum(weights[0]*weights[0],axis=0)
        controls += [(p1**4).sum(1)]
        exact += [3.0*np.sum(norm2*norm2)/(w*(w+2))]
    if kind in ('veca','vecap','veca2','vecall','vecdiag'):
        # add per-neuron a1
        controls.append(a1); exact.append(frow/mr)
    if kind in ('vecap','vecall'):
        controls.append(p1); exact.append(np.zeros(w))
    if kind in ('veca2','vecall','vecdiag'):
        norm2=np.sum(weights[0]*weights[0],axis=0)
        controls.append(a1*a1); exact.append(0.5*norm2/w)
    if kind in ('vecall',):
        norm2=np.sum(weights[0]*weights[0],axis=0)
        controls.append(p1*p1); exact.append(norm2/w)
    C=np.column_stack([c if getattr(c,'ndim',1)>1 else c[:,None] for c in controls])
    ex=np.concatenate([np.ravel(e) for e in exact])
    cm=C.mean(0)
    X=C-cm
    Y=y-ymean
    # beta solve. for m>n, use ridge in sample space? Use lstsq stable.
    m=C.shape[1]
    if kind=='vecdiag':
        var=np.sum(X*X,axis=0)+ridge*n
        cov=X.T@Y
        beta=cov/var[:,None]
    else:
        G=X.T@X
        G.flat[::m+1]+=ridge*n
        beta=np.linalg.solve(G,X.T@Y)
    corr=(cm-ex)@beta
    return mr*(ymean-corr)

def target(weights, ns=200000, seed=123, chunk=20000):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    s=np.zeros(w)
    done=0
    for _ in range((ns+chunk-1)//chunk):
        n=min(chunk,ns-done)
        x=rng.standard_normal((n,w))
        a=x
        for W in weights:
            a=np.maximum(a@W,0)
        s+=a.sum(0)
        done+=n
    return s/done

def sample_weights(w,d,seed):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2.0/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float64) for _ in range(d)]

configs=[(32,8,256),(32,16,256),(64,8,256),(64,16,192)]
kinds=['none','scalar','scalar_more','veca','veca2','vecap','vecall','vecdiag']
for w,d,n in configs:
    print('\\nCONFIG',w,d,'n',n, flush=True)
    mses={k:[] for k in kinds}
    mses.update({f'scalar_ant{s}':[] for s in [1,2,4]})
    for mi in range(6):

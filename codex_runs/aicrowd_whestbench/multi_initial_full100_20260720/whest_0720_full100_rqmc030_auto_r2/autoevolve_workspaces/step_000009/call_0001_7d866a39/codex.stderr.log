exec
/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy import special

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def lattice(width,n,seed,shift_count=2):
    rng=np.random.default_rng(seed)
    gen=np.sqrt(first_primes(width))%1
    n_per=max(1,n//shift_count)
    base=rng.random(width)
    arr=[]; paired=base
    for si in range(shift_count):
        if si==0: shift=base
        elif si==1: shift=1-base
        elif si%2==0:
            paired=rng.random(width); shift=paired
        else: shift=1-paired
        idx=np.arange(n_per)[:,None]
        u=(idx*gen[None,:]+shift[None,:])%1
        arr.append(u)
    u=np.concatenate(arr,0)
    u=1-np.abs(2*u-1)
    u=np.clip(u,1e-11,1-1e-11)
    x=special.ndtri(u)
    r=np.sqrt((x*x).sum(1))[:,None]
    return x/np.maximum(r,1e-30)

def exact_first(W):
    sd=np.sqrt((W*W).sum(0))
    return sd/math.sqrt(2*math.pi)

def mean_radius(w):
    return math.sqrt(2)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

def first_dir_mean_cov(W, mean_r, ridge=1e-8):
    w=W.shape[0]
    gram=W.T@W
    ns=np.maximum((W*W).sum(0),0)
    sd=np.sqrt(ns)
    outer=sd[:,None]*sd[None,:]
    corr=np.clip(gram/np.maximum(outer,1e-300),-1,1)
    kern=(np.sqrt(np.maximum(1-corr*corr,0))+(math.pi-np.arccos(corr))*corr)/(2*math.pi)
    second=outer*kern/w
    mean=sd/(math.sqrt(2*math.pi)*mean_r)
    cov=second-np.outer(mean,mean)+ridge*np.eye(w)
    return mean,cov,gram

def rqmc_est(weights,n,seed,scale=0.763,zscale=0.0,diag_blend=0.0):
    depth=len(weights); width=weights[0].shape[0]; mr=mean_radius(width)
    a=lattice(width,n,seed,2); actual=a.shape[0]
    first_a=first_z=None
    for li,W in enumerate(weights):
        z=a@W; a=np.maximum(z,0)
        if li==0:
            first_a=a.copy(); first_z=z.copy()
    final_mean=a.mean(0); centered_final=a-final_mean
    em,cov,gram=first_dir_mean_cov(weights[0],mr)
    centered=first_a-em[None,:]
    h=actual//2
    corr=0
    if scale:
        c1=centered[:h].T@centered_final[:h]/h
        c2=centered[h:].T@centered_final[h:]/(actual-h)
        b1=np.linalg.solve(cov,c1); b2=np.linalg.solve(cov,c2)
        m1=first_a[:h].mean(0); m2=first_a[h:].mean(0)
        corr += scale*0.5*((m1-em)@b2 + (m2-em)@b1)
    if zscale:
        zcov=gram/width+1e-8*np.eye(width)
        cz=first_z # mean 0
        c1=cz[:h].T@centered_final[:h]/h
        c2=cz[h:].T@centered_final[h:]/(actual-h)
        b1=np.linalg.solve(zcov,c1); b2=np.linalg.solve(zcov,c2)
        m1=cz[:h].mean(0); m2=cz[h:].mean(0)
        corr += zscale*0.5*(m1@b2 + m2@b1)
    est=mr*(final_mean-corr)
    if diag_blend:
        diag=diag_prop(weights)
        est=(1-diag_blend)*est+diag_blend*diag
    return est

def diag_prop(weights):
    w=weights[0].shape[0]
    m=np.zeros(w); v=np.ones(w)
    for W in weights:
        mu=m@W
        var=(v)@(W*W) # ignore cov; Var sum w"'^2 Var(a)
        sig=np.sqrt(np.maximum(var,1e-300))
        alpha=mu/sig
        Phi=0.5*(1+special.erf(alpha/math.sqrt(2)))
        phi=np.exp(-0.5*alpha*alpha)/math.sqrt(2*math.pi)
        mean=sig*phi+mu*Phi
        sec=(var+mu*mu)*Phi+mu*sig*phi
        v=np.maximum(sec-mean*mean,0)
        m=mean
    return m

def mc_ref(weights,n=200000,seed=999,chunk=10000):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    s=np.zeros(w); count=0
    for _ in range((n+chunk-1)//chunk):
        k=min(chunk,n-count)
        x=rng.standard_normal((k,w)).astype(np.float32)
        a=x
        for W in weights:
            a=np.maximum(a@W,0)
        s+=a.sum(0); count+=k
    return s/count

def run(width=64,depth=6,n=512,cases=6):
    rows=[]
    for seed in range(cases):
        rng=np.random.default_rng(1234+seed)
        scale=math.sqrt(2/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]
        ref=mc_ref(weights,n=100000 if width<=64 else 50000,seed=9000+seed,chunk=5000)
        vals={}
        for name,kw in [
            ('"'base',{}),('scale1',{'scale':1.0}),('scale0.6',{'scale':0.6}),
            ('z0.2',{'zscale':0.2}),('z0.5',{'zscale':0.5}),('z1',{'zscale':1.0}),
            ('diag.05',{'diag_blend':0.05}),('diag.1',{'diag_blend':0.1}),('diag.2',{'diag_blend':0.2}),
            ('nocv',{'scale':0.0}),
        ]:
            est=rqmc_est(weights,n,seed=777+seed,**kw)
            vals[name]=float(np.mean((est-ref)**2))
        rows.append(vals)
    names=list(rows[0])
    print('width depth n',width,depth,n)
    for name in names:
        arr=np.array([r[name] for r in rows])
        print(name, arr.mean(), arr.std()/math.sqrt(len(arr)))

for width,depth,n in [(64,6,512),(64,10,384),(128,6,256),(128,10,192)]:
    run(width,depth,n,cases=4)

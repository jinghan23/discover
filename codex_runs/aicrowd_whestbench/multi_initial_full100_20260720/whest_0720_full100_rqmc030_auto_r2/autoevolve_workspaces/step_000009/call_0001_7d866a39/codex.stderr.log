     return math.sqrt(2.0 / math.pi) / mean_radius_cubed
 
 
+def _diagonal_gaussian_final_mean(mlp) -> fnp.ndarray:
+    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
+    variance = fnp.ones(mlp.width, dtype=fnp.float64)
+    for weight in mlp.weights:
+        preactivation_mean = mean @ weight
+        preactivation_variance = variance @ (weight * weight)

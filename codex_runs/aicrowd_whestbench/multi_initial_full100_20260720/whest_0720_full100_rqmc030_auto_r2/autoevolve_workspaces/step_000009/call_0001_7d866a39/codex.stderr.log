+        standard_deviation = fnp.sqrt(preactivation_variance)
+        standardized_mean = preactivation_mean / standard_deviation
+        cdf = flops.stats.norm.cdf(standardized_mean)
+        pdf = flops.stats.norm.pdf(standardized_mean)
+        mean = standard_deviation * pdf + preactivation_mean * cdf
+        second_moment = (
+            (preactivation_variance + preactivation_mean * preactivation_mean) * cdf
+            + preactivation_mean * standard_deviation * pdf
+        )
+        variance = fnp.maximum(second_moment - mean * mean, 0.0)
+    return mean
+
+
+def _blend_with_diagonal_gaussian(estimate: fnp.ndarray, mlp) -> fnp.ndarray:
+    if _DIAGONAL_GAUSSIAN_BLEND <= 0.0:
+        return estimate
+    diagonal_estimate = _diagonal_gaussian_final_mean(mlp)
+    return (
+        (1.0 - _DIAGONAL_GAUSSIAN_BLEND) * estimate
+        + _DIAGONAL_GAUSSIAN_BLEND * diagonal_estimate
+    )
+

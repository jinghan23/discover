('shift8_nocf',{'_SHIFT_COUNT':8,'_CROSS_FIT_VECTOR_CONTROL':False}),
('shift8_nocf_s1.0',{'_SHIFT_COUNT':8,'_CROSS_FIT_VECTOR_CONTROL':False,'_VECTOR_CONTROL_SCALE':1.0}),
('frac24_shift8',{'_TARGET_FLOP_FRACTION':0.24,'_SHIFT_COUNT':8}),
('frac32_shift8',{'_TARGET_FLOP_FRACTION':0.32,'_SHIFT_COUNT':8}),
]

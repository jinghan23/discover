import time, math
import numpy as np
import flopscope.numpy as fnp
from whestbench import MLP
import submission
from whestbench.estimators import MeanPropagationEstimator, CovariancePropagationEstimator


def make_mlp(width, depth, seed, est_seed=123):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2.0/width)
    weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    fweights=[fnp.array(w) for w in weights]
    return MLP(width=width, depth=depth, weights=fweights, seed=est_seed), weights


def mc_target(weights, n, seed, chunk=8192):
    rng=np.random.default_rng(seed)
    width=weights[0].shape[0]
    depth=len(weights)
    total=np.zeros(width, dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights:
            x=x@w
            np.maximum(x,0,out=x)
        total += x.sum(axis=0,dtype=np.float64)
        done += m
    return total/n


def budget_for_n(n,width,depth):
    per=(89*width+4*width+depth*(2*width*width+width)+14*width+(width if depth>1 else 0))
    fixed=2*width*width+8*width
    return int((n*per+fixed)/0.14)


    return _const_cache[width]
def directions(count,width,seed,shift_count=4,offset=0):
    rng=fnp.random.default_rng(seed+offset); gen,mean_radius,_,_=constants(width)
    n_per=max(1,count//shift_count); arrays=[]; paired=rng.random(width)
    for si in range(shift_count):

for cf in [False, True]:
    eval_variant('crossfit '+str(cf), _CROSS_FIT_VECTOR_CONTROL=cf)
for sh in [1,2,4,8]:
    eval_variant('shift '+str(sh), _SHIFT_COUNT=sh)
eval_variant('antipodal', _ANTIPODAL_DIRECTIONS=True)
for off in [0,1,2,7,13,101,1009]:

# Save defaults
DEFAULTS={k:getattr(submission,k) for k in ['_TARGET_FLOP_FRACTION','_SHIFT_COUNT','_ANTIPODAL_DIRECTIONS','_CROSS_FIT_VECTOR_CONTROL','_SEED_OFFSET','_VECTOR_CONTROL_SCALE','_VECTOR_CONTROL_MIN_SAMPLE_FACTOR']}

def restore():
    for k,v in DEFAULTS.items(): setattr(submission,k,v)

def make_mlp(width, depth, seed, est_seed):
    rng=np.random.default_rng(seed); scale=math.sqrt(2.0/width)
    weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    return MLP(width=width, depth=depth, weights=[fnp.array(w) for w in weights], seed=est_seed), weights

def mc_target(weights, n, seed, chunk=8192):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]
    total=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights:
            x=x@w; np.maximum(x,0,out=x)
        total += x.sum(axis=0,dtype=np.float64); done += m
    return total/n

def budget_for_n(n,width,depth,frac=0.14):
    per=(89*width+4*width+depth*(2*width*width+width)+14*width+(width if depth>1 else 0))
    fixed=2*width*width+8*width
    return int((n*per+fixed)/frac)

width=64; depth=32; n_est=9000; budget=budget_for_n(n_est,width,depth)
mlps=[]
for i in range(6):
    mlp,w=make_mlp(width,depth,1000+i,2000+i)
    target=mc_target(w,200000,3000+i)
    mlps.append((mlp,target))
print('prepared',len(mlps),'budget',budget,'default_n',submission._sample_count(budget,width,depth))

def eval_variant(label, **params):
    restore()
    for k,v in params.items(): setattr(submission,k,v)
    ms=[]; times=[]; ns=[]
    for mlp,target in mlps:
        est=submission.Estimator(); est.setup(type('C',(),{'seed':0})())
        t=time.time(); pred=np.asarray(est.predict(mlp,budget))[-1].astype(np.float64); times.append(time.time()-t)

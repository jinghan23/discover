A stronger variance-reduction idea is to estimate an early hidden layer with many cheap truncated passes, then use that layer as a vector control variate for the final layer. I’m prototyping it locally before deciding whether it is worth adding to `submission.py`.
exec
/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import MLP
import submission

def make_mlp(width, depth, seed, est_seed):
    rng=np.random.default_rng(seed); scale=math.sqrt(2.0/width)
    weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    return MLP(width=width, depth=depth, weights=[fnp.array(w) for w in weights], seed=est_seed), weights
def mc_target(weights, n, seed, chunk=8192):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]
    total=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights:
            x=x@w; np.maximum(x,0,out=x)
        total += x.sum(axis=0,dtype=np.float64); done += m
    return total/n

def directions(count,width,seed,shift_count=4):
    rng=fnp.random.default_rng(seed)
    gen, mean_radius, identity, zero = submission.Estimator()._constants_for_width(width)
    n_per=max(1,count//shift_count)
    base=rng.random(width); arrays=[]; paired=base
    for si in range(shift_count):
        if si==0: shift=base
        elif si==1: shift=1.0-base
        elif si%2==0:
            paired=rng.random(width); shift=paired
        else: shift=1.0-paired
        arrays.append(submission._lattice_uniforms(n_per,gen,shift))
    u=fnp.concatenate(tuple(arrays),axis=0)
    u=1.0-fnp.abs(2.0*u-1.0); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
    a=flops.stats.norm.ppf(u)
    r=fnp.sqrt(fnp.sum(a*a,axis=1))[:,None]
    return fnp.asarray(a/fnp.maximum(r,1e-30),dtype=fnp.float32), mean_radius

def estimate_layer_control(mlp,n_full,n_ref,ctrl_idx,seed,shift_count=4,scale=1.0,stack_first=False):
    width=mlp.width
    x,mean_radius=directions(n_full,width,seed,shift_count)
    ctrl=None; first=None
    for li,w in enumerate(mlp.weights):
        x=fnp.maximum(x@w,0.0)
        if li==0: first=x
        if li==ctrl_idx: ctrl=x
    final=x
    fm=fnp.mean(final,axis=0)
    centered_final=final-fm[None,:]

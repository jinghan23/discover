    mlp, weights=make_mlp(width, depth, seed=1000+i, est_seed=2000+i)
    t0=time.time(); target=mc_target(weights, 200000, 3000+i); print('target time',time.time()-t0)
    for name, est in [('current', submission.Estimator()), ('mean', MeanPropagationEstimator()), ('cov', CovariancePropagationEstimator())]:
        if hasattr(est,'setup'): est.setup(type('C',(),{'seed':0})())
        t0=time.time(); pred=np.asarray(est.predict(mlp,budget))[-1].astype(np.float64); dt=time.time()-t0
        mse=((pred-target)**2).mean()
        print(i,name,'mse',mse,'rmse',math.sqrt(mse),'time',dt,'meanpred',pred.mean(),'targetmean',target.mean())

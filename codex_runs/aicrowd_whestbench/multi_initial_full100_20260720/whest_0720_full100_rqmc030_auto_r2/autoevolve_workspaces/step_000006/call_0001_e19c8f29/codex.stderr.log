+def _diagonal_gaussian_rows(mlp) -> list[fnp.ndarray]:
+    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
+    second_moment = fnp.ones(mlp.width, dtype=fnp.float64)
+    rows = []
+    for weight in mlp.weights:
+        variance = fnp.maximum(second_moment - mean * mean, 0.0)
+        preactivation_mean = mean @ weight
+        preactivation_variance = variance @ (weight * weight)
+        standard_deviation = fnp.sqrt(fnp.maximum(preactivation_variance, 0.0))
+        safe_standard_deviation = fnp.maximum(standard_deviation, 1e-30)
+        standardized_mean = preactivation_mean / safe_standard_deviation
+        normal_cdf = flops.stats.norm.cdf(standardized_mean)
+        normal_pdf = flops.stats.norm.pdf(standardized_mean)
+        mean = (
+            standard_deviation * normal_pdf + preactivation_mean * normal_cdf
+        )
+        second_moment = (
+            (preactivation_variance + preactivation_mean * preactivation_mean)
+            * normal_cdf
+            + preactivation_mean * standard_deviation * normal_pdf
+        )
+        rows.append(mean)
+    return rows

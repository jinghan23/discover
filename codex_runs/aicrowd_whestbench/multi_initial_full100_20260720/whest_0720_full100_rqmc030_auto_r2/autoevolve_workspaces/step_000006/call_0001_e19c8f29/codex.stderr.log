+    )
+    covariance = fnp.concatenate((top, bottom), axis=0)
+    covariance = covariance + _VECTOR_CONTROL_RIDGE * fnp.eye(
+        2 * width, dtype=fnp.float64
+    )
+    mean = fnp.concatenate((activation_mean, zero_row), axis=0)
+    return mean, covariance

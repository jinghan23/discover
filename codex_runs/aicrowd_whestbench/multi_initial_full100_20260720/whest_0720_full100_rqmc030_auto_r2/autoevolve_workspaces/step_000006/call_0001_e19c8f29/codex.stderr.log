+def _first_layer_gaussian_mean_and_covariance(
+    first_weight: fnp.ndarray, identity: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    gram = first_weight.T @ first_weight
+    norm_squared = fnp.maximum(fnp.sum(first_weight * first_weight, axis=0), 0.0)
+    standard_deviation = fnp.sqrt(norm_squared)
+    standard_deviation_outer = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(
+        gram / fnp.maximum(standard_deviation_outer, 1e-300), -1.0, 1.0
+    )
+    relu_kernel = (
+        fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        + (fnp.pi - fnp.arccos(correlation)) * correlation
+    ) / (2.0 * fnp.pi)
+    second_moment = standard_deviation_outer * relu_kernel
+    mean = standard_deviation / fnp.sqrt(2.0 * fnp.pi)
+    covariance = second_moment - mean[:, None] * mean[None, :]
+    covariance = covariance + _VECTOR_CONTROL_RIDGE * identity
+    return mean, covariance
+
+
+def _first_layer_augmented_mean_and_covariance(
+    first_weight: fnp.ndarray, mean_radius: float, zero_row: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    width = first_weight.shape[0]
+    gram = first_weight.T @ first_weight
+    norm_squared = fnp.maximum(fnp.sum(first_weight * first_weight, axis=0), 0.0)
+    standard_deviation = fnp.sqrt(norm_squared)
+    standard_deviation_outer = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(
+        gram / fnp.maximum(standard_deviation_outer, 1e-300), -1.0, 1.0
+    )
+    relu_kernel = (
+        fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        + (fnp.pi - fnp.arccos(correlation)) * correlation
+    ) / (2.0 * fnp.pi)
+    second_moment = standard_deviation_outer * relu_kernel / width
+    activation_mean = standard_deviation / (fnp.sqrt(2.0 * fnp.pi) * mean_radius)
+    activation_covariance = second_moment - (
+        activation_mean[:, None] * activation_mean[None, :]
+    )
+    activation_preactivation_covariance = gram / (2.0 * width)
+    preactivation_covariance = gram / width
+
+    top = fnp.concatenate(
+        (activation_covariance, activation_preactivation_covariance), axis=1
+    )
+    bottom = fnp.concatenate(
+        (activation_preactivation_covariance.T, preactivation_covariance), axis=1
+    )
+    covariance = fnp.concatenate((top, bottom), axis=0)
+    covariance = covariance + _VECTOR_CONTROL_RIDGE * fnp.eye(
+        2 * width, dtype=fnp.float64
+    )
+    mean = fnp.concatenate((activation_mean, zero_row), axis=0)
+    return mean, covariance
+
+

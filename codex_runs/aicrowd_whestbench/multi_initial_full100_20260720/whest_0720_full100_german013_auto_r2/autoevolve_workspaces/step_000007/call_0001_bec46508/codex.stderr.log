codex
Later-layer diagonal nudges are out; they are much worse locally. I’m now testing a lower-bias variance-reduction option: a post-hoc control variate using the exact first-layer mean and the sampled relationship between first-layer activations and final outputs.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQ=math.sqrt(2/math.pi); FIRST=.85; POST=.19

def cdf(x): x=np.clip(x,-8,8); y=SQ*(x+.044715*x*x*x); return .5*(1+np.tanh(y))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*cdf(a)
def lattice(half,w,seed):
    pairs=w//2; rng=np.random.default_rng(seed); sh1=rng.random((1,pairs),dtype=np.float32); sh2=rng.random((1,pairs),dtype=np.float32); i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*.754877666+sh1,1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+sh2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; return np.concatenate([r*np.cos(a),r*np.sin(a)],1).astype(np.float32)
def pred(weights,seed,cv='none',ridge=1e-4):
    w=weights[0].shape[0]; d=len(weights); budget=272_000_000_000; per=d*(2*w*w+w)+w*w+16*w; fixed=13*w**3; k=(int(.120*budget)-fixed)//per; k=max(32,min(k,24576)); k-=k&1
    u=lattice(k//2,w,seed+17); z=np.concatenate([u,-u],0); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T; x=np.maximum(z@(inv@weights[0]),0); h1_raw=x.copy()
    fv=np.sum(weights[0]*weights[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-sc*pm; x=np.where(x>0,np.maximum(x+FIRST*((sc-1)*x+shift),0),0); h1_corr=x.copy()
    gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pm2=tm@weights[1]; proj=fs@weights[1]; ps2=np.sum(weights[1]*proj,0); pv2=np.maximum(ps2-pm2*pm2,1e-20); secm=grelu(pm2,pv2)
    h2=None
    for li,wt in enumerate(weights[1:],1):
        if li==1:
            pre=x@wt; spm=pre.mean(0); sps=(pre*pre).mean(0); spv=np.maximum(sps-spm*spm,1e-12); pre=pm2+np.sqrt(pv2/spv)*(pre-spm); x=np.maximum(pre,0); x=np.maximum(x+POST*(secm-x.mean(0)),0); h2=x.copy()
        else: x=np.maximum(x@wt,0)
    y=x; my=y.mean(0)
    if cv=='none': return my
    if cv=='h1raw': C=h1_raw; mu=tm
    elif cv=='h1corr': C=h1_corr; mu=tm  # approximate known mean
    elif cv=='h2': C=h2; mu=secm
    elif cv=='h1both': C=np.concatenate([h1_raw,h1_raw*h1_raw],1); mu=np.concatenate([tm,ts])
    else: raise ValueError
    mc=C.mean(0); Cc=C-mc; Yc=y-my
    if C.shape[1] <= w:
        S=(Cc.T@Cc)/(k-1); CY=(Cc.T@Yc)/(k-1); S=S+ridge*np.trace(S)/S.shape[0]*np.eye(S.shape[0]); beta=np.linalg.solve(S,CY); return my+(mu-mc)@beta
    else:
        # diagonal for h1both to avoid oversized solve
        CY=(Cc.T@Yc)/(k-1); VV=np.maximum((Cc*Cc).mean(0),1e-12); beta=CY/VV[:,None]; return my+(mu-mc)@beta
def target(weights,n,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(8192,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
        for wt in weights: x=np.maximum(x@wt,0)
        s+=x.sum(0); done+=m
    return s/n
cvs=['none','h1raw','h1corr','h2','h1both']
for w,d,nmlp,n in [(64,32,8,200000),(128,32,5,120000),(256,16,3,80000)]:
    rng=np.random.default_rng(7777); vals={c:[] for c in cvs}; print('spec',w,d)
    for i in range(nmlp):
        weights=[(rng.standard_normal((w,w),dtype=np.float32)*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
        tgt=target(weights,n,1500+i)
        for c in cvs: vals[c].append(float(np.mean((pred(weights,1600+i,c)-tgt)**2)))
        print(i,{c:f'{np.mean(vals[c]):.3e}' for c in cvs}, flush=True)
    print('avg',{c:np.mean(vals[c]) for c in cvs})

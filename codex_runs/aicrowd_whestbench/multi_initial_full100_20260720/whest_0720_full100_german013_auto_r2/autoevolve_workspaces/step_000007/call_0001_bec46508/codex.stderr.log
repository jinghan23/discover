import numpy as np, math, time

BUDGET_FRACTION=0.120
MIN_SAMPLES=32
SAMPLE_CAP=24576
TWO_PI=2*math.pi
PI=math.pi
INV=1/math.sqrt(2*math.pi)
SQRT_2_PI=math.sqrt(2/math.pi)
FIRST=0.85
POST=0.19

def normal_cdf(x):
    x=np.clip(x,-8,8)
    y=SQRT_2_PI*(x+0.044715*x*x*x)
    return 0.5*(1+np.tanh(y))

def grelu(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8)
    phi=INV*np.exp(-0.5*a*a); cdf=normal_cdf(a)
    return sig*phi+mu*cdf

def lattice(half,w,seed):
    pairs=w//2; rng=np.random.default_rng(seed)
    shift1=rng.random((1,pairs), dtype=np.float32); shift2=rng.random((1,pairs), dtype=np.float32)
    i=(np.arange(half,dtype=np.float32)+0.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1.0)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*0.754877666+shift1,1.0); u2=np.mod(i*np.sqrt(2*j+2)*0.569840291+shift2,1.0)
    u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); angle=TWO_PI*u2
    z=np.concatenate([r*np.cos(angle),r*np.sin(angle)],1)
    if w&1: z=np.concatenate([z,rng.standard_normal((half,1), dtype=np.float32)],1)
    return z.astype(np.float32)

def sample_count(budget,w,d):
    per=d*(2*w*w+w)+w*w+16*w; fixed=9*w**3+2*(2*w**3)
    k=(int(BUDGET_FRACTION*budget)-fixed)//max(per,1); max_k=(100*1024*1024)//max(w*8,1)
    k=int(max(MIN_SAMPLES,min(1_000_000,max_k,k))); k-=k&1
    return max(MIN_SAMPLES,min(k,SAMPLE_CAP))

def current(weights, budget=272_000_000_000, seed=1, pre_c=0.0, post_c=POST):
    d=len(weights); w=weights[0].shape[0]; k=sample_count(budget,w,d)
    u=lattice(k//2,w,seed+17); x=np.concatenate([u,-u],0)
    cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6)
    invs=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(invs@weights[0]),0)
    first_var=np.sum(weights[0]*weights[0],0); true_second=0.5*first_var; true_mean=np.sqrt(first_var)*INV
    if d==1: return true_mean
    sm=x.mean(0); ss=(x*x).mean(0)
    pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second
    sv=np.maximum(ps-pm*pm,1e-12); tv=np.maximum(tps-tpm*tpm,1e-12)
    scale=np.sqrt(tv/sv); shift=tpm-scale*pm
    corr=x+FIRST*((scale-1)*x+shift)
    x=np.where(x>0,np.maximum(corr,0),0)
    gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=gram/(std[:,None]*std[None,:]); rho=np.clip(rho,-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0)); first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pre_mean=true_mean@weights[1]; projected=first_second@weights[1]; pre_second=np.sum(weights[1]*projected,0); pre_var=np.maximum(pre_second-pre_mean*pre_mean,1e-20)
    second_mean=grelu(pre_mean,pre_var)
    for li,wt in enumerate(weights[1:],1):
        if li==1 and pre_c"'!=0.0:
            pre=x@wt
            spm=pre.mean(0); sps=(pre*pre).mean(0); spv=np.maximum(sps-spm*spm,1e-12)
            sc=np.sqrt(pre_var/spv)
            target=pre_mean+sc*(pre-spm)
            pre=pre+pre_c*(target-pre)
            x=np.maximum(pre,0)
            if post_c!=0.0:
                sm=x.mean(0); x=np.maximum(x+post_c*(second_mean-sm),0)
        else:
            x=np.maximum(x@wt,0)
            if li==1 and post_c!=0.0:
                sm=x.mean(0); x=np.maximum(x+post_c*(second_mean-sm),0)
    return x.mean(0)

def target(weights,n=200000,seed=123):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; d=len(weights); s=np.zeros(w,dtype=np.float64); done=0; chunk=8192
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
        for wt in weights: x=np.maximum(x@wt,0)
        s+=x.sum(0); done+=m
    return (s/n).astype(np.float32)

for w,d,nmlp,n in [(64,16,8,300000),(128,16,5,160000),(128,32,3,120000)]:
    print('"'spec',w,d,nmlp,n, flush=True)
    scores={}
    for c in ['cur','pre025','pre05','pre1','pre05post0','pre1post0']:
        scores[c]=[]
    rng=np.random.default_rng(777)
    t0=time.time()
    for i in range(nmlp):
        weights=[(rng.standard_normal((w,w),dtype=np.float32)*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
        tgt=target(weights,n=n,seed=1000+i)
        preds={
            'cur': current(weights, seed=2000+i, pre_c=0.0, post_c=POST),
            'pre025': current(weights, seed=2000+i, pre_c=0.25, post_c=POST),
            'pre05': current(weights, seed=2000+i, pre_c=0.5, post_c=POST),
            'pre1': current(weights, seed=2000+i, pre_c=1.0, post_c=POST),
            'pre05post0': current(weights, seed=2000+i, pre_c=0.5, post_c=0.0),
            'pre1post0': current(weights, seed=2000+i, pre_c=1.0, post_c=0.0),
        }
        for k,p in preds.items(): scores[k].append(float(np.mean((p-tgt)**2)))
        print(' mlp',i,{k: f'{np.mean(v):.3e}' for k,v in scores.items()}, flush=True)
    print('done',time.time()-t0,{k: np.mean(v) for k,v in scores.items()})

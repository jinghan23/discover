import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQ=math.sqrt(2/math.pi); FIRST=.85; POST=.19

def cdf(x): x=np.clip(x,-8,8); y=SQ*(x+.044715*x*x*x); return .5*(1+np.tanh(y))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*cdf(a)
def lattice(half,w,seed):
    pairs=w//2; rng=np.random.default_rng(seed); sh1=rng.random((1,pairs),dtype=np.float32); sh2=rng.random((1,pairs),dtype=np.float32); i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*.754877666+sh1,1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+sh2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; return np.concatenate([r*np.cos(a),r*np.sin(a)],1).astype(np.float32)
def pred(weights,seed,mode='diag',strength=1.0):
    w=weights[0].shape[0]; d=len(weights); budget=272_000_000_000; per=d*(2*w*w+w)+w*w+16*w; fixed=13*w**3; k=(int(.120*budget)-fixed)//per; k=max(32,min(k,24576)); k-=k&1
    u=lattice(k//2,w,seed+17); z=np.concatenate([u,-u],0); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T; x=np.maximum(z@(inv@weights[0]),0)
    fv=np.sum(weights[0]*weights[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-sc*pm; x=np.where(x>0,np.maximum(x+FIRST*((sc-1)*x+shift),0),0)
    gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pm2=tm@weights[1]; proj=fs@weights[1]; pre_second_full=weights[1].T@proj; pv2=np.maximum(np.diag(pre_second_full)-pm2*pm2,1e-20); secm=grelu(pm2,pv2)
    for li,wt in enumerate(weights[1:],1):
        if li==1:
            pre=x@wt; spm=pre.mean(0)
            if mode=='diag':
                sps=(pre*pre).mean(0); spv=np.maximum(sps-spm*spm,1e-12); target=pm2+np.sqrt(pv2/spv)*(pre-spm)
            elif mode=='full':
                pc=pre-spm; sample_cov=(pc.T@pc)/(k-1); true_cov=pre_second_full-np.outer(pm2,pm2)
                vals_s,vec_s=np.linalg.eigh(sample_cov); vals_t,vec_t=np.linalg.eigh(true_cov); vals_s=np.maximum(vals_s,1e-6); vals_t=np.maximum(vals_t,1e-6)
                trans=(vec_s/np.sqrt(vals_s))@vec_s.T@(vec_t*np.sqrt(vals_t))@vec_t.T
                target=pm2+pc@trans
            else: target=pre
            pre=pre+strength*(target-pre); x=np.maximum(pre,0); x=np.maximum(x+POST*(secm-x.mean(0)),0)
        else: x=np.maximum(x@wt,0)
    return x.mean(0)
def target(weights,n,seed):

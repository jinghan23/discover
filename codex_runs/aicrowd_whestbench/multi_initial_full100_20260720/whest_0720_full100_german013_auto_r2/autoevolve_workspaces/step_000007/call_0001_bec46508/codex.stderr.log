    i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*.754877666+sh1,1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+sh2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2
    z=np.concatenate([r*np.cos(a),r*np.sin(a)],1)
    return z.astype(np.float32)
def pred(weights,seed,post):
    w=weights[0].shape[0]; d=len(weights); budget=272_000_000_000; per=d*(2*w*w+w)+w*w+16*w; fixed=13*w**3; k=(int(.120*budget)-fixed)//per; k=max(32,min(k,24576)); k-=k&1
    u=lattice(k//2,w,seed+17); x=np.concatenate([u,-u],0); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(inv@weights[0]),0); fv=np.sum(weights[0]*weights[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv
    sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-sc*pm; x=np.where(x>0,np.maximum(x+FIRST*((sc-1)*x+shift),0),0)
    gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pm2=tm@weights[1]; proj=fs@weights[1]; ps2=np.sum(weights[1]*proj,0); pv2=np.maximum(ps2-pm2*pm2,1e-20); secm=grelu(pm2,pv2)
    for li,wt in enumerate(weights[1:],1):
        if li==1:
            pre=x@wt; spm=pre.mean(0); sps=(pre*pre).mean(0); spv=np.maximum(sps-spm*spm,1e-12); pre=pm2+np.sqrt(pv2/spv)*(pre-spm); x=np.maximum(pre,0)
            if post: x=np.maximum(x+post*(secm-x.mean(0)),0)
        else: x=np.maximum(x@wt,0)

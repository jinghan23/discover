+        cross_cov = (centered_controls.T @ centered_outputs) / float(k - 1)
+        ridge = _CV_RIDGE * fnp.mean(fnp.diag(control_cov))
+        beta = fnp.linalg.solve(
+            control_cov + ridge * fnp.eye(width, dtype=control_cov.dtype),
+            cross_cov,
+        )
+        final_mean = fnp.maximum(
+            final_mean + _CV_STRENGTH * ((true_mean - control_mean) @ beta),
+            0.0,
+        )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)

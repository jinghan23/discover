import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQ=math.sqrt(2/math.pi); FIRST=.85; PRE=1.; POST=.19

def cdf(x): x=np.clip(x,-8,8); y=SQ*(x+.044715*x*x*x); return .5*(1+np.tanh(y))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*cdf(a)

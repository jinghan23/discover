# Quick numpy probe for second-pre correction strength on generated MLPs.
import numpy as np, math, time
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT_2_PI=math.sqrt(2/math.pi)
FIRST=0.85; POST=0.19

def cdf(x):
    x=np.clip(x,-8,8); y=SQRT_2_PI*(x+0.044715*x*x*x); return .5*(1+np.tanh(y))
def grelu(mu,var):
    s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*cdf(a)
def lattice(half,w,seed):
    pairs=w//2; rng=np.random.default_rng(seed); sh1=rng.random((1,pairs),dtype=np.float32); sh2=rng.random((1,pairs),dtype=np.float32)
    i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*.754877666+sh1,1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+sh2,1); u1=np.clip(u1,1e-7,1-1e-7)
    r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; z=np.concatenate([r*np.cos(a),r*np.sin(a)],1)
    if w&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],1)
    return z.astype(np.float32)
def pred(weights,seed,pre_c):
    w=weights[0].shape[0]; d=len(weights); budget=272_000_000_000
    per=d*(2*w*w+w)+w*w+16*w; fixed=9*w**3+2*(2*w**3); k=(int(.120*budget)-fixed)//per; k=max(32,min(k,24576)); k-=k&1
    u=lattice(k//2,w,seed+17); x=np.concatenate([u,-u],0); cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); inv=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(inv@weights[0]),0); fv=np.sum(weights[0]*weights[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv
    sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-sc*pm
    x=np.where(x>0,np.maximum(x+FIRST*((sc-1)*x+shift),0),0)
    gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pre_m=tm@weights[1]; proj=fs@weights[1]; pre_s=np.sum(weights[1]*proj,0); pre_v=np.maximum(pre_s-pre_m*pre_m,1e-20); sec_m=grelu(pre_m,pre_v)
    for li,wt in enumerate(weights[1:],1):
        if li==1:
            pre=x@wt; spm=pre.mean(0); sps=(pre*pre).mean(0); spv=np.maximum(sps-spm*spm,1e-12); sc2=np.sqrt(pre_v/spv); target=pre_m+sc2*(pre-spm); pre=pre+pre_c*(target-pre); x=np.maximum(pre,0); sm=x.mean(0); x=np.maximum(x+POST*(sec_m-sm),0)
        else: x=np.maximum(x@wt,0)
    return x.mean(0)
def target(weights,n,seed):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(8192,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
        for wt in weights: x=np.maximum(x@wt,0)
        s+=x.sum(0); done+=m
    return s/n
for w,d,nmlp,n in [(128,32,5,120000),(256,16,3,80000)]:
    rng=np.random.default_rng(999); vals={c:[] for c in [0,0.5,1,1.25,1.5,2]}; print('spec',w,d)
    for i in range(nmlp):
        weights=[(rng.standard_normal((w,w),dtype=np.float32)*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
        tgt=target(weights,n,700+i)
        for c in vals: vals[c].append(float(np.mean((pred(weights,800+i,c)-tgt)**2)))
        print(i,{c:f'{np.mean(vals[c]):.3e}' for c in vals}, flush=True)
    print('avg',{c:np.mean(vals[c]) for c in vals})

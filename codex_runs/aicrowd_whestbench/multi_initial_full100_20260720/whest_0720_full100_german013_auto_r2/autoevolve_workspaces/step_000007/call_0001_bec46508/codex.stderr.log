+                target_cov = pre_second - pre_mean[:, None] * pre_mean[None, :]
+                sample_eigenvalues, sample_eigenvectors = fnp.linalg.eigh(sample_cov)
+                target_eigenvalues, target_eigenvectors = fnp.linalg.eigh(target_cov)
+                sample_eigenvalues = fnp.maximum(sample_eigenvalues, _COV_EPS)
+                target_eigenvalues = fnp.maximum(target_eigenvalues, _COV_EPS)
+                sample_inverse_sqrt = (
+                    sample_eigenvectors / fnp.sqrt(sample_eigenvalues)
+                ) @ sample_eigenvectors.T
+                target_sqrt = (
+                    target_eigenvectors * fnp.sqrt(target_eigenvalues)
+                ) @ target_eigenvectors.T
+                target_pre = pre_mean + centered_pre @ (sample_inverse_sqrt @ target_sqrt)
+                pre = pre + _SECOND_PRE_CORRECTION * (target_pre - pre)
+                x = fnp.maximum(pre, 0.0)
                 sample_mean = fnp.mean(x, axis=0)
                 x = fnp.maximum(
                     x + _SECOND_MEAN_CORRECTION * (second_layer_mean - sample_mean),
                     0.0,
                 )
+            else:
+                x = fnp.maximum(x @ weight, 0.0)
 
         final_mean = fnp.mean(x, axis=0)
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)

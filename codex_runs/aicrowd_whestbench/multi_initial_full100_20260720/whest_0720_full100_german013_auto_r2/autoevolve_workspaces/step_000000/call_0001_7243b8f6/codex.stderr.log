import numpy as np, math

INV_SQRT_2PI=1/np.sqrt(2*np.pi)
_erf=np.vectorize(math.erf)
def Phi(a): return 0.5*(1+_erf(a/np.sqrt(2)))
def relu_norm(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
    p=Phi(a); pdf=INV_SQRT_2PI*np.exp(-.5*a*a)
    return sig*pdf+mu*p

def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig
    p=Phi(a); pdf=INV_SQRT_2PI*np.exp(-.5*a*a)
    return sig*pdf+mu*p, (var+mu*mu)*p+mu*sig*pdf

def gen_weights(w,d,seed,scale):
    rng=np.random.default_rng(seed)
    s=np.sqrt(2/w) if scale=='he' else 1/np.sqrt(w)
    return [rng.standard_normal((w,w), dtype=np.float32)*s for _ in range(d)]

def forward_mean(W, X):
    x=X
    for weight in W:
        x=np.maximum(x@weight,0)
    return x.mean(0)

def whitened_samples(k,w,seed):
    rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w), dtype=np.float32)
    cov=(u.T@u)/(k//2)
    vals,vecs=np.linalg.eigh(cov)
    inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T
    x=np.concatenate([u,-u],0)
    return x, inv

def cand_current(W,k,seed):
    x,inv=whitened_samples(k,W[0].shape[0],seed)
    x=np.maximum(x@(inv@W[0]),0)
    for weight in W[1:]: x=np.maximum(x@weight,0)
    return x.mean(0)

def cand_final_gauss(W,k,seed,mix=0):
    x,inv=whitened_samples(k,W[0].shape[0],seed)
    x=np.maximum(x@(inv@W[0]),0)
    for weight in W[1:-1]: x=np.maximum(x@weight,0)
    z=x@W[-1]
    s=np.maximum(z,0).mean(0)
    g=relu_norm(z.mean(0),(z*z).mean(0)-z.mean(0)**2)
    return (1-mix)*s+mix*g

def cand_first_scale(W,k,seed,mode='mean'):
    x,inv=whitened_samples(k,W[0].shape[0],seed)
    z=x@(inv@W[0])
    x=np.maximum(z,0)
    diag=np.sum(W[0]*W[0],axis=0)
    exact_mean=np.sqrt(diag)*INV_SQRT_2PI
    exact_second=0.5*diag
    if mode=='mean':
        sm=x.mean(0); x=x*(exact_mean/np.maximum(sm,1e-12))
    elif mode=='second':
        ss=(x*x).mean(0); x=x*np.sqrt(exact_second/np.maximum(ss,1e-12))
    elif mode=='affine':
        sm=x.mean(0); sv=np.maximum((x*x).mean(0)-sm*sm,1e-12)
        ev=np.maximum(exact_second-exact_mean*exact_mean,1e-12)
        x=(x-sm)/np.sqrt(sv)*np.sqrt(ev)+exact_mean
    for weight in W[1:]: x=np.maximum(x@weight,0)
    return x.mean(0)

def cand_layer_scale(W,k,seed):
    w=W[0].shape[0]
    mean=np.zeros(w); second=np.ones(w)
    x,inv=whitened_samples(k,w,seed)
    for li,weight in enumerate(W):
        centered=np.maximum(second-mean*mean,0)
        pre_mean=mean@weight
        pre_var=centered@(weight*weight)
        ex_mean, ex_second=relu_mom(pre_mean,pre_var)
        z=x@((inv@weight) if li==0 else weight)
        x=np.maximum(z,0)
        sm=x.mean(0)
        x=x*(ex_mean/np.maximum(sm,1e-12))
        mean=ex_mean; second=ex_second
    return x.mean(0)

for scale in ['he','xavier']:
  print('scale',scale)
  names=['cur','fg01','fg025','fg05','fg1','fsmean','fssecond','fsaffine','layerscale']
  mses={name:[] for name in names}
  for seed in range(20):
    w=64; d=16; k=2048; kt=100000
    W=gen_weights(w,d,seed, scale)
    rng=np.random.default_rng(1000+seed); Xt=rng.standard_normal((kt,w), dtype=np.float32)
    target=forward_mean(W,Xt)
    preds={
      'cur': cand_current(W,k,2000+seed),
      'fg01': cand_final_gauss(W,k,2000+seed,0.1),
      'fg025': cand_final_gauss(W,k,2000+seed,0.25),
      'fg05': cand_final_gauss(W,k,2000+seed,0.5),
      'fg1': cand_final_gauss(W,k,2000+seed,1.0),
      'fsmean': cand_first_scale(W,k,2000+seed,'mean'),
      'fssecond': cand_first_scale(W,k,2000+seed,'second'),
      'fsaffine': cand_first_scale(W,k,2000+seed,'affine'),
      'layerscale': cand_layer_scale(W,k,2000+seed),
    }
    for name,p in preds.items(): mses[name].append(np.mean((p-target)**2))
  base=np.mean(mses['cur'])
  for name in names: print(name, np.mean(mses[name]), 'rel',np.mean(mses[name])/base)

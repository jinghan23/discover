/bin/bash -lc "python - <<'PY'
import numpy as np, math

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def sphwhite(W,k,seed,scale):
 w=W[0].shape[0]; rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w),dtype=np.float32); d=u/np.sqrt((u*u).sum(1,keepdims=True)); x=np.concatenate([d,-d]); cov=(d.T@d)/(k//2); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,x@(inv*scale))
for wid in [64,256]:
 print('w',wid)
 scales=[0.995,0.9975,0.999,1.0,1.001,1.0025]
 ms={s:[] for s in scales}
 for seed in range(20 if wid==64 else 5):
  w=wid; d=32; k=2048 if wid==64 else 4096; kt=100000 if wid==64 else 30000
  W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
  for s in scales:
   p=sphwhite(W,k,2000+seed,s); ms[s].append(np.mean((p-target)**2))
 base=min(np.mean(v) for v in ms.values())
 for s in scales: print(s,np.mean(ms[s]),np.mean(ms[s])/base)

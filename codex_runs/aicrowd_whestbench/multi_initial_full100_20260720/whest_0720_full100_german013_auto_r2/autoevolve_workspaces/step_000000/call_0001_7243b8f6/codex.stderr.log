/bin/bash -lc "python - <<'PY'
import numpy as np

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def qmc(k,w,seed):
 n=k//2; rng=np.random.default_rng(seed); i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 s1=rng.random((1,w//2)); s2=rng.random((1,w//2))
 u1=(i*np.sqrt(2*j+1)*0.754877666+s1)%1; u2=(i*np.sqrt(2*j+2)*0.569840291+s2)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 z=np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
 return z
def rand(k,w,seed): return np.random.default_rng(seed).standard_normal((k//2,w),dtype=np.float32)
def est(W,k,seed,kind):
 w=W[0].shape[0]; u=qmc(k,w,seed) if kind=='qmc' else rand(k,w,seed)

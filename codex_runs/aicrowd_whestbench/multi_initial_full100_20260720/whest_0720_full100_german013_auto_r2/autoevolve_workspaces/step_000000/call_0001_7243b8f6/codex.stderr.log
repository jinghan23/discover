/bin/bash -lc "python - <<'PY'
import numpy as np, math

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def primes(n):
 ps=[]; x=2
 while len(ps)<n:
  ok=True
  for p in ps:
   if p*p>x: break
   if x%p==0: ok=False; break
  if ok: ps.append(x)
  x+=1
 return np.array(ps)
P=primes(512)
def make_u(n,w,seed,kind):
 rng=np.random.default_rng(seed); p=w//2; i=np.arange(n,dtype=np.float64)[:,None]
 shift=rng.random((2,p))
 if kind.startswith('sqrt'):
  # sqrtA_B: current-like with multipliers
  if kind=='sqrt_cur': a,b=.754877666,.569840291
  elif kind=='sqrt_golden': a,b=.61803398875,.41421356237
  elif kind=='sqrt_one': a,b=1.0,1.0
  elif kind=='sqrt_pi': a,b=.318309886,.367879441
  j=np.arange(p,dtype=np.float64)[None,:]+1
  u1=((i+0.5)*np.sqrt(2*j+1)*a+shift[0])%1
  u2=((i+0.5)*np.sqrt(2*j+2)*b+shift[1])%1
 elif kind.startswith('kor'):
  base=int(kind[3:]); mod=n
  g=[]; v=1
  for jj in range(2*p):
   g.append(v); v=(v*base)%mod
   if v%2==0: v=(v+1)%mod
  g=np.array(g,dtype=np.float64).reshape(2,p)
  u1=((i*g[0])%mod)/mod+shift[0]; u1%=1
  u2=((i*g[1])%mod)/mod+shift[1]; u2%=1
 elif kind=='odd':
  g=(2*np.arange(2*p)+1).astype(float).reshape(2,p)
  u1=((i*g[0])%n)/n+shift[0]; u1%=1
  u2=((i*g[1])%n)/n+shift[1]; u2%=1
 elif kind=='prime':
  g=P[:2*p].astype(float).reshape(2,p); g+=(g%2==0)
  u1=((i*g[0])%n)/n+shift[0]; u1%=1
  u2=((i*g[1])%n)/n+shift[1]; u2%=1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est(W,k,seed,kind):
 w=W[0].shape[0]; u=make_u(k//2,w,seed,kind); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,np.concatenate([u,-u])@inv)
kinds=['sqrt_cur','sqrt_golden','sqrt_one','sqrt_pi','odd','prime','kor3','kor5','kor13','kor17','kor41','kor73']
for d in [32]:
 print('d',d)
 ms={kind:[] for kind in kinds}
 for seed in range(25):
  w=64;k=2048;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
  for kind in kinds:
   p=est(W,k,2000+seed,kind); ms[kind].append(np.mean((p-target)**2))
 base=np.mean(ms['sqrt_cur'])
 for kind in sorted(kinds, key=lambda k:np.mean(ms[k])):
  print(kind,np.mean(ms[kind]),np.mean(ms[kind])/base)
PY" in /opt/tiger/discover/workspace

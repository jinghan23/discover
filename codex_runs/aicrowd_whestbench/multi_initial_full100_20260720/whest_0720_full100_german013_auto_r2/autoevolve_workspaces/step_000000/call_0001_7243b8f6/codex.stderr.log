+    variance = fnp.maximum(variance, _EPS)
+    sigma = fnp.sqrt(variance)
+    alpha = mean / sigma
+    return sigma * _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha) + mean * _normal_cdf(alpha)
 

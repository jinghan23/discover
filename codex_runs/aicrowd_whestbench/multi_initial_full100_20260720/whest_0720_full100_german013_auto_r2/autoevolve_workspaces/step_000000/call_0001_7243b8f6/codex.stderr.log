/bin/bash -lc "python - <<'PY'
import numpy as np

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def qmc(k,w):
 n=k//2; i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 u1=(i*np.sqrt(2*j+1)*.754877666+.5)%1; u2=(i*np.sqrt(2*j+2)*.569840291+.5)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est(W,k):
 w=W[0].shape[0]; u=qmc(k,w); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,np.concatenate([u,-u])@inv)
ks=[6144,8192,10240,12288,14336,16384]
ms={k:[] for k in ks}
for seed in range(16):
 w=64;d=32;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
 for k in ks: ms[k].append(np.mean((est(W,k)-target)**2))
# score proxy at multiplier proportional k with floor based on 8192=.13; floor .1 -> k floor ~6302
for k in ks:
 m=np.mean(ms[k]); mult=max(.1,.13*k/8192); print(k,m,'mse_rel',m/np.mean(ms[8192]),'score_rel',m*mult/(np.mean(ms[8192])*.13))
PY" in /opt/tiger/discover/workspace

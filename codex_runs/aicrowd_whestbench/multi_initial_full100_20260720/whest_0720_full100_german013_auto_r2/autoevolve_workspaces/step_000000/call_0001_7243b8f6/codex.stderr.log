import numpy as np

def gen_weights(w,d,seed,scale='he'):
    rng=np.random.default_rng(seed); s=np.sqrt(2/w)
    return [rng.standard_normal((w,w), dtype=np.float32)*s for _ in range(d)]

def forward_mean(W,X):
    x=X
    for weight in W: x=np.maximum(x@weight,0)
    return x.mean(0)

def cand_chunk(W,k,seed,batches):
    rng=np.random.default_rng(seed); w=W[0].shape[0]; outs=[]; sizes=[]
    half_total=k//2; base=half_total//batches
    for b in range(batches):
        h=base if b<batches-1 else half_total-base*(batches-1)
        u=rng.standard_normal((h,w), dtype=np.float32)
        cov=(u.T@u)/h
        vals,vecs=np.linalg.eigh(cov)
        inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T
        x=np.concatenate([u,-u],0)
        x=np.maximum(x@(inv@W[0]),0)
        for weight in W[1:]: x=np.maximum(x@weight,0)
        outs.append(x.mean(0)); sizes.append(2*h)
    return sum(o*s for o,s in zip(outs,sizes))/sum(sizes)

for d in [16,32]:
  print('d',d)
  names=[1,2,4,8,16]
  ms={b:[] for b in names}
  for seed in range(20):
    w=64; k=2048; kt=100000
    W=gen_weights(w,d,seed)
    target=forward_mean(W,np.random.default_rng(1000+seed).standard_normal((kt,w), dtype=np.float32))
    for b in names:
      if k//2//b > w+2:
        p=cand_chunk(W,k,2000+seed,b); ms[b].append(np.mean((p-target)**2))
  base=np.mean(ms[1])
  for b in names:
    if ms[b]: print(b, np.mean(ms[b]), np.mean(ms[b])/base)

codex
The network has no biases, so it is positively homogeneous in the input. I’m testing spherical sampling locally: integrate the Gaussian radial component analytically and Monte Carlo only over directions, which can reduce variance without using target data.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math

def gen_weights(w,d,seed):
    rng=np.random.default_rng(seed); s=np.sqrt(2/w)
    return [rng.standard_normal((w,w), dtype=np.float32)*s for _ in range(d)]

def fmean(W,x):
    for weight in W: x=np.maximum(x@weight,0)
    return x.mean(0)

def current(W,k,seed):
    w=W[0].shape[0]; rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w), dtype=np.float32)
    vals,vecs=np.linalg.eigh((u.T@u)/(k//2))
    inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T
    x=np.concatenate([u,-u])
    return fmean(W,x@inv)

def spherical(W,k,seed,whiten=False,scale='mean'):
    w=W[0].shape[0]; rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w), dtype=np.float32)
    d=u/np.sqrt(np.sum(u*u,axis=1,keepdims=True))
    x=np.concatenate([d,-d])
    if whiten:
        vals,vecs=np.linalg.eigh((x.T@x)/k)
        x=x@((vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T)
        # after whitening covariance I, effective radius sqrt(w); optionally scale to mean chi
        if scale=='mean': x*= (math.sqrt(w)*(1-1/(4*w)+1/(32*w*w)))/math.sqrt(w)
    else:
        r=math.sqrt(w)*(1-1/(4*w)+1/(32*w*w)) if scale=='mean' else math.sqrt(w)
        x=x*r
    return fmean(W,x)

for d in [8,16,32]:
  print('d',d)
  names=['cur','sph','sphsqrt','sphwhite']
  ms={n:[] for n in names}
  for seed in range(50):
    w=64;k=2048;kt=200000
    W=gen_weights(w,d,seed)
    target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w), dtype=np.float32))
    preds={
      'cur':current(W,k,2000+seed),
      'sph':spherical(W,k,2000+seed,False,'mean'),
      'sphsqrt':spherical(W,k,2000+seed,False,'sqrt'),
      'sphwhite':spherical(W,k,2000+seed,True,'mean'),
    }
    for n,p in preds.items(): ms[n].append(np.mean((p-target)**2))
  base=np.mean(ms['cur'])
  for n in names: print(n,np.mean(ms[n]),np.mean(ms[n])/base)

import numpy as np

def ndtri(p):
    # Acklam approximation
    a=[-3.969683028665376e+01,2.209460984245205e+02,-2.759285104469687e+02,1.383577518672690e+02,-3.066479806614716e+01,2.506628277459239e+00]
    b=[-5.447609879822406e+01,1.615858368580409e+02,-1.556989798598866e+02,6.680131188771972e+01,-1.328068155288572e+01]
    c=[-7.784894002430293e-03,-3.223964580411365e-01,-2.400758277161838e+00,-2.549732539343734e+00,4.374664141464968e+00,2.938163982698783e+00]
    d=[7.784695709041462e-03,3.224671290700398e-01,2.445134137142996e+00,3.754408661907416e+00]
    plow=0.02425; phigh=1-plow
    x=np.empty_like(p)
    mask=p<plow; q=np.sqrt(-2*np.log(p[mask])); x[mask]=(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    mask2=(p>=plow)&(p<=phigh); q=p[mask2]-0.5; r=q*q; x[mask2]=(((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q/(((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)
    mask=p>phigh; q=np.sqrt(-2*np.log(1-p[mask])); x[mask]=-(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5])/((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    return x

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def invqmc(k,w,kind):
 n=k//2; i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w)+1.0)[None,:]
 if kind=='sqrtcur': u=(i*np.sqrt(j+1)*.754877666+.5)%1
 elif kind=='sqrtpi': u=(i*np.sqrt(j+1)*.318309886+.5)%1
 elif kind=='gold': u=(i*np.sqrt(j+1)*.61803398875+.5)%1
 elif kind=='kor5':
  val=1; gs=[]
  for _ in range(w): gs.append(val); val=(val*5)%n
  g=np.array(gs)[None,:]; u=(((np.arange(n)[:,None]*g)%n)/n+.5)%1
 u=np.clip(u,1e-7,1-1e-7); return ndtri(u).astype(np.float32)
def box(k,w):
 n=k//2; i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 u1=(i*np.sqrt(2*j+1)*.754877666+.5)%1; u2=(i*np.sqrt(2*j+2)*.569840291+.5)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est(W,k,kind):
 w=W[0].shape[0]; u=box(k,w) if kind=='box' else invqmc(k,w,kind); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,np.concatenate([u,-u])@inv)
kinds=['box','sqrtcur','sqrtpi','gold','kor5']
ms={k:[] for k in kinds}
for seed in range(20):
 w=64;d=32;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
 for k in kinds: ms[k].append(np.mean((est(W,8192,k)-target)**2))
base=np.mean(ms['box'])
for k in sorted(kinds,key=lambda x:np.mean(ms[x])): print(k,np.mean(ms[k]),np.mean(ms[k])/base)

/bin/bash -lc "python - <<'PY'
import numpy as np

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def qmc_half(n,w,s1):
 i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 u1=(i*np.sqrt(2*j+1)*.754877666+s1)%1; u2=(i*np.sqrt(2*j+2)*.569840291+.5)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est_one(W,k,s1):
 w=W[0].shape[0]; u=qmc_half(k//2,w,s1); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,np.concatenate([u,-u])@inv)
def est_split(W,k,shifts):
 outs=[]
 for s in shifts: outs.append(est_one(W,k//len(shifts),s))
 return sum(outs)/len(outs)
configs={'one05':lambda W:est_one(W,8192,.5),'one025':lambda W:est_one(W,8192,.25),'split025075':lambda W:est_split(W,8192,[.25,.75]),'split05075':lambda W:est_split(W,8192,[.5,.75]),'split0005':lambda W:est_split(W,8192,[0,.5]),'split4':lambda W:est_split(W,8192,[0,.25,.5,.75])}
ms={c:[] for c in configs}
for seed in range(20):
 w=64;d=32;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
 for c,fn in configs.items(): ms[c].append(np.mean((fn(W)-target)**2))
base=np.mean(ms['one05'])
for c in sorted(configs,key=lambda x:np.mean(ms[x])): print(c,np.mean(ms[c]),np.mean(ms[c])/base)

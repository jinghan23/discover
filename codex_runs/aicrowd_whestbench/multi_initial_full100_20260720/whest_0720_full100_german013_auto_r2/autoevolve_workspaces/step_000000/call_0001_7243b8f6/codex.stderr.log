/bin/bash -lc "python - <<'PY'
import numpy as np

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def qmc(k,w,seed,shiftmode):
 n=k//2; rng=np.random.default_rng(seed); i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 if shiftmode=='rand': s1=rng.random((1,w//2)); s2=rng.random((1,w//2))
 elif shiftmode=='zero': s1=0.; s2=0.
 elif shiftmode=='half': s1=.5; s2=.5
 elif shiftmode=='scalar':
  s=rng.random(); s1=s; s2=(s+0.381966011)%1
 u1=(i*np.sqrt(2*j+1)*.754877666+s1)%1; u2=(i*np.sqrt(2*j+2)*.569840291+s2)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est(W,k,seed,mode):
 w=W[0].shape[0]; u=qmc(k,w,seed,mode); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; return fmean(W,np.concatenate([u,-u])@inv)
for k in [2048,8192]:
 print('k',k)
 modes=['rand','zero','half','scalar']
 ms={m:[] for m in modes}
 for seed in range(20):
  w=64;d=32;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
  for m in modes: ms[m].append(np.mean((est(W,k,2000+seed,m)-target)**2))
 base=np.mean(ms['rand'])
 for m in modes: print(m,np.mean(ms[m]),np.mean(ms[m])/base)

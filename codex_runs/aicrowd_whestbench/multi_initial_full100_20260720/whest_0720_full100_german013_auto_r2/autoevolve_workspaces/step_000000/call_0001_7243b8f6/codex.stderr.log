import numpy as np, math
INV=1/np.sqrt(2*np.pi); erf=np.vectorize(math.erf)
def Phi(x): return .5*(1+erf(x/np.sqrt(2)))
def relu_norm(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; return sig*INV*np.exp(-.5*a*a)+mu*Phi(a)
def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def qmc(k,w):
 n=k//2; i=(np.arange(n)+0.5)[:,None]; j=(np.arange(w//2)+1.0)[None,:]
 u1=(i*np.sqrt(2*j+1)*.754877666+.5)%1; u2=(i*np.sqrt(2*j+2)*.569840291+.5)%1
 u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); th=2*np.pi*u2
 return np.concatenate([r*np.cos(th),r*np.sin(th)],1).astype(np.float32)
def est(W,k,mix):
 w=W[0].shape[0]; u=qmc(k,w); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; x=np.concatenate([u,-u])@(inv)
 for weight in W[:-1]: x=np.maximum(x@weight,0)
 z=x@W[-1]
 s=np.maximum(z,0).mean(0); g=relu_norm(z.mean(0),(z*z).mean(0)-z.mean(0)**2)
 return (1-mix)*s+mix*g
mixes=[0,.025,.05,.1,.2]
ms={m:[] for m in mixes}
for seed in range(20):
 w=64;d=32;kt=150000;W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
 for m in mixes: ms[m].append(np.mean((est(W,8192,m)-target)**2))
base=np.mean(ms[0])
for m in mixes: print(m,np.mean(ms[m]),np.mean(ms[m])/base)

/bin/bash -lc "python - <<'PY'
import numpy as np, math

def gen_weights(w,d,seed):
 r=np.random.default_rng(seed); return [r.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w) for _ in range(d)]
def fmean(W,x):
 for weight in W: x=np.maximum(x@weight,0)
 return x.mean(0)
def current_samples(k,w,seed):
 rng=np.random.default_rng(seed); u=rng.standard_normal((k//2,w),dtype=np.float32); return u
def qmc_samples(k,w,seed):
 n=k//2; rng=np.random.default_rng(seed)
 i=(np.arange(n,dtype=np.float64)+0.5)[:,None]
 j=(np.arange(w//2,dtype=np.float64)+1.0)[None,:]
 # Kronecker constants; random Cranley shifts
 s1=rng.random((1,w//2)); s2=rng.random((1,w//2))
 u1=(i*np.sqrt(j*2.0+1.0)*0.754877666 + s1) % 1.0
 u2=(i*np.sqrt(j*2.0+2.0)*0.569840291 + s2) % 1.0
 u1=np.clip(u1,1e-7,1-1e-7)
 r=np.sqrt(-2*np.log(u1)); theta=2*np.pi*u2
 z=np.empty((n,w),dtype=np.float32); z[:,0::2]=(r*np.cos(theta)).astype(np.float32); z[:,1::2]=(r*np.sin(theta)).astype(np.float32)
 return z
def estimate(W,k,seed,kind,whiten=True):
 w=W[0].shape[0]; u=current_samples(k,w,seed) if kind=='rand' else qmc_samples(k,w,seed)
 if whiten:
  vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T
 else: inv=np.eye(w)
 x=np.concatenate([u,-u])@inv
 return fmean(W,x)
for d in [16,32]:
 print('d',d)
 names=['randw','qmcw','rand','qmc']
 ms={n:[] for n in names}
 for seed in range(30):
  w=64;k=2048;kt=150000
  W=gen_weights(w,d,seed); target=fmean(W,np.random.default_rng(1000+seed).standard_normal((kt,w),dtype=np.float32))
  for kind,wh,nm in [('rand',True,'randw'),('qmc',True,'qmcw'),('rand',False,'rand'),('qmc',False,'qmc')]:
   p=estimate(W,k,2000+seed,kind,wh); ms[nm].append(np.mean((p-target)**2))
 base=np.mean(ms['randw'])
 for n in names: print(n,np.mean(ms[n]),np.mean(ms[n])/base)

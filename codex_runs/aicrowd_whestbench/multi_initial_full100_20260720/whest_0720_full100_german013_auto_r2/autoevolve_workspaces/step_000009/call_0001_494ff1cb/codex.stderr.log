codex
Sphere-direction official score is `2.576544e-07`, a small regression. I’m not discarding it immediately because it is close; I’m checking whether its correction constants need different tuning before reverting.
exec
/bin/bash -lc "python - <<'PY'
# Compact synthetic tuning for the sphere-direction variant.
import numpy as np, math
INV=.3989422804014327; SQ=.7978845608028654; PI=np.pi; TWO=2*np.pi

def ncdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQ*(x+.044715*x*x*x)))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*ncdf(a)
def rad(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def lat(h,w,seed):
 rng=np.random.default_rng(seed); p=w//2; i=(np.arange(h,dtype=np.float32)+.5)[:,None]; j=(np.arange(p,dtype=np.float32)+1)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,p),dtype=np.float32),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,p),dtype=np.float32),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); z=np.concatenate([r*np.cos(TWO*u2),r*np.sin(TWO*u2)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((h,1),dtype=np.float32)],1)
 return z
def est(weights,seed,k,c1=1.55,c2=1.2,cm=.3):
 w=weights[0].shape[0]; u=lat(k//2,w,seed+17); cov=u.T@u/(k//2); vals,vecs=np.linalg.eigh(cov); z=u@((vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T); z=z/np.sqrt(np.maximum(np.sum(z*z,1,keepdims=True),1e-20)); x=np.concatenate([z,-z],0); rm=rad(w); x=np.maximum(x@weights[0],0)
 fv=np.sum(weights[0]*weights[0],0); ts=.5*fv/w; tm=np.sqrt(fv)*INV/rm; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm; x=np.where(x>0,np.maximum(x+c1*((scale-1)*x+shift),0),0)
 gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/(TWO*w)

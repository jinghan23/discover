/bin/bash -lc "python - <<'PY'
import numpy as np
INV=.3989422804014327; SQ=.7978845608028654; PI=np.pi; TWO=2*np.pi

def ncdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQ*(x+.044715*x*x*x)))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*ncdf(a)
def lat(h,w,seed):
 rng=np.random.default_rng(seed); p=w//2; i=(np.arange(h,dtype=np.float32)+.5)[:,None]; j=(np.arange(p,dtype=np.float32)+1)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,p),dtype=np.float32),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,p),dtype=np.float32),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); z=np.concatenate([r*np.cos(TWO*u2),r*np.sin(TWO*u2)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((h,1),dtype=np.float32)],1)
 return z
def est(weights,seed,k,clip=False,cm=.3):
 w=weights[0].shape[0]; u=lat(k//2,w,seed+17); x=np.concatenate([u,-u],0); cov=u.T@u/(k//2); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; x=np.maximum(x@(inv@weights[0]),0); fv=np.sum(weights[0]*weights[0],0); ts=.5*fv; tm=np.sqrt(fv)*INV; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm; x=np.where(x>0,np.maximum(x+1.55*((scale-1)*x+shift),0),0); gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO; pre_mean=tm@weights[1]; proj=fs@weights[1]; pre_second=np.sum(weights[1]*proj,0); pre_var=np.maximum(pre_second-pre_mean*pre_mean,1e-20); slm=grelu(pre_mean,pre_var)
 for li,W in enumerate(weights[1:],1):
  if li==1:
   pre=x@W; spm=pre.mean(0); spv=np.maximum((pre*pre).mean(0)-spm*spm,1e-12); scl=np.sqrt(pre_var/spv); pre=pre+1.2*((pre_mean+scl*(pre-spm))-pre); x=np.maximum(pre,0); y=x+cm*(slm-x.mean(0)); x=np.maximum(y,0) if clip else y
  else: x=np.maximum(x@W,0)
 return x.mean(0)
def target(weights,n=150000,seed=999):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; acc=np.zeros(w); c=0; bs=10000
 for _ in range(n//bs):
  x=rng.standard_normal((bs,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  acc+=x.mean(0); c+=1
 return acc/c
for cm in [.1,.2,.3,.4,.6]:
 ratios=[]
 for w,d,k in [(32,5,4096),(64,6,4096),(64,8,8192),(128,6,4096),(128,8,8192)]:
  for seed in range(4):
   rng=np.random.default_rng(8000+w*7+d*29+seed); weights=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]; tgt=target(weights,120000,seed+22); b=est(weights,seed,k,False,.3); p=est(weights,seed,k,True,cm); ratios.append(np.mean((p-tgt)**2)/np.mean((b-tgt)**2))
 print('clip cm',cm,np.mean(ratios),np.median(ratios))

codex
I’m testing a different variance-reduction idea locally: integrate out the Gaussian radius analytically and sample only directions on the unit sphere. Because the no-bias ReLU MLP is positively homogeneous of degree 1, the final mean is `E[R]` times the directional mean.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
INV=.3989422804014327; SQ=.7978845608028654; PI=np.pi; TWO=2*np.pi

def ncdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQ*(x+.044715*x*x*x)))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*ncdf(a)
def radial_mean(w): return math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
def lat(half,w,seed):
 rng=np.random.default_rng(seed); pairs=w//2; i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,pairs),dtype=np.float32),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,pairs),dtype=np.float32),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); z=np.concatenate([r*np.cos(TWO*u2),r*np.sin(TWO*u2)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],1)
 return z
def est(weights,seed,k,sphere=False,whiten=True,corr=True):
 w=weights[0].shape[0]; d=len(weights); u=lat(k//2,w,seed+17)
 if whiten:
  cov=u.T@u/(k//2); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; z=u@inv
 else: z=u
 if sphere:
  z=z/np.sqrt(np.sum(z*z,1,keepdims=True))
 x=np.concatenate([z,-z],0); rad=radial_mean(w) if sphere else 1.0; second_rad=w if sphere else 1.0
 x=np.maximum(x@weights[0],0)
 fv=np.sum(weights[0]*weights[0],0); true_second=.5*fv/second_rad; true_mean=np.sqrt(fv)*INV/rad
 if corr:
  sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second; scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm; x=np.where(x>0,np.maximum(x+1.55*((scale-1)*x+shift),0),0)
 gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO/second_rad
 pre_mean=true_mean@weights[1]; proj=fs@weights[1]; pre_second=np.sum(weights[1]*proj,0); pre_var=np.maximum(pre_second-pre_mean*pre_mean,1e-20); slm=grelu(pre_mean,pre_var)
 for li,W in enumerate(weights[1:],1):
  if li==1 and corr:
   pre=x@W; spm=pre.mean(0); spv=np.maximum((pre*pre).mean(0)-spm*spm,1e-12); scl=np.sqrt(pre_var/spv); pre=pre+1.2*((pre_mean+scl*(pre-spm))-pre); x=np.maximum(pre,0); x=x+.3*(slm-x.mean(0))
  elif li==1:
   x=np.maximum(x@W,0)
  else:
   x=np.maximum(x@W,0)
 return rad*x.mean(0)
def target(weights,n=200000,seed=999):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; acc=np.zeros(w); bs=10000; c=0
 for _ in range(n//bs):
  x=rng.standard_normal((bs,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  acc+=x.mean(0); c+=1
 return acc/c
configs=[('base',False,True,True),('sphere_w_corr',True,True,True),('sphere_raw_corr',True,False,True),('sphere_w_nocorr',True,True,False),('gauss_raw_corr',False,False,True)]
res={c[0]:[] for c in configs}
for w,d,k in [(16,5,4096),(32,5,4096),(64,6,4096),(64,8,8192),(128,6,4096),(128,8,8192),(256,6,2048)]:
 for seed in range(4):
  rng=np.random.default_rng(5000+w*7+d*19+seed); weights=[rng.standard_normal((w,w)).astype(np.float32)*np.sqrt(2/w) for _ in range(d)]; tgt=target(weights,150000,seed+121)

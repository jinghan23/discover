import numpy as np
INV=.3989422804014327; SQ=.7978845608028654; PI=np.pi; TWO=2*np.pi

def ncdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQ*(x+.044715*x*x*x)))
def grelu(mu,var): s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); return s*INV*np.exp(-.5*a*a)+mu*ncdf(a)
def lat(half,w,seed):
 rng=np.random.default_rng(seed); pairs=w//2; i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,pairs),dtype=np.float32),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,pairs),dtype=np.float32),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); z=np.concatenate([r*np.cos(TWO*u2),r*np.sin(TWO*u2)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],1)
 return z
def est(weights,seed,k,full=0.0):
 w=weights[0].shape[0]; d=len(weights); u=lat(k//2,w,seed+17); x=np.concatenate([u,-u],0); cov=u.T@u/(k//2); vals,vecs=np.linalg.eigh(cov); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; x=np.maximum(x@(inv@weights[0]),0)
 fv=np.sum(weights[0]*weights[0],0); ts=.5*fv; tm=np.sqrt(fv)*INV; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm; x=np.where(x>0,np.maximum(x+1.55*((scale-1)*x+shift),0),0)
 gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO
 pre_mean=tm@weights[1]; pre_second_mat=weights[1].T@fs@weights[1]; pre_cov=pre_second_mat-np.outer(pre_mean,pre_mean); pre_var=np.maximum(np.diag(pre_cov),1e-20); slm=grelu(pre_mean,pre_var)
 for li,W in enumerate(weights[1:],1):
  if li==1:
   pre=x@W; spm=pre.mean(0)
   if full:
    cen=pre-spm; scov=cen.T@cen/k; se,sv=np.linalg.eigh(scov); te,tv=np.linalg.eigh((pre_cov+pre_cov.T)*0.5); se=np.maximum(se,1e-8); te=np.maximum(te,1e-10); sinv=(sv/np.sqrt(se))@sv.T; tsqrt=(tv*np.sqrt(te))@tv.T; target=pre_mean+cen@(sinv@tsqrt); pre=pre+full*(target-pre)
   else:
    spv=np.maximum((pre*pre).mean(0)-spm*spm,1e-12); scl=np.sqrt(pre_var/spv); target=pre_mean+scl*(pre-spm); pre=pre+1.2*(target-pre)
   x=np.maximum(pre,0); x=x+.3*(slm-x.mean(0))
  else: x=np.maximum(x@W,0)
 return x.mean(0)
def target(weights,n=200000,seed=999):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; acc=np.zeros(w); bs=10000; c=0
 for _ in range(n//bs):
  x=rng.standard_normal((bs,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)

        target=sample_layer_statistics(mlp,gt,fnp.random.default_rng(2000+i))[1]
        print(' target',i,'time',time.time()-t0)
        for name,e in ests:
            with flops.BudgetContext(flop_budget=B, quiet=True) as bc:
                pred=e.predict(mlp,B)[-1]
            mse=float(fnp.mean((pred-target)**2))
            mult=max(0.1,(bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0))/B)
            ms[name].append(mse); adj[name].append(mse*mult)
            print(name,'mse',mse,'flops',bc.flops_used,'u',(bc.flops_used/B), 'mult',mult)
    for name,_ in ests:
        print('AVG',name,'mse',sum(ms[name])/len(ms[name]),'adj',sum(adj[name])/len(adj[name]))

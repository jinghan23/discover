The split form is mathematically equivalent to the previous correction when the two constants match. I’m screening a small grid locally to see whether mean or scale should move independently.
exec
/bin/bash -lc "python - <<'PY'
import itertools
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

def budget_for_cap(w,d,k=24576,frac=0.115):
    return int((k*(d*(2*w*w+w)+w*w+16*w)+13*w**3)/frac)

def run(w,d,gt,nm,seed):
    B=budget_for_cap(w,d)
    rng=fnp.random.default_rng(seed)
    mlps=[]; targets=[]
    for i in range(nm):
        mlp=sample_mlp(w,d,rng,seed=50000+seed+i)
        target=sample_layer_statistics(mlp,gt,fnp.random.default_rng(60000+seed+i))[1]
        mlps.append(mlp); targets.append(target)
    orig=(submission._SECOND_MEAN_CORRECTION, submission._SECOND_SCALE_CORRECTION)
    rows=[]
    for mc,sc in itertools.product([0.0,0.075,0.15,0.225,0.30,0.45], [0.0,0.075,0.15,0.225,0.30,0.45]):
        submission._SECOND_MEAN_CORRECTION=mc; submission._SECOND_SCALE_CORRECTION=sc
        e=submission.Estimator(); ms=[]; adj=[]
        for mlp,target in zip(mlps,targets):
            with flops.BudgetContext(flop_budget=B,quiet=True) as bc:
                pred=e.predict(mlp,B)[-1]
            m=float(fnp.mean((pred-target)**2)); C=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
            ms.append(m); adj.append(m*max(0.1,C/B))
        rows.append((sum(adj)/len(adj),sum(ms)/len(ms),mc,sc))
    submission._SECOND_MEAN_CORRECTION, submission._SECOND_SCALE_CORRECTION=orig
    rows.sort(); print('SPEC',w,d)
    for r in rows[:12]: print('adj %.4e mse %.4e mean %.3f scale %.3f'%r)
run(64,32,300000,4,12)
run(64,64,200000,3,13)
PY" in /opt/tiger/discover/workspace

/bin/bash -lc "python - <<'PY'
import time
import itertools
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

def budget_for_cap(w,d,k=24576, frac=0.115):
    per = d*(2*w*w+w)+w*w+16*w
    fixed = 9*w**3 + 2*(2*w**3)
    return int((k*per+fixed)/frac)

def eval_spec(w,d,gt,nm,seed=321):
    B=budget_for_cap(w,d)
    rng=fnp.random.default_rng(seed)
    mlps=[]; targets=[]
    for i in range(nm):
        mlp=sample_mlp(w,d,rng,seed=8000+i)
        target=sample_layer_statistics(mlp,gt,fnp.random.default_rng(9000+i))[1]
        mlps.append(mlp); targets.append(target)
    original=(submission._BUDGET_FRACTION, submission._FIRST_CORRECTION, submission._SECOND_CORRECTION, submission._SEED_OFFSET)
    rows=[]
    for frac,fc,sc,off in itertools.product([0.085,0.095,0.105,0.115], [0.75,1.0,1.15], [0.0,0.15,0.30,0.45,0.60], [17]):
        submission._BUDGET_FRACTION=frac
        submission._FIRST_CORRECTION=fc
        submission._SECOND_CORRECTION=sc
        submission._SEED_OFFSET=off
        e=submission.Estimator()
        mse=[]; adj=[]; util=[]; kval=[]
        for mlp,target in zip(mlps,targets):
            with flops.BudgetContext(flop_budget=B, quiet=True) as bc:
                pred=e.predict(mlp,B)[-1]
            m=float(fnp.mean((pred-target)**2))
            C=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
            mse.append(m); adj.append(m*max(0.1,C/B)); util.append(C/B)
            kval.append(submission._sample_count(B,w,d))
        rows.append((sum(adj)/len(adj),sum(mse)/len(mse),sum(util)/len(util),kval[0],frac,fc,sc,off))
    submission._BUDGET_FRACTION, submission._FIRST_CORRECTION, submission._SECOND_CORRECTION, submission._SEED_OFFSET=original
    rows.sort()
    print('SPEC',w,d,'B',B,'gt',gt,'nm',nm)
    for r in rows[:20]:
        print('adj %.4e mse %.4e util %.3f k %d frac %.3f first %.2f second %.2f off %d'%r)

for spec in [(64,32,500000,5),(64,64,300000,3),(32,64,500000,5)]:
    t=time.time(); eval_spec(*spec); print('elapsed',time.time()-t)

codex
The first split is in place and equivalent to the current best when both constants are `0.75`. I’m screening local combinations to decide whether mean or scale should differ.
exec
/bin/bash -lc "python - <<'PY'
import itertools
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import submission

def budget_for_cap(w,d,k=24576,frac=0.115):
    return int((k*(d*(2*w*w+w)+w*w+16*w)+13*w**3)/frac)

def run(w,d,gt,nm,seed):
    B=budget_for_cap(w,d)
    rng=fnp.random.default_rng(seed)
    mlps=[]; targets=[]
    for i in range(nm):
        mlp=sample_mlp(w,d,rng,seed=90000+seed+i)
        target=sample_layer_statistics(mlp,gt,fnp.random.default_rng(91000+seed+i))[1]
        mlps.append(mlp); targets.append(target)
    orig=(submission._FIRST_MEAN_CORRECTION, submission._FIRST_SCALE_CORRECTION)
    rows=[]
    for mc,sc in itertools.product([0.45,0.60,0.75,0.90,1.05], [0.0,0.35,0.60,0.75,0.90,1.05]):
        submission._FIRST_MEAN_CORRECTION=mc; submission._FIRST_SCALE_CORRECTION=sc
        e=submission.Estimator(); adj=[]; ms=[]
        for mlp,target in zip(mlps,targets):
            with flops.BudgetContext(flop_budget=B,quiet=True) as bc:
                pred=e.predict(mlp,B)[-1]
            m=float(fnp.mean((pred-target)**2)); C=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
            ms.append(m); adj.append(m*max(0.1,C/B))
        rows.append((sum(adj)/len(adj),sum(ms)/len(ms),mc,sc))
    submission._FIRST_MEAN_CORRECTION, submission._FIRST_SCALE_CORRECTION=orig
    rows.sort(); print('SPEC',w,d)
    for r in rows[:12]: print('adj %.4e mse %.4e mean %.2f scale %.2f'%r)
run(64,32,300000,4,31)
run(64,64,200000,3,32)
PY" in /opt/tiger/discover/workspace

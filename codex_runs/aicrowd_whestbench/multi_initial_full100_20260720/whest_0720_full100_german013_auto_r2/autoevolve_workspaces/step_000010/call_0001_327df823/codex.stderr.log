codex
There’s a useful structural property here: with no biases, the whole ReLU MLP is positively homogeneous, so Gaussian radius can be integrated out exactly and only directions need sampling. I’m testing fixed-radius sphere probes, which may reduce variance without increasing sample count.
exec
/bin/bash -lc "python - <<'PY'
import math
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission

def mean_radius(w):
    return math.sqrt(2.0)*math.exp(math.lgamma((w+1)/2.0)-math.lgamma(w/2.0))
class SphereRaw(BaseEstimator):
    def __init__(self, lattice=True, whiten=False, corr=False):
        self.lattice=lattice; self.whiten=whiten; self.corr=corr
    def predict(self,mlp,budget):
        width=mlp.width; depth=mlp.depth
        if depth==1:
            first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
            return (fnp.sqrt(first_var)*submission._INV_SQRT_2PI)[None,:]
        k=submission._sample_count(budget,width,depth)
        if self.lattice:
            u=submission._lattice_normal(k//2,width,mlp.seed+submission._SEED_OFFSET)
        else:
            rng=fnp.random.default_rng(mlp.seed+submission._SEED_OFFSET)
            u=rng.standard_normal((k//2,width),dtype=fnp.float32)
        norm=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-20))
        u=(mean_radius(width))*u/norm
        if self.whiten:
            cov=(u.T@u)/float(k//2)
            ev,Q=fnp.linalg.eigh(cov); ev=fnp.maximum(ev,1e-6)
            inv=(Q/fnp.sqrt(ev))@Q.T
            u=u@inv
            norm=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-20))
            u=(mean_radius(width))*u/norm
        x=fnp.concatenate([u,-u],axis=0)
        x=fnp.maximum(x@mlp.weights[0],0.0)
        if self.corr:
            first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
            true_second=0.5*first_var*(mean_radius(width)*mean_radius(width)/float(width))
            true_mean=fnp.sqrt(first_var)*submission._INV_SQRT_2PI
            sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0)
            pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second
            sv=fnp.maximum(ps-pm*pm,1e-12); tv=fnp.maximum(tps-tpm*tpm,1e-12)
            scale=fnp.sqrt(tv/sv); shift=tpm-scale*pm
            corrected=x+submission._FIRST_CORRECTION*((scale-1)*x+shift)
            x=fnp.where(x>0,fnp.maximum(corrected,0),0)
        for w in mlp.weights[1:]:
            x=fnp.maximum(x@w,0)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fnp.mean(x,axis=0)[None,:]],axis=0)

specs=[
 ContestSpec(width=64, depth=8, n_mlps=16, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=8001, wall_time_limit_s=120.0),
 ContestSpec(width=64, depth=16, n_mlps=8, flop_budget=25_000_000_000, ground_truth_samples=262144, seed=8002, wall_time_limit_s=120.0),
 ContestSpec(width=128, depth=8, n_mlps=4, flop_budget=60_000_000_000, ground_truth_samples=262144, seed=8003, wall_time_limit_s=120.0),
]
datas=[]
for s in specs:
 print('make',s.width,s.depth); datas.append(make_contest(s))
ests=[('base',submission.Estimator()),('sphere_lattice',SphereRaw(True,False,False)),('sphere_lattice_w',SphereRaw(True,True,False)),('sphere_lattice_corr',SphereRaw(True,False,True)),('sphere_random',SphereRaw(False,False,False)),('sphere_random_w',SphereRaw(False,True,False))]
for name,est in ests:
 vals=[]; ms=[]; mult=[]
 for data in datas:
  res=evaluate_estimator(est,data)
  vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier'])
 print(name,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(ms)/len(ms),'mult',sum(mult)/len(mult))

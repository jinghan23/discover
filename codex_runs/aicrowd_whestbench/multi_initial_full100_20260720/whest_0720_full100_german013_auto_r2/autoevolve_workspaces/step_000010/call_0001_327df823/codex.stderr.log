codex
I’m testing a more structural variance reducer: a first-layer control variate. The first layer has exact Gaussian ReLU moments, so final estimates can be adjusted using the sample’s first-layer mean error instead of only modifying activations inline.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
class H1CV(BaseEstimator):
    def __init__(self, alpha=1.0, ridge=1e-3):
        self.alpha=alpha; self.ridge=ridge
    def predict(self, mlp, budget):
        width=mlp.width; depth=mlp.depth
        if depth==1:
            first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
            return (fnp.sqrt(first_var)*submission._INV_SQRT_2PI)[None,:]
        k=submission._sample_count(budget,width,depth)
        u=submission._lattice_normal(k//2,width,mlp.seed+submission._SEED_OFFSET)
        x=fnp.concatenate([u,-u],axis=0)
        covariance=(u.T@u)/float(k//2)
        eigenvalues,eigenvectors=fnp.linalg.eigh(covariance); eigenvalues=fnp.maximum(eigenvalues,1e-6)
        inverse_sqrt=(eigenvectors/fnp.sqrt(eigenvalues))@eigenvectors.T
        x=fnp.maximum(x@(inverse_sqrt@mlp.weights[0]),0.0)
        h1_raw=x
        first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
        true_second=0.5*first_var
        true_mean=fnp.sqrt(first_var)*submission._INV_SQRT_2PI
        sample_mean=fnp.mean(x,axis=0); sample_second=fnp.mean(x*x,axis=0)
        positive_mean=2*sample_mean; positive_second=2*sample_second
        true_positive_mean=2*true_mean; true_positive_second=2*true_second
        sample_positive_var=fnp.maximum(positive_second-positive_mean*positive_mean,1e-12)
        true_positive_var=fnp.maximum(true_positive_second-true_positive_mean*true_positive_mean,1e-12)
        scale=fnp.sqrt(true_positive_var/sample_positive_var); shift=true_positive_mean-scale*positive_mean
        corrected=x+submission._FIRST_CORRECTION*((scale-1)*x+shift)
        x=fnp.where(x>0,fnp.maximum(corrected,0),0)
        gram=mlp.weights[0].T@mlp.weights[0]
        std=fnp.sqrt(fnp.maximum(fnp.diag(gram),1e-20)); rho=gram/(std[:,None]*std[None,:]); rho=fnp.clip(rho,-1,1)
        root=fnp.sqrt(fnp.maximum(1-rho*rho,0))
        first_second=((std[:,None]*std[None,:])*(root+(submission._PI-fnp.arccos(rho))*rho)/submission._TWO_PI)
        pre_mean=true_mean@mlp.weights[1]
        projected=first_second@mlp.weights[1]
        pre_second=fnp.sum(mlp.weights[1]*projected,axis=0)
        pre_var=fnp.maximum(pre_second-pre_mean*pre_mean,1e-20)
        second_layer_mean=submission._gaussian_relu_mean(pre_mean,pre_var)
        for layer_index,weight in enumerate(mlp.weights[1:],start=1):
            if layer_index==1:
                pre=x@weight
                sample_pre_mean=fnp.mean(pre,axis=0); sample_pre_second=fnp.mean(pre*pre,axis=0)
                sample_pre_var=fnp.maximum(sample_pre_second-sample_pre_mean*sample_pre_mean,1e-12)
                pre_scale=fnp.sqrt(pre_var/sample_pre_var)
                target_pre=pre_mean+pre_scale*(pre-sample_pre_mean)
                pre=pre+submission._SECOND_PRE_CORRECTION*(target_pre-pre)
                x=fnp.maximum(pre,0)
                sample_mean2=fnp.mean(x,axis=0)
                x=x+submission._SECOND_MEAN_CORRECTION*(second_layer_mean-sample_mean2)
            else:
                x=fnp.maximum(x@weight,0)
        final_mean=fnp.mean(x,axis=0)
        c_mean=fnp.mean(h1_raw,axis=0)
        C=h1_raw-c_mean
        Y=x-final_mean
        cross=(C.T@Y)/float(k)
        cov=first_second-true_mean[:,None]*true_mean[None,:]
        diagmean=fnp.mean(fnp.diag(cov))
        eye=fnp.eye(width,dtype=fnp.float32)
        beta=fnp.linalg.solve(cov + (self.ridge*diagmean+1e-8)*eye, cross)
        final_mean=final_mean + self.alpha*((true_mean-c_mean)@beta)
        return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),final_mean[None,:]],axis=0)

specs=[
 ContestSpec(width=64, depth=8, n_mlps=12, flop_budget=18_000_000_000, ground_truth_samples=524288, seed=7001, wall_time_limit_s=120.0),
 ContestSpec(width=64, depth=16, n_mlps=8, flop_budget=30_000_000_000, ground_truth_samples=262144, seed=7002, wall_time_limit_s=120.0),
]
datas=[]
for s in specs:
 print('make',s.width,s.depth); datas.append(make_contest(s))
for name,est in [('base',submission.Estimator())]+[(f'cv_a{a}_r{r}',H1CV(a,r)) for a in [0.25,0.5,0.75,1.0,1.25] for r in [1e-4,1e-3,1e-2,1e-1]]:
 vals=[]; mses=[]; mult=[]; fail=0
 for data in datas:
  res=evaluate_estimator(est,data)
  vals.append(res['adjusted_final_layer_score']); mses.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier']); fail+=res['n_failed_mlps']
 print(name,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(mses)/len(mses),'mult',sum(mult)/len(mult),'fail',fail)
PY" in /opt/tiger/discover/workspace

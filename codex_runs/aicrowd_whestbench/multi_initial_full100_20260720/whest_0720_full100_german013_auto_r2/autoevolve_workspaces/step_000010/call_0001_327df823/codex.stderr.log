ests=[('mc',submission.Estimator()),('fg1',FullGauss(1)),('fg2',FullGauss(2)),('fg3',FullGauss(3))]+[(f'blend{a}',Blend(a,3)) for a in [-0.1,-0.05,0.02,0.05,0.1]]
for name,est in ests:

/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
INV=0.3989422804014327
SQ=0.7978845608028654

def cdf(x):
    x=fnp.clip(x,-8.0,8.0); y=SQ*(x+0.044715*x*x*x); return 0.5*(1.0+fnp.tanh(y))
def relu_m2(mu,var):
    sig=fnp.sqrt(fnp.maximum(var,1e-20)); a=fnp.clip(mu/sig,-8.0,8.0)
    phi=INV*fnp.exp(-0.5*a*a); C=cdf(a)
    m=sig*phi+mu*C
    q=(mu*mu+var)*C+mu*sig*phi
    return m,q
class DiagAnalytic(BaseEstimator):
    def predict(self,mlp,budget):
        w0=mlp.weights[0]
        var=fnp.sum(w0*w0,axis=0); mu=fnp.zeros(mlp.width,dtype=fnp.float32)
        m,q=relu_m2(mu,var)
        outs=[m]
        for w in mlp.weights[1:]:
            v=fnp.maximum(q-m*m,1e-20)
            mu=m@w
            var=v@(w*w)
            m,q=relu_m2(mu,var)
            outs.append(m)
        return fnp.stack(outs)
class Blend(BaseEstimator):
    def __init__(self,a): self.a=a; self.mc=submission.Estimator(); self.an=DiagAnalytic()
    def predict(self,mlp,budget):
        p=self.mc.predict(mlp,budget); a=self.an.predict(mlp,budget)
        out=p*(1.0-self.a)+a*self.a
        z=fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32)
        return fnp.concatenate([z,out[-1:]],axis=0)


codex
One compute-side improvement might preserve the estimator while lowering FLOPs: replace the symmetric eigen whitening with Cholesky whitening. It still matches sample covariance but changes the finite sample orientation, so I’m testing quality and multiplier locally first.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
class Chol(BaseEstimator):
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth
  if depth==1:
   first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); return (fnp.sqrt(first_var)*submission._INV_SQRT_2PI)[None,:]
  k=submission._sample_count(budget,width,depth)
  u=submission._lattice_normal(k//2,width,mlp.seed+submission._SEED_OFFSET); x=fnp.concatenate([u,-u],axis=0)
  cov=(u.T@u)/float(k//2); L=fnp.linalg.cholesky(cov + 1e-6*fnp.eye(width,dtype=fnp.float32)); B=fnp.linalg.solve(L.T,mlp.weights[0]); x=fnp.maximum(x@B,0.0)
  first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); true_second=0.5*first_var; true_mean=fnp.sqrt(first_var)*submission._INV_SQRT_2PI
  sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second; sv=fnp.maximum(ps-pm*pm,1e-12); tv=fnp.maximum(tps-tpm*tpm,1e-12); scale=fnp.sqrt(tv/sv); shift=tpm-scale*pm; corr=x+submission._FIRST_CORRECTION*((scale-1)*x+shift); x=fnp.where(x>0,fnp.maximum(corr,0),0)
  gram=mlp.weights[0].T@mlp.weights[0]; std=fnp.sqrt(fnp.maximum(fnp.diag(gram),1e-20)); rho=fnp.clip(gram/(std[:,None]*std[None,:]),-1,1); root=fnp.sqrt(fnp.maximum(1-rho*rho,0)); first_second=((std[:,None]*std[None,:])*(root+(submission._PI-fnp.arccos(rho))*rho)/submission._TWO_PI)
  pre_mean=true_mean@mlp.weights[1]; projected=first_second@mlp.weights[1]; pre_second=fnp.sum(mlp.weights[1]*projected,axis=0); pre_var=fnp.maximum(pre_second-pre_mean*pre_mean,1e-20); second_layer_mean=submission._gaussian_relu_mean(pre_mean,pre_var)
  for li,w in enumerate(mlp.weights[1:],start=1):
   if li==1:
    pre=x@w; spm=fnp.mean(pre,axis=0); sps=fnp.mean(pre*pre,axis=0); spv=fnp.maximum(sps-spm*spm,1e-12); sc=fnp.sqrt(pre_var/spv); target=pre_mean+sc*(pre-spm); pre=pre+submission._SECOND_PRE_CORRECTION*(target-pre); x=fnp.maximum(pre,0); sm2=fnp.mean(x,axis=0); x=x+submission._SECOND_MEAN_CORRECTION*(second_layer_mean-sm2)
   else: x=fnp.maximum(x@w,0)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fnp.mean(x,axis=0)[None,:]],axis=0)

specs=[

import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import submission
orig_cdf=submission._normal_cdf

def cdf_erf(x):
    x=fnp.clip(x,-8.0,8.0)
    z=fnp.abs(x)*0.7071067811865476
    t=1.0/(1.0+0.3275911*z)
    y=1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*fnp.exp(-z*z)
    y=fnp.where(x<0.0,-y,y)
    return 0.5*(1.0+y)

def cdf_logistic(x):
    x=fnp.clip(x,-8.0,8.0)
    return 1.0/(1.0+fnp.exp(-1.702*x))

specs=[
 ContestSpec(width=64, depth=8, n_mlps=16, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=9001, wall_time_limit_s=120.0),

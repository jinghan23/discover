codex
The radial reweighting is clearly unstable. I’m going back to the lattice generator itself and testing a stratified-radius variant of the Box-Muller uniforms while preserving whitening and corrections.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import submission
orig_block=submission._lattice_block

def block_strat(count,width,shift1,shift2):
 pairs=width//2
 i=(fnp.arange(count,dtype=fnp.float32)+0.5)[:,None]
 n=float(count)
 j=(fnp.arange(pairs,dtype=fnp.float32)+1.0)[None,:]
 u1=fnp.mod(i/n+shift1,1.0)
 u2=fnp.mod(i*fnp.sqrt(2.0*j+2.0)*0.569840291+shift2,1.0)
 u1=fnp.clip(u1,1e-7,1.0-1e-7)
 radius=fnp.sqrt(-2.0*fnp.log(u1)); angle=submission._TWO_PI*u2
 return fnp.concatenate([radius*fnp.cos(angle),radius*fnp.sin(angle)],axis=1)

def block_strat_both(count,width,shift1,shift2):
 pairs=width//2
 i=(fnp.arange(count,dtype=fnp.float32)+0.5)[:,None]
 n=float(count)
 j=(fnp.arange(pairs,dtype=fnp.float32)+1.0)[None,:]
 u1=fnp.mod(i/n+shift1,1.0)
 u2=fnp.mod(i/n*fnp.sqrt(2.0*j+2.0)*pairs+shift2,1.0)
 u1=fnp.clip(u1,1e-7,1.0-1e-7)
 radius=fnp.sqrt(-2.0*fnp.log(u1)); angle=submission._TWO_PI*u2
 return fnp.concatenate([radius*fnp.cos(angle),radius*fnp.sin(angle)],axis=1)

def block_orig_div(count,width,shift1,shift2):
 pairs=width//2
 i=(fnp.arange(count,dtype=fnp.float32)+0.5)[:,None]
 j=(fnp.arange(pairs,dtype=fnp.float32)+1.0)[None,:]
 u1=fnp.mod(i*fnp.sqrt(2.0*j+1.0)*0.754877666+shift1,1.0)
 u2=fnp.mod(i*fnp.sqrt(2.0*j+2.0)*0.569840291+shift2,1.0)
 u1=fnp.clip(u1,1e-7,1.0-1e-7)
 radius=fnp.sqrt(-2.0*fnp.log(u1)); angle=submission._TWO_PI*u2
 return fnp.concatenate([radius*fnp.cos(angle),radius*fnp.sin(angle)],axis=1)

specs=[
 ContestSpec(width=64, depth=8, n_mlps=16, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=12001, wall_time_limit_s=120.0),
 ContestSpec(width=64, depth=16, n_mlps=8, flop_budget=25_000_000_000, ground_truth_samples=262144, seed=12002, wall_time_limit_s=120.0),
 ContestSpec(width=128, depth=8, n_mlps=4, flop_budget=60_000_000_000, ground_truth_samples=262144, seed=12003, wall_time_limit_s=120.0),
]
datas=[]
for s in specs:
 print('make',s.width,s.depth); datas.append(make_contest(s))
for name,block in [('orig',orig_block),('strat',block_strat),('stratboth',block_strat_both),('orig_center',block_orig_div)]:
 submission._lattice_block=block
 vals=[]; ms=[]; mult=[]
 for data in datas:
  res=evaluate_estimator(submission.Estimator(),data)
  vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier'])
 print(name,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(ms)/len(ms),'mult',sum(mult)/len(mult))
submission._lattice_block=orig_block

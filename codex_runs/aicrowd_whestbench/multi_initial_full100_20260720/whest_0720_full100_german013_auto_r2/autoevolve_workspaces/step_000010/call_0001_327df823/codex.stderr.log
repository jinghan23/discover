ests=[('base',submission.Estimator()),('sel3',SelectOffset([17,5,13],256)),('sel5',SelectOffset([17,5,13,19,37],256)),('sel5h512',SelectOffset([17,5,13,19,37],512)),('sel8',SelectOffset([17,5,13,19,23,37,79,131],256))]

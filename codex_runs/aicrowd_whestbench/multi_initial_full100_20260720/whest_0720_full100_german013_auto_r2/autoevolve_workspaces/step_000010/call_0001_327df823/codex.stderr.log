codex
Another cheap possibility is a global final-layer calibration. If the estimator has a small amplitude bias, multiplying the final mean by a constant changes no sampling work and can be tuned without touching the core algorithm.
exec
/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
class Scale(BaseEstimator):
 def __init__(self,s): self.s=s; self.e=submission.Estimator()
 def predict(self,mlp,budget):
  p=self.e.predict(mlp,budget)
  z=fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32)
  return fnp.concatenate([z,(p[-1]*self.s)[None,:]],axis=0)
specs=[
 ContestSpec(width=64, depth=8, n_mlps=16, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=10001, wall_time_limit_s=120.0),
 ContestSpec(width=64, depth=16, n_mlps=8, flop_budget=25_000_000_000, ground_truth_samples=262144, seed=10002, wall_time_limit_s=120.0),
 ContestSpec(width=128, depth=8, n_mlps=4, flop_budget=60_000_000_000, ground_truth_samples=262144, seed=10003, wall_time_limit_s=120.0),
]
datas=[]
for s in specs:
 print('make',s.width,s.depth); datas.append(make_contest(s))
for scale in [0.94,0.96,0.98,0.99,0.995,1.0,1.005,1.01,1.02,1.04,1.06]:
 vals=[]; ms=[]
 for data in datas:
  res=evaluate_estimator(Scale(scale),data)
  vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse'])
 print('scale',scale,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(ms)/len(ms))

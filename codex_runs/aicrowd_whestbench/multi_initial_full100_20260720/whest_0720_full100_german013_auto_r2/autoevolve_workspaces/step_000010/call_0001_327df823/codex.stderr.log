codex
I’m testing a cheaper homogeneity-based correction: reuse the baseline forward pass but reweight each final sample by the ratio of expected Gaussian radius to that probe’s radius. It avoids a second forward pass, though the early-layer moment corrections may make the effect imperfect.
exec
/bin/bash -lc "python - <<'PY'
import math
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission

def mean_radius(w): return math.sqrt(2.0)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))
class RadialReweight(BaseEstimator):
 def __init__(self,alpha=1.0,clip=10.0): self.alpha=alpha; self.clip=clip
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth
  if depth==1:
   first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0)
   return (fnp.sqrt(first_var)*submission._INV_SQRT_2PI)[None,:]
  k=submission._sample_count(budget,width,depth)
  u=submission._lattice_normal(k//2,width,mlp.seed+submission._SEED_OFFSET)
  # approximate radial factor before whitening; antithetic shares radius
  r=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-20))
  fac=mean_radius(width)/r
  fac=fnp.clip(fac,1.0/self.clip,self.clip)
  fac=fnp.concatenate([fac,fac],axis=0)
  x=fnp.concatenate([u,-u],axis=0)
  covariance=(u.T@u)/float(k//2); ev,Q=fnp.linalg.eigh(covariance); ev=fnp.maximum(ev,1e-6); inv=(Q/fnp.sqrt(ev))@Q.T
  x=fnp.maximum(x@(inv@mlp.weights[0]),0.0)
  first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); true_second=0.5*first_var; true_mean=fnp.sqrt(first_var)*submission._INV_SQRT_2PI
  sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0); pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second
  sv=fnp.maximum(ps-pm*pm,1e-12); tv=fnp.maximum(tps-tpm*tpm,1e-12); scale=fnp.sqrt(tv/sv); shift=tpm-scale*pm
  corr=x+submission._FIRST_CORRECTION*((scale-1)*x+shift); x=fnp.where(x>0,fnp.maximum(corr,0),0)
  gram=mlp.weights[0].T@mlp.weights[0]; std=fnp.sqrt(fnp.maximum(fnp.diag(gram),1e-20)); rho=fnp.clip(gram/(std[:,None]*std[None,:]),-1,1)
  root=fnp.sqrt(fnp.maximum(1-rho*rho,0)); first_second=((std[:,None]*std[None,:])*(root+(submission._PI-fnp.arccos(rho))*rho)/submission._TWO_PI)
  pre_mean=true_mean@mlp.weights[1]; projected=first_second@mlp.weights[1]; pre_second=fnp.sum(mlp.weights[1]*projected,axis=0); pre_var=fnp.maximum(pre_second-pre_mean*pre_mean,1e-20); second_layer_mean=submission._gaussian_relu_mean(pre_mean,pre_var)
  for li,w in enumerate(mlp.weights[1:],start=1):
   if li==1:
    pre=x@w; spm=fnp.mean(pre,axis=0); sps=fnp.mean(pre*pre,axis=0); spv=fnp.maximum(sps-spm*spm,1e-12); sc=fnp.sqrt(pre_var/spv); target=pre_mean+sc*(pre-spm); pre=pre+submission._SECOND_PRE_CORRECTION*(target-pre); x=fnp.maximum(pre,0); sm2=fnp.mean(x,axis=0); x=x+submission._SECOND_MEAN_CORRECTION*(second_layer_mean-sm2)
   else: x=fnp.maximum(x@w,0)
  base=fnp.mean(x,axis=0)
  rw=fnp.mean(x*fac,axis=0)
  fm=base+self.alpha*(rw-base)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fm[None,:]],axis=0)

specs=[
 ContestSpec(width=64, depth=8, n_mlps=16, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=11001, wall_time_limit_s=120.0),
 ContestSpec(width=64, depth=16, n_mlps=8, flop_budget=25_000_000_000, ground_truth_samples=262144, seed=11002, wall_time_limit_s=120.0),
 ContestSpec(width=128, depth=8, n_mlps=4, flop_budget=60_000_000_000, ground_truth_samples=262144, seed=11003, wall_time_limit_s=120.0),
]
datas=[]
for s in specs:
 print('make',s.width,s.depth); datas.append(make_contest(s))
for name,est in [('base',submission.Estimator())]+[(f'rw{a}',RadialReweight(a)) for a in [-1.0,-0.5,-0.25,0.25,0.5,0.75,1.0]]:
 vals=[]; ms=[]; mult=[]
 for data in datas:
  res=evaluate_estimator(est,data)
  vals.append(res['adjusted_final_layer_score']); ms.append(res['final_layer_mse']); mult.append(res['mean_score_multiplier'])
 print(name,'avg',sum(vals)/len(vals),'vals',vals,'mse',sum(ms)/len(ms),'mult',sum(mult)/len(mult))

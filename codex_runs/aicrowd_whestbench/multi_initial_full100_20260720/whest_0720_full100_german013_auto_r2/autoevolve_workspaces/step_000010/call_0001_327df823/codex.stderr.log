/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
INV=submission._INV_SQRT_2PI; TWO=submission._TWO_PI

def relu_m_q(mu,var):
 sig=fnp.sqrt(fnp.maximum(var,1e-20)); a=fnp.clip(mu/sig,-8,8); phi=INV*fnp.exp(-0.5*a*a); C=submission._normal_cdf(a); m=sig*phi+mu*C; q=(mu*mu+var)*C+mu*sig*phi; return m,q,a,phi,C,sig

def bivar_second(mu,cov,order=3):
 var=fnp.maximum(fnp.diag(cov),1e-20); m,q,a,phi,C,sig=relu_m_q(mu,var)
 rho=cov/(sig[:,None]*sig[None,:]); rho=fnp.clip(rho,-0.98,0.98)
 ai=a[:,None]; aj=a[None,:]; phii=phi[:,None]; phij=phi[None,:]; Ci=C[:,None]; Cj=C[None,:]
 rr=rho*rho
 cdf2=Ci*Cj+phii*phij*rho
 if order>=2: cdf2=cdf2+phii*phij*0.5*rr*ai*aj
 if order>=3: cdf2=cdf2+phii*phij*(rho*rr/6.0)*(ai*ai-1.0)*(aj*aj-1.0)
 cdf2=fnp.clip(cdf2,0.0,fnp.minimum(Ci,Cj))
 denom=fnp.maximum(1.0-rr,1e-6)
 expo=fnp.exp(-0.5*(ai*ai-2*rho*ai*aj+aj*aj)/denom)
 phi2=expo/(TWO*fnp.sqrt(denom))
 term=(mu[:,None]*mu[None,:]+cov)*cdf2
 term=term+mu[:,None]*sig[None,:]*phij*submission._normal_cdf((ai-rho*aj)/fnp.sqrt(denom))
 term=term+mu[None,:]*sig[:,None]*phii*submission._normal_cdf((aj-rho*ai)/fnp.sqrt(denom))
 term=term+sig[:,None]*sig[None,:]*denom*phi2
 eye=fnp.eye(mu.shape[0],dtype=fnp.float32)
 return term*(1.0-eye)+q[:,None]*eye, m
class FullGauss(BaseEstimator):
 def __init__(self,order=3): self.order=order
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth
  mu=fnp.zeros(w,dtype=fnp.float32); cov=mlp.weights[0].T@mlp.weights[0]
  S,m=bivar_second(mu,cov,self.order); outs=[m]
  for W in mlp.weights[1:]:
   pre_mean=m@W
   pre_second=W.T@S@W
   cov=pre_second-pre_mean[:,None]*pre_mean[None,:]
   S,m=bivar_second(pre_mean,cov,self.order); outs.append(m)
  return fnp.stack(outs)
class Blend(BaseEstimator):
 def __init__(self,a,order=3): self.a=a; self.mc=submission.Estimator(); self.an=FullGauss(order)
 def predict(self,mlp,budget):
  p=self.mc.predict(mlp,budget); a=self.an.predict(mlp,budget)
  out=p[-1]*(1-self.a)+a[-1]*self.a
  return fnp.concatenate([fnp.zeros((mlp.depth-1,mlp.width),dtype=fnp.float32),out[None,:]],axis=0)


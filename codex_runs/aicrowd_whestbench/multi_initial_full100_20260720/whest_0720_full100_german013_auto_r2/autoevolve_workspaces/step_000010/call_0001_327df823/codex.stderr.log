/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
class NoWhite(BaseEstimator):
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth; k=submission._sample_count(budget,width,depth)
  u=submission._lattice_normal(k//2,width,mlp.seed+submission._SEED_OFFSET)
  x=fnp.concatenate([u,-u],axis=0)
  x=fnp.maximum(x@mlp.weights[0],0.0)
  # same first correction but no whiten true? true moments still exact
  first_var=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); true_second=0.5*first_var; true_mean=fnp.sqrt(first_var)*submission._INV_SQRT_2PI
  sample_mean=fnp.mean(x,axis=0); sample_second=fnp.mean(x*x,axis=0)
  pm=2*sample_mean; ps=2*sample_second; tpm=2*true_mean; tps=2*true_second
  sv=fnp.maximum(ps-pm*pm,1e-12); tv=fnp.maximum(tps-tpm*tpm,1e-12)
  scale=fnp.sqrt(tv/sv); shift=tpm-scale*pm
  corrected=x+submission._FIRST_CORRECTION*((scale-1)*x+shift)
  x=fnp.where(x>0,fnp.maximum(corrected,0),0)
  # second analytic same
  gram=mlp.weights[0].T@mlp.weights[0]
  std=fnp.sqrt(fnp.maximum(fnp.diag(gram),1e-20)); rho=gram/(std[:,None]*std[None,:]); rho=fnp.clip(rho,-1,1)
  root=fnp.sqrt(fnp.maximum(1-rho*rho,0))
  first_second=((std[:,None]*std[None,:])*(root+(submission._PI-fnp.arccos(rho))*rho)/submission._TWO_PI)
  pre_mean=true_mean@mlp.weights[1]; projected=first_second@mlp.weights[1]
  pre_second=fnp.sum(mlp.weights[1]*projected,axis=0); pre_var=fnp.maximum(pre_second-pre_mean*pre_mean,1e-20)
  second_layer_mean=submission._gaussian_relu_mean(pre_mean,pre_var)
  for li,w in enumerate(mlp.weights[1:],start=1):
   if li==1:
    pre=x@w; spm=fnp.mean(pre,axis=0); sps=fnp.mean(pre*pre,axis=0); spv=fnp.maximum(sps-spm*spm,1e-12)
    sc=fnp.sqrt(pre_var/spv); target_pre=pre_mean+sc*(pre-spm); pre=pre+submission._SECOND_PRE_CORRECTION*(target_pre-pre)
    x=fnp.maximum(pre,0); sm=fnp.mean(x,axis=0); x=x+submission._SECOND_MEAN_CORRECTION*(second_layer_mean-sm)
   else:
    x=fnp.maximum(x@w,0)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fnp.mean(x,axis=0)[None,:]],axis=0)
class RandWhite(BaseEstimator):
 def predict(self,mlp,budget):
  width=mlp.width; depth=mlp.depth; k=submission._sample_count(budget,width,depth)
  rng=fnp.random.default_rng(mlp.seed+submission._SEED_OFFSET)
  u=rng.standard_normal((k//2,width),dtype=fnp.float32)
  x=fnp.concatenate([u,-u],axis=0)
  cov=(u.T@u)/float(k//2); ev,Q=fnp.linalg.eigh(cov); ev=fnp.maximum(ev,1e-6); inv=(Q/fnp.sqrt(ev))@Q.T
  x=fnp.maximum(x@(inv@mlp.weights[0]),0.0)
  # skip corrections? use submission code impossible. copy by using monkeypatch _lattice_normal? no
  # continue raw propagation only for rough comparison
  for w in mlp.weights[1:]: x=fnp.maximum(x@w,0)
  return fnp.concatenate([fnp.zeros((depth-1,width),dtype=fnp.float32),fnp.mean(x,axis=0)[None,:]],axis=0)

spec=ContestSpec(width=64, depth=8, n_mlps=12, flop_budget=15_000_000_000, ground_truth_samples=524288, seed=4001, wall_time_limit_s=120.0)
print('make')
data=make_contest(spec)
for name,est in [('current',submission.Estimator()),('nowhite',NoWhite()),('randwhite_raw',RandWhite())]:
 res=evaluate_estimator(est,data)
 print(name,res['adjusted_final_layer_score'],res['final_layer_mse'],res['mean_score_multiplier'])

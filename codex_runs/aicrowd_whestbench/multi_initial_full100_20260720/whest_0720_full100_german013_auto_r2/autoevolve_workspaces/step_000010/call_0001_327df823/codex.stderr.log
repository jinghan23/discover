/bin/bash -lc "python - <<'PY'
import flopscope.numpy as fnp
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import submission
class SelectOffset(BaseEstimator):
 def __init__(self,offsets,pilot_half=512): self.offsets=offsets; self.pilot_half=pilot_half
 def _metric(self,mlp,offset,true_mean,true_second):
  w=mlp.width; h=self.pilot_half
  u=submission._lattice_normal(h,w,mlp.seed+offset); x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(h); ev,Q=fnp.linalg.eigh(cov); ev=fnp.maximum(ev,1e-6); inv=(Q/fnp.sqrt(ev))@Q.T; x=fnp.maximum(x@(inv@mlp.weights[0]),0)
  sm=fnp.mean(x,axis=0); ss=fnp.mean(x*x,axis=0)
  dm=(sm-true_mean)/(fnp.abs(true_mean)+1e-6); ds=(ss-true_second)/(fnp.abs(true_second)+1e-6)
  return float(fnp.mean(dm*dm)+0.25*fnp.mean(ds*ds))
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth
  if d==1:
   fv=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); return (fnp.sqrt(fv)*submission._INV_SQRT_2PI)[None,:]
  fv=fnp.sum(mlp.weights[0]*mlp.weights[0],axis=0); tm=fnp.sqrt(fv)*submission._INV_SQRT_2PI; ts=0.5*fv
  best=self.offsets[0]; bestm=self._metric(mlp,best,tm,ts)
  for off in self.offsets[1:]:
   m=self._metric(mlp,off,tm,ts)
   if m<bestm: bestm=m; best=off
  old=submission._SEED_OFFSET; submission._SEED_OFFSET=best
  out=submission.Estimator().predict(mlp,budget)
  submission._SEED_OFFSET=old
  return out


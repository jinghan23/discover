def grelu(m,v):
 s=np.sqrt(np.maximum(v,1e-20)); a=np.clip(m/s,-8,8); return s*INV*np.exp(-.5*a*a)+m*cdf(a)
def lat(h,w,seed):
 rng=np.random.default_rng(seed); p=w//2; i=(np.arange(h)+.5)[:,None]; j=(np.arange(p)+1.)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,p)),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,p)),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO*u2; z=np.concatenate([r*np.cos(a),r*np.sin(a)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((h,1))],1)
 return z
def pred(ws,k,seed,cp,cm):

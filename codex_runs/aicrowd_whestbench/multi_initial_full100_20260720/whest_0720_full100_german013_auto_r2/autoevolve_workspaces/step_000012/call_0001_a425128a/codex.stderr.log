# Depth 2 cm sensitivity.
import numpy as np, math
INV=1/math.sqrt(2*math.pi); PI=math.pi; TWO=2*math.pi; SQRT=math.sqrt(2/math.pi)
def cdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQRT*(x+0.044715*x*x*x)))
def grelu(m,v):
 s=np.sqrt(np.maximum(v,1e-20)); a=np.clip(m/s,-8,8); return s*INV*np.exp(-.5*a*a)+m*cdf(a)
def lat(h,w,seed):
 rng=np.random.default_rng(seed); p=w//2; i=(np.arange(h)+.5)[:,None]; j=(np.arange(p)+1.)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*.754877666+rng.random((1,p)),1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+rng.random((1,p)),1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO*u2; z=np.concatenate([r*np.cos(a),r*np.sin(a)],1)
 if w&1: z=np.concatenate([z,rng.standard_normal((h,1))],1)
 return z
def pred(ws,k,seed,cm):
 w0=ws[0]; width=w0.shape[0]; u=lat(k//2,width,seed+17); x=np.concatenate([u,-u],0); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; x=np.maximum(x@(inv@w0),0)
 fv=np.sum(w0*w0,0); tm=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); sh=tpm-sc*pm; x=np.where(x>0,np.maximum(x+1.55*((sc-1)*x+sh),0),0)
 gram=w0.T@w0; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); fs=(std[:,None]*std[None,:])*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO
 pm2=tm@ws[1]; proj=fs@ws[1]; ps2=np.sum(ws[1]*proj,0); pv2=np.maximum(ps2-pm2*pm2,1e-20); gm2=grelu(pm2,pv2)
 pre=x@ws[1]; spm=pre.mean(0); spv=np.maximum((pre*pre).mean(0)-spm*spm,1e-12); sc=np.sqrt(pv2/spv); pre=pre+1.2*(pm2+sc*(pre-spm)-pre); x=np.maximum(pre,0); return (x+cm*(gm2-x.mean(0))).mean(0)
def true(ws,n,seed):
 rng=np.random.default_rng(seed); acc=np.zeros(ws[0].shape[1]); done=0
 while done<n:
  b=min(80000,n-done); x=rng.standard_normal((b,ws[0].shape[0]))
  for w in ws: x=np.maximum(x@w,0)
  acc+=x.sum(0); done+=b
 return acc/n
cms=[-0.2,0,0.05,0.1,0.2,0.3,0.5,1.0]
for width,k,n,seeds in [(32,16384,600000,8),(64,16384,400000,6),(96,8192,300000,4),(128,8192,220000,3),(160,4096,160000,2)]:
 vals={cm:[] for cm in cms}
 for seed in range(seeds):
  rng=np.random.default_rng(width*999+seed); s=1/math.sqrt(width); ws=[rng.standard_normal((width,width))*s for _ in range(2)]; tgt=true(ws,n,seed+321)
  for cm in cms: vals[cm].append(np.mean((pred(ws,k,seed,cm)-tgt)**2))
 base=np.mean(vals[0.3]); print('w',width,'base',base,'best',min(cms,key=lambda cm:np.mean(vals[cm])),'ratios',{cm:round(float(np.mean(vals[cm])/base),3) for cm in cms})

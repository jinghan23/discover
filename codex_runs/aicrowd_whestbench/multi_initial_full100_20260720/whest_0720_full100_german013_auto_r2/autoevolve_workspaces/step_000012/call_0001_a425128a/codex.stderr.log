+def _second_mean_correction(width: int, depth: int) -> float:
+    if width <= 48:
+        value = 0.04
+    elif width <= 80:
+        value = 0.07
+    elif width <= 112:
+        value = 0.16
+    elif width <= 144:
+        value = 0.24
+    else:

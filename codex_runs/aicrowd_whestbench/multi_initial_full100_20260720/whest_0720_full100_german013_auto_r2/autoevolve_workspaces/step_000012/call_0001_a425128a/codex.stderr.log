import numpy as np, math, time
INV=1/math.sqrt(2*math.pi); PI=math.pi; TWO=2*math.pi; SQRT=math.sqrt(2/math.pi)
# 6-point Gauss-Legendre nodes/weights
nodes=np.array([-0.9324695142031521,-0.6612093864662645,-0.2386191860831969,0.2386191860831969,0.6612093864662645,0.9324695142031521])
weights=np.array([0.1713244923791704,0.3607615730481386,0.4679139345726910,0.4679139345726910,0.3607615730481386,0.1713244923791704])
def cdf(x):
 x=np.clip(x,-8,8); return 0.5*(1+np.tanh(SQRT*(x+0.044715*x*x*x)))
def grelu(m,v):
 s=np.sqrt(np.maximum(v,1e-20)); a=np.clip(m/s,-8,8); return s*INV*np.exp(-.5*a*a)+m*cdf(a)
def bvcdf(a,b,rho):
 # vector/matrix a[:,None], b[None,:], rho matrix
 aa=a[:,None]; bb=b[None,:]; rr=np.clip(rho,-0.999,0.999)
 out=cdf(aa)*cdf(bb)
 integ=0.0
 for n,w in zip(nodes,weights):
  t=0.5*rr*(n+1.0); om=np.maximum(1-t*t,1e-8)
  expo=-(aa*aa - 2*t*aa*bb + bb*bb)/(2*om)
  pdf=np.exp(np.clip(expo,-80,40))/(TWO*np.sqrt(om))
  integ += w*pdf

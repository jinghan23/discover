        print(i,'cur',rows[-1][0],'diag',rows[-1][1])
    print('mean',np.mean(rows,axis=0))

for spec in [(64,4),(64,8),(128,4),(128,8)]:
    st=time.time(); run(*spec,n_mlps=3,n_target=200000,k=8192 if spec[0]>=128 else 16384); print('time',time.time()-st)

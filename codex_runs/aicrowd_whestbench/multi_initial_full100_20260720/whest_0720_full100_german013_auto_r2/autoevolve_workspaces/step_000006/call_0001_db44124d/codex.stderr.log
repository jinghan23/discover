import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT=math.sqrt(2/math.pi)
def cdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQRT*(x+0.044715*x*x*x)))
def rmean(mu,var): sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8); return sig*INV*np.exp(-.5*a*a)+mu*cdf(a)
def lat(h,w,s):
 pairs=w//2; rng=np.random.default_rng(s+17); s1=rng.random((1,pairs),dtype=np.float32); s2=rng.random((1,pairs),dtype=np.float32); i=(np.arange(h,dtype=np.float32)+.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1)[None,:]; u1=np.mod(i*np.sqrt(2*j+1)*.754877666+s1,1); u2=np.mod(i*np.sqrt(2*j+2)*.569840291+s2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; return np.concatenate([r*np.cos(a),r*np.sin(a)],1).astype(np.float32)
def pred(weights,k,seed,extra_layer=0,extra_coeff=0):
 w=weights[0].shape[0]; u=lat(k//2,w,seed); x=np.concatenate([u,-u]); vals,vecs=np.linalg.eigh((u.T@u)/(k//2)); inv=(vecs/np.sqrt(np.maximum(vals,1e-6)))@vecs.T; x=np.maximum(x@(inv@weights[0]),0); fv=(weights[0]*weights[0]).sum(0); m=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*m; tps=2*ts; scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm; x=np.where(x>0,np.maximum(x+.68*((scale-1)*x+shift),0),0); gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); fs=(std[:,None]*std[None,:])*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/TWO_PI; pm2=m@weights[1]; ps2=np.sum(weights[1]*(fs@weights[1]),0); m2=rmean(pm2,np.maximum(ps2-pm2*pm2,1e-20))
 for li,W in enumerate(weights[1:],1):
  if extra_coeff and li==extra_layer:
   mh=x.mean(0); S=(x.T@x)/x.shape[0]; mu=mh@W; sec=np.sum(W*(S@W),0); smooth=rmean(mu,np.maximum(sec-mu*mu,1e-20))
  else:
   smooth=None
  x=np.maximum(x@W,0)
  if li==1: x=np.maximum(x+.19*(m2-x.mean(0)),0)
  if smooth is not None:
   x=np.maximum(x+extra_coeff*(smooth-x.mean(0)),0)
 return x.mean(0)
def target(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  c=min(32768,n-done); x=rng.standard_normal((c,w),dtype=np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=c
 return s/n
rng=np.random.default_rng(1234)
settings=[(0,0),(2,.1),(2,.2),(2,.4),(3,.1),(3,.2),(3,.4),(4,.2)]
for spec in [(64,8,24576,400000,6),(128,8,16384,250000,5),(256,8,12288,100000,3),(128,12,16384,200000,4)]:
 width,depth,k,nt,nm=spec; print('\\nspec',width,depth); vals={s:[] for s in settings}
 for i in range(nm):
  weights=[(rng.standard_normal((width,width),dtype=np.float32)*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]; t=target(weights,nt,420+i+width)
  for s in settings: vals[s].append(np.mean((pred(weights,k,230+i,s[0],s[1])-t)**2))
 for s,v in sorted(((s,np.mean(v)) for s,v in vals.items()), key=lambda x:x[1])[:8]: print(s,v)

import numpy as np, math, time

BUDGET_FRACTION=0.120
MIN_SAMPLES=32
SAMPLE_CAP=24576
TWO_PI=2*math.pi
PI=math.pi
INV=1/math.sqrt(2*math.pi)
SQRT_2_OVER_PI=math.sqrt(2/math.pi)
FIRST=0.68
SECOND=0.19

def cdf_gelu(x):
    x=np.clip(x,-8,8)
    y=SQRT_2_OVER_PI*(x+0.044715*x*x*x)
    return 0.5*(1+np.tanh(y))

def relu_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8)
    phi=INV*np.exp(-0.5*a*a); c=cdf_gelu(a)
    return sig*phi+mu*c

def lattice(half,w,seed,offset=17):
    pairs=w//2
    rng=np.random.default_rng(seed+offset)
    shift1=rng.random((1,pairs), dtype=np.float32)
    shift2=rng.random((1,pairs), dtype=np.float32)
    i=(np.arange(half,dtype=np.float32)+0.5)[:,None]
    j=(np.arange(pairs,dtype=np.float32)+1.0)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*0.754877666+shift1,1.0)
    u2=np.mod(i*np.sqrt(2*j+2)*0.569840291+shift2,1.0)
    u1=np.clip(u1,1e-7,1-1e-7)
    r=np.sqrt(-2*np.log(u1)); ang=TWO_PI*u2
    z=np.concatenate([r*np.cos(ang), r*np.sin(ang)],axis=1).astype(np.float32)
    if w&1:
        z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],axis=1)
    return z

def current(weights, seed, k=24576, first_corr=FIRST, second_corr=SECOND, blend=0.0):
    depth=len(weights); w=weights[0].shape[0]
    u=lattice(k//2,w,seed)
    x=np.concatenate([u,-u],axis=0)
    cov=(u.T@u)/(k//2)
    vals,vecs=np.linalg.eigh(cov)
    vals=np.maximum(vals,1e-6)
    invsqrt=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(invsqrt@weights[0]),0)
    first_var=np.sum(weights[0]*weights[0],axis=0)
    if depth==1:
        return np.sqrt(first_var)*INV
    true_second=0.5*first_var
    true_mean=np.sqrt(first_var)*INV
    sm=x.mean(0); ss=(x*x).mean(0)
    pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second
    spv=np.maximum(ps-pm*pm,1e-12); tpv=np.maximum(tps-tpm*tpm,1e-12)
    scale=np.sqrt(tpv/spv); shift=tpm-scale*pm
    corr=x+first_corr*((scale-1)*x+shift)
    x=np.where(x>0,np.maximum(corr,0),0)
    gram=weights[0].T@weights[0]
    std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=gram/(std[:,None]*std[None,:])
    rho=np.clip(rho,-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
    first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pre_mean=true_mean@weights[1]
    projected=first_second@weights[1]
    pre_second=np.sum(weights[1]*projected,axis=0)
    second_mean=relu_mean(pre_mean,np.maximum(pre_second-pre_mean*pre_mean,1e-20))
    analytic=second_mean
    for li,W in enumerate(weights[1:],start=1):
        x=np.maximum(x@W,0)
        if li==1:
            sm=x.mean(0); x=np.maximum(x+second_corr*(second_mean-sm),0)
    fm=x.mean(0)
    # no analytic final yet
    return fm

def diag_analytic(weights):
    W=weights[0]
    var=np.sum(W*W,axis=0)
    m=np.sqrt(var)*INV
    q=0.5*var
    for W in weights[1:]:
        mu=m@W
        second=q@(W*W)  # ignores offdiag (wrong for nonzero mean independent? q includes E ai"'^2; no cov)
        var=np.maximum(second-mu*mu,1e-20)
        m=relu_mean(mu,var)
        # ReLU second for Gaussian: (mu''^2+var)Phi+mu sigma phi
        sig=np.sqrt(var); a=np.clip(mu/sig,-8,8); phi=INV*np.exp(-0.5*a*a); Phi=cdf_gelu(a)
        q=(mu*mu+var)*Phi+mu*sig*phi
    return m

def corrected_diag(weights, seed, k=24576, per_corr=0.0, first_corr=FIRST, second_corr=SECOND):
    depth=len(weights); w=weights[0].shape[0]
    u=lattice(k//2,w,seed); x=np.concatenate([u,-u],axis=0)
    cov=(u.T@u)/(k//2); vals,vecs=np.linalg.eigh(cov); vals=np.maximum(vals,1e-6); invsqrt=(vecs/np.sqrt(vals))@vecs.T
    x=np.maximum(x@(invsqrt@weights[0]),0)
    W=weights[0]
    var=np.sum(W*W,axis=0); m=np.sqrt(var)*INV; q=0.5*var
    # first correction exact same
    sm=x.mean(0); ss=(x*x).mean(0)
    pm=2*sm; ps=2*ss; tpm=2*m; tps=2*q
    scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm
    x=np.where(x>0,np.maximum(x+first_corr*((scale-1)*x+shift),0),0)
    # propagate diag and optionally correct every layer means/q
    for li,W in enumerate(weights[1:],start=1):
        mu=m@W
        second=q@(W*W)
        var=np.maximum(second-mu*mu,1e-20)
        sig=np.sqrt(var); a=np.clip(mu/sig,-8,8); phi=INV*np.exp(-0.5*a*a); Phi=cdf_gelu(a)
        m_next=sig*phi+mu*Phi
        q_next=(mu*mu+var)*Phi+mu*sig*phi
        x=np.maximum(x@W,0)
        if li==1:
            # overwrite m_next with full first exact second layer mean if desired? skip for this variant
            pass
        if per_corr:
            sm=x.mean(0); ss=(x*x).mean(0)
            sc=np.sqrt(np.maximum(q_next-m_next*m_next,1e-12)/np.maximum(ss-sm*sm,1e-12))
            x=np.maximum(x+per_corr*((sc-1)*x+(m_next-sc*sm)),0)
        m,q=m_next,q_next
    return x.mean(0)

def target(weights, n=500000, seed=1234, chunk=32768):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        c=min(chunk,n-done)
        x=rng.standard_normal((c,w),dtype=np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.astype(np.float64).sum(0); done+=c
    return s/n

def run(width,depth,n_mlps=5,n_target=300000,k=24576):
    rng=np.random.default_rng(999)
    print('"'spec',width,depth)
    rows=[]
    for i in range(n_mlps):

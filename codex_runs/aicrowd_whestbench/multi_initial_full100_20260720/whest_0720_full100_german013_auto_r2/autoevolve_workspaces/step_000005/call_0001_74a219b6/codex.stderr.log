codex
The sample-budget tests bracketed the baseline and both got worse, so I’m switching to an algorithmic variance-reduction trial. Because the network is positively homogeneous, the Gaussian radius can be integrated analytically; sampling only directions may reduce radial noise without using extra budget.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np

INV=0.3989422804014327
TWO_PI=6.283185307179586
PI=np.pi
SQRT2PI=0.7978845608028654

def mean_chi(w):
    if w & 1:
        value=SQRT2PI; n=1
    else:
        value=1.2533141373155001; n=2
    while n < w:
        value *= (n+1.0)/n
        n += 2
    return value

def lattice_normal(half,w,seed):
    rng=np.random.default_rng(seed)
    # approximate with rng for offline
    return rng.standard_normal((half,w)).astype(np.float32)

def sample_current(weights,k,seed,first_corr=.75,second_corr=.24):
    w=weights[0].shape[0]; d=len(weights)
    u=lattice_normal(k//2,w,seed+17)
    x=np.concatenate([u,-u],0)
    cov=u.T@u/(k//2)
    ev,evec=np.linalg.eigh(cov)
    inv=(evec/np.sqrt(np.maximum(ev,1e-6)))@evec.T
    x=np.maximum(x@(inv@weights[0]),0)
    if d==1: return np.sqrt(np.sum(weights[0]*weights[0],0))*INV
    first_var=np.sum(weights[0]*weights[0],0)
    true_second=.5*first_var
    true_mean=np.sqrt(first_var)*INV
    sample_mean=x.mean(0); sample_second=(x*x).mean(0)
    pm=2*sample_mean; ps=2*sample_second
    tpm=2*true_mean; tps=2*true_second
    spv=np.maximum(ps-pm*pm,1e-12); tpv=np.maximum(tps-tpm*tpm,1e-12)
    scale=np.sqrt(tpv/spv); shift=tpm-scale*pm
    corr=x+first_corr*((scale-1)*x+shift)
    x=np.where(x>0,np.maximum(corr,0),0)
    gram=weights[0].T@weights[0]
    std=np.sqrt(np.maximum(np.diag(gram),1e-20))
    rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pre_mean=true_mean@weights[1]
    projected=first_second@weights[1]
    pre_second=np.sum(weights[1]*projected,0)
    var=np.maximum(pre_second-pre_mean*pre_mean,1e-20)
    sigma=np.sqrt(var); alpha=np.clip(pre_mean/sigma,-8,8)
    phi=INV*np.exp(-.5*alpha*alpha)
    cdf=.5*(1+np.tanh(SQRT2PI*(alpha+0.044715*alpha**3)))
    second_mean=sigma*phi+pre_mean*cdf
    for li,W in enumerate(weights[1:],1):
        x=np.maximum(x@W,0)
        if li==1:
            sm=x.mean(0); x=np.maximum(x+second_corr*(second_mean-sm),0)
    return x.mean(0)

def sample_sphere(weights,k,seed,first_corr=.0,second_corr=.0,whiten=True):
    w=weights[0].shape[0]; d=len(weights)
    u=lattice_normal(k//2,w,seed+17)
    if whiten:
        cov=u.T@u/(k//2)
        ev,evec=np.linalg.eigh(cov)
        inv=(evec/np.sqrt(np.maximum(ev,1e-6)))@evec.T
        u=u@inv
    u=u/np.sqrt(np.sum(u*u,1,keepdims=True))*mean_chi(w)
    x=np.concatenate([u,-u],0)
    x=np.maximum(x@weights[0],0)
    # optionally same corrections
    if d==1: return np.sqrt(np.sum(weights[0]*weights[0],0))*INV
    first_var=np.sum(weights[0]*weights[0],0)
    true_second=.5*first_var
    true_mean=np.sqrt(first_var)*INV
    if first_corr:
        sample_mean=x.mean(0); sample_second=(x*x).mean(0)
        pm=2*sample_mean; ps=2*sample_second
        tpm=2*true_mean; tps=2*true_second
        spv=np.maximum(ps-pm*pm,1e-12); tpv=np.maximum(tps-tpm*tpm,1e-12)
        scale=np.sqrt(tpv/spv); shift=tpm-scale*pm
        corr=x+first_corr*((scale-1)*x+shift)
        x=np.where(x>0,np.maximum(corr,0),0)
    # same second analytic optional
    second_mean=None
    if second_corr:
        gram=weights[0].T@weights[0]
        std=np.sqrt(np.maximum(np.diag(gram),1e-20))
        rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
        pre_mean=true_mean@weights[1]
        projected=first_second@weights[1]
        pre_second=np.sum(weights[1]*projected,0)
        var=np.maximum(pre_second-pre_mean*pre_mean,1e-20)
        sigma=np.sqrt(var); alpha=np.clip(pre_mean/sigma,-8,8)
        phi=INV*np.exp(-.5*alpha*alpha)
        cdf=.5*(1+np.tanh(SQRT2PI*(alpha+0.044715*alpha**3)))
        second_mean=sigma*phi+pre_mean*cdf
    for li,W in enumerate(weights[1:],1):
        x=np.maximum(x@W,0)
        if li==1 and second_corr:
            sm=x.mean(0); x=np.maximum(x+second_corr*(second_mean-sm),0)
    return x.mean(0)

def target(weights,n=200000,seed=999):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]
    acc=np.zeros(w)
    bs=10000; rem=n
    while rem:
        b=min(bs,rem); rem-=b
        x=rng.standard_normal((b,w))
        for W in weights:
            x=np.maximum(x@W,0)
        acc += x.sum(0)
    return acc/n

for scale in ['he','xavier']:
  print('scale',scale)
  for width,depth,k in [(32,8,4096),(64,8,4096),(64,16,4096),(128,8,4096)]:
    errs={'cur':[],'s0':[],'s_corr':[],'s_nowhite':[]}
    for seed in range(5):
        rng=np.random.default_rng(seed)
        st=np.sqrt((2 if scale=='he' else 1)/width)
        weights=[rng.standard_normal((width,width))*st for _ in range(depth)]
        t=target(weights,n=100000,seed=seed+1000)
        for name,p in [('cur',sample_current(weights,k,seed)),('s0',sample_sphere(weights,k,seed,0,0,True)),('s_corr',sample_sphere(weights,k,seed,.75,.24,True)),('s_nowhite',sample_sphere(weights,k,seed,0,0,False))]:
            errs[name].append(np.mean((p-t)**2))
    print(width,depth,{n:float(np.mean(v)) for n,v in errs.items()})
PY" in /opt/tiger/discover/workspace

    pre_mean=true_mean@weights[1]; projected=first_second@weights[1]; pre_second=np.sum(weights[1]*projected,0)
    second_mean=gm(pre_mean,np.maximum(pre_second-pre_mean*pre_mean,1e-20))
    third_mean=None

        pre_second_matrix=weights[1].T@projected
        pre_cov=pre_second_matrix-pre_mean[:,None]*pre_mean[None,:]
        v=np.maximum(np.diag(pre_cov),1e-20); st=np.sqrt(v)
        r=np.clip(pre_cov/(st[:,None]*st[None,:]),-1,1)
        root=np.sqrt(np.maximum(1-r*r,0)); second_second=(st[:,None]*st[None,:])*(root+(PI-np.arccos(r))*r)/TWO
        # set diagonal to nonzero mean second moment
        sig=st; a=np.clip(pre_mean/sig,-8,8); phi=INV*np.exp(-.5*a*a); C=cdf(a)
        diag=(v+pre_mean*pre_mean)*C+pre_mean*sig*phi
        np.fill_diagonal(second_second,diag)
        pm3=second_mean@weights[2]
        proj2=second_second@weights[2]
        ps3=np.sum(weights[2]*proj2,0)
        third_mean=gm(pm3,np.maximum(ps3-pm3*pm3,1e-20))
    for li,W in enumerate(weights[1:],1):

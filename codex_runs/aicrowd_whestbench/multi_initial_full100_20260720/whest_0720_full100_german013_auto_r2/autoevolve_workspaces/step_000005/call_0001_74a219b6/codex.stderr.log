import numpy as np, math
INV=0.3989422804014327; SQRT2PI=0.7978845608028654; PI=math.pi; TWO=2*math.pi

def cdf(a):
    a=np.clip(a,-8,8); return .5*(1+np.tanh(SQRT2PI*(a+0.044715*a*a*a)))
def gm(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8); return sig*INV*np.exp(-.5*a*a)+mu*cdf(a)
def current(weights,k,seed,first=.75,second=.19,third=0.0):

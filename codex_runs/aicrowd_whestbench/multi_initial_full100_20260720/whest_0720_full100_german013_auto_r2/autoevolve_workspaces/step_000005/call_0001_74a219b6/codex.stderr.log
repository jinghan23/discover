import numpy as np, math
INV=0.3989422804014327; SQRT2PI=0.7978845608028654

def cdf(a): return .5*(1+np.tanh(SQRT2PI*(np.clip(a,-8,8)+0.044715*np.clip(a,-8,8)**3)))
def relu_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8); phi=INV*np.exp(-.5*a*a); return sig*phi+mu*cdf(a)
def relu_second(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/sig,-8,8); phi=INV*np.exp(-.5*a*a); C=cdf(a); return (var+mu*mu)*C + mu*sig*phi

def diag(weights):
    w=weights[0].shape[0]
    mean=np.zeros(w); second=np.ones(w)
    for W in weights:
        var=np.maximum(second-mean*mean,0)
        pm=mean@W
        pv=var@(W*W)
        mean=relu_mean(pm,pv)
        second=relu_second(pm,pv)
    return mean
# reuse quick estimator from previous? implement simple random current with same corrections but no lattice
def current(weights,k,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed)
    u=rng.standard_normal((k//2,w)); x=np.r_[u,-u]
    cov=u.T@u/(k//2); ev,evec=np.linalg.eigh(cov); inv=(evec/np.sqrt(np.maximum(ev,1e-6)))@evec.T
    x=np.maximum(x@(inv@weights[0]),0)
    fv=np.sum(weights[0]*weights[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv
    sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts
    scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm
    x=np.where(x>0,np.maximum(x+.75*((scale-1)*x+shift),0),0)
    # skip second correction for speed? no, include rough no full? leave
    for W in weights[1:]: x=np.maximum(x@W,0)
    return x.mean(0)
def target(weights,n=100000,seed=99):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; acc=np.zeros(w); bs=10000
    for _ in range(n//bs):
        x=rng.standard_normal((bs,w))
        for W in weights: x=np.maximum(x@W,0)
        acc+=x.sum(0)
    return acc/n
for scale in ['xavier','he']:
  print(scale)
  for width,depth,k in [(64,8,4096),(64,16,4096),(128,8,4096)]:
    vals=[]
    for gamma in [0,.01,.02,.05,.1,.2,.5,1.0]: vals.append([])
    for seed in range(5):
      rng=np.random.default_rng(seed); st=np.sqrt((1 if scale=='xavier' else 2)/width)
      weights=[rng.standard_normal((width,width))*st for _ in range(depth)]
      t=target(weights,seed=1000+seed); mc=current(weights,k,seed); an=diag(weights)
      for idx,gamma in enumerate([0,.01,.02,.05,.1,.2,.5,1.0]):
        p=(1-gamma)*mc+gamma*an
        vals[idx].append(np.mean((p-t)**2))
    print(width,depth,[(g,float(np.mean(v))) for g,v in zip([0,.01,.02,.05,.1,.2,.5,1.0],vals)])

+    phi = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = _normal_cdf(alpha)
+    mean = sigma * phi + mu * cdf
+    second = (var + mu * mu) * cdf + mu * sigma * phi
+    return mean, fnp.maximum(second, mean * mean)
 
 

 def _normal_cdf(x):
@@ -36,6 +37,28 @@
     return sigma * phi + mu * cdf
 
 
+def _gaussian_relu_second(mu, var):
+    sigma = fnp.sqrt(fnp.maximum(var, 1e-20))
+    alpha = fnp.clip(mu / sigma, -8.0, 8.0)
+    phi = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = _normal_cdf(alpha)
+    return (mu * mu + var) * cdf + mu * sigma * phi
+
+
+def _diag_gaussian_final_mean(mlp):
+    first_var = fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0)
+    mean = fnp.sqrt(first_var) * _INV_SQRT_2PI
+    second = 0.5 * first_var
+
+    for weight in mlp.weights[1:]:
+        var = fnp.maximum(second - mean * mean, 1e-20)
+        pre_mean = mean @ weight
+        pre_var = var @ (weight * weight)
+        mean = _gaussian_relu_mean(pre_mean, pre_var)
+        second = _gaussian_relu_second(pre_mean, pre_var)
+    return mean
+
+

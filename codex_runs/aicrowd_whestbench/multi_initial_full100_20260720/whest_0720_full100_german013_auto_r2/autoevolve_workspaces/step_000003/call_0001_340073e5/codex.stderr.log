/bin/bash -lc "python - <<'PY'
import numpy as np, math, time

TWO_PI=2*math.pi
PI=math.pi
INV=1/math.sqrt(2*math.pi)
SQRT2PI=math.sqrt(2/math.pi)

def normal_cdf(x):
    x=np.clip(x,-8,8)
    y=SQRT2PI*(x+0.044715*x*x*x)
    return 0.5*(1+np.tanh(y))

def gaussian_relu_moments(mu,var):
    sigma=np.sqrt(np.maximum(var,1e-20))
    alpha=np.clip(mu/sigma,-8,8)
    phi=INV*np.exp(-0.5*alpha*alpha)
    cdf=normal_cdf(alpha)
    mean=sigma*phi+mu*cdf
    second=(var+mu*mu)*cdf+mu*sigma*phi
    return mean,np.maximum(second,mean*mean)

def lattice_block(count,width,shift1,shift2):
    pairs=width//2
    i=(np.arange(count,dtype=np.float32)+0.5)[:,None]
    j=(np.arange(pairs,dtype=np.float32)+1.0)[None,:]
    u1=np.mod(i*np.sqrt(2.0*j+1.0)*0.754877666+shift1,1.0)
    u2=np.mod(i*np.sqrt(2.0*j+2.0)*0.569840291+shift2,1.0)
    u1=np.clip(u1,1e-7,1-1e-7)
    radius=np.sqrt(-2.0*np.log(u1))
    angle=TWO_PI*u2
    return np.concatenate([radius*np.cos(angle), radius*np.sin(angle)],axis=1).astype(np.float32)

def lattice_normal(half,width,seed, offset=17):
    rng=np.random.default_rng(seed+offset)
    pairs=width//2
    s1=rng.random((1,pairs),dtype=np.float32)
    s2=rng.random((1,pairs),dtype=np.float32)
    z=lattice_block(half,width,s1,s2)
    if width&1:
        z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],axis=1)
    return z

def baseline(weights, seed, k=24576, first_corr=1.05, second_corr=0.30, seed_offset=17, second_mean_corr=1.0, whiten=True):
    width=weights[0].shape[0]; depth=len(weights)
    if depth==1:
        return np.sqrt(np.sum(weights[0]*weights[0],axis=0))*INV
    u=lattice_normal(k//2,width,seed,seed_offset)
    x=np.concatenate([u,-u],axis=0)
    if whiten:
        cov=(u.T@u)/(k//2)
        evals,evecs=np.linalg.eigh(cov)
        evals=np.maximum(evals,1e-6)
        invsqrt=(evecs/np.sqrt(evals))@evecs.T
        x=np.maximum(x@(invsqrt@weights[0]),0)
    else:
        x=np.maximum(x@weights[0],0)
    first_var=np.sum(weights[0]*weights[0],axis=0)
    true_second=0.5*first_var
    true_mean=np.sqrt(first_var)*INV
    sample_mean=x.mean(axis=0); sample_second=(x*x).mean(axis=0)
    pos_mean=2*sample_mean; pos_second=2*sample_second
    true_pos_mean=2*true_mean; true_pos_second=2*true_second
    spv=np.maximum(pos_second-pos_mean*pos_mean,1e-12)
    tpv=np.maximum(true_pos_second-true_pos_mean*true_pos_mean,1e-12)
    scale=np.sqrt(tpv/spv); shift=true_pos_mean-scale*pos_mean
    corr=x+first_corr*((scale-1)*x+shift)
    x=np.where(x>0,np.maximum(corr,0),0)
    gram=weights[0].T@weights[0]
    std=np.sqrt(np.maximum(np.diag(gram),1e-20))
    rho=gram/(std[:,None]*std[None,:])
    rho=np.clip(rho,-1,1)
    root=np.sqrt(np.maximum(1-rho*rho,0))
    first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
    pre_mean=true_mean@weights[1]
    projected=first_second@weights[1]
    pre_second=np.sum(weights[1]*projected,axis=0)
    second_layer_mean, second_layer_second=gaussian_relu_moments(pre_mean,np.maximum(pre_second-pre_mean*pre_mean,1e-20))
    # optional shrink mean target? not used
    for li,w in enumerate(weights[1:],start=1):
        x=np.maximum(x@w,0)
        if li==1:
            sm=x.mean(axis=0); ss=(x*x).mean(axis=0)
            sv=np.maximum(ss-sm*sm,1e-12)
            tv=np.maximum(second_layer_second-second_layer_mean*second_layer_mean,1e-12)
            scale=np.sqrt(tv/sv)
            target_mean=second_layer_mean*second_mean_corr
            corr=x+second_corr*((scale-1)*x+(target_mean-scale*sm))
            x=np.maximum(corr,0)
    return x.mean(axis=0)

def diag_analytic(weights):
    w0=weights[0]
    var=np.sum(w0*w0,axis=0)
    mean=np.sqrt(var)*INV
    second=0.5*var
    for w in weights[1:]:
        mu=mean@w
        pre_second=second@(w*w)
        var=np.maximum(pre_second-mu*mu,1e-20)
        mean,second=gaussian_relu_moments(mu,var)
    return mean

def target_mc(weights, n=200000, seed=1234, chunk=8192):
    rng=np.random.default_rng(seed)
    width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width),dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(axis=0)
        done+=m
    return (s/n).astype(np.float32)

def make_weights(width,depth,seed):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2/width)
    return [(rng.standard_normal((width,width),dtype=np.float32)*scale).astype(np.float32) for _ in range(depth)]

for width,depth,nmlp,gt in [(64,8,6,300000),(128,8,3,200000)]:
    print('SPEC',width,depth)
    vals=[]
    for i in range(nmlp):
        weights=make_weights(width,depth,1000+i)
        tgt=target_mc(weights,gt,seed=2000+i)
        base=baseline(weights,3000+i,k=24576)
        sphere=None
        diag=diag_analytic(weights)
        vals.append((np.mean((base-tgt)**2),np.mean((diag-tgt)**2)))
        print(i, vals[-1])
    print('mean base diag',np.mean(vals,axis=0))

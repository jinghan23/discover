def weights(w,d,seed):
 rng=np.random.default_rng(seed); scale=math.sqrt(2/w); return [(rng.standard_normal((w,w),dtype=np.float32)*scale).astype(np.float32) for _ in range(d)]
for spec in [(64,8,8,300000),(128,8,4,200000)]:

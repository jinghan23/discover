/bin/bash -lc "python - <<'PY'
# Synthetic check for a third-layer approximate covariance correction.
import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT2PI=math.sqrt(2/math.pi); RELU_ZERO_VAR=0.5-1/(2*math.pi)
def cdf(x): x=np.clip(x,-8,8); y=SQRT2PI*(x+0.044715*x*x*x); return .5*(1+np.tanh(y))
def gm(mu,var):
 s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); p=INV*np.exp(-.5*a*a); c=cdf(a); m=s*p+mu*c; sec=(var+mu*mu)*c+mu*s*p; return m,np.maximum(sec,m*m)
def relu_second_matrix(mu, pre_second):
 diag=np.diag(pre_second); var=np.maximum(diag-mu*mu,1e-20); mean, second=gm(mu,var)
 std=np.sqrt(var); cov=pre_second-mu[:,None]*mu[None,:]; rho=np.clip(cov/(std[:,None]*std[None,:]),-1,1)
 root=np.sqrt(np.maximum(1-rho*rho,0)); zero_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
 zero_mean=std*INV; zero_cov=zero_second-zero_mean[:,None]*zero_mean[None,:]
 zero_var=np.maximum(RELU_ZERO_VAR*var,1e-20); relu_var=np.maximum(second-mean*mean,1e-20); scale=np.sqrt(relu_var/zero_var)
 out=zero_cov*(scale[:,None]*scale[None,:])+mean[:,None]*mean[None,:]
 # force diag exact
 idx=np.arange(len(mu)); out[idx,idx]=second
 return mean,out,second
def normal_lattice(half,w,seed):
 rng=np.random.default_rng(seed+17); p=w//2; i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(p,dtype=np.float32)+1)[None,:]
 s1=rng.random((1,p),dtype=np.float32); s2=rng.random((1,p),dtype=np.float32)
 u1=np.mod(i*np.sqrt(2*j+1)*0.754877666+s1,1); u2=np.mod(i*np.sqrt(2*j+2)*0.569840291+s2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; z=np.concatenate([r*np.cos(a),r*np.sin(a)],1).astype(np.float32)
 if w&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],1)
 return z
def targets(ws):
 W0=ws[0]; fv=np.sum(W0*W0,0); tm=np.sqrt(fv)*INV; gram=W0.T@W0; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); S=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
 outs=[]
 for W in ws[1:]:
  pre_m=tm@W; pre_S=W.T@S@W; tm,S,sec=relu_second_matrix(pre_m,pre_S); outs.append((tm,sec))
 return outs
def pred(ws,seed,k=24576, c2=.3,c3=0):
 w=ws[0].shape[0]; u=normal_lattice(k//2,w,seed); x=np.concatenate([u,-u],0); cov=(u.T@u)/(k//2); ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; x=np.maximum(x@(inv@ws[0]),0)
 fv=np.sum(ws[0]*ws[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts; sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); sh=tpm-sc*pm; x=np.where(x>0,np.maximum(x+1.05*((sc-1)*x+sh),0),0)
 corr_targets=targets(ws[:3]) if len(ws)>2 and c3 else targets(ws[:2])
 # Always need layer2 exact-ish target from targets[0]
 if not corr_targets: corr_targets=targets(ws[:2])
 for li,W in enumerate(ws[1:],1):
  x=np.maximum(x@W,0)
  coeff=0
  if li==1: coeff=c2; tm2,sec2=targets(ws[:2])[0]
  elif li==2 and c3: coeff=c3; tm2,sec2=targets(ws[:3])[1]
  else: continue
  if coeff:
   sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-12); tv=np.maximum(sec2-tm2*tm2,1e-12); scl=np.sqrt(tv/sv); x=np.maximum(x+coeff*((scl-1)*x+(tm2-scl*sm)),0)
 return x.mean(0)
def target(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(8192,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws:x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
def weights(w,d,seed):
 rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w),dtype=np.float32)*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
for spec in [(64,8,5,300000),(128,8,3,200000),(64,16,3,200000)]:

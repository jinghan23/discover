import numpy as np, math, time
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT2PI=math.sqrt(2/math.pi)
def cdf(x): x=np.clip(x,-8,8); y=SQRT2PI*(x+0.044715*x*x*x); return .5*(1+np.tanh(y))
def gm(mu,var):
 s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); p=INV*np.exp(-.5*a*a); c=cdf(a); m=s*p+mu*c; sec=(var+mu*mu)*c+mu*s*p; return m,np.maximum(sec,m*m)
def block(count,w,s1,s2):
 p=w//2; i=(np.arange(count,dtype=np.float32)+.5)[:,None]; j=(np.arange(p,dtype=np.float32)+1)[None,:]
 u1=np.mod(i*np.sqrt(2*j+1)*0.754877666+s1,1); u2=np.mod(i*np.sqrt(2*j+2)*0.569840291+s2,1); u1=np.clip(u1,1e-7,1-1e-7)

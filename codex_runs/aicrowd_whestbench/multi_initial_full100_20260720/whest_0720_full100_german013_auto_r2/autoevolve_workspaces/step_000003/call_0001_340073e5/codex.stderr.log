 for b in range(blocks):
  c=rem//(blocks-b); rem-=c
  s1=rng.random((1,p),dtype=np.float32); s2=rng.random((1,p),dtype=np.float32); outs.append(block(c,w,s1,s2))
 z=np.concatenate(outs,0)
 if w&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],1)
 return z
def pred(ws, seed, blocks=1, k=24576):
 w=ws[0].shape[0]; u=lattice(k//2,w,seed,blocks); x=np.concatenate([u,-u],0)
 cov=(u.T@u)/(k//2); ev,vec=np.linalg.eigh(cov); inv=(vec/np.sqrt(np.maximum(ev,1e-6)))@vec.T; x=np.maximum(x@(inv@ws[0]),0)
 fv=np.sum(ws[0]*ws[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv
 sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*tm; tps=2*ts
 sc=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); sh=tpm-sc*pm; x=np.where(x>0,np.maximum(x+1.05*((sc-1)*x+sh),0),0)
 gram=ws[0].T@ws[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
 fs=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI; pre=tm@ws[1]; proj=fs@ws[1]; pre2=np.sum(ws[1]*proj,0); m2,s2=gm(pre,np.maximum(pre2-pre*pre,1e-20))
 for li,W in enumerate(ws[1:],1):
  x=np.maximum(x@W,0)
  if li==1:
   sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-12); tv=np.maximum(s2-m2*m2,1e-12); scl=np.sqrt(tv/sv); x=np.maximum(x+.30*((scl-1)*x+(m2-scl*sm)),0)
 return x.mean(0)
def target(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(8192,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m

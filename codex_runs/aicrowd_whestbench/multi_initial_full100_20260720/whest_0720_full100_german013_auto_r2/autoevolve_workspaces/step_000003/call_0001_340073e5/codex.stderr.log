    else: x=np.maximum(x@weights[0],0)
    first_var=np.sum(weights[0]*weights[0],axis=0); true_second=0.5*first_var; true_mean=np.sqrt(first_var)*INV
    if fc:
      sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; tpm=2*true_mean; tps=2*true_second
      scale=np.sqrt(np.maximum(tps-tpm*tpm,1e-12)/np.maximum(ps-pm*pm,1e-12)); shift=tpm-scale*pm
      corr=x+fc*((scale-1)*x+shift); x=np.where(x>0,np.maximum(corr,0),0)
    if second and len(weights)>1:
      gram=weights[0].T@weights[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0))
      first_second=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI
      pre_mean=true_mean@weights[1]; projected=first_second@weights[1]; pre_second=np.sum(weights[1]*projected,axis=0)
      target_mean,target_second=gaussian_relu_moments(pre_mean,np.maximum(pre_second-pre_mean*pre_mean,1e-20))
    for li,w in enumerate(weights[1:],start=1):
      x=np.maximum(x@w,0)
      if li==1 and second and sc:
        sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-12); tv=np.maximum(target_second-target_mean*target_mean,1e-12)
        # Blend scale and shift toward exact target.
        scale=np.sqrt(tv/sv)
        scale=1.0+second_var_weight*(scale-1.0)
        mean_target=sm+second_mean_weight*(target_mean-sm)
        corr=x+sc*((scale-1)*x+(mean_target-scale*sm))
        x=np.maximum(corr,0) if post_clip else corr
    return x.mean(0)
def target_mc(weights,n,seed,chunk=8192):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width,np.float64); done=0
    while done<n:
      m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
      for w in weights: x=np.maximum(x@w,0)
      s+=x.astype(np.float64).sum(0); done+=m
    return (s/n).astype(np.float32)
def make_weights(width,depth,seed):
    rng=np.random.default_rng(seed); scale=math.sqrt(2/width); return [(rng.standard_normal((width,width),dtype=np.float32)*scale).astype(np.float32) for _ in range(depth)]
# Dataset
specs=[(64,8,6,400000),(128,8,4,300000)]
data=[]
for width,depth,nmlp,gt in specs:
    for i in range(nmlp):

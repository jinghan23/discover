# Synthetic test of a covariance-coloring correction after layer 2.
import numpy as np, math
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT2PI=math.sqrt(2/math.pi); ZERO_VAR=.5-1/(2*math.pi)
def cdf(x): x=np.clip(x,-8,8); return .5*(1+np.tanh(SQRT2PI*(x+0.044715*x*x*x)))
def gm(mu,var):
 s=np.sqrt(np.maximum(var,1e-20)); a=np.clip(mu/s,-8,8); p=INV*np.exp(-.5*a*a); c=cdf(a); m=s*p+mu*c; sec=(var+mu*mu)*c+mu*s*p; return m,np.maximum(sec,m*m)
def relu_mat(mu,preS):
 var=np.maximum(np.diag(preS)-mu*mu,1e-20); mean,sec=gm(mu,var); std=np.sqrt(var); cov=preS-mu[:,None]*mu[None,:]; rho=np.clip(cov/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); zsec=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI; zmean=std*INV; zcov=zsec-zmean[:,None]*zmean[None,:]; sc=np.sqrt(np.maximum(sec-mean*mean,1e-20)/np.maximum(ZERO_VAR*var,1e-20)); S=zcov*(sc[:,None]*sc[None,:])+mean[:,None]*mean[None,:]; idx=np.arange(len(mu)); S[idx,idx]=sec; return mean,sec,S
def lat(half,w,seed):
 rng=np.random.default_rng(seed+17); p=w//2; i=(np.arange(half,dtype=np.float32)+.5)[:,None]; j=(np.arange(p,dtype=np.float32)+1)[None,:]; s1=rng.random((1,p),dtype=np.float32); s2=rng.random((1,p),dtype=np.float32); u1=np.mod(i*np.sqrt(2*j+1)*0.754877666+s1,1); u2=np.mod(i*np.sqrt(2*j+2)*0.569840291+s2,1); u1=np.clip(u1,1e-7,1-1e-7); r=np.sqrt(-2*np.log(u1)); a=TWO_PI*u2; return np.concatenate([r*np.cos(a),r*np.sin(a)],1).astype(np.float32)
def pred(ws,seed,beta=0):
 k=24576; w=ws[0].shape[0]; u=lat(k//2,w,seed); x=np.concatenate([u,-u],0); ev,V=np.linalg.eigh((u.T@u)/(k//2)); inv=(V/np.sqrt(np.maximum(ev,1e-6)))@V.T; x=np.maximum(x@(inv@ws[0]),0); fv=np.sum(ws[0]*ws[0],0); tm=np.sqrt(fv)*INV; ts=.5*fv; sm=x.mean(0); ss=(x*x).mean(0); pm=2*sm; ps=2*ss; scl=np.sqrt(np.maximum(2*ts-(2*tm)**2,1e-12)/np.maximum(ps-pm*pm,1e-12)); sh=2*tm-scl*pm; x=np.where(x>0,np.maximum(x+((scl-1)*x+sh),0),0)
 gram=ws[0].T@ws[0]; std=np.sqrt(np.maximum(np.diag(gram),1e-20)); rho=np.clip(gram/(std[:,None]*std[None,:]),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); S1=(std[:,None]*std[None,:])*(root+(PI-np.arccos(rho))*rho)/TWO_PI; pre=tm@ws[1]; preS=ws[1].T@(S1@ws[1]); m2,sec2,S2=relu_mat(pre,preS)
 for li,W in enumerate(ws[1:],1):
  x=np.maximum(x@W,0)
  if li==1:
   sm=x.mean(0); ss=(x*x).mean(0); sv=np.maximum(ss-sm*sm,1e-12); tv=np.maximum(sec2-m2*m2,1e-12); sc=np.sqrt(tv/sv); x=np.maximum(x+.3*((sc-1)*x+(m2-sc*sm)),0)
   if beta:
    sm=x.mean(0); C=(x.T@x)/k-sm[:,None]*sm[None,:]
    Ct=S2-m2[:,None]*m2[None,:]
    evs,Vs=np.linalg.eigh(C+1e-6*np.eye(w)); evt,Vt=np.linalg.eigh(Ct+1e-8*np.eye(w)); A=(Vs/np.sqrt(np.maximum(evs,1e-8)))@Vs.T@(Vt*np.sqrt(np.maximum(evt,1e-8)))@Vt.T
    y=(x-sm)@A+m2
    x=np.maximum((1-beta)*x+beta*y,0)
 return x.mean(0)
def target(ws,n,seed):
 rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(8192,n-done); x=rng.standard_normal((m,w),dtype=np.float32)
  for W in ws:x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
def weights(w,d,seed):

/bin/bash -lc "python - <<'PY'
import numpy as np, math, itertools, time
TWO_PI=2*math.pi; PI=math.pi; INV=1/math.sqrt(2*math.pi); SQRT2PI=math.sqrt(2/math.pi)
def normal_cdf(x):
    x=np.clip(x,-8,8); y=SQRT2PI*(x+0.044715*x*x*x); return 0.5*(1+np.tanh(y))
def gaussian_relu_moments(mu,var):
    sigma=np.sqrt(np.maximum(var,1e-20)); alpha=np.clip(mu/sigma,-8,8); phi=INV*np.exp(-0.5*alpha*alpha); cdf=normal_cdf(alpha); mean=sigma*phi+mu*cdf; second=(var+mu*mu)*cdf+mu*sigma*phi; return mean,np.maximum(second,mean*mean)
def lattice_block(count,width,shift1,shift2,a=0.754877666,b=0.569840291):
    pairs=width//2; i=(np.arange(count,dtype=np.float32)+0.5)[:,None]; j=(np.arange(pairs,dtype=np.float32)+1.0)[None,:]
    u1=np.mod(i*np.sqrt(2*j+1)*a+shift1,1.0); u2=np.mod(i*np.sqrt(2*j+2)*b+shift2,1.0); u1=np.clip(u1,1e-7,1-1e-7)
    r=np.sqrt(-2*np.log(u1)); ang=TWO_PI*u2
    return np.concatenate([r*np.cos(ang),r*np.sin(ang)],axis=1).astype(np.float32)
def lattice_normal(half,width,seed,offset=17,a=0.754877666,b=0.569840291):
    rng=np.random.default_rng(seed+offset); pairs=width//2; s1=rng.random((1,pairs),dtype=np.float32); s2=rng.random((1,pairs),dtype=np.float32); z=lattice_block(half,width,s1,s2,a,b)
    if width&1: z=np.concatenate([z,rng.standard_normal((half,1),dtype=np.float32)],axis=1)
    return z
def pred(weights, seed, k=24576, fc=1.05, sc=0.30, offset=17, whiten=True, second=True, second_mean_weight=1.0, second_var_weight=1.0, post_clip=True):
    width=weights[0].shape[0]; depth=len(weights)
    if depth==1: return np.sqrt(np.sum(weights[0]*weights[0],axis=0))*INV
    u=lattice_normal(k//2,width,seed,offset); x=np.concatenate([u,-u],axis=0)
    if whiten:

```python
from __future__ import annotations

import math

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.092
_TAIL_CLIP = 1e-11
_ARRAY_BYTES_LIMIT = 96 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8


def _first_primes(count: int) -> tuple[int, ...]:
    primes = []
    candidate = 2
    while len(primes) < count:
        ok = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                ok = False
                break
        if ok:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


def _lattice_generator(width: int) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    return roots - fnp.floor(roots)


def _lattice_uniforms(n_samples: int, generator: fnp.ndarray, shift: fnp.ndarray) -> fnp.ndarray:
    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    values = indices * generator[None, :] + shift[None, :]
    return values - fnp.floor(values)


def _sample_pair_count(budget, width: int, depth: int) -> int:
    if budget is None:
        budget = 10_000_000

    lattice_per_pair = 96 * width
    normalize_per_pair = 6 * width
    forward_per_pair = 2 * depth * (2 * width * width + width)
    mean_per_pair = 2 * max(depth - 1, 0) * width
    per_pair = lattice_per_pair + normalize_per_pair + forward_per_pair + mean_per_pair

    fixed = 2 * width * width + 16 * width + 256
    n_pairs = (int(_TARGET_FLOP_FRACTION * int(budget)) - fixed) // max(per_pair, 1)

    max_by_bytes = _ARRAY_BYTES_LIMIT // max(2 * width * _FLOAT64_ITEMSIZE, 1)
    return int(max(1, min(n_pairs, max_by_bytes)))


def _exact_first_layer_mean(weight: fnp.ndarray) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.sum(weight * weight, axis=0))
    return sigma / fnp.sqrt(2.0 * fnp.pi)


def _scaled_chi_moments(width: int, depth: int) -> tuple[float, ...]:
    if depth <= 0:
        return ()

    moments = [1.0] * (depth + 1)
    moments[1] = math.exp(
        0.5 * (math.log(2.0) - math.log(float(width)))
        + math.lgamma(0.5 * (width + 1.0))
        - math.lgamma(0.5 * width)
    )
    for order in range(depth - 1):
        moments[order + 2] = moments[order] * ((width + order) / float(width))
    return tuple(moments[1:])


class Estimator(BaseEstimator):
    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        n_pairs = _sample_pair_count(budget, width, depth)

        rng = fnp.random.default_rng(mlp.seed)
        generator = _lattice_generator(width)
        shift = rng.random(width)

        uniforms = _lattice_uniforms(n_pairs, generator, shift)
        uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)

        normals = flops.stats.norm.ppf(uniforms)
        norms = fnp.sqrt(fnp.sum(normals * normals, axis=1, keepdims=True))
        directions = normals * (math.sqrt(float(width)) / norms)
        activations = fnp.concatenate((directions, -directions), axis=0)

        radial = _scaled_chi_moments(width, depth)
        denom = float(2 * n_pairs)

        rows = []
        first_exact = None

        for layer_index, weight in enumerate(mlp.weights):
            activations = fnp.maximum(activations @ weight, 0.0)

            if layer_index == 0:
                first_exact = _exact_first_layer_mean(weight)
                rows.append(first_exact)

                target_direction_mean = first_exact / radial[0]
                sample_direction_mean = fnp.mean(activations, axis=0)
                scale = target_direction_mean / fnp.maximum(sample_direction_mean, 1e-30)
                scale = fnp.clip(scale, 0.5, 2.0)
                activations = activations * scale[None, :]
            else:
                direction_mean = fnp.sum(activations, axis=0) / denom
                rows.append(direction_mean * radial[layer_index])

        return fnp.stack(rows, axis=0)
```

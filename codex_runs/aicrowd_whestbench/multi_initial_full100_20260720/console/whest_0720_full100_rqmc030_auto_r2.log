        rng = fnp.random.default_rng(mlp.seed + _SEED_OFFSET)
        generator = _lattice_generator(mlp.width)
        uniforms = fnp.concatenate(
            tuple(
                _lattice_uniforms(n_per_shift, generator, rng.random(mlp.width))
                for _ in range(_SHIFT_COUNT)

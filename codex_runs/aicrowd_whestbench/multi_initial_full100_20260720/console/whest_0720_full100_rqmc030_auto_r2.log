                activation_fourth_sum = fnp.sum(
                    first_activations
                    * first_activations
                    * first_activations
                    * first_activations,
                    axis=1,
                )
                controls = fnp.stack(
                    (
                        activation_sum,
                        activation_square_sum,
                        activation_fourth_sum,
                        first_preactivation_square_sum,

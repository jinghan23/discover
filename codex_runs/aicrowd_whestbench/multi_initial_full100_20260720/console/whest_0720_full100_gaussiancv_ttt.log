        final_mc = fnp.sum(fnp.maximum(z64, 0.0), axis=0) / float(n_samples)
        final = 0.99965 * (
            1.03700 * final_mc
            - 0.0425 * final_gauss
            + 0.00550 * final_mixed_diag
        )


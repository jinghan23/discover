        final = 0.99965 * (
            1.03700 * final_mc
            - 0.0425 * final_gauss
            + 0.00550 * final_mixed_diag
        )

        return fnp.asarray(
            fnp.stack(list(diag_rows[:-1]) + [final], axis=0),

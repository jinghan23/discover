    c1c = c1 - c1_mean
    n_pairs = c1.shape[0]
    width = c1.shape[1]

    gram1 = c1c @ c1c.T
    ridge1 = _ridge_for_centered(c1c, width, n_pairs, 0.012, 0.8)

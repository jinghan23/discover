import numpy as np
from scipy.special import ndtr

PHI0=0.3989422804014327
INV2PI=0.15915494309189535
PI=np.pi

def first_relu_cov(w):
    cov_pre=w.T@w
    var_pre=np.maximum(np.diag(cov_pre),1e-12)
    sigma=np.sqrt(var_pre)
    denom=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
    rho=np.clip(cov_pre/denom,-0.999999,0.999999)
    kernel=(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)*INV2PI
    second=denom*kernel
    mean=sigma*PHI0
    return second-mean[:,None]*mean[None,:]

def analytic(weights, skew1=1.0, fullvar1=True):
    width=weights[0].shape[0]
    mu=np.zeros(width)
    var=np.ones(width)
    rows=[]; vars=[]; first_cov=None; tau3=None
    for i,w in enumerate(weights):
        mu_pre=w.T@mu
        if i==1 and first_cov is not None:
            var_pre=np.maximum(np.sum(w*(first_cov@w),axis=0),1e-12)
        else:
            var_pre=np.maximum((w*w).T@var,1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=np.exp(-0.5*alpha*alpha)*PHI0
        cdf=ndtr(alpha)
        mu=mu_pre*cdf+sigma*phi
        if i==1 and tau3 is not None and skew1:
            kappa3=np.sum((w*w*w)*tau3[:,None],axis=0)
            skew=kappa3/np.maximum(var_pre*sigma,1e-12)
            mu=mu-skew1*(mu_pre*phi*skew)/6.0
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
        if i==0 and fullvar1:
            first_cov=first_relu_cov(w)
            tau3=sigma**3*PHI0*(0.5+1/np.pi)
    return np.array(rows), np.array(vars)

def candidate(weights, seed=0, n=1024, b0=.5,b1=.6, b_more=0, gam=1.0, radial=True, skew1=1.0, offset=0, match_layers=2):
    width=weights[0].shape[0]
    depth=len(weights)
    rows,vars=analytic(weights,skew1=skew1)
    rng=np.random.default_rng(seed+offset)
    half=n//2
    base=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([base,-base],axis=0)
    x=x-x.mean(axis=0)
    q,_=np.linalg.qr(x,mode='reduced')
    if radial:
        raw_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1),1e-12))[:,None]
        q_norm=np.sqrt(np.maximum(np.sum(q*q,axis=1),1e-12))[:,None]
        x=q*(raw_norm/q_norm)
        x=x-x.mean(axis=0)
        x_var=np.maximum(np.mean(x*x,axis=0),1e-12)
        x=x*np.sqrt(1/x_var)
    else:
        x=q*np.sqrt(float(n))
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        beta=0
        if i==0: beta=b0
        elif i==1: beta=b1
        elif i<match_layers: beta=b_more
        if beta"'!=0:
            xc=x-x.mean(axis=0)
            xv=np.maximum(np.mean(xc*xc,axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    final=np.maximum(x@weights[-1],0).mean(axis=0)
    return gam*final+(1-gam)*rows[-1]

def target(weights, seed=123, n=200000, batch=20000):
    rng=np.random.default_rng(seed)
    acc=np.zeros(weights[0].shape[0])
    cnt=0
    for _ in range(n//batch):
        x=rng.standard_normal((batch,weights[0].shape[0])).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        acc += x.mean(axis=0)*batch
        cnt += batch
    return acc/cnt

def trial(width=64,depth=5,n=1024,scale='"'fan'):
    rng=np.random.default_rng(999)
    nets=[]; tgts=[]
    for k in range(10):
        if scale=='fan':
            ws=[rng.standard_normal((width,width)).astype(np.float32)/np.sqrt(width) for _ in range(depth)]
        elif scale=='he':
            ws=[rng.standard_normal((width,width)).astype(np.float32)*np.sqrt(2/width) for _ in range(depth)]
        nets.append(ws); tgts.append(target(ws,seed=1000+k,n=100000,batch=10000))
    configs=[]
    for gam in [1.0,.95,.9,.85,.8,.7,1.05]:
      configs.append(('gam'+str(gam),dict(gam=gam)))
    for b0 in [.3,.4,.5,.6,.7]:
      for b1 in [.4,.5,.6,.7,.8]:
        configs.append((f'b{b0}_{b1}',dict(b0=b0,b1=b1)))
    for bm in [.1,.2,.3,.5]: configs.append((f'more{bm}',dict(b_more=bm,match_layers=depth-1)))
    for sk in [0,.5,1,1.5,2]: configs.append((f'sk{sk}',dict(skew1=sk)))
    configs.append(('norad',dict(radial=False)))
    best=[]
    for name,kw in configs:
        ms=[]
        for i,(ws,t) in enumerate(zip(nets,tgts)):
            p=candidate(ws,seed=42+i,n=n,**kw)
            ms.append(np.mean((p-t)**2))
        best.append((np.mean(ms),name))
    best.sort()
    print('width depth n scale',width,depth,n,scale)
    for m,name in best[:20]: print(m,name)

for scale in ['fan','he']:
  trial(64,5,1024,scale)

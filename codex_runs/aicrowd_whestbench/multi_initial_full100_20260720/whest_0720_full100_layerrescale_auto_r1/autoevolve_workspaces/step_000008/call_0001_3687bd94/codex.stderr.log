import numpy as np
from scipy.special import ndtr
PHI0=0.3989422804014327; INV2PI=0.15915494309189535; PI=np.pi

def first_relu_cov(w):
    cov_pre=w.T@w; var_pre=np.maximum(np.diag(cov_pre),1e-12); sigma=np.sqrt(var_pre)
    denom=np.maximum(sigma[:,None]*sigma[None,:],1e-12); rho=np.clip(cov_pre/denom,-.999999,.999999)
    second=denom*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)*INV2PI
    mean=sigma*PHI0; return second-mean[:,None]*mean[None,:]

def analytic(ws, skew1=1.0):
    W=ws[0].shape[0]; mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]; cov=None; tau=None
    for i,w in enumerate(ws):
      mup=w.T@mu
      if i==1 and cov is not None: vp=np.maximum(np.sum(w*(cov@w),axis=0),1e-12)
      else: vp=np.maximum((w*w).T@var,1e-12)
      sig=np.sqrt(vp); a=mup/sig; phi=np.exp(-.5*a*a)*PHI0; c=ndtr(a); mu=mup*c+sig*phi
      if i==1 and tau is not None and skew1:
        k3=np.sum((w*w*w)*tau[:,None],axis=0); skew=k3/np.maximum(vp*sig,1e-12); mu=mu-skew1*mup*phi*skew/6
      ez2=(mup*mup+vp)*c+mup*sig*phi; var=np.maximum(ez2-mu*mu,0)
      rows.append(mu.copy()); vars.append(var.copy())
      if i==0: cov=first_relu_cov(w); tau=sig**3*PHI0*(.5+1/np.pi)
    return np.array(rows),np.array(vars)

def cand(ws,seed,n,betas,center_each=False,scale_input=True,radial=True,final_mm=False,last_beta=0):
    rows,vars=analytic(ws); W=ws[0].shape[0]; rng=np.random.default_rng(seed); half=n//2
    base=rng.standard_normal((half,W)).astype(np.float32); x=np.concatenate([base,-base])
    x=x-x.mean(0)
    q,_=np.linalg.qr(x,mode='reduced')
    if radial:
      rn=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]
      x=q*(rn/qn); x=x-x.mean(0); xv=np.maximum((x*x).mean(0),1e-12); x=x*np.sqrt(1/xv)
    else: x=q*np.sqrt(float(n))
    for i,w in enumerate(ws[:-1]):
      x=np.maximum(x@w,0)
      beta=betas[i] if i<len(betas) else 0
      if beta:
        xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
        xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
        x=(1-beta)*x+beta*xm
      elif center_each:
        # mean-only centering to analytic? not used maybe
        pass
    final=np.maximum(x@ws[-1],0)
    if final_mm and last_beta:
      i=len(ws)-1; xc=final-final.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
      fm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
      final=(1-last_beta)*final+last_beta*fm
    return final.mean(0)

def target(ws,seed,n=120000,batch=10000):
  rng=np.random.default_rng(seed); acc=np.zeros(ws[0].shape[0]); cnt=0
  for _ in range(n//batch):
    x=rng.standard_normal((batch,ws[0].shape[0])).astype(np.float32)
    for w in ws: x=np.maximum(x@w,0)
    acc+=x.sum(0); cnt+=x.shape[0]
  return acc/cnt

def run(W,D,N,scale):
  rng=np.random.default_rng(1234+W+D); nets=[]; tgts=[]
  for k in range(12):
    fac=(1/np.sqrt(W)) if scale=='fan' else np.sqrt(2/W)
    ws=[(rng.standard_normal((W,W))*fac).astype(np.float32) for _ in range(D)]
    nets.append(ws); tgts.append(target(ws,2000+k,n=100000 if W<=64 else 60000))
  configs=[]
  configs.append(('base',[.5,.6],{}))
  # schedules
  for b0 in [.3,.4,.5,.6,.7,.8]:
    for b1 in [.3,.4,.5,.6,.7,.8]: configs.append((f'b{b0}-{b1}',[b0,b1],{}))
  for bm in [.05,.1,.15,.2,.3,.4,.5,.7,1.0]: configs.append((f'more{bm}',[.5,.6]+[bm]*(D-2),{}))
  for sched in [[.5,.6,.3,.15,.075,.03,.0],[.5,.6,.2,.2,.2,.2,.2],[.5,.6,.4,.3,.2,.1,.05],[.7,.5,.3,.2,.1,.05,.0],[.4,.7,.3,.2,.1,.0]]:
    configs.append(('sched'+','.join(map(str,sched)),sched,{}))
  for lb in [.05,.1,.2,.3,.5]: configs.append((f'finalmm{lb}',[.5,.6],{'final_mm':True,'last_beta':lb}))
  out=[]
  for name,betas,kw in configs:
    ms=[]
    for i,(ws,t) in enumerate(zip(nets,tgts)):
      p=cand(ws,42+i,N,betas,**kw); ms.append(((p-t)**2).mean())
    out.append((np.mean(ms),name))
  out.sort(); print('\\nW,D,N,scale',W,D,N,scale)
  for m,nm in out[:18]: print(f'{m:.6g}',nm)
for D in [4,6,8,10]:
  run(64,D,1024,'fan')

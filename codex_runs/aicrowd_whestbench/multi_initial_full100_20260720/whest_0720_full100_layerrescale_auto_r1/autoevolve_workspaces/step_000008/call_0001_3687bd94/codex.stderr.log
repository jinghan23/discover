# Quick synthetic beta sweep with skew2 correction enabled.
import numpy as np
from scipy.special import ndtr
PHI0=0.3989422804014327; INV2PI=0.15915494309189535; PI=np.pi
def fcov(w):
 c=w.T@w; v=np.maximum(np.diag(c),1e-12); s=np.sqrt(v); d=np.maximum(s[:,None]*s[None,:],1e-12); r=np.clip(c/d,-.999999,.999999); sec=d*(np.sqrt(np.maximum(1-r*r,0))+(PI-np.arccos(r))*r)*INV2PI; m=s*PHI0; return sec-m[:,None]*m[None,:]
def analytic(ws):
 W=ws[0].shape[0]; mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]; cov=None; tau=None
 for i,w in enumerate(ws):
  mp=w.T@mu; vp=np.maximum(np.sum(w*(cov@w),0) if i==1 and cov is not None else (w*w).T@var,1e-12); sg=np.sqrt(vp); a=mp/sg; phi=np.exp(-.5*a*a)*PHI0; c=ndtr(a); mu=mp*c+sg*phi; skew=None
  if i==1 and tau is not None:
   k3=np.sum((w*w*w)*tau[:,None],0); skew=k3/np.maximum(vp*sg,1e-12); mu=mu-mp*phi*skew/6
  ez2=(mp*mp+vp)*c+mp*sg*phi
  if i==1 and tau is not None:
   ez2=ez2+skew*vp*phi/3
  var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
  if i==0: cov=fcov(w); tau=sg**3*PHI0*(.5+1/np.pi)
 return np.array(rows),np.array(vars)
def cand(ws,t,b0,b1,n=1024):
 rows,vars=analytic(ws); W=ws[0].shape[0]; rng=np.random.default_rng(42); half=n//2; base=rng.standard_normal((half,W)).astype(np.float32); x=np.concatenate([base,-base]); x=x-x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); rn=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]; x=q*(rn/qn); x=x-x.mean(0); xv=np.maximum((x*x).mean(0),1e-12); x=x*np.sqrt(1/xv)
 for i,w in enumerate(ws[:-1]):
  x=np.maximum(x@w,0); beta=b0 if i==0 else (b1 if i==1 else 0)
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return ((np.maximum(x@ws[-1],0).mean(0)-t)**2).mean()
def tgt(ws,n=80000):
 rng=np.random.default_rng(19); acc=np.zeros(ws[0].shape[0]); cnt=0
 for _ in range(n//10000):
  x=rng.standard_normal((10000,ws[0].shape[0])).astype(np.float32)
  for w in ws: x=np.maximum(x@w,0)
  acc+=x.sum(0); cnt+=len(x)
 return acc/cnt
configs=[(.5,.6),(.5,.5),(.5,.7),(.4,.6),(.6,.6),(.4,.7),(.6,.5),(.7,.5),(.7,.6)]
for W,D in [(64,4),(64,6),(128,4),(128,6)]:
 vals={c:[] for c in configs}; rng=np.random.default_rng(111+W+D)
 for k in range(8):
  ws=[(rng.standard_normal((W,W))/np.sqrt(W)).astype(np.float32) for _ in range(D)]; t=tgt(ws,n=80000 if W==64 else 50000)
  for c in configs: vals[c].append(cand(ws,t,*c))
 print('\\n',W,D)
 for c in sorted(vals,key=lambda c:np.mean(vals[c]))[:8]: print(c,np.mean(vals[c]))

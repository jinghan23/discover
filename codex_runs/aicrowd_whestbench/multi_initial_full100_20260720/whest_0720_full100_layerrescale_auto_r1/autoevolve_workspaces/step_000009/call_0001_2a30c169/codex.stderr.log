/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import pi
PHI0=1/np.sqrt(2*pi)
def pdf(x): return np.exp(-.5*x*x)*PHI0
def fcov(w):
 c=w.T@w; v=np.maximum(np.diag(c),1e-12); s=np.sqrt(v); d=np.maximum(s[:,None]*s[None,:],1e-12); r=np.clip(c/d,-.999999,.999999); k=(np.sqrt(np.maximum(1-r*r,0))+(pi-np.arccos(r))*r)/(2*pi); return d*k-(s*PHI0)[:,None]*(s*PHI0)[None,:]
def diag(weights):
 width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; fc=None; pt=None
 for li,w in enumerate(weights):
  mup=w.T@mu; vp=np.maximum(np.sum(w*(fc@w),0),1e-12) if li==1 and fc is not None else np.maximum((w*w).T@var,1e-12)
  sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=ndtr(a); mu=mup*cd+sig*ph; sk=None
  if li==1 and pt is not None:
   k3=np.sum((w*w*w)*pt[:,None],0); sk=k3/np.maximum(vp*sig,1e-12); mu=mu-(mup*ph*sk)/6
  ez=(mup*mup+vp)*cd+mup*sig*ph
  if li==1 and pt is not None: ez=ez+sk*vp*ph/3
  var=np.maximum(ez-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
  if li==0: fc=fcov(w); pt=sig**3*PHI0*(.5+1/pi)
 return rows,vars,fc
def make_x(width,n,seed):
 rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); x=np.r_[base,-base].astype(np.float64); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); raw=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]; x=q*(raw/qn); x-=x.mean(0); xv=np.maximum((x*x).mean(0),1e-12); x*=np.sqrt(1/xv); return x
def full_match(x,mu,target_cov):
 xc=x-x.mean(0); s=(xc.T@xc)/x.shape[0]
 vals,vecs=np.linalg.eigh(s); inv=(vecs*(1/np.sqrt(np.maximum(vals,1e-12))))@vecs.T
 tv,tvcs=np.linalg.eigh(target_cov); root=(tvcs*np.sqrt(np.maximum(tv,1e-12)))@tvcs.T
 return xc@inv@root+mu
def pred(weights,n=1024,seed=0,b0=.480,b1=.64,mode='diag'):
 rows,vars,fc=diag(weights); width=weights[0].shape[0]; x=make_x(width,n,seed)
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  if i==0:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); dm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
   if mode=='full': xm=full_match(x,rows[i],fc)
   elif mode=='half_full': xm=.5*dm+.5*full_match(x,rows[i],fc)
   else: xm=dm
   x=(1-b0)*x+b0*xm
  elif i==1:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-b1)*x+b1*xm
 return np.maximum(x@weights[-1],0).mean(0)
def truth(weights,n=200000,seed=1):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); c=0; bs=50000
 while c<n:
  m=min(bs,n-c); c+=m; x=rng.standard_normal((m,width))
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return s/n
def run(w=64,d=6,scale='xavier'):
 modes=['diag','half_full','full']; b0s=[.1,.25,.48,1.0]
 errs={(m,b):[] for m in modes for b in b0s}
 rng=np.random.default_rng(55)
 for mi in range(5):
  sd=(2/w)**.5 if scale=='he' else 1/w**.5; weights=[rng.standard_normal((w,w))*sd for _ in range(d)]; t=truth(weights,seed=800+mi)
  for m,b in errs: errs[(m,b)].append(np.mean((pred(weights,seed=mi+17,b0=b,mode=m)-t)**2))
 print('case',w,d,scale)
 for g,v in sorted(errs.items(), key=lambda kv: np.mean(kv[1]))[:10]: print(g,np.mean(v))
 print('base diag .48',np.mean(errs[('diag',.48)]))
for scale in ['xavier','he']:
 for d in [4,6,8]: run(64,d,scale)

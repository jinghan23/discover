 for li,w in enumerate(weights):
  mup=w.T@mu; vp=np.maximum(np.sum(w*(fc@w),0),1e-12) if li==1 and fc is not None else np.maximum((w*w).T@var,1e-12)
  sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=ndtr(a); mu=mup*cd+sig*ph; sk=None
  if li==1 and pt is not None:
   k3=np.sum((w*w*w)*pt[:,None],0); sk=k3/np.maximum(vp*sig,1e-12); mu=mu-(mup*ph*sk)/6
  ez=(mup*mup+vp)*cd+mup*sig*ph
  if li==1 and pt is not None: ez=ez+sk*vp*ph/3
  var=np.maximum(ez-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
  if li==0: fc=fcov(w); pt=sig**3*PHI0*(.5+1/pi)
 return rows,vars
def parts(weights,seed=0,n=1024):
 rows,vars=diag(weights); width=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); x0=np.r_[base,-base].astype(np.float64); x0-=x0.mean(0); q,_=np.linalg.qr(x0,mode='reduced'); raw=np.sqrt(np.maximum((x0*x0).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]; x0=q*(raw/qn); x0-=x0.mean(0); xv=np.maximum((x0*x0).mean(0),1e-12); x0*=np.sqrt(1/xv); return rows,vars,x0

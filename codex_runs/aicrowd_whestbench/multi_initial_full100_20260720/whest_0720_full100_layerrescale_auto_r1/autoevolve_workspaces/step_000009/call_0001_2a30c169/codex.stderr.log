# Local beta grid around the official incumbent, same synthetic approximation.
import numpy as np
from scipy.special import ndtr
from math import pi
PHI0=1/np.sqrt(2*pi)
def pdf(x): return np.exp(-.5*x*x)*PHI0
def fcov(w):

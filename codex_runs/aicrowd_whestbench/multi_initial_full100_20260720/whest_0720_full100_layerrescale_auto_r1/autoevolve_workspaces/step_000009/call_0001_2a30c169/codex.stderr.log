diff --git a/submission.py b/submission.py
index 699f7a6b8df9f24e1f117c1e3a9886266aa423e0..30f0b73d39c94d5f46acf99a423b1da4f34df09d
--- a/submission.py
+++ b/submission.py
@@ -5,11 +5,12 @@
 from whestbench import BaseEstimator
 
 _FRAC = 0.09
-_BETA0 = 0.50
-_BETA1 = 0.60
+_BETA0 = 1.0
+_BETA1 = 0.64
 _RADIAL = True
 _SEED_OFFSET = 0
 _FULL_VAR1 = True
+_FULL_MATCH0 = True
 _SKEW1 = 1.0
 _SKEW2 = 1.0
 
@@ -110,12 +111,25 @@
             x = fnp.maximum(x @ w, 0.0)
             if i == 0:
                 x_center = x - fnp.mean(x, axis=0)
-                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
-                x_match = (
-                    x_center
-                    * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
-                    + diag_rows[i]
-                )
+                if _FULL_MATCH0 and first_cov is not None:
+                    sample_cov = (x_center.T @ x_center) / float(n_samples)
+                    s_vals, s_vecs = fnp.linalg.eigh(sample_cov)
+                    t_vals, t_vecs = fnp.linalg.eigh(first_cov)
+                    inv_root = (
+                        s_vecs
+                        * fnp.sqrt(1.0 / fnp.maximum(s_vals, 1e-12))[None, :]
+                    ) @ s_vecs.T
+                    target_root = (
+                        t_vecs * fnp.sqrt(fnp.maximum(t_vals, 1e-12))[None, :]
+                    ) @ t_vecs.T
+                    x_match = (x_center @ inv_root) @ target_root + diag_rows[i]
+                else:
+                    x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
+                    x_match = (
+                        x_center
+                        * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
+                        + diag_rows[i]
+                    )
                 x = (1.0 - _BETA0) * x + _BETA0 * x_match
             elif i == 1:
                 x_center = x - fnp.mean(x, axis=0)


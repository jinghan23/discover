codex
The next structural idea is cheap and targeted: after the probe reaches the penultimate layer, use the sample mean and variance of each final preactivation to form a Gaussianized ReLU moment, then blend it with the raw final ReLU sample. This keeps the sampled covariance signal but smooths final-layer sampling noise.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import pi
PHI0=1/np.sqrt(2*pi)
def pdf(x): return np.exp(-.5*x*x)*PHI0
def fcov(w):
 c=w.T@w; v=np.maximum(np.diag(c),1e-12); s=np.sqrt(v); d=np.maximum(s[:,None]*s[None,:],1e-12); r=np.clip(c/d,-.999999,.999999); k=(np.sqrt(np.maximum(1-r*r,0))+(pi-np.arccos(r))*r)/(2*pi); return d*k-(s*PHI0)[:,None]*(s*PHI0)[None,:]
def diag(weights):
 width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; fc=None; pt=None
 for li,w in enumerate(weights):
  mup=w.T@mu; vp=np.maximum(np.sum(w*(fc@w),0),1e-12) if li==1 and fc is not None else np.maximum((w*w).T@var,1e-12)
  sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=ndtr(a); mu=mup*cd+sig*ph; sk=None
  if li==1 and pt is not None:
   k3=np.sum((w*w*w)*pt[:,None],0); sk=k3/np.maximum(vp*sig,1e-12); mu=mu-(mup*ph*sk)/6
  ez=(mup*mup+vp)*cd+mup*sig*ph
  if li==1 and pt is not None: ez=ez+sk*vp*ph/3
  var=np.maximum(ez-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
  if li==0: fc=fcov(w); pt=sig**3*PHI0*(.5+1/pi)
 return rows,vars
def pred_parts(weights,n=1024,seed=0,b0=.480,b1=.64):
 rows,vars=diag(weights); width=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); x=np.r_[base,-base].astype(np.float64); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); raw=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]; x=q*(raw/qn); x-=x.mean(0); xv=np.maximum((x*x).mean(0),1e-12); x*=np.sqrt(1/xv)
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  if i==0 or i==1:
   beta=b0 if i==0 else b1; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 pre=x@weights[-1]
 sample=np.maximum(pre,0).mean(0)
 mup=pre.mean(0); vp=np.maximum(((pre-mup)*(pre-mup)).mean(0),1e-12); sig=np.sqrt(vp); a=mup/sig; gauss=mup*ndtr(a)+sig*pdf(a)
 return sample,gauss,rows[-1]
def truth(weights,n=200000,seed=1):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); c=0; bs=50000
 while c<n:
  m=min(bs,n-c); c+=m; x=rng.standard_normal((m,width))
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return s/n
def run(w=64,d=6,scale='xavier'):
 gammas=[-1,-.5,-.25,-.1,0,.1,.25,.5,.75,1,1.25,1.5]
 errs={g:[] for g in gammas}
 rng=np.random.default_rng(44)
 for mi in range(8):
  sd=(2/w)**.5 if scale=='he' else 1/w**.5; weights=[rng.standard_normal((w,w))*sd for _ in range(d)]; t=truth(weights,seed=700+mi); sample,gauss,ana=pred_parts(weights,seed=mi+13)
  for g in gammas:
   p=(1-g)*sample+g*gauss; errs[g].append(np.mean((p-t)**2))
 print('case',w,d,scale)
 for g,v in sorted(errs.items(), key=lambda kv: np.mean(kv[1])): print(g,np.mean(v))
for scale in ['xavier','he']:
 for d in [3,4,5,6,8,10]: run(64,d,scale)

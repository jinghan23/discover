 return np.maximum(x@weights[-1],0).mean(0)
def truth(weights,n=200000,seed=1):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); c=0; bs=50000
 while c<n:
  m=min(bs,n-c); c+=m; x=rng.standard_normal((m,width))
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return s/n
def run(w=64,d=6,scale='xavier'):

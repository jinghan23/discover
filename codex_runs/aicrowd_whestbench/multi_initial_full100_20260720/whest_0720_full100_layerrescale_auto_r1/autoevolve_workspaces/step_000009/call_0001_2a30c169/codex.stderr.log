        if i < len(betas) and betas[i]"'!=0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-betas[i])*x+betas[i]*xm
    return np.maximum(x@weights[-1],0).mean(0)

def truth(weights, n=300000, seed=123):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]
    bs=50000; s=np.zeros(width); c=0
    for _ in range((n+bs-1)//bs):
        m=min(bs,n-c); c+=m
        x=rng.standard_normal((m,width))
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(0)
    return s/c

def run(width=64,depth=5,scale='"'he',n_mlps=8,n_samples=1024):
    rng=np.random.default_rng(999)
    variants={
        'base': dict(beta0=.5,beta1=.6,betas_extra=()),
        'b55_65': dict(beta0=.55,beta1=.65,betas_extra=()),
        'b45_55': dict(beta0=.45,beta1=.55,betas_extra=()),
        'extra3_.2': dict(beta0=.5,beta1=.6,betas_extra=(.2,)),
        'extra3_.5': dict(beta0=.5,beta1=.6,betas_extra=(.5,)),
        'all_.5': dict(beta0=.5,beta1=.6,betas_extra=(.5,.5,.5,.5)),
        'radFalse': dict(beta0=.5,beta1=.6,betas_extra=(),radial=False),
        'skew0': dict(beta0=.5,beta1=.6,betas_extra=(),skew1=0,skew2=0),
        'skew_mu0': dict(beta0=.5,beta1=.6,betas_extra=(),skew1=0,skew2=1),
        'skew_var0': dict(beta0=.5,beta1=.6,betas_extra=(),skew1=1,skew2=0),
    }
    errs={k:[] for k in variants}
    for mi in range(n_mlps):
        if scale=='he': s=np.sqrt(2/width)
        elif scale=='xavier': s=1/np.sqrt(width)
        else: s=1.0
        weights=[rng.standard_normal((width,width))*s for _ in range(depth)]
        t=truth(weights,n=200000,seed=1000+mi)
        for k,kw in variants.items():
            p=predict(weights,n_samples=n_samples,seed=42+mi,**kw)
            errs[k].append(np.mean((p-t)**2))
    print('w,d,scale,n',width,depth,scale,n_samples)
    for k,v in sorted(errs.items(), key=lambda kv: np.mean(kv[1])):
        print(k, np.mean(v), np.std(v)/np.sqrt(len(v)))

for scale in ['he','xavier']:
  run(64,5,scale,n_mlps=5,n_samples=1024)
  run(64,8,scale,n_mlps=5,n_samples=1024)

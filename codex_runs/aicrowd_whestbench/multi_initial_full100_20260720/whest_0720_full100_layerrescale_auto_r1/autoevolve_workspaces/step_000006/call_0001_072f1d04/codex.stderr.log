# Reuse a compact version to compare sample size and betas on plausible dimensions.
import numpy as np, math, time
from scipy.special import erf

def pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def cdf(a): return 0.5*(1+erf(a/math.sqrt(2)))
def mlp(width, depth, rng):
    return [(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def tgt(ws,n,rng):
    width=ws[0].shape[0]; s=np.zeros(width); done=0
    while done<n:
        m=min(32768,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in ws: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n
def diag(ws):
    width=ws[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w in ws:
        mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig; ph=pdf(a); cf=cdf(a)
        mu=mp*cf+sig*ph; ez=(mp*mp+vp)*cf+mp*sig*ph; var=np.maximum(ez-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def pred(ws,n,seed,betas,radial=True):
    rng=np.random.default_rng(seed); rows,vars=diag(ws); width=ws[0].shape[0]
    half=n//2; base=rng.standard_normal((half,width),dtype=np.float32); x=np.concatenate((base,-base)); x-=x.mean(0)
    q,_=np.linalg.qr(x,mode='reduced')
    if radial:
        rn=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]
        x=q*(rn/qn); x-=x.mean(0); xv=np.maximum((x*x).mean(0),1e-12); x*=np.sqrt(1/xv)
    else: x=q*math.sqrt(n)
    for i,w in enumerate(ws[:-1]):
        x=np.maximum(x@w,0); b=betas[i] if i<len(betas) else 0
        if b:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-b)*x+b*xm
    return np.maximum(x@ws[-1],0).mean(0)

def run(width,depth,n_mlps,target_n):
    rng=np.random.default_rng(77); wslist=[mlp(width,depth,rng) for _ in range(n_mlps)]
    tgts=[tgt(ws,target_n,np.random.default_rng(100+i)) for i,ws in enumerate(wslist)]
    beta_grid=[(0,0),(0.4,0),(0.55,0),(0.65,0),(0.75,0),(0.9,0),(0.55,0.04),(0.65,0.04),(0.65,0.06),(0.75,0.06),(0.85,0.06),(0.65,0.1),(0.75,0.1),(0.65,0.06,0.03),(0.75,0.06,0.03),(0.75,0.1,0.04)]
    print(f'-- w{width} d{depth} --')

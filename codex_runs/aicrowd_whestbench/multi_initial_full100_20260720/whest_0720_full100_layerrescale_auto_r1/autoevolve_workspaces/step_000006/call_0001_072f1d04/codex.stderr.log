codex
The first candidate idea is to keep the current hidden-layer sample calibration but replace or blend the noisy final ReLU sample mean with a Gaussian moment computed from the sampled final preactivation mean/variance. I’m testing that locally across random He networks now.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from math import erf, sqrt, pi
try:
    from scipy.special import erf as sperf
    HAVE_SCIPY=True
except Exception:
    HAVE_SCIPY=False

def norm_pdf(a):
    return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)

def norm_cdf(a):
    if HAVE_SCIPY:
        return 0.5*(1+sperf(a/math.sqrt(2)))
    return 0.5*(1+np.vectorize(math.erf)(a/math.sqrt(2)))

def sample_mlp(width, depth, rng):
    scale=math.sqrt(2/width)
    return [(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]

def target(weights, n, rng, chunk=16384):
    width=weights[0].shape[0]
    s=np.zeros(width, np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        s += x.astype(np.float64).sum(0)
        done += m
    return (s/n).astype(np.float64)

def diag_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width)
    var=np.ones(width)
    rows=[]; vars=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(var_pre)
        a=mu_pre/sig
        phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=mu_pre*cdf+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows, vars

def pred(weights, n, seed, betas=(0.65,0.06), radial=True, final_mode='sample', gamma=0.0):
    rng=np.random.default_rng(seed)
    rows, vars = diag_prop(weights)
    width=weights[0].shape[0]
    half=n//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate((base,-base),0)
    x=x-x.mean(0)
    q,_=np.linalg.qr(x, mode='reduced')
    if radial:
        raw_norm=np.sqrt(np.maximum(np.sum(x*x,1),1e-12))[:,None]
        q_norm=np.sqrt(np.maximum(np.sum(q*q,1),1e-12))[:,None]
        x=q*(raw_norm/q_norm)
        x=x-x.mean(0)
        xv=np.maximum(np.mean(x*x,0),1e-12)
        x=x*np.sqrt(1.0/xv)
    else:
        x=q*math.sqrt(float(n))
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        beta=betas[i] if i < len(betas) else 0.0
        if beta:
            xc=x-x.mean(0)
            xv=np.maximum(np.mean(xc*xc,0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    pre=x@weights[-1]
    sample=np.maximum(pre,0).mean(0)
    m=pre.mean(0)
    xc=pre-m
    v=np.maximum(np.mean(xc*xc,0),1e-12)
    s=np.sqrt(v)
    a=m/s
    gauss=m*norm_cdf(a)+s*norm_pdf(a)
    diag=rows[-1]
    if final_mode=='sample': return sample
    if final_mode=='gauss': return gauss
    if final_mode=='diag': return diag
    if final_mode=='blend_gauss': return (1-gamma)*sample+gamma*gauss
    if final_mode=='blend_diag': return (1-gamma)*sample+gamma*diag
    if final_mode=='blend_both':
        g,h=gamma
        return (1-g-h)*sample+g*gauss+h*diag

def run(width=64,depth=8,n_mlps=20,n=1024,target_n=200000):
    rng=np.random.default_rng(123)
    mlps=[sample_mlp(width,depth,rng) for _ in range(n_mlps)]
    tgts=[]
    t0=time.time()
    for i,w in enumerate(mlps):
        tgts.append(target(w,target_n,np.random.default_rng(1000+i)))
    print('targets time',time.time()-t0)
    variants=[]
    for final_mode in ['sample','gauss']:
        variants.append((final_mode,0,(0.65,0.06), final_mode))
    for g in [-0.5,-0.25,0.1,0.25,0.5,0.75,1.0,1.25]:
        variants.append(('blend_gauss',g,(0.65,0.06),f'bg{g}'))
    for h in [-0.25,0.1,0.25,0.5,0.75,1.0]:
        variants.append(('blend_diag',h,(0.65,0.06),f'bd{h}'))
    beta_sets=[(0,0),(0.4,0),(0.65,0),(0.8,0),(0.65,0.06),(0.65,0.12),(0.8,0.06),(0.5,0.1),(0.65,0.06,0.03),(0.65,0.06,0.06),(0.7,0.1,0.03)]
    for b in beta_sets:
        variants.append(('sample',0,b,f'b{b}'))
        variants.append(('blend_gauss',0.5,b,f'b{b}_g.5'))
    res=[]
    for mode,g,b,name in variants:
        ms=[]
        for i,w in enumerate(mlps):
            p=pred(w,n,seed=2000+i,betas=b,final_mode=mode,gamma=g)
            ms.append(np.mean((p-tgts[i])**2))
        res.append((np.mean(ms), name))
    for m,name in sorted(res)[:20]:
        print(f'{m:.6g}', name)
print('---64x8 n1024---')
run(64,8,16,1024,120000)
print('---64x8 n2048---')
run(64,8,12,2048,120000)

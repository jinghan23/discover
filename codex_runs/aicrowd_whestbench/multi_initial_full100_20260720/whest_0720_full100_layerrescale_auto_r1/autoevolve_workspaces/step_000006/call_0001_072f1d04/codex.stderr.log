import numpy as np, math
from scipy.special import erf

def pdf(a): return np.exp(-.5*a*a)/math.sqrt(2*math.pi)
def cdf(a): return .5*(1+erf(a/math.sqrt(2)))
def mlp(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def tgt(ws,n,r):
    w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(32768,n-done); x=r.standard_normal((m,w)).astype(np.float32)
        for a in ws: x=np.maximum(x@a,0)
        s+=x.sum(0); done+=m
    return s/n
def diag(ws):
    w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for a in ws:
        mp=a.T@mu; vp=np.maximum((a*a).T@var,1e-12); sg=np.sqrt(vp); al=mp/sg; ph=pdf(al); cf=cdf(al)
        mu=mp*cf+sg*ph; ez=(mp*mp+vp)*cf+mp*sg*ph; var=np.maximum(ez-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def block_qr(n,w,r,blocks):
    parts=[]
    # each block includes antithetic pairs, total rows n
    per=2*((n//blocks)//2)
    counts=[per]*blocks
    counts[-1]=n-per*(blocks-1)
    for nb in counts:
        h=nb//2; base=r.standard_normal((h,w),dtype=np.float32); x=np.concatenate((base,-base)); x-=x.mean(0)
        q,_=np.linalg.qr(x,mode='reduced')
        rn=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]
        y=q*(rn/qn); y-=y.mean(0); y*=np.sqrt(1/np.maximum((y*y).mean(0),1e-12))
        parts.append(y)
    x=np.concatenate(parts)
    x-=x.mean(0); x*=np.sqrt(1/np.maximum((x*x).mean(0),1e-12))
    return x
def pred(ws,n,seed,blocks):
    rows,vars=diag(ws); w=ws[0].shape[0]; r=np.random.default_rng(seed); x=block_qr(n,w,r,blocks)
    for i,a in enumerate(ws[:-1]):
        x=np.maximum(x@a,0); b=0.65 if i==0 else (0.06 if i==1 else 0.0)
        if b:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-b)*x+b*xm
    return np.maximum(x@ws[-1],0).mean(0)
for w,d,n,mlps,target_n in [(64,8,8192,24,200000),(128,8,8192,12,160000),(256,4,4096,8,120000),(128,8,2048,16,160000)]:
    r=np.random.default_rng(14); wslist=[mlp(w,d,r) for _ in range(mlps)]; tgts=[tgt(ws,target_n,np.random.default_rng(900+i)) for i,ws in enumerate(wslist)]
    print('case',w,d,n)
    for blocks in [1,2,4,8]:
        if n//blocks < 2*w: continue
        ms=[np.mean((pred(ws,n,8000+i,blocks)-tgts[i])**2) for i,ws in enumerate(wslist)]
        print(blocks, np.mean(ms))

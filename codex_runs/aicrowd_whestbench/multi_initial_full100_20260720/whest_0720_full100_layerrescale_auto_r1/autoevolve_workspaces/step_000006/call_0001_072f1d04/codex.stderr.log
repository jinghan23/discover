/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import erf, ndtri

def pdf(a): return np.exp(-.5*a*a)/math.sqrt(2*math.pi)
def cdf(a): return .5*(1+erf(a/math.sqrt(2)))
def mlp(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
def tgt(ws,n,r):
    w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(32768,n-done); x=r.standard_normal((m,w)).astype(np.float32)
        for a in ws: x=np.maximum(x@a,0)
        s+=x.sum(0); done+=m
    return s/n
def diag(ws):
    w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for a in ws:
        mp=a.T@mu; vp=np.maximum((a*a).T@var,1e-12); sg=np.sqrt(vp); al=mp/sg; ph=pdf(al); cf=cdf(al)
        mu=mp*cf+sg*ph; ez=(mp*mp+vp)*cf+mp*sg*ph; var=np.maximum(ez-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def init_qr(n,w,r):
    h=n//2; base=r.standard_normal((h,w),dtype=np.float32); x=np.concatenate((base,-base)); x-=x.mean(0)
    q,_=np.linalg.qr(x,mode='reduced')
    rn=np.sqrt(np.maximum((x*x).sum(1),1e-12))[:,None]; qn=np.sqrt(np.maximum((q*q).sum(1),1e-12))[:,None]
    x=q*(rn/qn); x-=x.mean(0); x*=np.sqrt(1/np.maximum((x*x).mean(0),1e-12)); return x
def init_lhs(n,w,r,mode):
    h=n//2
    i=np.arange(h)[:,None]
    j=np.arange(w)[None,:]
    if mode=='cyclic':
        stride=2*j+1
        off=r.integers(0,h,size=(1,w))
        u=(((i*stride+off)%h)+0.5)/h
    elif mode=='gold':
        alpha=(np.sqrt(np.arange(w)+2)*0.6180339887498949)%1.0
        shift=r.random((1,w))
        u=(i*alpha[None,:]+shift)%1.0
        u=np.clip(u,1e-7,1-1e-7)
    elif mode=='gridshift':
        # same ranks shifted per dim
        off=r.integers(0,h,size=(1,w)); u=(((i+off)%h)+0.5)/h
    base=ndtri(u).astype(np.float32)
    x=np.concatenate((base,-base)); x-=x.mean(0); x*=np.sqrt(1/np.maximum((x*x).mean(0),1e-12)); return x
def pred(ws,n,seed,init):
    rows,vars=diag(ws); w=ws[0].shape[0]; r=np.random.default_rng(seed)
    x=init_qr(n,w,r) if init=='qr' else init_lhs(n,w,r,init)
    for i,a in enumerate(ws[:-1]):
        x=np.maximum(x@a,0); b=0.65 if i==0 else (0.06 if i==1 else 0.0)
        if b:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-b)*x+b*xm
    return np.maximum(x@ws[-1],0).mean(0)
for w,d,n,mlps,target_n in [(64,8,8192,20,200000),(128,8,4096,12,160000),(128,8,8192,12,160000),(256,4,4096,8,120000)]:
    r=np.random.default_rng(4); wslist=[mlp(w,d,r) for _ in range(mlps)]; tgts=[tgt(ws,target_n,np.random.default_rng(700+i)) for i,ws in enumerate(wslist)]
    print('case',w,d,n)
    for init in ['qr','cyclic','gridshift','gold']:
        ms=[np.mean((pred(ws,n,1000+i,init)-tgts[i])**2) for i,ws in enumerate(wslist)]
        print(init, np.mean(ms))

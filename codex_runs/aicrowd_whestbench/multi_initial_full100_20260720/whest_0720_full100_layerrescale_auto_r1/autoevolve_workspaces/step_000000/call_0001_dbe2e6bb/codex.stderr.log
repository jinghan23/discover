print('targets done',time.time()-t0)

def eval_coeffs(coeffs, extra=(), blend=(0.955,0.04,0.005), fit=False):
    Cs=[]; Ts=[]
    for weights,rows,vars,tgt,seed in data:
        c=comps_for(weights,rows,vars,seed,coeffs,dict(extra))
        Cs.append(c); Ts.append(tgt)
    T=np.concatenate(Ts)
    X=np.stack([np.concatenate([c[j] for c in Cs]) for j in range(3)],1)
    pred=X@np.array(blend)

import time, math
import numpy as np
from scipy.special import ndtr
W=256;D=32;B=272_000_000_000;per=D*(2*W*W+4*W)
def ns(f): return max(2,2*(min(8192,max(1024,int(f*B/per)))//2))
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-.5*x*x)*INV

def diag_prop(weights):
 mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig; ph=pdf(a); cd=ndtr(a)
  mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars

def target(weights,seed,n=262144):
 rng=np.random.default_rng(seed); s=np.zeros(W); done=0
 for st in range(0,n,4096):
  m=min(4096,n-st); x=rng.standard_normal((m,W),dtype=np.float32)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return (s/done).astype(np.float32)

def est(weights,rows,vars,seed,mode='qr',n=5854):
 rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,W),dtype=np.float32); x=np.concatenate([base,-base]).astype(np.float64); x-=x.mean(0)
 if mode=='qr':
  q,r=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
 elif mode=='qr_pos':
  q,r=np.linalg.qr(x,mode='reduced'); s=np.sign(np.diag(r)); s[s==0]=1; x=(q*s)*math.sqrt(n)
 elif mode=='qr_neg':
  q,r=np.linalg.qr(x,mode='reduced'); s=-np.sign(np.diag(r)); s[s==0]=1; x=(q*s)*math.sqrt(n)
 elif mode=='qr_rev':
  q,r=np.linalg.qr(x,mode='reduced'); x=q[:, ::-1]*math.sqrt(n)
 elif mode=='qr_sort':
  q,r=np.linalg.qr(x,mode='reduced'); order=np.argsort(np.abs(np.diag(r))); x=q[:, order]*math.sqrt(n)
 elif mode=='eigh':
  cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  k=1.5 if i==0 else (.17 if i==1 else (-.035 if i==3 else 0))
  if k:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
 z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)*(z-zm)).mean(0),1e-12)); a=zm/zs; nm=zm*ndtr(a)+zs*pdf(a); return (.955*mc+.04*nm+.005*rows[-1]).astype(np.float32)
M=8; data=[]; t0=time.time()
for m in range(M):
 rng=np.random.default_rng(3333+m); weights=[(rng.standard_normal((W,W),dtype=np.float32)*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 rows,vars=diag_prop(weights); tgt=target(weights,4444+m,262144); data.append((weights,rows,vars,tgt,5555+m)); print('t',m,time.time()-t0,flush=True)
for mode in ['eigh','qr','qr_pos','qr_neg','qr_rev','qr_sort']:
 for f in ([0.0885,0.0909908329,0.093,0.095] if mode in ['qr','qr_pos'] else [0.0909908329]):
  errs=[]; n=ns(f)
  st=time.time()
  for weights,rows,vars,tgt,seed in data: errs.append(np.mean((est(weights,rows,vars,seed,mode,n)-tgt)**2))
  print(mode,f,n,float(np.mean(errs)),'elapsed',time.time()-st,flush=True)

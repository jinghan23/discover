/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
from scipy.special import ndtr
W=256;D=32;B=272_000_000_000;per=D*(2*W*W+4*W);N=max(2,2*(min(8192,max(1024,int(0.0909908329*B/per)))//2))
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-.5*x*x)*INV

def diag_prop(weights):
 mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig; ph=pdf(a); cd=ndtr(a)
  mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars

def target(weights,seed,n=131072):
 rng=np.random.default_rng(seed); s=np.zeros(W); done=0
 for st in range(0,n,4096):
  m=min(4096,n-st); x=rng.standard_normal((m,W),dtype=np.float32)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return (s/done).astype(np.float32)

def comps(weights,rows,vars,seed,n=N):
 rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,W),dtype=np.float32); x=np.concatenate([base,-base]).astype(np.float64); x-=x.mean(0)
 q,r=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  k=1.5 if i==0 else (.17 if i==1 else (-.035 if i==3 else 0))
  if k:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
 z=x@weights[-1]
 mc=np.maximum(z,0).mean(0).astype(np.float32); zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)*(z-zm)).mean(0),1e-12)); a=zm/zs
 nm=(zm*ndtr(a)+zs*pdf(a)).astype(np.float32); dg=rows[-1].astype(np.float32)
 return mc,nm,dg
M=20; data=[]; t0=time.time()
for m in range(M):
 rng=np.random.default_rng(70000+m); weights=[(rng.standard_normal((W,W),dtype=np.float32)*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 rows,vars=diag_prop(weights); tgt=target(weights,80000+m,131072); c=comps(weights,rows,vars,90000+m)
 data.append((c,tgt)); print('mlp',m,time.time()-t0,flush=True)
X=np.stack([np.concatenate([c[j] for c,t in data]) for j in range(3)],1); T=np.concatenate([t for c,t in data])
for blend in [(0.955,0.04,0.005),(0.96,0.035,0.005),(0.95,0.045,0.005),(0.95,0.055,-0.005),(0.945,0.055,0.0),(0.965,0.03,0.005),(0.94,0.06,0.0),(0.93,0.07,0.0)]:
 print('blend',blend,float(np.mean((X@np.array(blend)-T)**2)))
for split in [2,3,5]:
 train=(np.arange(M*W)//W)%split"'!=0; test=~train
 coef=np.linalg.lstsq(X[train],T[train],rcond=None)[0]
 print('"'fit split',split,coef,'train',float(np.mean((X[train]@coef-T[train])**2)),'test',float(np.mean((X[test]@coef-T[test])**2)),'sum',coef.sum())
print('fit all',np.linalg.lstsq(X,T,rcond=None)[0])

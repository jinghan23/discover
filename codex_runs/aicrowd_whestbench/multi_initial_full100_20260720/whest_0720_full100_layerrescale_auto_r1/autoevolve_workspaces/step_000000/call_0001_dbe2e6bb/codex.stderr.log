/bin/bash -lc "python - <<'PY'
import time, math, itertools
import numpy as np
from scipy.special import ndtr
W=256;D=32;B=272_000_000_000;per=D*(2*W*W+4*W);N=max(2,2*(min(8192,max(1024,int(.0909908329*B/per)))//2))
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-.5*x*x)*INV

def diag_prop(weights):
 mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig; ph=pdf(a); cd=ndtr(a)
  mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars

def target(weights,seed,n=131072):
 rng=np.random.default_rng(seed); s=np.zeros(W); done=0
 for st in range(0,n,4096):
  m=min(4096,n-st); x=rng.standard_normal((m,W),dtype=np.float32)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return (s/done).astype(np.float32)

def est(weights,rows,vars,seed,ks):
 rng=np.random.default_rng(seed); half=N//2; base=rng.standard_normal((half,W),dtype=np.float32); x=np.concatenate([base,-base]).astype(np.float64); x-=x.mean(0)
 q,r=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(N)
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  k=ks.get(i,0.0)
  if k:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
 z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)*(z-zm)).mean(0),1e-12)); a=zm/zs; nm=zm*ndtr(a)+zs*pdf(a); return (.955*mc+.04*nm+.005*rows[-1]).astype(np.float32)
M=12; data=[]; t0=time.time()
for m in range(M):
 rng=np.random.default_rng(120000+m); weights=[(rng.standard_normal((W,W),dtype=np.float32)*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]
 rows,vars=diag_prop(weights); tgt=target(weights,130000+m,131072); data.append((weights,rows,vars,tgt,140000+m)); print('target',m,time.time()-t0,flush=True)
base={0:1.5,1:.17,3:-.035}
def score(ks):
 errs=[]
 for weights,rows,vars,tgt,seed in data: errs.append(np.mean((est(weights,rows,vars,seed,ks)-tgt)**2))
 return float(np.mean(errs))
seen=[]
def test(name,ks):
 s=score(ks); seen.append((s,name,dict(ks))); print('cand',name,s,dict(ks),flush=True)
test('base',base)
for k0 in [1.2,1.35,1.45,1.55,1.65,1.8]:
 ks=dict(base); ks[0]=k0; test(f'k0={k0}',ks)
for k1 in [-.05,.05,.1,.24,.35,.5]:
 ks=dict(base); ks[1]=k1; test(f'k1={k1}',ks)
for k3 in [-.12,-.08,-.055,-.015,0,.035,.08]:
 ks=dict(base); ks[3]=k3; test(f'k3={k3}',ks)
# selected combos around locally better directions after first pass manually broad
for k0,k1,k3 in [(1.45,.1,-.055),(1.55,.1,-.055),(1.45,.24,-.055),(1.55,.24,-.055),(1.35,.1,-.08),(1.65,.24,0),(1.5,.1,-.055),(1.5,.24,-.055)]:
 test(f'combo {k0},{k1},{k3}',{0:k0,1:k1,3:k3})
# additional one-layer matches
for layer in [2,4,5,8,12,20,30]:
 for k in [-.1,-.05,.05,.1]:
  ks=dict(base); ks[layer]=k; test(f'extra{layer}={k}',ks)
print('top')
for x in sorted(seen)[:12]: print(x)

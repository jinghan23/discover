import time, math, itertools, random
import numpy as np
from scipy.special import ndtr
W=256; D=32; BUDGET=272_000_000_000
per_sample=D*(2*W*W+4*W)
def ns_from_factor(f):
 n=max(1024,int((f*BUDGET)/per_sample)); n=min(n,8192); return max(2,2*(n//2))
N=ns_from_factor(0.0909908329)
print('N',N)
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV

def diag_prop(weights):
    mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]
    for w in weights:
        wf=w.astype(np.float64)
        mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12)
        sig=np.sqrt(vp); a=mp/sig; ph=pdf(a); cd=ndtr(a)
        mu=mp*cd+sig*ph
        ez2=(mp*mp+vp)*cd+mp*sig*ph
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows, vars

def target_mc(weights, seed, n=131072, chunk=4096):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,W),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0.0)
        s += x.astype(np.float64).sum(0); done += m
    return (s/done).astype(np.float32)

def comps_for(weights, rows, vars, seed, coeffs, extra=(), n=N):
    rng=np.random.default_rng(seed); half=n//2
    base=rng.standard_normal((half,W),dtype=np.float32)
    x=np.concatenate([base,-base],0).astype(np.float64)
    x-=x.mean(0)
    cov=x.T@x/float(n)
    vals,vecs=np.linalg.eigh(cov)
    x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
    corr={0:coeffs[0],1:coeffs[1],3:coeffs[2]}
    corr.update(extra)
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        k=corr.get(i,0.0)
        if k"'!=0.0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-k)*x+k*xm
    z=x@weights[-1]
    mc=np.maximum(z,0.0).mean(0)
    zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)*(z-zm)).mean(0),1e-12))
    a=zm/zs; nm=zm*ndtr(a)+zs*pdf(a)
    return mc.astype(np.float32), nm.astype(np.float32), rows[-1].astype(np.float32)

M=16; n_gt=131072
data=[]; t0=time.time()
for m in range(M):
    rng=np.random.default_rng(12345+m)
    weights=[(rng.standard_normal((W,W),dtype=np.float32)*math.sqrt(2/W)).astype(np.float32) for _ in range(D)]

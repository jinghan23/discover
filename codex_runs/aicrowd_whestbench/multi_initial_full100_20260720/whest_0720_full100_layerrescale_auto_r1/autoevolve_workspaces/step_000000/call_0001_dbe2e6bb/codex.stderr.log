        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars

def estimate_components(weights, seed, coeffs=(1.5,0.17,-0.035), final=(0.955,0.04,0.005), n=n_samples):
    rows,vars=diag_prop(weights)
    rng=np.random.default_rng(seed)
    half=n//2
    base=rng.standard_normal((half,W), dtype=np.float32)
    x=np.concatenate([base,-base],axis=0).astype(np.float64)
    x=x-x.mean(axis=0)
    cov=(x.T@x)/float(n)
    vals,vecs=np.linalg.eigh(cov)
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=x@inv
    corr={0:coeffs[0],1:coeffs[1],3:coeffs[2]}
    # parameter k means x = (1-k)*x + k*x_match; current layer0 k=1.5, layer1 .17, layer3 -0.035
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i in corr:
            k=corr[i]
            xc=x-x.mean(axis=0)
            xv=np.maximum((xc*xc).mean(axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-k)*x+k*xm
    z=x@weights[-1]
    final_mc=np.maximum(z,0.0).mean(axis=0)
    z_mu=z.mean(axis=0); zc=z-z_mu
    z_sigma=np.sqrt(np.maximum((zc*zc).mean(axis=0),1e-12))
    alpha=z_mu/z_sigma
    final_norm=z_mu*ndtr(alpha)+z_sigma*norm_pdf(alpha)
    diag=np.stack(rows,axis=0).astype(np.float32)
    pred=final[0]*final_mc+final[1]*final_norm+final[2]*diag[-1]
    return pred.astype(np.float32), (final_mc.astype(np.float32),final_norm.astype(np.float32),diag[-1].astype(np.float32))

def target_mc(weights, seed, n=65536, chunk=4096):
    rng=np.random.default_rng(seed)
    s=np.zeros(W,dtype=np.float64)
    ss=np.zeros(W,dtype=np.float64)
    done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,W), dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w,0.0)
        xd=x.astype(np.float64)
        s+=xd.sum(axis=0); ss+=(xd*xd).sum(axis=0)
        done+=m
    return (s/done).astype(np.float32), float(np.mean(ss/done-(s/done)**2))

M=5; n_gt=65536
preds=[]; tgts=[]; comps=[]; vars=[]
t0=time.time()
for m in range(M):

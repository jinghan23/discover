import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
    r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
    r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
    while rem:
        m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); rem-=m
    return s/n
def diag(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
        mu=m*c+sig*p; ez2=(m*m+v)*c+m*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def est(weights,rows,vars,betas,n=5792,seed=0,qr=True):
    width=weights[0].shape[0]; r=np.random.default_rng(seed); half=n//2
    base=r.standard_normal((half,width)).astype(np.float64); x=np.concatenate([base,-base],0); x-=x.mean(0)
    if qr:
        q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        beta=betas[i] if i<len(betas) else 0.0
        if beta:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    z=x@weights[-1]
    return np.maximum(z,0).mean(0)
width=256; depth=32; ntruth=160000; seeds=range(4)
mlps=[]; t0=time.time()
for s in seeds:
    W=gen(width,depth,10000+s); T=truth(W,ntruth,20000+s); R,V=diag(W); mlps.append((W,T,R,V)); print('truth done',s)
print('truth time',time.time()-t0)
# schedules: [b0,b1,b2,b3,b4...] default
scheds=[]
for b0 in [0.4,0.6,0.8,1.0]:
  for b1 in [0.0,0.04,0.08,0.12,0.2]:
    scheds.append((f'{b0},{b1}', [b0,b1]))
for b2 in [0.01,0.02,0.04,0.08,0.12]:
    scheds.append((f'def+b2{b2}', [0.8,0.08,b2]))
for tail in [0.005,0.01,0.02,0.04]:
    scheds.append((f'tail{tail}', [0.8,0.08]+[tail]*8))
for decay in [0.03,0.05,0.08,0.12]:
    scheds.append((f'decay{decay}', [0.8,0.08]+[decay*(0.5**k) for k in range(8)]))
scheds.append(('none',[0,0])); scheds.append(('default',[0.8,0.08]))
res={name:[] for name,_ in scheds}
for idx,(W,T,R,V) in enumerate(mlps):
    for name,b in scheds:
        p=est(W,R,V,b,seed=30000+idx)
        res[name].append(np.mean((p-T)**2))
    print('est done',idx)
for name,vals in sorted(res.items(), key=lambda kv: np.mean(kv[1]))[:30]:
    a=np.array(vals); print(name, a.mean(), a.std()/math.sqrt(len(a)), vals)
print('baseline default mean',np.mean(res['default']))

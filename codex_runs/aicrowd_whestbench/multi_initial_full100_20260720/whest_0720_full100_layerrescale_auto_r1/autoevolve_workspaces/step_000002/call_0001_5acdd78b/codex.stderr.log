I’m testing a first-layer marginal correction: after the QR input projection, rank-transform each first-layer preactivation column to exact normal quantiles before ReLU. It keeps the sampled dependence order but fixes marginal shape.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr, ndtri
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def make_x(n,w,seed):
 r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def rank_normalize_cols(z, sig):
 n,w=z.shape; out=np.empty_like(z); qs=ndtri((np.arange(n)+0.5)/n)
 # centered quantiles have variance close 1; scale exactly to variance 1
 qs=qs/np.sqrt(np.mean(qs*qs))
 for j in range(w):
  idx=np.argsort(z[:,j]); out[idx,j]=qs*sig[j]
 return out
def est(weights,R,V,x,mode='base',sch=[0.8,0.08]):
 x=x.copy()
 if mode=='rank1':
  z=x@weights[0]
  sig=np.sqrt(np.sum(weights[0].astype(np.float64)**2,axis=0))
  z=rank_normalize_cols(z,sig)
  x=np.maximum(z,0)
  # maybe moment match layer0
  beta=sch[0]
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[0],1e-12)/xv)+R[0]; x=(1-beta)*x+beta*xm
  start=1
 else:
  start=0
 for i in range(start,len(weights)-1):
  x=np.maximum(x@weights[i],0); beta=sch[i] if i<len(sch) else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; n=5792; ntruth=160000; seeds=range(8); modes=[]
for schname,sch in [('old',[0.8,0.08]),('no0',[0.0,0.08]),('full',[1.0,0.08]),('b12',[1.2,0.12])]:
 modes.append((f'base_{schname}','base',sch)); modes.append((f'rank_{schname}','rank1',sch))
res={m[0]:[] for m in modes}; t0=time.time()
for s in seeds:
 W=gen(width,32,71000+s); T=truth(W,ntruth,72000+s); R,V=diag(W); X=make_x(n,width,73000+s)
 for name,mode,sch in modes:
  p=est(W,R,V,X,mode,sch); res[name].append(np.mean((p-T)**2))
 print('seed',s,{k:res[k][-1] for k in res})
print('time',time.time()-t0)
for k,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
 a=np.array(v); print(k,a.mean(),a.std()/math.sqrt(len(a)),a.mean()/np.mean(res['base_old']))

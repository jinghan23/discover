import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import flopscope as flops_pkg

def predict(mlp,budget,frac=0.09):
 width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
 per_sample=max(1, depth*(2*width*width+4*width))
 n_samples=max(1024,int((frac*float(budget))/float(per_sample))); n_samples=min(n_samples,8192); n_samples=max(2,2*(n_samples//2))
 mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
 for w in mlp.weights:
  mu_pre=w.T@mu; var_pre=fnp.maximum((w*w).T@var,1e-12); sig=fnp.sqrt(var_pre); a=mu_pre/sig; p=flops_pkg.stats.norm.pdf(a); c=flops_pkg.stats.norm.cdf(a)
  mu=mu_pre*c+sig*p; e2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sig*p; var=fnp.maximum(e2-mu*mu,0.0); rows.append(mu); vars.append(var)
 half=n_samples//2; base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced'); x=q*fnp.sqrt(float(n_samples))
 for i,w in enumerate(mlp.weights[:-1]):
  x=fnp.maximum(x@w,0.0)
  if i==0 or i==1:
   beta=0.8 if i==0 else 0.08
   xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 z=x@mlp.weights[-1]; final=fnp.mean(fnp.maximum(z,0.0),axis=0); return fnp.stack(rows[:-1]+[final],axis=0), n_samples
rng=fnp.random.default_rng(1); mlp=sample_mlp(256,32,rng,seed=123); budget=272_000_000_000
for frac in [0.09,0.092,0.094,0.096,0.098,0.1,0.105,0.11]:
 with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
  _,n=predict(mlp,budget,frac)
 print(frac,'n',n,'flops',ctx.flops_used,'ratio',ctx.flops_used/budget,'wall',ctx.wall_time_s,'resid',ctx.residual_wall_time_s)

/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def est(weights,R,V,n=5792,seed=0,sch=[0.8,0.08]):
 w=weights[0].shape[0]; r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=sch[i] if i<len(sch) else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 p=np.maximum(x@weights[-1],0).mean(0); return p
width=256; ntruth=180000; seeds=range(12); alphas=[0,0.002,0.005,0.01,0.015,0.02,0.03,0.05]
for schname,sch in [('old',[0.8,0.08]),('b12',[1.2,0.12]),('b016',[1.0,0.16])]:
 res={a:[] for a in alphas}; t0=time.time(); print('SCHED',schname)
 for s in seeds:
  W=gen(width,32,81000+s); T=truth(W,ntruth,82000+s); R,V=diag(W); mc=est(W,R,V,seed=83000+s,sch=sch); dg=np.array(R[-1])
  for a in alphas: res[a].append(np.mean(((1-a)*mc+a*dg-T)**2))
  print('seed',s,{a:res[a][-1] for a in alphas[:5]})
 print('time',time.time()-t0)
 for a,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
  arr=np.array(v); print(a,arr.mean(),arr.std()/math.sqrt(len(arr)),arr.mean()/np.mean(res[0]))

width=256; ntruth=180000; seeds=range(10); configs=[('base5792','base',5792),('base5918','base',5918),('full1_5404','full1',5404),('full2_5018','full2',5018),('full2_5146','full2',5146)]
res={c[0]:[] for c in configs}; t0=time.time()
for s in seeds:
 W=gen(width,32,121000+s); T=truth(W,ntruth,122000+s); R,V=diag(W)
 for name,mode,n in configs:
  p=est(W,R,V,n,123000+s,mode); res[name].append(np.mean((p-T)**2))
 print('seed',s,{k:res[k][-1] for k in res})
print('time',time.time()-t0)
base=np.mean(res['base5792'])
for k,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
 a=np.array(v); print(k,a.mean(),a.std()/math.sqrt(len(a)),a.mean()/base)

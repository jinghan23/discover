codex
The best local probe variant uses stratified half-normal magnitudes, random signs, antithetic pairs, then QR. I’m checking its FLOP accounting because inverse-CDF generation is more expensive than standard normal probes.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp

def make_maganti_qr(n,width,seed):
    rng=fnp.random.default_rng(seed)
    half=n//2
    cols=[]
    for _ in range(width):
        u=(rng.permutation(half)+rng.random(half))/float(half)
        mag=flops.stats.norm.ppf(0.5+0.5*fnp.clip(u,1e-12,1.0-1e-12))
        sign=fnp.where(rng.random(half)<0.5,-1.0,1.0)
        cols.append(sign*mag)
    base=fnp.stack(cols,axis=1)
    x=fnp.concatenate((base,-base),axis=0)
    x=x-fnp.mean(x,axis=0)
    x=x/fnp.sqrt(fnp.maximum(fnp.mean(x*x,axis=0),1e-12))
    q,_=fnp.linalg.qr(x,mode='reduced')
    return q*fnp.sqrt(float(n))

def make_gauss_qr(n,width,seed):
    rng=fnp.random.default_rng(seed)
    half=n//2
    base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
    x=fnp.concatenate((base,-base),axis=0)
    x=x-fnp.mean(x,axis=0)
    q,_=fnp.linalg.qr(x,mode='reduced')
    return q*fnp.sqrt(float(n))
for kind,fn in [('gauss',make_gauss_qr),('maganti',make_maganti_qr)]:
    with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
        x=fn(5792,256,123)
    print(kind, 'shape', x.shape, 'flops', ctx.flops_used, 'wall', ctx.wall_time_s, 'resid', ctx.residual_wall_time_s)
    # print top ops compact
    d=ctx.summary_dict(by_namespace=True)
    print(d.get('flops_used'), d.get('flopscope_backend_time_s'), d.get('flopscope_overhead_time_s'))

/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
SQRT_2PI = 2.5066282746310002

def relu_diag_rows(mlp):
    width=int(mlp.width); mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
    for w in mlp.weights:
        mu_pre=w.T@mu; var_pre=fnp.maximum((w*w).T@var,1e-12); sig=fnp.sqrt(var_pre); a=mu_pre/sig; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
        mu=mu_pre*c+sig*p; e2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sig*p; var=fnp.maximum(e2-mu*mu,0.0); rows.append(mu); vars.append(var)
    return rows,vars

def exact_first(w):
    S=w.T@w
    d=fnp.maximum(fnp.diag(S),1e-12)
    sig=fnp.sqrt(d)
    denom=sig[:,None]*sig[None,:]
    rho=fnp.clip(S/denom,-1.0,1.0)
    root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
    theta=fnp.arccos(rho)
    E=denom*(root+(3.141592653589793-theta)*rho)/(2.0*3.141592653589793)
    mu=sig/SQRT_2PI
    C=E-mu[:,None]*mu[None,:]
    var=0.5*d-mu*mu
    C=C+fnp.diag(var-fnp.diag(C))
    return mu,C

def cov_match(x,mu_t,C_t):
    n=int(x.shape[0]); xc=x-fnp.mean(x,axis=0); Cs=(xc.T@xc)/float(n); Cs=(Cs+Cs.T)*0.5
    evs,Vs=fnp.linalg.eigh(Cs+fnp.eye(int(x.shape[1]))*1e-8)
    evt,Vt=fnp.linalg.eigh(C_t+fnp.eye(int(x.shape[1]))*1e-10)
    evs=fnp.maximum(evs,1e-8); evt=fnp.maximum(evt,1e-10)
    B=(Vs*(1.0/fnp.sqrt(evs))[None,:])@Vs.T
    G=(Vt*fnp.sqrt(evt)[None,:])@Vt.T
    return xc@(B@G)+mu_t

def predict(mlp,budget,frac=0.084,full=True):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed)); per=max(1,depth*(2*width*width+4*width)); n=max(1024,int(frac*float(budget)/float(per))); n=min(n,8192); n=max(2,2*(n//2))
    rows,vars=relu_diag_rows(mlp)
    half=n//2; base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced'); x=q*fnp.sqrt(float(n))
    if full:
        mu0,C0=exact_first(mlp.weights[0])
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        if full and i==0:
            x=cov_match(x,mu0,C0)
        elif i==0 or i==1:
            beta=0.8 if i==0 else 0.08
            xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
    final=fnp.mean(fnp.maximum(x@mlp.weights[-1],0.0),axis=0)
    return fnp.stack(rows[:-1]+[final],axis=0), n
mlp=sample_mlp(256,32,fnp.random.default_rng(1),seed=123); B=272_000_000_000
for frac in [0.08,0.082,0.084,0.086,0.088,0.09]:
 for full in [False,True]:
  with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
   _,n=predict(mlp,B,frac,full)
  print('frac',frac,'full',full,'n',n,'flops',ctx.flops_used,'ratio',ctx.flops_used/B,'resid',ctx.residual_wall_time_s,'wall',ctx.wall_time_s)

I’m testing a stronger first-layer correction: match the full exact covariance of the first ReLU layer, not only per-neuron variance. This costs extra matrix work but could reduce downstream probe noise.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def exact_relu0_cov(W):
 S=W.astype(np.float64).T@W.astype(np.float64); d=np.maximum(np.diag(S),1e-12); sig=np.sqrt(d); rho=np.clip(S/np.outer(sig,sig),-1,1)
 theta=np.arccos(rho); E=np.outer(sig,sig)/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
 mu=sig/SQRT2PI; C=E-np.outer(mu,mu); np.fill_diagonal(C,0.5*d-mu*mu); return mu,C
def cov_match(x,mu_t,C_t,beta):
 n=x.shape[0]; ms=x.mean(0); xc=x-ms; Cs=(xc.T@xc)/n; Cs=(Cs+Cs.T)*0.5
 evs,Vs=np.linalg.eigh(Cs+1e-8*np.eye(Cs.shape[0])); evt,Vt=np.linalg.eigh(C_t+1e-10*np.eye(C_t.shape[0])); evs=np.maximum(evs,1e-8); evt=np.maximum(evt,1e-10)
 A=(Vs*(1/np.sqrt(evs)))@Vs.T@(Vt*np.sqrt(evt))@Vt.T
 xm=xc@A+mu_t
 return (1-beta)*x+beta*xm

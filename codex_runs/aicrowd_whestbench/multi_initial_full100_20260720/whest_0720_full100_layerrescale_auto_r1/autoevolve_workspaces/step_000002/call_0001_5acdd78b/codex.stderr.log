/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def preds(weights,R,V,n=5792,seed=0,b0=1.0,b1=0.2):
 w=weights[0].shape[0]; r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=b0 if i==0 else (b1 if i==1 else 0)
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 z=x@weights[-1]
 mc=np.maximum(z,0).mean(0); mu=z.mean(0); c=z-mu; v=np.maximum((c*c).mean(0),1e-12); sig=np.sqrt(v); a=mu/sig; p=pdf(a); C=ndtr(a); zn=mu*C+sig*p
 m3=(c**3).mean(0); m4=(c**4).mean(0); skew=m3/(sig**3); exk=m4/(v*v)-3.0
 c3=-a*p; c4=(a*a-1)*p; c6=(a**4-6*a*a+3)*p
 edge3=zn+sig*(skew/6.0)*c3
 edge4=edge3+sig*(exk/24.0)*c4
 edge6=edge4+sig*((skew*skew)/72.0)*c6
 return {'mc':mc,'zn':zn,'edge3':edge3,'edge4':edge4,'edge6':edge6,'diag':np.array(R[-1])}
width=256; depth=32; ntruth=160000; seeds=range(8); res=[]; t0=time.time()
for s in seeds:
 W=gen(width,depth,11000+s); T=truth(W,ntruth,12000+s); R,V=diag(W); P=preds(W,R,V,seed=13000+s)
 d={k:np.mean((v-T)**2) for k,v in P.items()}
 for base in ['zn','edge3','edge4','edge6','diag']:
  for a in [0.01,0.02,0.05,0.08,0.1,0.15,0.2,0.3,0.5]:
   d[f'{base}{a}']=np.mean(((1-a)*P['mc']+a*P[base]-T)**2)
 print('seed',s,{k:d[k] for k in ['mc','zn','edge3','edge4','edge6','zn0.1','edge40.1','diag0.02']})
 res.append(d)
print('time',time.time()-t0)
for k in sorted(res[0], key=lambda k: np.mean([r[k] for r in res]))[:35]:
 arr=np.array([r[k] for r in res]); print(k,arr.mean(),arr.std()/math.sqrt(len(arr)))

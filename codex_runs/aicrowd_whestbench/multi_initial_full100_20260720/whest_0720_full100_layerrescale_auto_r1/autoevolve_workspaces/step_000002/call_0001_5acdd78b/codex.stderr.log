/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr, ndtri
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def make_gauss(n,w,r):
 half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def make_mag(n,w,r):
 half=n//2; base=np.empty((half,w)); offs=r.random((half,w))
 for j in range(w):
  u=(r.permutation(half)+offs[:,j])/half
  mag=ndtri(0.5+0.5*np.clip(u,1e-12,1-1e-12)); sign=np.where(r.random(half)<0.5,-1.0,1.0); base[:,j]=sign*mag
 x=np.concatenate([base,-base],0); x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0)); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def make_lhsanti(n,w,r):
 half=n//2; base=np.empty((half,w)); offs=r.random((half,w))
 for j in range(w):
  u=(r.permutation(half)+offs[:,j])/half; base[:,j]=ndtri(np.clip(u,1e-12,1-1e-12))
 x=np.concatenate([base,-base],0); x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0)); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def est(weights,R,V,x,sched):
 x=x.copy()
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=sched[i] if i<len(sched) else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; depth=32; ntruth=160000; seeds=range(10); configs=[('gauss_old','gauss',[0.8,0.08]),('gauss_b12','gauss',[1.2,0.12]),('mag_old','mag',[0.8,0.08]),('mag_b2','mag',[0.8,0.08,0.04]),('mag_b12','mag',[1.2,0.12]),('lhsanti_old','lhsanti',[0.8,0.08])]
res={c[0]:[] for c in configs}; t0=time.time()
for s in seeds:
 W=gen(width,depth,51000+s); T=truth(W,ntruth,52000+s); R,V=diag(W)
 xs={}
 rbase=53000+s
 xs['gauss']=make_gauss(5792,width,np.random.default_rng(rbase))
 xs['mag']=make_mag(5792,width,np.random.default_rng(rbase))
 xs['lhsanti']=make_lhsanti(5792,width,np.random.default_rng(rbase))
 for name,kind,sch in configs:
  p=est(W,R,V,xs[kind],sch); res[name].append(np.mean((p-T)**2))
 print('seed',s,{k:res[k][-1] for k in res})
print('time',time.time()-t0)
for k,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
 a=np.array(v); print(k,a.mean(),a.std()/math.sqrt(len(a)), 'rel_to_gauss_old', a.mean()/np.mean(res['gauss_old']))

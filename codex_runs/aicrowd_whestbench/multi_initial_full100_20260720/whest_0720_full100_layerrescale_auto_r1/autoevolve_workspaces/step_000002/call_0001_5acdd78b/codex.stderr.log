/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def est(weights,R,V,sched,n=5792,seed=0):
 w=weights[0].shape[0]; r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=sched[i] if i<len(sched) else 0.0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; depth=32; ntruth=180000; seeds=range(6); mlps=[]; t0=time.time()
for s in seeds:
 W=gen(width,depth,21000+s); T=truth(W,ntruth,22000+s); R,V=diag(W); mlps.append((W,T,R,V)); print('truth',s)
print('truth time',time.time()-t0)
scheds=[]
for b0 in [0.8,0.9,1.0,1.1,1.2]:
 for b1 in [0.12,0.16,0.2,0.24,0.28,0.34]:
  scheds.append((f'{b0:.1f},{b1:.2f}',[b0,b1]))
for b1 in [0.16,0.2,0.24,0.28]:
 for b2 in [-0.02,-0.01,0.0,0.01,0.02,0.04,0.08]:
  scheds.append((f'1,{b1:.2f},{b2:.2f}',[1.0,b1,b2]))
for b1 in [0.2,0.24]:
 for tail in [-0.01,0.005,0.01,0.02]:
  scheds.append((f'1,{b1:.2f},tail{tail}',[1.0,b1]+[tail]*6))
scheds += [('old',[0.8,0.08]),('none',[0,0])]
res={name:[] for name,_ in scheds}
for idx,(W,T,R,V) in enumerate(mlps):
 for name,sch in scheds:
  p=est(W,R,V,sch,seed=23000+idx); res[name].append(np.mean((p-T)**2))
 print('est',idx)
for name,vals in sorted(res.items(), key=lambda kv: np.mean(kv[1]))[:40]:
 a=np.array(vals); print(name,a.mean(),a.std()/math.sqrt(len(a)),[float(x) for x in vals])
print('old',np.mean(res['old']))

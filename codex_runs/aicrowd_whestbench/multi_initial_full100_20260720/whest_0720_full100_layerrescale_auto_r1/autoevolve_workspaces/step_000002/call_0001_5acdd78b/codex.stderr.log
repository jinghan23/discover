codex
A strong layer-2 covariance match is promising locally, but it adds another sample covariance/eigendecomposition/linear transform. I’m measuring its cost to choose a budget-safe sample count.
exec
/bin/bash -lc "python - <<'PY'
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
SQRT_2PI=2.5066282746310002; PI=3.141592653589793

def relu_diag(mu_pre,var_pre):
 sig=fnp.sqrt(fnp.maximum(var_pre,1e-12)); a=mu_pre/sig; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a); mu=mu_pre*c+sig*p; e2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sig*p; var=fnp.maximum(e2-mu*mu,0.0); return mu,var,a,p,c,sig

def diag_rows(mlp):
 w=int(mlp.width); mu=fnp.zeros(w); var=fnp.ones(w); rows=[]; vars=[]
 for W in mlp.weights:
  mu_pre=W.T@mu; var_pre=fnp.maximum((W*W).T@var,1e-12); mu,var,*_=relu_diag(mu_pre,var_pre); rows.append(mu); vars.append(var)
 return rows,vars

def cov_relu(mu_pre,S):
 d=fnp.maximum(fnp.diag(S),1e-12); mu,var,a,p,c,s=relu_diag(mu_pre,d); denom=s[:,None]*s[None,:]; rho=fnp.clip(S/denom,-0.999,0.999); cov=rho*(c[:,None]*c[None,:]); cov=cov+0.5*(rho*rho)*(p[:,None]*p[None,:]); c3=-a*p; cov=cov+(rho*rho*rho/6.0)*(c3[:,None]*c3[None,:]); c4=(a*a-1.0)*p; cov=cov+((rho*rho)*(rho*rho)/24.0)*(c4[:,None]*c4[None,:]); cov=cov*denom; cov=(cov+cov.T)*0.5; cov=cov+fnp.diag(var-fnp.diag(cov)); return mu,cov

def exact0(W):
 S=W.T@W; d=fnp.maximum(fnp.diag(S),1e-12); s=fnp.sqrt(d); denom=s[:,None]*s[None,:]; rho=fnp.clip(S/denom,-1.0,1.0); root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0)); theta=fnp.arccos(rho); E=denom*(root+(PI-theta)*rho)/(2*PI); mu=s/SQRT_2PI; C=E-mu[:,None]*mu[None,:]; var=0.5*d-mu*mu; C=C+fnp.diag(var-fnp.diag(C)); return mu,C

def cov_targets(mlp):
 mu0,C0=exact0(mlp.weights[0]); W=mlp.weights[1]; mu_pre=W.T@mu0; S=W.T@C0@W; S=(S+S.T)*0.5; mu1,C1=cov_relu(mu_pre,S); return [mu0,mu1],[C0,C1]

def cov_match(x,mu,C,beta):

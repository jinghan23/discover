# Compare budget-safe full2 n=5018 against baseline/full1.
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def relu_mom(m,v):
 v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; c=ndtr(a); p=pdf(a); mu=m*c+s*p; e2=(m*m+v)*c+m*s*p; var=np.maximum(e2-mu*mu,1e-12); return mu,var,a,p,c,s
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); mu,var,*_=relu_mom(m,v); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def exact0(W):
 Wd=W.astype(np.float64); S=Wd.T@Wd; d=np.maximum(np.diag(S),1e-12); s=np.sqrt(d); rho=np.clip(S/np.outer(s,s),-1,1); theta=np.arccos(rho); E=np.outer(s,s)/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho); mu=s/SQRT2PI; C=E-np.outer(mu,mu); np.fill_diagonal(C,0.5*d-mu*mu); return mu,C
def cov_relu(m,S):
 d=np.maximum(np.diag(S),1e-12); mu,var,a,p,c,s=relu_mom(m,d); rho=np.clip(S/np.outer(s,s),-0.999,0.999); cov=rho*np.outer(c,c)+0.5*rho*rho*np.outer(p,p); c3=-a*p; cov+=(rho**3)/6*np.outer(c3,c3); c4=(a*a-1)*p; cov+=(rho**4)/24*np.outer(c4,c4); cov*=np.outer(s,s); cov=(cov+cov.T)*0.5; np.fill_diagonal(cov,var); return mu,cov
def cov_targets(weights):
 mu0,C0=exact0(weights[0]); Wd=weights[1].astype(np.float64); m=Wd.T@mu0; S=Wd.T@C0@Wd; S=(S+S.T)*0.5; mu1,C1=cov_relu(m,S); return [mu0,mu1],[C0,C1]
def cov_match(x,mu,C,beta):
 n=x.shape[0]; xc=x-x.mean(0); Cs=(xc.T@xc)/n; Cs=(Cs+Cs.T)*0.5; evs,Vs=np.linalg.eigh(Cs+1e-8*np.eye(Cs.shape[0])); evt,Vt=np.linalg.eigh(C+1e-10*np.eye(C.shape[0])); evs=np.maximum(evs,1e-8); evt=np.maximum(evt,1e-10); A=((Vs*(1/np.sqrt(evs)))@Vs.T)@((Vt*np.sqrt(evt))@Vt.T); xm=xc@A+mu; return (1-beta)*x+beta*xm
def make_x(n,w,seed):
 r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def est(weights,R,V,n,seed,mode):
 x=make_x(n,weights[0].shape[0],seed)
 if mode in ['full1','full2']: crows,ccovs=cov_targets(weights)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if mode in ['full1','full2'] and i==0: x=cov_match(x,crows[0],ccovs[0],1.0)
  elif mode=='full2' and i==1: x=cov_match(x,crows[1],ccovs[1],0.7)
  elif i==0 or i==1:
   beta=0.8 if i==0 else 0.08; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm

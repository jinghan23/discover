/bin/bash -lc "python - <<'PY'
import numpy as np, time, math
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def norm_pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def norm_cdf(a): return ndtr(a)
def gen_weights(width, depth, seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((width,width))*math.sqrt(2.0/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width,dtype=np.float64); rem=n
    while rem:
        m=min(chunk,rem); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0.0)
        s += x.sum(axis=0,dtype=np.float64); rem-=m
    return s/n
def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w in weights:
        wf=w.astype(np.float64); mu_pre=wf.T@mu; var_pre=np.maximum((wf*wf).T@var,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=mu_pre*cdf+sig*phi; ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def estimate(weights,n_samples=5792,seed=999,b0=0.8,b1=0.08,qr=True):
    width=weights[0].shape[0]; rows,vars=diag_prop(weights); rng=np.random.default_rng(seed); half=n_samples//2
    base=rng.standard_normal((half,width)).astype(np.float64); x=np.concatenate([base,-base],axis=0); x=x-x.mean(0)
    if qr:
        q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n_samples)
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        beta=b0 if i==0 else (b1 if i==1 else 0)
        if beta:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    z=x@weights[-1]
    mc=np.maximum(z,0).mean(0); z_mu=z.mean(0); zc=z-z_mu; z_sig=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=z_mu/z_sig
    zn=z_mu*norm_cdf(a)+z_sig*norm_pdf(a)
    return mc, zn, np.array(rows[-1])

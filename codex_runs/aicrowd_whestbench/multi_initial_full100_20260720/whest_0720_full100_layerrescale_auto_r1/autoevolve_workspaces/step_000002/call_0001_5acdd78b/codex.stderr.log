/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def relu_mom(m,v):
 v=np.maximum(v,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a); mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,1e-12); return mu,var,a,p,c,sig
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); mu,var,*_=relu_mom(m,v); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def cov_relu(m,S,K=4):
 d=np.maximum(np.diag(S),1e-12); mu,var,a,p,c,s=relu_mom(m,d); rho=np.clip(S/np.outer(s,s),-0.999,0.999); cov=rho*np.outer(c,c); cov+=0.5*rho*rho*np.outer(p,p); c3=-a*p; cov+=(rho**3)/6*np.outer(c3,c3); c4=(a*a-1)*p; cov+=(rho**4)/24*np.outer(c4,c4); cov*=np.outer(s,s); cov=(cov+cov.T)*0.5; np.fill_diagonal(cov,var); return mu,cov
def exact0(W):
 Wd=W.astype(np.float64); S=Wd.T@Wd; d=np.maximum(np.diag(S),1e-12); sig=np.sqrt(d); rho=np.clip(S/np.outer(sig,sig),-1,1); theta=np.arccos(rho); E=np.outer(sig,sig)/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho); mu=sig/SQRT2PI; C=E-np.outer(mu,mu); np.fill_diagonal(C,0.5*d-mu*mu); return mu,C
def cov_targets(weights):
 mu,C=exact0(weights[0]); rows=[mu]; covs=[C]
 for W in weights[1:3]:
  Wd=W.astype(np.float64); m=Wd.T@mu; S=Wd.T@C@Wd; S=(S+S.T)*0.5; mu,C=cov_relu(m,S); rows.append(mu); covs.append(C)
 return rows,covs
def cov_match(x,mu,C,beta):
 n=x.shape[0]; xc=x-x.mean(0); Cs=(xc.T@xc)/n; Cs=(Cs+Cs.T)*0.5; evs,Vs=np.linalg.eigh(Cs+1e-8*np.eye(Cs.shape[0])); evt,Vt=np.linalg.eigh(C+1e-10*np.eye(C.shape[0])); evs=np.maximum(evs,1e-8); evt=np.maximum(evt,1e-10); A=((Vs*(1/np.sqrt(evs)))@Vs.T)@((Vt*np.sqrt(evt))@Vt.T); xm=xc@A+mu; return (1-beta)*x+beta*xm
def make_x(n,w,seed):
 r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def est(weights,R,V,n,seed,mode):
 x=make_x(n,weights[0].shape[0],seed); crows,ccovs=cov_targets(weights)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if i==0:
   x=cov_match(x,crows[0],ccovs[0],1.0)
  elif i==1 and mode.startswith('full2'):
   beta=float(mode[5:]); x=cov_match(x,crows[1],ccovs[1],beta)
  else:
   beta=0.08 if i==1 else 0
   if beta:
    xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; seeds=range(8); ntruth=160000; modes=['diag2','full20.05','full20.1','full20.2','full20.4','full20.7','full21.0']
res={m:[] for m in modes}; t0=time.time()
for s in seeds:
 W=gen(width,32,111000+s); T=truth(W,ntruth,112000+s); R,V=diag(W)
 for m in modes:
  p=est(W,R,V,5404,113000+s,m); res[m].append(np.mean((p-T)**2))
 print('seed',s,{m:res[m][-1] for m in modes})
print('time',time.time()-t0)
base=np.mean(res['diag2'])
for m,v in sorted(res.items(), key=lambda kv:np.mean(kv[1])):
 a=np.array(v); print(m,a.mean(),a.std()/math.sqrt(len(a)),a.mean()/base)

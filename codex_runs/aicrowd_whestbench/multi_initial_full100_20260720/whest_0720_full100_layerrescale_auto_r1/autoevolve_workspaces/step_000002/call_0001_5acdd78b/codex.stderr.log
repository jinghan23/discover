/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
    r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
    r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
    Wf=[W.astype(np.float32) for W in weights]
    while rem:
        m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
        for W in Wf: x=np.maximum(x@W,0)
        s+=x.sum(0); rem-=m
    return s/n
def relu_mom(m,v):
    v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; p=pdf(a); c=ndtr(a); mu=m*c+s*p; e2=(m*m+v)*c+m*s*p; var=np.maximum(e2-mu*mu,1e-12); return mu,var,a,p,c,s
def cov_relu(m,S,K=4,shrink=1.0):
    d=np.maximum(np.diag(S),1e-12); mu,var,a,p,c,s=relu_mom(m,d)
    ss=np.outer(s,s); rho=S/ss; rho=np.clip(rho,-0.999,0.999)*shrink
    outer=lambda u: np.outer(u,u)
    cov=rho*outer(c)
    if K>=2: cov += 0.5*(rho*rho)*outer(p)
    if K>=3:
        c3=-a*p; cov += (rho**3)/6.0*outer(c3)
    if K>=4:
        c4=(a*a-1.0)*p; cov += (rho**4)/24.0*outer(c4)
    if K>=5:
        c5=-(a*a*a-3*a)*p; cov += (rho**5)/120.0*outer(c5)
    if K>=6:
        c6=(a**4-6*a*a+3)*p; cov += (rho**6)/720.0*outer(c6)
    cov*=ss
    cov=(cov+cov.T)*0.5
    np.fill_diagonal(cov,var)
    return mu,cov
# exact zero covariance formula for first layer after preactivation zero mean
def cov_relu_zero(S):
    d=np.maximum(np.diag(S),1e-12); s=np.sqrt(d); rho=S/np.outer(s,s); rho=np.clip(rho,-1,1)
    theta=np.arccos(rho); e=np.outer(s,s)/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
    mu=s/SQRT2PI; cov=e-np.outer(mu,mu); var=0.5*d-mu*mu; np.fill_diagonal(cov,var); return mu,cov
def fullcov(weights,K=4,first_exact=True,shrink=1.0):
    w=weights[0].shape[0]; mu=np.zeros(w); C=np.eye(w); rows=[]
    for li,W in enumerate(weights):
        m=W.T@mu; S=W.T@C@W; S=(S+S.T)*0.5
        if first_exact and li==0:
            mu,C=cov_relu_zero(S)
        else:
            mu,C=cov_relu(m,S,K=K,shrink=shrink)
        rows.append(mu.copy())
    return np.array(rows)
# also baseline from previous script simplified
def diag(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        m=W.T@mu; v=np.maximum((W*W).T@var,1e-12); mu,var,a,p,c,s=relu_mom(m,v); rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars
def mc_est(weights,R,V,n=5792,seed=0,b0=0.8,b1=0.08):
    width=weights[0].shape[0]; r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,width)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0); beta=b0 if i==0 else (b1 if i==1 else 0)
        if beta:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
    return np.maximum(x@weights[-1],0).mean(0)
for width,ntruth,nseeds in [(64,300000,6),(128,160000,4),(256,80000,3)]:
    print('WIDTH',width); res=[]; t0=time.time()
    for s in range(nseeds):
        W=gen(width,32,7000+s); T=truth(W,ntruth,8000+s); R,V=diag(W); M=mc_est(W,R,V,seed=9000+s); d={'mc':np.mean((M-T)**2)}
        for K in [1,2,3,4,5,6]:
            P=fullcov(W,K=K,first_exact=True,shrink=1.0)[-1]; d[f'fc{K}']=np.mean((P-T)**2)
        for sh in [0.5,0.7,0.85,0.95]:
            P=fullcov(W,K=4,first_exact=True,shrink=sh)[-1]; d[f'fc4s{sh}']=np.mean((P-T)**2)
        # blends of mc with best-looking fc4 maybe
        P=fullcov(W,K=4,first_exact=True,shrink=1.0)[-1]
        for a in [0.02,0.05,0.1,0.2,0.4]: d[f'mcfc{a}']=np.mean(((1-a)*M+a*P-T)**2)
        print('seed',s,{k:d[k] for k in ['mc','fc1','fc2','fc3','fc4','fc5','fc6','mcfc0.05']})
        res.append(d)
    print('time',time.time()-t0)
    for k in sorted(res[0], key=lambda k: np.mean([r[k] for r in res])):
        arr=np.array([r[k] for r in res]); print(k,arr.mean(),arr.std()/math.sqrt(len(arr)))

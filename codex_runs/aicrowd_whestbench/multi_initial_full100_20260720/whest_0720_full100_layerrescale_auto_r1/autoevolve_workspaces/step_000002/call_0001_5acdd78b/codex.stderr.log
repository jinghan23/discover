codex
I’m testing stratified normal probes locally: Latin hypercube and antithetic variants, with and without QR normalization. The goal is lower probe variance at the same matrix-multiply budget.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr, ndtri
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s += x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def make_x(kind,n,w,seed):
 r=np.random.default_rng(seed)
 if kind=='gauss_qr':
  half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
 if kind=='gauss_noqr':
  half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); return x/np.sqrt(np.mean(x*x,0))*1.0
 if kind in ['lhs','lhs_qr']:
  x=np.empty((n,w))
  offs=r.random((n,w))
  for j in range(w):
   u=(r.permutation(n)+offs[:,j])/n
   u=np.clip(u,1e-12,1-1e-12); x[:,j]=ndtri(u)
  x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0))
  if kind.endswith('qr'):
   q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
  return x
 if kind in ['lhsanti','lhsanti_qr']:
  half=n//2; base=np.empty((half,w)); offs=r.random((half,w))
  for j in range(w):
   u=(r.permutation(half)+offs[:,j])/half
   u=np.clip(u,1e-12,1-1e-12); base[:,j]=ndtri(u)
  x=np.concatenate([base,-base],0); x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0))
  if kind.endswith('qr'):
   q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
  return x
 if kind in ['maganti','maganti_qr']:
  half=n//2; base=np.empty((half,w)); offs=r.random((half,w))
  for j in range(w):
   # stratify absolute normal; random signs per column
   u=(r.permutation(half)+offs[:,j])/half
   mag=ndtri(0.5+0.5*np.clip(u,1e-12,1-1e-12))
   sign=r.choice([-1.0,1.0], size=half)
   base[:,j]=sign*mag
  x=np.concatenate([base,-base],0); x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0))
  if kind.endswith('qr'):
   q,_=np.linalg.qr(x,mode='reduced'); x=q*math.sqrt(n)
  return x
 raise ValueError(kind)
def est(weights,R,V,kind,n=5792,seed=0,sch=[0.8,0.08]):
 w=weights[0].shape[0]; x=make_x(kind,n,w,seed)
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=sch[i] if i<len(sch) else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; depth=32; ntruth=180000; seeds=range(6); kinds=['gauss_qr','gauss_noqr','lhs','lhs_qr','lhsanti','lhsanti_qr','maganti','maganti_qr']
for schname,sch in [('old',[0.8,0.08]),('b12',[1.2,0.12])]:
 print('SCHED',schname); res={k:[] for k in kinds}; t0=time.time()
 for s in seeds:
  W=gen(width,depth,31000+s); T=truth(W,ntruth,32000+s); R,V=diag(W)
  for k in kinds:
   p=est(W,R,V,k,seed=33000+s,sch=sch); res[k].append(np.mean((p-T)**2))
  print('seed',s,{k:res[k][-1] for k in kinds})
 print('time',time.time()-t0)
 for k,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
  a=np.array(v); print(k,a.mean(),a.std()/math.sqrt(len(a)))

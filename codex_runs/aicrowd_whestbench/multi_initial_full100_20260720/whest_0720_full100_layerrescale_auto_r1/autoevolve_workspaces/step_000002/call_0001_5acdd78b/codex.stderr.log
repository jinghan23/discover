codex
At the default shape, full first-layer covariance matching with `frac=0.084` stays under the 0.1 effective-compute region and uses about 5,404 probes. I’m comparing that against the original 5,790-probe baseline on synthetic MLPs.
exec
/bin/bash -lc "python - <<'PY'
# Local numpy comparison: baseline n=5792 vs full first-layer cov match n=5404/5532.
import numpy as np, math, time
from scipy.special import ndtr
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def exact_relu0_cov(W):
 Wd=W.astype(np.float64); S=Wd.T@Wd; d=np.maximum(np.diag(S),1e-12); sig=np.sqrt(d); rho=np.clip(S/np.outer(sig,sig),-1,1)
 theta=np.arccos(rho); E=np.outer(sig,sig)/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
 mu=sig/SQRT2PI; C=E-np.outer(mu,mu); np.fill_diagonal(C,0.5*d-mu*mu); return mu,C
def cov_match(x,mu_t,C_t,beta=1.0):
 n=x.shape[0]; ms=x.mean(0); xc=x-ms; Cs=(xc.T@xc)/n; Cs=(Cs+Cs.T)*0.5
 evs,Vs=np.linalg.eigh(Cs+1e-8*np.eye(Cs.shape[0])); evt,Vt=np.linalg.eigh(C_t+1e-10*np.eye(C_t.shape[0])); evs=np.maximum(evs,1e-8); evt=np.maximum(evt,1e-10)
 B=(Vs*(1/np.sqrt(evs)))@Vs.T; G=(Vt*np.sqrt(evt))@Vt.T; xm=xc@(B@G)+mu_t; return (1-beta)*x+beta*xm
def make_x(n,w,seed):
 r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,w)); x=np.concatenate([base,-base],0); x-=x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def est(weights,R,V,n,seed,full=False,beta_full=1.0,b1=0.08):
 x=make_x(n,weights[0].shape[0],seed)
 if full: mu0,C0=exact_relu0_cov(weights[0])
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if full and i==0:
   x=cov_match(x,mu0,C0,beta_full)
  else:
   beta=0.8 if i==0 else (b1 if i==1 else 0)
   if beta:
    xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@weights[-1],0).mean(0)
width=256; ntruth=180000; seeds=range(12); configs=[('base5792',5792,False,1.0,0.08),('base5918',5918,False,1.0,0.08),('full5404',5404,True,1.0,0.08),('full5532',5532,True,1.0,0.08),('full5404b05',5404,True,0.5,0.08),('full5404b1_12',5404,True,1.0,0.12)]
res={c[0]:[] for c in configs}; t0=time.time()
for s in seeds:
 W=gen(width,32,101000+s); T=truth(W,ntruth,102000+s); R,V=diag(W)
 for name,n,full,bf,b1 in configs:
  p=est(W,R,V,n,103000+s,full,bf,b1); res[name].append(np.mean((p-T)**2))
 print('seed',s,{k:res[k][-1] for k in res})
print('time',time.time()-t0)
base=np.mean(res['base5792'])
for k,v in sorted(res.items(), key=lambda kv: np.mean(kv[1])):
 a=np.array(v); print(k,a.mean(),a.std()/math.sqrt(len(a)),a.mean()/base)

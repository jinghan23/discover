codex
I’m tuning the moment-match schedule specifically for the half-normal stratified probes; the best Gaussian schedule may not be best once the input design changes.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr, ndtri
SQRT2PI=math.sqrt(2*math.pi)
def pdf(a): return np.exp(-0.5*a*a)/SQRT2PI
def gen(width,depth,seed):
 r=np.random.default_rng(seed); return [(r.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
def truth(weights,n,seed,chunk=5000):
 r=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); rem=n
 while rem:
  m=min(chunk,rem); x=r.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); rem-=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(np.float64); m=Wd.T@mu; v=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(v); a=m/sig; c=ndtr(a); p=pdf(a)
  mu=m*c+sig*p; e2=(m*m+v)*c+m*sig*p; var=np.maximum(e2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def make_mag(n,w,seed):
 r=np.random.default_rng(seed); half=n//2; base=np.empty((half,w)); offs=r.random((half,w))
 for j in range(w):
  u=(r.permutation(half)+offs[:,j])/half
  mag=ndtri(0.5+0.5*np.clip(u,1e-12,1-1e-12))
  sign=np.where(r.random(half)<0.5,-1.0,1.0)
  base[:,j]=sign*mag
 x=np.concatenate([base,-base],0); x-=x.mean(0); x/=np.sqrt(np.mean(x*x,0)); q,_=np.linalg.qr(x,mode='reduced'); return q*math.sqrt(n)
def est_from_x(weights,R,V,x,sched,diag_blend=0.0):
 x=x.copy()
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0); beta=sched[i] if i<len(sched) else 0.0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+R[i]; x=(1-beta)*x+beta*xm
 p=np.maximum(x@weights[-1],0).mean(0)
 if diag_blend:
  p=(1-diag_blend)*p+diag_blend*np.array(R[-1])
 return p
width=256; depth=32; ntruth=160000; seeds=range(8); mlps=[]; t0=time.time()
for s in seeds:
 W=gen(width,depth,41000+s); T=truth(W,ntruth,42000+s); R,V=diag(W); X=make_mag(5792,width,43000+s); mlps.append((W,T,R,V,X)); print('truth',s)
print('prep',time.time()-t0)
scheds=[]
for b0 in [0.8,1.0,1.2,1.4]:
 for b1 in [0.04,0.08,0.12,0.16,0.2,0.28]: scheds.append((f'{b0},{b1}',[b0,b1]))
for b0,b1 in [(1.2,0.12),(1.2,0.16),(1.0,0.12),(0.8,0.08)]:
 for b2 in [-0.02,-0.01,0.0,0.01,0.02,0.04]: scheds.append((f'{b0},{b1},{b2}',[b0,b1,b2]))
res={name:[] for name,_ in scheds}; res_blend={}
for idx,(W,T,R,V,X) in enumerate(mlps):
 for name,sch in scheds:
  p=est_from_x(W,R,V,X,sch); res[name].append(np.mean((p-T)**2))
 print('est',idx)
# diag blend around best few plus old
best=sorted(res.items(), key=lambda kv: np.mean(kv[1]))[:10]+[(\"old\",res.get('0.8,0.08'))]
print('BEST raw')
for name,vals in best:
 print(name,np.mean(vals),np.std(vals)/math.sqrt(len(vals)))
# Compute diag blend for selected schedules
selected=['1.2,0.12','1.2,0.16','1.0,0.12','0.8,0.08','1.4,0.12']
for name in selected:
 sch=dict(scheds)[name]
 for a in [0.005,0.01,0.02,0.03,0.05]:
  vals=[]
  for W,T,R,V,X in mlps:
   p=est_from_x(W,R,V,X,sch,diag_blend=a); vals.append(np.mean((p-T)**2))
  res_blend[f'{name}+d{a}']=vals
print('BEST with blend')
allres={**res,**res_blend}
for name,vals in sorted(allres.items(), key=lambda kv: np.mean(kv[1]))[:30]:
 print(name,np.mean(vals),np.std(vals)/math.sqrt(len(vals)),[float(x) for x in vals])

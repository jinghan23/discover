from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp

class ParamEstimator(BaseEstimator):
    def __init__(self, frac=0.09, beta0=0.65, beta1=0.06, radial=True, offset=0, cap=8192, min_n=1024):
        self.frac=frac; self.beta0=beta0; self.beta1=beta1; self.radial=radial; self.offset=offset; self.cap=cap; self.min_n=min_n
    def predict(self, mlp, budget):
        width = int(mlp.width); depth = int(mlp.depth)
        rng = fnp.random.default_rng(int(mlp.seed) + int(self.offset))
        per_sample = max(1, depth * (2 * width * width + 4 * width))
        n_samples = max(int(self.min_n), int((float(self.frac) * float(budget)) / float(per_sample)))
        n_samples = min(int(self.cap), n_samples)
        n_samples = max(2, 2 * (n_samples // 2))
        mu = fnp.zeros(width); var = fnp.ones(width)
        diag_rows=[]; diag_vars=[]
        for w in mlp.weights:
            mu_pre = w.T @ mu
            var_pre = fnp.maximum((w*w).T @ var, 1e-12)
            sigma = fnp.sqrt(var_pre)
            alpha = mu_pre / sigma
            phi = flops.stats.norm.pdf(alpha); cdf = flops.stats.norm.cdf(alpha)
            mu = mu_pre*cdf + sigma*phi
            ez2 = (mu_pre*mu_pre+var_pre)*cdf + mu_pre*sigma*phi
            var = fnp.maximum(ez2 - mu*mu, 0.0)
            diag_rows.append(mu); diag_vars.append(var)
        half=n_samples//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base), axis=0)
        x=x-fnp.mean(x, axis=0)
        q,_=fnp.linalg.qr(x, mode='reduced')
        if self.radial:
            raw_norm=fnp.sqrt(fnp.maximum(fnp.sum(x*x, axis=1), 1e-12))[:,None]
            q_norm=fnp.sqrt(fnp.maximum(fnp.sum(q*q, axis=1), 1e-12))[:,None]
            x=q*(raw_norm/q_norm)
            x=x-fnp.mean(x, axis=0)
            x_var=fnp.maximum(fnp.mean(x*x, axis=0), 1e-12)
            x=x*fnp.sqrt(1.0/x_var)
        else:
            x=q*fnp.sqrt(float(n_samples))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w, 0.0)
            if i == 0 and self.beta0 "'!= 0.0:
                x_center=x-fnp.mean(x, axis=0)
                x_var=fnp.maximum(fnp.mean(x_center*x_center, axis=0), 1e-12)
                x_match=x_center*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/x_var)+diag_rows[i]
                x=(1.0-self.beta0)*x+self.beta0*x_match
            elif i == 1 and self.beta1 != 0.0:
                x_center=x-fnp.mean(x, axis=0)
                x_var=fnp.maximum(fnp.mean(x_center*x_center, axis=0), 1e-12)
                x_match=x_center*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/x_var)+diag_rows[i]
                x=(1.0-self.beta1)*x+self.beta1*x_match
        final_act=fnp.maximum(x@mlp.weights[-1], 0.0)
        final_pred=fnp.asarray(fnp.mean(fnp.asarray(final_act, dtype=fnp.float64), axis=0), dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(diag_rows, axis=0), dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None,:]), axis=0), dtype=fnp.float32)

spec = ContestSpec(width=256, depth=32, n_mlps=3, flop_budget=272_000_000_000, ground_truth_samples=20000, seed=321)
print('"'making data')
data = make_contest(spec)
variants = []
for frac in [0.075,0.085,0.09,0.095,0.10,0.11,0.13,0.16]:
    variants.append((f'frac={frac}', dict(frac=frac,beta0=0.65,beta1=0.06,radial=True)))
for b0 in [0.45,0.55,0.60,0.65,0.70,0.75,0.85,1.0]:
    variants.append((f'b0={b0}', dict(frac=0.09,beta0=b0,beta1=0.06,radial=True)))
for b1 in [-0.10,-0.05,0.0,0.03,0.06,0.10,0.15,0.25,0.4]:
    variants.append((f'b1={b1}', dict(frac=0.09,beta0=0.65,beta1=b1,radial=True)))
variants += [('norad', dict(frac=0.09,beta0=0.65,beta1=0.06,radial=False))]
for name, kwargs in variants:
    res = evaluate_estimator(ParamEstimator(**kwargs), data)
    print(name, res['adjusted_final_layer_score'], res['raw_score'] if 'raw_score' in res else '', 'mse', res['final_layer_mse'], 'flops', res['per_mlp'][0]['flops_used'])

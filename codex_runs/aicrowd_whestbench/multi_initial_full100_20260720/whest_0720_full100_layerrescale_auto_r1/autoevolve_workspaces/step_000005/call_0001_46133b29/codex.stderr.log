            mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0)
            rows.append(mu); vars.append(var)
        half=n_samples//2; base=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32))
        x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced')

Since the blackbox service is unavailable, I’ll do one higher-fidelity local comparison using 1,000,000 target samples for a couple of public synthetic MLPs. That reduces target noise enough to sanity-check the patched beta profile.
exec
/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp
class Est(BaseEstimator):
    def __init__(self, radial=True, betas=(0.65,0.06)): self.radial=radial; self.betas=tuple(betas)
    def predict(self,mlp,budget):
        W=int(mlp.width); D=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
        per=max(1,D*(2*W*W+4*W)); n=max(1024,int(0.09*float(budget)/float(per))); n=min(8192,n); n=max(2,2*(n//2))
        mu=fnp.zeros(W); var=fnp.ones(W); rows=[]; vars=[]
        for w in mlp.weights:
            mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
            mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0); rows.append(mu); vars.append(var)
        half=n//2; base=fnp.asarray(rng.standard_normal((half,W),dtype=fnp.float32)); raw=fnp.concatenate((base,-base),axis=0); raw=raw-fnp.mean(raw,axis=0); q,_=fnp.linalg.qr(raw,mode='reduced')
        if self.radial:
            rn=fnp.sqrt(fnp.maximum(fnp.sum(raw*raw,axis=1),1e-12))[:,None]; qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        else:
            x=q*fnp.sqrt(float(n))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0); beta=self.betas[i] if i<len(self.betas) else 0.0
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
        y=fnp.maximum(x@mlp.weights[-1],0.0); fp=fnp.asarray(fnp.mean(fnp.asarray(y,dtype=fnp.float64),axis=0),dtype=fnp.float32); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)
variants=[('orig',Est(True,(0.65,0.06))),('q_origbeta',Est(False,(0.65,0.06))),('q_1_006_010',Est(False,(1.0,0.06,0.10))),('q_1_003_012',Est(False,(1.0,0.03,0.12))),('q_1_006_012',Est(False,(1.0,0.06,0.12)))]
for sd in [111,222]:
    print('make',sd)
    data=make_contest(ContestSpec(width=256,depth=32,n_mlps=1,flop_budget=272_000_000_000,ground_truth_samples=1000000,seed=sd))
    for name,est in variants:
        res=evaluate_estimator(est,data)
        print(sd,name,res['adjusted_final_layer_score'],res['final_layer_mse'])

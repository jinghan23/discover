The non-radial orthogonal cloud may be a bias/variance tradeoff rather than a universal win. I’ll compare base radial and plain orthogonal across several independently generated synthetic MLPs with 200k target samples.
exec
/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp

class Est(BaseEstimator):
    def __init__(self, radial=True, b1=0.06, frac=0.09): self.radial=radial; self.b1=b1; self.frac=frac
    def predict(self, mlp,budget):
        width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
        per=max(1,depth*(2*width*width+4*width)); n=max(1024,int(self.frac*float(budget)/float(per))); n=min(8192,n); n=max(2,2*(n//2))
        mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
        for w in mlp.weights:
            mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
            mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0); rows.append(mu); vars.append(var)
        half=n//2; base=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32)); raw=fnp.concatenate((base,-base),axis=0); raw=raw-fnp.mean(raw,axis=0)
        q,_=fnp.linalg.qr(raw,mode='reduced')
        if self.radial:
            rn=fnp.sqrt(fnp.maximum(fnp.sum(raw*raw,axis=1),1e-12))[:,None]; qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        else:
            x=q*fnp.sqrt(float(n))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0); beta=0.65 if i==0 else (self.b1 if i==1 else 0.0)
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
        y=fnp.maximum(x@mlp.weights[-1],0.0); fp=fnp.asarray(fnp.mean(fnp.asarray(y,dtype=fnp.float64),axis=0),dtype=fnp.float32); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

variants=[('rad_b006', Est(True,0.06)),('q_b006',Est(False,0.06)),('rad_b032',Est(True,0.32)),('q_b032',Est(False,0.32)),('q_b028',Est(False,0.28)),('q_b04',Est(False,0.4))]
seeds=[111,222,333,444]
acc={name:0.0 for name,_ in variants}
for sd in seeds:
    print('seed',sd)
    data=make_contest(ContestSpec(width=256,depth=32,n_mlps=1,flop_budget=272_000_000_000,ground_truth_samples=200000,seed=sd))
    for name,est in variants:
        res=evaluate_estimator(est,data)
        val=res['adjusted_final_layer_score']; acc[name]+=val
        print(name,val)
print('avg')
for name in acc:
    print(name, acc[name]/len(seeds))

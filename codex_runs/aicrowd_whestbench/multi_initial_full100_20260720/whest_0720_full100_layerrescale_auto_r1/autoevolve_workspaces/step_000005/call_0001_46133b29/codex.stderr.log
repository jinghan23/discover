from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp

class ParamEstimator(BaseEstimator):
    def __init__(self, frac=0.09, betas=(0.65,0.25), radial=True, gamma_gauss=0.0, gamma_diag=0.0):
        self.frac=frac; self.betas=tuple(betas); self.radial=radial; self.gamma_gauss=gamma_gauss; self.gamma_diag=gamma_diag
    def predict(self, mlp, budget):
        width=int(mlp.width); depth=int(mlp.depth)
        rng=fnp.random.default_rng(int(mlp.seed))
        per_sample=max(1, depth*(2*width*width+4*width))
        n_samples=max(1024, int((float(self.frac)*float(budget))/float(per_sample)))
        n_samples=min(8192, n_samples); n_samples=max(2,2*(n_samples//2))
        mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
        for w in mlp.weights:
            mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s
            phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
            mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0)
            rows.append(mu); vars.append(var)
        half=n_samples//2; base=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0)
        q,_=fnp.linalg.qr(x,mode='reduced')
        if self.radial:
            rn=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]; qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        else:
            x=q*fnp.sqrt(float(n_samples))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=self.betas[i] if i<len(self.betas) else 0.0
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]
                x=(1.0-beta)*x+beta*xm
        z=x@mlp.weights[-1]
        relu_mean=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(z,0.0),dtype=fnp.float64),axis=0),dtype=fnp.float32)
        if self.gamma_gauss "'!= 0.0:
            mz=fnp.mean(fnp.asarray(z,dtype=fnp.float64),axis=0)
            ez2=fnp.mean(fnp.asarray(z*z,dtype=fnp.float64),axis=0)
            vz=fnp.maximum(ez2-mz*mz,1e-12)
            sz=fnp.sqrt(vz); a=mz/sz; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
            gauss=fnp.asarray(mz*cdf+sz*phi,dtype=fnp.float32)
            relu_mean=(1.0-self.gamma_gauss)*relu_mean+self.gamma_gauss*gauss
        if self.gamma_diag != 0.0:
            relu_mean=(1.0-self.gamma_diag)*relu_mean+self.gamma_diag*rows[-1]
        diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1],relu_mean[None,:]),axis=0),dtype=fnp.float32)


        y=fnp.maximum(x@mlp.weights[-1],0.0)
        fp=fnp.asarray(fnp.mean(fnp.asarray(y,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], fp[None,:]),axis=0), dtype=fnp.float32)


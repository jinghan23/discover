        q,_=fnp.linalg.qr(x, mode='reduced')
        if self.radial:
            raw=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]
            qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(raw/qn); x=x-fnp.mean(x,axis=0)
            xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        else:
            x=q*fnp.sqrt(float(n_samples))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=self.betas[i] if i < len(self.betas) else 0.0
            if beta "'!= 0.0:
                xc=x-fnp.mean(x,axis=0)
                xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=(1.0-beta)*x+beta*xm
        final=fnp.maximum(x@mlp.weights[-1],0.0)
        fp=fnp.asarray(fnp.mean(fnp.asarray(final,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(diag_rows,axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)


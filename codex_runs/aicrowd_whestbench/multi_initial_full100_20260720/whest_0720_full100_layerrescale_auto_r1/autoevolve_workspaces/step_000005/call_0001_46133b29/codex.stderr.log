            qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        else:
            x=q*fnp.sqrt(float(n_samples))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=self.betas[i] if i < len(self.betas) else 0.0
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]

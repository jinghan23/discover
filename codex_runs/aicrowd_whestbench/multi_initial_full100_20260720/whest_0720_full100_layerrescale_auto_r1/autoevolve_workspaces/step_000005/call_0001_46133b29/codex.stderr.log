        half=n//2; base=fnp.asarray(rng.standard_normal((half,wdt),dtype=fnp.float32)); raw=fnp.concatenate((base,-base),axis=0); raw=raw-fnp.mean(raw,axis=0); q,_=fnp.linalg.qr(raw,mode='reduced')
        if self.radial:

/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp

class Est(BaseEstimator):
    def __init__(self, betas): self.betas=tuple(betas)
    def predict(self,mlp,budget):
        W=int(mlp.width); D=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed)); n=max(1024,int(0.09*float(budget)/float(max(1,D*(2*W*W+4*W))))); n=min(8192,n); n=max(2,2*(n//2))
        mu=fnp.zeros(W); var=fnp.ones(W); rows=[]; vars=[]
        for w in mlp.weights:
            mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a); mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0); rows.append(mu); vars.append(var)
        half=n//2; base=fnp.asarray(rng.standard_normal((half,W),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced'); x=q*fnp.sqrt(float(n))
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0); beta=self.betas[i] if i<len(self.betas) else 0.0
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
        y=fnp.maximum(x@mlp.weights[-1],0.0); fp=fnp.asarray(fnp.mean(fnp.asarray(y,dtype=fnp.float64),axis=0),dtype=fnp.float32); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32); return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

def features(mlp,budget=272_000_000_000):
    W=int(mlp.width); D=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed)); n=max(1024,int(0.09*float(budget)/float(max(1,D*(2*W*W+4*W))))); n=min(8192,n); n=max(2,2*(n//2))
    mu=fnp.zeros(W); var=fnp.ones(W); rows=[]; vars=[]
    for w in mlp.weights:
        mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a); mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0); rows.append(mu); vars.append(var)
    half=n//2; base=fnp.asarray(rng.standard_normal((half,W),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced'); x=q*fnp.sqrt(float(n))
    for i,w in enumerate(mlp.weights[:3]):
        x=fnp.maximum(x@w,0.0)
        beta=1.0 if i==0 else (0.03 if i==1 else 0.0)
        sm=fnp.mean(x,axis=0); xc=x-sm; sv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
        if i==2:
            dm=sm-rows[i]; dv=sv-vars[i]
            relm=float(fnp.sqrt(fnp.mean((dm*dm)/fnp.maximum(vars[i],1e-12))))
            relv=float(fnp.sqrt(fnp.mean((dv*dv)/fnp.maximum(vars[i]*vars[i],1e-12))))
            meanbias=float(fnp.mean(dm))
            varratio=float(fnp.mean(sv/fnp.maximum(vars[i],1e-12)))
            # predicted impact of b2 on next preactivation variance via layer 3 weights
            corr=(xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/sv)+rows[i])-x
            dn=float(fnp.sqrt(fnp.mean(corr*corr)))
            return relm, relv, meanbias, varratio, dn
        if beta:
            xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/sv)+rows[i]; x=(1-beta)*x+beta*xm
    return (0,0,0,0,0)

seeds=[111,222,333,444,555,666,777,888]
for sd in seeds:
    data=make_contest(ContestSpec(width=256,depth=32,n_mlps=1,flop_budget=272_000_000_000,ground_truth_samples=100000,seed=sd))
    mlp=data.mlps[0]
    orig=evaluate_estimator(Est((0.65,0.06)),data)['adjusted_final_layer_score']
    no2=evaluate_estimator(Est((1.0,0.03,0.0)),data)['adjusted_final_layer_score']
    b2=evaluate_estimator(Est((1.0,0.03,0.12)),data)['adjusted_final_layer_score']
    print(sd,'orig',orig,'no2',no2,'b2',b2,'feat',features(mlp))

I’m testing final-layer shrinkage toward analytic predictions locally. This is cheap in the submission and could reduce variance if a very small blend offsets sample noise without importing too much analytic bias.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import time

class BlendE(BaseEstimator):
    def __init__(self, gamma=0.0, target='diag'):
        self.gamma=gamma; self.target=target
    def predict(self, mlp,budget):
        width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
        n=max(1024,int((0.09*float(budget))/float(max(1,depth*(2*width*width+4*width))))); n=min(n,8192); n=max(2,2*(n//2))
        mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
        for w in mlp.weights:
            mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
            mu=mp*c+s*p; ez=(mp*mp+vp)*c+mp*s*p; var=fnp.maximum(ez-mu*mu,0.0); rows.append(mu); vars.append(var)
        # optional cheap covariance final target
        cov_final=None
        if self.target=='cov':
            mu2=fnp.zeros(width); cov=fnp.eye(width)
            for w in mlp.weights:
                mp=w.T@mu2; cp=w.T@cov@w; vp=fnp.maximum(fnp.diag(cp),1e-12); s=fnp.sqrt(vp); a=mp/s; p=flops.stats.norm.pdf(a); c=flops.stats.norm.cdf(a)
                mu2=mp*c+s*p; ez=(mp*mp+vp)*c+mp*s*p; varp=fnp.maximum(ez-mu2*mu2,0.0)
                gain=fnp.where(s>1e-12,c,0.0); cov=fnp.multiply(fnp.outer(gain,gain),cp); fnp.fill_diagonal(cov,varp)
            cov_final=mu2
        h=n//2; base=fnp.asarray(rng.standard_normal((h,width),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced')
        rn=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]; qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
        x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0); beta=0.65 if i==0 else (0.06 if i==1 else 0.0)
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1.0-beta)*x+beta*xm
        fp=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(x@mlp.weights[-1],0.0),dtype=fnp.float64),axis=0),dtype=fnp.float32)
        if self.gamma "'!= 0.0:
            tgt=rows[-1] if self.target=='"'diag' else cov_final
            fp=fnp.asarray((1.0-self.gamma)*fp+self.gamma*tgt,dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

variants=[('base',BlendE(0.0))]
for g in [-0.05,-0.02,-0.01,0.005,0.01,0.02,0.05,0.1]: variants.append((f'diag{g}',BlendE(g,'diag')))
for g in [-0.1,-0.05,-0.02,0.01,0.02,0.05,0.1,0.2]: variants.append((f'cov{g}',BlendE(g,'cov')))
agg={k:[] for k,_ in variants}
for seed in [909,1009]:
    spec=ContestSpec(width=256,depth=32,n_mlps=5,flop_budget=272_000_000_000,ground_truth_samples=180000,seed=seed,wall_time_limit_s=60.0)
    print('make',seed); t=time.time(); data=make_contest(spec); print('make_s',time.time()-t)
    for name,est in variants:
        t=time.time(); res=evaluate_estimator(est,data); agg[name].append(res['adjusted_final_layer_score']); print(seed,name,f\"{res['adjusted_final_layer_score']:.9g}\", 'mse', f\"{res['final_layer_mse']:.9g}\", 'util', f\"{res['mean_compute_utilization']:.4f}\", 's', f\"{time.time()-t:.2f}\")
for name,vals in agg.items(): print('AVG',name,f\"{sum(vals)/len(vals):.9g}\")

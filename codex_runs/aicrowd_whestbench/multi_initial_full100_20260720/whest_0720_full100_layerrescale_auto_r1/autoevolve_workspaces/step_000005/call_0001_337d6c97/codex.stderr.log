            mu=mp*c+s*p; ez=(mp*mp+vp)*c+mp*s*p; var=fnp.maximum(ez-mu*mu,0.0); rows.append(mu); vars.append(var)
        h=n//2; base=fnp.asarray(rng.standard_normal((h,width),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0); x=x-fnp.mean(x,axis=0); q,_=fnp.linalg.qr(x,mode='reduced')
        rn=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]; qn=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
        x=q*(rn/qn); x=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0),1e-12); x=x*fnp.sqrt(1.0/xv)
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=0.65 if i==0 else (0.06 if i==1 else 0.0)
            if beta:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1.0-beta)*x+beta*xm
        fp=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(x@mlp.weights[-1],0.0),dtype=fnp.float64),axis=0),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

spec=ContestSpec(width=256,depth=32,n_mlps=5,flop_budget=272_000_000_000,ground_truth_samples=180000,seed=777,wall_time_limit_s=60.0)

exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import time

_INV_SQRT_2PI = 0.3989422804014327
_TWO_PI = 6.283185307179586

class ParamEstimator(BaseEstimator):
    def __init__(self, frac=0.09, b0=0.65, b1=0.06, b2=0.0, radial=True, whiten=False, exact2=False, cap=8192, floor=1024):
        self.frac=frac; self.b0=b0; self.b1=b1; self.b2=b2; self.radial=radial; self.whiten=whiten; self.exact2=exact2; self.cap=cap; self.floor=floor
    def _diag(self, mlp, width):
        mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
        for w in mlp.weights:
            mu_pre=w.T@mu
            var_pre=fnp.maximum((w*w).T@var, 1e-12)
            sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
            phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
            mu=mu_pre*cdf+sigma*phi
            ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
            var=fnp.maximum(ez2-mu*mu, 0.0)
            rows.append(mu); vars.append(var)
        if self.exact2 and len(mlp.weights) > 1:
            w0=mlp.weights[0]; w1=mlp.weights[1]
            cov0=w0.T@w0
            v0=fnp.maximum(fnp.diag(cov0), 1e-12)
            s0=fnp.sqrt(v0)
            mu0=s0*_INV_SQRT_2PI
            denom=fnp.maximum(fnp.outer(s0,s0), 1e-12)
            rho=fnp.clip(cov0/denom, -0.999999, 0.999999)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho, 0.0))
            ker=(denom/_TWO_PI)*(root+(3.141592653589793-fnp.arccos(rho))*rho)
            cova=ker-fnp.outer(mu0,mu0)
            # exact diagonal from univariate half-normal, avoids tiny arccos diagonal error
            fnp.fill_diagonal(cova, fnp.maximum(0.5*v0-mu0*mu0, 0.0))
            m1=w1.T@mu0
            tmp=cova@w1
            vp1=fnp.maximum(fnp.sum(w1*tmp, axis=0), 1e-12)
            sig=fnp.sqrt(vp1); a=m1/sig
            phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
            mu1=m1*cdf+sig*phi
            ez2=(m1*m1+vp1)*cdf+m1*sig*phi
            var1=fnp.maximum(ez2-mu1*mu1, 0.0)
            rows[1]=mu1; vars[1]=var1
        return rows, vars
    def predict(self, mlp, budget):
        width=int(mlp.width); depth=int(mlp.depth)
        rng=fnp.random.default_rng(int(mlp.seed))
        per_sample=max(1, depth*(2*width*width+4*width))
        n_samples=max(self.floor, int((self.frac*float(budget))/float(per_sample)))
        n_samples=min(n_samples, self.cap)
        n_samples=max(2, 2*(n_samples//2))
        rows,vars=self._diag(mlp,width)
        half=n_samples//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base), axis=0)
        x=x-fnp.mean(x, axis=0)
        q,_=fnp.linalg.qr(x, mode='reduced')
        if self.radial:
            raw_norm=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]
            q_norm=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(raw_norm/q_norm)
            x=x-fnp.mean(x,axis=0)
            if self.whiten:
                cov=(x.T@x)/float(n_samples)
                chol=fnp.linalg.cholesky(cov + fnp.eye(width)*1e-6)
                invt=fnp.linalg.inv(chol.T)
                x=x@invt
                x=x-fnp.mean(x,axis=0)
            x_var=fnp.maximum(fnp.mean(x*x,axis=0),1e-12)
            x=x*fnp.sqrt(1.0/x_var)
        else:
            x=q*fnp.sqrt(float(n_samples))
        betas=(self.b0,self.b1,self.b2)
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=betas[i] if i < len(betas) else 0.0
            if beta "'!= 0.0:
                xc=x-fnp.mean(x,axis=0)
                xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]
                x=(1.0-beta)*x+beta*xm
        final_act=fnp.maximum(x@mlp.weights[-1],0.0)
        final_pred=fnp.asarray(fnp.mean(fnp.asarray(final_act,dtype=fnp.float64),axis=0),dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(rows,axis=0), dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None,:]), axis=0), dtype=fnp.float32)


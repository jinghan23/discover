A promising low-cost change is to stop estimating the final ReLU mean directly from thresholded samples. After the penultimate layer, the final preactivation is a wide weighted sum, so using sample mean/variance plus the Gaussian ReLU moment formula may reduce final sampling noise. I’m testing that and small blends locally.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
import time

class ParamEstimator(BaseEstimator):
    def __init__(self, frac=0.09, b0=0.65, b1=0.06, b2=0.0, final_gauss=0.0, radial=True, cap=8192, floor=1024):
        self.frac=frac; self.b0=b0; self.b1=b1; self.b2=b2; self.final_gauss=final_gauss; self.radial=radial; self.cap=cap; self.floor=floor
    def predict(self, mlp, budget):
        width=int(mlp.width); depth=int(mlp.depth)
        rng=fnp.random.default_rng(int(mlp.seed))
        per_sample=max(1, depth*(2*width*width+4*width))
        n_samples=max(self.floor, int((self.frac*float(budget))/float(per_sample)))
        n_samples=min(n_samples, self.cap)
        n_samples=max(2, 2*(n_samples//2))
        mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
        for w in mlp.weights:
            mu_pre=w.T@mu
            var_pre=fnp.maximum((w*w).T@var, 1e-12)
            sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
            phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
            mu=mu_pre*cdf+sigma*phi
            ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
            var=fnp.maximum(ez2-mu*mu, 0.0)
            rows.append(mu); vars.append(var)
        half=n_samples//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base), axis=0)
        x=x-fnp.mean(x, axis=0)
        q,_=fnp.linalg.qr(x, mode='reduced')
        if self.radial:
            raw_norm=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))[:,None]
            q_norm=fnp.sqrt(fnp.maximum(fnp.sum(q*q,axis=1),1e-12))[:,None]
            x=q*(raw_norm/q_norm)
            x=x-fnp.mean(x,axis=0)
            x_var=fnp.maximum(fnp.mean(x*x,axis=0),1e-12)
            x=x*fnp.sqrt(1.0/x_var)
        else:
            x=q*fnp.sqrt(float(n_samples))
        betas=(self.b0,self.b1,self.b2)
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            beta=betas[i] if i < len(betas) else 0.0
            if beta "'!= 0.0:
                xc=x-fnp.mean(x,axis=0)
                xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]
                x=(1.0-beta)*x+beta*xm
        pre=x@mlp.weights[-1]
        relu_mean=fnp.asarray(fnp.mean(fnp.asarray(fnp.maximum(pre,0.0), dtype=fnp.float64), axis=0), dtype=fnp.float32)
        if self.final_gauss != 0.0:
            pm=fnp.mean(fnp.asarray(pre,dtype=fnp.float64), axis=0)
            pc=fnp.asarray(pre,dtype=fnp.float64)-pm
            pv=fnp.maximum(fnp.mean(pc*pc,axis=0),1e-12)
            sig=fnp.sqrt(pv); a=pm/sig
            gp=fnp.asarray(pm*flops.stats.norm.cdf(a)+sig*flops.stats.norm.pdf(a), dtype=fnp.float32)
            relu_mean=fnp.asarray((1.0-self.final_gauss)*relu_mean+self.final_gauss*gp, dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(rows,axis=0), dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], relu_mean[None,:]), axis=0), dtype=fnp.float32)

spec=ContestSpec(width=256, depth=32, n_mlps=3, flop_budget=272_000_000_000, ground_truth_samples=150000, seed=2026, wall_time_limit_s=60.0)
print('"'make')
t=time.time(); data=make_contest(spec); print('make_s', time.time()-t)
variants=[]
for g in [0.0,0.25,0.5,0.75,1.0]:
    variants.append((f'g{g}', ParamEstimator(final_gauss=g)))
for b2 in [0.02,0.05,0.1,-0.02]:
    variants.append((f'b2{b2}', ParamEstimator(b2=b2)))
for b0,b1 in [(0.55,0.06),(0.75,0.06),(0.65,0.0),(0.65,0.1),(0.65,0.04),(0.7,0.04)]:
    variants.append((f'b{b0}_{b1}', ParamEstimator(b0=b0,b1=b1)))
for frac in [0.075,0.085,0.095,0.10]:
    variants.append((f'f{frac}', ParamEstimator(frac=frac)))
for name,est in variants:
    t=time.time(); res=evaluate_estimator(est,data); dt=time.time()-t
    print(name, 'adj', f\"{res['adjusted_final_layer_score']:.9g}\", 'mse', f\"{res['final_layer_mse']:.9g}\", 'util', f\"{res['mean_compute_utilization']:.4f}\", 'mult', f\"{res['mean_score_multiplier']:.4f}\", 's', f\"{dt:.2f}\", 'fail', res['n_failed_mlps'])

/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
try:
    from scipy.special import ndtr
except Exception:
    ndtr = None

W=256; D=32; BUDGET=272_000_000_000; FRAC=0.09
per_sample=max(1,D*(2*W*W+4*W))
n=max(1024,int(FRAC*BUDGET/per_sample)); n=min(n,8192); n=max(2,2*(n//2))
print('n',n)
variants=[]
for b0 in [0.55,0.60,0.65,0.70,0.75]:
  for b1 in [0.03,0.06,0.09]:
    variants.append((b0,b1,0.0))
# extra layer2 small around known
variants += [(0.65,0.06,0.01),(0.65,0.06,0.02),(0.65,0.06,-0.01),(0.65,0.0,0.0),(0.65,0.12,0.0)]
variants=list(dict.fromkeys(variants))
sse={v:0.0 for v in variants}
count=0
rng_master=np.random.default_rng(20260721)

def cdf(x):
    if ndtr is not None:
        return ndtr(x)
    return 0.5*(1.0+np.vectorize(math.erf)(x/np.sqrt(2.0)))

def diag_mom(weights):
    mu=np.zeros(W,dtype=np.float64); var=np.ones(W,dtype=np.float64)
    rows=[]; vars=[]
    invsqrt2pi=1/np.sqrt(2*np.pi)
    for w in weights:
        wf=w.astype(np.float64)
        mu_pre=wf.T@mu
        var_pre=np.maximum((wf*wf).T@var,1e-12)
        sigma=np.sqrt(var_pre); alpha=mu_pre/sigma
        phi=np.exp(-0.5*alpha*alpha)*invsqrt2pi
        cc=cdf(alpha)
        mu=mu_pre*cc+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cc+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def make_q(seed):
    rng=np.random.default_rng(seed)
    base=rng.standard_normal((n//2,W), dtype=np.float32)
    x=np.concatenate([base,-base],axis=0)
    x=x-x.mean(axis=0,keepdims=True)
    q,_=np.linalg.qr(x,mode='reduced')
    raw=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    qn=np.sqrt(np.maximum(np.sum(q*q,axis=1,keepdims=True),1e-12))
    x=q*(raw/qn)
    x=x-x.mean(axis=0,keepdims=True)
    xv=np.maximum(np.mean(x*x,axis=0,keepdims=True),1e-12)
    x=x*np.sqrt(1.0/xv)
    return x.astype(np.float32)

def est(weights, rows, vars, x0, b0,b1,b2):
    x=x0.copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        beta = b0 if i==0 else (b1 if i==1 else (b2 if i==2 else 0.0))
        if beta"'!=0.0:
            xc=x-x.mean(axis=0,keepdims=True)
            xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    y=np.maximum(x@weights[-1],0.0).mean(axis=0,dtype=np.float64).astype(np.float32)
    return y

def truth(weights, seed, N=120000, chunk=10000):
    rng=np.random.default_rng(seed)
    s=np.zeros(W,dtype=np.float64); done=0
    for st in range(0,N,chunk):
        m=min(chunk,N-st)
        x=rng.standard_normal((m,W),dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w,0.0)
        s += x.sum(axis=0,dtype=np.float64); done += m
    return (s/done).astype(np.float32)

start=time.time()
for mi in range(4):
    weights=[(rng_master.standard_normal((W,W)).astype(np.float32)*np.sqrt(2.0/W)).astype(np.float32) for _ in range(D)]
    rows,vars=diag_mom(weights)
    ref=truth(weights, 9000+mi, N=120000)
    x0=make_q(100000+mi)
    for v in variants:
        pred=est(weights,rows,vars,x0,*v)
        sse[v]+=float(np.mean((pred-ref)**2))
    count+=1
    print('"'mlp',mi,'elapsed',time.time()-start)
print('results')
for v,val in sorted(sse.items(), key=lambda kv: kv[1]):
    print(v, val/count)

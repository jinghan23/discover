+
+def _first_relu_cov(w, width):
+    cov_pre = w.T @ w
+    var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
+    sigma = fnp.sqrt(var_pre)
+    denom = fnp.maximum(sigma[:, None] * sigma[None, :], 1e-12)
+    rho = fnp.maximum(fnp.minimum(cov_pre / denom, 0.999999), -0.999999)
+    one_minus = fnp.maximum(1.0 - rho * rho, 0.0)
+    kernel = (
+        fnp.sqrt(one_minus)
+        + (3.141592653589793 - fnp.arccos(rho)) * rho
+    ) * 0.15915494309189535
+    second = denom * kernel
+    mean = sigma * 0.3989422804014327
+    cov = second - mean[:, None] * mean[None, :]
+    eye = fnp.eye(width, dtype=fnp.float32)
+    return mean, cov + eye * _JITTER
+
+
+def _match_cov(x, target_mean, target_cov, beta):
+    n = int(x.shape[0])
+    x_mean = fnp.mean(x, axis=0)
+    x_center = x - x_mean
+    sample_cov = (x_center.T @ x_center) / float(max(1, n))
+    sample_cov = sample_cov + fnp.eye(int(x.shape[1]), dtype=fnp.float32) * _JITTER
+    sample_chol = fnp.linalg.cholesky(sample_cov)
+    target_chol = fnp.linalg.cholesky(target_cov)
+    transform = fnp.linalg.solve(sample_chol.T, target_chol.T)
+    matched = x_center @ transform + target_mean
+    return (1.0 - beta) * x + beta * matched
 
 

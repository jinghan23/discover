/bin/bash -lc "python - <<'PY'
import numpy as np, time
from scipy.special import ndtr
W=256; D=32; BUDGET=272_000_000_000
per_sample=max(1,D*(2*W*W+4*W))
def ns(frac):
    n=max(1024,int(frac*BUDGET/per_sample)); n=min(n,8192); return max(2,2*(n//2))
variants=[('rad',ns(.09),False,True),('norad',ns(.09),False,False),('white_full',ns(.09),True,True),('white_less',ns(.085),True,True),('white_087',ns(.087),True,True)]
print(variants)
rng_master=np.random.default_rng(12345)

def diag_mom(weights):
    mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]; inv=1/np.sqrt(2*np.pi)
    for w in weights:
        wf=w.astype(np.float64); mu_pre=wf.T@mu; var_pre=np.maximum((wf*wf).T@var,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; phi=np.exp(-0.5*a*a)*inv; cc=ndtr(a)
        mu=mu_pre*cc+sig*phi; ez2=(mu_pre*mu_pre+var_pre)*cc+mu_pre*sig*phi; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def make_x(seed,n,radial,white):
    rng=np.random.default_rng(seed); base=rng.standard_normal((n//2,W), dtype=np.float32)
    x=np.concatenate([base,-base],0); x=x-x.mean(0,keepdims=True); q,_=np.linalg.qr(x,mode='reduced')
    if radial:
        raw=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); qn=np.sqrt(np.maximum((q*q).sum(1,keepdims=True),1e-12))
        x=q*(raw/qn); x=x-x.mean(0,keepdims=True); xv=np.maximum((x*x).mean(0,keepdims=True),1e-12); x=x*np.sqrt(1/xv)
    else:
        x=q*np.sqrt(float(n))
    if white:
        x=x-x.mean(0,keepdims=True)
        c=(x.T@x)/float(n)
        L=np.linalg.cholesky(c+np.eye(W,dtype=np.float32)*1e-6)
        x=np.linalg.solve(L, x.T).T.astype(np.float32)
    return x.astype(np.float32)

def est(weights,rows,vars,x):
    x=x.copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        beta=.65 if i==0 else (.06 if i==1 else 0)
        if beta:
            xc=x-x.mean(0,keepdims=True); xv=np.maximum((xc*xc).mean(0,keepdims=True),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
    return np.maximum(x@weights[-1],0).mean(0,dtype=np.float64).astype(np.float32)

def truth(weights, seed,N=120000,chunk=10000):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for st in range(0,N,chunk):
        m=min(chunk,N-st); x=rng.standard_normal((m,W),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0,dtype=np.float64); done+=m
    return (s/done).astype(np.float32)

s={v[0]:0.0 for v in variants}; start=time.time()
for mi in range(4):
    weights=[(rng_master.standard_normal((W,W)).astype(np.float32)*np.sqrt(2/W)).astype(np.float32) for _ in range(D)]
    rows,vars=diag_mom(weights); ref=truth(weights,7000+mi)
    for name,n,white,radial in variants:
        x=make_x(20000+mi,n,radial,white); pred=est(weights,rows,vars,x); s[name]+=float(np.mean((pred-ref)**2))
    print('mlp',mi,'elapsed',time.time()-start)
print({k:v/4 for k,v in s.items()})

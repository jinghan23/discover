import time, math
import numpy as np
from scipy import special
WIDTH=256; DEPTH=32; BUDGET=272_000_000_000; FRAC=0.09
N=max(1024,int(FRAC*BUDGET/(DEPTH*(2*WIDTH*WIDTH+4*WIDTH)))); N=min(N,8192); N=max(2,2*(N//2))
print('N',N)

def gen(seed):
 r=np.random.default_rng(seed); scale=np.float32(math.sqrt(2/WIDTH)); return [(r.standard_normal((WIDTH,WIDTH),dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]
def target(ws,seed,n=262144,chunk=8192):
 r=np.random.default_rng(seed); s=np.zeros(WIDTH,np.float64)
 for st in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-st),WIDTH),dtype=np.float32)
  for w in ws: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n).astype(np.float32)
def diag(ws):
 mu=np.zeros(WIDTH,np.float32); var=np.ones(WIDTH,np.float32); rows=[]; vars=[]
 for w in ws:
  mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig
  phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a)
  mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars
def hidden(ws,seed,b0=.65,b1=.06,n=N):
 rows,vars=diag(ws); r=np.random.default_rng(seed); half=n//2; base=r.standard_normal((half,WIDTH),dtype=np.float32); x=np.concatenate([base,-base]); x=x-x.mean(0); q,_=np.linalg.qr(x, mode='reduced'); x=(q*math.sqrt(n)).astype(np.float32)
 for i,w in enumerate(ws[:-1]):
  x=np.maximum(x@w,0)
  beta=b0 if i==0 else b1 if i==1 else 0.0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return x, rows[-1]
def pred(ws,seed,alpha=0.0):
 x,diag_final=hidden(ws,seed)
 z=x@ws[-1]
 mc=np.maximum(z,0).mean(0)
 zm=z.mean(0); zc=z-zm; zv=np.maximum((zc*zc).mean(0),1e-12); sig=np.sqrt(zv); a=zm/sig; phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a); gauss=zm*c+sig*phi
 # alpha=1 pure gauss, 0 pure mc
 return ((1-alpha)*mc+alpha*gauss).astype(np.float32)
seeds=[3001,3002,3003,3004,3005]
ws=[]; ys=[]; t=time.time()
for s0 in seeds:
 w=gen(s0); y=target(w,s0+9999,n=131072); ws.append(w); ys.append(y); print('target', len(ws), time.time()-t, flush=True)
for a in [-0.5,-0.25,0,0.25,0.5,0.75,1.0,1.25,1.5]:
 ms=[]
 for j,(w,y) in enumerate(zip(ws,ys)):
  p=pred(w,4444+j,alpha=a); ms.append(float(np.mean((p-y)**2)))
 print(a, sum(ms)/len(ms), ms, flush=True)

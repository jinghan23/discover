exec
/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
from scipy import special
WIDTH=256; DEPTH=32; BUDGET=272_000_000_000; FRAC=0.09
N=max(1024,int(FRAC*BUDGET/(DEPTH*(2*WIDTH*WIDTH+4*WIDTH)))); N=min(N,8192); N=max(2,2*(N//2))

def gen(seed):
 r=np.random.default_rng(seed); scale=np.float32(math.sqrt(2/WIDTH)); return [(r.standard_normal((WIDTH,WIDTH),dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]
def target(ws,seed,n=131072,chunk=8192):
 r=np.random.default_rng(seed); s=np.zeros(WIDTH,np.float64)
 for st in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-st),WIDTH),dtype=np.float32)
  for w in ws: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n).astype(np.float32)
def diag(ws):
 mu=np.zeros(WIDTH,np.float32); var=np.ones(WIDTH,np.float32); rows=[]; vars=[]
 for w in ws:
  mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig
  phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a)
  mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars
def make_x(seed,blocks=1):
 r=np.random.default_rng(seed)
 if blocks==1:
  half=N//2; base=r.standard_normal((half,WIDTH),dtype=np.float32); x=np.concatenate([base,-base]); x=x-x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); return (q*math.sqrt(N)).astype(np.float32)
 xs=[]; rem=N
 for b in range(blocks):
  nb=(N//blocks)//2*2
  if b==blocks-1: nb=rem
  nb=(nb//2)*2; rem-=nb
  half=nb//2; base=r.standard_normal((half,WIDTH),dtype=np.float32); x=np.concatenate([base,-base]); x=x-x.mean(0); q,_=np.linalg.qr(x,mode='reduced'); xs.append((q*math.sqrt(nb)).astype(np.float32))
 return np.concatenate(xs,axis=0)
def pred(ws,seed,blocks=1):
 rows,vars=diag(ws); x=make_x(seed,blocks)
 for i,w in enumerate(ws[:-1]):
  x=np.maximum(x@w,0); beta=.65 if i==0 else .06 if i==1 else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@ws[-1],0).mean(0).astype(np.float32)
seeds=[8001,8002,8003,8004,8005]
ws=[]; ys=[]; t=time.time()
for s0 in seeds:
 w=gen(s0); y=target(w,s0+9999); ws.append(w); ys.append(y); print('target', len(ws), time.time()-t, flush=True)
for blocks in [1,2,3,4,6,8]:
 ms=[]
 for j,(w,y) in enumerate(zip(ws,ys)):
  p=pred(w, 9999+j, blocks); ms.append(float(np.mean((p-y)**2)))
 print('blocks',blocks, sum(ms)/len(ms), ms, flush=True)
PY" in /opt/tiger/discover/workspace

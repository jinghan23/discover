/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
from scipy import special
WIDTH=256; DEPTH=32; BUDGET=272_000_000_000; FRAC=0.09
per_sample=DEPTH*(2*WIDTH*WIDTH+4*WIDTH)
N=max(1024,int(FRAC*BUDGET/per_sample)); N=min(N,8192); N=max(2,2*(N//2))
print('N',N)

def gen(seed):
 r=np.random.default_rng(seed); scale=np.float32(math.sqrt(2/WIDTH)); return [(r.standard_normal((WIDTH,WIDTH),dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]
def target(ws,seed,n=131072,chunk=8192):
 r=np.random.default_rng(seed); s=np.zeros(WIDTH,np.float64)
 for st in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-st),WIDTH),dtype=np.float32)
  for w in ws: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n).astype(np.float32)
def diag(ws):
 mu=np.zeros(WIDTH,np.float32); var=np.ones(WIDTH,np.float32); rows=[]; vars=[]
 for w in ws:
  mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig
  phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a)
  mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars
def base_q(seed,n=N):
 r=np.random.default_rng(seed); half=n//2; b=r.standard_normal((half,WIDTH),dtype=np.float32); x=np.concatenate([b,-b]); x=x-x.mean(0); q,_=np.linalg.qr(x, mode='reduced'); return q.astype(np.float32)
def pred_base(ws,seed,b0=.65,b1=.06):
 rows,vars=diag(ws); q=base_q(seed); x=q*math.sqrt(N)
 for i,w in enumerate(ws[:-1]):
  x=np.maximum(x@w,0)
  beta=b0 if i==0 else b1 if i==1 else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@ws[-1],0).mean(0).astype(np.float32)
def first_cov(ws):
 w=ws[0]
 K=(w.T@w).astype(np.float64)
 d=np.maximum(np.diag(K),1e-12); sd=np.sqrt(d)
 rho=K/(sd[:,None]*sd[None,:]); rho=np.clip(rho,-1,1)
 s=np.sqrt(np.maximum(1-rho*rho,0)); theta=np.arccos(rho)
 E=(sd[:,None]*sd[None,:])*(s+(math.pi-theta)*rho)/(2*math.pi)
 mu=(sd/math.sqrt(2*math.pi))
 C=E-mu[:,None]*mu[None,:]
 C=(C+C.T)*0.5
 # jitter
 C[np.diag_indices(WIDTH)] += 1e-6
 L=np.linalg.cholesky(C).astype(np.float32)
 return mu.astype(np.float32), L
def pred_cov1(ws,seed,b1=.06,b2=0.0):
 rows,vars=diag(ws); q=base_q(seed); mu,L=first_cov(ws)
 x=(q*math.sqrt(N))@L.T + mu
 for i,w in enumerate(ws[1:-1], start=1):
  x=np.maximum(x@w,0)
  beta=b1 if i==1 else b2 if i==2 else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@ws[-1],0).mean(0).astype(np.float32)

seeds=[2001,2002,2003]
ws=[]; ys=[]; t=time.time()
for s0 in seeds:
 w=gen(s0); y=target(w,s0+9999); ws.append(w); ys.append(y); print('target done',time.time()-t,flush=True)
variants=[('base',pred_base,{}),('cov1 b1=.0',pred_cov1,{'b1':0.0}),('cov1 b1=.03',pred_cov1,{'b1':0.03}),('cov1 b1=.06',pred_cov1,{'b1':0.06}),('cov1 b1=.1',pred_cov1,{'b1':0.1}),('cov1 b1=.06 b2=.03',pred_cov1,{'b1':0.06,'b2':0.03})]
for name,fn,kw in variants:
 ms=[]
 for j,(w,y) in enumerate(zip(ws,ys)):
  p=fn(w, 3333+j, **kw); ms.append(float(np.mean((p-y)**2)))
 print(name, sum(ms)/len(ms), ms, flush=True)

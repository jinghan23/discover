/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
from scipy import special
W=256; D=32; B=272_000_000_000; F=.09
N=max(1024,int(F*B/(D*(2*W*W+4*W)))); N=min(N,8192); N=max(2,2*(N//2))

def gen(seed):
 r=np.random.default_rng(seed); scale=np.float32(math.sqrt(2/W)); return [(r.standard_normal((W,W),dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]
def target(ws,seed,n=131072,chunk=8192):
 r=np.random.default_rng(seed); s=np.zeros(W,np.float64)
 for st in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-st),W),dtype=np.float32)
  for w in ws: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n).astype(np.float32)
def diag(ws):
 mu=np.zeros(W,np.float32); var=np.ones(W,np.float32); rows=[]; vars=[]
 for w in ws:
  mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); sig=np.sqrt(vp); a=mp/sig
  phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a)
  mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars
def make(seed):
 r=np.random.default_rng(seed); half=N//2; base=r.standard_normal((half,W),dtype=np.float32); raw=np.concatenate([base,-base]); raw=raw-raw.mean(0); q,_=np.linalg.qr(raw,mode='reduced')
 rn=np.sqrt(np.maximum((raw*raw).sum(1,keepdims=True),1e-12)); qn=np.sqrt(np.maximum((q*q).sum(1,keepdims=True),1e-12)); x=(q*(rn/qn)).astype(np.float32)
 x=x-x.mean(0); x=x/np.sqrt(np.maximum((x*x).mean(0),1e-12)); return x.astype(np.float32)
def pred(ws,seed,b0=.65,b1=.06,b2=0.0):
 rows,vars=diag(ws); x=make(seed)
 for i,w in enumerate(ws[:-1]):
  x=np.maximum(x@w,0); beta=b0 if i==0 else b1 if i==1 else b2 if i==2 else 0
  if beta:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
 return np.maximum(x@ws[-1],0).mean(0).astype(np.float32)
seeds=[1401,1402,1403,1404,1405]
ws=[]; ys=[]; t=time.time()
for s in seeds:
 w=gen(s); y=target(w,s+9999); ws.append(w); ys.append(y); print('target',len(ws),time.time()-t,flush=True)
vars=[]
for b0 in [.55,.6,.65,.7,.75,.8]:
 for b1 in [0,.03,.06,.09,.12]:
  vars.append((f'b0={b0} b1={b1}',dict(b0=b0,b1=b1)))
for b2 in [-.03, .03, .06, .1]: vars.append((f'b2={b2}',dict(b2=b2)))
res=[]
for name,kw in vars:
 ms=[]
 for j,(w,y) in enumerate(zip(ws,ys)):
  p=pred(w,2468+j,**kw); ms.append(float(np.mean((p-y)**2)))
 res.append((sum(ms)/len(ms),name,ms))
for r in sorted(res)[:15]: print(r,flush=True)

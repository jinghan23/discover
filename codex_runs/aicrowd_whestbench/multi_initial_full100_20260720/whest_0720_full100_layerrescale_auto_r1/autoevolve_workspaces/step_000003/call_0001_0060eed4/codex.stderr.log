import time, math
import numpy as np
try:
    from scipy import special
    ndtr = special.ndtr
except Exception:
    ndtr = np.vectorize(lambda z: 0.5*(1.0+math.erf(float(z)/math.sqrt(2.0))))

WIDTH=256; DEPTH=32; BUDGET=272_000_000_000
FRAC=0.09
per_sample=max(1, DEPTH*(2*WIDTH*WIDTH+4*WIDTH))
N=max(1024, int((FRAC*BUDGET)/per_sample)); N=min(N,8192); N=max(2,2*(N//2))
print('N', N)

def gen_mlp(seed):
    rng=np.random.default_rng(seed)
    scale=np.float32(math.sqrt(2.0/WIDTH))
    return [(rng.standard_normal((WIDTH,WIDTH), dtype=np.float32)*scale).astype(np.float32) for _ in range(DEPTH)]

def target(weights, seed, n=131072, chunk=8192):
    rng=np.random.default_rng(seed)
    s=np.zeros(WIDTH, dtype=np.float64)
    done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,WIDTH), dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w, 0.0)
        s += x.astype(np.float64).sum(axis=0)
        done += m
    return (s/done).astype(np.float32)

def diag_rows_vars(weights):
    mu=np.zeros(WIDTH, dtype=np.float32)
    var=np.ones(WIDTH, dtype=np.float32)
    rows=[]; vars=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=np.maximum((w*w).T@var, 1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=np.exp(-0.5*alpha*alpha)/math.sqrt(2*math.pi)
        cdf=ndtr(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows, vars

def pred(weights, seed, b0=.65, b1=.06, b2=0.0, gamma=0.0, n=N, match_all_decay=None, final_match=False, noqr=False):
    rows, vars=diag_rows_vars(weights)
    rng=np.random.default_rng(seed)
    half=n//2
    base=rng.standard_normal((half,WIDTH), dtype=np.float32)
    x=np.concatenate([base,-base], axis=0)
    x=x-x.mean(axis=0)
    if not noqr:
        q,_=np.linalg.qr(x, mode='reduced')
        x=(q*math.sqrt(float(n))).astype(np.float32)
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        beta=0.0
        if match_all_decay is not None:
            beta=match_all_decay[0]*(match_all_decay[1]**i)
        elif i==0: beta=b0
        elif i==1: beta=b1
        elif i==2: beta=b2
        if beta"'!=0.0:
            xc=x-x.mean(axis=0)
            xv=np.maximum((xc*xc).mean(axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    mc=np.maximum(x@weights[-1],0.0).mean(axis=0).astype(np.float32)
    if final_match:
        # Match penultimate sample moments before final, then average final layer.
        pass
    return ((1-gamma)*mc+gamma*rows[-1]).astype(np.float32)

variants=[]
for b0 in [0.55,0.6,0.65,0.7,0.75]:
  for b1 in [0.0,0.03,0.06,0.09,0.12]:
    variants.append((f'"'b0={b0} b1={b1}', dict(b0=b0,b1=b1)))
for g in [-0.05,-0.02,0.02,0.05,0.1,0.15]:
    variants.append((f'gamma={g}', dict(gamma=g)))
for b2 in [0.02,0.05,0.1,-0.02]:
    variants.append((f'b2={b2}', dict(b2=b2)))
for a,d in [(0.65,0.25),(0.65,0.35),(0.65,0.5),(0.5,0.5),(0.8,0.25)]:
    variants.append((f'decay={a},{d}', dict(match_all_decay=(a,d))))

seeds=[1001,1002,1003]
ys=[]; ws=[]
t0=time.time()
for j,s in enumerate(seeds):
    w=gen_mlp(s)
    y=target(w, s+9999, n=131072)
    ws.append(w); ys.append(y)
    print('target', j, 'mean', float(y.mean()), 'time', time.time()-t0, flush=True)

scores=[]
for name,kw in variants:
    ms=[]
    for j,(w,y) in enumerate(zip(ws,ys)):
        p=pred(w, 12345+j, **kw)
        ms.append(float(np.mean((p-y)**2)))
    scores.append((sum(ms)/len(ms), name, ms))
for s in sorted(scores)[:20]:
    print(s)

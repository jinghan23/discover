 q,_=np.linalg.qr(raw,mode='reduced')
 white=(q*math.sqrt(N)).astype(np.float32)
 if mode=='qr': return white
 rn=np.sqrt(np.maximum((raw*raw).sum(1,keepdims=True),1e-12))
 qn=np.sqrt(np.maximum((q*q).sum(1,keepdims=True),1e-12))
 radial=(q*(rn/qn)).astype(np.float32)
 radial=radial-radial.mean(0)
 radial=radial/np.sqrt(np.maximum((radial*radial).mean(0),1e-12))
 if mode=='radial': return radial.astype(np.float32)
 x=(1-blend)*white+blend*radial

/bin/bash -lc "python - <<'PY'
import time, math
import numpy as np
from scipy import special
WIDTH=256; DEPTH=32
# 9-point probabilists GH expectation nodes/weights from numpy for local; hardcode later if useful.

def gh(n):
    x,w=np.polynomial.hermite.hermgauss(n)
    return (x*np.sqrt(2)).astype(np.float64),(w/np.sqrt(np.pi)).astype(np.float64)

def gen(seed):
 r=np.random.default_rng(seed); scale=np.float32(math.sqrt(2/WIDTH)); return [(r.standard_normal((WIDTH,WIDTH),dtype=np.float32)*scale).astype(np.float64) for _ in range(DEPTH)]
def target(ws,seed,n=131072,chunk=8192):
 r=np.random.default_rng(seed); s=np.zeros(WIDTH,np.float64)
 w32=[w.astype(np.float32) for w in ws]
 for st in range(0,n,chunk):
  x=r.standard_normal((min(chunk,n-st),WIDTH),dtype=np.float32)
  for w in w32: x=np.maximum(x@w,0)
  s+=x.sum(0)
 return (s/n)
def relu_moments(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); c=special.ndtr(a)
 mean=mu*c+sig*phi
 ez2=(mu*mu+var)*c+mu*sig*phi
 return mean, ez2
def cov_prop(ws,nq=7,diag_only=False):
 mu=np.zeros(WIDTH,dtype=np.float64); S=np.eye(WIDTH,dtype=np.float64) # raw second moment E[x xT]
 nodes,weights=gh(nq)
 eye=np.eye(WIDTH,dtype=np.float64)
 for li,w in enumerate(ws):
  mu_z=w.T@mu
  M=w.T@S@w
  C=M-np.outer(mu_z,mu_z)
  C=(C+C.T)*.5
  var=np.maximum(np.diag(C),1e-12)
  mu_next, ez2=relu_moments(mu_z,var)
  if diag_only:
   S=np.outer(mu_next,mu_next); S[np.diag_indices(WIDTH)]=ez2
  else:
   sig=np.sqrt(var)
   rho=C/(sig[:,None]*sig[None,:]); rho=np.clip(rho,-0.999999,0.999999)
   sqrt1=np.sqrt(np.maximum(1-rho*rho,1e-12))
   sig_j=sig[None,:]
   mu_j=mu_z[None,:]
   E=np.zeros((WIDTH,WIDTH),dtype=np.float64)
   # integrate over first variable i rows
   for u,wt in zip(nodes,weights):
    xplus=np.maximum(mu_z+sig*u,0.0)[:,None]
    cmu=mu_j + rho*sig_j*u
    csig=sig_j*sqrt1
    a=cmu/np.maximum(csig,1e-12)
    inner=cmu*special.ndtr(a)+csig*np.exp(-.5*a*a)/math.sqrt(2*math.pi)
    E += wt*xplus*inner
   S=E
   S=(S+S.T)*.5
   S=S*(1-eye)+np.diag(ez2)
  mu=mu_next
 return mu.astype(np.float32)

def diag_prop(ws):
 mu=np.zeros(WIDTH); var=np.ones(WIDTH)
 for w in ws:
  mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); mu,ez2=relu_moments(mp,vp); var=np.maximum(ez2-mu*mu,0)
 return mu.astype(np.float32)

seeds=[9001,9002,9003]
ws=[]; ys=[]; t=time.time()
for s0 in seeds:
 w=gen(s0); y=target(w,s0+9999,n=131072); ws.append(w); ys.append(y); print('target',len(ws),time.time()-t,flush=True)
for nq in [3,5,7,9,11]:
 ms=[]; t0=time.time()
 for w,y in zip(ws,ys):
  p=cov_prop(w,nq=nq); ms.append(float(np.mean((p-y)**2)))
 print('cov nq',nq, sum(ms)/len(ms), ms, 'time', time.time()-t0, flush=True)
ms=[]
for w,y in zip(ws,ys):
 p=diag_prop(w); ms.append(float(np.mean((p-y)**2)))
print('diag', sum(ms)/len(ms), ms)

# Quick local check of final Gaussian blend at lower probe counts on generated depth-12 nets.
import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)

def diag_prop(weights):
    w=weights[0]; mu=np.zeros(w.shape[0]); var=np.ones(w.shape[0]); rows=[]; vars=[]
    for w in weights:
        wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=np.exp(-.5*a*a)*INV; c=ndtr(a)
        mu=mp*c+s*p; ez2=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def xinit(width,n,seed):
    rng=np.random.default_rng(seed); b=rng.standard_normal((n//2,width),dtype=np.float32); x=np.concatenate([b,-b]); x-=x.mean(0,keepdims=True); q,_=np.linalg.qr(x,mode='reduced'); return (q*np.sqrt(float(n))).astype(np.float32)

def pred(weights,seed,n=4096,bnorm=0):
    rows,vars=diag_prop(weights); x=xinit(weights[0].shape[0],n,seed)
    for i,w in enumerate(weights[:-1]):
        x=x@w; np.maximum(x,0,out=x)
        if i==0 or i==1:
            c=.8 if i==0 else .08
            xm=x.mean(0,keepdims=True); xc=x-xm; xv=np.maximum((xc*xc).mean(0),1e-12); xmch=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=((1-c)*x+c*xmch).astype(np.float32)
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0)
    if bnorm:
        zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=zm/zs; norm=zm*ndtr(a)+zs*np.exp(-.5*a*a)*INV; mc=(1-bnorm)*mc+bnorm*norm
    return mc.astype(np.float32)

def target(weights,seed,N=1048576,chunk=16384):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width)
    for st in range(0,N,chunk):
        x=rng.standard_normal((min(chunk,N-st),width),dtype=np.float32)
        for w in weights:
            x=x@w; np.maximum(x,0,out=x)
        s+=x.astype(np.float64).sum(0)
    return (s/N).astype(np.float32)

rng=np.random.default_rng(999)
for width,depth in [(64,12),(128,12),(128,8)]:
    scores={b:[] for b in [-.2,-.1,-.05,.0,.02,.05,.1,.2,.4]}
    for j in range(4):
        weights=[(rng.standard_normal((width,width)).astype(np.float32)*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        seed=int(rng.integers(0,2**32-1)); tgt=target(weights,45678+j,N=524288)
        for b in scores: scores[b].append(np.mean((pred(weights,seed,n=4096,bnorm=b)-tgt)**2))
    base=np.mean(scores[0.0]); print('CASE',width,depth,'base',base)
    for b,v in sorted(scores.items(), key=lambda kv:np.mean(kv[1])):
        print(b,np.mean(v),np.mean(v)/base)

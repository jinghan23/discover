import numpy as np
from scipy.special import ndtr

INV_SQRT_2PI = 1.0 / np.sqrt(2*np.pi)

def diag_prop(weights):
    width = weights[0].shape[0]
    mu = np.zeros(width, dtype=np.float64)
    var = np.ones(width, dtype=np.float64)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for w in weights:
        wf = w.astype(np.float64)
        mu_pre = wf.T @ mu
        var_pre = np.maximum((wf*wf).T @ var, 1e-12)
        sigma = np.sqrt(var_pre)
        alpha = mu_pre / sigma
        phi = np.exp(-0.5*alpha*alpha) * INV_SQRT_2PI
        cdf = ndtr(alpha)
        mu = mu_pre*cdf + sigma*phi
        ez2 = (mu_pre*mu_pre + var_pre)*cdf + mu_pre*sigma*phi
        var = np.maximum(ez2 - mu*mu, 0.0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
        pre_mus.append(mu_pre.astype(np.float32)); pre_vars.append(var_pre.astype(np.float32))
    return rows, vars, pre_mus, pre_vars

def make_x(width, n, seed):
    rng = np.random.default_rng(seed)
    half = n//2
    base = rng.standard_normal((half,width), dtype=np.float32)
    x = np.concatenate([base, -base], axis=0).astype(np.float32)
    x = x - x.mean(axis=0, keepdims=True)
    q, _ = np.linalg.qr(x, mode='reduced')
    return (q * np.sqrt(float(n))).astype(np.float32)

def pred(weights, est_seed, n=8192, c0=0.8, c1=0.08, c2=0.0, final='mc', bnorm=0.0, bdiag=0.0, match_layers=None):
    rows, vars, pre_mus, pre_vars = diag_prop(weights)
    width = weights[0].shape[0]
    x = make_x(width, n, est_seed)
    if match_layers is None:
        coeffs = {0:c0,1:c1,2:c2}
    else:
        coeffs = match_layers
    for i,w in enumerate(weights[:-1]):
        x = x @ w
        np.maximum(x, 0.0, out=x)
        c = coeffs.get(i,0.0)
        if c "'!= 0.0:
            xm = x.mean(axis=0, keepdims=True)
            xc = x - xm
            xv = np.maximum((xc*xc).mean(axis=0), 1e-12)
            x_match = xc * np.sqrt(np.maximum(vars[i], 1e-12) / xv) + rows[i]
            x = ((1-c)*x + c*x_match).astype(np.float32)
    z = x @ weights[-1]
    reluz = np.maximum(z, 0.0)
    mc = reluz.mean(axis=0)
    zm = z.mean(axis=0)
    zc = z - zm
    zs = np.sqrt(np.maximum((zc*zc).mean(axis=0), 1e-12))
    za = zm/zs
    norm = zm*ndtr(za) + zs*np.exp(-0.5*za*za)*INV_SQRT_2PI
    out = mc
    if bnorm != 0.0:
        out = (1-bnorm)*out + bnorm*norm
    if bdiag != 0.0:
        out = (1-bdiag)*out + bdiag*rows[-1]
    return out.astype(np.float32), rows[-1]

def target(weights, seed, N=262144, chunk=8192):
    rng = np.random.default_rng(seed)
    width = weights[0].shape[0]
    s = np.zeros(width, dtype=np.float64)
    done = 0
    for start in range(0,N,chunk):
        n = min(chunk, N-start)
        x = rng.standard_normal((n,width), dtype=np.float32)
        for w in weights:
            x = x @ w
            np.maximum(x, 0.0, out=x)
        s += x.astype(np.float64).sum(axis=0)
        done += n
    return (s/done).astype(np.float32)

def run(width=64, depth=8, nets=8, Ntarget=262144):
    rng = np.random.default_rng(12345)
    variants = []
    # layer moment match grids
    for c0 in [0.5,0.8,1.0]:
      for c1 in [0.0,0.04,0.08,0.15,0.3]:
        variants.append((f'"'c0{c0}_c1{c1}', dict(c0=c0,c1=c1)))
    for bnorm in [-0.2,-0.1,0.05,0.1,0.2,0.4,0.7,1.0]:
        variants.append((f'bnorm{bnorm}', dict(bnorm=bnorm)))
    for bdiag in [-0.2,-0.1,0.02,0.05,0.1,0.2,0.4]:
        variants.append((f'bdiag{bdiag}', dict(bdiag=bdiag)))
    for c2 in [0.02,0.05,0.1,-0.05]:
        variants.append((f'c2{c2}', dict(c2=c2)))
    scores = {name:[] for name,_ in variants}
    scores['base']=[]; scores['diag']=[]
    for j in range(nets):
        weights = [(rng.standard_normal((width,width)).astype(np.float32)*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        est_seed = int(rng.integers(0,2**32-1))
        tgt = target(weights, seed=999000+j, N=Ntarget)
        p,d = pred(weights, est_seed)
        scores['base'].append(np.mean((p-tgt)**2)); scores['diag'].append(np.mean((d-tgt)**2))
        for name,kw in variants:
            pp,_ = pred(weights, est_seed, **kw)
            scores[name].append(np.mean((pp-tgt)**2))
        print('net',j,'base',scores['base'][-1],'diag',scores['diag'][-1], flush=True)
    means = sorted((np.mean(v), np.std(v)/np.sqrt(len(v)), k) for k,v in scores.items())
    print('RESULT', width, depth, nets, Ntarget)
    for m,se,k in means[:20]:
        print(f'{k:18s} {m:.8g} se {se:.2g} ratio {m/np.mean(scores[\"base\"]):.3f}')

for width,depth in [(64,8),(128,8),(64,12)]:
    run(width,depth,nets=6,Ntarget=131072)

While the official run is pending, I’m doing a higher-sample local check on a small number of generated networks to see whether the second-layer change survives target-noise reduction.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)

def diag_prop(weights):
 w0=weights[0]; width=w0.shape[0]
 mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mu_pre=wf.T@mu; var_pre=np.maximum((wf*wf).T@var,1e-12)
  s=np.sqrt(var_pre); a=mu_pre/s; phi=np.exp(-0.5*a*a)*INV; c=ndtr(a)
  mu=mu_pre*c+s*phi; ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*s*phi; var=np.maximum(ez2-mu*mu,0)
  rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars

def xinit(width,n,seed):
 rng=np.random.default_rng(seed); half=n//2
 x=np.concatenate([rng.standard_normal((half,width),dtype=np.float32), -rng.standard_normal((0,width),dtype=np.float32)]) if False else None
 base=rng.standard_normal((half,width),dtype=np.float32); x=np.concatenate([base,-base]).astype(np.float32); x-=x.mean(0,keepdims=True); q,_=np.linalg.qr(x,mode='reduced'); return (q*np.sqrt(float(n))).astype(np.float32)

def pred(weights,seed,c0=0.8,c1=0.08,c2=0,n=8192,bnorm=0):
 rows,vars=diag_prop(weights); x=xinit(weights[0].shape[0],n,seed)
 coeff={0:c0,1:c1,2:c2}
 for i,w in enumerate(weights[:-1]):
  x=x@w; np.maximum(x,0,out=x); c=coeff.get(i,0)
  if c:
   xm=x.mean(0,keepdims=True); xc=x-xm; xv=np.maximum((xc*xc).mean(0),1e-12)
   xmch=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
   x=((1-c)*x+c*xmch).astype(np.float32)
 z=x@weights[-1]; mc=np.maximum(z,0).mean(0)
 if bnorm:
  zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=zm/zs; norm=zm*ndtr(a)+zs*np.exp(-0.5*a*a)*INV; mc=(1-bnorm)*mc+bnorm*norm
 return mc.astype(np.float32)

def target(weights,seed,N=1048576,chunk=16384):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width,dtype=np.float64)
 for st in range(0,N,chunk):
  n=min(chunk,N-st); x=rng.standard_normal((n,width),dtype=np.float32)
  for w in weights:
   x=x@w; np.maximum(x,0,out=x)
  s+=x.astype(np.float64).sum(0)
 return (s/N).astype(np.float32)

def run(width,depth,nets):
 rng=np.random.default_rng(777)
 variants={
 'base':dict(c0=0.8,c1=0.08),'c1_0':dict(c0=0.8,c1=0),'c0_1_c1_0':dict(c0=1,c1=0),'c0_05_c1_0':dict(c0=.5,c1=0),
 'c2_005':dict(c0=.8,c1=.08,c2=.05),'c1_0_c2_005':dict(c0=.8,c1=0,c2=.05),'bnorm005':dict(c0=.8,c1=.08,bnorm=.05),'bnorm-01':dict(c0=.8,c1=.08,bnorm=-.1)
 }
 scores={k:[] for k in variants}
 for j in range(nets):
  weights=[(rng.standard_normal((width,width)).astype(np.float32)*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
  est_seed=int(rng.integers(0,2**32-1)); tgt=target(weights,123456+j)
  for k,kw in variants.items(): scores[k].append(np.mean((pred(weights,est_seed,**kw)-tgt)**2))
  print('net',j,{k:float(scores[k][-1]) for k in variants},flush=True)
 print('SUMMARY',width,depth)
 base=np.mean(scores['base'])
 for k,v in sorted(scores.items(), key=lambda kv: np.mean(kv[1])):
  print(k,np.mean(v),'ratio',np.mean(v)/base,'se',np.std(v)/np.sqrt(nets))
run(128,8,4)
run(64,12,4)

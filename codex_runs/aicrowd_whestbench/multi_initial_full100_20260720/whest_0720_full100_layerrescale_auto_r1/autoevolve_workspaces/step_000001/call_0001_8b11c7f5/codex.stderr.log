import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)

def diag(weights):
 mu=np.zeros(weights[0].shape[0]); var=np.ones(weights[0].shape[0]); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=np.exp(-.5*a*a)*INV; c=ndtr(a); mu=mp*c+s*p; var=np.maximum((mp*mp+vp)*c+mp*s*p-mu*mu,0); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars

def xinit(width,n,seed,mode):
 rng=np.random.default_rng(seed); b=rng.standard_normal((n//2,width),dtype=np.float32); raw=np.concatenate([b,-b]); x=raw-raw.mean(0,keepdims=True); q,_=np.linalg.qr(x,mode='reduced'); x=(q*np.sqrt(float(n))).astype(np.float32)
 if mode=='qr': return x
 if mode=='radial':
  rn=np.sqrt(np.maximum((raw*raw).sum(1),1e-12)).astype(np.float32); xn=np.sqrt(np.maximum((x*x).sum(1),1e-12)).astype(np.float32); return (x*(rn/xn)[:,None]).astype(np.float32)
 if mode=='raw_center_scale':
  # antithetic raw with exact column std match only
  xc=raw-raw.mean(0,keepdims=True); xv=np.sqrt(np.maximum((xc*xc).mean(0),1e-12)); return (xc/xv).astype(np.float32)
 return raw

def pred(weights,seed,n,mode,c0=.66,c1=.056):
 rows,vars=diag(weights); x=xinit(weights[0].shape[0],n,seed,mode)

/bin/bash -lc "python - <<'PY'
import os
rows=[]
for name in os.listdir('/proc'):
    if not name.isdigit():
        continue
    pid=int(name)
    try:
        with open(f'/proc/{pid}/cmdline','rb') as f:
            cmd=f.read().replace(b'\\0',b' ').decode('utf-8','ignore').strip()
        with open(f'/proc/{pid}/stat','r') as f:
            stat=f.read().split()
        if 'python' in cmd or 'eval' in cmd or 'whest' in cmd:
            rows.append((pid, stat[2], cmd[:240]))
    except Exception:
        pass
for r in rows:
    print(r)

import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)
# compact functions
def diag(weights):
 mu=np.zeros(weights[0].shape[0]); var=np.ones(weights[0].shape[0]); rows=[]; vars=[]
 for w in weights:
  wf=w.astype(np.float64); mp=wf.T@mu; vp=np.maximum((wf*wf).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=np.exp(-.5*a*a)*INV; c=ndtr(a); mu=mp*c+s*p; var=np.maximum((mp*mp+vp)*c+mp*s*p-mu*mu,0); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return rows,vars
def xinit(width,n,seed):
 rng=np.random.default_rng(seed); b=rng.standard_normal((n//2,width),dtype=np.float32); x=np.concatenate([b,-b]); x-=x.mean(0,keepdims=True); q,_=np.linalg.qr(x,mode='reduced'); return (q*np.sqrt(n)).astype(np.float32)
def pred(weights,seed,n,c0,c1):
 rows,vars=diag(weights); x=xinit(weights[0].shape[0],n,seed)
 for i,w in enumerate(weights[:-1]):
  x=x@w; np.maximum(x,0,out=x)
  if i<2:
   c=c0 if i==0 else c1
   if c:
    xm=x.mean(0,keepdims=True); xc=x-xm; xv=np.maximum((xc*xc).mean(0),1e-12); y=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=((1-c)*x+c*y).astype(np.float32)
 z=x@weights[-1]; return np.maximum(z,0).mean(0).astype(np.float32)
def targ(weights,seed,N=524288,chunk=16384):
 rng=np.random.default_rng(seed); s=np.zeros(weights[0].shape[0])
 for st in range(0,N,chunk):

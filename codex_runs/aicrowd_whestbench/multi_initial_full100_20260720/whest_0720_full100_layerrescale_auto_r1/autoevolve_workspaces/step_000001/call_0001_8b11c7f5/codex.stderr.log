I’m exploring a deterministic full-covariance Gaussian moment propagator locally. It is derived only from weights and Gaussian/ReLU moments, and if accurate it could be blended with MC as a control variate.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from numpy.polynomial.hermite import hermgauss
INV=1/np.sqrt(2*np.pi)

def relu_mean(mu,var):
    var=np.maximum(var,1e-12); s=np.sqrt(var); a=mu/s; return mu*ndtr(a)+s*np.exp(-.5*a*a)*INV

def relu_second(mu,var):
    var=np.maximum(var,1e-12); s=np.sqrt(var); a=mu/s; return (mu*mu+var)*ndtr(a)+mu*s*np.exp(-.5*a*a)*INV

def full_prop(weights,K=15):
    width=weights[0].shape[0]
    m=np.zeros(width,dtype=np.float64); M=np.eye(width,dtype=np.float64)
    xs, ws = hermgauss(K); xs=xs.astype(np.float64); ws=(ws/np.sqrt(np.pi)).astype(np.float64)
    rows=[]
    for w in weights:
        W=w.astype(np.float64)
        mu=W.T@m
        S=W.T@M@W
        cov=S-np.outer(mu,mu)
        var=np.maximum(np.diag(cov),1e-12)
        sd=np.sqrt(var)
        m=relu_mean(mu,var)
        rho=cov/(sd[:,None]*sd[None,:])
        rho=np.clip(rho,-0.999999,0.999999)
        sdj=sd[None,:]
        muj=mu[None,:]
        scond=sdj*np.sqrt(np.maximum(1-rho*rho,1e-12))
        M2=np.zeros((width,width),dtype=np.float64)
        for x,wgh in zip(xs,ws):
            xi=mu+sd*np.sqrt(2)*x
            pos=np.maximum(xi,0)[:,None]
            mcond=muj + rho*sdj*np.sqrt(2)*x
            a=mcond/scond
            inner=mcond*ndtr(a)+scond*np.exp(-.5*a*a)*INV
            M2 += wgh*pos*inner
        # exact diagonal
        np.fill_diagonal(M2, relu_second(mu,var))
        M=(M2+M2.T)*0.5
        rows.append(m.astype(np.float32))
    return np.stack(rows).astype(np.float32)

def diag_prop(weights):
 width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
 for w in weights:
  W=w.astype(np.float64); mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=np.exp(-.5*a*a)*INV; c=ndtr(a); mu=mp*c+s*p; ez=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
 return np.stack(rows), rows, vars

def target(weights,seed,N=1048576,chunk=16384):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width)
 for st in range(0,N,chunk):
  x=rng.standard_normal((min(chunk,N-st),width),dtype=np.float32)
  for w in weights: x=x@w; np.maximum(x,0,out=x)
  s += x.astype(np.float64).sum(0)
 return (s/N).astype(np.float32)
for width,depth in [(32,8),(64,8),(64,12),(128,8)]:
 rng=np.random.default_rng(123+width+depth); scores={k:[] for k in ['full9','full15','diag']}
 for j in range(4):
  weights=[(rng.standard_normal((width,width)).astype(np.float32)*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
  tgt=target(weights,98765+j,N=524288 if width>=64 else 1048576)
  for K in [9,15]:
   p=full_prop(weights,K=K)[-1]; scores[f'full{K}'].append(np.mean((p-tgt)**2))
  d=diag_prop(weights)[0][-1]; scores['diag'].append(np.mean((d-tgt)**2))
  print('net',width,depth,j,{k:float(v[-1]) for k,v in scores.items()},flush=True)
 print('SUMMARY',width,depth)
 for k,v in sorted(scores.items(), key=lambda kv:np.mean(kv[1])):
  print(k,np.mean(v))

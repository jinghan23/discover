  for w in weights: x=x@w; np.maximum(x,0,out=x)
  s+=x.astype(np.float64).sum(0)
 return (s/N).astype(np.float32)
for case in [(64,12,4096),(128,12,4096),(128,8,4096),(64,12,8192)]:
 width,depth,n=case; rng=np.random.default_rng(3030+width+depth+n); modes=['qr','radial','raw_center_scale','raw']; scores={m:[] for m in modes}
 for j in range(5):

diff --git a/submission.py b/submission.py
index 7f63a5be665eae68110f13349ff43ef98528a29f..d4172b860220595deb0c65614e19791a6ee8adf0
--- a/submission.py
+++ b/submission.py
@@ -5,12 +5,49 @@
 from whestbench import BaseEstimator
 
 _FRAC = 0.09
-_BETA0 = 0.65
+_BETA0 = 0.70
 _BETA1 = 0.06
+_COV_BETA0 = 0.08
 _RADIAL = True
 _SEED_OFFSET = 0
+_FINAL_BLEND = 0.0
+_PI = 3.141592653589793
+_INV_2PI = 0.15915494309189535
+_INV_SQRT_2PI = 0.3989422804014327
 
 
+def _first_relu_cov(w, width):
+    cov_pre = w.T @ w
+    var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
+    sigma = fnp.sqrt(var_pre)
+    denom = fnp.maximum(sigma[:, None] * sigma[None, :], 1e-12)
+    rho = cov_pre / denom
+    rho = fnp.maximum(fnp.minimum(rho, 0.999999), -0.999999)
+    root = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
+    second = denom * (root + (_PI - fnp.arccos(rho)) * rho) * _INV_2PI
+    mu = sigma * _INV_SQRT_2PI
+    cov = second - mu[:, None] * mu[None, :]
+    diag_cov = fnp.maximum(0.5 * var_pre - mu * mu, 1e-12)
+    eye = fnp.eye(width)
+    return cov * (1.0 - eye) + diag_cov[:, None] * eye
+
+
+def _match_cov(x, target_mu, target_cov, beta, width, n_samples):
+    x_mean = fnp.mean(x, axis=0)
+    xc = x - x_mean
+    eye = fnp.eye(width)
+    sample_cov = (xc.T @ xc) / float(n_samples) + 1e-5 * eye
+    target_cov = target_cov + 1e-5 * eye
+    s_vals, s_vecs = fnp.linalg.eigh(sample_cov)
+    t_vals, t_vecs = fnp.linalg.eigh(target_cov)
+    s_vals = fnp.maximum(s_vals, 1e-8)
+    t_vals = fnp.maximum(t_vals, 1e-8)
+    white = (s_vecs * (1.0 / fnp.sqrt(s_vals))[None, :]) @ s_vecs.T
+    color = (t_vecs * fnp.sqrt(t_vals)[None, :]) @ t_vecs.T
+    x_match = (xc @ white) @ color + target_mu
+    return (1.0 - beta) * x + beta * x_match
+
+
 class Estimator(BaseEstimator):
     def predict(self, mlp, budget):
         width = int(mlp.width)
@@ -81,6 +118,8 @@
             fnp.mean(fnp.asarray(final_act, dtype=fnp.float64), axis=0),
             dtype=fnp.float32,

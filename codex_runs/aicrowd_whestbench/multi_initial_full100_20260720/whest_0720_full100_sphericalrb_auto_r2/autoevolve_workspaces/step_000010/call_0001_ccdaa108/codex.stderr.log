/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.stats import norm

TARGET=0.13; TAIL=1e-11; K=11; MOD=104729; FIRST=1.0; CEX=-0.07

def mean_chi(d):
    return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def lattice_gen(w,k=K):
    return np.array([pow(k,i,MOD)/MOD for i in range(w)], dtype=np.float64)

def qmc_dirs(n,w,seed=0,k=K,shift=True,whiten=True):
    rng=np.random.default_rng(seed)
    g=lattice_gen(w,k)
    sh=rng.random(w) if shift else np.zeros(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*g[None,:]+sh[None,:])%1.0
    z=norm.ppf(np.clip(u,TAIL,1-TAIL))
    d=z/np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))[:,None]
    if whiten:
        S=d.T@d*(w/n)
        vals, vecs=np.linalg.eigh(S)
        T=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T
        # current code applies whitening to weights, equivalent d @ T
        return d, T
    return d, np.eye(w)

def relu_normal_mean(m,v):
    s=np.sqrt(np.maximum(v,1e-24)); a=m/s
    return s*norm.pdf(a)+m*norm.cdf(a)

def relu_normal_second(m,v):
    s=np.sqrt(np.maximum(v,1e-24)); a=m/s
    return (v+m*m)*norm.cdf(a)+m*s*norm.pdf(a)

def diag_means(weights):
    w=weights[0].shape[0]
    rows=[]
    # input mean 0, var 1 independent
    m=np.zeros(w); var=np.ones(w)
    for W in weights:
        pm=m@W
        pv=var@(W*W)
        mu=relu_normal_mean(pm,pv)
        sec=relu_normal_second(pm,pv)
        var=np.maximum(sec-mu*mu,1e-18)
        m=mu
        rows.append(mu)
    return rows

def current(weights,n,seed=0,first=FIRST,cex=CEX,k=K,shift=True,whiten=True, layer_shift=0.0, final_blend=0.0, hidden_blend=0.0):
    w=weights[0].shape[0]; h=n//2
    hd,T=qmc_dirs(h,w,seed,k,shift,whiten)
    dirs=np.concatenate([hd,-hd],axis=0)
    x=dirs*mean_chi(w)
    rows=[]
    analytic=diag_means(weights) if (layer_shift or final_blend or hidden_blend) else None
    W0=T@weights[0]
    x=np.maximum(x@W0,0)
    fm=exact_first(weights[0])
    sm=np.maximum(np.mean(x,axis=0),1e-12)
    x=x+(first*(fm-sm))[None,:]
    if hidden_blend:
        # not for first, exact already
        pass
    rows.append(fm)
    for li,W in enumerate(weights[1:],start=1):
        x=np.maximum(x@W,0)
        lm=np.mean(x,axis=0)
        if layer_shift and li < len(weights)-1:
            am=analytic[li]
            delta=layer_shift*(am-lm)
            x=x+delta[None,:]
            lm=lm+delta
        if li==len(weights)-1:
            if h>=2 and cex:
                q=h//2
                nested=0.5*(np.mean(x[:q],axis=0)+np.mean(x[h:h+q],axis=0))
                lm=lm+cex*(lm-nested)
            if final_blend:
                lm=lm+final_blend*(analytic[li]-lm)
        rows.append(lm)
    return np.stack(rows)

def ref_mean(weights,n=65536,seed=123):
    # randomized spherical MC, no qmc whitening, large n maybe
    rng=np.random.default_rng(seed)
    chunk=8192
    s=np.zeros((len(weights),weights[0].shape[0]), dtype=np.float64)
    done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st)
        z=rng.standard_normal((m,weights[0].shape[0]))
        z=z/np.sqrt(np.sum(z*z,axis=1,keepdims=True))*mean_chi(weights[0].shape[0])
        x=z
        for li,W in enumerate(weights):
            x=np.maximum(x@W,0)
            s[li]+=x.sum(axis=0)
        done+=m
    return s/done

def run(w=64,d=16,n=4096,nref=131072,mlps=6):
    rng=np.random.default_rng(777)
    configs=[]
    for cex in [-0.16,-0.10,-0.07,-0.03,0.0,0.05]:
        configs.append(('cex'+str(cex), dict(cex=cex)))
    for fb in [-0.1,0.05,0.1,0.2,0.4,0.7,1.0]:
        configs.append(('final_blend'+str(fb), dict(final_blend=fb)))
    for ls in [-0.2,-0.1,0.05,0.1,0.2,0.4]:
        configs.append(('layer_shift'+str(ls), dict(layer_shift=ls)))
    for first in [0.0,0.5,0.8,1.0,1.2,1.5]:
        configs.append(('first'+str(first), dict(first=first)))
    for k in [3,5,7,11,17,31,47,73]:
        configs.append(('k'+str(k), dict(k=k)))
    configs.append(('noshift',dict(shift=False)))
    configs.append(('nowhiten',dict(whiten=False)))
    base=[]; scores={name:[] for name,_ in configs}; scores['base']=[]; scores['diag']=[]
    t=time.time()
    for mi in range(mlps):
        weights=[(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(d)]
        ref=ref_mean(weights,nref,seed=1000+mi)[-1]
        pred=current(weights,n,seed=2000+mi)[-1]
        scores['base'].append(np.mean((pred-ref)**2))
        dg=np.stack(diag_means(weights))[-1]
        scores['diag'].append(np.mean((dg-ref)**2))
        for name,kw in configs:
            pr=current(weights,n,seed=2000+mi,**kw)[-1]
            scores[name].append(np.mean((pr-ref)**2))
        print('mlp',mi,'base',scores['base'][-1], flush=True)
    means={k:np.mean(v) for k,v in scores.items()}
    print('elapsed',time.time()-t)
    for k,v in sorted(means.items(), key=lambda kv: kv[1])[:30]:
        print(k,v, 'ratio', v/means['base'])


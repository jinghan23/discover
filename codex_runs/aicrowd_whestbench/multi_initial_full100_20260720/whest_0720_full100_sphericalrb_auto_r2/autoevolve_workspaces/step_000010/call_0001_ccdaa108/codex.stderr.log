 if kind=='lattice': u=lattice_u(h,w,seed)
 elif kind=='halton': u=halton(h,w,seed)
 elif kind=='sobol': u=qmc.Sobol(d=w, scramble=True, seed=seed).random_base2(int(math.log2(h)))

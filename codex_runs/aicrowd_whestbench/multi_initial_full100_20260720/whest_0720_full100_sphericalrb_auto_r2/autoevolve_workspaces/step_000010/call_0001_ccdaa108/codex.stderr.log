import numpy as np, math, time
from scipy.stats import norm, qmc
TAIL=1e-11; MOD=104729; K=11

def primes(n):
 ps=[]; x=2
 while len(ps)<n:
  ok=True
  r=int(math.sqrt(x))
  for p in ps:
   if p>r: break
   if x%p==0: ok=False; break
  if ok: ps.append(x)
  x+=1
 return ps
def radical_inverse(i,b):
 f=1.0/b; r=0.0
 while i:
  r += f*(i%b); i//=b; f/=b
 return r
def halton(n,d,seed):
 ps=primes(d); rng=np.random.default_rng(seed); shift=rng.random(d); U=np.empty((n,d))
 for j,b in enumerate(ps):
  for i in range(n): U[i,j]=(radical_inverse(i+1,b)+shift[j])%1.0
 return U
def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def exact_first(W): return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)
def lattice_u(h,w,seed):
 rng=np.random.default_rng(seed); g=np.array([pow(K,i,MOD)/MOD for i in range(w)]); idx=np.arange(h)[:,None]; return (idx*g[None,:]+rng.random(w)[None,:])%1.0
def dirs_from_u(u):

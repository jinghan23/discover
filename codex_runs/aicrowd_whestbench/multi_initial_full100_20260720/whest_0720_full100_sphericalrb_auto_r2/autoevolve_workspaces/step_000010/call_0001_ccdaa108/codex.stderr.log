sc={k:[] for k in configs}
for mi in range(mlps):
 weights=[(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(dep)]
 rf=ref(weights,nref,700+mi)
 for name,cfg in configs.items(): sc[name].append(np.mean((pred(weights,n,1700+mi,*cfg)-rf)**2))
 print('mlp',mi,'base',sc['prefix-.07'][-1], flush=True)
base=np.mean(sc['prefix-.07'])
for k in sorted(sc,key=lambda k:np.mean(sc[k])):
 print(k,np.mean(sc[k]),np.mean(sc[k])/base)

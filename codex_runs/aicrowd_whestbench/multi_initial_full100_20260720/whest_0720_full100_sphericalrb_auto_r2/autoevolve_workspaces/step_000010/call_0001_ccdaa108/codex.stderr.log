from scipy.stats import norm
TAIL=1e-11; MOD=104729

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def exact_first(W): return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)
def gen(w,k): return np.array([pow(k,i,MOD)/MOD for i in range(w)], dtype=np.float64)
def dirs(h,w,seed,k):
 r=np.random.default_rng(seed); g=gen(w,k); idx=np.arange(h,dtype=np.float64)[:,None]; u=(idx*g[None,:]+r.random(w)[None,:])%1.0; z=norm.ppf(np.clip(u,TAIL,1-TAIL)); d=z/np.sqrt(np.sum(z*z,axis=1,keepdims=True)); S=d.T@d*(w/h); vals,vecs=np.linalg.eigh(S); T=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T; return d,T
def pred(weights,n,seed,k=11,cex=-.07):
 w=weights[0].shape[0]; h=n//2; d,T=dirs(h,w,seed,k); x=np.concatenate([d,-d])*mean_chi(w); x=np.maximum(x@(T@weights[0]),0); fm=exact_first(weights[0]); x=x+(fm-np.maximum(x.mean(0),1e-12));
 for li,W in enumerate(weights[1:],1):
  x=np.maximum(x@W,0); lm=x.mean(0)
  if li==len(weights)-1 and h>=2:

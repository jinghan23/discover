314: def validate_predictions(predictions: fnp.ndarray, *, depth: int, width: int) -> fnp.ndarray:
315:     """Validate estimator prediction array shape and finiteness."""
316:     shape = tuple(predictions.shape) if hasattr(predictions, "shape") else ()
317:     expected_shape = (depth, width)
318:     if shape != expected_shape:
319:         if shape == (width, depth):
320:             hint = (
321:                 "Returned predictions appear to be transposed (got width-first instead "
322:                 "of depth-first). Stack per-layer mean vectors with "
323:                 "`fnp.stack(rows, axis=0)` where each row has shape (width,)."
324:             )
325:         else:
326:             hint = (
327:                 "Predictions must be a 2D array of shape (depth, width). Stack per-layer "
328:                 "mean vectors with `fnp.stack(rows, axis=0)` where each row has shape (width,)."
329:             )
330:         details = {
331:             "expected_shape": list(expected_shape),
332:             "got_shape": list(shape),
333:             "cause_hints": [hint],
334:             "hint": hint,
335:         }
336:         exc = ValueError(
337:             f"Predictions must have shape (depth={depth}, width={width}); got shape={shape}."
338:         )
339:         setattr(exc, "details", details)
340:         raise exc
341:     pred_np = fnp.asarray(predictions, dtype=fnp.float32)
342:     if not fnp.all(fnp.isfinite(pred_np)):
343:         details = {
344:             "expected_shape": list(expected_shape),
345:             "got_shape": list(shape),
346:             "cause_hints": ["Predictions must contain finite values only."],
347:             "hint": "Prediction values must be finite and include neither inf nor NaN.",
348:         }
349:         exc = ValueError("Predictions must contain only finite values.")
350:         setattr(exc, "details", details)
351:         raise exc
352:     return predictions

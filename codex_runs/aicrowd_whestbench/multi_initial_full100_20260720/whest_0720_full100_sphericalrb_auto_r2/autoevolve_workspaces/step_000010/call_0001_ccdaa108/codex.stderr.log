/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm
TAIL=1e-11; MOD=104729; K=11

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def exact_first(W): return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(K,i,MOD)/MOD for i in range(w)], dtype=np.float64)
def lattice_normals(h,w,seed):
 rng=np.random.default_rng(seed); g=gen(w); idx=np.arange(h)[:,None]; u=(idx*g[None,:]+rng.random(w)[None,:])%1.0; return norm.ppf(np.clip(u,TAIL,1-TAIL))
def pred(weights,n,seed,kind):
 w=weights[0].shape[0]; h=n//2; z=lattice_normals(h,w,seed)
 if kind=='spherical':
  d=z/np.sqrt(np.sum(z*z,axis=1,keepdims=True)); S=d.T@d*(w/h); vals,vecs=np.linalg.eigh(S); T=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T; x=np.concatenate([d,-d])*mean_chi(w)
 else:
  S=z.T@z/h; vals,vecs=np.linalg.eigh(S); T=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T; x=np.concatenate([z,-z])
 x=np.maximum(x@(T@weights[0]),0); fm=exact_first(weights[0]); x=x+(fm-np.maximum(x.mean(0),1e-12))
 for li,W in enumerate(weights[1:],1):
  x=np.maximum(x@W,0); lm=x.mean(0)
  if li==len(weights)-1:
   q=h//2; nested=.5*(x[:q].mean(0)+x[h:h+q].mean(0)); lm=lm-.07*(lm-nested)
 return lm
def ref(weights,n,seed):
 # plain MC gaussian high-ish
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0; chunk=4096
 for st in range(0,n,chunk):
  m=min(chunk,n-st); x=rng.standard_normal((m,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/done
rng=np.random.default_rng(333); w=128; d=32; n=4096; nref=32768; mlps=6; sc={'spherical':[],'gaussian':[]}
for mi in range(mlps):
 weights=[(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(d)]
 rf=ref(weights,nref,100+mi)
 for kind in sc: sc[kind].append(np.mean((pred(weights,n,200+mi,kind)-rf)**2))
print({k:np.mean(v) for k,v in sc.items()}, 'ratio', np.mean(sc['gaussian'])/np.mean(sc['spherical']))

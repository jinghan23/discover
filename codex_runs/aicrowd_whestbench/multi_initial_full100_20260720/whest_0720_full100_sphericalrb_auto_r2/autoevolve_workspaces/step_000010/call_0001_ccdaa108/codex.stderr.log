import numpy as np, math
from scipy.stats import norm
TAIL=1e-11; MOD=104729; K=11

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def exact_first(W): return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(K,i,MOD)/MOD for i in range(w)], dtype=np.float64)
def dirs(h,w,seed):
 rng=np.random.default_rng(seed); g=gen(w); idx=np.arange(h)[:,None]; u=(idx*g[None,:]+rng.random(w))%1.0; z=norm.ppf(np.clip(u,TAIL,1-TAIL)); d=z/np.sqrt(np.sum(z*z,axis=1,keepdims=True)); S=d.T@d*(w/h); vals,vecs=np.linalg.eigh(S); T=(vecs/np.sqrt(np.maximum(vals,1e-8)))@vecs.T; return d,T
def pred_base_acts(weights,n,seed):
 w=weights[0].shape[0]; h=n//2; d,T=dirs(h,w,seed); x=np.concatenate([d,-d])*mean_chi(w); x=np.maximum(x@(T@weights[0]),0); fm=exact_first(weights[0]); x=x+(fm-np.maximum(x.mean(0),1e-12))
 for W in weights[1:]: x=np.maximum(x@W,0)
 return x,h
def pred(weights,n,seed,cp=-.07,ce=0,co=0):
 x,h=pred_base_acts(weights,n,seed); lm=x.mean(0); q=h//2
 prefix=.5*(x[:q].mean(0)+x[h:h+q].mean(0))
 even=.5*(x[:h:2].mean(0)+x[h::2].mean(0))
 odd=.5*(x[1:h:2].mean(0)+x[h+1::2].mean(0))
 return lm + cp*(lm-prefix) + ce*(lm-even) + co*(lm-odd)
def ref(weights,n,seed): return pred(weights,n,seed,0,0,0)

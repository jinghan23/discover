556: def _compute_budget_adjusted_score(
557:     *, mse_final: float, effective_compute: float, flop_budget: int, failure: bool
558: ) -> float:
559:     """Per-MLP budget-adjusted score ``s_m = mse_final * score_multiplier(C_m, B_m)``.
560: 
561:     See ``whestbench.budget.score_multiplier`` for the canonical multiplier
562:     (1.0 on failure / no budget; otherwise ``max(0.1, C_m / B_m)``, uncapped above).
563:     """
564:     return float(mse_final) * score_multiplier(effective_compute, flop_budget, failed=failure)

355: def _predict_stats_to_dict(stats: Any) -> Optional[Dict[str, Any]]:
356:     if stats is None:
357:         return None
358:     if isinstance(stats, dict):
359:         return stats
360:     extracted: Dict[str, Any] = {}
361:     for field in (
362:         "flops_used",
363:         "wall_time_s",
364:         "flopscope_backend_time_s",
365:         "flopscope_overhead_time_s",
366:         "residual_wall_time_s",
367:         "budget_breakdown",
368:     ):
369:         if hasattr(stats, field):
370:             extracted[field] = getattr(stats, field)
371:     return extracted or None

import math, time
import numpy as np
from scipy.special import ndtri

TAIL=1e-11; MOD=104729; MULT=11

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def sample_count(budget,w,d,frac=0.13):
    half=(89*w+3*w+2)//2; layer=d*(2*w*w+2*w); cov=w*w; fixed=13*w**3+8*w
    c=(int(frac*budget)-fixed)//(half+layer+cov)
    c=int(max(32,min(c,100*1024*1024//(w*8))))
    return c-(c&1)

def gen(w): return np.array([pow(MULT,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng,g):
    u=np.arange(n,dtype=float)[:,None]*g[None,:]+rng.random(w)[None,:]
    u=u-np.floor(u); u=np.clip(u,TAIL,1-TAIL)
    z=ndtri(u); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def wh(d):
    n,w=d.shape; s=d.T@d*(w/n); vals,vecs=np.linalg.eigh(s); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def pred(weights,seed,budget,mode='first',ex=-.07):
    depth=len(weights); w=weights[0].shape[0]; n=sample_count(budget,w,depth); half=n//2
    hd=dirs(half,w,np.random.default_rng(seed),gen(w)); T=wh(hd); act=np.concatenate([hd,-hd])*mean_chi(w)
    act=np.maximum(act@(T@weights[0]),0); first=exact_first(weights[0]); act*=((first/np.maximum(act.mean(0),1e-12))**.73)[None,:]
    rows=[first]
    for li,W in enumerate(weights[1:],1):
        act=np.maximum(act@W,0); lm=act.mean(0)
        if li==depth-1 and ex:
            if mode=='first':
                q=half//2; nested=.5*(act[:q].mean(0)+act[half:half+q].mean(0))
            elif mode=='stride':
                nested=.5*(act[:half:2].mean(0)+act[half::2].mean(0))
            elif mode=='second':
                q=half//2; nested=.5*(act[q:half].mean(0)+act[half+q:].mean(0))
            elif mode=='avg_first_second':
                q=half//2
                n1=.5*(act[:q].mean(0)+act[half:half+q].mean(0))
                n2=.5*(act[q:half].mean(0)+act[half+q:].mean(0))
                nested=0.5*(n1+n2)
            elif mode=='odd':
                nested=.5*(act[1:half:2].mean(0)+act[half+1::2].mean(0))
            lm=lm+ex*(lm-nested)
        rows.append(lm)
    return np.stack(rows)

def target(weights,n=150000,seed=7):
    rng=np.random.default_rng(seed); d=len(weights); w=weights[0].shape[0]; sums=np.zeros((d,w)); done=0
    while done<n:
        m=min(10000,n-done); x=rng.standard_normal((m,w))
        for i,W in enumerate(weights): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
        done+=m
    return sums/n
w=64; d=32; budget=int(272e9*(w/256)**2)
rng=np.random.default_rng(123); N=8; weights=[]; targets=[]
t=time.time()
for i in range(N):
    ws=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
    weights.append(ws); targets.append(target(ws, seed=1000+i)); print('mk',i,time.time()-t,flush=True)

def score(mode,ex):
    return np.mean([np.mean((pred(weights[i],5000+i,budget,mode,ex)[-1]-targets[i][-1])**2) for i in range(N)])
for mode in ['first','second','avg_first_second','stride','odd']:
    vals=[]
    for ex in [-.12,-.09,-.07,-.05,-.03,0,.05]: vals.append((ex,score(mode,ex)))
    print(mode, vals)

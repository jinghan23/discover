+                standardized_mean = pre_mean / pre_standard_deviation
+                gaussian_relu_mean = (
+                    pre_mean * flops.stats.norm.cdf(standardized_mean)
+                    + pre_standard_deviation
+                    * flops.stats.norm.pdf(standardized_mean)
+                )
+                layer_mean = layer_mean + _FINAL_GAUSSIAN_EXTRAPOLATION * (
+                    gaussian_relu_mean - layer_mean
+                )
             rows.append(layer_mean)
 
         return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)


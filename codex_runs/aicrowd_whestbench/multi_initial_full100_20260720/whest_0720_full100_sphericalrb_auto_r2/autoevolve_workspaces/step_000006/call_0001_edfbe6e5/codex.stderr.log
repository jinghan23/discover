from scipy.special import ndtri
TAIL=1e-11; MOD=104729; MULT=11

def mean_chi(d): h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def scount(budget,w,d):
 c=(int(.13*budget)-(13*w**3+8*w))//(((89*w+3*w+2)//2)+d*(2*w*w+2*w)+w*w); c=int(max(32,min(c,100*1024*1024//(w*8)))); return c-(c&1)
def gen(w): return np.array([pow(MULT,i,MOD)/MOD for i in range(w)],float)
def block_dirs(n,w,rng,g):
 u=np.arange(n,dtype=float)[:,None]*g[None,:]+rng.random(w)[None,:]; u=u-np.floor(u); u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def dirs(n,w,rng,g,shifts):
 if shifts==1: return block_dirs(n,w,rng,g)
 sizes=[n//shifts]*shifts
 for i in range(n%shifts): sizes[i]+=1
 return np.concatenate([block_dirs(s,w,rng,g) for s in sizes],0)
def wh(d):
 n,w=d.shape; s=d.T@d*(w/n); vals,V=np.linalg.eigh(s); vals=np.maximum(vals,1e-8); return (V/np.sqrt(vals))@V.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def pred(Ws,seed,budget,shifts):
 d=len(Ws); w=Ws[0].shape[0]; half=scount(budget,w,d)//2; hd=dirs(half,w,np.random.default_rng(seed),gen(w),shifts); A=np.concatenate([hd,-hd])*mean_chi(w); A=np.maximum(A@(wh(hd)@Ws[0]),0); f=exact_first(Ws[0]); A*=((f/np.maximum(A.mean(0),1e-12))**.73)[None,:]

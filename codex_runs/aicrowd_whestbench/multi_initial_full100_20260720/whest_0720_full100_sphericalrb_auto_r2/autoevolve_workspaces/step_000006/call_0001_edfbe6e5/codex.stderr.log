codex
Another variance lever is the first-layer square root: the true first preactivation distribution is `N(0, W0.T @ W0)`, so any covariance square root is mathematically valid, but finite QMC error depends on the chosen orientation. I’m testing whether an eigensquare-root or Cholesky first transform beats using `W0` directly.
exec
/bin/bash -lc "python - <<'PY'
import math,time
import numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; MULT=11

def mean_chi(d): h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def scount(budget,w,d):
 half=(89*w+3*w+2)//2; layer=d*(2*w*w+2*w); cov=w*w; fixed=13*w**3+8*w
 c=(int(.13*budget)-fixed)//(half+layer+cov); c=int(max(32,min(c,100*1024*1024//(w*8))))
 return c-(c&1)
def gen(w): return np.array([pow(MULT,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng,g):
 u=np.arange(n,dtype=float)[:,None]*g[None,:]+rng.random(w)[None,:]; u=u-np.floor(u); u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def wh(d):
 n,w=d.shape; s=d.T@d*(w/n); vals,vecs=np.linalg.eigh(s); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def first_transform(W,kind):
 if kind=='W': return W
 S=W.T@W
 if kind=='eig':
  vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,0); return (vecs*np.sqrt(vals))@vecs.T
 if kind=='chol':
  return np.linalg.cholesky(S+1e-12*np.eye(S.shape[0])).T
 if kind=='eig_rev':
  vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,0); return vecs[:,::-1]*np.sqrt(vals[::-1]) @ vecs[:,::-1].T
 raise ValueError
def pred(weights,seed,budget,kind):
 depth=len(weights); w=weights[0].shape[0]; n=scount(budget,w,depth); half=n//2; hd=dirs(half,w,np.random.default_rng(seed),gen(w)); T=wh(hd)
 F=first_transform(weights[0],kind); act=np.concatenate([hd,-hd])*mean_chi(w); act=np.maximum(act@(T@F),0)
 first=exact_first(weights[0]); act*=((first/np.maximum(act.mean(0),1e-12))**.73)[None,:]
 for li,W in enumerate(weights[1:],1):
  act=np.maximum(act@W,0); lm=act.mean(0)
  if li==depth-1:
   q=half//2; nested=.5*(act[:q].mean(0)+act[half:half+q].mean(0)); lm=lm-.07*(lm-nested)
 return lm
def target(weights,n=160000,seed=7):
 rng=np.random.default_rng(seed); d=len(weights); w=weights[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(10000,n-done); x=rng.standard_normal((m,w))
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for w in [64,128]:
 d=32; budget=int(272e9*(w/256)**2); N=8 if w==64 else 3; NT=120000 if w==64 else 60000; rng=np.random.default_rng(777+w); Ws=[]; Ts=[]; print('case',w,'n',scount(budget,w,d))
 for i in range(N):
  weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]; Ws.append(weights); Ts.append(target(weights,NT,30+i))
 for kind in ['W','eig','chol']:
  mse=np.mean([np.mean((pred(Ws[i],400+i,budget,kind)-Ts[i])**2) for i in range(N)])
  print(kind,mse)

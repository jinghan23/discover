import math,time
import numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; MULT=11

def mean_chi(d): h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def gen(w): return np.array([pow(MULT,i,MOD)/MOD for i in range(w)],float)
def scount(budget,w,d,frac=.13,mode='normal'):
 half=(89*w+3*w+2)//2 if mode=='normal' else (3*w+2)//2
 layer=d*(2*w*w+2*w); cov=w*w; fixed=13*w**3+8*w
 c=(int(frac*budget)-fixed)//(half+layer+cov); c=int(max(32,min(c,100*1024*1024//(w*8))))
 return c-(c&1)
def dirs_normal(n,w,rng,g):
 u=np.arange(n,dtype=float)[:,None]*g[None,:]+rng.random(w)[None,:]; u=u-np.floor(u); u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def dirs_sign(n,w,rng,g):
 u=np.arange(n,dtype=float)[:,None]*g[None,:]+rng.random(w)[None,:]; u=u-np.floor(u); z=np.where(u<0.5,-1.0,1.0); return z/math.sqrt(w)
def wh(d):
 n,w=d.shape; s=d.T@d*(w/n); vals,vecs=np.linalg.eigh(s); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def pred(weights,seed,budget,mode='normal',frac=.13,ex=-.07):
 depth=len(weights); w=weights[0].shape[0]; n=scount(budget,w,depth,frac,mode); half=n//2; rng=np.random.default_rng(seed); g=gen(w)
 hd=dirs_normal(half,w,rng,g) if mode=='normal' else dirs_sign(half,w,rng,g)
 T=wh(hd); act=np.concatenate([hd,-hd])*mean_chi(w); act=np.maximum(act@(T@weights[0]),0)
 first=exact_first(weights[0]); act*=((first/np.maximum(act.mean(0),1e-12))**.73)[None,:]

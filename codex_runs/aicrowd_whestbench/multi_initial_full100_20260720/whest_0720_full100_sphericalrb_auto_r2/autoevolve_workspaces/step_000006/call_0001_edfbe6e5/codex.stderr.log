import math, time
import numpy as np
from scipy.special import ndtri, ndtr

TARGET_FRACTION=0.13
MAX_WORK=100*1024*1024
TAIL=1e-11
MIN=32
MULT=11
MOD=104729

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def sample_count(budget,w,d,frac=0.13):
    half=(89*w+3*w+2)//2
    layer=d*(2*w*w+2*w)
    cov=w*w
    per=half+layer+cov
    fixed=13*w**3+8*w
    lim=(int(frac*budget)-fixed)//max(per,1)
    mem=MAX_WORK//max(w*8,1)
    c=int(max(MIN,min(lim,mem)))
    return c-(c&1)

def lattice_gen(w, mult=11, mod=104729):
    return np.array([pow(mult,i,mod)/mod for i in range(w)], dtype=np.float64)

def qmc_dirs(n,w,rng,gen,tail=TAIL):
    shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=idx*gen[None,:]+shift[None,:]
    u=u-np.floor(u)
    u=np.clip(u,tail,1-tail)
    z=ndtri(u)
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def whitening(dirs):
    n,w=dirs.shape
    s=(dirs.T@dirs)*(w/n)
    vals, vecs=np.linalg.eigh(s)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first(W):
    sd=np.sqrt(np.sum(W*W,axis=0))
    return sd/math.sqrt(2*math.pi)

def predict(weights, seed, budget, frac=0.13, powcorr=0.73, extrap=-0.07, offset=0, mult=11, mod=104729, blend=0.0, analytic=None):
    d=len(weights); w=weights[0].shape[0]
    n=sample_count(budget,w,d,frac); half=n//2
    rng=np.random.default_rng(int(seed)+offset)
    gen=lattice_gen(w,mult,mod)
    hd=qmc_dirs(half,w,rng,gen)
    wh=whitening(hd)
    fw=wh@weights[0]
    dirs=np.concatenate([hd,-hd],axis=0)
    act=dirs*mean_chi(w)
    rows=[]
    act=np.maximum(act@fw,0)
    first=exact_first(weights[0])
    sample_first=np.maximum(np.mean(act,axis=0),1e-12)
    corr=(first/sample_first)**powcorr
    act=act*corr[None,:]
    rows.append(first)
    for li,W in enumerate(weights[1:],start=1):
        act=np.maximum(act@W,0)
        lm=np.mean(act,axis=0)
        if li==d-1 and half>=2 and extrap"'!=0:
            q=half//2
            nested=0.5*(np.mean(act[:q],axis=0)+np.mean(act[half:half+q],axis=0))
            lm=lm+extrap*(lm-nested)
        rows.append(lm)
    pred=np.stack(rows)
    if blend and analytic is not None:
        pred[-1]=(1-blend)*pred[-1]+blend*analytic[-1]
    return pred

def analytic_mean_cov(weights):
    # reference covariance approximation
    w=weights[0].shape[0]
    mu=np.zeros(w)
    cov=np.eye(w)
    rows=[]
    for W in weights:
        mu_pre=W.T@mu
        cov_pre=W.T@cov@W
        var=np.maximum(np.diag(cov_pre),1e-12)
        sig=np.sqrt(var)
        alpha=mu_pre/sig
        phi=np.exp(-0.5*alpha*alpha)/math.sqrt(2*math.pi)
        Phi=ndtr(alpha)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var)*Phi+mu_pre*sig*phi
        var_post=np.maximum(ez2-mu*mu,0)
        gain=np.where(sig>1e-12,Phi,0)
        cov=(gain[:,None]*gain[None,:])*cov_pre
        np.fill_diagonal(cov,var_post)
        rows.append(mu.copy())
    return np.stack(rows)

def mc_target(weights, n=200000, seed=123, chunk=8192):
    rng=np.random.default_rng(seed)
    d=len(weights); w=weights[0].shape[0]
    sums=np.zeros((d,w),dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float64)
        for li,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[li]+=x.sum(axis=0)
        done+=m
    return sums/n

w=64; d=32; budget=int(272_000_000_000*(w/256)**2*(d/32))
print('"'budget',budget,'n',sample_count(budget,w,d))
NMLP=6; NT=120000
rng=np.random.default_rng(20260721)
weights_list=[]; targets=[]; analytics=[]

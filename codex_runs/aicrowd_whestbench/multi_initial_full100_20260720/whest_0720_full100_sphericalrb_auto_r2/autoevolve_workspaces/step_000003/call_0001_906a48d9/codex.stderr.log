 a=np.maximum(a@(Wh@ws[0]),0); m1=exact1(ws[0]); a*= (m1/np.maximum(a.mean(0),1e-12))[None,:]
 for W in ws[1:]: a=np.maximum(a@W,0)
 return a.mean(0)

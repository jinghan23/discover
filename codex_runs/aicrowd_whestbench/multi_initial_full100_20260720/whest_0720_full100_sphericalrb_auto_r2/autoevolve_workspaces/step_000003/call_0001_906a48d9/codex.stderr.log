import math, numpy as np
from scipy import stats
TAIL=1e-11; MOD=104729

def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def weights(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(float) for _ in range(d)]
def true(ws,n=150000,seed=0,b=15000):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; done=0; s=np.zeros(w)
 while done<n:
  m=min(b,n-done); done+=m; x=r.standard_normal((m,w))
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
def relu_gauss(mu,var):
 sd=np.sqrt(np.maximum(var,1e-30)); a=mu/sd; return sd*stats.norm.pdf(a)+mu*stats.norm.cdf(a)
def est(ws,n,seed=0,alpha=0):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; h=n//2; g=np.array([pow(11,i,MOD)/MOD for i in range(w)])
 u=(np.arange(h)[:,None]*g[None,:]+r.random(w)[None,:])%1; z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); hd=z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
 M=hd.T@hd*(w/h); ev,U=np.linalg.eigh(M); Wh=(U/np.sqrt(np.maximum(ev,1e-8)))@U.T; a=np.concatenate([hd,-hd])*mean_chi(w)
 a=np.maximum(a@(Wh@ws[0]),0); m1=np.sqrt((ws[0]*ws[0]).sum(0))/math.sqrt(2*math.pi); a*= (m1/np.maximum(a.mean(0),1e-12))[None,:]
 for W in ws[1:-1]: a=np.maximum(a@W,0)
 pre=a@ws[-1]; rel=np.maximum(pre,0); sm=rel.mean(0)
 if alpha:
  mu=pre.mean(0); var=np.maximum((pre*pre).mean(0)-mu*mu,0); gm=relu_gauss(mu,var); return (1-alpha)*sm+alpha*gm
 return sm
for w,d,n in [(32,8,256),(32,16,256),(64,8,512),(64,16,512),(128,8,512),(128,16,512),(128,8,1024)]:
 print('---',w,d,n); vals={a:[] for a in [-.5,-.2,-.1,0,.1,.2,.3,.5,.8,1.0]}
 for c in range(6):
  ws=weights(w,d,np.random.default_rng(100+w*9+d*11+c)); tgt=true(ws,n=180000 if w<=64 else 100000,seed=500+c)

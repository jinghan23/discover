+def _relu_gaussian_moments(mean: fnp.ndarray, variance: fnp.ndarray):
+    standard_deviation = fnp.sqrt(fnp.maximum(variance, 1e-30))
+    alpha = mean / standard_deviation
+    density = flops.stats.norm.pdf(alpha)
+    distribution = flops.stats.norm.cdf(alpha)
+    relu_mean = standard_deviation * density + mean * distribution
+    relu_second = (
+        (mean * mean + variance) * distribution
+        + mean * standard_deviation * density
+    )
+    relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 0.0)
+    return relu_mean, relu_variance
+
+
+def _diagonal_gaussian_rows(weights) -> fnp.ndarray:
+    first_weight = weights[0]
+    first_pre_variance = fnp.sum(first_weight * first_weight, axis=0)
+    mean = fnp.sqrt(first_pre_variance) / fnp.sqrt(2.0 * fnp.pi)
+    variance = fnp.maximum(0.5 * first_pre_variance - mean * mean, 0.0)
+    rows = [mean]
+
+    for weight in weights[1:]:
+        pre_mean = mean @ weight
+        pre_variance = variance @ (weight * weight)
+        mean, variance = _relu_gaussian_moments(pre_mean, pre_variance)
+        rows.append(mean)
+
+    return fnp.stack(rows, axis=0)
+

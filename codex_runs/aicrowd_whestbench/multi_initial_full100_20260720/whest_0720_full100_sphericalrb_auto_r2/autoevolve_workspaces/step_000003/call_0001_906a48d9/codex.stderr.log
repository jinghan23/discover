/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy import stats

TAIL=1e-11
MULT=11
MOD=104729

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def weights(width, depth, rng):
    return [(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]

def true_means(ws, n=200000, batch=20000, seed=123):
    rng=np.random.default_rng(seed)
    depth=len(ws); width=ws[0].shape[0]
    sums=[np.zeros(width) for _ in range(depth)]
    done=0
    while done<n:
        m=min(batch,n-done); done+=m
        x=rng.standard_normal((m,width))
        for i,W in enumerate(ws):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(axis=0)
    return [s/n for s in sums]

def lattice_gen(width, mult=MULT, mod=MOD):
    return np.array([pow(mult,i,mod)/mod for i in range(width)],float)

def qmc_dirs(nh,width,rng,mult=MULT):
    gen=lattice_gen(width,mult)
    shift=rng.random(width)
    idx=np.arange(nh)[:,None].astype(float)
    u=(idx*gen[None,:]+shift[None,:])%1.0
    z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL))
    return z/np.sqrt(np.maximum((z*z).sum(axis=1),1e-24))[:,None]

def whitening(dirs):
    n,w=dirs.shape
    M=dirs.T@dirs*(w/n)
    ev,U=np.linalg.eigh(M)
    ev=np.maximum(ev,1e-8)
    return (U/np.sqrt(ev))@U.T

def exact_first_mean(W):
    return np.sqrt((W*W).sum(axis=0))/math.sqrt(2*math.pi)

def current(ws,n,seed=0,mult=11,offset=0):
    rng=np.random.default_rng(seed+offset)
    h=n//2
    hd=qmc_dirs(h,ws[0].shape[0],rng,mult)
    Wh=whitening(hd)
    dirs=np.concatenate([hd,-hd],axis=0)
    a=dirs*mean_chi(ws[0].shape[0])
    out=[]
    a=np.maximum(a@(Wh@ws[0]),0)
    m1=exact_first_mean(ws[0])
    sm=np.maximum(a.mean(axis=0),1e-12)
    a=a*(m1/sm)[None,:]
    out.append(m1)
    for W in ws[1:]:
        a=np.maximum(a@W,0)
        out.append(a.mean(axis=0))
    return out

def first_cov_exact(W):
    C=W.T@W
    sd=np.sqrt(np.maximum(np.diag(C),1e-30))
    R=C/(sd[:,None]*sd[None,:])
    R=np.clip(R,-1,1)
    term=np.sqrt(np.maximum(1-R*R,0))+(math.pi-np.arccos(R))*R
    second=(sd[:,None]*sd[None,:])*term/(2*math.pi)
    m=sd/math.sqrt(2*math.pi)
    return m, second-np.outer(m,m), second

def current_varscale1(ws,n,seed=0):
    rng=np.random.default_rng(seed)
    h=n//2; width=ws[0].shape[0]
    hd=qmc_dirs(h,width,rng)
    Wh=whitening(hd); dirs=np.concatenate([hd,-hd],axis=0)
    a=dirs*mean_chi(width)
    out=[]
    a=np.maximum(a@(Wh@ws[0]),0)
    m1,cov1,_=first_cov_exact(ws[0])
    sm=np.maximum(a.mean(axis=0),1e-12)
    a=a*(m1/sm)[None,:]
    # affine diagonal variance match
    sv=np.maximum(((a-m1)**2).mean(axis=0),1e-12)
    scale=np.sqrt(np.maximum(np.diag(cov1),1e-30)/sv)
    a=(a-m1)*scale[None,:]+m1
    out.append(m1)
    for W in ws[1:]:
        a=np.maximum(a@W,0)
        out.append(a.mean(axis=0))
    return out

def current_fullcov1(ws,n,seed=0):
    rng=np.random.default_rng(seed)
    h=n//2; width=ws[0].shape[0]
    hd=qmc_dirs(h,width,rng)
    Wh=whitening(hd); dirs=np.concatenate([hd,-hd],axis=0)
    a=dirs*mean_chi(width)
    out=[]
    a=np.maximum(a@(Wh@ws[0]),0)
    m1,cov1,_=first_cov_exact(ws[0])
    sm=np.maximum(a.mean(axis=0),1e-12)
    a=a*(m1/sm)[None,:]
    S=a-m1
    Cs=S.T@S/n
    evs,Us=np.linalg.eigh(Cs+1e-10*np.eye(width))
    eve,Ue=np.linalg.eigh(cov1+1e-10*np.eye(width))
    invs=(Us/np.sqrt(np.maximum(evs,1e-10)))@Us.T
    sqe=(Ue*np.sqrt(np.maximum(eve,0)))@Ue.T
    T=invs@sqe
    a=S@T+m1
    out.append(m1)
    for W in ws[1:]:
        a=np.maximum(a@W,0)
        out.append(a.mean(axis=0))
    return out

def diag_analytic(ws):
    W=ws[0]
    pre=(W*W).sum(axis=0)
    mean=np.sqrt(pre)/math.sqrt(2*math.pi)
    var=0.5*pre-mean*mean
    out=[mean]
    for W in ws[1:]:
        mu=mean@W
        va=var@(W*W)
        sd=np.sqrt(np.maximum(va,1e-30)); alpha=mu/sd
        phi=stats.norm.pdf(alpha); Phi=stats.norm.cdf(alpha)
        mean=sd*phi+mu*Phi
        sec=(mu*mu+va)*Phi+mu*sd*phi
        var=np.maximum(sec-mean*mean,0)
        out.append(mean)
    return out


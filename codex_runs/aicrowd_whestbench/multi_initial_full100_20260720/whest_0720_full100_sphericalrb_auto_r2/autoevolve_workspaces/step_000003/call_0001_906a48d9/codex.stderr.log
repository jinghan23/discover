def weights(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(float) for _ in range(d)]
def true(ws,n=120000,seed=0,b=12000):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; sums=[np.zeros(w) for _ in ws]; done=0
 while done<n:
  m=min(b,n-done); done+=m; x=r.standard_normal((m,w))
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return [s/n for s in sums]
def gen(w,mult): return np.array([pow(mult,i,MOD)/MOD for i in range(w)],float)
def dirs(nh,w,r,mult=11,multi=1):
 parts=[]; g=gen(w,mult)
 for k in range(multi):
  m=nh//multi+(k<nh%multi); sh=r.random(w); idx=np.arange(m)[:,None].astype(float)
  u=(idx*g[None,:]+sh[None,:])%1.0; z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); parts.append(z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None])
 return np.concatenate(parts,0)
def white(D):
 n,w=D.shape; M=D.T@D*(w/n); ev,U=np.linalg.eigh(M); return (U/np.sqrt(np.maximum(ev,1e-8)))@U.T
def exact1(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def est(ws,n,seed,mult=11,multi=1):

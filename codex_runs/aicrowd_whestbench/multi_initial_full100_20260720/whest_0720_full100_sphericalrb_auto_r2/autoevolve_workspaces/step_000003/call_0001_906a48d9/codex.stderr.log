 while done<n:
  m=min(b,n-done); done+=m; x=r.standard_normal((m,w))
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
def dirs(w,h,r):
 g=np.array([pow(11,i,MOD)/MOD for i in range(w)]); u=(np.arange(h)[:,None]*g[None,:]+r.random(w)[None,:])%1; z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

import math, numpy as np
from scipy import stats
TAIL=1e-11; MOD=104729

def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def weights(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(float) for _ in range(d)]
def true(ws,n=120000,seed=0,b=12000):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; sums=[np.zeros(w) for _ in ws]; done=0
 while done<n:
  m=min(b,n-done); done+=m; x=r.standard_normal((m,w))
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0)
 return [s/n for s in sums]
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)],float)
def dirs(nh,w,r):
 g=gen(w); sh=r.random(w); idx=np.arange(nh)[:,None].astype(float); u=(idx*g[None,:]+sh[None,:])%1.0
 z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def white(D):
 n,w=D.shape; M=D.T@D*(w/n); ev,U=np.linalg.eigh(M); return (U/np.sqrt(np.maximum(ev,1e-8)))@U.T
def exact_first(W):
 K=W.T@W; sd=np.sqrt(np.maximum(np.diag(K),1e-30)); m=sd/math.sqrt(2*math.pi)
 R=K/(sd[:,None]*sd[None,:]); R=np.clip(R,-1,1)
 second=(sd[:,None]*sd[None,:])*(np.sqrt(np.maximum(1-R*R,0))+(math.pi-np.arccos(R))*R)/(2*math.pi)
 return m, second-np.outer(m,m)
def relu_gauss(mu,var):
 sd=np.sqrt(np.maximum(var,1e-30)); a=mu/sd; phi=stats.norm.pdf(a); Phi=stats.norm.cdf(a)
 return sd*phi+mu*Phi
def est(ws,n,seed=0,lam=0.0,layer2=True,blend_deeper=False):
 r=np.random.default_rng(seed); h=n//2; w=ws[0].shape[0]; hd=dirs(h,w,r); Wh=white(hd); D=np.concatenate([hd,-hd]); a=D*mean_chi(w); rows=[]
 a=np.maximum(a@(Wh@ws[0]),0); m1,cov1=exact_first(ws[0]); a*= (m1/np.maximum(a.mean(0),1e-12))[None,:]; rows.append(m1)
 analytic_mean=m1; analytic_var=np.diag(cov1)
 # layer2 control target from full first covariance
 if len(ws)>1:
  W=ws[1]; a=np.maximum(a@W,0); sm=np.maximum(a.mean(0),1e-12)
  mu=m1@W; var=np.sum(W*(cov1@W),axis=0); gm=relu_gauss(mu,var)
  target=(1-lam)*sm+lam*gm
  a*= (target/sm)[None,:]
  rows.append(target)
  analytic_mean=target
  analytic_var=np.maximum(a.var(0),1e-12)
 for W in ws[2:]:
  a=np.maximum(a@W,0); sm=a.mean(0)
  if blend_deeper and lam:
   mu=analytic_mean@W; var=analytic_var@(W*W); gm=relu_gauss(mu,var); target=(1-lam)*sm+lam*gm; a*= (target/np.maximum(sm,1e-12))[None,:]; rows.append(target); analytic_mean=target; analytic_var=np.maximum(a.var(0),1e-12)
  else:
   rows.append(sm); analytic_mean=sm; analytic_var=np.maximum(a.var(0),1e-12)
 return rows

def run(configs):
 for w,d,n in configs:
  print('---',w,d,n)
  vals={lam:[] for lam in [0,.1,.2,.3,.5,.8,1.0]}
  valsd={lam:[] for lam in [.05,.1,.2]}
  for c in range(4):
   ws=weights(w,d,np.random.default_rng(1000+w*3+d*17+c)); tgt=true(ws,n=160000 if w<=64 else 90000,seed=2000+c)[-1]
   for lam in vals:
    p=est(ws,n,seed=3000+c,lam=lam)[-1]; vals[lam].append(((p-tgt)**2).mean())
   for lam in valsd:
    p=est(ws,n,seed=4000+c,lam=lam,blend_deeper=True)[-1]; valsd[lam].append(((p-tgt)**2).mean())
  base=np.mean(vals[0])
  for lam in vals: print('l2',lam,'%.3g'%np.mean(vals[lam]),'rel %.3f'%(np.mean(vals[lam])/base))
  for lam in valsd: print('deep',lam,'%.3g'%np.mean(valsd[lam]),'rel %.3f'%(np.mean(valsd[lam])/base))
run([(32,8,256),(32,16,256),(64,8,512),(64,16,512),(128,8,512),(128,16,512)])

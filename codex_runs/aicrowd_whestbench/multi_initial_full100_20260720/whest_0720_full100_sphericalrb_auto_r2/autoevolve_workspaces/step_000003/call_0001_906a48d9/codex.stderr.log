   p=est(ws,n,seed=900+c,alpha=a); vals[a].append(((p-tgt)**2).mean())
 base=np.mean(vals[0])
 for a in vals: print(a,'%.3g'%np.mean(vals[a]),'rel %.3f'%(np.mean(vals[a])/base))

codex
One more structural optimization is worth exploring: precompute the QMC direction set and whitening once in `setup`, then reuse it for every MLP. It changes the randomization source to setup time and can lower per-MLP FLOPs substantially if accuracy holds. I’m testing the accuracy tradeoff locally first.
exec
/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy import stats
TAIL=1e-11; MOD=104729

def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def weights(w,d,r): return [(r.standard_normal((w,w))*math.sqrt(2/w)).astype(float) for _ in range(d)]
def true(ws,n=120000,seed=0,b=12000):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; done=0; s=np.zeros(w)
 while done<n:
  m=min(b,n-done); done+=m; x=r.standard_normal((m,w))
  for W in ws: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
def make_dirs(w,h,seed):
 r=np.random.default_rng(seed); g=np.array([pow(11,i,MOD)/MOD for i in range(w)]); u=(np.arange(h)[:,None]*g[None,:]+r.random(w)[None,:])%1; z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); hd=z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
 M=hd.T@hd*(w/h); ev,U=np.linalg.eigh(M); Wh=(U/np.sqrt(np.maximum(ev,1e-8)))@U.T
 return hd,Wh
def est(ws,n,seed=0,pre=None):
 w=ws[0].shape[0]; h=n//2
 hd,Wh=pre if pre is not None else make_dirs(w,h,seed)
 a=np.concatenate([hd,-hd])*mean_chi(w); W0=Wh@ws[0]
 a=np.maximum(a@W0,0); m1=np.sqrt((ws[0]*ws[0]).sum(0))/math.sqrt(2*math.pi); a*= (m1/np.maximum(a.mean(0),1e-12))[None,:]
 for W in ws[1:]: a=np.maximum(a@W,0)
 return a.mean(0)
for w,d,n in [(32,8,256),(32,16,256),(64,8,512),(64,16,512),(128,8,512),(128,16,512),(128,8,1024)]:
 print('---',w,d,n); vals={'per':[],'fixed0':[],'fixed1':[],'fixed2':[]}
 pres={k:make_dirs(w,n//2,10000+k) for k in [0,1,2]}
 for c in range(8):
  ws=weights(w,d,np.random.default_rng(500+w*7+d*23+c)); tgt=true(ws,n=150000 if w<=64 else 90000,seed=900+c)
  vals['per'].append(((est(ws,n,seed=1200+c)-tgt)**2).mean())
  for k in [0,1,2]: vals['fixed'+str(k)].append(((est(ws,n,pre=pres[k])-tgt)**2).mean())
 base=np.mean(vals['per'])
 for name in vals: print(name,'%.3g'%np.mean(vals[name]),'rel %.3f'%(np.mean(vals[name])/base))

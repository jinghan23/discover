import math, time
import numpy as np
from scipy.stats import norm

TAIL=1e-11
MOD=104729
MULT=11

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def gen_weights(w,d,seed):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def lattice_gen(w,mult=MULT,mod=MOD):
    return np.array([pow(mult,i,mod)/mod for i in range(w)], dtype=np.float64)

def dirs(n,w,seed,mult=MULT,whiten=True):
    rng=np.random.default_rng(seed)
    g=lattice_gen(w,mult)
    half=n//2
    shift=rng.random(w)
    idx=np.arange(half,dtype=np.float64)[:,None]
    u=idx*g[None,:]+shift[None,:]
    u=u-np.floor(u)
    z=norm.ppf(np.clip(u,TAIL,1-TAIL))
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    hd=z/r[:,None]
    if whiten:
        M=hd.T@hd*(w/half)
        ev,Q=np.linalg.eigh(M)
        T=(Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
    else:
        T=np.eye(w)
    d2=np.concatenate([hd,-hd],axis=0)
    return d2,T

def qmc(weights,n,seed=0,mult=MULT,scale_first=True,whiten=True,dtype=np.float64):
    w=weights[0].shape[0]
    D,T=dirs(n,w,seed,mult,whiten)
    D=D.astype(dtype, copy=False)
    T=T.astype(dtype, copy=False)
    act=D*mean_chi(w)
    rows=[]
    W0=(T@weights[0]).astype(dtype,copy=False)
    act=np.maximum(act@W0,0)
    first=exact_first(weights[0]).astype(dtype)
    if scale_first:
        sm=np.maximum(act.mean(axis=0),1e-12)
        act=act*(first/sm)[None,:]
    rows.append(first)
    for W in weights[1:]:
        act=np.maximum(act@W.astype(dtype,copy=False),0)
        rows.append(act.mean(axis=0))
    return np.stack(rows)

def mc_ref(weights,N,seed=123,chunk=8192):
    w=weights[0].shape[0]; d=len(weights)
    rng=np.random.default_rng(seed)
    sums=np.zeros((d,w),dtype=np.float64)
    done=0
    while done<N:
        n=min(chunk,N-done)
        x=rng.standard_normal((n,w)).astype(np.float32)
        for li,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[li]+=x.sum(axis=0)
        done+=n
    return sums/N

w=128; d=24; n_ref=262144
for mlp_seed in [1,2,3]:
    weights=gen_weights(w,d,mlp_seed)
    t=time.time(); ref=mc_ref(weights,n_ref,seed=900+mlp_seed); print('ref time',time.time()-t)
    for n in [2048,4096,8192,12288,16384]:
        pred=qmc(weights,n,seed=1000+mlp_seed,scale_first=True,whiten=True)
        mse=((pred[-1]-ref[-1])**2).mean()

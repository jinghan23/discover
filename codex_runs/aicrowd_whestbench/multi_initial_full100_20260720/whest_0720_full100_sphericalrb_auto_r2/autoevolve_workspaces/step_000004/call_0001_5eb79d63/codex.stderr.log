import math, time
import numpy as np
from scipy.stats import norm
TAIL=1e-11; MOD=104729; MULT=11

def mean_chi(d):
    h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def gen_weights(w,d,seed):
    rng=np.random.default_rng(seed); scale=math.sqrt(2/w)
    return [(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]
def exact_first(W): return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)
def lattice_gen(w,mult=MULT,mod=MOD): return np.array([pow(mult,i,mod)/mod for i in range(w)], dtype=np.float64)
def dirs(n,w,seed,mult=MULT):
    rng=np.random.default_rng(seed); g=lattice_gen(w,mult); half=n//2; shift=rng.random(w)
    u=np.arange(half,dtype=np.float64)[:,None]*g[None,:]+shift[None,:]; u-=np.floor(u)
    z=norm.ppf(np.clip(u,TAIL,1-TAIL)); r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24)); hd=z/r[:,None]
    M=hd.T@hd*(w/half); ev,Q=np.linalg.eigh(M); T=(Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
    return np.concatenate([hd,-hd]),T
def qmc(weights,n,seed=0,orient='none'):
    w=weights[0].shape[0]; D,T=dirs(n,w,seed); act=D*mean_chi(w); W0=weights[0].astype(np.float64)
    if orient=='qr':
        q,r=np.linalg.qr(W0); W0=q.T@W0
    elif orient=='svd':
        u,s,vt=np.linalg.svd(W0,full_matrices=True); W0=u.T@W0
    elif orient=='signperm':
        rng=np.random.default_rng(seed+99991); perm=rng.permutation(w); signs=np.where(rng.random(w)<0.5,-1.0,1.0)
        W0=signs[:,None]*W0[perm,:]
    W0=T@W0
    act=np.maximum(act@W0,0)
    first=exact_first(weights[0]).astype(np.float64)
    act=act*(first/np.maximum(act.mean(0),1e-12))[None,:]
    for W in weights[1:]: act=np.maximum(act@W,0)
    return act.mean(0)
def mc_ref(weights,N,seed=123,chunk=8192):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
    while done<N:
        n=min(chunk,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=n
    return s/N

import math, time
from types import SimpleNamespace
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))

def angular_truth(mlp,n,seed,chunk=65536):
 rng=fnp.random.default_rng(seed); w=mlp.width; sums=[fnp.zeros(w,dtype=fnp.float64) for _ in range(mlp.depth)]; done=0; sc=fnp.float32(mean_chi(w))
 while done<n:
  h=min(chunk//2,(n-done)//2)
  z=fnp.asarray(rng.standard_normal((h,w),dtype=fnp.float32),dtype=fnp.float32); r=fnp.sqrt(fnp.maximum(fnp.sum(z*z,axis=1),1e-24)); d=z/r[:,None]
  x=fnp.concatenate((d,-d),axis=0)*sc
  for li,wt in enumerate(mlp.weights): x=fnp.maximum(x@wt,fnp.float32(0.0)); sums[li]=sums[li]+fnp.sum(fnp.asarray(x,dtype=fnp.float64),axis=0)
  done+=2*h
 return fnp.asarray(fnp.stack(sums)/done,dtype=fnp.float32)

def run_setting(width,depth,budget,n_truth,n_mlps,settings):
 mlps=[];truths=[]
 for i in range(n_mlps):
  base=width*100000+depth*1000+i
  mlp=sample_mlp(width,depth,fnp.random.default_rng(base),seed=base+100); truths.append(angular_truth(mlp,n_truth,base+200)); mlps.append(mlp)
 orig=(submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION)
 out=[]
 for frac,add,extra,mult in settings:
  submission._TARGET_FLOP_FRACTION=frac; submission._FIRST_MEAN_ADDITIVE=add; submission._FINAL_NESTED_EXTRAPOLATION=extra; submission._KOROBOV_MULTIPLIER=mult
  errs=[]
  for mlp,truth in zip(mlps,truths):
   est=submission.Estimator(); est.setup(SimpleNamespace(width=width,depth=depth,flop_budget=budget,seed=1,api_version=''))

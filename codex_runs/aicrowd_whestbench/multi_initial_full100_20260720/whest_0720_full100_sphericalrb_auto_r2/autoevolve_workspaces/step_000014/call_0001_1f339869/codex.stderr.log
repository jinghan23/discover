import math
from types import SimpleNamespace
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def mean_chi(d):
 h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))

def lattice_multi(n,width,rng,generator,shifts):
    per=n//shifts
    rem=n-per*shifts
    parts=[]
    for s in range(shifts):
        m=per+(1 if s<rem else 0)
        shift=rng.random(width)
        idx=fnp.arange(m,dtype=fnp.float64)[:,None]
        u=idx*generator[None,:]+shift[None,:]
        u=u-fnp.floor(u); u=fnp.clip(u,submission._TAIL_CLIP,1.0-submission._TAIL_CLIP)
        z=flops.stats.norm.ppf(u)
        r=fnp.sqrt(fnp.maximum(fnp.sum(z*z,axis=1),1e-24))
        parts.append(z/r[:,None])
    return fnp.concatenate(parts,axis=0)

def angular_truth(mlp,n,seed,chunk=65536):
 rng=fnp.random.default_rng(seed); w=mlp.width; sums=[fnp.zeros(w,dtype=fnp.float64) for _ in range(mlp.depth)]; done=0; sc=fnp.float32(mean_chi(w))

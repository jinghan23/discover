A lower-risk correction is at the last layer: estimate the final preactivation mean and variance from the probes, then blend the sampled ReLU mean with the Gaussian ReLU moment. This keeps the sampled nonlinear path but reduces threshold noise when the final preactivation is close to Gaussian.
exec
/bin/bash -lc "python - <<'PY'
import math, time
from types import SimpleNamespace
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2.0)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def angular_truth(mlp, n_samples, seed, chunk=65536):
    width=mlp.width; depth=mlp.depth
    rng=fnp.random.default_rng(seed)
    sums=[fnp.zeros(width,dtype=fnp.float64) for _ in range(depth)]
    done=0; scale=fnp.float32(mean_chi(width)); half_chunk=chunk//2
    while done<n_samples:
        n=min(half_chunk*2, n_samples-done); h=n//2
        z=fnp.asarray(rng.standard_normal((h,width), dtype=fnp.float32), dtype=fnp.float32)
        r=fnp.sqrt(fnp.maximum(fnp.sum(z*z,axis=1), 1e-24))
        d=z/r[:,None]
        x=fnp.concatenate((d,-d),axis=0)*scale
        for li,w in enumerate(mlp.weights):
            x=fnp.maximum(x@w, fnp.float32(0.0))
            sums[li]=sums[li]+fnp.sum(fnp.asarray(x,dtype=fnp.float64),axis=0)
        done += 2*h
    return fnp.asarray(fnp.stack(sums)/done,dtype=fnp.float32)

def predict_final_gauss(mlp,budget,frac=0.13,add=0.91,extra=-0.065,blend=0.0):
    old=(submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION)
    submission._TARGET_FLOP_FRACTION=frac
    n_samples=submission._sample_count(budget,mlp.width,mlp.depth); half=n_samples//2
    gen=submission._lattice_generator(mlp.width); rng=fnp.random.default_rng(int(mlp.seed))
    hd=fnp.asarray(submission._qmc_directions(half,mlp.width,rng,gen),dtype=fnp.float32)
    wh=fnp.asarray(submission._angular_whitening_transform(hd),dtype=fnp.float32)
    fw=fnp.asarray(wh@mlp.weights[0],dtype=fnp.float32)
    x=fnp.concatenate((hd,-hd),axis=0)*fnp.float32(mean_chi(mlp.width))
    rows=[]
    x=fnp.maximum(x@fw,fnp.float32(0.0))
    fm=submission._exact_first_layer_mean(mlp.weights[0])
    sm=fnp.maximum(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),1e-12)
    x=fnp.asarray(x+(add*(fm-sm))[None,:],dtype=fnp.float32)
    rows.append(fm)
    final=mlp.depth-1
    for li,w in enumerate(mlp.weights[1:],start=1):
        pre=x@w
        x=fnp.maximum(pre,fnp.float32(0.0))
        lm=fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0)
        if li==final:
            if blend"'!=0.0:
                pre64=fnp.asarray(pre,dtype=fnp.float64)
                mu=fnp.mean(pre64,axis=0)
                var=fnp.maximum(fnp.mean(pre64*pre64,axis=0)-mu*mu,1e-12)
                sig=fnp.sqrt(var)
                a=mu/sig
                gm=mu*flops.stats.norm.cdf(a)+sig*flops.stats.norm.pdf(a)
                lm=(1.0-blend)*lm+blend*gm
            if extra!=0.0 and half>=2:
                q=half//2
                nested=0.5*(fnp.mean(fnp.asarray(x[:q],dtype=fnp.float64),axis=0)+fnp.mean(fnp.asarray(x[half:half+q],dtype=fnp.float64),axis=0))
                lm=lm+extra*(lm-nested)
        rows.append(lm)
    submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION=old
    return fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)

width=64; depth=8; budget=1_000_000_000; n_truth=1_048_576; n_mlps=8
mlps=[]; truths=[]
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,fnp.random.default_rng(17000+i),seed=18000+i)
    truths.append(angular_truth(mlp,n_truth,19000+i)); mlps.append(mlp)
print('"'truth ready')

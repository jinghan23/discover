  done+=2*h
 return fnp.asarray(fnp.stack(sums)/done,dtype=fnp.float32)

def pred_multi(mlp,budget,frac,shifts,add=.91,extra=-.065):
 old=submission._TARGET_FLOP_FRACTION; submission._TARGET_FLOP_FRACTION=frac
 n=submission._sample_count(budget,mlp.width,mlp.depth); half=n//2; gen=submission._lattice_generator(mlp.width); rng=fnp.random.default_rng(int(mlp.seed))
 hd=fnp.asarray(lattice_multi(half,mlp.width,rng,gen,shifts),dtype=fnp.float32)
 wh=fnp.asarray(submission._angular_whitening_transform(hd),dtype=fnp.float32); fw=fnp.asarray(wh@mlp.weights[0],dtype=fnp.float32)
 x=fnp.concatenate((hd,-hd),axis=0)*fnp.float32(mean_chi(mlp.width)); x=fnp.maximum(x@fw,fnp.float32(0.0))
 fm=submission._exact_first_layer_mean(mlp.weights[0]); sm=fnp.maximum(fnp.mean(fnp.asarray(x,dtype=fnp.float64),axis=0),1e-12); x=fnp.asarray(x+(add*(fm-sm))[None,:],dtype=fnp.float32)
 rows=[fm]; final=mlp.depth-1
 for li,wt in enumerate(mlp.weights[1:],start=1):
  x=fnp.maximum(x@wt,fnp.float32(0.0)); lm=fnp.mean(x,axis=0)
  if li==final and half>=2:
   q=half//2; nested=0.5*(fnp.mean(x[:q],axis=0)+fnp.mean(x[half:half+q],axis=0)); lm=lm+extra*(lm-nested)
  rows.append(lm)
 submission._TARGET_FLOP_FRACTION=old
 return fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)


   errs.append(float(fnp.mean((fnp.asarray(pred[-1],dtype=fnp.float64)-fnp.asarray(truth[-1],dtype=fnp.float64))**2)))
  out.append(((frac,add,extra,mult),sum(errs)/len(errs),est._sample_count(budget,width,depth)))
 submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION,submission._KOROBOV_MULTIPLIER=orig
 print('CASE',width,depth,'truth',n_truth)
 for row in out: print(row)

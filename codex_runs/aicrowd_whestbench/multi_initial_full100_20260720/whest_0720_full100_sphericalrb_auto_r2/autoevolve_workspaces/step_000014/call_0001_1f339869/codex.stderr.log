from types import SimpleNamespace
import math, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
import submission

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2.0)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def angular_truth(mlp, n_samples, seed, chunk=65536):
    width=mlp.width; depth=mlp.depth
    rng=fnp.random.default_rng(seed)
    sums=[fnp.zeros(width,dtype=fnp.float64) for _ in range(depth)]
    done=0; scale=fnp.float32(mean_chi(width)); half_chunk=chunk//2
    while done<n_samples:
        n=min(half_chunk*2, n_samples-done); h=n//2
        z=fnp.asarray(rng.standard_normal((h,width), dtype=fnp.float32), dtype=fnp.float32)
        r=fnp.sqrt(fnp.maximum(fnp.sum(z*z,axis=1), 1e-24))
        d=z/r[:,None]
        x=fnp.concatenate((d,-d),axis=0)*scale
        for li,w in enumerate(mlp.weights):
            x=fnp.maximum(x@w, fnp.float32(0.0))
            sums[li]=sums[li]+fnp.sum(fnp.asarray(x,dtype=fnp.float64),axis=0)
        done += 2*h
    return fnp.asarray(fnp.stack(sums)/done,dtype=fnp.float32)

def predict_cv(mlp,budget,frac=0.13,add=0.0,extra=0.0,cv=1.0,ridge=1e-5):
    old=(submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION)
    submission._TARGET_FLOP_FRACTION=frac
    n_samples=submission._sample_count(budget,mlp.width,mlp.depth)
    half_samples=n_samples//2
    gen=submission._lattice_generator(mlp.width)
    rng=fnp.random.default_rng(int(mlp.seed))
    half_dirs=submission._qmc_directions(half_samples,mlp.width,rng,gen)
    half_dirs=fnp.asarray(half_dirs,dtype=fnp.float32)
    whitening=fnp.asarray(submission._angular_whitening_transform(half_dirs),dtype=fnp.float32)
    first_weight=fnp.asarray(whitening@mlp.weights[0],dtype=fnp.float32)
    dirs=fnp.concatenate((half_dirs,-half_dirs),axis=0)
    acts=dirs*fnp.float32(mean_chi(mlp.width))
    rows=[]
    acts=fnp.maximum(acts@first_weight,fnp.float32(0.0))
    first_acts=fnp.asarray(acts,dtype=fnp.float32)
    first_mean=submission._exact_first_layer_mean(mlp.weights[0])
    sample_first_mean=fnp.mean(fnp.asarray(first_acts,dtype=fnp.float64),axis=0)
    if add"'!=0.0:
        acts=fnp.asarray(first_acts+(add*(first_mean-sample_first_mean))[None,:],dtype=fnp.float32)
    rows.append(first_mean)
    final_index=mlp.depth-1
    for li,w in enumerate(mlp.weights[1:],start=1):
        acts=fnp.maximum(acts@w,fnp.float32(0.0))
        layer_mean=fnp.mean(fnp.asarray(acts,dtype=fnp.float64),axis=0)
        if li==final_index and extra!=0.0 and half_samples>=2:
            q=half_samples//2
            nested=0.5*(fnp.mean(fnp.asarray(acts[:q],dtype=fnp.float64),axis=0)+fnp.mean(fnp.asarray(acts[half_samples:half_samples+q],dtype=fnp.float64),axis=0))
            layer_mean=layer_mean+extra*(layer_mean-nested)
        rows.append(layer_mean)
    if cv!=0.0 and mlp.depth>1:
        y=fnp.asarray(acts,dtype=fnp.float64)
        x=fnp.asarray(first_acts,dtype=fnp.float64)
        xm=fnp.mean(x,axis=0)
        ym=fnp.mean(y,axis=0)
        xc=x-xm[None,:]
        yc=y-ym[None,:]
        cxx=(xc.T@xc)/float(n_samples)
        # ridge scaled by average diagonal
        diagmean=fnp.mean(fnp.diag(cxx))
        cxx=cxx+fnp.eye(mlp.width,dtype=fnp.float64)*(ridge*diagmean+1e-12)
        cxy=(xc.T@yc)/float(n_samples)
        beta=fnp.linalg.solve(cxx,cxy)
        corr=(fnp.asarray(first_mean,dtype=fnp.float64)-xm)@beta
        rows[-1]=fnp.asarray(fnp.asarray(rows[-1],dtype=fnp.float64)+cv*corr,dtype=fnp.float64)
    submission._TARGET_FLOP_FRACTION,submission._FIRST_MEAN_ADDITIVE,submission._FINAL_NESTED_EXTRAPOLATION=old
    return fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)


import math, numpy as np
from scipy.stats import norm

def relu_mean(m,v):
    s=np.sqrt(np.maximum(v,1e-30)); a=m/s; return s*norm.pdf(a)+m*norm.cdf(a)
def full_zero_cov_est(weights):
    W0=weights[0]; G=W0.T@W0; q=np.maximum(np.diag(G),1e-30); s=np.sqrt(q); mu=s/math.sqrt(2*math.pi)

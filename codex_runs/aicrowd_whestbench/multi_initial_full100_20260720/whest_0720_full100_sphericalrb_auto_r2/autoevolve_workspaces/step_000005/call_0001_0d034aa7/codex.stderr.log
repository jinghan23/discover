import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def exact(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng):
    g=gen(w); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]; u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def relu_mom(m,v):
    s=np.sqrt(np.maximum(v,1e-30)); a=m/s; Phi=norm.cdf(a); phi=norm.pdf(a); mu=s*phi+m*Phi; second=(v+m*m)*Phi+m*s*phi; return mu,np.maximum(second-mu*mu,1e-30)
def est(weights,n=512,p=.8,q=0,seed=1):
    w=weights[0].shape[0]; hd=dirs(n//2,w,np.random.default_rng(seed)); W0=whiten(hd)@weights[0]; a=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(a@W0,0); mu=exact(weights[0]); s2=(weights[0]*weights[0]).sum(0); var=s2*0.5-mu*mu; a*=((mu/np.maximum(a.mean(0),1e-12))**p)[None,:]
    for W in weights[1:]:
        pred_m=mu@W; pred_v=var@(W*W); mu,var=relu_mom(pred_m,pred_v)
        a=np.maximum(a@W,0)
        if q"'!=0:
            sm=np.maximum(a.mean(0),1e-12)
            a*=((np.maximum(mu,1e-12)/sm)**q)[None,:]
    return a.mean(0)
def target(weights,n,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); z=rng.standard_normal((n,w)); a=z/np.linalg.norm(z,axis=1)[:,None]*mean_chi(w)
    for W in weights: a=np.maximum(a@W,0)
    return a.mean(0)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
qs=[-0.2,-0.1,-0.05,0,0.03,0.05,0.1,0.2]
for case in [(48,8,384,70000,8),(64,8,512,70000,5),(96,10,512,50000,3)]:
    w,d,n,nt,rep=case; rng=np.random.default_rng(999+w); acc={q:[] for q in qs}
    for r in range(rep):
        weights=make(w,d,rng); t=target(weights,nt,3000+r)
        for q in qs:
            e=est(weights,n,q=q,seed=4000+r); acc[q].append(np.mean((e-t)**2))
    vals={q:float(np.mean(v)) for q,v in acc.items()}; base=vals[0]; print('"'case',case[:3], 'best',min(vals,key=vals.get), vals[min(vals,key=vals.get)], {q:round(vals[q]/base,3) for q in qs})

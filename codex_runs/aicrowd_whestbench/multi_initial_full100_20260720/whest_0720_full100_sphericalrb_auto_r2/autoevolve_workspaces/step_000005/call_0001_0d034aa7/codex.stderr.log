/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy.special import ndtri
from scipy.stats import norm
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def exact(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng):
    g=gen(w); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]; u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def relu_gauss(m,v):
    s=np.sqrt(np.maximum(v,1e-30)); a=m/s; return s*norm.pdf(a)+m*norm.cdf(a)
def est(weights,n=512,p=.8,blend=1.0,seed=1):
    w=weights[0].shape[0]; hd=dirs(n//2,w,np.random.default_rng(seed)); a=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(a@(whiten(hd)@weights[0]),0); fm=exact(weights[0]); a*=((fm/np.maximum(a.mean(0),1e-12))**p)[None,:]
    for W in weights[1:-1]: a=np.maximum(a@W,0)
    pre=a@weights[-1]; raw=np.maximum(pre,0).mean(0); m=pre.mean(0); v=np.maximum((pre*pre).mean(0)-m*m,1e-30); gm=relu_gauss(m,v)
    return blend*raw+(1-blend)*gm
def target(weights,n,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); z=rng.standard_normal((n,w)); a=z/np.linalg.norm(z,axis=1)[:,None]*mean_chi(w)
    for W in weights: a=np.maximum(a@W,0)
    return a.mean(0)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
blends=[-0.5,0,0.25,0.5,0.75,0.9,1.0,1.1,1.25,1.5]
for case in [(32,6,256,100000,8),(48,8,384,70000,8),(64,8,512,70000,5),(96,10,512,50000,3)]:
    w,d,n,nt,rep=case; rng=np.random.default_rng(121+w); acc={b:[] for b in blends}
    for r in range(rep):
        weights=make(w,d,rng); t=target(weights,nt,7000+r)
        for b in blends:
            e=est(weights,n,blend=b,seed=8000+r); acc[b].append(np.mean((e-t)**2))
    vals={b:float(np.mean(v)) for b,v in acc.items()}; base=vals[1.0]; print('case',case[:3], 'best',min(vals,key=vals.get), vals[min(vals,key=vals.get)], {b:round(vals[b]/base,3) for b in blends})

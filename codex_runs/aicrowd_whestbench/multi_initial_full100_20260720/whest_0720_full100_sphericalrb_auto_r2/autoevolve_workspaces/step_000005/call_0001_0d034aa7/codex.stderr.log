import math, numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def gen(w,k=11): return np.array([pow(k,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng,k=11):
    g=gen(w,k); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]
    u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u)
    return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def qmc(weights,n=512,p=.75,seed=7,cv=False,ridge=1e-8,cv_on_raw=True):
    w=weights[0].shape[0]; h=n//2; rng=np.random.default_rng(seed); hd=dirs(h,w,rng); wh=whiten(hd); a=np.concatenate([hd,-hd])*mean_chi(w)
    a=np.maximum(a@(wh@weights[0]),0); H_raw=a.copy(); fm=exact_first(weights[0]); sampleH=H_raw.mean(0)
    if p"'!=0:

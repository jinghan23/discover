import math, numpy as np
from scipy.stats import norm

def first_moments(W):
    G=W.T@W; q=np.maximum(np.diag(G),1e-30); s=np.sqrt(q); mu=s/math.sqrt(2*math.pi)
    rho=G/np.maximum(s[:,None]*s[None,:],1e-30); rho=np.clip(rho,-1,1)
    second=(s[:,None]*s[None,:])/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)
    cov=second-mu[:,None]*mu[None,:]
    return mu,cov
def relu_mean_second(m,v):
    s=np.sqrt(np.maximum(v,1e-30)); a=m/s; Phi=norm.cdf(a); phi=norm.pdf(a); mu=s*phi+m*Phi; second=(v+m*m)*Phi+m*s*phi; return mu,second
def bivar_second_gh(m,S,nodes,weights):
    w=len(m); v=np.maximum(np.diag(S),1e-30); s=np.sqrt(v); rho=S/np.maximum(s[:,None]*s[None,:],1e-30); rho=np.clip(rho,-0.999999,0.999999); c=np.sqrt(np.maximum(1-rho*rho,1e-12)); out=np.zeros((w,w))
    sj=s[None,:]; mj=m[None,:]
    for t,wt in zip(nodes,weights):
        xpos=np.maximum(m+s*t,0)[:,None]
        cm=mj + sj*rho*t
        cs=sj*c
        a=cm/np.maximum(cs,1e-30)
        yplus=cs*norm.pdf(a)+cm*norm.cdf(a)
        out += wt*xpos*yplus
    return 0.5*(out+out.T)
def full_gh_est(weights,k=9,jitter=1e-10):
    x,w=np.polynomial.hermite.hermgauss(k); nodes=x*math.sqrt(2); weights_gh=w/math.sqrt(math.pi)
    mu,cov=first_moments(weights[0]); rows=[mu.copy()]
    for W in weights[1:]:
        m=mu@W; S=W.T@cov@W; v=np.maximum(np.diag(S),1e-30); new_mu,diag_second=relu_mean_second(m,v); second=bivar_second_gh(m,S,nodes,weights_gh); second[np.diag_indices_from(second)]=diag_second; cov=second-new_mu[:,None]*new_mu[None,:]
        cov=0.5*(cov+cov.T); cov[np.diag_indices_from(cov)]=np.maximum(np.diag(cov),jitter)
        mu=new_mu; rows.append(mu.copy())
    return np.stack(rows)
def target(weights,n=100000,seed=123):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); a=rng.standard_normal((n,w)); rows=[]
    for W in weights: a=np.maximum(a@W,0); rows.append(a.mean(0))
    return np.stack(rows)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
for k in [5,7,9,13,17]:
    print('k',k)
    for case in [(32,6,200000,8),(64,8,100000,5),(96,10,70000,3)]:
        w,d,nt,rep=case; rng=np.random.default_rng(733+w); acc=[]
        for r in range(rep):
            weights=make(w,d,rng); t=target(weights,nt,100+r); e=full_gh_est(weights,k=k); acc.append(np.mean((e[-1]-t[-1])**2))
        print(case[:2], np.mean(acc))

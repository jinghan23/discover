    for W in weights[1:]: a=np.maximum(a@W,0); rows.append(a.mean(0))
    out=np.stack(rows)
    if cv:
        H=H_raw if cv_on_raw else (H_raw*((fm/np.maximum(sampleH,1e-12))**p)[None,:])
        Hm=H.mean(0); Hc=H-Hm
        F=a
        Fc=F-F.mean(0)
        C=(Hc.T@Hc)/n
        tr=np.trace(C)/w
        C.flat[::w+1]+=ridge*max(float(tr),1e-12)

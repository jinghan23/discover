# Local compare whitening vs no whitening at same and increased sample counts.
import math, numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def exact(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng):
    g=gen(w); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]; u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def est(weights,n,white=True,p=.8,seed=1):
    w=weights[0].shape[0]; hd=dirs(n//2,w,np.random.default_rng(seed)); W0=(whiten(hd)@weights[0]) if white else weights[0]; a=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(a@W0,0); fm=exact(weights[0]); a*=((fm/np.maximum(a.mean(0),1e-12))**p)[None,:]
    for W in weights[1:]: a=np.maximum(a@W,0)
    return a.mean(0)
def target(weights,n,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); z=rng.standard_normal((n,w)); a=z/np.linalg.norm(z,axis=1)[:,None]*mean_chi(w)
    for W in weights: a=np.maximum(a@W,0)
    return a.mean(0)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
for case in [(48,8,384,70000,8),(64,8,512,70000,5),(96,10,512,50000,3)]:
    w,d,n,nt,rep=case; rng=np.random.default_rng(555+w); acc={'white':[],'nowhite':[],'nowhite1.3':[],'nowhite1.6':[]}
    for r in range(rep):
        weights=make(w,d,rng); t=target(weights,nt,800+r)
        acc['white'].append(np.mean((est(weights,n,True,seed=100+r)-t)**2))
        acc['nowhite'].append(np.mean((est(weights,n,False,seed=100+r)-t)**2))
        acc['nowhite1.3'].append(np.mean((est(weights,int(n*1.3)//2*2,False,seed=100+r)-t)**2))
        acc['nowhite1.6'].append(np.mean((est(weights,int(n*1.6)//2*2,False,seed=100+r)-t)**2))
    vals={k:float(np.mean(v)) for k,v in acc.items()}; base=vals['white']; print('case',case[:3], vals, {k:round(v/base,3) for k,v in vals.items()})

import math, numpy as np
from scipy.special import ndtri

TAIL=1e-11
K=11
MOD=104729
FLOOR=1e-8

def mean_chi(d):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*d+0.5)-math.lgamma(0.5*d))

def gen(width,k=11):
    return np.array([pow(k,i,MOD)/MOD for i in range(width)],float)

def lattice_normals(n,w,rng,g):
    shift=rng.random(w)
    idx=np.arange(n,dtype=float)[:,None]
    u=(idx*g[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    return ndtri(u)

def qmc_dirs(n,w,rng,g):
    z=lattice_normals(n,w,rng,g)
    return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]

def whiten(dirs):
    n,w=dirs.shape
    sm=(dirs.T@dirs)*(w/n)
    vals,vecs=np.linalg.eigh(sm)
    vals=np.maximum(vals,FLOOR)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def estimate(weights,n,p,k=11,seed=0,do_whiten=True):
    w=weights[0].shape[0]
    half=n//2
    rng=np.random.default_rng(seed)
    d=qmc_dirs(half,w,rng,gen(w,k))
    if do_whiten:
        first=whiten(d)@weights[0]
    else:
        first=weights[0]
    dirs=np.concatenate([d,-d],axis=0)
    a=dirs*mean_chi(w)
    rows=[]
    a=np.maximum(a@first,0)
    fm=exact_first(weights[0])
    sm=np.maximum(a.mean(0),1e-12)
    a*= (fm/sm)[None,:]**p
    rows.append(fm)
    for W in weights[1:]:
        a=np.maximum(a@W,0)
        rows.append(a.mean(0))
    return np.stack(rows)

def target(weights,n,seed=12345):
    w=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    # pseudorandom sphere large; enough for relative screen
    z=rng.standard_normal((n,w))
    dirs=z/np.linalg.norm(z,axis=1)[:,None]
    a=dirs*mean_chi(w)
    rows=[]
    for W in weights:
        a=np.maximum(a@W,0)
        rows.append(a.mean(0))
    return np.stack(rows)

def make_weights(w,d,rng,kind):
    if kind=='gauss1':
        return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
    if kind=='he':
        return [rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
    if kind=='colunit':
        out=[]
        for _ in range(d):
            W=rng.standard_normal((w,w))
            W/=np.linalg.norm(W,axis=0,keepdims=True)
            out.append(W)
        return out
    raise ValueError

ps=[0,0.25,0.5,0.65,0.75,0.85,1.0,1.15]
for kind in ['gauss1','he','colunit']:
    print('KIND', kind)
    for w,d,n,nt,rep in [(32,6,256,80000,8),(64,8,384,50000,5)]:
        rng=np.random.default_rng(900+w+d)
        acc={p:[] for p in ps}
        for r in range(rep):
            weights=make_weights(w,d,rng,kind)
            t=target(weights,nt,seed=1000+r)
            for p in ps:
                e=estimate(weights,n,p,seed=2000+r)
                acc[p].append(np.mean((e[-1]-t[-1])**2))
        vals={p:float(np.mean(acc[p])) for p in ps}
        base=vals[0.75]
        best=min(vals,key=vals.get)
        print('case',w,d,n,'best',best,vals[best],'base',base,'ratios',{p:round(vals[p]/base,3) for p in ps})

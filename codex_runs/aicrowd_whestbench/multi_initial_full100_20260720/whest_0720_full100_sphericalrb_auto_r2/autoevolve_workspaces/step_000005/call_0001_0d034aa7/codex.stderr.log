import math, numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def gen(w,k=11): return np.array([pow(k,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng,k=11):
    g=gen(w,k); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]; u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def exact_first_cov_scaled_sphere(W):
    w=W.shape[0]; G=W.T@W; q=np.maximum(np.diag(G),1e-30); sq=np.sqrt(q); rho=G/np.maximum(sq[:,None]*sq[None,:],1e-30); rho=np.clip(rho,-1,1)
    second=(sq[:,None]*sq[None,:])/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)
    scale=mean_chi(w)**2/w
    second*=scale
    mu=exact_first(W); cov=second-mu[:,None]*mu[None,:]
    return mu,cov
def mat_sqrt(C):
    vals,vecs=np.linalg.eigh((C+C.T)*0.5); vals=np.maximum(vals,1e-10); return (vecs*np.sqrt(vals))@vecs.T, (vecs/np.sqrt(vals))@vecs.T
def qmc(weights,n=512,p=.75,seed=7,mode='scale'):
    w=weights[0].shape[0]; h=n//2; rng=np.random.default_rng(seed); hd=dirs(h,w,rng); wh=whiten(hd); a=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(a@(wh@weights[0]),0); fm=exact_first(weights[0])
    if mode=='scale':
        a*=((fm/np.maximum(a.mean(0),1e-12))**p)[None,:]
    elif mode in ('affine','affineclip'):
        mu,cov=exact_first_cov_scaled_sphere(weights[0]); Hc=a-a.mean(0); Cs=Hc.T@Hc/n; sqrt_e,_=mat_sqrt(cov); _,inv_s=mat_sqrt(Cs); A=inv_s@sqrt_e; a=Hc@A+mu
        if mode=='affineclip': a=np.maximum(a,0)
    elif mode=='none':
        pass
    else: raise ValueError
    for W in weights[1:]: a=np.maximum(a@W,0)
    return a.mean(0)
def target(weights,n=80000,seed=123):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); z=rng.standard_normal((n,w)); a=z/np.linalg.norm(z,axis=1)[:,None]*mean_chi(w)
    for W in weights: a=np.maximum(a@W,0)
    return a.mean(0)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
variants=['scale','none','affine','affineclip']
for case in [(32,6,256,100000,8),(64,8,512,70000,5),(96,10,512,50000,3)]:
    w,d,n,nt,rep=case; rng=np.random.default_rng(222+w); acc={v:[] for v in variants}
    neg=[]
    for r in range(rep):

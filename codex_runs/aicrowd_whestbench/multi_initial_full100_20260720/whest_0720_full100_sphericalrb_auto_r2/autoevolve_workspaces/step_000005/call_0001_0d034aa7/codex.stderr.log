            acc[v].append(np.mean((e-t)**2))
    vals={k:float(np.mean(v)) for k,v in acc.items()}; base=vals['scale']; print('case',case[:3], 'base', base, 'best', min(vals,key=vals.get), vals[min(vals,key=vals.get)])
    print({k:round(vals[k]/base,3) for k,v in vals.items()})

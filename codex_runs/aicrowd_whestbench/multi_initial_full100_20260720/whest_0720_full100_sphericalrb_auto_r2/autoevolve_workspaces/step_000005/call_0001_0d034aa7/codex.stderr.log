/bin/bash -lc "python - <<'PY'
import math, numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; FLOOR=1e-8

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(.5*d+.5)-math.lgamma(.5*d))
def exact(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)],float)
def dirs(n,w,rng):
    g=gen(w); sh=rng.random(w); idx=np.arange(n,dtype=float)[:,None]; u=(idx*g[None,:]+sh[None,:])%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.maximum(np.linalg.norm(z,axis=1),1e-24)[:,None]
def whiten(d):
    n,w=d.shape; sm=d.T@d*(w/n); vals,vecs=np.linalg.eigh(sm); vals=np.maximum(vals,FLOOR); return (vecs/np.sqrt(vals))@vecs.T
def final_acts(weights,n=512,p=.73,seed=1):
    w=weights[0].shape[0]; h=n//2; hd=dirs(h,w,np.random.default_rng(seed)); a=np.concatenate([hd,-hd])*mean_chi(w); a=np.maximum(a@(whiten(hd)@weights[0]),0); fm=exact(weights[0]); a*=((fm/np.maximum(a.mean(0),1e-12))**p)[None,:]
    for W in weights[1:]: a=np.maximum(a@W,0)
    return a,h
def subset_mean(F,h,mode):
    q=h//2
    if mode=='prefix': idx=np.r_[0:q, h:h+q]
    elif mode=='suffix': idx=np.r_[q:h, h+q:2*h]
    elif mode=='even': idx=np.r_[np.arange(0,h,2), h+np.arange(0,h,2)]
    elif mode=='odd': idx=np.r_[np.arange(1,h,2), h+np.arange(1,h,2)]
    elif mode=='middle':
        s=(h-q)//2; idx=np.r_[s:s+q, h+s:h+s+q]
    return F[idx].mean(0)
def target(weights,n,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); z=rng.standard_normal((n,w)); a=z/np.linalg.norm(z,axis=1)[:,None]*mean_chi(w)
    for W in weights: a=np.maximum(a@W,0)
    return a.mean(0)
def make(w,d,rng): return [rng.standard_normal((w,w))/math.sqrt(w) for _ in range(d)]
modes=['prefix','suffix','even','odd','middle']; betas=[-0.1,-0.07,-0.04,0,0.04,0.07,0.1]
for case in [(48,8,384,70000,5),(64,8,512,70000,4),(96,10,512,50000,3)]:
    w,d,n,nt,rep=case; rng=np.random.default_rng(177+w); vals={(m,b):[] for m in modes for b in betas}
    for r in range(rep):
        weights=make(w,d,rng); t=target(weights,nt,12000+r); F,h=final_acts(weights,n,seed=13000+r); full=F.mean(0)
        subs={m:subset_mean(F,h,m) for m in modes}
        for m in modes:
          for b in betas:
            e=full+b*(full-subs[m]); vals[(m,b)].append(np.mean((e-t)**2))
    meanvals={k:float(np.mean(v)) for k,v in vals.items()}; base=meanvals[('prefix',-0.07)]; best=min(meanvals,key=meanvals.get)
    print('case',case[:3],'best',best,meanvals[best],'prefix-07',base,'ratios best/base',meanvals[best]/base)
    print('odd ratios',{b:round(meanvals[('odd',b)]/base,3) for b in betas})
    print('prefix ratios',{b:round(meanvals[('prefix',b)]/base,3) for b in betas})

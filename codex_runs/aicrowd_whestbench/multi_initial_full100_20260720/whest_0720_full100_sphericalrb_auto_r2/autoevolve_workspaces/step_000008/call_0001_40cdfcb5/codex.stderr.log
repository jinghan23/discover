sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def make_targets(w=64,d=8,n_mlps=8,n_samples=200000):
    root=fnp.random.SeedSequence(20260721).spawn(3*n_mlps)
    data=[]
    t=time.time()
    for i in range(n_mlps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(root[3*i]),seed=int(root[3*i+2].generate_state(1)[0]))
        target, final, _=sample_layer_statistics(mlp,n_samples,rng=fnp.random.default_rng(root[3*i+1]))
        data.append((mlp,target,final))
        print('target',i+1,'done',time.time()-t, flush=True)
    return data

def score(data,budget,params):
    for k,v in params.items(): setattr(sub,k,v)
    scores=[]; mses=[]; fracs=[]
    for mlp,target,final in data:
        est=sub.Estimator()
        class C: pass
        c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=budget; c.seed=777; c.api_version='x'
        est.setup(c)
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((pred[-1]-final)**2))
        frac=(ctx.flops_used + 1e11*float(ctx.residual_wall_time_s or 0.0))/budget
        mses.append(mse); fracs.append(frac); scores.append(mse*max(0.1,frac))
    return float(fnp.mean(fnp.asarray(scores))), float(fnp.mean(fnp.asarray(mses))), float(fnp.mean(fnp.asarray(fracs)))

data=make_targets()
budget=int(1e9)
base={'_TARGET_FLOP_FRACTION':0.13,'_FIRST_MEAN_CORRECTION_POWER':0.73,'_FINAL_NESTED_EXTRAPOLATION':-0.070,'_SEED_OFFSET':0}
for params in [base, {**base,'_TARGET_FLOP_FRACTION':0.10},{**base,'_TARGET_FLOP_FRACTION':0.18},{**base,'_TARGET_FLOP_FRACTION':0.25},{**base,'_FIRST_MEAN_CORRECTION_POWER':0.6},{**base,'_FIRST_MEAN_CORRECTION_POWER':0.85},{**base,'_FINAL_NESTED_EXTRAPOLATION':0.0},{**base,'_FINAL_NESTED_EXTRAPOLATION':-0.14},{**base,'_SEED_OFFSET':1},{**base,'_SEED_OFFSET':12345}]:
    print(params, score(data,budget,params), flush=True)

import importlib.util, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def make_data(w,d,n_mlps,n_samples,seed):
    ss=fnp.random.SeedSequence(seed).spawn(3*n_mlps)
    data=[]; t=time.time()
    for i in range(n_mlps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(ss[3*i]),seed=int(ss[3*i+2].generate_state(1)[0]))
        _,final,_=sample_layer_statistics(mlp,n_samples,rng=fnp.random.default_rng(ss[3*i+1]))
        data.append((mlp,final))
    print('made',w,d,n_mlps,n_samples,'in',time.time()-t, flush=True)
    return data

def score(data,budget,params):
    for k,v in params.items(): setattr(sub,k,v)
    ms=[]
    for mlp,final in data:
        est=sub.Estimator()
        class C: pass
        c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=budget; c.seed=123; c.api_version='x'
        est.setup(c)
        pred=est.predict(mlp,budget)
        ms.append(float(fnp.mean((pred[-1]-final)**2)))
    return float(fnp.mean(fnp.asarray(ms)))

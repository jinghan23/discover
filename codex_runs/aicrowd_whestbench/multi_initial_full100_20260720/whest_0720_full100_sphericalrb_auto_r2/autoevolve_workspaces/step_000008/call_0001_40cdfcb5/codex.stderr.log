import importlib.util, time, math
import flopscope.numpy as fnp, flopscope as flops
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub); sub._KOROBOV_MULTIPLIER=11

def hadamard(w):
    h=fnp.array([[1.0]],dtype=fnp.float64)
    n=1
    while n<w:
        h=fnp.concatenate((fnp.concatenate((h,h),axis=1),fnp.concatenate((h,-h),axis=1)),axis=0)
        n*=2
    return h/fnp.sqrt(float(w))

def had_pred(mlp,b,random_sign=True):
    w=mlp.width; n=sub._sample_count(b,w,mlp.depth); blocks=max(1,n//(2*w)); hs=blocks*w
    H=hadamard(w)
    rng=fnp.random.default_rng(int(mlp.seed))
    dirs=[]
    for k in range(blocks):
        if random_sign:
            signs=fnp.where(rng.random(w)<0.5,-1.0,1.0)
            dirs.append(H*signs[None,:])
        else:
            dirs.append(H)
    half=fnp.concatenate(dirs,axis=0)
    dirs=fnp.concatenate((half,-half),axis=0)
    act=dirs*sub._mean_chi(w); rows=[]
    act=fnp.maximum(act@mlp.weights[0],0.0)
    fm=sub._exact_first_layer_mean(mlp.weights[0]); sm=fnp.maximum(fnp.mean(act,axis=0),1e-12); corr=(fm/sm)**sub._FIRST_MEAN_CORRECTION_POWER
    act=act*corr[None,:]; rows.append(fm)
    for li,wt in enumerate(mlp.weights[1:],start=1):
        act=fnp.maximum(act@wt,0); m=fnp.mean(act,axis=0)
        if li==mlp.depth-1 and hs>=2:
            qs=hs//2; nested=.5*(fnp.mean(act[:qs],axis=0)+fnp.mean(act[hs:hs+qs],axis=0)); m=m+sub._FINAL_NESTED_EXTRAPOLATION*(m-nested)
        rows.append(m)
    return fnp.asarray(fnp.stack(rows),dtype=fnp.float32)

def base(mlp,b):
    est=sub.Estimator();
    class C: pass
    c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=b; c.seed=0; c.api_version='x'; est.setup(c); return est.predict(mlp,b)

def run(w,d,b,nm,ns):
    ss=fnp.random.SeedSequence(5566+w).spawn(3*nm); data=[]
    for i in range(nm):
        mlp=sample_mlp(w,d,fnp.random.default_rng(ss[3*i]),seed=int(ss[3*i+2].generate_state(1)[0])); _,final,_=sample_layer_statistics(mlp,ns,rng=fnp.random.default_rng(ss[3*i+1])); data.append((mlp,final))
    print('CASE',w,d,'nbase',sub._sample_count(b,w,d))
    for name in ['base','had','hadfixed']:
        ms=[]; adj=[]; fr=[]
        for mlp,final in data:
            with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx:
                p=base(mlp,b) if name=='base' else had_pred(mlp,b,name=='had')
            mse=float(fnp.mean((p[-1]-final)**2)); f=(ctx.flops_used+1e11*float(ctx.residual_wall_time_s or 0))/b
            ms.append(mse); fr.append(f); adj.append(mse*max(.1,f))
        print(name,'mse',float(fnp.mean(fnp.asarray(ms))),'frac',float(fnp.mean(fnp.asarray(fr))),'adj',float(fnp.mean(fnp.asarray(adj))))
run(64,8,int(1e9),8,300000)
run(128,8,int(3e9),8,250000)
run(256,8,int(1e10),4,160000)

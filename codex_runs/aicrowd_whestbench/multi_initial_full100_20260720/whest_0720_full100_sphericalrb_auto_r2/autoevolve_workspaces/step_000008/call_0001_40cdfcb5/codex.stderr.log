/bin/bash -lc "python - <<'PY'
import importlib.util, time, math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics
import flopscope as flops_pkg
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
_INV_SQRT_2PI=1.0/math.sqrt(2.0*math.pi)

def gaussian_relu_moments(mu,var):
    sigma=fnp.sqrt(fnp.maximum(var,1e-30))
    alpha=mu/sigma
    phi=fnp.exp(-0.5*alpha*alpha)*_INV_SQRT_2PI
    Phi=flops_pkg.stats.norm.cdf(alpha)
    mean=sigma*phi+mu*Phi
    second=(var+mu*mu)*Phi+mu*sigma*phi
    return mean, second

def diag_pred(mlp):
    rows=[]
    w0=mlp.weights[0]
    s2=fnp.sum(w0*w0,axis=0)
    mean=fnp.sqrt(s2)*_INV_SQRT_2PI
    second=0.5*s2
    rows.append(mean)
    for w in mlp.weights[1:]:
        var=fnp.maximum(second-mean*mean,1e-30)
        mu=mean@w
        prevar=var@(w*w)
        mean,second=gaussian_relu_moments(mu,prevar)
        rows.append(mean)
    return fnp.asarray(fnp.stack(rows),dtype=fnp.float32)

def qmc_pred(mlp,budget):
    est=sub.Estimator()
    class C: pass
    c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=budget; c.seed=777; c.api_version='x'
    est.setup(c); return est.predict(mlp,budget)

def eval_case(w,d,b,n_mlps,n_samples):
    ss=fnp.random.SeedSequence(98765).spawn(3*n_mlps)
    res=[]; t=time.time()
    for i in range(n_mlps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(ss[3*i]),seed=int(ss[3*i+2].generate_state(1)[0]))
        _,final,_=sample_layer_statistics(mlp,n_samples,rng=fnp.random.default_rng(ss[3*i+1]))
        q=qmc_pred(mlp,b); dg=diag_pred(mlp)
        # scalar blends final only: alpha q + (1-alpha) diag
        ms=[]
        for a in [-1,-0.5,0,0.25,0.5,0.75,1,1.25,1.5,2]:
            p=a*q[-1]+(1-a)*dg[-1]
            ms.append(float(fnp.mean((p-final)**2)))
        res.append(ms)
        print('mlp',i+1,'q',ms[6],'diag',ms[2], 'time',time.time()-t, flush=True)
    avg=fnp.mean(fnp.asarray(res),axis=0)
    print('CASE',w,d,'alphas',[-1,-0.5,0,0.25,0.5,0.75,1,1.25,1.5,2])
    print([float(x) for x in avg])
for case in [(64,8,int(1e9),8,200000),(128,8,int(3e9),8,200000),(256,8,int(1e10),4,120000)]:
    eval_case(*case)

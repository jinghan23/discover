/bin/bash -lc "python - <<'PY'
import importlib.util, time
import flopscope.numpy as fnp, flopscope as flops
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)

def pred_control(mlp,b,frac=0.13,ridge=1e-6,mode='raw'):
    old=sub._TARGET_FLOP_FRACTION; sub._TARGET_FLOP_FRACTION=frac
    n=sub._sample_count(b,mlp.width,mlp.depth); hs=n//2; rng=fnp.random.default_rng(int(mlp.seed)); gen=sub._lattice_generator(mlp.width)
    hd=sub._qmc_directions(hs,mlp.width,rng,gen); wh=sub._angular_whitening_transform(hd); fw=wh@mlp.weights[0]
    dirs=fnp.concatenate((hd,-hd),axis=0); act=dirs*sub._mean_chi(mlp.width)
    raw1=fnp.maximum(act@fw,0.0); fm=sub._exact_first_layer_mean(mlp.weights[0]); sm=fnp.maximum(fnp.mean(raw1,axis=0),1e-12)
    corr=(fm/sm)**sub._FIRST_MEAN_CORRECTION_POWER
    act=raw1*corr[None,:]
    if mode=='raw':
        controls=raw1; expected=fm
    elif mode=='scaled':
        controls=act; expected=fm*corr
    else:
        controls=raw1; expected=fm
    rows=[fm]
    final_act=None; final_mean=None
    for li,w in enumerate(mlp.weights[1:],start=1):
        act=fnp.maximum(act@w,0); m=fnp.mean(act,axis=0)
        if li==mlp.depth-1 and hs>=2:
            qs=hs//2; nested=.5*(fnp.mean(act[:qs],axis=0)+fnp.mean(act[hs:hs+qs],axis=0)); m=m+sub._FINAL_NESTED_EXTRAPOLATION*(m-nested)
        rows.append(m)
        if li==mlp.depth-1:
            final_act=act; final_mean=m
    cm=fnp.mean(controls,axis=0); centered=controls-cm[None,:]
    # Use un-extrapolated final sample mean for beta centering but apply correction to row final.
    fm_sample=fnp.mean(final_act,axis=0); fcent=final_act-fm_sample[None,:]
    G=(centered.T@centered)/float(n)
    G=G+fnp.eye(mlp.width,dtype=fnp.float64)*ridge
    H=(centered.T@fcent)/float(n)
    beta=fnp.linalg.solve(G,H)
    rows[-1]=rows[-1]+(expected-cm)@beta
    sub._TARGET_FLOP_FRACTION=old
    return fnp.asarray(fnp.stack(rows),dtype=fnp.float32)

def base(mlp,b):
    est=sub.Estimator();
    class C: pass
    c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=b; c.seed=0; c.api_version='x'; est.setup(c); return est.predict(mlp,b)

def run(w,d,b,nm,ns):
    ss=fnp.random.SeedSequence(1212+w+d).spawn(3*nm); data=[]
    for i in range(nm):
        mlp=sample_mlp(w,d,fnp.random.default_rng(ss[3*i]),seed=int(ss[3*i+2].generate_state(1)[0])); _,final,_=sample_layer_statistics(mlp,ns,rng=fnp.random.default_rng(ss[3*i+1])); data.append((mlp,final))
    print('CASE',w,d,'n',sub._sample_count(b,w,d))
    tests=[('base',None),('raw',('raw',1e-6,.13)),('raw8',('raw',1e-6,.08)),('raw10',('raw',1e-6,.10)),('scaled',('scaled',1e-6,.13)),('rawridge',('raw',1e-3,.13))]
    for name,cfg in tests:
        ms=[]; adj=[]; fr=[]
        for mlp,final in data:
            with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx:
                p=base(mlp,b) if cfg is None else pred_control(mlp,b,cfg[2],cfg[1],cfg[0])
            mse=float(fnp.mean((p[-1]-final)**2)); f=(ctx.flops_used+1e11*float(ctx.residual_wall_time_s or 0))/b
            ms.append(mse); fr.append(f); adj.append(mse*max(.1,f))
        print(name,'mse',float(fnp.mean(fnp.asarray(ms))),'frac',float(fnp.mean(fnp.asarray(fr))),'adj',float(fnp.mean(fnp.asarray(adj))))
for case in [(128,8,int(3e9),8,250000),(256,8,int(1e10),4,160000),(128,16,int(5e9),6,180000)]: run(*case)

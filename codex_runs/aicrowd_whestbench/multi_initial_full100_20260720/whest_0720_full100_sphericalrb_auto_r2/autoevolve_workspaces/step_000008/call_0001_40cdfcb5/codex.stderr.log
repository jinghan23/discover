/bin/bash -lc "python - <<'PY'
import importlib.util, math, time
import flopscope.numpy as fnp
import flopscope as flops
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics
spec=importlib.util.spec_from_file_location('sub','submission.py')
sub=importlib.util.module_from_spec(spec); spec.loader.exec_module(sub)
# restore local constants if file currently m13
sub._KOROBOV_MULTIPLIER=11
_INV=1.0/(2.0*math.pi)

def exact_first_second(w):
    gram=w.T@w
    norms=fnp.sqrt(fnp.maximum(fnp.diagonal(gram),1e-30))
    denom=norms[:,None]*norms[None,:]
    rho=fnp.clip(gram/fnp.maximum(denom,1e-30),-1.0,1.0)
    s=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
    return denom*(s+(math.pi-fnp.arccos(rho))*rho)*_INV

def pred_cov(mlp,budget,mode='lin'):
    n=sub._sample_count(budget,mlp.width,mlp.depth)
    hs=n//2
    rng=fnp.random.default_rng(int(mlp.seed)+sub._SEED_OFFSET)
    gen=sub._lattice_generator(mlp.width)
    hd=sub._qmc_directions(hs,mlp.width,rng,gen)
    whitening=sub._angular_whitening_transform(hd)
    first_weight=whitening@mlp.weights[0]
    dirs=fnp.concatenate((hd,-hd),axis=0)
    act=dirs*sub._mean_chi(mlp.width)
    act=fnp.maximum(act@first_weight,0.0)
    first_mean=sub._exact_first_layer_mean(mlp.weights[0])
    if mode=='baseline':
        sm=fnp.maximum(fnp.mean(act,axis=0),1e-12)
        corr=(first_mean/sm)**sub._FIRST_MEAN_CORRECTION_POWER
        act=act*corr[None,:]
    else:
        nfloat=float(n)
        sm=fnp.mean(act,axis=0)
        centered=act-sm[None,:]
        sample_cov=(centered.T@centered)/nfloat
        second=exact_first_second(mlp.weights[0])
        exact_cov=second-first_mean[:,None]*first_mean[None,:]
        es,us=fnp.linalg.eigh(sample_cov)
        ee,ue=fnp.linalg.eigh(exact_cov)
        es=fnp.maximum(es,1e-9); ee=fnp.maximum(ee,1e-12)
        sample_invsqrt=(us/fnp.sqrt(es))@us.T
        exact_sqrt=(ue*fnp.sqrt(ee))@ue.T
        transform=sample_invsqrt@exact_sqrt
        act=centered@transform+first_mean[None,:]
        if mode=='clip':
            act=fnp.maximum(act,0.0)
        elif mode=='blend':
            sm2=fnp.maximum(fnp.mean(act,axis=0),1e-12)
            act=act*(first_mean/sm2)[None,:]
    rows=[first_mean]
    final=mlp.depth-1
    for li,w in enumerate(mlp.weights[1:],start=1):
        act=fnp.maximum(act@w,0.0)
        mean=fnp.mean(act,axis=0)
        if li==final and hs>=2:
            qs=hs//2
            nested=0.5*(fnp.mean(act[:qs],axis=0)+fnp.mean(act[hs:hs+qs],axis=0))
            mean=mean+sub._FINAL_NESTED_EXTRAPOLATION*(mean-nested)
        rows.append(mean)
    return fnp.asarray(fnp.stack(rows),dtype=fnp.float32)

def base_pred(mlp,b):
    est=sub.Estimator();
    class C: pass
    c=C(); c.width=mlp.width; c.depth=mlp.depth; c.flop_budget=b; c.seed=0; c.api_version='x'; est.setup(c)
    return est.predict(mlp,b)

def run(w,d,b,nm,ns):
    ss=fnp.random.SeedSequence(24680+w).spawn(3*nm)
    sums={k:[] for k in ['base','lin','clip','blend']}; t=time.time(); fl={}
    for i in range(nm):
        mlp=sample_mlp(w,d,fnp.random.default_rng(ss[3*i]),seed=int(ss[3*i+2].generate_state(1)[0]))
        _,final,_=sample_layer_statistics(mlp,ns,rng=fnp.random.default_rng(ss[3*i+1]))
        for mode in sums:
            with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
                p=base_pred(mlp,b) if mode=='base' else pred_cov(mlp,b,mode)
            sums[mode].append(float(fnp.mean((p[-1]-final)**2)))
            fl.setdefault(mode,[]).append(ctx.flops_used)
        print('mlp',i+1,'time',time.time()-t, flush=True)
    print('CASE',w,d)
    for mode,vals in sums.items(): print(mode,float(fnp.mean(fnp.asarray(vals))),'flops',sum(fl[mode])/len(fl[mode])/b)
for case in [(64,8,int(1e9),8,300000),(128,8,int(3e9),6,200000)]: run(*case)

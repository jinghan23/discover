/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.stats import norm
# Reuse core pieces from the previous local comparison, shortened.
TAIL=1e-11; K=5; M=104729

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def lattice_dirs(nh,d,seed=123):
    gen=np.array([pow(K,i,M)/M for i in range(d)])
    rng=np.random.default_rng(seed); shift=rng.random(d); idx=np.arange(nh)[:,None]
    z=norm.ppf(np.clip((idx*gen[None,:]+shift[None,:])%1.0,TAIL,1-TAIL))
    return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

def whiten(D):
    nh,d=D.shape; S=D.T@D*(d/nh); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def qmc(Ws,n,seed=123):
    d=Ws[0].shape[0]; Dh=lattice_dirs(n//2,d,seed); T=whiten(Dh); D=np.r_[Dh,-Dh]
    A=D*mean_chi(d); rows=[]; A=np.maximum(A@(T@Ws[0]),0); rows.append(exact_first(Ws[0]))
    for W in Ws[1:]:
        A=np.maximum(A@W,0); rows.append(A.mean(0))
    return np.stack(rows)

def diag(Ws):
    rows=[]; W=Ws[0]
    s2=(W*W).sum(0); m=np.sqrt(s2)/math.sqrt(2*math.pi); q=0.5*s2; rows.append(m)
    for W in Ws[1:]:
        v=np.maximum(q-m*m,0)
        mu=m@W; sig2=v@(W*W); sig=np.sqrt(np.maximum(sig2,1e-30)); t=mu/sig
        Phi=norm.cdf(t); phi=np.exp(-0.5*t*t)/math.sqrt(2*math.pi)
        m=sig*phi+mu*Phi
        q=(mu*mu+sig2)*Phi+mu*sig*phi
        rows.append(m)
    return np.stack(rows)

def true_mean(Ws,N=100000,seed=999,batch=10000):
    d=Ws[0].shape[0]; sums=[np.zeros(d) for _ in Ws]; rng=np.random.default_rng(seed); done=0
    while done<N:
        b=min(batch,N-done); A=rng.normal(size=(b,d))
        for i,W in enumerate(Ws): A=np.maximum(A@W,0); sums[i]+=A.sum(0)
        done+=b
    return np.stack([s/N for s in sums])

def trial(d,L,n,t=10):
    vals={k:[] for k in ['qmc','diag','b01','b02','b05','b10','b-01']}
    for seed in range(t):
        rng=np.random.default_rng(10+seed); sc=math.sqrt(2/d)
        Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]
        tr=true_mean(Ws,seed=200+seed)[-1]
        p=qmc(Ws,n,300+seed)[-1]; a=diag(Ws)[-1]
        preds={'qmc':p,'diag':a,'b01':0.9*p+0.1*a,'b02':0.8*p+0.2*a,'b05':0.5*p+0.5*a,'b10':a,'b-01':1.1*p-0.1*a}
        for k,x in preds.items(): vals[k].append(((x-tr)**2).mean())
    print('d L n',d,L,n)
    base=np.mean(vals['qmc'])
    for k,v in vals.items(): print(k,np.mean(v),np.mean(v)/base)
for args in [(32,6,128),(32,6,256),(64,6,256),(64,8,256),(64,8,512),(128,8,256)]:

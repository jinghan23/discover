     return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
 
 
+def _relu_normal_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, _MIN_VARIANCE)
+    standard_deviation = fnp.sqrt(variance)
+    standardized = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(standardized)
+    pdf = flops.stats.norm.pdf(standardized)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    second_moment = (mean * mean + variance) * cdf + mean * standard_deviation * pdf
+    return relu_mean, fnp.maximum(second_moment, 0.0), cdf
+
+
+def _with_diagonal(matrix: fnp.ndarray, diagonal: fnp.ndarray) -> fnp.ndarray:
+    return matrix + fnp.diag(diagonal - fnp.diag(matrix))
+
+
+def _full_gaussian_final_mean(weights: list[fnp.ndarray]) -> fnp.ndarray:
+    first_weight = weights[0]
+    covariance = first_weight.T @ first_weight
+    variance = fnp.maximum(fnp.diag(covariance), _MIN_VARIANCE)
+    standard_deviation = fnp.sqrt(variance)
+    correlation = covariance / (standard_deviation[:, None] * standard_deviation[None, :])
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    sine_term = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    angle = fnp.arccos(correlation)
+    joint_second = (
+        standard_deviation[:, None]
+        * standard_deviation[None, :]
+        * (sine_term + (math.pi - angle) * correlation)
+        / (2.0 * math.pi)
+    )
+    mean = standard_deviation / fnp.sqrt(2.0 * fnp.pi)
+    covariance = joint_second - fnp.outer(mean, mean)
+
+    for weight in weights[1:]:
+        pre_mean = mean @ weight
+        pre_covariance = weight.T @ covariance @ weight
+        mean, second_moment, gate_probability = _relu_normal_moments(
+            pre_mean, fnp.diag(pre_covariance)
+        )
+        covariance = (
+            gate_probability[:, None]
+            * gate_probability[None, :]
+            * pre_covariance
+        )
+        covariance = _with_diagonal(
+            covariance, fnp.maximum(second_moment - mean * mean, 0.0)
+        )
+
+    return mean
+
+
 class Estimator(BaseEstimator):
     def predict(self, mlp, budget: int) -> fnp.ndarray:

import numpy as np, math
from scipy.stats import norm
TAIL=1e-11; K=5; M=104729

def mean_chi(d): h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def dirs(nh,d,seed):
 gen=np.array([pow(K,i,M)/M for i in range(d)]); rng=np.random.default_rng(seed); shift=rng.random(d); idx=np.arange(nh)[:,None]
 z=norm.ppf(np.clip((idx*gen[None,:]+shift[None,:])%1.0,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def white(D):
 nh,d=D.shape; S=D.T@D*(d/nh); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def initial(Ws,n,seed):
 d=Ws[0].shape[0]; Dh=dirs(n//2,d,seed); T=white(Dh); D=np.r_[Dh,-Dh]; A=D*mean_chi(d); A=np.maximum(A@(T@Ws[0]),0); return A
def propagate(Ws,A):
 rows=[exact_first(Ws[0])]
 for W in Ws[1:]: A=np.maximum(A@W,0); rows.append(A.mean(0))
 return np.stack(rows)
def pred(Ws,n,mode,seed):
 if mode=='base': A=initial(Ws,n,seed)
 elif mode=='choose2':
  m=exact_first(Ws[0]); A1=initial(Ws,n,seed); e1=((A1.mean(0)-m)**2).mean(); A2=initial(Ws,n,seed+104729); e2=((A2.mean(0)-m)**2).mean(); A=A2 if e2<e1 else A1
 elif mode=='avg2':
  # half samples per shift, concatenate first activations after separate whitening; exact first row still used
  A=np.r_[initial(Ws,n//2,seed), initial(Ws,n//2,seed+104729)]
 return propagate(Ws,A)
def true(Ws,N=100000,seed=9,batch=10000):
 d=Ws[0].shape[0]; sums=[np.zeros(d) for _ in Ws]; rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); A=rng.normal(size=(b,d))
  for i,W in enumerate(Ws): A=np.maximum(A@W,0); sums[i]+=A.sum(0)
  done+=b
 return np.stack([s/N for s in sums])
for args in [(32,6,128),(32,6,256),(64,8,256),(64,8,512),(128,8,256)]:
 d,L,n=args; vals={k:[] for k in ['base','choose2','avg2']}
 for s in range(6):
  rng=np.random.default_rng(100+s); sc=math.sqrt(2/d); Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]; tr=true(Ws,seed=200+s)[-1]
  for k in vals: vals[k].append(((pred(Ws,n,k,300+s)[-1]-tr)**2).mean())
 print(args,{k:np.mean(v) for k,v in vals.items()}, 'rels',{k:np.mean(vals[k])/np.mean(vals['base']) for k in vals})

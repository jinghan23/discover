import numpy as np, math
from scipy.stats import norm, qmc
TAIL=1e-11; MOD=104729

def mean_chi(d):
    h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))

def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def whiten(D):
    nh,d=D.shape; S=D.T@D*(d/nh); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T

def dirs_lattice(nh,d,seed,mult=5,mod=MOD):
    gen=np.array([pow(mult,i,mod)/mod for i in range(d)])
    rng=np.random.default_rng(seed); shift=rng.random(d); idx=np.arange(nh)[:,None]
    z=norm.ppf(np.clip((idx*gen[None,:]+shift[None,:])%1.0,TAIL,1-TAIL))
    return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

def dirs_sobol(nh,d,seed):
    # use next power of two then truncate only if needed
    m=int(math.ceil(math.log2(max(nh,2))))
    sampler=qmc.Sobol(d=d, scramble=True, seed=seed)
    u=sampler.random_base2(m)[:nh]
    z=norm.ppf(np.clip(u,TAIL,1-TAIL))
    return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

def dirs_normal(nh,d,seed):
    rng=np.random.default_rng(seed); z=rng.normal(size=(nh,d)); return z/np.sqrt((z*z).sum(1))[:,None]

def pred(Ws,n,kind,seed=0,mult=5):
    d=Ws[0].shape[0]
    if kind=='sobol': Dh=dirs_sobol(n//2,d,seed)
    elif kind=='normal': Dh=dirs_normal(n//2,d,seed)
    else: Dh=dirs_lattice(n//2,d,seed,mult)
    T=whiten(Dh); D=np.r_[Dh,-Dh]; A=D*mean_chi(d); rows=[]; A=np.maximum(A@(T@Ws[0]),0); rows.append(exact_first(Ws[0]))
    for W in Ws[1:]: A=np.maximum(A@W,0); rows.append(A.mean(0))
    return np.stack(rows)

def true_mean(Ws,N=120000,seed=999,batch=10000):
    d=Ws[0].shape[0]; sums=[np.zeros(d) for _ in Ws]; rng=np.random.default_rng(seed); done=0
    while done<N:
        b=min(batch,N-done); A=rng.normal(size=(b,d))
        for i,W in enumerate(Ws): A=np.maximum(A@W,0); sums[i]+=A.sum(0)
        done+=b
    return np.stack([s/N for s in sums])

def trial(d,L,n,t=8):
    keys=['lat3','lat5','lat7','lat11','lat13','lat17','lat23','sobol','normal']
    vals={k:[] for k in keys}
    for seed in range(t):
        rng=np.random.default_rng(100+seed); sc=math.sqrt(2/d); Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]
        tr=true_mean(Ws,seed=700+seed)[-1]
        for k in keys:
            if k.startswith('lat'):
                p=pred(Ws,n,'lat',300+seed,int(k[3:]))[-1]
            else:
                p=pred(Ws,n,k,300+seed)[-1]
            vals[k].append(((p-tr)**2).mean())
    print('d,L,n',d,L,n)
    base=np.mean(vals['lat5'])
    for k in keys: print(k,np.mean(vals[k]),np.mean(vals[k])/base)
for args in [(32,6,128),(32,6,256),(64,8,256),(64,8,512),(128,8,256)]:
    trial(*args,t=6)

def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def dirs(nh,d,seed):
 gen=np.array([pow(K,i,M)/M for i in range(d)]); rng=np.random.default_rng(seed); shift=rng.random(d); idx=np.arange(nh)[:,None]
 z=norm.ppf(np.clip((idx*gen[None,:]+shift[None,:])%1.0,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

def trans(D,gamma):
 if gamma==0: return np.eye(D.shape[1])
 nh,d=D.shape; S=D.T@D*(d/nh); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8)
 return (vecs/(vals**(0.5*gamma)))@vecs.T

def pred(Ws,n,gamma,seed):
 d=Ws[0].shape[0]; Dh=dirs(n//2,d,seed); T=trans(Dh,gamma); D=np.r_[Dh,-Dh]; A=D*mean_chi(d); rows=[]; A=np.maximum(A@(T@Ws[0]),0); rows.append(exact_first(Ws[0]))
 for W in Ws[1:]: A=np.maximum(A@W,0); rows.append(A.mean(0))
 return np.stack(rows)

def true(Ws,N=100000,seed=9,batch=10000):
 d=Ws[0].shape[0]; sums=[np.zeros(d) for _ in Ws]; rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); A=rng.normal(size=(b,d))
  for i,W in enumerate(Ws): A=np.maximum(A@W,0); sums[i]+=A.sum(0)
  done+=b
 return np.stack([s/N for s in sums])

def trial(d,L,n,t=8):
 gammas=[0,0.25,0.5,0.75,1.0,1.25]
 vals={g:[] for g in gammas}
 for seed in range(t):
  rng=np.random.default_rng(40+seed); sc=math.sqrt(2/d); Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]
  tr=true(Ws,seed=90+seed)[-1]
  for g in gammas: vals[g].append(((pred(Ws,n,g,500+seed)[-1]-tr)**2).mean())
 print('d,L,n',d,L,n); base=np.mean(vals[1.0])
 for g in gammas: print(g,np.mean(vals[g]),np.mean(vals[g])/base)
for args in [(32,6,128),(32,6,256),(64,8,256),(64,8,512),(128,8,256)]: trial(*args,t=6)

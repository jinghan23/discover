import numpy as np, math
from scipy.stats import norm
# qmc baseline helpers omitted? include compact
TAIL=1e-11; K=5; M=104729

def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def relu_mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-30)); a=mu/sig; Phi=norm.cdf(a); phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
 m=sig*phi+mu*Phi; q=(mu*mu+var)*Phi+mu*sig*phi; return m,q,Phi
def full_gauss(Ws):
 W=Ws[0]; S=W.T@W; sd=np.sqrt(np.maximum(np.diag(S),1e-30)); m=sd/math.sqrt(2*math.pi)
 R=S/(sd[:,None]*sd[None,:]); R=np.clip(R,-1,1)
 E=(sd[:,None]*sd[None,:])/(2*math.pi)*(np.sqrt(np.maximum(1-R*R,0))+(math.pi-np.arccos(R))*R)
 np.fill_diagonal(E,0.5*np.diag(S)); C=E-np.outer(m,m); rows=[m]
 for W in Ws[1:]:
  mu=m@W; PC=W.T@C@W; var=np.maximum(np.diag(PC),0); m,q,Phi=relu_mom(mu,var)
  C=(Phi[:,None]*Phi[None,:])*PC
  np.fill_diagonal(C,np.maximum(q-m*m,0))
  rows.append(m)
 return np.stack(rows)
def diag(Ws):
 W=Ws[0]; s2=(W*W).sum(0); m=np.sqrt(s2)/math.sqrt(2*math.pi); q=.5*s2; rows=[m]
 for W in Ws[1:]:
  v=np.maximum(q-m*m,0); mu=m@W; var=v@(W*W); m,q,_=relu_mom(mu,var); rows.append(m)
 return np.stack(rows)
def mean_chi(d): h=.5*d; return math.sqrt(2)*math.exp(math.lgamma(h+.5)-math.lgamma(h))
def dirs(nh,d,seed):
 gen=np.array([pow(K,i,M)/M for i in range(d)]); rng=np.random.default_rng(seed); shift=rng.random(d); idx=np.arange(nh)[:,None]
 z=norm.ppf(np.clip((idx*gen[None,:]+shift[None,:])%1.0,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def white(D):
 nh,d=D.shape; S=D.T@D*(d/nh); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def qmc(Ws,n,seed):
 d=Ws[0].shape[0]; Dh=dirs(n//2,d,seed); T=white(Dh); D=np.r_[Dh,-Dh]; A=D*mean_chi(d); rows=[]; A=np.maximum(A@(T@Ws[0]),0); rows.append(exact_first(Ws[0]))
 for W in Ws[1:]: A=np.maximum(A@W,0); rows.append(A.mean(0))
 return np.stack(rows)
def true(Ws,N=100000,seed=9,batch=10000):
 d=Ws[0].shape[0]; sums=[np.zeros(d) for _ in Ws]; rng=np.random.default_rng(seed); done=0
 while done<N:
  b=min(batch,N-done); A=rng.normal(size=(b,d))
  for i,W in enumerate(Ws): A=np.maximum(A@W,0); sums[i]+=A.sum(0)
  done+=b
 return np.stack([s/N for s in sums])
for args in [(32,6,128),(64,8,256),(128,8,256)]:
 d,L,n=args; vals={k:[] for k in ['qmc','diag','full','b05','b10','b20','b-10']}
 for s in range(6):
  rng=np.random.default_rng(1500+s); sc=math.sqrt(2/d); Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]; tr=true(Ws,seed=1600+s)[-1]
  p=qmc(Ws,n,1700+s)[-1]; a=diag(Ws)[-1]; f=full_gauss(Ws)[-1]
  preds={'qmc':p,'diag':a,'full':f,'b05':.95*p+.05*f,'b10':.9*p+.1*f,'b20':.8*p+.2*f,'b-10':1.1*p-.1*f}
  for k,x in preds.items(): vals[k].append(((x-tr)**2).mean())
 print(args); base=np.mean(vals['qmc'])
 for k,v in vals.items(): print(k,np.mean(v),np.mean(v)/base)

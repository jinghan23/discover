import numpy as np, math
from scipy.stats import norm

TAIL=1e-11
K=5; M=104729

def mean_chi(d):
    h=0.5*d
    return math.sqrt(2)*math.exp(math.lgamma(h+0.5)-math.lgamma(h))

def exact_first(W):
    return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)

def lattice_dirs(nh,d,seed=123):
    gen=np.array([pow(K,i,M)/M for i in range(d)])
    rng=np.random.default_rng(seed)
    shift=rng.random(d)
    idx=np.arange(nh)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    z=norm.ppf(np.clip(u,TAIL,1-TAIL))
    return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]

def whiten(D):
    nh,d=D.shape
    S=D.T@D*(d/nh)
    vals,vecs=np.linalg.eigh(S)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def predict(Ws,n,control='none',shrink=1.0,ridge=1e-6,seed=123):
    d=Ws[0].shape[0]
    Dhalf=lattice_dirs(n//2,d,seed)
    T=whiten(Dhalf)
    W0=T@Ws[0]
    D=np.concatenate([Dhalf,-Dhalf],0)
    A=D*mean_chi(d)
    rows=[]
    A=np.maximum(A@W0,0)
    m1_exact=exact_first(Ws[0])
    rows.append(m1_exact)
    if control"'!='"'none':
        C=A
        cm=C.mean(0)
        Cc=C-cm
        delta=m1_exact-cm
        if control=='diag':
            var=(Cc*Cc).mean(0)+ridge
            v=delta/var
        else:
            cov=(Cc.T@Cc)/n
            cov=cov+ridge*np.eye(d)
            v=np.linalg.solve(cov,delta)
        sw=(Cc@v)/n
    for W in Ws[1:]:
        A=np.maximum(A@W,0)
        m=A.mean(0)
        if control"'!='"'none':
            m=m+shrink*(sw@A)
        rows.append(m)
    return np.stack(rows)

def true_mean(Ws, N=200000, seed=999, batch=20000):
    d=Ws[0].shape[0]
    sums=[np.zeros(d) for _ in Ws]
    rng=np.random.default_rng(seed)
    done=0
    while done<N:
        b=min(batch,N-done)
        A=rng.normal(size=(b,d))
        for i,W in enumerate(Ws):
            A=np.maximum(A@W,0)
            sums[i]+=A.sum(0)
        done+=b
    return np.stack([s/N for s in sums])

def trial(d=32,L=6,n=256,scale='he',t=20):
    mses={k:[] for k in ['base','diag1','diag07','full1','full07','full04']}
    for seed in range(t):
        rng=np.random.default_rng(1000+seed)
        sc=math.sqrt(2/d) if scale=='he' else 1/math.sqrt(d)
        Ws=[rng.normal(scale=sc,size=(d,d)) for _ in range(L)]
        tr=true_mean(Ws,N=100000,seed=2000+seed,batch=10000)[-1]
        preds={
            'base': predict(Ws,n,'none',seed=3000+seed)[-1],
            'diag1': predict(Ws,n,'diag',1.0,seed=3000+seed)[-1],
            'diag07': predict(Ws,n,'diag',0.7,seed=3000+seed)[-1],
            'full1': predict(Ws,n,'full',1.0,seed=3000+seed)[-1],
            'full07': predict(Ws,n,'full',0.7,seed=3000+seed)[-1],
            'full04': predict(Ws,n,'full',0.4,seed=3000+seed)[-1],
        }
        for k,p in preds.items():
            mses[k].append(((p-tr)**2).mean())
    print('d L n scale',d,L,n,scale)
    for k,v in mses.items():
        print(k, np.mean(v), 'rel', np.mean(v)/np.mean(mses['base']))

for args in [(32,6,128),(32,6,256),(64,6,256),(64,8,256),(64,8,512)]:
    trial(*args,t=8)

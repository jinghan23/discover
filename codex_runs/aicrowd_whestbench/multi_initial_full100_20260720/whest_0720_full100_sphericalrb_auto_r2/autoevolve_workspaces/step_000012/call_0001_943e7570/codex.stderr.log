def relu_mean(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=mu/sig; Phi=ndtr(a); phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi)
    mean=mu*Phi+sig*phi; sec=(mu*mu+var)*Phi+mu*sig*phi; return mean, np.maximum(sec-mean*mean,0)

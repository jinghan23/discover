def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def relu_gauss(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=mu/sig; Phi=ndtr(a); phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi); return mu*Phi+sig*phi
def estimate_values(ws,seed):

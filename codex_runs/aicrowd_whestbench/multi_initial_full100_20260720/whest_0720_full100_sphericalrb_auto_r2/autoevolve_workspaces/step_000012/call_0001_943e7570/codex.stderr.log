/bin/bash -lc "python - <<'PY'
import math,time
import numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; N=8194

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)])
def dirs(n,w,seed):
    rng=np.random.default_rng(seed); u=(np.arange(n)[:,None]*gen(w)[None,:]+rng.random(w))%1.; z=ndtri(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def whiten(D):
    n,w=D.shape; S=(D.T@D)*(w/n); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def final_acts(ws,seed):
    w=ws[0].shape[0]; h=N//2; hd=dirs(h,w,seed).astype('float32'); Wh=whiten(hd).astype('float32')
    A=np.concatenate([hd,-hd],0)*np.float32(mean_chi(w)); A=np.maximum(A@(Wh@ws[0]).astype('float32'),0)
    first=exact_first(ws[0]).astype('float32'); sm=np.maximum(A.astype('float64').mean(0),1e-12); A=(A+(first-sm)[None,:]).astype('float32')
    for W in ws[1:]: A=np.maximum(A@W,0)
    return A
def pred_from_A(A,mode,c=-.05):
    h=N//2; full=A.mean(0)
    if mode=='none': return full
    if mode=='first':
        q=h//2; coarse=.5*(A[:q].mean(0)+A[h:h+q].mean(0))
    elif mode=='last':
        q=h//2; coarse=.5*(A[h-q:h].mean(0)+A[-q:].mean(0))
    elif mode=='even':

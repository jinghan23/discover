/bin/bash -lc "python - <<'PY'
import math,time
import numpy as np
from scipy.special import ndtri, ndtr
TAIL=1e-11; MOD=104729; N=8194

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)])
def dirs(n,w,seed):
    rng=np.random.default_rng(seed); u=(np.arange(n)[:,None]*gen(w)[None,:]+rng.random(w))%1.; z=ndtri(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def whiten(D):
    n,w=D.shape; S=(D.T@D)*(w/n); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/math.sqrt(2*math.pi)
def sample_est(ws,seed):
    w=ws[0].shape[0]; h=N//2; hd=dirs(h,w,seed).astype('float32'); Wh=whiten(hd).astype('float32')
    A=np.concatenate([hd,-hd],0)*np.float32(mean_chi(w)); A=np.maximum(A@(Wh@ws[0]).astype('float32'),0)
    first=exact_first(ws[0]).astype('float32'); sm=np.maximum(A.astype('float64').mean(0),1e-12); A=(A+(first-sm)[None,:]).astype('float32')
    for li,W in enumerate(ws[1:],1):
        A=np.maximum(A@W,0)
        if li==len(ws)-1:
            lm=A.mean(0); q=h//2; nested=.5*(A[:q].mean(0)+A[h:h+q].mean(0)); return (lm-.05*(lm-nested)).astype('float32')
def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20)); a=mu/sig; Phi=ndtr(a); phi=np.exp(-.5*a*a)/math.sqrt(2*math.pi)
    mean=mu*Phi+sig*phi; sec=(mu*mu+var)*Phi+mu*sig*phi; return mean, np.maximum(sec-mean*mean,0), Phi
def diag_est(ws):
    w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w)
    for W in ws:
        mu_pre=W.T@mu; var_pre=(W*W).T@var; mu,var,_=relu_mom(mu_pre,var_pre)
    return mu.astype('float32')
def cov_est(ws):
    w=ws[0].shape[0]; mu=np.zeros(w); cov=np.eye(w)
    for W in ws:
        mu_pre=W.T@mu; cov_pre=W.T@cov@W; var_pre=np.maximum(np.diag(cov_pre),1e-20)
        mu,var_post,gain=relu_mom(mu_pre,var_pre)
        cov=np.outer(gain,gain)*cov_pre; np.fill_diagonal(cov,var_post)
    return mu.astype('float32')
def target(ws,n=180000,seed=0):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(8192,n-done); A=rng.standard_normal((m,w)).astype('float32')
        for W in ws: A=np.maximum(A@W,0)
        s+=A.astype('float64').sum(0); done+=m
    return (s/n).astype('float32')
def weights(seed,w=256,d=32):
    rng=np.random.default_rng(seed); scale=math.sqrt(2/w); return [(rng.standard_normal((w,w)).astype('float32')*scale) for _ in range(d)]
errs={}; alphas=[-0.2,-0.1,-0.05,-0.02,-0.01,0,0.01,0.02,0.05,0.1,0.2]
for key in ['s','diag','cov']+[f'diag{a}' for a in alphas]+[f'cov{a}' for a in alphas]: errs[key]=[]
t=time.time(); mlps=8
for mi in range(mlps):
    W=weights(21000+mi); T=target(W,160000,22000+mi); S=sample_est(W,23000+mi); D=diag_est(W); C=cov_est(W)
    errs['s'].append(np.mean((S-T)**2)); errs['diag'].append(np.mean((D-T)**2)); errs['cov'].append(np.mean((C-T)**2))
    for a in alphas:
        errs[f'diag{a}'].append(np.mean(((1-a)*S+a*D-T)**2))
        errs[f'cov{a}'].append(np.mean(((1-a)*S+a*C-T)**2))
    print('done',mi,time.time()-t, 's',errs['s'][-1], 'diag',errs['diag'][-1], 'cov',errs['cov'][-1])
base=np.mean(errs['s']); print('base',base)
for k in sorted(errs,key=lambda k:np.mean(errs[k]))[:30]:
    a=np.array(errs[k]); print(k,a.mean(),a.mean()/base,a.std(ddof=1)/math.sqrt(len(a)))

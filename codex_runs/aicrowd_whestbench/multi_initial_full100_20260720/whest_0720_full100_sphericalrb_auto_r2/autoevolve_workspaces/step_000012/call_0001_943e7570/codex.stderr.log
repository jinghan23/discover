import math, time
import numpy as np
from scipy.special import ndtri, ndtr

TARGET_FRACTION=.13
TAIL=1e-11
MUL=11
MOD=104729
FINAL_EXT=-.05
FIRST_ADD=1.0
FLOP_BUDGET=272_000_000_000

def mean_chi(d):
    return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))

def sample_count(budget,w,d,frac=.13):
    half=(89*w+3*w+2)//2
    layer=d*(2*w*w+2*w)
    cov=w*w
    per=half+layer+cov
    fixed=13*w**3+8*w
    c=(int(frac*budget)-fixed)//per
    return int(max(32,c)) & ~1

def gen_vec(w,mul=11,mod=104729):
    return np.array([pow(mul,i,mod)/mod for i in range(w)],dtype=np.float64)

def qmc_dirs(n,w,seed=0,mul=11):
    rng=np.random.default_rng(seed)
    g=gen_vec(w,mul)
    shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*g[None,:]+shift[None,:])%1.0
    u=np.clip(u,TAIL,1-TAIL)
    z=ndtri(u)
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def whiten(D):
    n,w=D.shape
    S=(D.T@D)*(w/n)
    vals, vecs=np.linalg.eigh(S)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def relu_gauss(mu,var):
    sig=np.sqrt(np.maximum(var,1e-20))
    a=mu/sig
    Phi=ndtr(a)
    phi=np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
    mean=mu*Phi+sig*phi
    second=(mu*mu+var)*Phi+mu*sig*phi
    return mean, second

def estimate(weights, seed=0, n=8194, mul=11, final_ext=-.05, final_gauss=0.0, layer_gauss=0.0, first_mode='add', layer_var=0.0):
    w=weights[0].shape[0]; d=len(weights); half=n//2
    hd=qmc_dirs(half,w,seed,mul).astype(np.float32)
    B=whiten(hd).astype(np.float32)
    firstW=(B@weights[0]).astype(np.float32)
    dirs=np.concatenate([hd,-hd],axis=0)
    A=(dirs*np.float32(mean_chi(w)))
    rows=[]
    pre=A@firstW
    A=np.maximum(pre,0)
    first=exact_first(weights[0]).astype(np.float32)
    sm=np.maximum(A.astype(np.float64).mean(axis=0),1e-12)
    if first_mode=='add':
        A=(A+(first-sm)[None,:]).astype(np.float32)
    elif first_mode=='scale':
        A=(A*(first/sm)[None,:]).astype(np.float32)
    elif first_mode=='affine':
        ss=np.mean(A.astype(np.float64)*A.astype(np.float64),axis=0)
        tv=0.5*np.sum(weights[0].astype(np.float64)**2,axis=0)-first.astype(np.float64)**2
        sv=np.maximum(ss-sm*sm,1e-20)
        scale=np.sqrt(np.maximum(tv,1e-20)/sv)
        A=((A-sm[None,:])*scale[None,:]+first[None,:]).astype(np.float32)
    rows.append(first)
    for li,W in enumerate(weights[1:],start=1):
        pre=A@W
        rel=np.maximum(pre,0)
        sm=rel.mean(axis=0)
        lm=sm
        if layer_gauss or final_gauss or layer_var:
            pm=pre.astype(np.float64).mean(axis=0)
            ps=pre.astype(np.float64)*pre.astype(np.float64)
            var=np.maximum(ps.mean(axis=0)-pm*pm,1e-20)
            gm,g2=relu_gauss(pm,var)
            if li==d-1 and final_gauss:
                lm=lm+final_gauss*(gm-lm)
            if li<d-1 and layer_gauss:
                target=sm+layer_gauss*(gm-sm)
                if layer_var:
                    ss=(rel.astype(np.float64)*rel.astype(np.float64)).mean(axis=0)
                    sv=np.maximum(ss-sm.astype(np.float64)*sm.astype(np.float64),1e-20)
                    tv=np.maximum((g2-gm*gm),1e-20)
                    sc=np.sqrt(tv/sv)
                    sc=1+layer_var*(sc-1)
                    rel=((rel-sm[None,:])*sc[None,:]+target[None,:]).astype(np.float32)
                else:
                    rel=(rel+(target-sm)[None,:]).astype(np.float32)
        if li==d-1 and half>=2 and final_ext:
            q=half//2
            nested=.5*(rel[:q].mean(axis=0)+rel[half:half+q].mean(axis=0))
            lm=lm+final_ext*(lm-nested)
        A=rel
        rows.append(lm.astype(np.float32))
    return np.stack(rows)

def target(weights, n=200000, seed=123, chunk=8192):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]; d=len(weights)
    sums=np.zeros((d,w),dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        A=rng.standard_normal((m,w)).astype(np.float32)
        for li,W in enumerate(weights):
            A=np.maximum(A@W,0)
            sums[li]+=A.astype(np.float64).sum(axis=0)
        done+=m
    return (sums/n).astype(np.float32)

def sample_weights(w,d,seed):
    rng=np.random.default_rng(seed)
    scale=math.sqrt(2/w)
    return [(rng.standard_normal((w,w)).astype(np.float32)*scale) for _ in range(d)]


/bin/bash -lc "python - <<'PY'
# quick local width-256 budget fraction check on synthetic networks
import math, time
import numpy as np
from scipy.special import ndtri
TAIL=1e-11; MOD=104729; BUDGET=272_000_000_000

def count(frac,w=256,d=32):
    per=((89*w+3*w+2)//2)+d*(2*w*w+2*w)+w*w; fixed=13*w**3+8*w
    return max(32, ((int(frac*BUDGET)-fixed)//per)) & ~1

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def gen(w): return np.array([pow(11,i,MOD)/MOD for i in range(w)])
def dirs(n,w,seed):
    rng=np.random.default_rng(seed); g=gen(w); u=(np.arange(n)[:,None]*g[None,:]+rng.random(w))%1.0; u=np.clip(u,TAIL,1-TAIL); z=ndtri(u); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def est(ws,n,seed):
    w=ws[0].shape[0]; h=n//2; hd=dirs(h,w,seed).astype('float32'); S=(hd.T@hd)*(w/h); vals,vecs=np.linalg.eigh(S); vals=np.maximum(vals,1e-8); Wh=(vecs/np.sqrt(vals))@vecs.T
    A=np.concatenate([hd,-hd],0)*np.float32(mean_chi(w)); A=np.maximum(A@(Wh.astype('float32')@ws[0]).astype('float32'),0)
    first=np.sqrt((ws[0]*ws[0]).sum(0))/math.sqrt(2*math.pi); sm=np.maximum(A.astype('float64').mean(0),1e-12); A=(A+(first-sm)[None,:]).astype('float32')
    for li,W in enumerate(ws[1:],1):
        A=np.maximum(A@W,0)
        if li==len(ws)-1:
            lm=A.mean(0); q=h//2; nested=.5*(A[:q].mean(0)+A[h:h+q].mean(0)); return (lm-.05*(lm-nested)).astype('float32')
def tgt(ws,n=100000,seed=0):
    rng=np.random.default_rng(seed); w=ws[0].shape[0]; s=np.zeros(w); done=0
    while done<n:
        m=min(4096,n-done); A=rng.standard_normal((m,w)).astype('float32')
        for W in ws: A=np.maximum(A@W,0)
        s+=A.astype('float64').sum(0); done+=m
    return (s/n).astype('float32')
def ws(seed,w=256,d=32):
    rng=np.random.default_rng(seed); scale=math.sqrt(2/w); return [(rng.standard_normal((w,w)).astype('float32')*scale) for _ in range(d)]
fracs=[.11,.13,.16,.20,.25,.30]
errs={f:[] for f in fracs}; t=time.time()
for mi in range(4):
    W=ws(300+mi); T=tgt(W,80000,700+mi); print('target',mi,time.time()-t)
    for f in fracs:
        p=est(W,count(f),900+mi); errs[f].append(np.mean((p-T)**2))
    print('done',mi,time.time()-t)
for f in fracs:
    a=np.array(errs[f]); print(f,'n',count(f),'mse',a.mean(),'adj~',a.mean()*max(.1,f),a)
PY" in /opt/tiger/discover/workspace

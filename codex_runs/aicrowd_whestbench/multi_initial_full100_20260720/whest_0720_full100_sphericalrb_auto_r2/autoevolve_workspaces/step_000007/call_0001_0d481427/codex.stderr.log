codex
A more promising analytic path is a full-covariance Gaussian closure: propagate exact scalar ReLU means/variances and approximate off-diagonal covariance with gate-probability linearization. I’ll test that locally as a possible low-cost control variate before trying it in the hidden evaluator.
exec
/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
from scipy import stats

TAIL=1e-11; K=11; MOD=104729

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def lattice_gen(w): return np.array([pow(K,i,MOD)/MOD for i in range(w)], dtype=np.float64)
def qmc_dirs(n,w,rng,g):
    u=(np.arange(n,dtype=np.float64)[:,None]*g[None,:]+rng.random(w)[None,:])%1.0
    z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); r=np.sqrt(np.maximum((z*z).sum(1),1e-24)); return z/r[:,None]
def whiten(d):
    n,w=d.shape; M=d.T@d*(w/n); vals,vecs=np.linalg.eigh(M); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact_first(W): return np.sqrt((W*W).sum(0))/np.sqrt(2*np.pi)
def relu_mom(mu,var):
    std=np.sqrt(np.maximum(var,1e-12)); a=mu/std; Phi=stats.norm.cdf(a); phi=stats.norm.pdf(a)
    return std*phi+mu*Phi, (var+mu*mu)*Phi+mu*std*phi, Phi

def full_lin(weights):
    w=weights[0].shape[0]
    m=np.zeros(w); C=np.eye(w)
    for W in weights:
        mu=m@W
        PC=W.T@C@W
        var=np.maximum(np.diag(PC),1e-12)
        m2,q,gate=relu_mom(mu,var)
        C2=PC*(gate[:,None]*gate[None,:])
        np.fill_diagonal(C2, np.maximum(q-m2*m2,0))
        m,C=m2,C2
    return m

def full_zero_arc(weights):
    # zero-mean arc-cos covariance closure: ignores pre_mean for cov but scalar mean with zero mean
    w=weights[0].shape[0]
    S=np.eye(w) # second moment
    m=None
    for W in weights:
        M=W.T@S@W
        d=np.maximum(np.diag(M),1e-12); sd=np.sqrt(d)
        corr=M/(sd[:,None]*sd[None,:]); corr=np.clip(corr,-1,1)
        theta=np.arccos(corr)
        S=(sd[:,None]*sd[None,:])/(2*np.pi)*(np.sqrt(np.maximum(1-corr*corr,0))+(np.pi-theta)*corr)
        m=np.sqrt(d)/np.sqrt(2*np.pi)
        np.fill_diagonal(S,0.5*d)
    return m

def qmc_pred(weights,n,p=0.64,ext=-0.07):
    w=weights[0].shape[0]; half=n//2; rng=np.random.default_rng(123); g=lattice_gen(w)
    hd=qmc_dirs(half,w,rng,g); A=whiten(hd); x=np.concatenate([hd,-hd],0)*mean_chi(w)
    x=np.maximum(x@(A@weights[0]),0); first=exact_first(weights[0]); x*=((first/np.maximum(x.mean(0),1e-12))**p)[None,:]
    for W in weights[1:]: x=np.maximum(x@W,0)
    lm=x.mean(0); q=half//2; nm=0.5*(x[:q].mean(0)+x[half:half+q].mean(0)); return lm+ext*(lm-nm)

def target(weights,N=300000,chunk=8192):
    w=weights[0].shape[0]; rng=np.random.default_rng(999); s=np.zeros(w); done=0
    while done<N:
        n=min(chunk,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=n
    return s/N

def run(width=64,depth=32,n_mlps=8,nq=4096,nt=200000):
    rng=np.random.default_rng(77); labels=['qmc','full_lin','zero_arc']
    blends=[0,0.01,0.02,0.05,0.1,0.2]
    mse={k:[] for k in labels}; blend_lin={b:[] for b in blends}; blend_arc={b:[] for b in blends}
    t=time.time()
    for i in range(n_mlps):
        weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        y=target(weights,nt)
        q=qmc_pred(weights,nq); fl=full_lin(weights); za=full_zero_arc(weights)
        mse['qmc'].append(np.mean((q-y)**2)); mse['full_lin'].append(np.mean((fl-y)**2)); mse['zero_arc'].append(np.mean((za-y)**2))
        for b in blends:
            blend_lin[b].append(np.mean(((1-b)*q+b*fl-y)**2))
            blend_arc[b].append(np.mean(((1-b)*q+b*za-y)**2))
        print('mlp',i,'q',mse['qmc'][-1],'lin',mse['full_lin'][-1],'arc',mse['zero_arc'][-1], 'time',time.time()-t, flush=True)
    print('means')
    for k in labels: print(k, np.mean(mse[k]))
    print('blend_lin')
    for b in blends: print(b, np.mean(blend_lin[b]))
    print('blend_arc')
    for b in blends: print(b, np.mean(blend_arc[b]))
run()

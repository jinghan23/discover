codex
The local experiment will be intentionally smaller than the hidden suite, so I’ll treat it only as a direction check, not as a source of challenge-specific constants.
exec
/bin/bash -lc "python - <<'PY'
import math, time
import numpy as np
from scipy import stats

TARGET_FRACTION=0.13
TAIL=1e-11
K=11; MOD=104729

def mean_chi(d):
    return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))

def lattice_gen(w):
    return np.array([pow(K,i,MOD)/MOD for i in range(w)], dtype=np.float64)

def qmc_dirs(n,w,rng,g):
    shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*g[None,:]+shift[None,:])%1.0
    z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL))
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def whiten(dirs):
    n,w=dirs.shape
    M=dirs.T@dirs*(w/n)
    vals,vecs=np.linalg.eigh(M)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first(w):
    sd=np.sqrt(np.sum(w*w,axis=0))
    return sd/np.sqrt(2*np.pi)

def relu_mom(mu,var):
    std=np.sqrt(np.maximum(var,1e-12))
    a=mu/std
    Phi=stats.norm.cdf(a); phi=stats.norm.pdf(a)
    m=std*phi+mu*Phi
    q=(var+mu*mu)*Phi+mu*std*phi
    return m,q

def diag_analytic(weights):
    W0=weights[0]
    v=np.sum(W0*W0,axis=0)
    m=np.sqrt(v)/np.sqrt(2*np.pi)
    q=0.5*v
    for W in weights[1:]:
        centered=np.maximum(q-m*m,0)
        mu=m@W
        var=centered@(W*W)
        m,q=relu_mom(mu,var)
    return m

def qmc_pred(weights,n,p=0.66,ext=-0.07,blend=0.0):
    w=weights[0].shape[0]; half=n//2
    rng=np.random.default_rng(123)
    g=lattice_gen(w)
    hd=qmc_dirs(half,w,rng,g)
    A=whiten(hd)
    fw=A@weights[0]
    dirs=np.concatenate([hd,-hd],axis=0)
    x=dirs*mean_chi(w)
    x=np.maximum(x@fw,0)
    first=exact_first(weights[0])
    sm=np.maximum(x.mean(axis=0),1e-12)
    x=x*((first/sm)**p)[None,:]
    for li,W in enumerate(weights[1:],start=1):
        x=np.maximum(x@W,0)
    lm=x.mean(axis=0)
    if half>=2:
        q=half//2
        nm=0.5*(x[:q].mean(axis=0)+x[half:half+q].mean(axis=0))
        lm=lm+ext*(lm-nm)
    if blend:
        am=diag_analytic(weights)
        lm=(1-blend)*lm+blend*am
    return lm

def target(weights,N=100000,chunk=8192):
    w=weights[0].shape[0]
    rng=np.random.default_rng(999)
    s=np.zeros(w,dtype=np.float64); done=0
    while done<N:
        n=min(chunk,N-done)
        x=rng.standard_normal((n,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(axis=0)
        done+=n
    return s/N

def run(width=64,depth=32,n_mlps=5,nq=4096,nt=200000):
    rng=np.random.default_rng(42)
    blends=[0,0.02,0.05,0.1,0.2,0.4,0.8,1.0]
    mses={b:[] for b in blends}
    mses_p={}
    t=time.time()
    for i in range(n_mlps):
        scale=np.sqrt(2/width).astype(np.float32) if hasattr(np.sqrt(2/width),'astype') else np.sqrt(2/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        y=target(weights,nt)
        for b in blends:
            pred=qmc_pred(weights,nq,p=0.66,ext=-0.07,blend=b)
            mses[b].append(np.mean((pred-y)**2))
        print('mlp',i,'done',time.time()-t, flush=True)
    print('width depth nq nt',width,depth,nq,nt)
    for b in blends:
        print(b, np.mean(mses[b]), mses[b])

run()

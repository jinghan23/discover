     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    standard_deviation = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    return relu_mean, relu_second
+
+
+def _diagonal_gaussian_final_mean(mlp) -> fnp.ndarray:
+    first_variance = fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0)
+    mean = first_variance / fnp.sqrt(2.0 * fnp.pi * first_variance)
+    second = 0.5 * first_variance
+
+    for weights in mlp.weights[1:]:
+        centered_second = fnp.maximum(second - mean * mean, 0.0)
+        preactivation_mean = mean @ weights
+        preactivation_variance = centered_second @ (weights * weights)
+        mean, second = _relu_gaussian_moments(
+            preactivation_mean, preactivation_variance
+        )
+    return mean
+
+

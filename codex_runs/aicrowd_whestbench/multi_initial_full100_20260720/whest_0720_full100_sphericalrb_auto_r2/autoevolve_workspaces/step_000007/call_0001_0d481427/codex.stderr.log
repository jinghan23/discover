import math,time
import numpy as np
from scipy import stats
TAIL=1e-11; K=11; MOD=104729

def mean_chi(d): return math.sqrt(2)*math.exp(math.lgamma(d/2+0.5)-math.lgamma(d/2))
def gen(w): return np.array([pow(K,i,MOD)/MOD for i in range(w)])
def qmc(n,w,rng,g):
 u=(np.arange(n)[:,None]*g[None,:]+rng.random(w)[None,:])%1.0
 z=stats.norm.ppf(np.clip(u,TAIL,1-TAIL)); return z/np.sqrt(np.maximum((z*z).sum(1),1e-24))[:,None]
def whiten(d):
 n,w=d.shape; M=d.T@d*(w/n); vals,vecs=np.linalg.eigh(M); vals=np.maximum(vals,1e-8); return (vecs/np.sqrt(vals))@vecs.T
def exact(W): return np.sqrt((W*W).sum(0))/np.sqrt(2*np.pi)
def relu_gauss(mu,var):
 std=np.sqrt(np.maximum(var,1e-12)); a=mu/std
 return std*stats.norm.pdf(a)+mu*stats.norm.cdf(a)
def pred_pair(weights,n=4096,p=0.64,ext=-0.07):
 w=weights[0].shape[0]; half=n//2; rng=np.random.default_rng(123); g=gen(w); hd=qmc(half,w,rng,g); A=whiten(hd)
 x=np.concatenate([hd,-hd])*mean_chi(w); x=np.maximum(x@(A@weights[0]),0); fm=exact(weights[0]); x*=((fm/np.maximum(x.mean(0),1e-12))**p)[None,:]
 for W in weights[1:-1]: x=np.maximum(x@W,0)
 z=x@weights[-1]
 y=np.maximum(z,0)
 lm=y.mean(0); q=half//2; nm=0.5*(y[:q].mean(0)+y[half:half+q].mean(0)); sample=lm+ext*(lm-nm)
 mu=z.mean(0); var=np.maximum((z*z).mean(0)-mu*mu,0); gauss=relu_gauss(mu,var)
 return sample,gauss
def target(weights,N=200000,chunk=8192):
 w=weights[0].shape[0]; rng=np.random.default_rng(999); s=np.zeros(w); done=0
 while done<N:
  n=min(chunk,N-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/N
bl=[0,0.02,0.05,0.1,0.2,0.5,1]
rng=np.random.default_rng(444); width=64; depth=32; nmlp=8
ms={b:[] for b in bl}; ga=[]; t=time.time()
for i in range(nmlp):
 weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
 y=target(weights); sample,gm=pred_pair(weights)
 for b in bl:
  pr=(1-b)*sample+b*gm; ms[b].append(np.mean((pr-y)**2))
 print('mlp',i,'base',ms[0][-1],'gauss',ms[1][-1],'best',min((ms[b][-1],b) for b in bl),'time',time.time()-t,flush=True)
print('means')
for b in bl: print(b,np.mean(ms[b]))

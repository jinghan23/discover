 from whestbench import BaseEstimator
 
 
-_TARGET_FLOP_FRACTION = 0.10
+_TARGET_FLOP_FRACTION = 0.20
 _MAX_WORKING_SET_BYTES = 100 * 1024 * 1024
 _FLOAT64_ITEMSIZE = 8
 _TAIL_CLIP = 1e-11
@@ -16,6 +16,7 @@
 _KOROBOV_MULTIPLIER = 5
 _KOROBOV_MODULUS = 104729
 _SEED_OFFSET = 7919
+_SECOND_LAYER_BLEND = 0.5
 
 
 def _mean_chi(dimension: int) -> float:
@@ -30,6 +31,27 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _gaussian_second_layer_mean(
+    first_weights: fnp.ndarray, second_weights: fnp.ndarray, first_mean: fnp.ndarray
+) -> fnp.ndarray:
+    gram = first_weights.T @ first_weights
+    standard_deviation = fnp.sqrt(fnp.maximum(fnp.diag(gram), 1e-24))
+    denominator = fnp.maximum(fnp.outer(standard_deviation, standard_deviation), 1e-24)
+    correlation = fnp.clip(gram / denominator, -1.0, 1.0)
+    root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    relu_second_moment = (
+        denominator
+        * (root + (fnp.pi - fnp.arccos(correlation)) * correlation)
+        / (2.0 * fnp.pi)
+    )
+    covariance = relu_second_moment - fnp.outer(first_mean, first_mean)
+    mean_pre = first_mean @ second_weights
+    variance_pre = fnp.maximum(fnp.sum(second_weights * (covariance @ second_weights), axis=0), 1e-12)
+    sigma_pre = fnp.sqrt(variance_pre)
+    alpha = mean_pre / sigma_pre
+    return mean_pre * flops.stats.norm.cdf(alpha) + sigma_pre * flops.stats.norm.pdf(alpha)
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     half_lattice_per_sample = (89 * width + 3 * width + 2) // 2
     layer_per_sample = depth * (2 * width * width + 2 * width)
@@ -92,9 +114,24 @@
 

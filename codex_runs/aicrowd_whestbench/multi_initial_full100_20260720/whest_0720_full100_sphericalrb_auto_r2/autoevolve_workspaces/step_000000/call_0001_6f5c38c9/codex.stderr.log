import math, time
import numpy as np
from scipy.stats import norm

w=256; d=32

def primes(count):
    ps=[]; c=2
    while len(ps)<count:
        ok=True
        for p in ps:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: ps.append(c)
        c+=1
    return np.array(ps,dtype=np.float64)
gen=np.sqrt(primes(w))%1
mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))

def lattice_dirs(n, seed):
    rng=np.random.default_rng(seed); shift=rng.random(w)
    u=(np.arange(n,dtype=np.float64)[:,None]*gen[None,:]+shift[None,:])%1
    z=norm.ppf(np.clip(u,1e-11,1-1e-11)); r=np.sqrt(np.sum(z*z,1))
    return z/r[:,None]
def whiten(dirs):
    S=dirs.T@dirs*(w/dirs.shape[0]); ev,Q=np.linalg.eigh(S); ev=np.maximum(ev,1e-8); return (Q/np.sqrt(ev))@Q.T
def exact_first(W): return np.sqrt(np.sum(W*W,0))/math.sqrt(2*math.pi)

def estimate(weights,n,rep,base_seed):
    per_half=(n//2)//rep
    acts=[]
    for r in range(rep):
        dirs=lattice_dirs(per_half, base_seed+1009*r)
        A=whiten(dirs); W0=A@weights[0]
        dirs=np.concatenate([dirs,-dirs],0)
        acts.append(np.maximum((dirs*mean_chi)@W0,0))
    a=np.concatenate(acts,0)
    for W in weights[1:]:
        a=np.maximum(a@W,0)
    return a.mean(0)

def mc(weights,N=120000,batch=4096):
    rng=np.random.default_rng(999); total=np.zeros(w); c=0
    for s in range(0,N,batch):
        n=min(batch,N-s); a=rng.standard_normal((n,w))
        for W in weights: a=np.maximum(a@W,0)
        total+=a.sum(0); c+=n
    return total/c
for mlp_seed in [0,1,2]:
    rng=np.random.default_rng(100+mlp_seed)
    weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
    truth=mc(weights,80000)
    print('MLP',mlp_seed)
    for n in [4096,6292,8192]:
      vals=[]
      for rep in [1,2,4]:
        st=time.time(); est=estimate(weights,n,rep,777+mlp_seed); vals.append((rep,np.mean((est-truth)**2),time.time()-st))
      print('n',n,vals)

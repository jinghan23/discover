import math, time
import numpy as np
from scipy.stats import norm
w=256; d=32

def full_zero(weights):
 S=np.eye(w); rows=[]
 for W in weights:
  K=W.T@S@W
  diag=np.maximum(np.diag(K),1e-12)
  sigma=np.sqrt(diag)
  rho=K/(sigma[:,None]*sigma[None,:])
  rho=np.clip(rho,-1,1)
  theta=np.arccos(rho)
  J=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)/(2*math.pi)
  S=(sigma[:,None]*sigma[None,:])*J
  rows.append(sigma/math.sqrt(2*math.pi))
 return rows[-1]

def diag(weights):
 m=np.zeros(w); v=np.ones(w)
 for W in weights:
  pm=W.T@m; pv=np.maximum((W*W).T@v,1e-12); s=np.sqrt(pv); a=pm/s; p=norm.cdf(a); den=norm.pdf(a)
  m=pm*p+s*den; sec=(pm*pm+pv)*p+pm*s*den; v=np.maximum(sec-m*m,0)
 return m

def mc(weights,N=120000,batch=4096):
 rng=np.random.default_rng(999); total=np.zeros(w); c=0
 for s in range(0,N,batch):
  b=min(batch,N-s); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  total+=a.sum(0); c+=b
 return total/c
for mlp_seed in range(5):

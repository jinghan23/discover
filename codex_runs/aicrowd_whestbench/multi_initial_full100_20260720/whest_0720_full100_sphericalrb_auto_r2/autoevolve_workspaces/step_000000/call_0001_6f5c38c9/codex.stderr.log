def est(weights,seed,kind,white):
 if kind=='lat': D=lattice(seed,n//2)
 elif kind=='rad': D=radem(seed,n//2)
 else: D=had(seed,n//2)
 W0=weights[0]
 if white: W0=whiten(D)@W0
 a=np.concatenate([D,-D],0)*mean_chi
 for i,W in enumerate(weights): a=np.maximum(a@(W0 if i==0 else W),0)
 return a.mean(0)
def mc(weights,N=80000,batch=4096):

import math, time
import numpy as np
from scipy.stats import norm

w=256; d=32; seed=123
rng=np.random.default_rng(seed)
weights=[rng.standard_normal((w,w)).astype(np.float64)*math.sqrt(2/w) for _ in range(d)]

def primes(count):
    ps=[]; c=2
    while len(ps)<count:
        ok=True
        for p in ps:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: ps.append(c)
        c+=1
    return np.array(ps,dtype=np.float64)
roots=np.sqrt(primes(w)); gen=roots-np.floor(roots)
mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))

def lattice_dirs(n, seed):
    rng=np.random.default_rng(seed)
    shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=(idx*gen[None,:]+shift[None,:])%1.0
    z=norm.ppf(np.clip(u,1e-11,1-1e-11))
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def whiten(dirs):
    n=dirs.shape[0]
    S=dirs.T@dirs*(w/n)
    ev,Q=np.linalg.eigh(S)
    ev=np.maximum(ev,1e-8)
    return (Q/np.sqrt(ev))@Q.T

def exact_first(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def relu_gauss(m,v):
    v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s
    return m*norm.cdf(a)+s*norm.pdf(a)

def qmc(n, terminal='direct', blend=0.0, whitened=True):
    half=n//2
    dirs=lattice_dirs(half, seed+7)
    W0=weights[0]
    if whitened:
        A=whiten(dirs); W0=A@W0
    dirs=np.concatenate([dirs,-dirs],0)
    a=dirs*mean_chi
    rows=[]
    a=np.maximum(a@W0,0)
    rows.append(exact_first(weights[0]))
    for W in weights[1:-1]:
        a=np.maximum(a@W,0)
        rows.append(a.mean(0))
    W=weights[-1]
    z=a@W
    direct=np.maximum(z,0).mean(0)
    if terminal=='direct':
        final=direct
    else:
        mu=a.mean(0)
        S=a.T@a/n
        pm=W.T@mu
        ps=np.sum((S@W)*W,axis=0)
        gv=relu_gauss(pm,ps-pm*pm)
        if terminal=='gauss': final=gv
        elif terminal=='blend': final=(1-blend)*direct+blend*gv
    return final

def diag():
    m=np.zeros(w); v=np.ones(w)
    for W in weights:
        pm=W.T@m; pv=np.maximum((W*W).T@v,1e-12)
        s=np.sqrt(pv); a=pm/s; p=norm.cdf(a); den=norm.pdf(a)
        m=pm*p+s*den
        sec=(pm*pm+pv)*p+pm*s*den
        v=np.maximum(sec-m*m,0)
    return m

def mc(N, batch=4096):
    total=np.zeros(w); count=0
    rng=np.random.default_rng(999)
    for start in range(0,N,batch):
        n=min(batch,N-start)
        a=rng.standard_normal((n,w))
        for W in weights:
            a=np.maximum(a@W,0)
        total += a.sum(0); count += n
    return total/count

st=time.time(); truth=mc(120000,4096); print('truth',time.time()-st,truth.mean(),truth.std())
base=diag(); print('diag mse',np.mean((base-truth)**2))
for n in [1024,2048,4096,6144,8192,12288]:
    for term in ['direct','gauss']:
        st=time.time(); est=qmc(n,terminal=term); print(n,term,'mse',np.mean((est-truth)**2),'time',time.time()-st)
    for b in [0.25,0.5,0.75]:

import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292

def primes(c):
 ps=[]; x=2
 while len(ps)<c:
  ok=True
  for p in ps:
   if p*p>x: break
   if x%p==0: ok=False; break
  if ok: ps.append(x)
  x+=1
 return np.array(ps,float)
gen=np.sqrt(primes(w))%1; mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))
def dirs(seed):
 rng=np.random.default_rng(seed); shift=rng.random(w); u=(np.arange(n//2)[:,None]*gen[None,:]+shift)%1; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def whiten(D):
 S=D.T@D*(w/D.shape[0]); ev,Q=np.linalg.eigh(S); return (Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
def exact_m(W): return np.sqrt(np.sum(W*W,0))/math.sqrt(2*math.pi)
def exact_s2(W): return np.sum(W*W,0)*0.5
def est(weights,seed,mode):
 D=dirs(seed); A=whiten(D); W0=A@weights[0]; X=np.concatenate([D,-D],0)*mean_chi
 a=np.maximum(X@W0,0)
 if mode=='mean':
  a=a*(exact_m(weights[0])/np.maximum(a.mean(0),1e-12))
 elif mode=='second':
  a=a*np.sqrt(exact_s2(weights[0])/np.maximum((a*a).mean(0),1e-12))
 elif mode=='both':
  # affine per neuron to match mean and second, clipped to preserve nonnegativity less often.
  m=a.mean(0); s2=(a*a).mean(0); tm=exact_m(weights[0]); ts2=exact_s2(weights[0])
  var=np.maximum(s2-m*m,1e-12); tvar=np.maximum(ts2-tm*tm,1e-12)
  a=(a-m)*np.sqrt(tvar/var)+tm
  a=np.maximum(a,0)

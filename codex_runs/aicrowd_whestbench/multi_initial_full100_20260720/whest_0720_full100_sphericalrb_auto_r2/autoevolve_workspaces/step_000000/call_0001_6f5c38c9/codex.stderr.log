import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292

def primes(count):
 ps=[]; c=2
 while len(ps)<count:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps,float)
gen=np.sqrt(primes(w))%1
mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))
def dirs(seed,half):
 rng=np.random.default_rng(seed); shift=rng.random(w)
 u=(np.arange(half,dtype=float)[:,None]*gen[None,:]+shift[None,:])%1
 z=norm.ppf(np.clip(u,1e-11,1-1e-11)); r=np.sqrt(np.sum(z*z,1)); return z/r[:,None]
def whiten(D):
 S=D.T@D*(w/D.shape[0]); ev,Q=np.linalg.eigh(S); return (Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
def diag_pre(weights):
 m=np.zeros(w); v=np.ones(w)
 pres=None
 for W in weights:
  pm=W.T@m; pv=np.maximum((W*W).T@v,1e-12); pres=(pm,pv)
  s=np.sqrt(pv); a=pm/s; p=norm.cdf(a); den=norm.pdf(a)
  m=pm*p+s*den; sec=(pm*pm+pv)*p+pm*s*den; v=np.maximum(sec-m*m,0)
 return m,v,pres
def qmc_z(weights,seed):
 D=dirs(seed,n//2); A=whiten(D); W0=A@weights[0]
 D=np.concatenate([D,-D],0); X=D*mean_chi
 a=np.maximum(X@W0,0)
 for W in weights[1:-1]: a=np.maximum(a@W,0)
 z=a@weights[-1]
 return z

def mc(weights,N=120000,batch=4096):
 rng=np.random.default_rng(999); total=np.zeros(w); c=0
 for s in range(0,N,batch):
  b=min(batch,N-s); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  total+=a.sum(0); c+=b
 return total/c
for mlp_seed in range(5):
 rng=np.random.default_rng(500+mlp_seed); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
 truth=mc(weights,80000)
 z=qmc_z(weights,1234+mlp_seed); direct=np.maximum(z,0).mean(0); sm=z.mean(0); sv=z.var(0)
 m,v,(dpm,dpv)=diag_pre(weights); prob=norm.cdf(dpm/np.sqrt(dpv))
 print('mlp',mlp_seed,'direct',np.mean((direct-truth)**2),'diag',np.mean((m-truth)**2))
 for scale in [0.25,0.5,0.75,1.0,1.25]:
  est=direct-scale*prob*(sm-dpm)
  print(' scale',scale,np.mean((est-truth)**2))
 # sample prob variant? known mean dpm but beta from sample
 p2=norm.cdf(sm/np.sqrt(np.maximum(sv,1e-12)))
 for scale in [0.5,1.0]:
  est=direct-scale*p2*(sm-dpm)
  print(' samplep',scale,np.mean((est-truth)**2))

/bin/bash -lc "python - <<'PY'
import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292

def primes(count):
 ps=[]; c=2
 while len(ps)<count:
  ok=True
  for p in ps:
   if p*p>c: break
   if c%p==0: ok=False; break
  if ok: ps.append(c)
  c+=1
 return np.array(ps,float)
gen=np.sqrt(primes(w))%1; mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))
def lattice(seed,half):
 rng=np.random.default_rng(seed); shift=rng.random(w); u=(np.arange(half)[:,None]*gen[None,:]+shift)%1; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def pseudo(seed,half):
 rng=np.random.default_rng(seed); z=rng.standard_normal((half,w)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def whiten(D):
 S=D.T@D*(w/D.shape[0]); ev,Q=np.linalg.eigh(S); return (Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
def est(weights,seed,kind,white=True):
 D=(lattice if kind=='lat' else pseudo)(seed,n//2)
 W0=weights[0]
 if white: W0=whiten(D)@W0
 D=np.concatenate([D,-D],0); a=D*mean_chi
 for i,W in enumerate(weights):
  a=np.maximum(a@(W0 if i==0 else W),0)
 return a.mean(0)
def mc(weights,N=100000,batch=4096):
 rng=np.random.default_rng(999); total=np.zeros(w); c=0
 for s in range(0,N,batch):
  b=min(batch,N-s); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  total+=a.sum(0); c+=b
 return total/c
for mlp_seed in range(6):
 rng=np.random.default_rng(700+mlp_seed); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
 truth=mc(weights,80000)
 print('MLP',mlp_seed)
 for kind in ['lat','rnd']:
  for white in [False,True]:
   ms=[]
   for off in [0,10000,20000]:
    e=est(weights,123+mlp_seed+off,kind,white)
    ms.append(np.mean((e-truth)**2))
   print(kind,white,ms,'avg',sum(ms)/len(ms))

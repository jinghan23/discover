/bin/bash -lc "python - <<'PY'
import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292

def primes(c):
 ps=[]; x=2
 while len(ps)<c:
  ok=True
  for p in ps:
   if p*p>x: break
   if x%p==0: ok=False; break
  if ok: ps.append(x)
  x+=1
 return np.array(ps,float)
gen=np.sqrt(primes(w))%1; mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))
def dirs(seed):
 rng=np.random.default_rng(seed); shift=rng.random(w); u=(np.arange(n//2)[:,None]*gen[None,:]+shift)%1; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def whiten(D):
 S=D.T@D*(w/D.shape[0]); ev,Q=np.linalg.eigh(S); return (Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
def est(weights,seed,t):
 D=dirs(seed); A=whiten(D); B=(1-t)*np.eye(w)+t*A; W0=B@weights[0]
 X=np.concatenate([D,-D],0)*mean_chi
 a=np.maximum(X@W0,0)
 for W in weights[1:]: a=np.maximum(a@W,0)
 return a.mean(0)
def mc(weights,N=80000,batch=4096):
 rng=np.random.default_rng(999); total=np.zeros(w); c=0
 for s in range(0,N,batch):
  b=min(batch,N-s); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  total+=a.sum(0); c+=b
 return total/c
Ts=[0,0.25,0.5,0.75,1.0,1.25]
avg={t:[] for t in Ts}
for mlp_seed in range(8):
 rng=np.random.default_rng(1100+mlp_seed); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
 truth=mc(weights)
 print('MLP',mlp_seed)
 for t in Ts:
  e=est(weights,321+mlp_seed,t); mse=np.mean((e-truth)**2); avg[t].append(mse); print(t,mse)
print('avg')
for t in Ts: print(t,sum(avg[t])/len(avg[t]))

/bin/bash -lc "python - <<'PY'
import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292; mod=104729
mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))
g5=np.array([pow(5,j,mod)/mod for j in range(w)],float)
g13=np.array([pow(13,j,mod)/mod for j in range(w)],float)

def dirs_gen(seed,gen,m):
 rng=np.random.default_rng(seed); shift=rng.random(w); u=(np.arange(m,dtype=float)[:,None]*gen[None,:]+shift)%1; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def dirs(seed,kind):
 half=n//2
 if kind=='g5': return dirs_gen(seed,g5,half)
 if kind=='g13': return dirs_gen(seed,g13,half)
 return np.concatenate([dirs_gen(seed,g5,half//2), dirs_gen(seed+7919,g13,half-half//2)],0)
def whiten(D):
 S=D.T@D*(w/D.shape[0]); ev,Q=np.linalg.eigh(S); return (Q/np.sqrt(np.maximum(ev,1e-8)))@Q.T
def est(weights,seed,kind):
 D=dirs(seed,kind); W0=whiten(D)@weights[0]; a=np.concatenate([D,-D],0)*mean_chi
 for i,W in enumerate(weights): a=np.maximum(a@(W0 if i==0 else W),0)
 return a.mean(0)
def mc(weights,N=70000,batch=4096):
 rng=np.random.default_rng(999); total=np.zeros(w); c=0
 for s in range(0,N,batch):
  b=min(batch,N-s); a=rng.standard_normal((b,w))
  for W in weights: a=np.maximum(a@W,0)
  total+=a.sum(0); c+=b
 return total/c
avg={k:[] for k in ['g5','g13','mix']}
for mlp_seed in range(8):
 rng=np.random.default_rng(2300+mlp_seed); weights=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
 truth=mc(weights)
 print('MLP',mlp_seed)
 for k in avg:
  e=est(weights,8642+mlp_seed,k); mse=np.mean((e-truth)**2); avg[k].append(mse); print(k,mse)
print('avg')
for k,v in avg.items(): print(k,sum(v)/len(v))

import math
import numpy as np
from scipy.stats import norm
w=256; d=32; n=6292
mean_chi=math.sqrt(2)*math.exp(math.lgamma(w/2+0.5)-math.lgamma(w/2))

def hadamard(n):
 H=np.array([[1.0]])
 while H.shape[0]<n:
  H=np.block([[H,H],[H,-H]])
 return H
H=hadamard(w)/math.sqrt(w)

def primes(c):
 ps=[]; x=2
 while len(ps)<c:
  ok=True
  for p in ps:
   if p*p>x: break
   if x%p==0: ok=False; break
  if ok: ps.append(x)
  x+=1
 return np.array(ps,float)
gen=np.sqrt(primes(w))%1
def lattice(seed,half):
 rng=np.random.default_rng(seed); shift=rng.random(w); u=(np.arange(half)[:,None]*gen[None,:]+shift)%1; z=norm.ppf(np.clip(u,1e-11,1-1e-11)); return z/np.sqrt(np.sum(z*z,1))[:,None]
def radem(seed,half):
 rng=np.random.default_rng(seed); D=rng.choice([-1.0,1.0],size=(half,w))/math.sqrt(w); return D
def had(seed,half):
 rng=np.random.default_rng(seed); blocks=[]
 while sum(b.shape[0] for b in blocks)<half:
  signs=rng.choice([-1.0,1.0],size=w)
  perm=rng.permutation(w)
  blocks.append((H*signs)[ :, perm])

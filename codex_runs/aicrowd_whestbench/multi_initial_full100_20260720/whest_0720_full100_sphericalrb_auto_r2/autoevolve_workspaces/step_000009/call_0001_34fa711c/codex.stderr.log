diff --git a/submission.py b/submission.py
index 2357e2c2daa4053126ac2c71d96ca1cf24f9a788..91ace947119001be9edb4982ab56a36a004d7f6f
--- a/submission.py
+++ b/submission.py
@@ -18,6 +18,7 @@
 _SEED_OFFSET = 0
 _FIRST_MEAN_CORRECTION_POWER = 0.73
 _FINAL_NESTED_EXTRAPOLATION = -0.070
+_DIAGONAL_BLEND = 0.05
 
 
 def _mean_chi(dimension: int) -> float:
@@ -32,6 +33,32 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    standard_deviation = fnp.sqrt(fnp.maximum(variance, 1e-24))
+    alpha = mean / standard_deviation
+    density = flops.stats.norm.pdf(alpha)
+    probability = flops.stats.norm.cdf(alpha)
+    relu_mean = standard_deviation * density + mean * probability
+    relu_second = (mean * mean + variance) * probability + mean * standard_deviation * density
+    return relu_mean, relu_second
+
+
+def _diagonal_gaussian_means(mlp) -> list[fnp.ndarray]:
+    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
+    second = fnp.ones(mlp.width, dtype=fnp.float64)
+    rows = []
+    for weights in mlp.weights:

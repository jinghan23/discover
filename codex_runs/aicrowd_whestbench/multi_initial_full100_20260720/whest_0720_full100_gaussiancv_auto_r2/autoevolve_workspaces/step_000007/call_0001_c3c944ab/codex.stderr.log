One remaining cheap idea is a final-layer control variate: adjust the sampled ReLU mean by the difference between analytic and sampled preactivation means. I’ll screen that locally as a coefficient on `final_mixed_diag - final_gauss`.
exec
/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from pathlib import Path
import types,time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=200000, seed=9090)
print('making')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base=Path('submission.py').read_text()
# ensure original
base=base.replace('z = 1.25 * (z_center @ (inv_sqrt @ target_sqrt)) - 0.25 * z_center','z = z_center @ (inv_sqrt @ target_sqrt)')
variants=[]
old='''final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n        )'''
for c in [-0.2,-0.1,-0.05,-0.02,0.02,0.05,0.1,0.2,0.4]:
    src=base.replace(old, f'''final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n            + {c} * (final_mixed_diag - final_gauss)\\n        )''')
    variants.append((f'mixdiff{c}',src))
# change existing gauss/mixed weights preserving sum between them
for c in [-0.1,-0.05,0.0,0.00549808,0.02,0.05,0.1]:
    # keep final_mc coeff and total gauss+mixed = -0.03699836
    total=-0.04249644+0.00549808
    g=total-c
    src=base.replace(old, f'''final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            + {g} * final_gauss\\n            + {c} * final_mixed_diag\\n        )''')
    variants.append((f'mixw{c}',src))
variants.insert(0,('orig',base))
res=[]
for name,src in variants:
    mod=types.ModuleType(name); exec(compile(src,name+'.py','exec'),mod.__dict__)
    t=time.time(); r=evaluate_estimator(mod.Estimator(),data); dt=time.time()-t
    row=(r['adjusted_final_layer_score'],r['final_layer_mse'],r['mean_score_multiplier'],name,dt)
    res.append(row); print(row)
print('BEST')
for row in sorted(res)[:15]: print(row)

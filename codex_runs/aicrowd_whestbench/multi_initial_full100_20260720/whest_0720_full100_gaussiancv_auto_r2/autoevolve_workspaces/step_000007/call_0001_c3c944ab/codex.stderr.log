/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench.sdk import SetupContext
from pathlib import Path
import types,time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=160000, seed=6060)
print('making')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base=Path('submission.py').read_text()
# variants: setup sample replacing per-mlp rng
setup_method='''\\n    def setup(self, context):\\n        width = int(context.width)\\n        depth = int(context.depth)\\n        per_sample = max(1, depth * (2 * width * width + 4 * width))\\n        n_samples = max(1024, int((0.625 * float(context.flop_budget)) / float(per_sample)))\\n        n_samples = min(n_samples, 7520)\\n        n_samples = 2 * max(1, n_samples // 2)\\n        rng = fnp.random.default_rng(int(context.seed) + 19)\\n        self._setup_x0 = fnp.asarray(rng.standard_normal((n_samples // 2, width), dtype=fnp.float32))\\n'''
setup_src=base.replace('class Estimator(BaseEstimator):\\n', 'class Estimator(BaseEstimator):\\n'+setup_method)
setup_src=setup_src.replace('rng = fnp.random.default_rng(int(mlp.seed) + 3)\\n        eye = fnp.eye(width, dtype=fnp.float64)\\n        half_samples = n_samples // 2\\n        x0 = fnp.asarray(rng.standard_normal((half_samples, width), dtype=fnp.float32))',
'''eye = fnp.eye(width, dtype=fnp.float64)\\n        half_samples = n_samples // 2\\n        base_x0 = getattr(self, \"_setup_x0\", None)\\n        if base_x0 is None or base_x0.shape[0] < half_samples or base_x0.shape[1] "'!= width:'"\\n            rng = fnp.random.default_rng(int(mlp.seed) + 3)\\n            x0 = fnp.asarray(rng.standard_normal((half_samples, width), dtype=fnp.float32))\\n        else:\\n            x0 = base_x0[:half_samples]''')
variants=[('orig',base,False),('setup_common',setup_src,True)]
# setup with common plus mlp seed scalar sign? x0 times sign from seed, no random cost
sign_src=setup_src.replace('x0 = base_x0[:half_samples]', 'x0 = base_x0[:half_samples]\\n            if int(mlp.seed) % 2:\\n                x0 = -x0')
variants.append(('setup_sign',sign_src,True))
for name,src,do_setup in variants:
    mod=types.ModuleType(name); exec(compile(src,name+'.py','exec'),mod.__dict__)
    est=mod.Estimator()
    if do_setup:
        est.setup(SetupContext(width=spec.width,depth=spec.depth,flop_budget=spec.flop_budget,api_version='x',seed=spec.seed or 0))
    t=time.time(); r=evaluate_estimator(est,data); dt=time.time()-t
    print(name,r['adjusted_final_layer_score'],r['final_layer_mse'],r['mean_score_multiplier'],dt)

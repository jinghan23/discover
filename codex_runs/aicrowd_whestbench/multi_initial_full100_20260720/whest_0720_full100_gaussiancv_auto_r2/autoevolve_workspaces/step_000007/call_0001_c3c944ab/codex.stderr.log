from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from pathlib import Path
import types,time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=160000, seed=7070)
print('making')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base=Path('submission.py').read_text()

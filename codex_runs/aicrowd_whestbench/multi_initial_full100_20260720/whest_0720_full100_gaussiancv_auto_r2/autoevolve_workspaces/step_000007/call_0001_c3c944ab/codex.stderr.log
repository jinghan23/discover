from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from pathlib import Path
import types, time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=200000, seed=4040)
print('making data')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base=Path('submission.py').read_text()
# ensure original constants
base=base.replace('int(mlp.seed) + 17','int(mlp.seed) + 3').replace('n_samples = min(n_samples, 7800)','n_samples = min(n_samples, 7520)')
variants=[]
# diag correction inside scale
for c in [-0.20,-0.10,-0.05,-0.02,0.02,0.05,0.10,0.20]:
    src=base.replace('final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n        )',
        f'final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n            + {c} * (diag_rows[-1] - final_mixed_diag)\\n        )')
    variants.append((f'diagdiff{c}',src))
# final_diag direct adjusted preserving sum by subtracting mc? maybe
for c in [-0.05,-0.02,0.02,0.05,0.10]:
    src=base.replace('final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n        )',
        f'final = 0.99938145 * (\\n            {1.03699807-c} * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n            + {c} * diag_rows[-1]\\n        )')
    variants.append((f'diag_swap{c}',src))
# edge corrections
insert='''final_mc = fnp.sum(fnp.maximum(z64, 0.0), axis=0) / float(n_samples)'''
edge_code='''final_mc = fnp.sum(fnp.maximum(z64, 0.0), axis=0) / float(n_samples)\\n        z2c = z_center * z_center\\n        inv_z_sigma = 1.0 / fnp.maximum(z_sigma, 1e-12)\\n        z_skew = fnp.mean(z2c * z_center, axis=0) * inv_z_sigma * inv_z_sigma * inv_z_sigma\\n        z_exkurt = fnp.mean(z2c * z2c, axis=0) * inv_z_sigma * inv_z_sigma * inv_z_sigma * inv_z_sigma - 3.0\\n        edge3 = -z_sigma * z_skew * z_alpha * z_phi / 6.0\\n        edge4 = z_sigma * z_exkurt * (z_alpha * z_alpha - 1.0) * z_phi / 24.0'''
for c3 in [-1.0,-0.5,-0.2,0.2,0.5,1.0]:
    src=base.replace(insert, edge_code).replace('final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n        )',
        f'final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n            + {c3} * edge3\\n        )')
    variants.append((f'edge3_{c3}',src))
for c4 in [-1.0,-0.5,-0.2,0.2,0.5,1.0]:
    src=base.replace(insert, edge_code).replace('final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n        )',
        f'final = 0.99938145 * (\\n            1.03699807 * final_mc\\n            - 0.04249644 * final_gauss\\n            + 0.00549808 * final_mixed_diag\\n            + {c4} * edge4\\n        )')
    variants.append((f'edge4_{c4}',src))
# original
variants.insert(0,('orig',base))
results=[]
for name,src in variants:
    mod=types.ModuleType(name)
    exec(compile(src,name+'.py','exec'),mod.__dict__)
    t=time.time(); res=evaluate_estimator(mod.Estimator(), data); dt=time.time()-t
    row=(res['adjusted_final_layer_score'],res['final_layer_mse'],res['mean_score_multiplier'],name,dt)
    results.append(row)
    print(row)
print('\\nBEST')
for r in sorted(results)[:20]: print(r)

old='z = z_center @ (inv_sqrt @ target_sqrt)'
variants=[]
for b in [0.0,0.25,0.5,0.75,0.9,1.0,1.1,1.25,1.5]:
    if b==1.0:
        src=base
    else:
        src=base.replace(old, f'z = {b} * (z_center @ (inv_sqrt @ target_sqrt)) + {1-b} * z_center', 1)
    variants.append((f'preb{b}',src))

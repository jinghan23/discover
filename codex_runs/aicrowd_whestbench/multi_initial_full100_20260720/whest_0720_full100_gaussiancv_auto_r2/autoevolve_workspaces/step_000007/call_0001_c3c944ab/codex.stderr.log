exec
/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from pathlib import Path
import types,time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=200000, seed=5050)
print('making')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base=Path('submission.py').read_text()
# remove configure and ensure no edge (if present no, but configure yes)
base=base.replace('\\nflops.configure(symmetry_warnings=False)\\n','\\n')
variants=[]
for m in [-0.30,-0.20,-0.15,-0.10,-0.05,0.0,0.05,0.10,0.20]:
    # expression is diag_rows[0] - 0.100 * err; coefficient k on err
    src=base.replace('diag_rows[0]\\n                    - 0.100 * (x_mean0 - diag_rows[0])', f'diag_rows[0]\\n                    + {m} * (x_mean0 - diag_rows[0])')
    variants.append((f'm{m}',src))
# alpha + mean combos local promising maybe
for m,a in [(-0.2,1.36),(-0.2,1.43645),(-0.15,1.36),(-0.05,1.36),(0.0,1.36)]:
    b=1-a
    src=base.replace('diag_rows[0]\\n                    - 0.100 * (x_mean0 - diag_rows[0])', f'diag_rows[0]\\n                    + {m} * (x_mean0 - diag_rows[0])')
    src=src.replace('1.43645 * (x_full - diag_rows[0])\\n                    - 0.43645 * x_center', f'{a} * (x_full - diag_rows[0])\\n                    + {b} * x_center')
    variants.append((f'm{m}_a{a}',src))
res=[]
for name,src in variants:
    mod=types.ModuleType(name); exec(compile(src,name+'.py','exec'),mod.__dict__)
    t=time.time(); r=evaluate_estimator(mod.Estimator(),data); dt=time.time()-t
    row=(r['adjusted_final_layer_score'],r['final_layer_mse'],r['mean_score_multiplier'],name,dt)
    res.append(row); print(row)
print('BEST')
for row in sorted(res)[:15]: print(row)
PY" in /opt/tiger/discover/workspace

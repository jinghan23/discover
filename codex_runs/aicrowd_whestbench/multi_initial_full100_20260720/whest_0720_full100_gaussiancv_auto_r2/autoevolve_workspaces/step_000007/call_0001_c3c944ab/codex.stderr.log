/bin/bash -lc "python - <<'PY'
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from pathlib import Path
import types, time
spec=ContestSpec(width=256, depth=32, n_mlps=4, flop_budget=272_000_000_000, ground_truth_samples=150000, seed=3030)
print('making data')
t=time.time(); data=make_contest(spec); print('gt',time.time()-t)
base_src=Path('submission.py').read_text()
variants=[]
# cap variants
for cap in [6000,6500,7000,7250,7400,7520,7650,7800,8200,9000,10000]:
    src=base_src.replace('n_samples = min(n_samples, 7520)', f'n_samples = min(n_samples, {cap})')
    variants.append((f'cap{cap}',src))
# seed offsets
for off in [0,1,2,3,4,5,7,11,17]:
    src=base_src.replace('int(mlp.seed) + 3', f'int(mlp.seed) + {off}')
    variants.append((f'seed{off}',src))
# final scale small
for scale in [0.9975,0.9985,0.9990,0.99938145,0.9998,1.0002,1.0010]:
    src=base_src.replace('0.99938145 *', f'{scale} *')
    variants.append((f'scale{scale}',src))
# first layer coeff a
for a in [1.36,1.40,1.42,1.43645,1.45,1.48,1.52]:
    b=1-a
    src=base_src.replace('1.43645 * (x_full - diag_rows[0])\\n                    - 0.43645 * x_center', f'{a} * (x_full - diag_rows[0])\\n                    + {b} * x_center')
    variants.append((f'a{a}',src))

results=[]
for name,src in variants:
    mod=types.ModuleType(name)
    exec(compile(src, name+'.py','exec'), mod.__dict__)
    t=time.time(); res=evaluate_estimator(mod.Estimator(), data); dt=time.time()-t
    results.append((res['adjusted_final_layer_score'], res['final_layer_mse'], res['mean_score_multiplier'], name, dt))
    print(name, results[-1])
print('\\nBEST')
for r in sorted(results)[:15]: print(r)

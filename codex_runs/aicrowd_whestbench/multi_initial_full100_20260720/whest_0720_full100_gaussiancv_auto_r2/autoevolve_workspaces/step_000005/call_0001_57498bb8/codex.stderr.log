/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr

pi=np.pi

def phi(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)

def diag_prop(weights):
    width=weights[0].shape[0]
    d_mu=np.zeros(width,dtype=np.float64); d_var=np.ones(width,dtype=np.float64)
    rows=[]; vars=[]; pre=[]
    for w in weights:
        w=w.astype(np.float64)
        d_mu_pre=w.T@d_mu
        d_var_pre=(w*w).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); a=d_mu_pre/sig
        c=ndtr(a); p=phi(a)
        d_mu=d_mu_pre*c+sig*p
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*p
        d_var=np.maximum(ez2-d_mu*d_mu,0.0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pre.append(d_mu_pre.copy())
    return rows,vars,pre

def features(weights, seed=0, n_samples=7520, adj_mean=-0.100, acoef=1.43645, bcoef=-0.43645):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows,diag_vars,pres=diag_prop(weights)
    if depth==1:
        return None, diag_rows[-1]
    rng=np.random.default_rng(seed+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        w=w.astype(np.float64)
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0); x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0.0))
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+adj_mean*(x_mean0-diag_rows[0])+acoef*(x_full-diag_rows[0])+bcoef*x_center
    z=x@weights[-1].astype(np.float64)
    z_mean=z.mean(axis=0); zc=z-z_mean; z_var=(zc*zc).mean(axis=0); z_sigma=np.sqrt(np.maximum(z_var,1e-12))
    za=z_mean/z_sigma; final_gauss=z_mean*ndtr(za)+z_sigma*phi(za)
    za_md=pres[-1]/z_sigma; final_mixed=pres[-1]*ndtr(za_md)+z_sigma*phi(za_md)
    final_mc=np.maximum(z,0).mean(axis=0)
    return np.stack([final_mc,final_gauss,final_mixed],axis=0), None

def target(weights, N=200000, seed=12345, chunk=20000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed)
    s=np.zeros(width,dtype=np.float64); done=0
    while done<N:
        n=min(chunk,N-done)
        x=rng.standard_normal((n,width),dtype=np.float32).astype(np.float64)
        for w in weights:
            x=np.maximum(x@w.astype(np.float64),0)
        s+=x.sum(axis=0); done+=n
    return s/N

def run(width,depth,m=20,N=100000):
    feats=[]; tgts=[]; cur=[]; diag=[]
    for k in range(m):
        rng=np.random.default_rng(1000+k)
        weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        f,_=features(weights,seed=2000+k,n_samples=7520)
        t=target(weights,N=N,seed=3000+k,chunk=10000)
        pred=0.99938145*(1.03699807*f[0]-0.04249644*f[1]+0.00549808*f[2])
        feats.append(f.T); tgts.append(t); cur.append(np.mean((pred-t)**2))
    X=np.concatenate(feats,axis=0); y=np.concatenate(tgts,axis=0)
    # least squares no intercept and with intercept-like diag? just features
    beta=np.linalg.lstsq(X,y,rcond=None)[0]
    pred=X@beta
    print('w d m N',width,depth,m,N,'cur mean',np.mean(cur),'coef',beta,'fit mse',np.mean((pred-y)**2),'rel',np.mean((pred-y)**2)/np.mean(cur))
    # current coefs expanded
    print('current expanded',0.99938145*np.array([1.03699807,-0.04249644,0.00549808]))

for width,depth,m,N in [(16,8,30,200000),(32,8,15,120000),(32,16,10,100000),(64,8,6,80000),(64,16,4,60000)]:
    run(width,depth,m,N)

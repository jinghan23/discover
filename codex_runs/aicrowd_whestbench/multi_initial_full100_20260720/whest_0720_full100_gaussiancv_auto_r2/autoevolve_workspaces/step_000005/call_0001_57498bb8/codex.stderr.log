  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(t),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(t/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); K=(root+(pi-np.arccos(rho))*rho)/(2*pi); ts=scale*K; tc=ts-rows[0][:,None]*rows[0][None,:]; tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,te=np.linalg.eigh(tc); xf=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]; x=rows[0]+mean_corr*(xm-rows[0])+1.43645*(xf-rows[0])-.43645*xc
 z=x@weights[-1].astype(float); zm=z.mean(0); zv=np.mean((z-zm)**2,0); zs=np.sqrt(np.maximum(zv,1e-12)); fg=zm*ndtr(zm/zs)+zs*phi(zm/zs); fm=pres[-1]*ndtr(pres[-1]/zs)+zs*phi(pres[-1]/zs); fmc=np.maximum(z,0).mean(0); return .99938145*((1.03699807-shift)*fmc+(-.04249644+shift)*fg+.00549808*fm)

def target(weights,N,seed):
 width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
 while done<N:
  m=min(10000,N-done); x=rng.standard_normal((m,width),dtype=np.float32).astype(float)
  for w in weights: x=np.maximum(x@w.astype(float),0)
  s+=x.sum(0); done+=m
 return s/N
for width,depth,m,N in [(16,8,40,120000),(32,8,30,90000),(32,16,20,80000),(64,8,12,70000),(64,16,8,60000)]:

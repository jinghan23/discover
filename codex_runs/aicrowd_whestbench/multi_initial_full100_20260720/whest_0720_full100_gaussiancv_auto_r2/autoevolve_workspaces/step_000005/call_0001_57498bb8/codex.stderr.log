# Synthetic original-vs-modified comparison on fresh generated MLPs.
import numpy as np
from scipy.special import ndtr
pi=np.pi

def phi(x): return np.exp(-.5*x*x)/np.sqrt(2*pi)

def diag(weights):
 width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pres=[]
 for w in weights:
  w=w.astype(float); pre=w.T@mu; v=(w*w).T@var; v=np.maximum(v,1e-12); s=np.sqrt(v); a=pre/s; c=ndtr(a); p=phi(a); m=pre*c+s*p; e=(pre*pre+v)*c+pre*s*p; mu=m; var=np.maximum(e-m*m,0); rows.append(mu.copy()); vars.append(var.copy()); pres.append(pre.copy())
 return rows,vars,pres

def pred(weights,seed,mean_corr,shift,n=7520):
 rows,vars,pres=diag(weights); width=weights[0].shape[0]; rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width),dtype=np.float32).astype(float); x=np.r_[x0,-x0]; eye=np.eye(width)
 for i,w in enumerate(weights[:-1]):
  w=w.astype(float); z=x@w
  if i==0:

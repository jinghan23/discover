/bin/bash -lc "python - <<'PY'
# Fast synthetic comparison for per-layer diagonal rescaling after hidden ReLUs.
import numpy as np
from scipy.special import ndtr
pi=np.pi

def phi(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)

def diag_prop(weights):
    width=weights[0].shape[0]
    d_mu=np.zeros(width); d_var=np.ones(width); rows=[]; vars=[]; pres=[]
    for w in weights:
        w=w.astype(float); pre=w.T@d_mu; v=(w*w).T@d_var; v=np.maximum(v,1e-12)
        sig=np.sqrt(v); a=pre/sig; c=ndtr(a); p=phi(a)
        mu=pre*c+sig*p; ez2=(pre*pre+v)*c+pre*sig*p
        d_mu=mu; d_var=np.maximum(ez2-mu*mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pres.append(pre.copy())
    return rows,vars,pres

def pred(weights,seed,rescale=False,mean=-0.05,shift=0.015,n=7520):
    rows,vars,pres=diag_prop(weights); width=weights[0].shape[0]
    rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width),dtype=np.float32).astype(float); x=np.r_[x0,-x0]
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):

import numpy as np
from scipy.special import ndtr
pi=np.pi

def phi(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)

def diag_prop(weights):
    width=weights[0].shape[0]
    d_mu=np.zeros(width); d_var=np.ones(width); rows=[]; vars=[]; pres=[]; ezs=[]
    for w in weights:
        w=w.astype(float); pre=w.T@d_mu; v=(w*w).T@d_var; v=np.maximum(v,1e-12)
        sig=np.sqrt(v); a=pre/sig; c=ndtr(a); p=phi(a)
        mu=pre*c+sig*p; ez2=(pre*pre+v)*c+pre*sig*p
        d_mu=mu; d_var=np.maximum(ez2-mu*mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pres.append(pre.copy()); ezs.append(ez2.copy())
    return rows,vars,pres,ezs

def full_second(weights):
    rows,vars,pres,ezs=diag_prop(weights); width=weights[0].shape[0]
    mu=np.zeros(width); S=np.eye(width)
    for idx,w in enumerate(weights):
        w=w.astype(float)
        pm=w.T@mu
        P=w.T@S@w
        q=np.maximum(np.diag(P),1e-12)
        scale=np.maximum(np.sqrt(q)[:,None]*np.sqrt(q)[None,:],1e-12)
        rho=np.clip(P/scale,-.999999,.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        K=(root+(pi-np.arccos(rho))*rho)/(2*pi)
        S=scale*K
        # use exact univariate diag and mean from diagonal propagation
        S=S*(1-np.eye(width))+np.eye(width)*ezs[idx]
        mu=rows[idx]
    return mu

def pred_features(weights,seed,mean=-.05,shift=.015,n=7520):
    rows,vars,pres,ezs=diag_prop(weights); width=weights[0].shape[0]
    rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width),dtype=np.float32).astype(float); x=np.r_[x0,-x0]; eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        w=w.astype(float); z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12)
            rho=np.clip(tc/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); K=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=scale*K; target_cov=target_second-rows[0][:,None]*rows[0][None,:]; target_cov=.5*(target_cov+target_cov.T); target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            tv,te=np.linalg.eigh(target_cov); xf=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]
            x=rows[0]+mean*(xm-rows[0])+1.43645*(xf-rows[0])-0.43645*xc
    z=x@weights[-1].astype(float); zm=z.mean(0); zv=np.mean((z-zm)**2,0); zs=np.sqrt(np.maximum(zv,1e-12))
    fg=zm*ndtr(zm/zs)+zs*phi(zm/zs); fm=pres[-1]*ndtr(pres[-1]/zs)+zs*phi(pres[-1]/zs); fmc=np.maximum(z,0).mean(0)
    fcur=.99938145*((1.03699807-shift)*fmc+(-.04249644+shift)*fg+.00549808*fm)
    return fcur, fmc, fg, fm, full_second(weights)

def target(weights,N=100000,seed=99):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<N:
        m=min(10000,N-done); x=rng.standard_normal((m,width),dtype=np.float32).astype(float)
        for w in weights: x=np.maximum(x@w.astype(float),0)
        s+=x.sum(0); done+=m
    return s/N
for width,depth,m in [(16,8,30),(32,8,15),(32,16,10),(64,8,6),(64,16,4)]:
    Ys=[]; Fs=[]; cur=[]; full=[]
    for k in range(m):

The blackbox tuning is now mostly finding tiny deterministic-sample effects. To look for larger gains, I’ll run a private synthetic benchmark from fresh random MLPs and high-sample Monte Carlo targets, then only bring promising ideas back to the official blackbox.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time

# Synthetic-only benchmark; no hidden data. Mirrors the estimator logic with ordinary numpy for speed.
def norm_pdf(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)
def norm_cdf(x): return 0.5*(1+np.vectorize(math.erf)(x/math.sqrt(2)))
# vectorized erf via scipy if available fallback
try:
    import scipy.special as sp
    def norm_cdf(x): return sp.ndtr(x)
except Exception:
    pass

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0)
    var=np.ones(w0)
    rows=[]; vars=[]; pre_mu=None; pre_var=None
    for W in weights:
        pre_mu=W.T@mu
        pre_var=(W*W).T@var
        pre_var=np.maximum(pre_var,1e-12)
        sig=np.sqrt(pre_var); a=pre_mu/sig; phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=pre_mu*cdf+sig*phi
        ez2=(pre_mu*pre_mu+pre_var)*cdf+pre_mu*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars,pre_mu,pre_var

def estimate(weights, seed=123, n_samples=5000, coeffs=(0.99938145,1.01883590,-0.026,0.00716410), factor_variant='base'):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,d_mu_pre,d_var_pre=diag_prop(weights)
    if depth==1: return rows[-1]
    rng=np.random.default_rng(seed+3)
    n_samples=2*(n_samples//2)
    x0=rng.standard_normal((n_samples//2,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    target_cov0=None
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            z_center=z-z.mean(0)
            sample_cov=z_center.T@z_center/n_samples
            sv,su=np.linalg.eigh(sample_cov)
            tv,tu=np.linalg.eigh(t_cov)
            inv=su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T)
            tar=tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)
            z=z_center@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sample_cov=xc.T@xc/n_samples
            sv,su=np.linalg.eigh(sample_cov)
            sig0=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(sig0[:,None]*sig0[None,:],1e-12)
            rho=np.clip(t_cov/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); pi=math.pi
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=(sig0[:,None]*sig0[None,:])*kernel
            target_cov=target_second-rows[0][:,None]*rows[0][None,:]
            target_cov=.5*(target_cov+target_cov.T); target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            tv,tu=np.linalg.eigh(target_cov)
            inv=su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T)
            tar=tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)
            x_full=xc@(inv@tar)+rows[0]
            x=rows[0]-0.100*(xm-rows[0])+1.43645*(x_full-rows[0])-0.43645*xc
        # variants maybe
        if factor_variant=='clipneg' and i==0:
            x=np.maximum(x,0)
    z=x@weights[-1]
    z=z.astype(np.float64); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12))
    a=zm/zs; fg=zm*norm_cdf(a)+zs*norm_pdf(a)
    amd=d_mu_pre/zs; fmd=d_mu_pre*norm_cdf(amd)+zs*norm_pdf(amd)
    fmc=np.maximum(z,0).mean(0)
    s,cm,cg,cmd=coeffs
    return s*(cm*fmc+cg*fg+cmd*fmd)

def truth(weights, seed=999, n=200000, chunk=10000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    total=np.zeros(width)
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        total+=x.sum(0)
    return total/n

def run(width=32, depth=8, n_mlps=8, n_est=5000):
    ms=[]; ms_clip=[]; ms_diag=[]
    t=time.time()
    for i in range(n_mlps):
        rng=np.random.default_rng(1000+i)
        scale=math.sqrt(2/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        y=truth(weights, seed=2000+i, n=100000 if width<=32 else 50000)
        p=estimate(weights, seed=3000+i, n_samples=n_est)
        pc=estimate(weights, seed=3000+i, n_samples=n_est, factor_variant='clipneg')
        dr,_,_,_=diag_prop(weights); pd=dr[-1]
        ms.append(((p-y)**2).mean()); ms_clip.append(((pc-y)**2).mean()); ms_diag.append(((pd-y)**2).mean())
    print('spec',width,depth,'time',time.time()-t,'base',np.mean(ms),'clip',np.mean(ms_clip),'diag',np.mean(ms_diag))

for spec in [(32,8),(64,8),(32,16)]:
    run(*spec, n_mlps=5, n_est=5000)

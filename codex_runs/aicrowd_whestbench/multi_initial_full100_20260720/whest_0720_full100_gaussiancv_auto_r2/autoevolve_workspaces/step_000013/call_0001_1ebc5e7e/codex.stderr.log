One compute/prediction tradeoff worth testing locally is Cholesky-based moment matching instead of symmetric eigensquare roots for the first-layer whitening. It is cheaper but rotates samples differently, so I’ll test it synthetically before risking a blackbox run.
exec
/bin/bash -lc "python - <<'PY'
# Local comparison: eig vs Cholesky covariance matching.
import numpy as np, math
try:
 import scipy.special as sp
 ndtr=sp.ndtr
except Exception:
 ndtr=lambda x:0.5*(1+np.vectorize(math.erf)(x/math.sqrt(2)))
def pdf(x): return np.exp(-.5*x*x)/math.sqrt(2*math.pi)
def match_eig(X,T):
 n=X.shape[0]; C=X.T@X/n; sv,su=np.linalg.eigh(C); tv,tu=np.linalg.eigh(T); return X@(su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T)@(tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)))
def match_chol(X,T):
 n=X.shape[0]; C=X.T@X/n; eye=np.eye(C.shape[0]); Ls=np.linalg.cholesky(C+1e-10*eye); Lt=np.linalg.cholesky(T+1e-10*eye); A=np.linalg.solve(Ls.T,Lt.T); return X@A
def diag_prop(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=None
 for W in Ws:
  pre=W.T@mu; pv=(W*W).T@var; pv=np.maximum(pv,1e-12); s=np.sqrt(pv); a=pre/s; c=ndtr(a); p=pdf(a); mu=pre*c+s*p; ez2=(pre*pre+pv)*c+pre*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars,pre
def est(Ws,seed,n,chol=False):
 width=Ws[0].shape[0]; rows,vars,dpre=diag_prop(Ws); rng=np.random.default_rng(seed+3); n=2*(n//2); x0=rng.standard_normal((n//2,width)).astype(np.float32); x=np.concatenate([x0,-x0]); eye=np.eye(width)
 for i,W in enumerate(Ws[:-1]):
  z=x@W
  if i==0:
   t=W.T@W; zc=z-z.mean(0); z=match_chol(zc,t) if chol else match_eig(zc,t)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sig=np.sqrt(np.maximum(np.diag(t),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(t/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); pi=math.pi; kern=(root+(pi-np.arccos(rho))*rho)/(2*pi); tcov=scale*kern-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]; xf=(match_chol(xc,tcov) if chol else match_eig(xc,tcov))+rows[0]; x=rows[0]-0.1*(xm-rows[0])+1.43645*(xf-rows[0])-0.43645*xc
 z=(x@Ws[-1]).astype(float); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); fg=zm*ndtr(zm/zs)+zs*pdf(zm/zs); fmd=dpre*ndtr(dpre/zs)+zs*pdf(dpre/zs); fmc=np.maximum(z,0).mean(0); return .99938145*(1.0188359*fmc-.026*fg+.0071641*fmd)
def truth(Ws,seed,n):
 width=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); ch=10000
 for st in range(0,n,ch):
  m=min(ch,n-st); x=rng.standard_normal((m,width)).astype(np.float32)
  for W in Ws:x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
for spec in [(32,8),(64,8),(32,16),(64,16)]:
 vals=[[],[]]; width,depth=spec
 for i in range(8):
  rng=np.random.default_rng(1400+i); Ws=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]; y=truth(Ws,1500+i,80000 if width<=32 else 40000)
  vals[0].append(((est(Ws,1600+i,5000,False)-y)**2).mean()); vals[1].append(((est(Ws,1600+i,5000,True)-y)**2).mean())

codex
Another analytic final-layer idea is an Edgeworth correction: use sampled skewness/kurtosis of the final preactivation to improve the Gaussian ReLU moment without relying on the full noisy ReLU sample mean. I’ll test it on synthetic MLPs first.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
try:
 import scipy.special as sp
 ndtr=sp.ndtr
except Exception:
 ndtr=lambda x: 0.5*(1+np.vectorize(math.erf)(x/math.sqrt(2)))
def pdf(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)
# Reuse shorter estimator from previous local tests, adding edgeworth.
def diag_prop(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=None
 for W in Ws:
  pre=W.T@mu; pv=(W*W).T@var; pv=np.maximum(pv,1e-12); s=np.sqrt(pv); a=pre/s; c=ndtr(a); p=pdf(a); mu=pre*c+s*p; ez2=(pre*pre+pv)*c+pre*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars,pre
def components(Ws, seed, n):
 width=Ws[0].shape[0]; rows,vars,dpre=diag_prop(Ws); rng=np.random.default_rng(seed+3); n=2*(n//2); x0=rng.standard_normal((n//2,width)).astype(np.float32); x=np.concatenate([x0,-x0]); eye=np.eye(width)
 for i,W in enumerate(Ws[:-1]):
  z=x@W
  if i==0:
   t=W.T@W; zc=z-z.mean(0); sc=zc.T@zc/n; sv,su=np.linalg.eigh(sc); tv,tu=np.linalg.eigh(t); z=zc@(su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T)@(tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)))
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,su=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(t),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(t/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); pi=math.pi; kern=(root+(pi-np.arccos(rho))*rho)/(2*pi); tcov=scale*kern-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]; tv,tu=np.linalg.eigh(tcov); xf=xc@(su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T)@(tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)))+rows[0]; x=rows[0]-0.1*(xm-rows[0])+1.43645*(xf-rows[0])-0.43645*xc
 z=(x@Ws[-1]).astype(float); zm=z.mean(0); c=z-zm; var=(c*c).mean(0); sig=np.sqrt(np.maximum(var,1e-12)); a=zm/sig; ph=pdf(a); fg=zm*ndtr(a)+sig*ph; fmc=np.maximum(z,0).mean(0); fmd=dpre*ndtr(dpre/sig)+sig*pdf(dpre/sig)
 m3=(c**3).mean(0); m4=(c**4).mean(0); skew=m3/np.maximum(sig**3,1e-12); exk=m4/np.maximum(var*var,1e-12)-3

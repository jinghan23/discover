import numpy as np
from scipy.stats import norm
import time

def relu_moments(mu,cov,K=16,L=-8.0):
    w=len(mu); var=np.maximum(np.diag(cov),1e-12); sig=np.sqrt(var); alpha=mu/sig
    ai=alpha[:,None]; aj=alpha[None,:]; si=sig[:,None]; sj=sig[None,:]
    rho=np.clip(cov/np.maximum(si*sj,1e-12),-0.999999,0.999999); s=np.sqrt(np.maximum(1-rho*rho,1e-12))
    # Gauss-Legendre [0,1]
    xs, ws=np.polynomial.legendre.leggauss(K); ts=(xs+1)/2; wts=ws/2
    P=np.zeros((w,w))
    span=np.maximum(ai-L,0.0)
    for t,wt in zip(ts,wts):
        u=L+t*span
        P += wt*span*norm.pdf(u)*norm.cdf((aj-rho*u)/s)
    # symmetrize; quadrature over first variable only can have tiny asymmetry
    P=0.5*(P+P.T)
    phii=norm.pdf(ai); phij=norm.pdf(aj)
    c_ij=norm.cdf((aj-rho*ai)/s); c_ji=norm.cdf((ai-rho*aj)/s)
    Mx=phii*c_ij + rho*phij*c_ji
    My=phij*c_ji + rho*phii*c_ij
    # bivar pdf term times (1-rho"'^2)
    expo=np.exp(-(ai*ai - 2*rho*ai*aj + aj*aj)/(2*np.maximum(1-rho*rho,1e-12)))
    Euv=s*rho*0 # placeholder
    Euv=rho*P + s/(2*np.pi)*expo
    second=mu[:,None]*mu[None,:]*P + mu[:,None]*sj*My + mu[None,:]*si*Mx + si*sj*Euv
    cdf=norm.cdf(alpha); phi=norm.pdf(alpha); m=mu*cdf+sig*phi
    ez2=(mu*mu+var)*cdf+mu*sig*phi
    np.fill_diagonal(second,ez2)
    C=second-m[:,None]*m[None,:]
    C=0.5*(C+C.T)
    # clip diagonal
    diag=np.maximum(np.diag(C),0)
    C[np.diag_indices(w)]=diag
    return m,C

def fullcov(weights,K=16):
    w=weights[0].shape[0]; m=np.zeros(w); C=np.eye(w); rows=[]
    for W in weights:
        mu=W.T@m
        cov=W.T@C@W
        m,C=relu_moments(mu,cov,K=K)
        rows.append(m.copy())
    return np.array(rows)

def target(weights,n=200000,chunk=20000,seed=0):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); sums=np.zeros((len(weights),w)); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
        for li,W in enumerate(weights):
            x=np.maximum(x@W,0); sums[li]+=x.astype(np.float64).sum(0)
        done+=m
    return sums/n
for spec in [(32,8),(64,8),(64,16)]:
 w,d=spec; rng=np.random.default_rng(2027+w+d); ms=[]; t=time.time()
 for i in range(4):
  weights=[(rng.standard_normal((w,w))*np.sqrt(2/w)).astype(np.float32) for _ in range(d)]
  pred=fullcov(weights,K=16); y=target(weights,n=200000 if w<=64 else 100000,seed=500+i)
  ms.append(np.mean((pred[-1]-y[-1])**2)); print(spec,i,ms[-1],flush=True)
 print('"'spec',spec,'mean',np.mean(ms),'elapsed',time.time()-t,flush=True)

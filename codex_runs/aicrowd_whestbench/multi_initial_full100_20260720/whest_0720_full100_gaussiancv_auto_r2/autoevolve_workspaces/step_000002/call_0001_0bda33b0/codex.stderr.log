   tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(tc); z=zc@(svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T@tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,svec=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tcov=sig[:,None]*sig[None,:]*ker-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]; tv,tvec=np.linalg.eigh(tcov); xfull=xc@(svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T@tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)+rows[0]; x=rows[0]-.100*(xm-rows[0])+1.43645*(xfull-rows[0])-.43645*xc
 z=(x@weights[-1]).astype(np.float64); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12)); fg=zm*norm.cdf(zm/zs)+zs*norm.pdf(zm/zs); fmd=prem[-1]*norm.cdf(prem[-1]/zs)+zs*norm.pdf(prem[-1]/zs); fmc=np.maximum(z,0).mean(0); cur=.99938145*(1.03699807*fmc-.04249644*fg+.00549808*fmd); return np.vstack([fmc,fg,fmd,rows[-1],cur]).T
rng=np.random.default_rng(4242); X=[]; Y=[]; start=time.time(); m=4
for i in range(m):
 weights=[(rng.standard_normal((256,256))*np.sqrt(2/256)).astype(np.float32) for _ in range(32)]
 f=feats(weights,7520,seed=10000+i); y=target(weights,1000000,seed=11000+i)

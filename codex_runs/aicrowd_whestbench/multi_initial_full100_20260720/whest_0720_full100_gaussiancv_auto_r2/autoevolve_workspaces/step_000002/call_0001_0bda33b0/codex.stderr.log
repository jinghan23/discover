print('agg current',np.mean((X[:,4]-Y)**2),'mc',np.mean((X[:,0]-Y)**2),'gauss',np.mean((X[:,1]-Y)**2),'mixed',np.mean((X[:,2]-Y)**2),'diag',np.mean((X[:,3]-Y)**2))
for cols in ([0,1,2],[0,1],[0,1,2,3]):

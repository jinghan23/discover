import numpy as np
from scipy.stats import norm
# Quick synthetic sweep for layer-2 mean correction c.
def target(weights,n=300000,chunk=20000,seed=0):
 s=np.zeros(256); rng=np.random.default_rng(seed); done=0
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,256)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return s/n
def diag(weights):
 mu=np.zeros(256); var=np.ones(256); rows=[]; vars=[]; prem=[]
 for W in weights:
  mup=W.T@mu; varp=(W*W).T@var; varp=np.maximum(varp,1e-12); sig=np.sqrt(varp); a=mup/sig; c=norm.cdf(a); p=norm.pdf(a); mu=mup*c+sig*p; ez2=(mup*mup+varp)*c+mup*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy()); prem.append(mup.copy())
 return rows,vars,prem
def pred(weights,y,c2=0.0,n=7520,seed=0):
 rows,vars,prem=diag(weights); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,256)).astype(np.float32); x=np.concatenate([x0,-x0]); eye=np.eye(256)
 for i,W in enumerate(weights[:-1]):
  z=x@W
  if i==0:
   tc=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(tc); z=zc@(svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T@tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,svec=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tcov=sig[:,None]*sig[None,:]*ker-rows[0][:,None]*rows[0][None,:]; tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]; tv,tvec=np.linalg.eigh(tcov); xfull=xc@(svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T@tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)+rows[0]; x=rows[0]-.100*(xm-rows[0])+1.43645*(xfull-rows[0])-.43645*xc
  elif i==1 and c2"'!=0.0:
   xm=x.mean(0); x=x-c2*(xm-rows[1])
 z=(x@weights[-1]).astype(np.float64); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12)); fg=zm*norm.cdf(zm/zs)+zs*norm.pdf(zm/zs); fmd=prem[-1]*norm.cdf(prem[-1]/zs)+zs*norm.pdf(prem[-1]/zs); fmc=np.maximum(z,0).mean(0); final=.99938145*(1.03699807*fmc-.04249644*fg+.00549808*fmd); return np.mean((final-y)**2)
rng=np.random.default_rng(9191); items=[]
for i in range(4):

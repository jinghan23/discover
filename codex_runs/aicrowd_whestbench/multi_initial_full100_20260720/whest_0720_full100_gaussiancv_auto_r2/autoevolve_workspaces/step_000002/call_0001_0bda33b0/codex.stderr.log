import numpy as np
from scipy.stats import norm
import time


def relu(x): return np.maximum(x,0)

def target_mean(weights, n=80000, chunk=10000, seed=123):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s += x.astype(np.float64).sum(axis=0)
        done += m
    return s/n

def diag_features(weights):
    w=weights[0].shape[0]
    d_mu=np.zeros(w)
    d_var=np.ones(w)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for W in weights:
        d_mu_pre=W.T@d_mu
        d_var_pre=(W*W).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre)
        a=d_mu_pre/sig
        c=norm.cdf(a); p=norm.pdf(a)
        d_mu=d_mu_pre*c+sig*p
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*c+d_mu_pre*sig*p
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pre_mus.append(d_mu_pre.copy()); pre_vars.append(d_var_pre.copy())
    return rows, vars, pre_mus, pre_vars

def current_features(weights, n_samples=7520, seed=0, mix_a=1.43645, mix_b=0.43645, mean_corr=-0.100):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows, diag_vars, pre_mus, pre_vars=diag_features(weights)
    rng=np.random.default_rng(seed+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n_samples
            sv, svec=np.linalg.eigh(sample_cov)
            tv, tvec=np.linalg.eigh(t_cov)
            inv_sqrt=svec@((1/np.sqrt(np.maximum(sv,1e-12)))[:,None]*svec.T)
            # equivalent svec@diag@? Actually svec @ diag @ svec.T
            inv_sqrt=svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T
            target_sqrt=tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0)
            x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples
            sv,svec=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            pi=np.pi
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv_sqrt=svec@np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T
            target_sqrt=tvec@np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]+mean_corr*(x_mean0-diag_rows[0])+mix_a*(x_full-diag_rows[0])-mix_b*x_center
    z=x@weights[-1]
    z=z.astype(np.float64)
    zm=z.mean(axis=0); zc=z-zm; zv=np.mean(zc*zc,axis=0); zs=np.sqrt(np.maximum(zv,1e-12))
    za=zm/zs
    final_gauss=zm*norm.cdf(za)+zs*norm.pdf(za)
    z_alpha_md=pre_mus[-1]/zs
    final_mixed=pre_mus[-1]*norm.cdf(z_alpha_md)+zs*norm.pdf(z_alpha_md)
    final_mc=np.maximum(z,0).mean(axis=0)
    current=0.99938145*(1.03699807*final_mc-0.04249644*final_gauss+0.00549808*final_mixed)
    return np.vstack([final_mc,final_gauss,final_mixed,diag_rows[-1],current]).T

def run(width=64,depth=8,m=10,target_n=80000,n_samples=7520):
    rng=np.random.default_rng(987)
    X=[]; y=[]
    t=time.time()
    for i in range(m):
        weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        feat=current_features(weights,n_samples=n_samples,seed=1000+i)
        tgt=target_mean(weights,n=target_n,seed=2000+i)
        X.append(feat[:,:4]); y.append(tgt)
        cur=feat[:,4]
        print(i,'cur_mse',np.mean((cur-tgt)**2),'diag_mse',np.mean((feat[:,3]-tgt)**2), flush=True)
    X=np.concatenate(X,axis=0); y=np.concatenate(y)
    # fit with/without intercept/scaler
    A=X[:,:3]
    coef=np.linalg.lstsq(A,y,rcond=None)[0]
    pred=A@coef
    print('coef3',coef,'mse',np.mean((pred-y)**2))
    A4=X[:,:4]
    coef4=np.linalg.lstsq(A4,y,rcond=None)[0]
    print('coef4',coef4,'mse',np.mean((A4@coef4-y)**2))
    cur_mse=np.mean((X[:,4] if X.shape[1]>4 else pred-y)**2) if False else None
    current=0.99938145*(1.03699807*X[:,0]-0.04249644*X[:,1]+0.00549808*X[:,2])
    print('current aggregate',np.mean((current-y)**2),'mc',np.mean((X[:,0]-y)**2),'gauss',np.mean((X[:,1]-y)**2),'mixed',np.mean((X[:,2]-y)**2),'diag',np.mean((X[:,3]-y)**2))
    print('elapsed',time.time()-t)


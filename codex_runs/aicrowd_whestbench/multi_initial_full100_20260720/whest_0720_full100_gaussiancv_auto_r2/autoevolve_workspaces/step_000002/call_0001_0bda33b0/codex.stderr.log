import numpy as np
from scipy.stats import norm
import time
# Reuse default estimator features; no Edgeworth to keep this focused.
def target(weights,n=1000000,chunk=20000,seed=0):
 w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return s/n
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
 for W in weights:
  mup=W.T@mu; varp=(W*W).T@var; varp=np.maximum(varp,1e-12); sig=np.sqrt(varp); a=mup/sig; c=norm.cdf(a); p=norm.pdf(a)
  mu=mup*c+sig*p; ez2=(mup*mup+varp)*c+mup*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy()); prem.append(mup.copy())
 return rows,vars,prem
def feats(weights,n=7520,seed=0):
 w=256; rows,vars,prem=diag(weights); rng=np.random.default_rng(seed+3); half=n//2; x0=rng.standard_normal((half,w)).astype(np.float32); x=np.concatenate([x0,-x0]); eye=np.eye(w)
 for i,W in enumerate(weights[:-1]):
  z=x@W

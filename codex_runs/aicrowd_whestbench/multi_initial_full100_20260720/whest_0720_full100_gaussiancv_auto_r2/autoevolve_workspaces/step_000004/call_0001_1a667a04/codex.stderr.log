/bin/bash -lc "python - <<'PY'
# Quick numerical sanity check for the bivariate ReLU covariance approximation on random synthetic contests.
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
from whestbench import BaseEstimator
import flopscope.numpy as fnp
import flopscope as flops

# Reuse current submission baseline by inheritance/copy: import current Estimator.
from submission import Estimator as BaseCandidate

class FullControlEstimator(BaseCandidate):
    def _full_final(self, mlp):
        width = int(mlp.width)
        pi = 3.141592653589793
        mu = fnp.zeros(width, dtype=fnp.float64)
        cov = fnp.eye(width, dtype=fnp.float64)
        eye = fnp.eye(width, dtype=fnp.float64)
        for li, w0 in enumerate(mlp.weights):
            w = fnp.asarray(w0, dtype=fnp.float64)
            pre_mu = w.T @ mu
            pre_cov = (w.T @ cov) @ w
            pre_cov = 0.5 * (pre_cov + pre_cov.T)
            pre_var = fnp.maximum(fnp.diagonal(pre_cov), 1e-12)
            sigma = fnp.sqrt(pre_var)
            alpha = pre_mu / sigma
            phi = flops.stats.norm.pdf(alpha)
            cdf = flops.stats.norm.cdf(alpha)
            out_mu = pre_mu * cdf + sigma * phi
            ez2 = (pre_mu * pre_mu + pre_var) * cdf + pre_mu * sigma * phi
            out_var = fnp.maximum(ez2 - out_mu * out_mu, 0.0)
            if li == int(mlp.depth) - 1:
                return out_mu
            scale = fnp.maximum(sigma[:, None] * sigma[None, :], 1e-12)
            rho = fnp.clip(pre_cov / scale, -0.97, 0.97)
            a = alpha[:, None]
            b = alpha[None, :]
            cdfa = cdf[:, None]
            cdfb = cdf[None, :]
            phia = phi[:, None]
            phib = phi[None, :]
            # Mehler expansion for Phi_2(a,b;rho), clipped to Frechet bounds.
            r2 = rho * rho
            p = cdfa * cdfb + phia * phib * (
                rho + 0.5 * a * b * r2 + ((a * a - 1.0) * (b * b - 1.0)) * (r2 * rho) / 6.0
            )
            lo = fnp.maximum(0.0, cdfa + cdfb - 1.0)
            hi = fnp.minimum(cdfa, cdfb)
            p = fnp.clip(p, lo, hi)
            one_minus = fnp.maximum(1.0 - rho * rho, 1e-12)
            expo = -0.5 * (a * a - 2.0 * rho * a * b + b * b) / one_minus
            phi2 = fnp.exp(expo) / (2.0 * pi * fnp.sqrt(one_minus))
            cond1 = flops.stats.norm.cdf((a - rho * b) / fnp.sqrt(one_minus))
            cond2 = flops.stats.norm.cdf((b - rho * a) / fnp.sqrt(one_minus))
            second = (
                pre_mu[:, None] * pre_mu[None, :] * p
                + pre_mu[:, None] * sigma[None, :] * phib * cond1
                + pre_mu[None, :] * sigma[:, None] * phia * cond2
                + scale * (rho * p + fnp.sqrt(one_minus) * phi2)
            )
            cov = second - out_mu[:, None] * out_mu[None, :]
            cov = 0.5 * (cov + cov.T)
            cov = cov * (1.0 - eye) + eye * out_var[None, :]
            mu = out_mu
        return mu
    def predict(self, mlp, budget):
        base = super().predict(mlp, budget)
        full = self._full_final(mlp)
        final = 0.998 * base[-1] + 0.002 * full
        return fnp.asarray(fnp.stack(list(base[:-1]) + [final], axis=0), dtype=fnp.float32)


+                x_var_h = fnp.mean(x_center_h * x_center_h, axis=0)
+                x_matched_h = target_mean_h + x_center_h * fnp.sqrt(
+                    target_var_h / fnp.maximum(x_var_h, 1e-12)
+                )
+                x = x64h + 0.50 * (x_matched_h - x64h)
 
         z = x @ mlp.weights[-1]
         z64 = fnp.asarray(z, dtype=fnp.float64)


import numpy as np
from scipy.special import ndtr
SQRT2PI=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-.5*x*x)/SQRT2PI

def cov_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width); cov=np.eye(width); rows=[]; vars=[]
    inv2pi=1/(2*np.pi); var0=0.5-inv2pi
    for W in weights:
        muz=W.T@mu
        covz=W.T@cov@W
        covz=.5*(covz+covz.T)
        vz=np.maximum(np.diag(covz),1e-12)
        sig=np.sqrt(vz); a=muz/sig; c=ndtr(a); p=pdf(a)
        mu=muz*c+sig*p
        ez2=(muz*muz+vz)*c+muz*sig*p
        var=np.maximum(ez2-mu*mu,1e-12)
        scale=np.maximum(sig[:,None]*sig[None,:],1e-12)
        rho=np.clip(covz/scale,-.999999,.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
        corr=(kern-inv2pi)/var0
        corr=np.clip(corr,-.999999,.999999)
        cov=corr*np.sqrt(var[:,None]*var[None,:])
        cov=.5*(cov+cov.T); np.fill_diagonal(cov,var)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; pre=[]
    for W in weights:
        mup=W.T@mu; varp=(W*W).T@var; varp=np.maximum(varp,1e-12); sig=np.sqrt(varp); a=mup/sig; c=ndtr(a); p=pdf(a)
        mu=mup*c+sig*p; ez2=(mup*mup+varp)*c+mup*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); pre.append((mup.copy(),varp.copy()))
    return rows,pre

def target(weights,N=200000,seed=1):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); c=0
    for _ in range(N//50000):
        x=rng.standard_normal((50000,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); c+=len(x)
    return s/c
for scale in ['he','xav']:
 for depth in [4,8,16]:
    es=[]; ed=[]
    for seed in range(10 if depth<16 else 5):
        w=32; rng=np.random.default_rng(seed); std=np.sqrt(2/w) if scale=='he' else 1/np.sqrt(w)
        Ws=[rng.standard_normal((w,w))*std for _ in range(depth)]
        y=target(Ws,seed=100+seed)
        cp=cov_prop(Ws)[0][-1]
        dp=diag_prop(Ws)[0][-1]
        es.append(np.mean((cp-y)**2)); ed.append(np.mean((dp-y)**2))
    print(scale,depth,'cov',np.mean(es),'diag',np.mean(ed))

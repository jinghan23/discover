codex
The earlier covariance pass used a zero-mean correlation shortcut after the first layer, which explains the large miss. I’m deriving and testing the full nonzero-mean bivariate ReLU moment with a small instrumentable quadrature for the bivariate Gaussian CDF.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr, ndtri
SQRT2PI=np.sqrt(2*np.pi); INV2PI=1/(2*np.pi)
def pdf(x): return np.exp(-.5*x*x)/SQRT2PI
# 12 point Gauss-Legendre nodes/weights
nodes=np.array([-0.9815606342467192,-0.9041172563704749,-0.7699026741943047,-0.5873179542866175,-0.3678314989981802,-0.1252334085114689,0.1252334085114689,0.3678314989981802,0.5873179542866175,0.7699026741943047,0.9041172563704749,0.9815606342467192])
weights=np.array([0.0471753363865118,0.1069393259953184,0.1600783285433462,0.2031674267230659,0.2334925365383548,0.2491470458134028,0.2491470458134028,0.2334925365383548,0.2031674267230659,0.1600783285433462,0.1069393259953184,0.0471753363865118])
def bvncdf_mat(a,b,rho):
    pa=ndtr(a); r=np.sqrt(np.maximum(1-rho*rho,1e-12)); P=np.zeros_like(rho)
    # integrate u from 0 to Phi(a_i)
    for t,w in zip(nodes,weights):
        u=np.clip(0.5*pa*(t+1),1e-14,1-1e-14)
        q=ndtri(u)[:,None]
        P += w*ndtr((b[None,:]-rho*q)/r)
    P *= 0.5*pa[:,None]
    return P
def relu_second(mu,sig,cov):
    a=mu/sig; rho=np.clip(cov/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999)
    r=np.sqrt(np.maximum(1-rho*rho,1e-12))
    P=bvncdf_mat(a,a,rho); P=.5*(P+P.T)
    phia=pdf(a); cdf_terms=ndtr((a[None,:]-rho*a[:,None])/r) # for A_i? shape i,j: Phi((b_j-rho a_i)/r)
    A=phia[:,None]*cdf_terms + rho*phia[None,:]*cdf_terms.T # A_i for pair? E[U_i]
    B=A.T
    expo=np.exp(-(a[:,None]**2-2*rho*a[:,None]*a[None,:]+a[None,:]**2)/(2*np.maximum(1-rho*rho,1e-12)))
    C=rho*P + r*INV2PI*expo
    E=mu[:,None]*mu[None,:]*P + mu[:,None]*sig[None,:]*B + mu[None,:]*sig[:,None]*A + sig[:,None]*sig[None,:]*C
    # diag exact E[X_+"'^2]
    c=ndtr(a); p=phia; diag=(mu*mu+sig*sig)*c+mu*sig*p
    np.fill_diagonal(E,diag)
    return E
def full_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); M=np.eye(w); rows=[]
    for W in weights:
        pre_mu=W.T@mu; pre_second=W.T@M@W; pre_cov=pre_second-pre_mu[:,None]*pre_mu[None,:]; pre_cov=.5*(pre_cov+pre_cov.T)
        var=np.maximum(np.diag(pre_cov),1e-12); sig=np.sqrt(var); a=pre_mu/sig; c=ndtr(a); p=pdf(a)
        mu=pre_mu*c+sig*p
        M=relu_second(pre_mu,sig,pre_cov)
        rows.append(mu.copy())
    return rows
def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]
    for W in weights:
        mup=W.T@mu; varp=(W*W).T@var; varp=np.maximum(varp,1e-12); sig=np.sqrt(varp); a=mup/sig; c=ndtr(a); p=pdf(a)
        mu=mup*c+sig*p; ez2=(mup*mup+varp)*c+mup*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy())
    return rows
def target(weights,N=300000,seed=1):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); c=0
    for _ in range(N//50000):
        x=rng.standard_normal((50000,w)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); c+=len(x)
    return s/c
# sanity first layer exact covariance vs MC? skip
for scale in ['"'he','xav']:
 for depth in [2,4,8,16]:
    ef=[]; ed=[]
    m=6 if depth<16 else 3
    for seed in range(m):
        w=24; rng=np.random.default_rng(seed); std=np.sqrt(2/w) if scale=='he' else 1/np.sqrt(w)
        Ws=[rng.standard_normal((w,w))*std for _ in range(depth)]
        y=target(Ws,N=200000,seed=100+seed)
        f=full_prop(Ws)[-1]; d=diag_prop(Ws)[-1]
        ef.append(np.mean((f-y)**2)); ed.append(np.mean((d-y)**2))
    print(scale,depth,'full',np.mean(ef),'diag',np.mean(ed))

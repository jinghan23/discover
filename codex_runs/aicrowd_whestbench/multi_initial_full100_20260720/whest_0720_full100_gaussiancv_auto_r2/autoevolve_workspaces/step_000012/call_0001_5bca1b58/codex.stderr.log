/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr

SQRT2PI = np.sqrt(2*np.pi)

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0); var=np.ones(w0); rows=[]; vars=[]; pre=[]
    for W in weights:
        mup=W.T@mu
        varp=(W*W).T@var
        varp=np.maximum(varp,1e-12)
        sig=np.sqrt(varp); a=mup/sig; phi=pdf(a); cdf=ndtr(a)
        mu=mup*cdf+sig*phi
        ez2=(mup*mup+varp)*cdf+mup*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pre.append((mup.copy(),varp.copy()))
    return rows,vars,pre

def current(weights,n=7520,seed=0, params=(1.43645,-0.43645,-0.100,0.99938145,1.03533234,-0.04249644,0.00716410), corr_each=False, pre_diag_mix=0.0, post_diag_mix=0.0, edge=False):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,pre=diag_prop(weights)
    if depth==1: return rows[-1]
    half=n//2
    rng=np.random.default_rng(seed+3)
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    a_full,b_center,mean_c,scale_final,c_mc,c_g,c_md=params
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            zc=z-z.mean(0)
            sc=(zc.T@zc)/n
            sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        elif pre_diag_mix"'!=0:
            mup,varp=pre[i]
            zm=z.mean(0); zv=((z-zm)**2).mean(0)
            z_adj=mup+(z-zm)*np.sqrt(np.maximum(varp,1e-12)/np.maximum(zv,1e-12))
            z=(1-pre_diag_mix)*z+pre_diag_mix*z_adj
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm
            sc=(xc.T@xc)/n
            sv,svec=np.linalg.eigh(sc)
            sig0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(sig0[:,None]*sig0[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target_second=scale*kern
            target_cov=target_second-rows[0][:,None]*rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            x_full=xc@(inv@ts)+rows[0]
            x=rows[0] + mean_c*(xm-rows[0]) + a_full*(x_full-rows[0]) + b_center*xc
        elif post_diag_mix!=0:
            xm=x.mean(0); xv=((x-xm)**2).mean(0)
            x_adj=rows[i]+(x-xm)*np.sqrt(np.maximum(vars[i],1e-12)/np.maximum(xv,1e-12))
            x=(1-post_diag_mix)*x+post_diag_mix*x_adj
    z=x@weights[-1]
    z64=z.astype(np.float64); zm=z64.mean(0); zc=z64-zm; zv=(zc*zc).mean(0); sig=np.sqrt(np.maximum(zv,1e-12)); alpha=zm/sig
    fg=zm*ndtr(alpha)+sig*pdf(alpha)
    dmu_pre=pre[-1][0]
    amd=dmu_pre/sig
    fmd=dmu_pre*ndtr(amd)+sig*pdf(amd)
    fmc=np.maximum(z64,0).mean(0)
    if edge:
        m3=(zc**3).mean(0); m4=(zc**4).mean(0)
        k3=m3/(sig**3+1e-30); k4=m4/(sig**4+1e-30)-3
        ph=pdf(alpha)
        fed=fg + sig*ph*((-k3*alpha)/6 + (k4*(alpha*alpha-1))/24 + ((k3*k3)*(alpha**4-6*alpha*alpha+3))/72)
        return scale_final*(c_mc*fmc+c_g*fg+c_md*fmd), fg, fmc, fmd, fed
    return scale_final*(c_mc*fmc+c_g*fg+c_md*fmd)

def target(weights,N=300000,seed=123):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed)
    batch=50000; s=np.zeros(width); count=0
    for _ in range(N//batch):
        x=rng.standard_normal((batch,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0); count+=batch
    return s/count

def trial(width=32, depth=8, scale='"'he', m=10):
    errs={k:[] for k in ['cur','post1','post05','pre05','pre1','both05','edge_fg','edge_fed','mc','fg','fmd']}
    for seed in range(m):
        rng=np.random.default_rng(1000+seed)
        if scale=='he': std=np.sqrt(2/width)
        elif scale=='xav': std=1/np.sqrt(width)
        else: std=1.0
        weights=[rng.standard_normal((width,width))*std for _ in range(depth)]
        y=target(weights,N=200000,seed=2000+seed)
        cur=current(weights,seed=3000+seed)

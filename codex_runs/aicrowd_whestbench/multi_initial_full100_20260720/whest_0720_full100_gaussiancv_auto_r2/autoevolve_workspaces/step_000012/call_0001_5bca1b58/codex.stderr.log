            x=rows[0]-.100*(xm-rows[0])+1.43645*(xfull-rows[0])-.43645*xc
    z=(x@weights[-1]).astype(float); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); sig=np.sqrt(np.maximum(zv,1e-12)); a=zm/sig
    fmc=np.maximum(z,0).mean(0); fg=zm*ndtr(a)+sig*pdf(a); dmu,dvar=pre[-1]; amd=dmu/sig; fmd=dmu*ndtr(amd)+sig*pdf(amd)

import numpy as np
from scipy.special import ndtr
SQRT2PI=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-.5*x*x)/SQRT2PI
# quick compare final empirical mean-shift feature on synthetic cases
def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
    for W in weights:
        mup=W.T@mu; varp=(W*W).T@var; varp=np.maximum(varp,1e-12)
        sig=np.sqrt(varp); a=mup/sig; c=ndtr(a); p=pdf(a)
        mu=mup*c+sig*p; ez2=(mup*mup+varp)*c+mup*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pre.append((mup.copy(),varp.copy()))
    return rows,vars,pre

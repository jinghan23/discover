/bin/bash -lc "python - <<'PY'
import time, types
from pathlib import Path
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

WIDTH=256; DEPTH=32; BUDGET=272_000_000_000; N_TARGET=131072; N_MLPS=5
CAPS=[4096,6144,8192,10240,12288,13744,16384,20480]
src=Path('submission.py').read_text()
classes={}
for cap in CAPS:
    mod=types.ModuleType('sub_'+str(cap))
    code=src.replace('min(n_samples, 13744)', f'min(n_samples, {cap})')
    exec(compile(code, 'submission_variant.py', 'exec'), mod.__dict__)
    classes[cap]=mod.Estimator()
ss=fnp.random.SeedSequence(31337).spawn(2*N_MLPS)
acc={cap:[] for cap in CAPS}; acc_adj={cap:[] for cap in CAPS}; mults={cap:[] for cap in CAPS}
for i in range(N_MLPS):
    mlp=sample_mlp(WIDTH, DEPTH, fnp.random.default_rng(ss[2*i]), seed=int(ss[2*i].generate_state(1)[0]))
    _, final, _ = sample_layer_statistics(mlp, N_TARGET, rng=fnp.random.default_rng(ss[2*i+1]))
    line=[]
    for cap, est in classes.items():
        with flops.BudgetContext(flop_budget=BUDGET, wall_time_limit_s=60.0, quiet=True) as bc:
            pred=est.predict(mlp, BUDGET)
        mse=float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2))
        eff=bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0)
        mult=max(0.1, eff/BUDGET)
        acc[cap].append(mse); acc_adj[cap].append(mse*mult); mults[cap].append(mult)
        line.append((cap, mse*mult))
    print('mlp', i, [(cap, round(v*1e7,3)) for cap,v in line], flush=True)
for cap in CAPS:
    print('cap', cap, 'mse', sum(acc[cap])/len(acc[cap]), 'adj', sum(acc_adj[cap])/len(acc_adj[cap]), 'mult', sum(mults[cap])/len(mults[cap]))

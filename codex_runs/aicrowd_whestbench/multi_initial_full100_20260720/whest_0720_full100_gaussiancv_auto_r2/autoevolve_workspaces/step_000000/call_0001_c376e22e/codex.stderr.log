    exec(compile(code,'submission_variant.py','exec'), mod.__dict__)
    classes[(m,r)]=mod.Estimator()
ss=fnp.random.SeedSequence(8080).spawn(2*M)
acc={p:[] for p in params}
for i in range(M):
    mlp=sample_mlp(WIDTH,DEPTH,fnp.random.default_rng(ss[2*i]),seed=int(ss[2*i].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,N,rng=fnp.random.default_rng(ss[2*i+1]))
    best=None
    for p,est in classes.items():
        with flops.BudgetContext(flop_budget=B, wall_time_limit_s=60, quiet=True) as bc:
            pred=est.predict(mlp,B)
        mse=float(fnp.mean((fnp.asarray(pred[-1], dtype=fnp.float32)-final)**2))
        mult=max(0.1,(bc.flops_used+1e11*(bc.residual_wall_time_s or 0.0))/B)
        val=mse*mult
        acc[p].append(val)
        if best is None or val < best[2]: best=(p,mse,val)
    cur=acc[(-0.245,0.455)][-1]
    print('mlp',i,'cur',round(cur*1e7,3),'best',best[0],round(best[2]*1e7,3),flush=True)
rank=sorted((sum(v)/len(v),p) for p,v in acc.items())
print('top')
for val,p in rank[:12]:
    print(p,val)
print('cur',sum(acc[(-0.245,0.455)])/len(acc[(-0.245,0.455)]))

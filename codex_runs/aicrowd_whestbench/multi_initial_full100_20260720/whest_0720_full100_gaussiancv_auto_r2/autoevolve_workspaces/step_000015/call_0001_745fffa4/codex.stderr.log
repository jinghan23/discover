import numpy as np, math, time
from scipy.special import ndtr
PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)

def diag_prop(ws,wid):
    mu=np.zeros(wid); var=np.ones(wid); rows=[]; vars=[]; prem=[]; prev=[]
    for w in ws:
        wf=w.astype(np.float64); pm=wf.T@mu; pv=(wf*wf).T@var; pv=np.maximum(pv,1e-12); sig=np.sqrt(pv); a=pm/sig; c=ndtr(a); p=pdf(a); mu=pm*c+sig*p; ez2=(pm*pm+pv)*c+pm*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); prem.append(pm.copy()); prev.append(pv.copy())
    return rows,vars,prem,prev

def feats(ws, seed, wid, dep, mean_k=-0.1, b=1.43645, n=7520):
    rows,vars,prem,prev=diag_prop(ws,wid); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,wid), dtype=np.float32); x=np.concatenate([x0,-x0],0); eye=np.eye(wid)
    for i,w in enumerate(ws[:-1]):
        z=x@w
        if i==0:
            wf=w.astype(np.float64); tc=wf.T@wf; zc=z.astype(np.float64)-z.mean(0,dtype=np.float64); sc=(zc.T@zc)/n; sc=(sc+sc.T)*0.5; sv,sq=np.linalg.eigh(sc); tv,tq=np.linalg.eigh((tc+tc.T)*0.5); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); ts=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); z=(zc@(inv@ts)).astype(np.float32)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0,dtype=np.float64); xc=x.astype(np.float64)-xm; sc=(xc.T@xc)/n; sc=(sc+sc.T)*0.5; sv,sq=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12); rho=np.clip(tc/scale,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); kern=(root+(PI-np.arccos(rho))*rho)/(2*PI); tsecond=scale*kern; tcov=tsecond-rows[0][:,None]*rows[0][None,:]; tcov=0.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
            tv,tq=np.linalg.eigh(tcov); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); ts=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); xf=xc@(inv@ts)+rows[0]
            x=(rows[0]+mean_k*(xm-rows[0])+b*(xf-rows[0])+(1-b)*xc).astype(np.float32)
    z=x@ws[-1]; z64=z.astype(np.float64); zm=z64.mean(0); zc=z64-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12)); f0=np.maximum(z64,0).mean(0); f1=zm*ndtr(zm/zs)+zs*pdf(zm/zs); f2=prem[-1]*ndtr(prem[-1]/zs)+zs*pdf(prem[-1]/zs); f3=rows[-1]
    return np.vstack([f0,f1,f2,f3]).T

def pred_from(F): return 0.99938145*(1.01883590*F[:,0]-0.026*F[:,1]+0.00716410*F[:,2])

def tgt(ws,wid,n=300000,seed=1):
    rng=np.random.default_rng(seed); s=np.zeros(wid); done=0
    for st in range(0,n,8192):
        m=min(8192,n-st); x=rng.standard_normal((m,wid), dtype=np.float32)
        for w in ws: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done
wid=256; dep=32; nmlp=10; t0=time.time(); W=[]; Y=[]
for k in range(nmlp):
    rng=np.random.default_rng(5000+k); sc=math.sqrt(2/wid); ws=[(rng.standard_normal((wid,wid))*sc).astype(np.float32) for _ in range(dep)]; W.append(ws); Y.append(tgt(ws,wid,300000,7000+k)); print('tgt',k,time.time()-t0, flush=True)

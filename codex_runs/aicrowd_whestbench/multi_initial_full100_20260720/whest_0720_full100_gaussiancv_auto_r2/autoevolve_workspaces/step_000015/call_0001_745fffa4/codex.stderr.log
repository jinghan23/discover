import numpy as np, math, time
from scipy.special import ndtr
PI=math.pi

def pdf(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)
# compact functions from before with option input_white

def diag_prop(ws,wid):
    mu=np.zeros(wid); var=np.ones(wid); rows=[]; vars=[]; prem=[]; prev=[]
    for w in ws:
        wf=w.astype(np.float64); pm=wf.T@mu; pv=(wf*wf).T@var; pv=np.maximum(pv,1e-12); sig=np.sqrt(pv); a=pm/sig; c=ndtr(a); p=pdf(a); mu=pm*c+sig*p; ez2=(pm*pm+pv)*c+pm*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy()); prem.append(pm.copy()); prev.append(pv.copy())
    return rows,vars,prem,prev

def estimate(ws,seed,wid,dep,n=7520,input_white=False,z_white=True):
    rows,vars,prem,prev=diag_prop(ws,wid); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,wid), dtype=np.float32); x=np.concatenate([x0,-x0],0).astype(np.float32); eye=np.eye(wid)

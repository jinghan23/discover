            else:
                x=(x.astype(np.float64)+shift_strength*(rows[i]-xm)).astype(np.float32)
    z=x@weights[-1]; z64=z.astype(np.float64); zm=z64.mean(0); zc=z64-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12)); fgauss=zm*ndtr(zm/zs)+zs*norm_pdf(zm/zs); fmix=prem[-1]*ndtr(prem[-1]/zs)+zs*norm_pdf(prem[-1]/zs); fmc=np.maximum(z64,0).mean(0)
    a,b,c=final_coef; return outer*(a*fmc+b*fgauss+c*fmix)

def target(weights,width,n=300000,seed=1,chunk=8192):
    rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,width), dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done

# Quick synthetic check for adding approximate covariance-propagation features.
import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV

def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pm=[]; pv=[]
    for w in weights:
        mp=w.T@mu; vp=(w*w).T@var; vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=mp/s; P=ndtr(a); p=pdf(a)
        mu=mp*P+s*p; ez2=(mp*mp+vp)*P+mp*s*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pm.append(mp.copy()); pv.append(vp.copy())
    return rows,vars,pm,pv

def cov_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); cov=np.eye(width); rows=[]; pm=[]; pv=[]
    for w in weights:
        mp=w.T@mu; cp=w.T@cov@w; vp=np.maximum(np.diag(cp),1e-12); s=np.sqrt(vp); a=mp/s; P=ndtr(a); p=pdf(a)
        mu=mp*P+s*p; ez2=(mp*mp+vp)*P+mp*s*p; var=np.maximum(ez2-mu*mu,0)
        gain=np.where(s>1e-12,P,0); cov=np.outer(gain,gain)*cp; np.fill_diagonal(cov,var)
        rows.append(mu.copy()); pm.append(mp.copy()); pv.append(vp.copy())
    return rows,pm,pv

def features(weights,seed,n=7520):
    dr,dv,dpm,dpv=diag_prop(weights); cr,cpm,cpv=cov_prop(weights)
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+3); h=n//2; x0=rng.standard_normal((h,width)); x=np.vstack([x0,-x0]); eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; sv,se=np.linalg.eigh((sc+sc.T)/2); tv,te=np.linalg.eigh((tc+tc.T)/2)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            tc=weights[0].T@weights[0]; xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh((sc+sc.T)/2)
            sg=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sg,sg),1e-12),-0.999999,0.999999)
            kern=(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target=np.outer(sg,sg)*kern-np.outer(dr[0],dr[0]); target=(target+target.T)/2; target=target*(1-eye)+eye*dv[0][None,:]
            tv,te=np.linalg.eigh(target); xf=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+dr[0]
            x=dr[0]-0.1*(xm-dr[0])+1.43645*(xf-dr[0])-0.43645*xc
    z=x@weights[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); s=np.sqrt(np.maximum(zv,1e-12))
    mc=np.maximum(z,0).mean(0); ga=zm*ndtr(zm/s)+s*pdf(zm/s); mix=dpm[-1]*ndtr(dpm[-1]/s)+s*pdf(dpm[-1]/s); cmix=cpm[-1]*ndtr(cpm[-1]/s)+s*pdf(cpm[-1]/s)
    return np.stack([mc,ga,mix,dr[-1],cr[-1],cmix],1)

def target(weights,seed,n=131072):
    rng=np.random.default_rng(seed+1000003); width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<n:
        m=min(32768,n-done); done+=m; x=rng.standard_normal((m,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return s/n
rng=np.random.default_rng(7); Xs=[]; ys=[]; cur=[]
for width,depth,nm in [(32,8,10),(64,8,4),(32,16,6)]:
    for _ in range(nm):
        weights=[rng.standard_normal((width,width))*np.sqrt(2/width) for _ in range(depth)]; seed=int(rng.integers(0,2**32-1))
        F=features(weights,seed); y=target(weights,seed,n=196608 if width==32 else 98304)
        Xs.append(F); ys.append(y); cur.append(0.99938145*(1.03699807*F[:,0]-0.04249644*F[:,1]+0.00549808*F[:,2]))
X=np.concatenate(Xs); y=np.concatenate(ys); cur=np.concatenate(cur)
for cols in [[0,1,2],[0,1,2,4],[0,1,2,5],[0,1,2,3,4,5]]:
    A=X[:,cols]; coef=np.linalg.lstsq(A,y,rcond=None)[0]; pred=A@coef
    print(cols, 'fit',np.mean((pred-y)**2),'coef',coef)
print('cur weighted',np.mean((cur-y)**2))

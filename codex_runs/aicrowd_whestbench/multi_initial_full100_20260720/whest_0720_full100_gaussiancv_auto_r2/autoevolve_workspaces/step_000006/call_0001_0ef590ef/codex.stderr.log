import numpy as np
from scipy.special import ndtr

SQRT2PI = np.sqrt(2*np.pi)
INV_SQRT2PI = 1.0/SQRT2PI

def pdf(x): return np.exp(-0.5*x*x)*INV_SQRT2PI

def relu_mean(mu, var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig
    return mu*ndtr(a)+sig*pdf(a)

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0); var=np.ones(w0)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=(w*w).T@var
        var_pre=np.maximum(var_pre,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; Phi=ndtr(a); phi=pdf(a)
        mu=mu_pre*Phi+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*Phi+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.copy()); vars.append(var.copy()); pre_mus.append(mu_pre.copy()); pre_vars.append(var_pre.copy())
    return rows,vars,pre_mus,pre_vars

def features(weights, seed, n=7520, a=0.100, b=1.43645, prewhite=True, postcorr=True, layer_diag_match=False):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows, diag_vars, pre_mus, pre_vars = diag_prop(weights)
    if depth==1:
        return np.stack([diag_rows[-1]]*5,axis=1), diag_rows[-1]
    rng=np.random.default_rng(int(seed)+3)
    h=n//2
    x0=rng.standard_normal((h,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0 and prewhite:
            t_cov=w.T@w
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n
            sv,se=np.linalg.eigh((sample_cov+sample_cov.T)*0.5)
            tv,te=np.linalg.eigh((t_cov+t_cov.T)*0.5)
            inv_sqrt=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            target_sqrt=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0 and postcorr:
            t_cov=weights[0].T@weights[0]
            x_mean0=x.mean(axis=0)
            x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n
            sv,se=np.linalg.eigh((sample_cov+sample_cov.T)*0.5)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target_second=scale*kernel
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=(target_cov+target_cov.T)*0.5
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=np.linalg.eigh(target_cov)
            inv_sqrt=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            target_sqrt=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]-a*(x_mean0-diag_rows[0])+b*(x_full-diag_rows[0])+(1-b)*x_center
        if layer_diag_match and i>0:
            # affine match to diag propagation mean/variance at hidden layer i
            xm=x.mean(axis=0); xv=x.var(axis=0)
            scale=np.sqrt(np.maximum(diag_vars[i],1e-12)/np.maximum(xv,1e-12))
            x=diag_rows[i]+(x-xm)*scale
    z=x@weights[-1]
    zm=z.mean(axis=0); zc=z-zm; zv=np.mean(zc*zc,axis=0)
    sig=np.sqrt(np.maximum(zv,1e-12)); alpha=zm/sig
    final_gauss=zm*ndtr(alpha)+sig*pdf(alpha)
    alpha_md=pre_mus[-1]/sig
    final_mixed=pre_mus[-1]*ndtr(alpha_md)+sig*pdf(alpha_md)
    final_mc=np.maximum(z,0).mean(axis=0)
    final_diag=diag_rows[-1]
    final_zmean=relu_mean(zm, pre_vars[-1]) # maybe bad: sample mean, diag var
    F=np.stack([final_mc, final_gauss, final_mixed, final_diag, final_zmean],axis=1)
    cur=0.99938145*(1.03699807*final_mc-0.04249644*final_gauss+0.00549808*final_mixed)
    return F, cur

def target(weights, seed, n=262144, chunk=32768):
    # use independent rng stream; exact stream not relevant for true-ish target
    rng=np.random.default_rng(seed+1000003)
    width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,width)).astype(np.float32)
        x=x.astype(np.float64)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0)
    return s/n

def gen(width,depth,rng):
    scale=np.sqrt(2.0/width)
    return [(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]

rng=np.random.default_rng(123)
cases=[]
for width,depth,nm in [(32,8,12),(64,8,6),(32,16,8),(64,4,6)]:
    for k in range(nm):
        weights=gen(width,depth,rng); seed=int(rng.integers(0,2**32-1))
        cases.append((weights,seed,width,depth))

import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV
def diag_prop(ws):
    width=ws[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pms=[]
    for w in ws:
        mp=w.T@mu; vp=(w*w).T@var; vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=mp/s; P=ndtr(a); p=pdf(a)
        mu=mp*P+s*p; ez2=(mp*mp+vp)*P+mp*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy()); pms.append(mp.copy())
    return rows,vars,pms
def pred(ws,seed,beta=0,n=7520):
    dr,dv,pms=diag_prop(ws); width=ws[0].shape[0]; rng=np.random.default_rng(seed+3); h=n//2; x0=rng.standard_normal((h,width)); x=np.vstack([x0,-x0]); eye=np.eye(width)
    for i,w in enumerate(ws[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; sv,se=np.linalg.eigh((sc+sc.T)/2); tv,te=np.linalg.eigh((tc+tc.T)/2)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            tc=ws[0].T@ws[0]; xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh((sc+sc.T)/2)
            sg=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sg,sg),1e-12),-0.999999,0.999999)
            kern=(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target=np.outer(sg,sg)*kern-np.outer(dr[0],dr[0]); target=(target+target.T)/2; target=target*(1-eye)+eye*dv[0][None,:]
            tv,te=np.linalg.eigh(target); xf=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+dr[0]
            x=dr[0]-0.1*(xm-dr[0])+1.43645*(xf-dr[0])-0.43645*xc
        elif beta:
            xm=x.mean(0)
            x=x-beta*(xm-dr[i])
    z=x@ws[-1]; z=z.astype(float); zm=z.mean(0); c=z-zm; v=(c*c).mean(0); s=np.sqrt(np.maximum(v,1e-12)); a=zm/s
    ga=zm*ndtr(a)+s*pdf(a); mix=pms[-1]*ndtr(pms[-1]/s)+s*pdf(pms[-1]/s); mc=np.maximum(z,0).mean(0)
    return 0.99938145*(1.03699807*mc-0.04249644*ga+0.00549808*mix)
def target(ws,seed,n=131072):
    rng=np.random.default_rng(seed+222); width=ws[0].shape[0]; s=np.zeros(width); done=0
    while done<n:
        m=min(32768,n-done); done+=m; x=rng.standard_normal((m,width))
        for w in ws: x=np.maximum(x@w,0)
        s+=x.sum(0)
    return s/n
rng=np.random.default_rng(21); cases=[]
for width,depth,nm in [(32,8,10),(64,8,4),(32,16,6)]:
    for _ in range(nm): cases.append(([rng.standard_normal((width,width))*np.sqrt(2/width) for _ in range(depth)], int(rng.integers(0,2**32-1)), width))
T=[target(ws,s,n=196608 if w==32 else 98304) for ws,s,w in cases]
for beta in [-0.1,-0.05,0.025,0.05,0.1,0.2]:
    e=[]
    for (ws,s,w),t in zip(cases,T): e.append(np.mean((pred(ws,s,beta)-t)**2))
    print(beta,np.mean(e))

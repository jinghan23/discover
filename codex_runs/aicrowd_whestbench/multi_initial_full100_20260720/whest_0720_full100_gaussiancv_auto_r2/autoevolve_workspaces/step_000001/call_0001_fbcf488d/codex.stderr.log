import numpy as np
from scipy import special
import math, time
pi=np.pi

def chi_mean(k): return math.sqrt(2.0)*math.exp(math.lgamma((k+1)/2)-math.lgamma(k/2))
def phi(a): return np.exp(-0.5*a*a)/np.sqrt(2*pi)
def Phi(a): return special.ndtr(a)

def diag_prop(weights):
    width=weights[0].shape[0]; dm=np.zeros(width); dv=np.ones(width); rows=[]; vars=[]; pre=[]
    for W in weights:
        pm=W.T@dm; pv=(W*W).T@dv; sig=np.sqrt(np.maximum(pv,1e-12)); a=pm/sig; p=phi(a); c=Phi(a)
        dm=pm*c+sig*p; ez2=(pm*pm+pv)*c+pm*sig*p; dv=np.maximum(ez2-dm*dm,0)
        rows.append(dm); vars.append(dv); pre.append(pm)
    return rows,vars,pre

def feats(weights, seed, n=13744, spherical=False, first_match=True):
    width=weights[0].shape[0]; rows,vars,pre=diag_prop(weights)
    rng=np.random.default_rng(seed+2); half=n//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    if spherical:
        r=np.sqrt(np.sum(x0*x0,axis=1,keepdims=True)); x0=x0/np.maximum(r,1e-12)*chi_mean(width)
    x=np.concatenate([x0,-x0])
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0 and first_match:
            t_cov=W.T@W; zc=z-z.mean(0); sc=zc.T@zc/n; sv,su=np.linalg.eigh(sc); tv,tu=np.linalg.eigh(t_cov)
            z=zc@(su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T) @ (tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)))
        x=np.maximum(z,0)
        if i==0 and first_match:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,su=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            tc=(sigma[:,None]*sigma[None,:])*kernel-rows[0][:,None]*rows[0][None,:]
            tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]
            tv,tu=np.linalg.eigh(tc)
            xfull=xc@(su@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@su.T) @ (tu@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tu.T)))+rows[0]
            x=rows[0]-0.245*(xm-rows[0])+1.455*(xfull-rows[0])-0.455*xc
    z=x@weights[-1]
    zm=z.mean(0); zv=np.mean((z-zm)**2,0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs
    gauss=zm*Phi(a)+zs*phi(a)
    a2=pre[-1]/zs; mixed=pre[-1]*Phi(a2)+zs*phi(a2)
    mc=np.maximum(z,0).mean(0)
    return np.vstack([mc,gauss,mixed,rows[-1],np.ones(width)]).T

def target(weights, seed, n=300000, chunk=20000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/done

def run(width=64, depth=32, n_mlps=10, n_gt=300000):
    data={}; y=[]; t=time.time(); ss=np.random.SeedSequence(444).spawn(3*n_mlps)
    for key in ['base','sph_match','sph_nomatch','gauss_nomatch']:
        data[key]=[]
    for i in range(n_mlps):
        rng=np.random.default_rng(ss[3*i]); weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
        seed=int(ss[3*i+2].generate_state(1)[0]); samp=int(ss[3*i+1].generate_state(1)[0])
        data['base'].append(feats(weights,seed,spherical=False,first_match=True))
        data['sph_match'].append(feats(weights,seed,spherical=True,first_match=True))
        data['sph_nomatch'].append(feats(weights,seed,spherical=True,first_match=False))
        data['gauss_nomatch'].append(feats(weights,seed,spherical=False,first_match=False))
        y.append(target(weights,samp,n_gt))
        print('mlp',i,'elapsed',time.time()-t, flush=True)
    yy=np.concatenate(y)
    for key in data:
        F=np.concatenate(data[key])
        base=0.99965*(1.037*F[:,0]-0.0425*F[:,1]+0.0055*F[:,2])
        mc=F[:,0]
        print('\\n',key,'currentblend mse',np.mean((base-yy)**2),'mc mse',np.mean((mc-yy)**2))
        X=F[:,[0,1,2]]; beta=np.linalg.lstsq(X,yy,rcond=None)[0]
        print('fit3',np.mean((X@beta-yy)**2), beta)
run()

codex
The cheap full-covariance approximation is far too biased by itself. I’m testing a more exact bivariate-normal ReLU covariance formula with vectorized quadrature; if it is not clearly better locally, I’ll avoid adding that complexity.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy import special
import time
pi=np.pi
nodes, weights = np.polynomial.legendre.leggauss(24)

def phi(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)
def Phi(x): return special.ndtr(x)

def bvncdf_pos(a,b,rho):
    # P(U<=a,V<=b), vectorized, integrate u from -9 to a. Good for challenge ranges.
    lo=-9.0
    hi=np.clip(a, lo, 9.0)
    mid=0.5*(hi+lo); half=0.5*(hi-lo)
    s=np.sqrt(np.maximum(1-rho*rho,1e-10))
    acc=np.zeros_like(a)
    for x,w in zip(nodes,weights):
        u=mid+half*x
        acc += w*phi(u)*Phi((b-rho*u)/s)
    res=half*acc
    return np.where(a<=lo, 0.0, np.where(a>=9.0, Phi(b), res))

def relu_moments_bivar(mu,S):
    v=np.maximum(np.diag(S),1e-12); sig=np.sqrt(v)
    a=mu/sig
    rho=np.clip(S/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.9999,0.9999)
    ai=a[:,None]; bj=a[None,:]
    si=sig[:,None]; sj=sig[None,:]
    phia=phi(ai); phib=phi(bj)
    s=np.sqrt(np.maximum(1-rho*rho,1e-10))
    P=bvncdf_pos(ai,bj,rho)
    A=Phi((bj-rho*ai)/s)
    B=Phi((ai-rho*bj)/s)
    Iu=phia*A + rho*phib*B
    Iv=phib*B + rho*phia*A
    phi2=np.exp(-(ai*ai-2*rho*ai*bj+bj*bj)/(2*np.maximum(1-rho*rho,1e-10)))/(2*pi*s)
    Iuv=rho*P + (1-rho*rho)*phi2 - rho*ai*phia*A - rho*bj*phib*B
    mui=mu[:,None]; muj=mu[None,:]
    second=mui*muj*P + mui*sj*Iv + muj*si*Iu + si*sj*Iuv
    # univariate exact
    c=Phi(a); p=phi(a)
    mean=mu*c+sig*p
    ez2=(mu*mu+v)*c+mu*sig*p
    var=np.maximum(ez2-mean*mean,0)
    second=0.5*(second+second.T)
    np.fill_diagonal(second, ez2)
    C=second-mean[:,None]*mean[None,:]
    C=0.5*(C+C.T); np.fill_diagonal(C,var)
    return mean,C

def full_bivar(weights):
    width=weights[0].shape[0]
    m=np.zeros(width); C=np.eye(width)
    for W in weights:
        mu=W.T@m; S=W.T@C@W; S=0.5*(S+S.T)
        m,C=relu_moments_bivar(mu,S)
    return m

def diag_prop(weights):
    width=weights[0].shape[0]; m=np.zeros(width); v=np.ones(width)
    for W in weights:
        mu=W.T@m; pv=(W*W).T@v; sig=np.sqrt(np.maximum(pv,1e-12)); a=mu/sig; c=Phi(a); p=phi(a)
        m=mu*c+sig*p; ez2=(mu*mu+pv)*c+mu*sig*p; v=np.maximum(ez2-m*m,0)
    return m

def target(weights, seed, n=300000, chunk=20000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/done

def run(width=64,depth=32,n_mlps=8,n_gt=300000):
    X=[]; y=[]; t=time.time(); ss=np.random.SeedSequence(333).spawn(2*n_mlps)
    for i in range(n_mlps):
        rng=np.random.default_rng(ss[2*i]); weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
        d=diag_prop(weights); fb=full_bivar(weights); tgt=target(weights,int(ss[2*i+1].generate_state(1)[0]),n_gt)
        X.append(np.vstack([d,fb,np.ones(width)]).T); y.append(tgt)
        print('mlp',i,'elapsed',time.time()-t,'fb mean',fb.mean(), flush=True)
    X=np.concatenate(X); yy=np.concatenate(y)
    for cols,name in [([0],'diag'),([1],'full_bivar'),([0,1],'both'),([0,1,2],'both+b')]:
        A=X[:,cols]; beta=np.linalg.lstsq(A,yy,rcond=None)[0]; pred=A@beta
        print(name,'mse',np.mean((pred-yy)**2),'beta',beta)
run()

One promising route is analytic full-covariance propagation: track the whole activation covariance with a Gaussian approximation, using the exact zero-mean ReLU correlation map as a cheap covariance update. I’m testing it locally as a potential control variate for the final layer.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy import special
import time
pi=np.pi

def univ_relu(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; phi=np.exp(-0.5*a*a)/np.sqrt(2*pi); c=special.ndtr(a)
    mean=mu*c+sig*phi; ez2=(mu*mu+var)*c+mu*sig*phi; varo=np.maximum(ez2-mean*mean,0)
    return mean, varo

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]
    for W in weights:
        pm=W.T@mu; pv=(W*W).T@var; mu,var=univ_relu(pm,pv); rows.append(mu)
    return rows[-1]

def full_zero(weights):
    width=weights[0].shape[0]
    m=np.zeros(width); C=np.eye(width); rows=[]
    var_relu0=0.5-1/(2*pi)
    for W in weights:
        mu=W.T@m
        S=W.T@C@W
        S=0.5*(S+S.T)
        v=np.maximum(np.diag(S),1e-12); sig=np.sqrt(v)
        m_out,v_out=univ_relu(mu,v)
        rho=np.clip(S/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
        corr=(kernel-1/(2*pi))/var_relu0
        C=corr*np.sqrt(np.maximum(v_out[:,None]*v_out[None,:],0))
        C=0.5*(C+C.T); C[np.diag_indices(width)]=v_out
        m=m_out; rows.append(m)
    return rows[-1]

def full_zero_meanpre(weights):
    # uses zero-mean second moment kernel scaled by pre stds, then subtract nonzero output means
    width=weights[0].shape[0]
    m=np.zeros(width); C=np.eye(width); rows=[]
    for W in weights:
        mu=W.T@m; S=W.T@C@W; S=0.5*(S+S.T)
        v=np.maximum(np.diag(S),1e-12); sig=np.sqrt(v)
        m_out,v_out=univ_relu(mu,v)
        rho=np.clip(S/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
        second=(sig[:,None]*sig[None,:])*kernel
        C=second-m_out[:,None]*m_out[None,:]
        C=0.5*(C+C.T); C[np.diag_indices(width)]=v_out
        m=m_out; rows.append(m)
    return rows[-1]

def target(weights, seed, n=300000, chunk=20000):

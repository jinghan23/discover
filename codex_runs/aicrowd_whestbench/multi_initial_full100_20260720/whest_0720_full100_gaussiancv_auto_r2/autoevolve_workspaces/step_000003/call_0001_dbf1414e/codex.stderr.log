        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); a=d_mu_pre/sig
        Phi=norm.cdf(a); phi=norm.pdf(a)
        d_mu=d_mu_pre*Phi+sig*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*Phi+d_mu_pre*sig*phi
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy()); pres.append(d_mu_pre.copy()); prevars.append(d_var_pre.copy())
    return rows,vars,pres,prevars


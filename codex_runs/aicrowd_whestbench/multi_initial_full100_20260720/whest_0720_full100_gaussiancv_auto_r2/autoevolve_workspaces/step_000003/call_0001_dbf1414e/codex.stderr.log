    depth=len(weights); width=weights[0].shape[0]
    rows, vars, pres, prevars = diag_prop(weights)
    if depth==1: return np.stack(rows).astype(np.float32)
    per=max(1, depth*(2*width*width+4*width))
    n=max(1024, int((0.625*float(budget))/float(per)))
    n=min(n,ncap); n=2*max(1,n//2)
    rng=np.random.default_rng(int(seed)+3)
    x0=rng.standard_normal((n//2,width)).astype(dtype)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(0)
            sample_cov=(z_center.T@z_center)/n
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)

    rng=np.random.default_rng(seed+3)
    x0=rng.standard_normal((n//2,width)).astype(dtype)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-z.mean(0)
            sc=(zc.T@zc)/n
            sv,svec=np.linalg.eigh(sc); tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n
            sv,svec=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            rho=np.clip(t_cov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target_second=(sigma[:,None]*sigma[None,:])*kern
            tc=target_second-rows[0][:,None]*rows[0][None,:]
            tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(tc)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            xfull=xc@(inv@ts)+rows[0]
            a,b,c=first
            x=rows[0]+a*(xm-rows[0])+b*(xfull-rows[0])+c*xc
    z=x@weights[-1]
    z64=z.astype(np.float64)
    zm=z64.mean(0); zc=z64-zm; zv=np.mean(zc*zc,0); zs=np.sqrt(np.maximum(zv,1e-12))
    final_mc=np.maximum(z64,0).mean(0)
    a=zm/zs; final_gauss=zm*norm.cdf(a)+zs*norm.pdf(a)
    amd=pres[-1]/zs; final_mixed=pres[-1]*norm.cdf(amd)+zs*norm.pdf(amd)
    # Adjust sample preactivation to diagonal-prop mean/variance, then relu-average.
    d_sig=np.sqrt(np.maximum(prevars[-1],1e-12))
    z_adj=(z64-zm)*(d_sig/np.maximum(zs,1e-12))+pres[-1]
    final_adj=np.maximum(z_adj,0).mean(0)
    # Adjust mean only and variance only Gaussian moments.
    am=pres[-1]/zs; gauss_meanfix=pres[-1]*norm.cdf(am)+zs*norm.pdf(am)
    adv=zm/d_sig; gauss_varfix=zm*norm.cdf(adv)+d_sig*norm.pdf(adv)
    # existing output features order first three important + diag + adj variants
    F=np.stack([final_mc, final_gauss, final_mixed, rows[-1], final_adj, gauss_varfix, np.ones(width)],axis=1)
    return F, rows

def target(weights,n=400000,seed=1234,chunk=50000):
    width=weights[0].shape[0]
    sums=[np.zeros(width) for _ in weights]
    rng=np.random.default_rng(seed)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for i,w in enumerate(weights):
            x=np.maximum(x@w,0)
            sums[i]+=x.astype(np.float64).sum(0)
        done+=m
    return np.stack([s/n for s in sums])

def gen(width,depth,seed):
    rng=np.random.default_rng(seed)
    sc=np.sqrt(2/width)
    return [(rng.standard_normal((width,width))*sc).astype(np.float32) for _ in range(depth)]


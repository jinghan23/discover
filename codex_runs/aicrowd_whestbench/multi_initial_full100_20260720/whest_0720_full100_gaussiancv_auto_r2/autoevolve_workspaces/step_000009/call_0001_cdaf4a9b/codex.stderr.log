# Quick synthetic coefficient fit for final combination with fixed current propagation.
import numpy as np, math, time
from scipy.special import ndtr
SQ=math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def gen(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(d)]
def diag(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pre=[]
    for w in weights:
        mp=w.T@mu; vp=(w*w).T@var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; c=ndtr(a); p=pdf(a)
        mu=mp*c+sig*p; ez2=(mp*mp+vp)*c+mp*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu); vars.append(var); pre.append((mp,vp))
    return rows,vars,pre
def feats(weights, seed, n=7520):
    width=weights[0].shape[0]; rows,vars,pre=diag(weights); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width)); x=np.concatenate([x0,-x0]); eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; sv,svv=np.linalg.eigh(sc); tv,tvv=np.linalg.eigh(tc)
            A=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T)@(tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T)); z=zc@A
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,svv=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
            tcov=np.outer(sig,sig)*ker-np.outer(rows[0],rows[0]); tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
            tv,tvv=np.linalg.eigh(tcov); B=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T)@(tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T))
            xf=xc@B+rows[0]; x=rows[0]-.1*(xm-rows[0])+1.43645*(xf-rows[0])-.43645*xc
    z=x@weights[-1]; zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); sig=np.sqrt(np.maximum(zv,1e-12)); a=zm/sig
    ga=zm*ndtr(a)+sig*pdf(a); mp,vp=pre[-1]; a2=mp/sig; mix=mp*ndtr(a2)+sig*pdf(a2); mc=np.maximum(z,0).mean(0)
    return np.stack([mc,ga,mix],axis=1)
def targ(weights, seed, N, chunk=50000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+56789); s=np.zeros(width); cnt=0
    while cnt<N:
        m=min(chunk,N-cnt); x=rng.standard_normal((m,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); cnt+=m
    return s/cnt
allF=[]; allY=[]
for width,depth,nmlp,N in [(32,8,16,350000),(32,16,16,350000),(64,8,10,250000),(64,16,10,250000)]:
    rng=np.random.default_rng(24680+width*13+depth)
    F=[]; Y=[]
    for j in range(nmlp):
        ws=gen(width,depth,rng); F.append(feats(ws,j)); Y.append(targ(ws,j,N))
    F=np.concatenate(F); Y=np.concatenate(Y); allF.append(F); allY.append(Y)
    base=(1.03699807*F[:,0]-.04249644*F[:,1]+.00549808*F[:,2])
    opt=float(np.dot(base,Y)/np.dot(base,base))
    print('dim',width,depth,'curr mse',np.mean((.99938145*base-Y)**2),'opt scale',opt,'opt mse',np.mean((opt*base-Y)**2),'coef',np.linalg.lstsq(F,Y,rcond=None)[0])
F=np.concatenate(allF); Y=np.concatenate(allY); base=(1.03699807*F[:,0]-.04249644*F[:,1]+.00549808*F[:,2])
for sc in [.9975,.9985,.9990,.99938145,.9998,1.0,1.0005]: print('scale',sc,'mse',np.mean((sc*base-Y)**2))
print('all opt scale',np.dot(base,Y)/np.dot(base,base),'all coef',np.linalg.lstsq(F,Y,rcond=None)[0])

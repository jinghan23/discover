import numpy as np, math, time
from scipy.special import ndtr
SQ=math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def gen(width,depth,rng): return [(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
def diag(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pre=[]
    for w in weights:
        mp=w.T@mu; vp=(w*w).T@var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; c=ndtr(a); p=pdf(a)
        mu=mp*c+sig*p; ez2=(mp*mp+vp)*c+mp*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu); vars.append(var); pre.append((mp,vp))
    return rows,vars,pre
def precompute(weights, seed, n):
    width=weights[0].shape[0]; rows,vars,pre=diag(weights); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width)); x=np.concatenate([x0,-x0]); eye=np.eye(width); data=[]
    # only supports varying first layer blend; after that propagate in eval_r
    w=weights[0]; z=x@w; tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; sv,svv=np.linalg.eigh(sc); tv,tvv=np.linalg.eigh(tc)
    A=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T) @ (tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T))
    z=zc@A; xr=np.maximum(z,0); xm=xr.mean(0); xc=xr-xm; sc=xc.T@xc/n; sv,svv=np.linalg.eigh(sc)
    sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999)
    ker=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
    tcov=np.outer(sig,sig)*ker-np.outer(rows[0],rows[0]); tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
    tv,tvv=np.linalg.eigh(tcov); B=svv@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svv.T) @ (tvv@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvv.T))
    xfull=xc@B+rows[0]
    return rows,vars,pre,xm,xc,xfull
def est_from_pc(weights, pc, r, am):
    rows,vars,pre,xm,xc,xfull=pc; x=rows[0]+am*(xm-rows[0])+r*(xfull-rows[0])+(1-r)*xc
    for w in weights[1:-1]: x=np.maximum(x@w,0)
    z=x@weights[-1]; zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); sig=np.sqrt(np.maximum(zv,1e-12)); a=zm/sig
    ga=zm*ndtr(a)+sig*pdf(a); mp,vp=pre[-1]; a2=mp/sig; mix=mp*ndtr(a2)+sig*pdf(a2); mc=np.maximum(z,0).mean(0)
    return .99938145*(1.03699807*mc-.04249644*ga+.00549808*mix)
def targ(weights, seed, N=500000, chunk=50000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+1111); s=np.zeros(width); cnt=0
    while cnt<N:
        m=min(chunk,N-cnt); x=rng.standard_normal((m,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); cnt+=m
    return s/cnt
sets=[]
for width,depth,nmlp,N in [(32,8,10,400000),(32,16,10,400000),(64,8,6,250000),(64,16,6,250000)]:
    rng=np.random.default_rng(9300+width*7+depth); mlps=[gen(width,depth,rng) for _ in range(nmlp)]
    pcs=[]; ys=[]
    for j,w in enumerate(mlps): pcs.append(precompute(w,j,7520)); ys.append(targ(w,j,N))
    sets.append((width,depth,mlps,pcs,ys))
print('prepared')
rs=[1.20,1.30,1.36,1.40,1.43645,1.48,1.55,1.65]
ams=[-.20,-.12,-.10,-.06,0.0,.06]
for r in rs:
    best=[]
    for am in ams:
        allerr=[]
        for width,depth,mlps,pcs,ys in sets:
            errs=[np.mean((est_from_pc(w,pc,r,am)-y)**2) for w,pc,y in zip(mlps,pcs,ys)]
            allerr.extend(errs)
        best.append((np.mean(allerr),am))
    m,am=min(best)
    print('r',r,'best',m,'am',am)
print('per dim current vs nearby')
for width,depth,mlps,pcs,ys in sets:
    print('dim',width,depth)
    for r,am in [(1.43645,-.10),(1.36,-.10),(1.48,-.10),(1.40,-.06),(1.55,-.12)]:
        errs=[np.mean((est_from_pc(w,pc,r,am)-y)**2) for w,pc,y in zip(mlps,pcs,ys)]
        print(r,am,np.mean(errs))

import numpy as np
from scipy.special import ndtr
import math, time

SQRT2PI = math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def gen_mlp(width, depth, rng):
    scale = math.sqrt(2.0/width)
    return [(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0); var=np.ones(w0)
    rows=[]; vars=[]; pre=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=(w*w).T@var
        var_pre=np.maximum(var_pre,1e-12)
        sig=np.sqrt(var_pre)
        a=mu_pre/sig
        c=ndtr(a); p=pdf(a)
        mu=mu_pre*c+sig*p
        ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sig*p
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu); vars.append(var); pre.append((mu_pre,var_pre))
    return rows,vars,pre

def est_features(weights, seed=0, n_samples=7520, r=1.43645, am=-0.100, dtype=np.float64, mode='current'):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,pre=diag_prop(weights)
    if depth==1:
        return rows[-1], rows[-1], rows[-1], rows
    rng=np.random.default_rng(seed+3)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(dtype)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-z.mean(axis=0)
            sc=(zc.T@zc)/n_samples
            sv,svec=np.linalg.eigh(sc)
            tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        # optional pre diag match for i>0
        if mode in ('pre_diag','prepost_diag','pre_diag_light') and i>0:
            m,v=pre[i]
            zm=z.mean(axis=0); zc=z-zm; zv=np.mean(zc*zc,axis=0)
            fac=np.sqrt(np.maximum(v,1e-12)/np.maximum(zv,1e-12))
            blend=1.0 if mode"'!='"'pre_diag_light' else 0.5
            z = (1-blend)*z + blend*(m + zc*fac)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(axis=0); xc=x-xm
            sc=(xc.T@xc)/n_samples
            sv,svec=np.linalg.eigh(sc)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(np.outer(sigma0,sigma0),1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
            target_second=np.outer(sigma0,sigma0)*kernel
            tcov=target_second-np.outer(rows[0],rows[0])
            tcov=0.5*(tcov+tcov.T)
            tcov=tcov*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(tcov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            xfull=xc@(inv@ts)+rows[0]
            x=rows[0]+am*(xm-rows[0])+r*(xfull-rows[0])+(1-r)*xc
        elif mode in ('post_diag','prepost_diag'):
            xm=x.mean(axis=0); xc=x-xm; xv=np.mean(xc*xc,axis=0)
            fac=np.sqrt(np.maximum(vars[i],1e-12)/np.maximum(xv,1e-12))
            x=rows[i]+xc*fac
    z=x@weights[-1]
    zm=z.mean(axis=0); zc=z-zm; zv=np.mean(zc*zc,axis=0)
    sig=np.sqrt(np.maximum(zv,1e-12)); a=zm/sig
    gauss=zm*ndtr(a)+sig*pdf(a)
    mu_pre,var_pre=pre[-1]
    a2=mu_pre/sig
    mixed=mu_pre*ndtr(a2)+sig*pdf(a2)
    mc=np.maximum(z,0).mean(axis=0)
    cur=0.99938145*(1.03699807*mc-0.04249644*gauss+0.00549808*mixed)
    return mc,gauss,mixed,rows,cur

def target(weights, seed, n=300000, chunk=50000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed+1000003)
    s=np.zeros(width); cnt=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-cnt)
        if m<=0: break
        x=rng.standard_normal((m,width)).astype(np.float64)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0); cnt+=m
    return s/cnt

for width,depth,nmlp,nt in [(32,8,12,300000),(64,8,8,200000),(32,16,8,250000)]:
    rng=np.random.default_rng(12345+width*10+depth)
    Fs=[]; Ys=[]; Cur=[]
    st=time.time()
    for j in range(nmlp):
        weights=gen_mlp(width,depth,rng)
        y=target(weights, seed=j, n=nt)
        mc,g,m,rows,cur=est_features(weights, seed=j, n_samples=7520)
        Fs.append(np.stack([mc,g,m],axis=1)); Ys.append(y); Cur.append(cur)
    F=np.concatenate(Fs,axis=0); Y=np.concatenate(Ys,axis=0); Cur=np.concatenate(Cur)
    # ridge/lstsq coefficients no intercept
    coef=np.linalg.lstsq(F,Y,rcond=None)[0]
    pred=F@coef
    print('dim',width,depth,'time',time.time()-st)
    print('cur mse',np.mean((Cur-Y)**2),'mc',np.mean((F[:,0]-Y)**2),'gauss',np.mean((F[:,1]-Y)**2),'mixed',np.mean((F[:,2]-Y)**2))
    print('coef',coef,'mse',np.mean((pred-Y)**2), 'scale current sum',0.99938145*(1.03699807-0.04249644+0.00549808))

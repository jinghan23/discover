# Compare symmetric eig vs Cholesky covariance matching on synthetic.
import numpy as np, math
from scipy.special import ndtr
SQ=math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def gen(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(d)]
def diag(ws):
    width=ws[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pre=[]
    for w in ws:
        mp=w.T@mu; vp=(w*w).T@var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; c=ndtr(a); p=pdf(a)
        mu=mp*c+sig*p; ez2=(mp*mp+vp)*c+mp*sig*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu); vars.append(var); pre.append((mp,vp))
    return rows,vars,pre
def covmatch(xc, S, T, method):
    if method=='eig':
        sv,svec=np.linalg.eigh(S); tv,tvec=np.linalg.eigh(T); return xc@(svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)@(tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)))
    if method=='chol':
        n=S.shape[0]; jitter=1e-10*np.eye(n)
        Ls=np.linalg.cholesky(S+jitter); Lt=np.linalg.cholesky(T+jitter)
        A=np.linalg.solve(Ls.T, Lt.T)
        return xc@A
    if method=='cholT':
        n=S.shape[0]; jitter=1e-10*np.eye(n)
        Ls=np.linalg.cholesky(S+jitter); Lt=np.linalg.cholesky(T+jitter)
        A=np.linalg.solve(Ls, Lt)
        return xc@A

def est(ws, seed, method, n=7520):
    width=ws[0].shape[0]; rows,vars,pre=diag(ws); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width)); x=np.concatenate([x0,-x0]); eye=np.eye(width)
    for i,w in enumerate(ws[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n; z=covmatch(zc,sc,tc,method)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi); tcov=np.outer(sig,sig)*ker-np.outer(rows[0],rows[0]); tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
            xf=covmatch(xc,sc,tcov,method)+rows[0]; x=rows[0]-.1*(xm-rows[0])+1.43645*(xf-rows[0])-.43645*xc
    z=x@ws[-1]; zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); sig=np.sqrt(np.maximum(zv,1e-12)); a=zm/sig; ga=zm*ndtr(a)+sig*pdf(a); mp,vp=pre[-1]; a2=mp/sig; mix=mp*ndtr(a2)+sig*pdf(a2); mc=np.maximum(z,0).mean(0); return .99938145*(1.03699807*mc-.04249644*ga+.00549808*mix)
def targ(ws, seed, N=250000):
    width=ws[0].shape[0]; rng=np.random.default_rng(seed+2468); s=np.zeros(width); cnt=0
    while cnt<N:
        m=min(50000,N-cnt); x=rng.standard_normal((m,width))
        for w in ws: x=np.maximum(x@w,0)
        s+=x.sum(0); cnt+=m
    return s/cnt

codex
I’m going to test a deterministic full-second-moment approximation locally: propagate the full activation second-moment matrix with the zero-mean ReLU kernel, while keeping exact univariate means/diagonals. If it is accurate enough, it could act as another final-layer control variate.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.special import ndtr
SQ=math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def relu_mom(m,v):
    v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; c=ndtr(a); p=pdf(a); mu=m*c+s*p; ez2=(m*m+v)*c+m*s*p; return mu,ez2

def full_approx(ws):
    width=ws[0].shape[0]; mu=np.zeros(width); M=np.eye(width); rows=[]
    for w in ws:
        mean=w.T@mu
        second=w.T@M@w
        diag2=np.maximum(np.diag(second),1e-12)
        var=np.maximum(diag2-mean*mean,1e-12)
        mu,ez2=relu_mom(mean,var)
        sig=np.sqrt(diag2)
        rho=np.clip(second/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999)
        ker=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
        M=np.outer(sig,sig)*ker
        np.fill_diagonal(M, ez2)
        rows.append(mu)
    return np.array(rows), M, mu

def diag_approx(ws):
    width=ws[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]
    for w in ws:
        mp=w.T@mu; vp=(w*w).T@var; mu,ez2=relu_mom(mp,vp); var=np.maximum(ez2-mu*mu,0); rows.append(mu)
    return np.array(rows)

def targ(ws, seed, N=300000):
    width=ws[0].shape[0]; rng=np.random.default_rng(seed+321); sums=[]; s=None; cnt=0
    while cnt<N:
        m=min(50000,N-cnt); x=rng.standard_normal((m,width))
        for w in ws: x=np.maximum(x@w,0)
        if s is None: s=np.zeros(width)
        s+=x.sum(0); cnt+=m
    return s/cnt
def gen(w,d,rng): return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float64) for _ in range(d)]
for width,depth,nmlp,N in [(32,8,20,300000),(32,16,20,300000),(32,32,15,250000),(64,16,10,220000),(64,32,8,180000)]:
    rng=np.random.default_rng(4444+width+depth); e_full=[]; e_diag=[]; rows=[]
    for j in range(nmlp):
        ws=gen(width,depth,rng); y=targ(ws,j,N); fa,_,_=full_approx(ws); da=diag_approx(ws); e_full.append(np.mean((fa[-1]-y)**2)); e_diag.append(np.mean((da[-1]-y)**2))
    print(width,depth,'full',np.mean(e_full),'diag',np.mean(e_diag))

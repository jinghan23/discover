from scipy.stats import multivariate_normal, norm
nodes8=np.array([0.0198550717512319,0.101666761293187,0.237233795041836,0.408282678752175,0.591717321247825,0.762766204958164,0.898333238706813,0.980144928248768])
weights8=np.array([0.0506142681451881,0.111190517226687,0.156853322938944,0.181341891689181,0.181341891689181,0.156853322938944,0.111190517226687,0.0506142681451881])
nodes12=np.array([0.00921968287664037,0.0479413718147626,0.115048662902848,0.206341022856691,0.31608425050091,0.437383295744266,0.562616704255734,0.68391574949909,0.793658977143309,0.884951337097152,0.952058628185237,0.99078031712336])

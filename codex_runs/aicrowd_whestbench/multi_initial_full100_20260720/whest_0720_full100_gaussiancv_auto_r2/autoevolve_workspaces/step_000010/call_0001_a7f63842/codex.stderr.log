import numpy as np
try:
    from scipy.stats import multivariate_normal, norm
    print('scipy ok')
except Exception as e:
    print('no scipy', e)
    raise SystemExit

def moment_formula(mu1,mu2,s1,s2,rho):
    a=mu1/s1; b=mu2/s2; s=np.sqrt(max(1-rho*rho,1e-12))
    P=multivariate_normal.cdf([a,b], mean=[0,0], cov=[[1,rho],[rho,1]])
    phia=norm.pdf(a); phib=norm.pdf(b)
    Eu=phia*norm.cdf((b+rho*a)/s)+rho*phib*norm.cdf((a+rho*b)/s)
    Ev=phib*norm.cdf((a+rho*b)/s)+rho*phia*norm.cdf((b+rho*a)/s)
    pdf2=np.exp(-(a*a-2*rho*a*b+b*b)/(2*s*s))/(2*np.pi*s)
    Euv=rho*P+(1-rho*rho)*pdf2
    return mu1*mu2*P + mu1*s2*Ev + mu2*s1*Eu + s1*s2*Euv
rng=np.random.default_rng(0)
for params in [(0,0,1,1,0),(0,0,1,1,.5),(1,-.5,2,.7,.3),(-1,-.2,1.3,2,-.4)]:

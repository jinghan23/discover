    cov=[[s1*s1,rho*s1*s2],[rho*s1*s2,s2*s2]]
    z=rng.multivariate_normal([mu1,mu2],cov,size=2000000)
    mc=np.mean(np.maximum(z[:,0],0)*np.maximum(z[:,1],0))
    fm=moment_formula(*params)
    print(params, mc, fm, fm-mc)

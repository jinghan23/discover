def cdfq(a,b,rho,nodes,weights):
    s=np.sqrt(np.maximum(1-rho*rho,1e-12))
    p1=norm.cdf(a)
    u=np.clip(p1[...,None]*nodes,1e-12,1-1e-12)
    x=norm.ppf(u)
    vals=norm.cdf((b[...,None]-rho[...,None]*x)/s[...,None])
    return p1*np.sum(weights*vals,axis=-1)

rng=np.random.default_rng(0)
for K,nodes,weights in [(8,nodes8,weights8),(12,nodes12,weights12)]:
  errs=[]
  for _ in range(1000):
    a,b=rng.normal(0,1.5,2)
    rho=rng.uniform(-.95,.95)
    true=multivariate_normal.cdf([a,b],cov=[[1,rho],[rho,1]])
    q=cdfq(np.array(a),np.array(b),np.array(rho),nodes,weights)
    errs.append(abs(true-q))
  print(K, np.mean(errs), np.percentile(errs,[50,90,99]), np.max(errs))

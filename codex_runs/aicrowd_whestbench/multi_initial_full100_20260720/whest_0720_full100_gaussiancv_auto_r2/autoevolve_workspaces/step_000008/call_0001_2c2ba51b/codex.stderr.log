            sv,se=np.linalg.eigh(scov); tv,te=np.linalg.eigh(tcov)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; scov=(xc.T@xc)/n; sv,se=np.linalg.eigh(scov)
            sigma=np.sqrt(np.maximum(np.diag(tcov),1e-12)); scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(tcov/scale,-0.999999,0.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            t2=sigma[:,None]*sigma[None,:]*ker; tc=t2-diag_rows[0][:,None]*diag_rows[0][None,:]
            tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=np.linalg.eigh(tc)
            xfull=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+diag_rows[0]
            x=diag_rows[0] - mean_corr*(xm-diag_rows[0]) + acoef*(xfull-diag_rows[0]) + bcoef*xc
    z=x@weights[-1]
    zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0); sig=np.sqrt(np.maximum(zv,1e-12))
    fg=zm*cdf(zm/sig)+sig*pdf(zm/sig)

/bin/bash -lc "python - <<'PY'
import time
import numpy as np
from scipy import special

SQRT2PI = np.sqrt(2*np.pi)

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI
def cdf(x): return special.ndtr(x)

def diag_prop(weights):
    w0 = weights[0].shape[0]
    mu = np.zeros(w0)
    var = np.ones(w0)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for W in weights:
        mu_pre = W.T @ mu
        var_pre = (W*W).T @ var
        var_pre = np.maximum(var_pre, 1e-12)
        sig = np.sqrt(var_pre)
        a = mu_pre/sig
        Phi = cdf(a); phi=pdf(a)
        mu = mu_pre*Phi + sig*phi
        ez2 = (mu_pre*mu_pre+var_pre)*Phi + mu_pre*sig*phi
        var = np.maximum(ez2 - mu*mu, 0.0)
        rows.append(mu); vars.append(var); pre_mus.append(mu_pre); pre_vars.append(var_pre)
    return rows, vars, pre_mus, pre_vars

def current(weights, seed=0, n=7520, mean_corr=-0.100, acoef=1.43645, bcoef=-0.43645, final_scale=0.99938145, c_mc=1.03699807, c_gauss=-0.04249644, c_mix=0.00549808, diag_match=False, recenter=False, z_var_diag_blend=None):
    width=weights[0].shape[0]; depth=len(weights)
    diag_rows, diag_vars, pre_mus, pre_vars = diag_prop(weights)
    if depth==1: return np.stack(diag_rows).astype(np.float32)
    rng=np.random.default_rng(seed+3)
    half=n//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            t_cov=W.T@W
            zc=z-z.mean(0)
            scov=(zc.T@zc)/n
            sv,se=np.linalg.eigh(scov)
            tv,te=np.linalg.eigh(t_cov)
            inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; scov=(xc.T@xc)/n
            sv,se=np.linalg.eigh(scov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            ker=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*ker
            tcov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            tcov=0.5*(tcov+tcov.T)
            tcov=tcov*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=np.linalg.eigh(tcov)
            inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            xfull=xc@(inv@ts)+diag_rows[0]
            x=diag_rows[0] - mean_corr*(xm-diag_rows[0]) + acoef*(xfull-diag_rows[0]) + bcoef*xc
        elif diag_match:
            xm=x.mean(0); xc=x-xm
            xv=np.mean(xc*xc,0)
            scale=np.sqrt(np.maximum(diag_vars[i],1e-12)/np.maximum(xv,1e-12))
            x=diag_rows[i] + xc*scale
        elif recenter:
            x=x - x.mean(0) + diag_rows[i]
    z=x@weights[-1]
    zm=z.mean(0); zc=z-zm; zv=np.mean(zc*zc,0)
    if z_var_diag_blend is not None:
        # blend sample final pre variance with diagonal propagated final pre variance
        zv=(1-z_var_diag_blend)*zv + z_var_diag_blend*pre_vars[-1]
    sig=np.sqrt(np.maximum(zv,1e-12))
    aa=zm/sig; fg=zm*cdf(aa)+sig*pdf(aa)
    am=pre_mus[-1]/sig; fm=pre_mus[-1]*cdf(am)+sig*pdf(am)
    fmc=np.maximum(z,0).mean(0)
    final=final_scale*(c_mc*fmc+c_gauss*fg+c_mix*fm)
    return np.stack(diag_rows[:-1]+[final]).astype(np.float32)

def target(weights, seed=123, n=300000, chunk=20000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(width,dtype=np.float64); done=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return (s/done).astype(np.float32)

def run(width=64,depth=8,nmlp=6):
    print('case',width,depth,nmlp, flush=True)
    variants={
      'base':{},
      'recenter':{'recenter':True},
      'diagmatch':{'diag_match':True},
      'zblend02':{'z_var_diag_blend':0.2},
      'zblend-02':{'z_var_diag_blend':-0.2},
      'no_scale':{'final_scale':1.0},
      'less_mc':{'c_mc':1.02,'c_gauss':-0.02,'c_mix':0.0},
    }
    ms={k:[] for k in variants}
    rng=np.random.default_rng(2027+width*3+depth)
    scale=np.sqrt(2/width)
    t0=time.time()
    for j in range(nmlp):
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]
        y=target(weights, seed=9000+j, n=250000 if width<=64 else 120000)
        for k,kw in variants.items():
            p=current(weights, seed=1000+j, n=7520, **kw)[-1]
            ms[k].append(float(np.mean((p-y)**2)))
        print(j, {k: f'{np.mean(v):.3e}' for k,v in ms.items()}, flush=True)
    print('elapsed',time.time()-t0)
    for k,v in sorted(ms.items(), key=lambda kv: np.mean(kv[1])):
        print(k, np.mean(v), np.std(v)/np.sqrt(len(v)))


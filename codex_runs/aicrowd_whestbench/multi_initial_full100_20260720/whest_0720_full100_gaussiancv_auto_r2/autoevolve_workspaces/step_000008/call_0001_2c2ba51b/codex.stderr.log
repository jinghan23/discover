import numpy as np
from scipy import special, stats
# Reuse compact version from earlier for feature/current with provided initial x
SQRT2PI=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI
def cdf(x): return special.ndtr(x)

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
    for W in weights:
        m=W.T@mu; v=(W*W).T@var; v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; P=cdf(a); p=pdf(a)
        mu=m*P+s*p; ez2=(m*m+v)*P+m*s*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var); prem.append(m)
    return rows,vars,prem

def pred(weights, x):
    n=x.shape[0]; width=x.shape[1]; rows,vars,prem=diag_prop(weights); eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            tcov=W.T@W; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tcov)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-0.999999,0.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            tc=sigma[:,None]*sigma[None,:]*ker-rows[0][:,None]*rows[0][None,:]; tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]
            tv,te=np.linalg.eigh(tc)
            xfull=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]
            x=rows[0]-0.100*(xm-rows[0])+1.43645*(xfull-rows[0])-0.43645*xc
    z=x@weights[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); sig=np.sqrt(np.maximum(zv,1e-12))
    fg=zm*cdf(zm/sig)+sig*pdf(zm/sig); fm=prem[-1]*cdf(prem[-1]/sig)+sig*pdf(prem[-1]/sig); fmc=np.maximum(z,0).mean(0)
    return 0.99938145*(1.03699807*fmc-0.04249644*fg+0.00549808*fm)

def target(weights, seed, n=300000):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
    while done<n:
        m=min(25000,n-done); x=rng.standard_normal((m,w), dtype=np.float32).astype(float)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n

def sobol_normal(n,w,seed):
    m=int(np.ceil(np.log2(n)))
    sampler=stats.qmc.Sobol(d=w, scramble=True, seed=seed)
    u=sampler.random_base2(m)[:n]
    u=np.clip(u,1e-7,1-1e-7)
    return special.ndtri(u)

def rand_anti(n,w,seed):
    rng=np.random.default_rng(seed+3); h=n//2; x0=rng.standard_normal((h,w), dtype=np.float32).astype(float); return np.concatenate([x0,-x0])
for width,depth,nmlp in [(64,8,8),(128,8,4),(64,16,4)]:
    rng=np.random.default_rng(4242+width+depth); scale=np.sqrt(2/width)
    mr=[]; ms=[]
    for j in range(nmlp):
        weights=[(rng.standard_normal((width,width))*scale).astype(float) for _ in range(depth)]
        y=target(weights, 7000+j, n=220000 if width==64 else 120000)
        pr=pred(weights, rand_anti(7520,width,1000+j)); ps=pred(weights, sobol_normal(8192,width,1000+j)[:7520])
        mr.append(np.mean((pr-y)**2)); ms.append(np.mean((ps-y)**2))
    print('case',width,depth,'rand',np.mean(mr),'sobol',np.mean(ms),'ratio',np.mean(ms)/np.mean(mr))

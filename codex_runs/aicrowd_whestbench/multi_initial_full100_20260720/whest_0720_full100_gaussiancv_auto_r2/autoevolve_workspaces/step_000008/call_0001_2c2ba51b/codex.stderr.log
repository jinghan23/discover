/bin/bash -lc "python - <<'PY'
# Tune first-layer constants on synthetic cases, reusing approximate implementation.
import numpy as np
from scipy import special
SQ=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def cdf(x): return special.ndtr(x)
def diag(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
    for W in weights:
        m=W.T@mu; v=np.maximum((W*W).T@var,1e-12); s=np.sqrt(v); P=cdf(m/s); p=pdf(m/s); mu=m*P+s*p; ez=(m*m+v)*P+m*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var); prem.append(m)
    return rows,vars,prem
def pred(weights,mcorr=0.100,acoef=1.43645,n=7520,seed=1):
    width=weights[0].shape[0]; rows,vars,prem=diag(weights); rng=np.random.default_rng(seed+3); h=n//2; x0=rng.standard_normal((h,width), dtype=np.float32).astype(float); x=np.concatenate([x0,-x0]); eye=np.eye(width)
    for i,W in enumerate(weights[:-1]):
        z=x@W
        if i==0:
            tcov=W.T@W; zc=z-z.mean(0); sv,se=np.linalg.eigh((zc.T@zc)/n); tv,te=np.linalg.eigh(tcov); z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sv,se=np.linalg.eigh((xc.T@xc)/n); sig=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tc=sig[:,None]*sig[None,:]*ker-rows[0][:,None]*rows[0][None,:]; tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,te=np.linalg.eigh(tc); xfull=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]; x=rows[0]-mcorr*(xm-rows[0])+acoef*(xfull-rows[0])+(1-acoef)*xc
    z=x@weights[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); s=np.sqrt(np.maximum(zv,1e-12)); fg=zm*cdf(zm/s)+s*pdf(zm/s); fm=prem[-1]*cdf(prem[-1]/s)+s*pdf(prem[-1]/s); return 0.99938145*(1.03699807*np.maximum(z,0).mean(0)-0.04249644*fg+0.00549808*fm)
def targ(weights,n,seed):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
    while done<n:
        m=min(25000,n-done); x=rng.standard_normal((m,w), dtype=np.float32).astype(float)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=m
    return s/n
cases=[]
for width,depth,nmlp,nt in [(64,8,8,220000),(128,8,4,120000),(64,16,4,180000),(128,4,4,150000)]:
    rng=np.random.default_rng(9000+width*7+depth); scale=np.sqrt(2/width)
    for j in range(nmlp):
        W=[(rng.standard_normal((width,width))*scale).astype(float) for _ in range(depth)]
        y=targ(W,nt,100+j+depth)
        cases.append((W,y,2000+j))
print('cases',len(cases))
results=[]
for mc in [0.0,0.05,0.10,0.15,0.20,-0.05]:
  for a in [1.0,1.2,1.35,1.43645,1.55,1.75]:
    vals=[]
    for W,y,sd in cases:
      p=pred(W,mc,a,seed=sd)
      vals.append(np.mean((p-y)**2))
    results.append((np.mean(vals),mc,a))
for r in sorted(results)[:15]: print(r)
print('current',[r for r in results if abs(r[1]-0.1)<1e-9 and abs(r[2]-1.43645)<1e-9][0])

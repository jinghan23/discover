# Compare 7520 transformed vs 6000 transformed + 1520 raw direct, synthetic.
# Same functions as previous but trimmed by exec reuse is impossible, so keep output only.
import numpy as np
from scipy import special
SQ=np.sqrt(2*np.pi)
def pdf(x): return np.exp(-0.5*x*x)/SQ
def cdf(x): return special.ndtr(x)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]
 for W in Ws:
  m=W.T@mu; v=np.maximum((W*W).T@var,1e-12); s=np.sqrt(v); P=cdf(m/s); p=pdf(m/s); mu=m*P+s*p; ez=(m*m+v)*P+m*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var); prem.append(m)
 return rows,vars,prem
def trans(Ws,n,seed):
 width=Ws[0].shape[0]; rows,vars,prem=diag(Ws); rng=np.random.default_rng(seed+3); x0=rng.standard_normal((n//2,width), dtype=np.float32).astype(float); x=np.concatenate([x0,-x0]); eye=np.eye(width)
 for i,W in enumerate(Ws[:-1]):
  z=x@W
  if i==0:
   tcov=W.T@W; zc=z-z.mean(0); sv,se=np.linalg.eigh((zc.T@zc)/n); tv,te=np.linalg.eigh(tcov); z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
  x=np.maximum(z,0)
  if i==0:
   xm=x.mean(0); xc=x-xm; sv,se=np.linalg.eigh((xc.T@xc)/n); sig=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sig[:,None]*sig[None,:],1e-12),-0.999999,0.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho)/(2*np.pi); tc=sig[:,None]*sig[None,:]*ker-rows[0][:,None]*rows[0][None,:]; tc=0.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,te=np.linalg.eigh(tc); xfull=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)@(te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]; x=rows[0]-0.1*(xm-rows[0])+1.43645*(xfull-rows[0])-0.43645*xc
 z=x@Ws[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); s=np.sqrt(np.maximum(zv,1e-12)); fg=zm*cdf(zm/s)+s*pdf(zm/s); fm=prem[-1]*cdf(prem[-1]/s)+s*pdf(prem[-1]/s); return 0.99938145*(1.03699807*np.maximum(z,0).mean(0)-0.04249644*fg+0.00549808*fm)
def direct(Ws,n,seed):
 width=Ws[0].shape[0]; rng=np.random.default_rng(seed+17); x0=rng.standard_normal((n//2,width), dtype=np.float32).astype(float); x=np.concatenate([x0,-x0])
 for W in Ws: x=np.maximum(x@W,0)
 return x.mean(0)
def targ(Ws,n,seed):
 w=Ws[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0
 while done<n:
  m=min(25000,n-done); x=rng.standard_normal((m,w), dtype=np.float32).astype(float)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
for width,depth,nmlp in [(64,8,10),(128,8,5),(64,16,5),(128,4,5)]:
 rng=np.random.default_rng(444+width+depth); scale=np.sqrt(2/width); b=[]; h=[]
 for j in range(nmlp):
  Ws=[(rng.standard_normal((width,width))*scale).astype(float) for _ in range(depth)]
  y=targ(Ws,180000 if width==64 else 100000,600+j)
  base=trans(Ws,7520,900+j)
  c=trans(Ws,6000,900+j); d=direct(Ws,1520,900+j)
  b.append(np.mean((base-y)**2)); h.append(np.mean((0.94*c+0.06*d-y)**2))
 print(width,depth,'base7520',np.mean(b),'hyb',np.mean(h),'ratio',np.mean(h)/np.mean(b))

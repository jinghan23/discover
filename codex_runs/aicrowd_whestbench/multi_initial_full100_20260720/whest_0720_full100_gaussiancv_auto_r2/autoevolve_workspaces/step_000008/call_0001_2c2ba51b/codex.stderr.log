 z=x@Ws[-1]; zm=z.mean(0); zv=((z-zm)**2).mean(0); s=np.sqrt(np.maximum(zv,1e-12)); fmc=np.maximum(z,0).mean(0); fg=zm*cdf(zm/s)+s*pdf(zm/s); fm=prem[-1]*cdf(prem[-1]/s)+s*pdf(prem[-1]/s); cfm=cprem[-1]*cdf(cprem[-1]/s)+s*pdf(cprem[-1]/s)
 return np.vstack([fmc,fg,fm,cfm,rows[-1],crows[-1]]).T

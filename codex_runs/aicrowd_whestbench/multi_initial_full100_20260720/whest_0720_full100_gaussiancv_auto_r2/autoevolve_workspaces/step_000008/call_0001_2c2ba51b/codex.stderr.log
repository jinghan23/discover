    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; prem=[]; prev=[]
    for W in weights:
        m=W.T@mu; v=(W*W).T@var; v=np.maximum(v,1e-12); s=np.sqrt(v); a=m/s; P=cdf(a); p=pdf(a)
        mu=m*P+s*p; ez2=(m*m+v)*P+m*s*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var); prem.append(m); prev.append(v)
    return rows,vars,prem,prev

def features(weights, seed=0, n=7520, mean_corr=-0.100, acoef=1.43645, bcoef=-0.43645):
    width=weights[0].shape[0]; diag_rows,diag_vars,prem,prev=diag_prop(weights)
    rng=np.random.default_rng(seed+3); half=n//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64); x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)

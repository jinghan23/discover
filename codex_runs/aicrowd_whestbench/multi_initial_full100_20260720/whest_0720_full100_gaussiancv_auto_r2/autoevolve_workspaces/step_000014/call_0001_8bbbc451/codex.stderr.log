/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import time

SQRT2PI_INV = 1/np.sqrt(2*np.pi)
pi=np.pi

def pdf(x): return np.exp(-0.5*x*x)*SQRT2PI_INV

def diag_prop(weights):
    w0=weights[0].shape[0]
    d_mu=np.zeros(w0)
    d_var=np.ones(w0)
    rows=[]; vars=[]; pre_mu=None; pre_var=None
    for w in weights:
        pre_mu=w.T@d_mu
        pre_var=(w*w).T@d_var
        pre_var=np.maximum(pre_var,1e-12)
        sig=np.sqrt(pre_var); alpha=pre_mu/sig; phi=pdf(alpha); cdf=ndtr(alpha)
        d_mu=pre_mu*cdf+sig*phi
        ez2=(pre_mu*pre_mu+pre_var)*cdf+pre_mu*sig*phi
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu); vars.append(d_var)
    return rows,vars,pre_mu,pre_var

def features(weights, seed=0, n=7520, mean_corr=-0.100, blend=1.43645):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,pre_mu,pre_var=diag_prop(weights)
    rng=np.random.default_rng(seed+3)
    half=n//2
    x0=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-z.mean(0)
            sc=(zc.T@zc)/n
            sv,svec=np.linalg.eigh(sc)
            tv,tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm
            sc=(xc.T@xc)/n
            sv,svec=np.linalg.eigh(sc)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(np.outer(sigma0,sigma0),1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kern=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=scale*kern
            target_cov=target_second-np.outer(rows[0],rows[0])
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(target_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            x_full=xc@(inv@ts)+rows[0]
            x=rows[0]+mean_corr*(xm-rows[0])+blend*(x_full-rows[0])+(1-blend)*xc
    z=x@weights[-1]
    z_mean=z.mean(0); zc=z-z_mean; z_var=(zc*zc).mean(0); z_sig=np.sqrt(np.maximum(z_var,1e-12))
    alpha=z_mean/z_sig; cdf=ndtr(alpha); phi=pdf(alpha)
    fg=z_mean*cdf+z_sig*phi
    amd=pre_mu/z_sig
    fmd=pre_mu*ndtr(amd)+z_sig*pdf(amd)
    fmc=np.maximum(z,0).mean(0)
    fd=rows[-1]
    m3=(zc**3).mean(0); skew=m3/(z_sig**3+1e-18)
    m4=(zc**4).mean(0); kurt=m4/(z_sig**4+1e-18)-3
    t=-alpha
    # Edgeworth corrections
    fe3=fg + z_sig*(skew/6.0)*(t*phi)  # t=-alpha -> from derivation A3=t phi
    fe34=fe3 + z_sig*(kurt/24.0)*((t*t-1)*phi)
    return np.stack([fmc,fg,fmd,fd,fe3,fe34],axis=1)

def target(weights, rng, n=200000, chunk=20000):
    width=weights[0].shape[0]
    s=np.zeros(width)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(0)
        done+=m
    return s/n

def run(width=32,depth=6,n_mlps=30,n_target=100000,n_est=7520):
    rng=np.random.default_rng(123)
    X=[]; y=[]
    t0=time.time()
    for k in range(n_mlps):
        scale=np.sqrt(2/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]
        yk=target(weights,rng,n_target)
        fk=features(weights,seed=int(rng.integers(0,2**32-1)),n=n_est)
        X.append(fk); y.append(yk)
        if (k+1)%5==0: print('mlp',k+1,'elapsed',time.time()-t0,flush=True)
    X=np.concatenate(X,axis=0); y=np.concatenate(y,axis=0)
    cur=0.99938145*(1.01883590*X[:,0]-0.026*X[:,1]+0.00716410*X[:,2])
    print('current mse',np.mean((cur-y)**2))
    for cols,name in [([0],'mc'),([0,1,2],'mc/fg/fmd'),([0,1,2,3],'add_fd'),([0,1,2,4],'add_fe3'),([0,1,2,5],'add_fe34'),([0,1,2,3,4,5],'all')]:
        A=X[:,cols]
        coef=np.linalg.lstsq(A,y,rcond=None)[0]
        pred=A@coef
        print(name,'mse',np.mean((pred-y)**2),'coef',coef)
    # constrained sum maybe with intercept? include intercept
    A=np.c_[X[:,0], X[:,1], X[:,2], np.ones(len(y))]
    coef=np.linalg.lstsq(A,y,rcond=None)[0]
    print('with intercept mse',np.mean((A@coef-y)**2),'coef',coef)
run()

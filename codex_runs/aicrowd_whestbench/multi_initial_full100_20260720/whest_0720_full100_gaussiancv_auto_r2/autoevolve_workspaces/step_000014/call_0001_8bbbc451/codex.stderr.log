def target(weights,rng,n,chunk=100000):
 width=weights[0].shape[0]; s=np.zeros(width); done=0
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
  for w in weights: x=np.maximum(x@w,0)
  s+=x.sum(0); done+=m
 return s/n
def run(width=32,depth=6,n_mlps=20,n_target=2000000):
 rng=np.random.default_rng(321); X=[]; y=[]; t0=time.time()
 for k in range(n_mlps):
  scale=np.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]
  seed=int(rng.integers(0,2**32-1)); fk=features(weights,seed=seed); yk=target(weights,rng,n_target)
  X.append(fk); y.append(yk); print(k+1,time.time()-t0,flush=True)
 X=np.concatenate(X,0); y=np.concatenate(y,0)
 cur=0.99938145*(1.01883590*X[:,0]-0.026*X[:,1]+0.00716410*X[:,2])
 print('current',np.mean((cur-y)**2),'mc',np.mean(((0.9996801*X[:,0])-y)**2), 'rawmc',np.mean((X[:,0]-y)**2))
 for cols,name in [([0,1,2],'3'),([0,1,2,3],'fd'),([0,1,2,4],'fe3'),([0,1,2,5],'fe34'),([0,1,2,3,4,5],'all')]:
  A=X[:,cols]; coef=np.linalg.lstsq(A,y,rcond=None)[0]; print(name,np.mean((A@coef-y)**2),coef)
run()

import numpy as np
from scipy.special import ndtr
from math import sqrt, pi

SQRT2PI_INV = 1.0 / sqrt(2*pi)
def pdf(x): return np.exp(-0.5*x*x)*SQRT2PI_INV

def sample_weights(width, depth, seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2.0/width).astype(np.float32) if hasattr(np.sqrt(2.0/width),'astype') else np.float32(np.sqrt(2.0/width))
    return [(rng.standard_normal((width,width), dtype=np.float32)*scale).astype(np.float32) for _ in range(depth)]

def target(weights, n=262144, seed=123, chunk=16384):
    rng=np.random.default_rng(seed)
    width=weights[0].shape[0]; depth=len(weights)
    sums=np.zeros((depth,width), dtype=np.float64)
    done=0
    for s in range(0,n,chunk):
        m=min(chunk,n-s)
        x=rng.standard_normal((m,width), dtype=np.float32)
        for i,w in enumerate(weights):
            x=x@w
            np.maximum(x,0,out=x)
            sums[i]+=x.sum(axis=0, dtype=np.float64)
        done+=m
    return (sums/done).astype(np.float32)

def diag_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width, dtype=np.float64)
    var=np.ones(width, dtype=np.float64)
    rows=[]; vars=[]
    for w in weights:
        wd=w.astype(np.float64)
        mu_pre=wd.T@mu
        var_pre=np.maximum((wd*wd).T@var, 1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=pdf(alpha); cdf=ndtr(alpha)
        mu=mu_pre*cdf + sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf + mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.copy()); vars.append(var.copy())
    return np.stack(rows).astype(np.float32), np.stack(vars).astype(np.float32)

def estimate(weights, mlp_seed=999, n_samples=4096, c0=-0.14, c1=0.075, final=(0.946,0.048,0.006), layer_extra=None, whiten=True, row_scale=True):
    width=weights[0].shape[0]; depth=len(weights)
    diag, dvars=diag_prop(weights)
    rng=np.random.default_rng(mlp_seed)
    half=n_samples//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate([base,-base],axis=0).astype(np.float32)
    x=x-x.mean(axis=0, keepdims=True)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    if whiten:
        cov=(x.T@x)/float(n_samples)
        vals,vecs=np.linalg.eigh(cov.astype(np.float64))
        inv=vecs@(np.diag(1.0/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
        x=(x@inv).astype(np.float32)
        if row_scale:
            x_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
            x=x*(row_norm/x_norm)
    for i,w in enumerate(weights[:-1]):
        x=x@w; np.maximum(x,0,out=x)
        coeff=None
        if i==0: coeff=c0 # x = coeff*x + (1-coeff)*x_match? current coeff=-.14, match=1.14
        elif i==1: coeff=1.0-c1 # current x=0.925 x + 0.075 match
        elif layer_extra is not None:
            coeff=1.0-layer_extra
        if coeff is not None:
            xm=x.mean(axis=0,keepdims=True)
            xc=x-xm
            xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
            xmatch=xc*np.sqrt(np.maximum(dvars[i],1e-12)/xv)+diag[i]
            x=(coeff*x + (1.0-coeff)*xmatch).astype(np.float32)
    z=x@weights[-1]
    rel=np.maximum(z,0)
    final_mc=rel.mean(axis=0)
    z_mu=z.mean(axis=0)
    zc=z-z_mu
    z_sigma=np.sqrt(np.maximum(np.mean(zc*zc,axis=0),1e-12))
    za=z_mu/z_sigma
    final_norm=z_mu*ndtr(za)+z_sigma*pdf(za)
    a,b,c=final
    fp=a*final_mc+b*final_norm+c*diag[-1]
    return fp.astype(np.float32), diag

def eval_set(width, depth, n_cand=4096, seeds=range(10), target_n=262144, **kw):
    ms=[]; diagms=[]
    for seed in seeds:
        weights=sample_weights(width, depth, 1000+seed)
        t=target(weights, n=target_n, seed=2000+seed)[-1]
        p,_=estimate(weights, mlp_seed=3000+seed, n_samples=n_cand, **kw)
        d,_=diag_prop(weights)
        ms.append(np.mean((p-t)**2))
        diagms.append(np.mean((d[-1]-t)**2))
    return float(np.mean(ms)), float(np.std(ms)/np.sqrt(len(ms))), float(np.mean(diagms))

for w,d,n in [(32,4,4096),(32,8,4096),(64,4,4096),(64,8,4096),(128,4,2048),(128,8,2048)]:
    m,se,dm=eval_set(w,d,n_cand=n,seeds=range(8),target_n=131072)
    print('base',w,d,n,m,se,'diag',dm)

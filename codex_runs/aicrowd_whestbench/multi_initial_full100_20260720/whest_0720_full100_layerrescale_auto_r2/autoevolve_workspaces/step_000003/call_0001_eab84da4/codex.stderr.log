import numpy as np
from scipy.special import ndtr
from math import sqrt,pi
inv=1/sqrt(2*pi)
def pdf(x): return np.exp(-0.5*x*x)*inv
def make(w,d,s):
 r=np.random.default_rng(s); sc=np.float32(np.sqrt(2/w)); return [(r.standard_normal((w,w),dtype=np.float32)*sc).astype(np.float32) for _ in range(d)]
def targ(ws,n=262144,seed=1,ch=32768):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; d=len(ws); sums=np.zeros((d,w),np.float64)
 for st in range(0,n,ch):
  m=min(ch,n-st); x=r.standard_normal((m,w),dtype=np.float32)
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0,dtype=np.float64)
 return (sums/n).astype(np.float32)
def diag(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vs=[]
 for W in ws:
  Wd=W.astype(np.float64); mup=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=ndtr(a); mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vs.append(var.copy())
 return np.stack(rows).astype(np.float32),np.stack(vs).astype(np.float32)
def feats(ws,n=8192,seed=2):
 w=ws[0].shape[0]; dr,dv=diag(ws); r=np.random.default_rng(seed); h=n//2; b=r.standard_normal((h,w),dtype=np.float32); x=np.concatenate([b,-b]); x=x-x.mean(0,keepdims=True); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); cov=(x.T@x)/n; vals,vecs=np.linalg.eigh(cov.astype(np.float64)); x=(x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))).astype(np.float32); xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); x=x*(rn/xn)
 for i,W in enumerate(ws[:-1]):
  x=np.maximum(x@W,0)
  if i<2:
   a=-.14 if i==0 else .925; xm=x.mean(0,keepdims=True); xc=x-xm; xv=np.maximum((xc*xc).mean(0,keepdims=True),1e-12); xm2=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]; x=(a*x+(1-a)*xm2).astype(np.float32)
 z=x@ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zc=z-zm; var=np.maximum((zc*zc).mean(0),1e-12); sig=np.sqrt(var); alpha=zm/sig; ph=pdf(alpha); norm=zm*ndtr(alpha)+sig*ph
 m3=(zc**3).mean(0); m4=(zc**4).mean(0); skew=m3/np.maximum(sig**3,1e-12); ex=m4/np.maximum(var*var,1e-12)-3.0
 edge=norm + sig*ph*((-alpha*skew)/6.0 + ((alpha*alpha-1.0)*ex)/24.0)
 edge_s=norm + sig*ph*((-alpha*skew)/6.0) # only skew
 return np.stack([mc,norm,dr[-1],edge,edge_s,skew,ex],1)
for dims in [[(16,4),(16,8),(32,4),(32,8),(64,4),(64,8)],[(32,4),(32,8),(64,4),(64,8),(128,4),(128,8)]]:
 Xs=[]; ys=[]
 for w,d in dims:
  for s in range(8):
   ws=make(w,d,41000+w*100+d*10+s); y=targ(ws,262144,42000+s)[-1].astype(np.float64); X=feats(ws,8192 if w<=64 else 4096,43000+s).astype(np.float64); Xs.append(X); ys.append(y)
 X=np.concatenate(Xs); y=np.concatenate(ys)
 cur=np.array([.946,.048,.006])
 print('dims',dims,'cur',np.mean((X[:,:3]@cur-y)**2))
 for cols,name in [([0,1,2],'mc norm diag'),([0,3,2],'mc edge diag'),([0,4,2],'mc edgeskew diag'),([0,1,2,3],'mc norm diag edge'),([0,1,2,4],'mc norm diag edgeskew')]:
  coef=np.linalg.lstsq(X[:,cols],y,rcond=None)[0]; print(name,coef,'mse',np.mean((X[:,cols]@coef-y)**2))

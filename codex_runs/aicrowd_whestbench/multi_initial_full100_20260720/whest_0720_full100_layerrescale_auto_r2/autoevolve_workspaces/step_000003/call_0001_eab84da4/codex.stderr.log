import numpy as np
from scipy.special import ndtr
from math import sqrt,pi
inv=1/sqrt(2*pi)
def pdf(x): return np.exp(-0.5*x*x)*inv

def make(w,d,s):
 r=np.random.default_rng(s); sc=np.float32(np.sqrt(2/w)); return [(r.standard_normal((w,w),dtype=np.float32)*sc).astype(np.float32) for _ in range(d)]
def targ(ws,n=262144,seed=1,ch=32768):
 r=np.random.default_rng(seed); w=ws[0].shape[0]; d=len(ws); sums=np.zeros((d,w),np.float64)
 for st in range(0,n,ch):
  m=min(ch,n-st); x=r.standard_normal((m,w),dtype=np.float32)
  for i,W in enumerate(ws): x=np.maximum(x@W,0); sums[i]+=x.sum(0,dtype=np.float64)
 return (sums/n).astype(np.float32)
def diag(ws):
 w=ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vs=[]
 for W in ws:
  Wd=W.astype(np.float64); mup=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12); sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=ndtr(a); mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vs.append(var.copy())
 return np.stack(rows).astype(np.float32),np.stack(vs).astype(np.float32)
def feats(ws,n=8192,seed=2,a0=-.14,a1=.925,extra=None,whiten=True,row_scale=True):
 w=ws[0].shape[0]; dr,dv=diag(ws); r=np.random.default_rng(seed); h=n//2; b=r.standard_normal((h,w),dtype=np.float32); x=np.concatenate([b,-b]).astype(np.float32); x=x-x.mean(0,keepdims=True); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
 if whiten:
  cov=(x.T@x)/n; vals,vecs=np.linalg.eigh(cov.astype(np.float64)); invs=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T); x=(x@invs).astype(np.float32)
  if row_scale:
   xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); x=x*(rn/xn)
 for i,W in enumerate(ws[:-1]):
  x=np.maximum(x@W,0)
  a=None
  if i==0: a=a0
  elif i==1: a=a1
  elif extra is not None: a=extra
  if a is not None:
   xm=x.mean(0,keepdims=True); xc=x-xm; xv=np.maximum((xc*xc).mean(0,keepdims=True),1e-12); xmatch=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]; x=(a*x+(1-a)*xmatch).astype(np.float32)
 z=x@ws[-1]
 mc=np.maximum(z,0).mean(0)
 zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)**2).mean(0),1e-12)); norm=zm*ndtr(zm/zs)+zs*pdf(zm/zs)
 return np.stack([mc,norm,dr[-1]],axis=1).astype(np.float64)

def build(dims, per=12, n=8192, tn=524288, **kw):
 Xs=[]; ys=[]
 for w,d in dims:
  for s in range(per):
   ws=make(w,d,100000+w*100+d*10+s); y=targ(ws,tn,200000+s)[-1].astype(np.float64); X=feats(ws,n,300000+s,**kw); Xs.append(X); ys.append(y)
 X=np.concatenate(Xs); y=np.concatenate(ys); return X,y
for dims in [[(32,4),(32,8),(64,4),(64,8)],[(16,4),(16,8),(32,4),(32,8)],[(64,4),(64,8),(128,4),(128,8)]]:
 print('dims',dims)
 X,y=build(dims, per=8, n=8192 if max(w for w,d in dims)<=64 else 4096, tn=262144)
 cur=np.array([.946,.048,.006]); pred=X@cur
 print('cur mse',np.mean((pred-y)**2))
 coef=np.linalg.lstsq(X,y,rcond=None)[0]; print('fit',coef,'sum',coef.sum(),'mse',np.mean((X@coef-y)**2))
 # constrained sum 1 via fit on differences + diag base
 A=np.stack([X[:,0]-X[:,2], X[:,1]-X[:,2]],axis=1); b=y-X[:,2]
 c2=np.linalg.lstsq(A,b,rcond=None)[0]; co=np.array([c2[0],c2[1],1-c2.sum()]); print('sum1',co,'mse',np.mean((X@co-y)**2))

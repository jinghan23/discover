# Reuse a compact synthetic test for final Gaussian extrapolation.
import numpy as np, math
from scipy.special import ndtr

def pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def probe(w,n,rng):
 h=n//2; b=rng.standard_normal((h,w)).astype(np.float32); x=np.concatenate([b,-b]); x-=x.mean(0); vals,vecs=np.linalg.eigh(x.T@x/n); return x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(float); mp=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12); s=np.sqrt(vp); a=mp/s; c=ndtr(a); p=pdf(a); mu=mp*c+s*p; e=(mp*mp+vp)*c+mp*s*p; var=np.maximum(e-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def true(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(10000,n-done); done+=m; x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
def est(weights,n,seed,k):
 rows,vars=diag(weights); x=probe(weights[0].shape[0],n,np.random.default_rng(seed))
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if i==0:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=-0.14*x+1.14*xm
  elif i==1:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=0.95*x+0.05*xm
 z=x@weights[-1]; act=np.maximum(z,0); direct=act.mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); a=zm/zs; gauss=zm*ndtr(a)+zs*pdf(a); return (0.998+k)*direct - k*gauss + 0.002*rows[-1]
ks=[-0.1,-0.05,0,0.05,0.1,0.2]
ms={k:[] for k in ks}
for r in range(10):
 rng=np.random.default_rng(700+r); w=64; d=16; scale=math.sqrt(2/w); weights=[(rng.standard_normal((w,w))*scale).astype(np.float32) for _ in range(d)]; tgt=true(weights,200000,900+r)
 for k in ks: ms[k].append(((est(weights,2048,1000+r,k)-tgt)**2).mean())
for k,v in sorted(ms.items(), key=lambda kv:np.mean(kv[1])): print(k,np.mean(v))

        #   s_m = final_layer_mse * max(0.1, C_m / B_m)  for valid runs
        #   s_m = final_layer_mse * 1.0                  for failures (Task 5 wires this for exceptions)
        failure_flag = (
            budget_exhausted
            or time_exhausted
            or residual_wall_time_exhausted
            or combined_budget_exhausted

/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
try:
 from scipy.special import ndtr
except Exception:
 ndtr=None

def norm_pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def norm_cdf(a):
    if ndtr is not None: return ndtr(a)
    return 0.5*(1+np.vectorize(math.erf)(a/math.sqrt(2)))

def make_probe(width,n,rng):
    half=n//2
    base=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([base,-base],0)
    x=x-x.mean(0)
    cov=x.T@x/float(n)
    vals,vecs=np.linalg.eigh(cov)
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    return (x@inv).astype(np.float32)

def diag_rows(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w,dtype=np.float64); var=np.ones(w,dtype=np.float64)
    rows=[]; vars=[]; pre=[]
    for W in weights:
        Wd=W.astype(np.float64)
        mp=Wd.T@mu
        vp=np.maximum((Wd*Wd).T@var,1e-12)
        s=np.sqrt(vp); a=mp/s; phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=mp*cdf+s*phi
        ez2=(mp*mp+vp)*cdf+mp*s*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pre.append((mp.copy(),vp.copy()))
    return rows,vars,pre

def estimate(weights,n,seed,params):
    rows,vars,pre=diag_rows(weights)
    rng=np.random.default_rng(seed)
    x=make_probe(weights[0].shape[0],n,rng).astype(np.float64)
    coeffs=params.get('coeffs',[(-0.14,1.14),(0.925,0.075)])
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i < len(coeffs) and coeffs[i] is not None:
            a,b=coeffs[i]
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=a*x+b*xm
    z=x@weights[-1]
    fm=np.maximum(z,0).mean(0)
    zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs
    fg=zm*norm_cdf(za)+zs*norm_pdf(za)
    mp,vp=pre[-1]; zmatch=(z-zm)*np.sqrt(np.maximum(vp,1e-12)/zv)+mp
    fz=np.maximum(zmatch,0).mean(0)
    d=np.array(rows[-1])
    alpha=params.get('gauss',0.0); beta=params.get('zmatch',0.0); dd=params.get('diag',0.002)
    # direct remaining
    return (1-alpha-beta-dd)*fm + alpha*fg + beta*fz + dd*d

def true_mean(weights,n,seed,chunk=10000):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64); count=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-count); count+=m
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0)
    return s/count

width=64; depth=16; n_est=2048; n_true=200000; reps=8
variants={
 'base':{},
 'gauss05':{'gauss':0.05},
 'gauss10':{'gauss':0.10},
 'gauss20':{'gauss':0.20},
 'zmatch01':{'zmatch':0.01},
 'zmatch02':{'zmatch':0.02},
 'zmatch05':{'zmatch':0.05},
 'l2_01':{'coeffs':[(-0.14,1.14),(0.925,0.075),(0.99,0.01)]},
 'l2_02':{'coeffs':[(-0.14,1.14),(0.925,0.075),(0.98,0.02)]},
 'l1_05':{'coeffs':[(-0.14,1.14),(0.95,0.05)]},
 'l1_10':{'coeffs':[(-0.14,1.14),(0.90,0.10)]},
 'l0_10':{'coeffs':[(-0.10,1.10),(0.925,0.075)]},
 'l0_18':{'coeffs':[(-0.18,1.18),(0.925,0.075)]},
}
mses={k:[] for k in variants}
t0=time.time()
for r in range(reps):
    rng=np.random.default_rng(1000+r)
    scale=math.sqrt(2/width)
    weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    target=true_mean(weights,n_true,200000+r)
    for k,p in variants.items():
        pred=estimate(weights,n_est,300000+r,p)
        mses[k].append(((pred-target)**2).mean())
    print('rep',r,'elapsed',time.time()-t0)
for k,v in sorted(mses.items(), key=lambda kv: np.mean(kv[1])):
    print(k, np.mean(v), np.std(v)/math.sqrt(len(v)))

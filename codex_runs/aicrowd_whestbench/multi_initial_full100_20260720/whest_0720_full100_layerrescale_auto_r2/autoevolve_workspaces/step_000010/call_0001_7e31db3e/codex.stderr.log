codex
A variance-reduction idea that does not change probes is radial control: keep the whitened directions, but analytically integrate the Gaussian input radius using network homogeneity. I’ll test it locally on synthetic MLPs first.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr

def pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def make_probe(w,n,rng):
 half=n//2; base=rng.standard_normal((half,w)).astype(np.float32); x=np.concatenate([base,-base]); x-=x.mean(0); cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); return (x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))).astype(np.float32)
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in weights:
  Wd=W.astype(float); mp=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12); s=np.sqrt(vp); a=mp/s; ph=pdf(a); c=ndtr(a); mu=mp*c+s*ph; ez2=(mp*mp+vp)*c+mp*s*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
 return rows,vars
def est(weights,n,seed,rad):
 rows,vars=diag(weights); rng=np.random.default_rng(seed); x0=make_probe(weights[0].shape[0],n,rng).astype(float); rn=np.sqrt(np.maximum((x0*x0).sum(1),1e-12)); er=math.sqrt(2)*math.exp(math.lgamma((weights[0].shape[0]+1)/2)-math.lgamma(weights[0].shape[0]/2)); rw=er/rn; x=x0
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if i==0:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=-0.14*x+1.14*xm
  elif i==1:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=0.945*x+0.055*xm
 y=np.maximum(x@weights[-1],0)
 fm=y.mean(0); fr=(y*rw[:,None]).mean(0); d=rows[-1]
 return (1-rad-0.002)*fm + rad*fr + 0.002*d
def true(weights,n,seed):
 rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); done=0; chunk=10000
 while done<n:
  m=min(chunk,n-done); done+=m; x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
width=64; depth=16; n_est=2048; n_true=200000; reps=8
rads=[-0.2,-0.1,0,0.1,0.25,0.5,1.0]
ms={r:[] for r in rads}
t=time.time()
for k in range(reps):
 rng=np.random.default_rng(500+k); scale=math.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]; target=true(weights,n_true,800+k)
 for r in rads: ms[r].append(((est(weights,n_est,900+k,r)-target)**2).mean())
print('elapsed',time.time()-t)
for r,v in sorted(ms.items(), key=lambda kv:np.mean(kv[1])): print(r,np.mean(v))

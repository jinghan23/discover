import numpy as np, scipy.special as sp

def moments(mu,var):
 s=np.sqrt(np.maximum(var,1e-12)); a=mu/s; c=.5*(1+sp.erf(a/np.sqrt(2))); p=np.exp(-.5*a*a)/np.sqrt(2*np.pi); m=mu*c+s*p; ez=(mu*mu+var)*c+mu*s*p; return m,np.maximum(ez-m*m,0)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vs=[]
 for W in Ws:
  mu,var=moments(W.T@mu,(W*W).T@var); rows.append(mu); vs.append(var)
 return np.stack(rows),vs
def pred(Ws, seed, c0=1.14,c1=.075, blend=(.955,.04,.005), budget=1e10):
 w=Ws[0].shape[0]; d=len(Ws); rng=np.random.default_rng(seed); n=max(1024,int(.0909908329*budget/(d*(2*w*w+4*w)))); n=min(n,8192); n=max(2,2*(n//2)); D,Dv=diag(Ws); h=n//2; base=rng.standard_normal((h,w),dtype=np.float32).astype(float); x=np.r_[base,-base]; x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); x*=rn/xn
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0)
  if i in (0,1):
   c = c0 if i==0 else c1
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(Dv[i],1e-12)/xv)+D[i]
   x=(1-c)*x+c*xm
 z=x@Ws[-1]; fmc=np.maximum(z,0).mean(0); zmu=z.mean(0); zs=np.sqrt(np.maximum(((z-zmu)**2).mean(0),1e-12)); a=zmu/zs; c=.5*(1+sp.erf(a/np.sqrt(2))); p=np.exp(-.5*a*a)/np.sqrt(2*np.pi); fn=zmu*c+zs*p; return blend[0]*fmc+blend[1]*fn+blend[2]*D[-1]
def targ(Ws, seed, n=120000):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; s=np.zeros(w); done=0
 while done<n:
  m=min(20000,n-done); done+=m; x=rng.standard_normal((m,w),dtype=np.float32).astype(float)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0)
 return s/n
def Ws(w,d,seed):
 rng=np.random.default_rng(seed); return [(rng.standard_normal((w,w),dtype=np.float32)*np.sqrt(2/w)).astype(float) for _ in range(d)]
configs=[(64,4),(96,4),(128,4),(128,5)]
seeds=list(range(6))
targets=[]
for w,d in configs:
 for k in seeds:
  W=Ws(w,d,100+k*13+w); t=targ(W,200+k*13+w,n=130000 if w<=96 else 80000); targets.append((W,t))
variants=[]
for c0 in [1.08,1.10,1.12,1.14,1.16,1.18,1.20]:
 for c1 in [0.0,0.04,0.06,0.075,0.09,0.11,0.14]:
  variants.append((c0,c1))
best=[]
for c0,c1 in variants:
 errs=[]
 for idx,(W,t) in enumerate(targets):
  errs.append(np.mean((pred(W,900+idx,c0,c1)-t)**2))
 best.append((np.mean(errs),c0,c1))
best=sorted(best)[:15]
for row in best: print(row)
print('baseline', [r for r in best if abs(r[1]-1.14)<1e-9 and abs(r[2]-.075)<1e-9])
# compute exact baseline rank
allrows=[]
for c0,c1 in variants:
 errs=[np.mean((pred(W,900+idx,c0,c1)-t)**2) for idx,(W,t) in enumerate(targets)]
 allrows.append((np.mean(errs),c0,c1))
for rank,r in enumerate(sorted(allrows),1):
 if r[1]==1.14 and r[2]==.075: print('baseline rank',rank,r)

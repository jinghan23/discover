for cfgs_name,cfgs in [('mix',[(64,4),(64,5),(96,4),(96,5),(128,4),(128,5)]),('small',[(32,4),(48,4),(64,4)]),('wide',[(128,4),(128,5),(256,4)])]:
 X=[]; y=[]; baseerrs=[]; mconly=[]; normonly=[]; diagonly=[]; ns=[]

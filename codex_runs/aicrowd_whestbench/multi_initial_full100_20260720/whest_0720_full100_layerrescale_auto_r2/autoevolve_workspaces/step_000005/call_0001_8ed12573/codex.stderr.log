import numpy as np

def relu_moments(mu, var):
    # vector norm pdf/cdf via scipy? use math erf vectorized? np has erf? no. import scipy if available
    import scipy.special as sp
    sigma=np.sqrt(np.maximum(var,1e-12)); a=mu/sigma
    cdf=0.5*(1+sp.erf(a/np.sqrt(2))); phi=np.exp(-0.5*a*a)/np.sqrt(2*np.pi)
    m=mu*cdf+sigma*phi
    ez2=(mu*mu+var)*cdf+mu*sigma*phi
    v=np.maximum(ez2-m*m,0)
    return m,v

def diag_predict(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        mu_pre=W.T@mu
        var_pre=(W*W).T@var
        mu,var=relu_moments(mu_pre,var_pre)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars

def current_predict(weights, seed, budget=1e10, coef=0.0909908329, cap=8192, blend=(0.946,0.048,0.006), corr0=(-0.14,1.14), corr1=(0.925,0.075)):
    width=weights[0].shape[0]; depth=len(weights)
    rng=np.random.default_rng(seed)
    per_sample=max(1, depth*(2*width*width+4*width))
    n=max(1024, int((coef*float(budget))/float(per_sample)))
    n=min(n,cap); n=max(2,2*(n//2))
    diag, diag_vars=diag_predict(weights)
    half=n//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate([base,-base],0).astype(np.float64)
    x=x-x.mean(0)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/n
    vals,vecs=np.linalg.eigh(cov)
    inv_sqrt=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=x@inv_sqrt
    x_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    x=x*(row_norm/x_norm)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0:
            c0,c1=corr0
            xc=x-x.mean(0); xv=np.maximum(np.mean(xc*xc,axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(diag_vars[i],1e-12)/xv)+diag[i]
            x=c0*x+c1*xm
        elif i==1:
            c0,c1=corr1
            xc=x-x.mean(0); xv=np.maximum(np.mean(xc*xc,axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(diag_vars[i],1e-12)/xv)+diag[i]
            x=c0*x+c1*xm
    z=x@weights[-1]
    final_mc=np.mean(np.maximum(z,0),0)
    z_mu=z.mean(0); zc=z-z_mu; z_sigma=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12));
    import scipy.special as sp
    a=z_mu/z_sigma; cdf=0.5*(1+sp.erf(a/np.sqrt(2))); phi=np.exp(-0.5*a*a)/np.sqrt(2*np.pi)
    final_norm=z_mu*cdf+z_sigma*phi
    final=blend[0]*final_mc+blend[1]*final_norm+blend[2]*diag[-1]
    return final.astype(np.float32), diag[-1], n

def target_mc(weights, seed, n=200000, chunk=20000):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]; s=np.zeros(w); count=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-count); count+=m
        x=rng.standard_normal((m,w), dtype=np.float32).astype(np.float64)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0)
    return (s/n).astype(np.float32)

def sample_weights(width,depth,seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2/width)
    return [(rng.standard_normal((width,width), dtype=np.float32)*scale).astype(np.float64) for _ in range(depth)]

for width,depth,budget in [(64,4,1e9),(128,4,1e10),(128,5,1e10),(256,4,1e10),(128,3,1e10)]:
    ms=[]; ds=[]; ns=[]
    for k in range(5):
        weights=sample_weights(width,depth,1234+k)
        targ=target_mc(weights,4321+k,n=100000 if width<=128 else 50000)
        pred,diag,n=current_predict(weights,9876+k,budget=budget)
        ms.append(np.mean((pred-targ)**2)); ds.append(np.mean((diag-targ)**2)); ns.append(n)
    print('cfg',width,depth,budget,'n',ns[0],'cur',np.mean(ms), 'diag',np.mean(ds))

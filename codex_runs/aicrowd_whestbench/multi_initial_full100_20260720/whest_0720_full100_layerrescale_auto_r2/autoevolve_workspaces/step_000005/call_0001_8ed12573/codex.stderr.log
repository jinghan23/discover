def moments(mu,var):
 s=np.sqrt(np.maximum(var,1e-12)); a=mu/s; c=.5*(1+sp.erf(a/np.sqrt(2))); p=np.exp(-.5*a*a)/np.sqrt(2*np.pi); m=mu*c+s*p; ez=(mu*mu+var)*c+mu*s*p; return m,np.maximum(ez-m*m,0)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vs=[]
 for W in Ws:
  mu,var=moments(W.T@mu,(W*W).T@var); rows.append(mu); vs.append(var)
 return np.stack(rows),vs
def comps(Ws, seed, budget=1e10):

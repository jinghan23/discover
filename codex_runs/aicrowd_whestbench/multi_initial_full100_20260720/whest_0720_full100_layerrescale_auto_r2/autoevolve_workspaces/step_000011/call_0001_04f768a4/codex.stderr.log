codex
I’m also evaluating a full-covariance moment-closure idea locally. It propagates a dense covariance matrix and uses the exact zero-mean ReLU correlation map as an approximation for nonzero preactivation means. If it looks promising synthetically, I’ll test a hybrid with the blackbox.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi); Q=1/(2*math.pi); VAR0=0.5-Q
def pdf(x): return np.exp(-0.5*x*x)*INV
def relu_mom(mu,var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; ph=pdf(a); cd=ndtr(a)
    m=mu*cd+sig*ph
    ez2=(mu*mu+var)*cd+mu*sig*ph
    v=np.maximum(ez2-m*m,0)
    return m,v

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]
    for W in weights:
        pm=W.T@mu; pv=np.maximum((W*W).T@var,1e-12)
        mu,var=relu_mom(pm,pv); rows.append(mu)
    return np.array(rows)

def full_cov(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width); cov=np.eye(width); rows=[]
    for li,W in enumerate(weights):
        pm=W.T@mu
        pc=W.T@cov@W
        pv=np.maximum(np.diag(pc),1e-12)
        m,v=relu_mom(pm,pv); rows.append(m)
        if li < len(weights)-1:
            sig=np.sqrt(pv); denom=np.outer(sig,sig)
            rho=np.clip(pc/np.maximum(denom,1e-30),-0.999999,0.999999)
            K=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
            corr=(K-Q)/VAR0
            sv=np.sqrt(np.maximum(v,0))
            cov=corr*np.outer(sv,sv)
            np.fill_diagonal(cov,v)
            mu=m
    return np.array(rows)

def target(weights,nt,rng,chunk=20000):
    width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<nt:
        n=min(chunk,nt-done); x=rng.standard_normal((n,width)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0.0)
        s+=x.sum(0); done+=n
    return s/nt
for width,depth,nmlp,nt in [(32,8,20,100000),(64,8,12,80000),(64,16,8,60000),(128,8,6,50000)]:
    rng=np.random.default_rng(321); sd=sf=0
    t=time.time()
    for j in range(nmlp):
        scale=math.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float64) for _ in range(depth)]
        tar=target(weights,nt,np.random.default_rng(9000+j))
        d=diag_prop(weights)[-1]
        f=full_cov(weights)[-1]
        sd+=((d-tar)**2).mean(); sf+=((f-tar)**2).mean()
    print('spec',width,depth,'diag',sd/nmlp,'fullcov',sf/nmlp,'ratio',sf/sd,'elapsed',time.time()-t)

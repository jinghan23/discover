exec
/bin/bash -lc "python - <<'PY'
# Synthetic test final preactivation moment matching component.
import numpy as np, math
from scipy.special import ndtr, ndtri
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV
def mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; ph=pdf(a); cd=ndtr(a); m=mu*cd+sig*ph; ez2=(mu*mu+var)*cd+mu*sig*ph; return m,np.maximum(ez2-m*m,0)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pres=[]
 for W in Ws:
  pm=W.T@mu; pv=np.maximum((W*W).T@var,1e-12); mu,var=mom(pm,pv); rows.append(mu); vars.append(var); pres.append((pm,pv))
 return rows,vars,pres
def probe(width,n,rng):
 h=n//2; vals=ndtri((np.arange(h)+0.5)/(2*h)).astype(np.float32); base=np.stack([vals[rng.permutation(h)] for _ in range(width)],1); x=np.concatenate([base,-base]).astype(float); x-=x.mean(0); e,v=np.linalg.eigh(x.T@x/n); return (x@(v@(np.diag(1/np.sqrt(np.maximum(e,1e-12)))@v.T))).astype(np.float32)
def comps(Ws,x0):
 rows,vars,pres=diag(Ws); x=x0.astype(float)
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0); k=1.45 if i==0 else (0.05 if i==1 else 0)
  if k:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
 z=x@Ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za)
 pm,pv=pres[-1]; zmatch=(z-zm)*np.sqrt(np.maximum(pv,1e-12)/zv)+pm; mcm=np.maximum(zmatch,0).mean(0)
 return mc,ga,rows[-1],mcm
def target(Ws,nt,rng):
 w=Ws[0].shape[0]; s=np.zeros(w); done=0
 while done<nt:
  n=min(20000,nt-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/nt
for spec in [(32,8,4096,20,60000),(64,8,2048,12,50000),(64,16,2048,8,40000),(128,8,1024,6,30000)]:
 width,depth,npb,nmlp,nt=spec; x0=probe(width,npb,np.random.default_rng(21)); rng=np.random.default_rng(22); C=[]; T=[]
 for j in range(nmlp):
  sc=math.sqrt(2/width); Ws=[(rng.standard_normal((width,width))*sc).astype(np.float32) for _ in range(depth)]; T.append(target(Ws,nt,np.random.default_rng(8000+j))); C.append(comps(Ws,x0))
 configs=[]
 # pred = old + d*(mcm-old) or linear grids
 for d in [-0.5,-0.2,-0.1,0,0.1,0.2,0.5,1.0]:
  mse=0
  for (mc,ga,di,mcm),tar in zip(C,T):
   old=1.063*mc-0.065*ga+0.002*di; p=old+d*(mcm-old); mse+=((p-tar)**2).mean()
  configs.append((mse/nmlp,d))
 print('\\nspec',spec)
 for r in sorted(configs): print(r)

/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
SQRT2=math.sqrt(2.0); INV_SQRT2PI=1.0/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV_SQRT2PI
def cdf(x): return 0.5*(1.0+np.vectorize(math.erf)(x/math.sqrt(2.0)))
# vectorize erf is slow; use scipy if present
try:
    from scipy.special import ndtr
    cdf=ndtr
except Exception:
    pass

def diag_prop(weights,width):
    mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; ph=pdf(a); cd=cdf(a)
        mu=mu_pre*cd+sig*ph
        ez2=(mu_pre*mu_pre+var_pre)*cd+mu_pre*sig*ph
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu); vars.append(var)
    return rows, vars

def make_probe(width,n,rng):
    half=n//2
    base=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([base,-base],0).astype(np.float64)
    x=x-x.mean(0)
    cov=x.T@x/float(n)
    vals,vecs=np.linalg.eigh(cov)
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    return (x@inv).astype(np.float32)

def estimate(weights,probe,k0=1.14,k1=0.05,k2=0.0,final=(1.063,-0.065,0.002)):
    width=weights[0].shape[0]
    rows,vars=diag_prop(weights,width)
    x=probe.astype(np.float64)
    ks=[k0,k1,k2]
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        k=ks[i] if i<len(ks) else 0.0
        if k"'!=0.0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-k)*x+k*xm
    z=x@weights[-1]
    mc=np.maximum(z,0.0).mean(0)
    zm=z.mean(0); zc=z-zm; zv=np.maximum((zc*zc).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs
    ga=zm*cdf(za)+zs*pdf(za)
    a,b,c=final
    return a*mc+b*ga+c*rows[-1]

def target(weights,nt,rng,chunk=20000):
    width=weights[0].shape[0]
    s=np.zeros(width); done=0
    while done<nt:
        n=min(chunk,nt-done)
        x=rng.standard_normal((n,width)).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0.0)
        s+=x.sum(0); done+=n
    return s/nt

def run(width=64,depth=8,nprobe=4096,nmlp=12,nt=80000):
    rng=np.random.default_rng(123)
    probe=make_probe(width,nprobe,np.random.default_rng(999))
    Ws=[]; Ts=[]
    for j in range(nmlp):
        scale=math.sqrt(2/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        Ws.append(weights)
        Ts.append(target(weights,nt,np.random.default_rng(10000+j)))
    configs=[]
    for k0 in [0.9,1.0,1.1,1.14,1.2,1.3]:
      for k1 in [-0.1,0.0,0.05,0.1,0.2]:
       pred=[]; mse=0

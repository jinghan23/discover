/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV
def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; ph=pdf(a); cd=ndtr(a); m=mu*cd+sig*ph; ez2=(mu*mu+var)*cd+mu*sig*ph; return m,np.maximum(ez2-m*m,0)
def diag(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for W in weights:
        mu_pre=W.T@mu; var_pre=np.maximum((W*W).T@var,1e-12); mu,var=relu_mom(mu_pre,var_pre); rows.append(mu); vars.append(var)
    return rows,vars
def probe(width,n,rng):
    x=np.r_[rng.standard_normal((n//2,width)), -rng.standard_normal((0,width))]
    base=rng.standard_normal((n//2,width)).astype(np.float32); x=np.concatenate([base,-base]).astype(float); x-=x.mean(0); vals,vecs=np.linalg.eigh(x.T@x/n); return (x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))).astype(np.float32)
def est(weights,x0,k0=1.14,k1=0.05,k_late=0.0,late_start=2):
    rows,vars=diag(weights); x=x0.astype(float)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        k=0
        if i==0: k=k0
        elif i==1: k=k1
        elif i>=late_start: k=k_late
        if k:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za); return 1.063*mc-0.065*ga+0.002*rows[-1]
def target(weights,nt,rng):
    width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<nt:
        n=min(20000,nt-done); x=rng.standard_normal((n,width)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=n
    return s/nt
for spec in [(32,8,4096,20,80000),(64,8,2048,12,60000),(64,16,2048,8,50000),(128,8,1024,6,40000)]:
    width,depth,nprobe,nmlp,nt=spec; rng=np.random.default_rng(77); x0=probe(width,nprobe,np.random.default_rng(88)); Ws=[]; Ts=[]
    for j in range(nmlp):
        sc=math.sqrt(2/width); weights=[(rng.standard_normal((width,width))*sc).astype(np.float32) for _ in range(depth)]; Ws.append(weights); Ts.append(target(weights,nt,np.random.default_rng(1000+j)))
    res=[]
    for kl in [-0.10,-0.05,0,0.025,0.05,0.10,0.20]:
        mse=0
        for W,T in zip(Ws,Ts): mse+=((est(W,x0,k_late=kl)-T)**2).mean()
        res.append((mse/nmlp,kl))

/bin/bash -lc "python - <<'PY'
import numpy as np, math
from scipy.special import ndtr, ndtri
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV
def mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; ph=pdf(a); cd=ndtr(a); m=mu*cd+sig*ph; ez2=(mu*mu+var)*cd+mu*sig*ph; return m,np.maximum(ez2-m*m,0)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in Ws:
  pm=W.T@mu; pv=np.maximum((W*W).T@var,1e-12); mu,var=mom(pm,pv); rows.append(mu); vars.append(var)
 return rows,vars
def probe(width,n,rng):
 h=n//2; vals=ndtri((np.arange(h)+0.5)/(2*h)).astype(np.float32); base=np.stack([vals[rng.permutation(h)] for _ in range(width)],1); x=np.concatenate([base,-base]).astype(float); x-=x.mean(0); vals2,vecs=np.linalg.eigh(x.T@x/n); return (x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals2,1e-12)))@vecs.T))).astype(np.float32)
def rescale(x,row,var,km,kv):
 ms=x.mean(0); xc=x-ms; vs=np.maximum((xc*xc).mean(0),1e-12); s=np.sqrt(np.maximum(var,1e-12)/vs); scale=(1-kv)+kv*s; mean=(1-km)*ms+km*row; return xc*scale+mean
def est(Ws,x0,km0,kv0,km1=0.05,kv1=0.05):
 rows,vars=diag(Ws); x=x0.astype(float)
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0)
  if i==0: x=rescale(x,rows[i],vars[i],km0,kv0)
  elif i==1: x=rescale(x,rows[i],vars[i],km1,kv1)
 z=x@Ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za); return 1.063*mc-0.065*ga+0.002*rows[-1]
def target(Ws,nt,rng):
 w=Ws[0].shape[0]; s=np.zeros(w); done=0
 while done<nt:
  n=min(20000,nt-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/nt
for spec in [(32,8,4096,20,60000),(64,8,2048,12,50000),(64,16,2048,8,40000),(128,8,1024,6,30000)]:
 width,depth,npb,nmlp,nt=spec; x0=probe(width,npb,np.random.default_rng(9)); rng=np.random.default_rng(10); Ws=[]; Ts=[]
 for j in range(nmlp):
  sc=math.sqrt(2/width); W=[(rng.standard_normal((width,width))*sc).astype(np.float32) for _ in range(depth)]; Ws.append(W); Ts.append(target(W,nt,np.random.default_rng(5000+j)))
 res=[]
 for km in [1.0,1.2,1.45,1.7,2.0]:
  for kv in [0.8,1.0,1.2,1.45,1.7,2.0]:
   mse=sum(((est(W,x0,km,kv)-T)**2).mean() for W,T in zip(Ws,Ts))/nmlp; res.append((mse,km,kv))
 res.sort(); print('\\nspec',spec)
 for r in res[:10]: print(r)

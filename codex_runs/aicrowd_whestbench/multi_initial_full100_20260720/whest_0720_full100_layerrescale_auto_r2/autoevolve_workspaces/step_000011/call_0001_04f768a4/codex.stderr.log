The dense moment closure is not accurate enough by itself, but it may provide better marginal means/variances for the existing probe rescaling. I’m testing that hybrid synthetically now.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
from scipy.special import ndtr
INV=1/math.sqrt(2*math.pi); Q=1/(2*math.pi); VAR0=0.5-Q
def pdf(x): return np.exp(-0.5*x*x)*INV
def relu_mom(mu,var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; ph=pdf(a); cd=ndtr(a)
    m=mu*cd+sig*ph
    ez2=(mu*mu+var)*cd+mu*sig*ph
    v=np.maximum(ez2-m*m,0)
    return m,v

def diag_marg(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for W in weights:
        pm=W.T@mu; pv=np.maximum((W*W).T@var,1e-12)
        mu,var=relu_mom(pm,pv); rows.append(mu); vars.append(var)
    return rows,vars

def full_marg(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); cov=np.eye(width); rows=[]; vars=[]
    for li,W in enumerate(weights):
        pm=W.T@mu; pc=W.T@cov@W; pv=np.maximum(np.diag(pc),1e-12)
        mu,var=relu_mom(pm,pv); rows.append(mu); vars.append(var)
        if li < len(weights)-1:
            sig=np.sqrt(pv); rho=np.clip(pc/np.maximum(np.outer(sig,sig),1e-30),-0.999999,0.999999)
            K=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
            corr=(K-Q)/VAR0
            sv=np.sqrt(np.maximum(var,0)); cov=corr*np.outer(sv,sv); np.fill_diagonal(cov,var)
    return rows,vars

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); x=np.concatenate([base,-base],0).astype(np.float64); x-=x.mean(0); cov=x.T@x/float(n); vals,vecs=np.linalg.eigh(cov); return (x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))).astype(np.float32)

def estimate(weights,probe,full=False,k0=1.14,k1=0.05,final=(1.063,-0.065,0.002)):
    rows,vars=(full_marg(weights) if full else diag_marg(weights))
    x=probe.astype(np.float64)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0.0)
        if i==0:
            k=k0
        elif i==1:
            k=k1
        else:
            k=0.0
        if k:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm

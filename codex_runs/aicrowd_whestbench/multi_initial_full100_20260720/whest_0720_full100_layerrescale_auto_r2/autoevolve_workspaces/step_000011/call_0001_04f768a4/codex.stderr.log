            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za); a,b,c=final; return a*mc+b*ga+c*rows[-1]
def components(weights,x0,k0=1.14,k1=0.05):
    rows,vars=diag(weights); x=x0.astype(float)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0); k=1.14 if i==0 else (0.05 if i==1 else 0)
        if k:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za); return mc,ga,rows[-1]
def target(weights,nt,rng):
    width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<nt:
        n=min(20000,nt-done); x=rng.standard_normal((n,width)).astype(np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=n
    return s/nt
for spec in [(32,8,4096,30,80000),(64,8,2048,18,70000),(64,16,2048,12,50000),(128,8,1024,8,50000)]:
    width,depth,nprobe,nmlp,nt=spec; rng=np.random.default_rng(55); x0=probe_lhs(width,nprobe,np.random.default_rng(66)); Ws=[]; Ts=[]
    for j in range(nmlp):

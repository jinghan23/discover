        tar=target(weights,nt,np.random.default_rng(20000+j))
        sd+=((estimate(weights,probe,False)-tar)**2).mean()
        sf+=((estimate(weights,probe,True)-tar)**2).mean()
    print('spec',width,depth,nprobe,'diagmatch',sd/nmlp,'fullmatch',sf/nmlp,'ratio',sf/sd,'elapsed',time.time()-t)

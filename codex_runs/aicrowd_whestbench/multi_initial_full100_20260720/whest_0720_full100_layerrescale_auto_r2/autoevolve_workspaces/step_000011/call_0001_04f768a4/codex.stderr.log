    for W in weights:
        mu_pre=W.T@mu; var_pre=np.maximum((W*W).T@var,1e-12); mu,var=relu_mom(mu_pre,var_pre); rows.append(mu); vars.append(var)
    return rows,vars
def whiten(x):
    n=len(x); x=x-x.mean(0); vals,vecs=np.linalg.eigh(x.T@x/n); return (x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))).astype(np.float32)
def probe_lhs(width,n,rng):
    half=n//2; vals=ndtri((np.arange(half)+0.5)/(2*half)).astype(np.float32); cols=[vals[rng.permutation(half)] for _ in range(width)]; return whiten(np.concatenate([np.stack(cols,1),-np.stack(cols,1)]).astype(float))
def est(weights,x0,k0=1.14,k1=0.05,final=(1.063,-0.065,0.002)):
    rows,vars=diag(weights); x=x0.astype(float)
    for i,W in enumerate(weights[:-1]):

/bin/bash -lc "python - <<'PY'
# Compare quantile offsets synthetically under current best estimator.
import numpy as np, math
from scipy.special import ndtr, ndtri
INV=1/math.sqrt(2*math.pi)
def pdf(x): return np.exp(-0.5*x*x)*INV
def mom(mu,var):
 sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; ph=pdf(a); cd=ndtr(a); m=mu*cd+sig*ph; ez2=(mu*mu+var)*cd+mu*sig*ph; return m,np.maximum(ez2-m*m,0)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in Ws:
  pm=W.T@mu; pv=np.maximum((W*W).T@var,1e-12); mu,var=mom(pm,pv); rows.append(mu); vars.append(var)
 return rows,vars
def probe(width,n,rng,mode):
 h=n//2; i=np.arange(h)
 if mode=='mid': u=(i+0.5)/(2*h)
 elif mode=='blom': u=(i+0.375)/(2*h+0.25)
 elif mode=='weibull': u=(i+1.0)/(2*h+1.0)
 elif mode=='tukey': u=(i+1/3)/(2*h+1/3)
 vals=ndtri(u).astype(np.float32); base=np.stack([vals[rng.permutation(h)] for _ in range(width)],1); x=np.concatenate([base,-base]).astype(float); x-=x.mean(0); e,v=np.linalg.eigh(x.T@x/n); return (x@(v@(np.diag(1/np.sqrt(np.maximum(e,1e-12)))@v.T))).astype(np.float32)
def est(Ws,x0):
 rows,vars=diag(Ws); x=x0.astype(float)
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0)
  if i==0 or i==1:
   k=1.45 if i==0 else 0.05; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-k)*x+k*xm
 z=x@Ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum(((z-zm)**2).mean(0),1e-12); zs=np.sqrt(zv); za=zm/zs; ga=zm*ndtr(za)+zs*pdf(za); return 1.063*mc-0.065*ga+0.002*rows[-1]
def target(Ws,nt,rng):
 w=Ws[0].shape[0]; s=np.zeros(w); done=0
 while done<nt:
  n=min(20000,nt-done); x=rng.standard_normal((n,w)).astype(np.float32)
  for W in Ws: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=n
 return s/nt
for spec in [(32,8,4096,20,60000),(64,8,2048,12,50000),(64,16,2048,8,40000),(128,8,1024,6,30000)]:
 width,depth,npb,nmlp,nt=spec; probes={m:probe(width,npb,np.random.default_rng(11),m) for m in ['mid','blom','weibull','tukey']}; sums={m:0 for m in probes}; rng=np.random.default_rng(12)
 for j in range(nmlp):
  sc=math.sqrt(2/width); Ws=[(rng.standard_normal((width,width))*sc).astype(np.float32) for _ in range(depth)]; T=target(Ws,nt,np.random.default_rng(7000+j))
  for m,p in probes.items(): sums[m]+=((est(Ws,p)-T)**2).mean()
 print('\\nspec',spec)
 for m,v in sorted((v/nmlp,m) for m,v in sums.items()): print(m,v)

/bin/bash -lc "python - <<'PY'
import time
import numpy as np
from scipy.special import ndtr

WIDTH=256
DEPTH=32
BUDGET=272_000_000_000
per_sample=max(1, DEPTH*(2*WIDTH*WIDTH+4*WIDTH))
N=max(1024, int((0.0909908329*BUDGET)/per_sample))
N=min(N,8192)
N=max(2,2*(N//2))
print('N',N)
SQRT2PI=np.sqrt(2*np.pi)

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def components(weights, seed, a0=-0.5, a1=0.83, a3=1.035):
    rng=np.random.default_rng(seed)
    mu=np.zeros(WIDTH,dtype=np.float64)
    var=np.ones(WIDTH,dtype=np.float64)
    diag_rows=[]; diag_vars=[]
    for w in weights:
        wd=w.astype(np.float64, copy=False)
        mu_pre=wd.T @ mu
        var_pre=np.maximum((wd*wd).T @ var,1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        c=ndtr(alpha); p=pdf(alpha)
        mu=mu_pre*c+sigma*p
        ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sigma*p
        var=np.maximum(ez2-mu*mu,0.0)
        diag_rows.append(mu.astype(np.float32))
        diag_vars.append(var.astype(np.float32))
    half=N//2
    base=rng.standard_normal((half,WIDTH),dtype=np.float32)
    x=np.concatenate([base,-base],axis=0)
    x=x-x.mean(axis=0)
    cov=(x.T@x)/float(N)
    vals,vecs=np.linalg.eigh(cov.astype(np.float64))
    inv=vecs @ (np.diag(1/np.sqrt(np.maximum(vals,1e-12))) @ vecs.T)
    x=(x @ inv).astype(np.float32)
    # x0 after whitening cov exact, mean zero
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x @ w,0.0)
        if i in (0,1,3):
            xc=x-x.mean(axis=0)
            xv=np.maximum((xc*xc).mean(axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
            if i==0: x=a0*x+(1-a0)*xm  # current -0.5*x +1.5*xm
            elif i==1: x=a1*x+(1-a1)*xm
            elif i==3: x=a3*x+(1-a3)*xm
    z=x @ weights[-1]
    final_mc=np.maximum(z,0.0).mean(axis=0).astype(np.float32)
    z_mu=z.mean(axis=0)
    zc=z-z_mu
    z_sigma=np.sqrt(np.maximum((zc*zc).mean(axis=0),1e-12))
    a=z_mu/z_sigma
    final_norm=(z_mu*ndtr(a)+z_sigma*pdf(a)).astype(np.float32)
    diag=np.stack(diag_rows,axis=0).astype(np.float32)
    return final_mc, final_norm, diag[-1]

def target(weights, seed, n=65536, chunk=4096):
    rng=np.random.default_rng(seed)
    s=np.zeros(WIDTH,dtype=np.float64)
    count=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,WIDTH),dtype=np.float32)
        for w in weights:
            x=np.maximum(x @ w,0.0)
        s += x.astype(np.float64).sum(axis=0)
        count += m
    return (s/count).astype(np.float32)

mlp_rng=np.random.default_rng(12345)
rows=[]; ys=[]
t0=time.time()
for k in range(6):
    weights=[(mlp_rng.standard_normal((WIDTH,WIDTH),dtype=np.float32)*np.sqrt(2/WIDTH)).astype(np.float32) for _ in range(DEPTH)]
    comp=components(weights, seed=987654+k)
    y=target(weights, seed=424242+k, n=65536)
    rows.append(np.stack(comp,axis=1))
    ys.append(y)
    base=0.955*comp[0]+0.04*comp[1]+0.005*comp[2]
    print(k, 'baseline mse', np.mean((base-y)**2), 'mc', np.mean((comp[0]-y)**2), 'elapsed', time.time()-t0, flush=True)
X=np.concatenate(rows,axis=0).astype(np.float64)
y=np.concatenate(ys,axis=0).astype(np.float64)
for cols,name in [([0,1,2],'mc_norm_diag'),([0,1],'mc_norm'),([0,2],'mc_diag')]:
    A=X[:,cols]
    coef=np.linalg.lstsq(A,y,rcond=None)[0]
    pred=A@coef
    print(name, coef, np.mean((pred-y)**2))
print('current', np.mean(((0.955*X[:,0]+0.04*X[:,1]+0.005*X[:,2])-y)**2))
# constrain sum=1 via features differences y - diag maybe: coef sum 1
A=np.stack([X[:,0]-X[:,2], X[:,1]-X[:,2]],axis=1)
b=y-X[:,2]
coef2=np.linalg.lstsq(A,b,rcond=None)[0]
coefs=np.array([coef2[0],coef2[1],1-coef2.sum()])
print('sum1', coefs, np.mean((X@coefs-y)**2))

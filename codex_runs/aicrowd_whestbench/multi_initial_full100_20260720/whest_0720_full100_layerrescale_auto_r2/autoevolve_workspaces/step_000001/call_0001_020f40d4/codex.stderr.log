codex
There is no bivariate normal CDF exposed, so I’ll only consider a cheap zero-mean ReLU covariance approximation. I’m using the synthetic proxy again to see whether that signal looks useful before spending a blackbox run.
exec
/bin/bash -lc "python - <<'PY'
import time
import numpy as np
from scipy.special import ndtr
WIDTH=256; DEPTH=32; BUDGET=272_000_000_000
per_sample=DEPTH*(2*WIDTH*WIDTH+4*WIDTH)
N=max(1024, int((0.0909908329*BUDGET)/per_sample)); N=min(N,8192); N=max(2,2*(N//2))
SQRT2PI=np.sqrt(2*np.pi)

def pdf(x): return np.exp(-0.5*x*x)/SQRT2PI

def diag_components(weights):
    mu=np.zeros(WIDTH); var=np.ones(WIDTH); rows=[]; vars=[]
    for w in weights:
        wd=w.astype(np.float64,copy=False); mu_pre=wd.T@mu; var_pre=np.maximum((wd*wd).T@var,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig; c=ndtr(a); p=pdf(a)
        mu=mu_pre*c+sig*p; ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars

def full_zero(weights):
    mu=np.zeros(WIDTH,dtype=np.float64); cov=np.eye(WIDTH,dtype=np.float64)
    for w in weights:
        wd=w.astype(np.float64,copy=False)
        pre_mu=wd.T@mu
        pre_cov=wd.T@(cov@wd)
        var=np.maximum(np.diag(pre_cov),1e-12)
        sig=np.sqrt(var); a=pre_mu/sig; c=ndtr(a); p=pdf(a)
        mu=pre_mu*c+sig*p
        denom=np.sqrt(np.maximum(np.outer(var,var),1e-24))
        rho=np.clip(pre_cov/denom,-1,1)
        theta=np.arccos(rho)
        e=denom/(2*np.pi)*(np.sin(theta)+(np.pi-theta)*rho)
        m0=sig/SQRT2PI
        cov=e-np.outer(m0,m0)
        cov=(cov+cov.T)*0.5
    return mu.astype(np.float32)

def comps(weights, seed):
    rng=np.random.default_rng(seed)
    diag,vars=diag_components(weights)
    half=N//2; base=rng.standard_normal((half,WIDTH),dtype=np.float32)
    x=np.concatenate([base,-base],axis=0); x=x-x.mean(axis=0)
    row_norm=np.sqrt(np.maximum((x*x).sum(axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/float(N); vals,vecs=np.linalg.eigh(cov.astype(np.float64)); inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=(x@inv).astype(np.float32); x_norm=np.sqrt(np.maximum((x*x).sum(axis=1,keepdims=True),1e-12)); x=x*(row_norm/x_norm)
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0:
            xc=x-x.mean(axis=0); xv=np.maximum((xc*xc).mean(axis=0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+diag[i]
            x=-0.14*x+1.14*xm
        elif i==1:
            xc=x-x.mean(axis=0); xv=np.maximum((xc*xc).mean(axis=0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+diag[i]
            x=0.925*x+0.075*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(axis=0).astype(np.float32)
    zm=z.mean(axis=0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(axis=0),1e-12)); aa=zm/zs
    norm=(zm*ndtr(aa)+zs*pdf(aa)).astype(np.float32)
    full=full_zero(weights)
    return mc,norm,diag[-1],full

def target(weights,seed,n=131072,chunk=4096):
    rng=np.random.default_rng(seed); s=np.zeros(WIDTH); count=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,WIDTH),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); count+=m
    return (s/count).astype(np.float32)

mlp_rng=np.random.default_rng(9876); X=[]; y=[]; t0=time.time()
for k in range(8):
    weights=[(mlp_rng.standard_normal((WIDTH,WIDTH),dtype=np.float32)*np.sqrt(2/WIDTH)).astype(np.float32) for _ in range(DEPTH)]
    c=comps(weights,1000+k); tar=target(weights,2000+k,n=65536)
    X.append(np.stack(c,axis=1)); y.append(tar)
    cur=0.946*c[0]+0.048*c[1]+0.006*c[2]
    print(k,'cur',np.mean((cur-tar)**2),'full',np.mean((c[3]-tar)**2),'diag',np.mean((c[2]-tar)**2),'elapsed',time.time()-t0,flush=True)
X=np.concatenate(X).astype(np.float64); y=np.concatenate(y).astype(np.float64)
for cols,name in [([0,1,2],'current basis'),([0,1,2,3],'plus full'),([0,1,3],'full no diag')]:
    A=X[:,cols]; coef=np.linalg.lstsq(A,y,rcond=None)[0]; pred=A@coef
    print(name,coef,np.mean((pred-y)**2))
print('current t1.2',np.mean(((0.946*X[:,0]+0.048*X[:,1]+0.006*X[:,2])-y)**2))

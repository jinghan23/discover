import numpy as np
from math import erf, sqrt, pi

# Fast normal helpers
INV_SQRT2PI = 1/np.sqrt(2*np.pi)
def pdf(x): return INV_SQRT2PI*np.exp(-0.5*x*x)
def cdf(x): return 0.5*(1+np.vectorize(erf)(x/np.sqrt(2)))
# use scipy if available for speed
try:
    from scipy.special import ndtr
    cdf = ndtr
except Exception:
    pass


def diag_prop(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        mup=W.T@mu
        varp=(W*W).T@var
        varp=np.maximum(varp,1e-12)
        sig=np.sqrt(varp); a=mup/sig; P=cdf(a); p=pdf(a)
        mu=mup*P+sig*p
        ez2=(mup*mup+varp)*P + mup*sig*p
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var)
    return np.array(rows), np.array(vars)

def mc_mean(weights,n=262144,seed=123,batch=32768):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    sums=[np.zeros(w) for _ in weights]
    total=0
    while total<n:
        m=min(batch,n-total)
        x=rng.standard_normal((m,w)).astype(np.float64)
        for i,W in enumerate(weights):
            x=np.maximum(x@W,0)
            sums[i]+=x.sum(0)
        total+=m
    return np.array([s/n for s in sums])

def candidate_like(weights,n=8192,seed=1):
    width=weights[0].shape[0]
    diag, dvars=diag_prop(weights)
    rng=np.random.default_rng(seed)
    half=n//2
    base=rng.standard_normal((half,width))
    x=np.concatenate([base,-base],0)
    x=x-x.mean(0)
    row_norm=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    cov=x.T@x/n
    vals,vecs=np.linalg.eigh(cov)
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=x@inv
    x_norm=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    x=x*(row_norm/x_norm)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(dvars[i],1e-12)/xv)+diag[i]
            x=-0.14*x+1.14*xm
        elif i==1:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(dvars[i],1e-12)/xv)+diag[i]
            x=0.925*x+0.075*xm
    z=x@weights[-1]
    final_mc=np.maximum(z,0).mean(0)
    zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)**2).mean(0),1e-12)); za=zm/zs
    final_norm=zm*cdf(za)+zs*pdf(za)
    final=0.98*final_mc+0.015*final_norm+0.005*diag[-1]
    out=diag.copy(); out[-1]=final
    return out

def cov_hermite(weights,K=4,exact_first=False):
    w=weights[0].shape[0]
    mu=np.zeros(w); cov=np.eye(w); rows=[]; vars=[]
    eye=np.eye(w)
    for li,W in enumerate(weights):
        mup=W.T@mu
        pcov=W.T@cov@W
        varp=np.maximum(np.diag(pcov),1e-12)
        sig=np.sqrt(varp); a=mup/sig; P=cdf(a); p=pdf(a)
        mun=mup*P+sig*p
        ez2=(mup*mup+varp)*P+mup*sig*p
        varn=np.maximum(ez2-mun*mun,0)
        denom=np.outer(sig,sig)
        r=np.clip(pcov/np.maximum(denom,1e-30),-1,1)
        if exact_first and li==0 and np.max(np.abs(mup))<1e-12:
            th=np.arccos(r)
            second=denom/(2*np.pi)*(np.sqrt(np.maximum(1-r*r,0))+(np.pi-th)*r)
            cn=second-np.outer(mun,mun)
        else:
            b1=sig*P
            cn=np.outer(b1,b1)*r
            if K>=2:
                b2=sig*p
                r2=r*r; cn += 0.5*np.outer(b2,b2)*r2
            if K>=3:
                b3=-mup*p
                cn += (1/6)*np.outer(b3,b3)*r2*r
            if K>=4:
                b4=sig*(a*a-1)*p
                r4=r2*r2; cn += (1/24)*np.outer(b4,b4)*r4
            if K>=5:
                b5=sig*(-a*a*a+3*a)*p  # H3(-a)=(-a)"'^3-3(-a)
                cn += (1/120)*np.outer(b5,b5)*r4*r
            if K>=6:
                b6=sig*(a**4-6*a*a+3)*p # H4(-a)
                cn += (1/720)*np.outer(b6,b6)*r4*r2
        cn=cn*(1-eye)+np.diag(varn)
        # tiny symmetrization for simulation
        cov=(cn+cn.T)*0.5
        mu=mun
        rows.append(mu); vars.append(varn)
    return np.array(rows), np.array(vars)


def rand_weights(w,d,scale,seed):
    rng=np.random.default_rng(seed)
    return [rng.standard_normal((w,w))*scale for _ in range(d)]

for w,d in [(32,8),(64,8),(64,16),(128,8)]:
  for scale_name,scale in [('"'xav',1/np.sqrt(w)),('he',np.sqrt(2/w))]:
    errs=[]
    for s in range(5):
      W=rand_weights(w,d,scale,1000+s)
      true=mc_mean(W,n=131072,seed=2000+s)[-1]
      diag=diag_prop(W)[0][-1]
      cand=candidate_like(W,n=min(8192,4096 if w>=128 else 8192),seed=3000+s)[-1]
      cov2=cov_hermite(W,K=2,exact_first=True)[0][-1]
      cov4=cov_hermite(W,K=4,exact_first=True)[0][-1]
      cov6=cov_hermite(W,K=6,exact_first=True)[0][-1]
      errs.append([np.mean((diag-true)**2),np.mean((cand-true)**2),np.mean((cov2-true)**2),np.mean((cov4-true)**2),np.mean((cov6-true)**2)])
    print((w,d,scale_name), np.mean(errs,0))

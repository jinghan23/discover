/bin/bash -lc "python - <<'PY'
# 128 wide n=8192 edge blend quick
import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)
def pdf(x): return INV*np.exp(-.5*x*x)
def cdf(x): return ndtr(x)
def diag(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); R=[]; V=[]
 for W in Ws:
  mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; P=cdf(a); p=pdf(a); mu=mp*P+s*p; ez=(mp*mp+vp)*P+mp*s*p; var=np.maximum(ez-mu*mu,0); R.append(mu); V.append(var)
 return np.array(R),np.array(V)
def true(Ws,n,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; sm=np.zeros(w); tot=0
 while tot<n:
  m=min(32768,n-tot); x=rng.standard_normal((m,w))
  for W in Ws: x=np.maximum(x@W,0)
  sm+=x.sum(0); tot+=m
 return sm/n
def comps(Ws,n,seed):
 w=Ws[0].shape[0]; D,V=diag(Ws); rng=np.random.default_rng(seed); h=n//2; base=rng.standard_normal((h,w)); x=np.concatenate([base,-base]); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); C=x.T@x/n
 vals,vecs=np.linalg.eigh(C); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0)
  if i<2:
   c=1.14 if i==0 else .075; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+D[i]; x=(1-c)*x+c*xm
 z=x@Ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); yc=z-zm; v2=np.maximum((yc*yc).mean(0),1e-12); zs=np.sqrt(v2); a=zm/zs; p=pdf(a); norm=zm*cdf(a)+zs*p
 m3=(yc**3).mean(0); m4=(yc**4).mean(0); skew=m3/np.maximum(zs**3,1e-18); exk=m4/np.maximum(v2*v2,1e-18)-3
 edge=norm+zs*p*((skew/6)*(-a)+(exk/24)*(a*a-1)+(skew*skew/72)*(a**4-6*a*a+3))
 return np.vstack([mc,norm,edge,D[-1]])
for d in [8,16]:
 for scale in [1/np.sqrt(128),np.sqrt(2/128)]:
  X=[];Y=[]
  for s in range(6):
   rng=np.random.default_rng(8000+s); Ws=[rng.standard_normal((128,128))*scale for _ in range(d)]
   Y.append(true(Ws,131072,8200+s)); X.append(comps(Ws,8192,8400+s).T)
  X=np.concatenate(X); Y=np.concatenate(Y).ravel(); cur=.98*X[:,0]+.015*X[:,1]+.005*X[:,3]
  for e in [0.03,0.06,0.10,0.15,0.25]:
   pred=(.98-e)*X[:,0]+.015*X[:,1]+e*X[:,2]+.005*X[:,3]
   print('d',d,'scale',scale,'e',e,'mse',np.mean((pred-Y)**2),'cur',np.mean((cur-Y)**2),'mc',np.mean((X[:,0]-Y)**2),'edge',np.mean((X[:,2]-Y)**2))

+                + (z_a2 * z_a2 - 6.0 * z_a2 + 3.0) * (z_skew * z_skew / 72.0)
+            )
+            final_edge = fnp.maximum(final_norm + edge_corr, 0.0)
+            final_pred = fnp.asarray(

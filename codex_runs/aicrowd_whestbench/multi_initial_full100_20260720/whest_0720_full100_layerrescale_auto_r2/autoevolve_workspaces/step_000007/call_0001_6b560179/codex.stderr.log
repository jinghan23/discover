/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
INV=np.float64(1/np.sqrt(2*np.pi))
def pdf(x): return INV*np.exp(-0.5*x*x)
def cdf(x): return ndtr(x)

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        mup=W.T@mu; varp=np.maximum((W*W).T@var,1e-12); sig=np.sqrt(varp); a=mup/sig; P=cdf(a); p=pdf(a)
        mu=mup*P+sig*p; ez2=(mup*mup+varp)*P+mup*sig*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var)
    return np.array(rows),np.array(vars)

def true_mean(weights,n=524288,seed=7,batch=32768):
    rng=np.random.default_rng(seed); w=weights[0].shape[0]; s=np.zeros(w); tot=0
    while tot<n:
      m=min(batch,n-tot); x=rng.standard_normal((m,w))
      for W in weights: x=np.maximum(x@W,0)
      s+=x.sum(0); tot+=m
    return s/n

def components(weights,n,seed,a0=-0.14,a1=0.075):
    width=weights[0].shape[0]; diag,dvars=diag_prop(weights)
    rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,width)); x=np.r_[base,-base]
    x-=x.mean(0)
    row_norm=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); cov=x.T@x/n
    vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
    x_norm=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); x*=row_norm/x_norm
    for i,W in enumerate(weights[:-1]):
      x=np.maximum(x@W,0)
      if i==0:
        xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(dvars[i],1e-12)/xv)+diag[i]
        x=a0*x+(1-a0)*xm  # current a0=-.14 => -0.14 raw + 1.14 match
      elif i==1:
        xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(dvars[i],1e-12)/xv)+diag[i]
        x=(1-a1)*x+a1*xm
    z=x@weights[-1]
    mc=np.maximum(z,0).mean(0)
    zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)**2).mean(0),1e-12)); za=zm/zs
    norm=zm*cdf(za)+zs*pdf(za)
    # edgeworth using central moments maybe
    yc=z-zm
    m3=(yc**3).mean(0); m4=(yc**4).mean(0)
    skew=m3/np.maximum(zs**3,1e-18); exk=m4/np.maximum(zs**4,1e-18)-3
    # derive edgeworth correction: E[(mu+sY)+ H3,H4 terms over y>-alpha]
    # density phi*(1 + skew/6 H3 + exk/24 H4 + skew"'^2/72 H6)
    # contribution integral of (mu+sy) Hk phi from t=-alpha to inf. Use numerical omitted.
    return np.vstack([mc,norm,diag[-1]])

def randW(w,d,scale,seed):
    rng=np.random.default_rng(seed); return [rng.standard_normal((w,w))*scale for _ in range(d)]

for cfg in [(32,8),(64,8),(64,16),(128,8),(128,16)]:
  w,d=cfg; scale=1/np.sqrt(w)
  X=[]; Y=[]
  for s in range(12):

+            )
+        else:
+            final_pred = fnp.asarray(0.98 * final_mc + 0.015 * final_norm + 0.005 * diag[-1], dtype=fnp.float32)
         return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None, :]), axis=0), dtype=fnp.float32)


/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
INV=1/np.sqrt(2*np.pi)
def pdf(x): return INV*np.exp(-.5*x*x)
def cdf(x): return ndtr(x)

def diag_prop(Ws):
 w=Ws[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
 for W in Ws:
  mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; P=cdf(a); p=pdf(a)
  mu=mp*P+s*p; ez=(mp*mp+vp)*P+mp*s*p; var=np.maximum(ez-mu*mu,0); rows.append(mu); vars.append(var)
 return np.array(rows),np.array(vars)

def true(Ws,n,seed):
 rng=np.random.default_rng(seed); w=Ws[0].shape[0]; sm=np.zeros(w); tot=0
 while tot<n:
  m=min(32768,n-tot); x=rng.standard_normal((m,w))
  for W in Ws: x=np.maximum(x@W,0)
  sm+=x.sum(0); tot+=m
 return sm/n

def comps(Ws,n,seed,a0=-.14,a1=.075):
 w=Ws[0].shape[0]; D,V=diag_prop(Ws); rng=np.random.default_rng(seed); h=n//2
 x=np.r_[rng.standard_normal((h,w)), -rng.standard_normal((h,w))] if False else None
 base=rng.standard_normal((h,w)); x=np.concatenate([base,-base])
 x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); C=x.T@x/n
 vals,vecs=np.linalg.eigh(C); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
 xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); x*=rn/xn
 for i,W in enumerate(Ws[:-1]):
  x=np.maximum(x@W,0)
  if i in (0,1):
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(V[i],1e-12)/xv)+D[i]
   if i==0: x=a0*x+(1-a0)*xm
   else: x=(1-a1)*x+a1*xm
 z=x@Ws[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zs=np.sqrt(np.maximum(((z-zm)**2).mean(0),1e-12)); norm=zm*cdf(zm/zs)+zs*pdf(zm/zs)
 return np.vstack([mc,norm,D[-1]])
for cfg in [(32,8),(64,8),(64,16),(128,8),(128,16)]:
 w,d=cfg; scale=np.sqrt(2/w); X=[]; Y=[]
 for s in range(8):
  rng=np.random.default_rng(700+s); Ws=[rng.standard_normal((w,w))*scale for _ in range(d)]
  Y.append(true(Ws,131072 if w<128 else 65536,900+s)); X.append(comps(Ws,8192 if w<128 else 4096,1100+s).T)

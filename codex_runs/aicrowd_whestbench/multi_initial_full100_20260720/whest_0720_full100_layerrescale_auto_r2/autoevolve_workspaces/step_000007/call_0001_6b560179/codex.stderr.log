+            z_m3 = fnp.mean(z_center * z_center * z_center, axis=0)
+            z_m4 = fnp.mean(z_center * z_center * z_center * z_center, axis=0)
+            z_skew = z_m3 / fnp.maximum(z_sigma * z_var, 1e-18)
+            z_exk = z_m4 / fnp.maximum(z_var * z_var, 1e-18) - 3.0

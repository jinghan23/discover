import numpy as np
from scipy.stats import norm
# compact current estimator with variable n
def probe(width,n,rng):
 half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); x=np.concatenate((base,-base),0).astype(float); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); return (x*(rn/xn)).astype(np.float32)
def diag(weights):
 w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vs=[]
 for W in weights:
  Wd=W.astype(float); mp=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=norm.pdf(a); c=norm.cdf(a); mu=mp*c+s*p; ez2=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vs.append(var.copy())
 return rows,vs
def pred(weights,ps,seed):
 rows,vs=diag(weights); x=ps[seed%2].astype(float).copy()
 for i,W in enumerate(weights[:-1]):
  x=np.maximum(x@W,0)
  if i==0:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=-0.14*x+1.14*xm
  elif i==1:
   xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=0.925*x+0.075*xm
 z=x@weights[-1]; f=np.maximum(z,0).mean(0); zmu=z.mean(0); zs=np.sqrt(np.maximum(((z-zmu)**2).mean(0),1e-12)); fn=zmu*norm.cdf(zmu/zs)+zs*norm.pdf(zmu/zs); return 0.955*f+0.04*fn+0.005*rows[-1]
def target(weights,n,rng):
 w=weights[0].shape[0]; s=np.zeros(w); done=0; chunk=65536
 while done<n:
  m=min(chunk,n-done); x=rng.standard_normal((m,w)).astype(np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.sum(0); done+=m
 return s/n
def run(width,depth):
 rng=np.random.default_rng(33); scale=np.sqrt(2/width); pairs=[]
 for i in range(8):
  weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
  pairs.append((weights,target(weights,524288,np.random.default_rng(800+i)),i))
 for n in [2048,4096,8192,12288,16384,24576]:
  setup=np.random.default_rng(123); ps=[probe(width,n,setup),probe(width,n,setup)]
  ms=[np.mean((pred(W,ps,i)-t)**2) for W,t,i in pairs]
  print(width,depth,n,np.mean(ms), 'adj@floor?',0.1*np.mean(ms),'adj@ratio0.11n/8192',0.11*n/8192*np.mean(ms))
for spec in [(64,8),(128,8),(128,4)]: run(*spec)

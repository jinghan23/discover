# Same core functions, one focused higher-precision run for plausible sizes.
import numpy as np
from scipy.stats import norm
import time

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate((base,-base),0).astype(np.float64); x-=x.mean(0)
    rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    cov=x.T@x/float(n); vals,vecs=np.linalg.eigh(cov)
    x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
    xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    return (x*(rn/xn)).astype(np.float32)

def diag(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vs=[]
    for w in weights:
        wd=w.astype(np.float64); mp=wd.T@mu; vp=np.maximum((wd*wd).T@var,1e-12)
        s=np.sqrt(vp); a=mp/s; p=norm.pdf(a); c=norm.cdf(a)
        mu=mp*c+s*p; ez2=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vs.append(var.copy())
    return rows,vs

def pred(weights,probes,seed,coeff):
    rows,vs=diag(weights); x=probes[seed%2].astype(np.float64).copy()
    c10,c11,c20,c21,af,an,ad=coeff
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=c10*x+c11*xm
        elif i==1:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=c20*x+c21*xm
    z=x@weights[-1]; fmc=np.maximum(z,0).mean(0)
    zmu=z.mean(0); zs=np.sqrt(np.maximum(((z-zmu)**2).mean(0),1e-12)); a=zmu/zs
    fn=zmu*norm.cdf(a)+zs*norm.pdf(a)
    return coeff[4]*fmc+coeff[5]*fn+coeff[6]*rows[-1]

def target(weights,n,rng):
    width=weights[0].shape[0]; s=np.zeros(width); done=0; chunk=65536
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n

def evalset(width,depth,n_mlp=12,nprobe=8192,ntarget=1048576):
    setup=np.random.default_rng(123); probes=[make_probe(width,nprobe,setup) for _ in range(2)]
    rng=np.random.default_rng(999); pairs=[]
    t=time.time()
    for i in range(n_mlp):
        scale=np.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        targ=target(weights,ntarget,np.random.default_rng(5000+i))
        pairs.append((weights,targ,i))
    print('built',width,depth,'time',time.time()-t)
    base=(-0.14,1.14,0.925,0.075,0.955,0.04,0.005)
    for coeff in [base,(-0.14,1.14,0.925,0.075,0.97,0.025,0.005),(-0.14,1.14,0.925,0.075,0.98,0.015,0.005),(-0.12,1.12,0.93,0.07,0.955,0.04,0.005),(-0.16,1.16,0.92,0.08,0.955,0.04,0.005),(-0.14,1.14,1.0,0.0,0.955,0.04,0.005)]:
        ms=[]
        for weights,targ,i in pairs:
            pr=pred(weights,probes,i,coeff); ms.append(np.mean((pr-targ)**2))
        print('coeff',coeff,'mse',np.mean(ms),'std',np.std(ms))
for spec in [(64,4),(64,8),(128,4)]:
    evalset(*spec,n_mlp=8,ntarget=524288)

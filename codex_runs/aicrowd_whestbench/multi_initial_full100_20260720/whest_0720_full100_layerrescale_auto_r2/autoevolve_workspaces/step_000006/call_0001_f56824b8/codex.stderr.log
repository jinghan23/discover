/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
import time

def make_probe(width, n_samples, rng):
    half = n_samples // 2
    base = rng.standard_normal((half, width)).astype(np.float32)
    x = np.concatenate((base, -base), axis=0).astype(np.float64)
    x = x - x.mean(axis=0)
    row_norm = np.sqrt(np.maximum(np.sum(x*x, axis=1, keepdims=True), 1e-12))
    cov = (x.T @ x) / float(n_samples)
    vals, vecs = np.linalg.eigh(cov)
    inv_sqrt = vecs @ (np.diag(1.0/np.sqrt(np.maximum(vals, 1e-12))) @ vecs.T)
    x = x @ inv_sqrt
    x_norm = np.sqrt(np.maximum(np.sum(x*x, axis=1, keepdims=True), 1e-12))
    return (x * (row_norm/x_norm)).astype(np.float32)

def diag_rows(weights, width):
    mu=np.zeros(width,dtype=np.float64); var=np.ones(width,dtype=np.float64)
    rows=[]; vars=[]
    for w in weights:
        wd=w.astype(np.float64)
        mu_pre=wd.T@mu
        var_pre=np.maximum((wd*wd).T@var,1e-12)
        sig=np.sqrt(var_pre); a=mu_pre/sig
        phi=norm.pdf(a); cdf=norm.cdf(a)
        mu=mu_pre*cdf+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy())
    return rows, vars

def current_pred(weights, probes, seed, coeff=(-0.14,1.14,0.925,0.075,0.955,0.04,0.005)):
    width=weights[0].shape[0]
    rows, vars = diag_rows(weights,width)
    x=probes[seed%len(probes)].copy().astype(np.float64)
    c10,c11,c20,c21,af,an,ad=coeff
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i==0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=c10*x+c11*xm
        elif i==1:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=c20*x+c21*xm
    z=x@weights[-1]
    final_mc=np.maximum(z,0.0).mean(0)
    zmu=z.mean(0); zc=z-zmu; zsig=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); za=zmu/zsig
    final_norm=zmu*norm.cdf(za)+zsig*norm.pdf(za)
    return af*final_mc+an*final_norm+ad*rows[-1]

def target_mc(weights, n, rng, chunk=32768):
    width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0.0)
        s += x.sum(0)
        done += m
    return s/n

def run(width, depth, n_mlp=8, n_probe=8192, n_target=262144):
    rng_setup=np.random.default_rng(123)
    probes=[make_probe(width,n_probe,rng_setup) for _ in range(2)]
    ms=[]
    t=time.time()
    rng=np.random.default_rng(456)
    for i in range(n_mlp):
        scale=np.sqrt(2.0/width)
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        pred=current_pred(weights,probes,i)
        targ=target_mc(weights,n_target,np.random.default_rng(1000+i))
        ms.append(np.mean((pred-targ)**2))
    print('w d n',width,depth,n_probe,'mse mean',np.mean(ms),'std',np.std(ms),'time',time.time()-t)
for width, depth in [(32,4),(64,4),(64,8),(128,4),(128,8)]:
    run(width,depth,n_mlp=6,n_probe=8192,n_target=131072)

exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.stats import norm
import time

def probe_iid(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width)).astype(np.float32); return finish(base,n)
def probe_lhs(width,n,rng):
    half=n//2
    q=(np.arange(half)+0.5)/half
    cols=[norm.ppf(q[rng.permutation(half)]).astype(np.float32) for _ in range(width)]
    base=np.stack(cols,axis=1)
    return finish(base,n)
def finish(base,n):
    x=np.concatenate((base,-base),0).astype(np.float64); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); xn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); return (x*(rn/xn)).astype(np.float32)
def diag(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vs=[]
    for w in weights:
        wd=w.astype(float); mp=wd.T@mu; vp=np.maximum((wd*wd).T@var,1e-12); s=np.sqrt(vp); a=mp/s; p=norm.pdf(a); c=norm.cdf(a); mu=mp*c+s*p; ez2=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vs.append(var.copy())
    return rows,vs
def pred(weights,probes,seed):
    rows,vs=diag(weights); x=probes[seed%2].astype(float).copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=-0.14*x+1.14*xm
        elif i==1:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vs[i],1e-12)/xv)+rows[i]; x=0.925*x+0.075*xm
    z=x@weights[-1]; f=np.maximum(z,0).mean(0); zmu=z.mean(0); zs=np.sqrt(np.maximum(((z-zmu)**2).mean(0),1e-12)); fn=zmu*norm.cdf(zmu/zs)+zs*norm.pdf(zmu/zs); return 0.955*f+0.04*fn+0.005*rows[-1]
def target(weights,n,rng):
    width=weights[0].shape[0]; s=np.zeros(width); done=0; chunk=65536
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n
def run(width,depth,nmlp=10,nt=524288):
    rng=np.random.default_rng(88); scale=np.sqrt(2/width); pairs=[]
    for i in range(nmlp):
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        pairs.append((weights,target(weights,nt,np.random.default_rng(9000+i)),i))
    pi=[probe_iid(width,8192,np.random.default_rng(123)),probe_iid(width,8192,np.random.default_rng(124))]
    pl=[probe_lhs(width,8192,np.random.default_rng(123)),probe_lhs(width,8192,np.random.default_rng(124))]
    for name,ps in [('iid',pi),('lhs',pl)]:
        ms=[np.mean((pred(w,ps,i)-t)**2) for w,t,i in pairs]
        print(width,depth,name,np.mean(ms),np.std(ms))
for spec in [(64,4),(64,8),(128,4),(128,8)]: run(*spec,nmlp=8,nt=524288)

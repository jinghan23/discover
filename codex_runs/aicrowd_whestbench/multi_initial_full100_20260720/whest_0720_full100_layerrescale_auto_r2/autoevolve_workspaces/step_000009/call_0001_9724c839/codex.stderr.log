exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import math, time
PHI0=1/math.sqrt(2*math.pi)

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width),dtype=np.float32)
    x=np.concatenate((base,-base),axis=0); x=x-np.mean(x,axis=0,keepdims=True)
    cov=(x.T@x)/n; vals,vecs=np.linalg.eigh(cov.astype(np.float64)); inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    return (x@inv).astype(np.float32)

def relu_mom(mp,vp):
    vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a); mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; return mu,np.maximum(ez2-mu*mu,0)

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W0 in weights:
        W=W0.astype(np.float64); mu,var=relu_mom(W.T@mu,(W*W).T@var); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def pred(weights,probe,c0,c1,fb=0.0035):
    dr,dv=diag_prop(weights); x=probe.copy()
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0: cc=c0
        elif i==1: cc=c1
        else: continue
        xc=x-np.mean(x,axis=0,keepdims=True); xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
        xm=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]; x=cc*x+(1-cc)*xm
    mc=np.mean(np.maximum(x@weights[-1],0),axis=0).astype(np.float32)
    return (1-fb)*mc+fb*dr[-1]

def target(weights,n,rng,chunk=2048):
    width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(axis=0,dtype=np.float64); done+=m
    return (s/n).astype(np.float32)
width=256; depth=32; n_mlps=12; n_target=80000; n_pred=7078
probes=[make_probe(width,n_pred,np.random.default_rng(3500+i)) for i in range(2)]
items=[]; t0=time.time()
for j in range(n_mlps):
    rng=np.random.default_rng(31000+j); scale=math.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    trg=target(weights,n_target,np.random.default_rng(32000+j)); items.append((weights,probes[j%2],trg)); print('made',j+1,'elapsed',time.time()-t0,flush=True)
def score(c0,c1,fb=0.0035): return float(np.mean([np.mean((pred(w,p,c0,c1,fb)-t)**2) for w,p,t in items]))
base=score(-0.14,0.925); print('base',base,flush=True); best=(base,(-0.14,0.925,0.0035))
for c0 in [-0.22,-0.18,-0.16,-0.14,-0.12,-0.10,-0.06,0.0]:
 for c1 in [0.85,0.90,0.925,0.95,0.975,1.0]:
  for fb in [0.002,0.0035,0.005]:
    s=score(c0,c1,fb)
    if s<best[0]: best=(s,(c0,c1,fb)); print('best',best,flush=True)
print('final',best)
PY" in /opt/tiger/discover/workspace

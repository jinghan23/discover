import numpy as np
from scipy.special import ndtr
import math, time

PHI0 = 1.0 / math.sqrt(2.0 * math.pi)

def make_probe(width, n_samples, rng):
    half = n_samples // 2
    base = rng.standard_normal((half, width), dtype=np.float32)
    x = np.concatenate((base, -base), axis=0)
    x = x - np.mean(x, axis=0, keepdims=True)
    row_norm = np.sqrt(np.maximum(np.sum(x * x, axis=1, keepdims=True), 1e-12))
    cov = (x.T @ x) / float(n_samples)
    vals, vecs = np.linalg.eigh(cov.astype(np.float64))
    inv_sqrt = vecs @ (np.diag(1.0 / np.sqrt(np.maximum(vals, 1e-12))) @ vecs.T)
    x = (x @ inv_sqrt).astype(np.float32)
    x_norm = np.sqrt(np.maximum(np.sum(x * x, axis=1, keepdims=True), 1e-12))
    return x * (row_norm / x_norm)

def diag_prop(weights):
    width = weights[0].shape[0]
    mu = np.zeros(width, dtype=np.float64)
    var = np.ones(width, dtype=np.float64)
    rows=[]; vars=[]
    for w0 in weights:
        w = w0.astype(np.float64)
        mu_pre = w.T @ mu
        var_pre = np.maximum((w*w).T @ var, 1e-12)
        sigma=np.sqrt(var_pre)
        alpha=mu_pre/sigma
        phi=np.exp(-0.5*alpha*alpha)*PHI0
        cdf=ndtr(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows, vars

def pred(weights, probe, c0=-0.14, c1=0.925, fblend=0.0035, c_extra=None):
    diag_rows, diag_vars = diag_prop(weights)
    x = probe.copy()
    for i,w in enumerate(weights[:-1]):
        x = np.maximum(x @ w, 0.0)
        c = None
        if i == 0: c = c0
        elif i == 1: c = c1
        elif c_extra is not None and i < len(c_extra)+2: c = c_extra[i-2]
        if c is not None:
            xc=x-np.mean(x,axis=0,keepdims=True)
            xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
            xm=xc*np.sqrt(np.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
            x=c*x+(1-c)*xm
    fm=np.mean(np.maximum(x @ weights[-1],0.0),axis=0).astype(np.float32)
    return (1-fblend)*fm+fblend*diag_rows[-1]

def target(weights, n, rng, chunk=8192):
    width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64)
    done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width), dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w,0.0)
        s += x.sum(axis=0,dtype=np.float64)
        done += m
    return (s/n).astype(np.float32)

width=64; depth=32; n_mlps=12; n_target=120000; n_pred=8192

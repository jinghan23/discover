/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import math, time
PHI0=1/math.sqrt(2*math.pi)

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width),dtype=np.float32)
    x=np.concatenate((base,-base),axis=0); x=x-np.mean(x,axis=0,keepdims=True)
    rn=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12)); cov=(x.T@x)/n
    vals,vecs=np.linalg.eigh(cov.astype(np.float64)); inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    y=(x@inv).astype(np.float32); yn=np.sqrt(np.maximum(np.sum(y*y,axis=1,keepdims=True),1e-12)); return y*(rn/yn)

def relu_mom(mp,vp):
    vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a)
    mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0); return mu,var

def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W0 in weights:
        W=W0.astype(np.float64); mu,var=relu_mom(W.T@mu,(W*W).T@var); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def first_cov_target(W):
    Wd=W.astype(np.float64); G=Wd.T@Wd
    q=np.maximum(np.diag(G),1e-12); sig=np.sqrt(q); denom=np.outer(sig,sig)
    rho=np.clip(G/denom,-1,1)
    theta=np.arccos(rho)
    second=denom/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
    mu=sig*PHI0
    cov=second-np.outer(mu,mu)
    np.fill_diagonal(cov,q*(0.5-1/(2*math.pi)))
    return mu.astype(np.float32), cov.astype(np.float32)

def full_match_first(x,W,mode,diag_mu,diag_var):
    if mode=='diag':
        xc=x-np.mean(x,axis=0,keepdims=True); xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
        xm=xc*np.sqrt(np.maximum(diag_var,1e-12)/xv)+diag_mu
        return -0.14*x+1.14*xm
    mu_t,Ct=first_cov_target(W)
    xc=x-np.mean(x,axis=0,keepdims=True)
    S=(xc.T@xc)/x.shape[0]
    # regularize
    vals,vecs=np.linalg.eigh(S.astype(np.float64)); inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-9)))@vecs.T)
    vt,Ut=np.linalg.eigh(Ct.astype(np.float64)); sqrtC=Ut@(np.diag(np.sqrt(np.maximum(vt,1e-12)))@Ut.T)
    xm=(xc@inv@sqrtC).astype(np.float32)+mu_t
    if mode=='full': return xm
    if mode=='full_over': return -0.14*x+1.14*xm
    if mode=='full_half': return 0.5*x+0.5*xm
    if mode=='full_075': return 0.75*x+0.25*xm
    if mode=='full_125': return 1.25*x-0.25*xm
    raise ValueError

def pred(weights,probe,mode):
    dr,dv=diag_prop(weights); x=probe.copy()
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0:
            x=full_match_first(x,W,mode,dr[i],dv[i])
        elif i==1:
            xc=x-np.mean(x,axis=0,keepdims=True); xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
            xm=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]; x=0.925*x+0.075*xm
    mc=np.mean(np.maximum(x@weights[-1],0),axis=0).astype(np.float32)
    return 0.9965*mc+0.0035*dr[-1]

def target(weights,n,rng,chunk=2048):
    width=weights[0].shape[0]; s=np.zeros(width); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(axis=0,dtype=np.float64); done+=m
    return (s/n).astype(np.float32)
width=256; depth=32; n_mlps=10; n_target=90000; n_pred=7078
probes=[make_probe(width,n_pred,np.random.default_rng(3100+i)) for i in range(2)]
items=[]; t0=time.time()
for j in range(n_mlps):
    rng=np.random.default_rng(27000+j); scale=math.sqrt(2/width); weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    trg=target(weights,n_target,np.random.default_rng(28000+j)); items.append((weights,probes[j%2],trg)); print('made',j+1,'elapsed',time.time()-t0,flush=True)
for mode in ['diag','full','full_over','full_half','full_075','full_125']:
    vals=[]; t=time.time()
    for weights,probe,trg in items:
        p=pred(weights,probe,mode); vals.append(np.mean((p-trg)**2))
    print(mode,float(np.mean(vals)),['%.2g'%v for v in vals],'time',time.time()-t,flush=True)

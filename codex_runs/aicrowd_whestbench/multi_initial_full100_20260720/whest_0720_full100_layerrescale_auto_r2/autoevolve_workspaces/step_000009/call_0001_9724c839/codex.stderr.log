for b in blocks_list:
    ms=[]; t=time.time()
    for weights,idx,trg in items:
        p=pred(weights,probes[b][idx])
        ms.append(np.mean((p-trg)**2))
    print('blocks',b,float(np.mean(ms)),['%.2g'%m for m in ms],'time',time.time()-t,flush=True)

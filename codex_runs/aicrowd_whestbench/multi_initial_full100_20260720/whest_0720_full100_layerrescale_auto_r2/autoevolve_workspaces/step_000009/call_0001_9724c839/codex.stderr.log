import numpy as np
from scipy.special import ndtr
import math, time
PHI0=1/math.sqrt(2*math.pi)

def make_probe(width,n,rng):
    half=n//2
    base=rng.standard_normal((half,width),dtype=np.float32)
    x=np.concatenate((base,-base),axis=0)
    x=x-np.mean(x,axis=0,keepdims=True)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/float(n)
    vals,vecs=np.linalg.eigh(cov.astype(np.float64))
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=(x@inv).astype(np.float32)
    x_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    return x*(row_norm/x_norm)

def diag_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width); var=np.ones(width)
    rows=[]; vars=[]
    for w0 in weights:
        w=w0.astype(np.float64)
        mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(vp); a=mp/sig
        phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a)
        mu=mp*c+sig*phi
        ez2=(mp*mp+vp)*c+mp*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def pred(weights,probe,c0,c1,fb):
    dr,dv=diag_prop(weights); x=probe.copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0: cc=c0
        elif i==1: cc=c1
        else: continue
        xc=x-np.mean(x,axis=0,keepdims=True)
        xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
        xm=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]
        x=cc*x+(1-cc)*xm
    fm=np.mean(np.maximum(x@weights[-1],0),axis=0).astype(np.float32)
    return (1-fb)*fm+fb*dr[-1]

def target(weights,n,rng,chunk=2048):
    width=weights[0].shape[0]
    s=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,width),dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0,dtype=np.float64); done+=m
    return (s/n).astype(np.float32)


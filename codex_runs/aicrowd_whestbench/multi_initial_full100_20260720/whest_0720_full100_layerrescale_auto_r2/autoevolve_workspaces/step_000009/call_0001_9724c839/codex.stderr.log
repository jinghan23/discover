    for weights,idx,trg in items:
        p=pred(weights,probes[mode][idx])
        ms.append(np.mean((p-trg)**2))
    print(mode, float(np.mean(ms)), ['%.2g'%m for m in ms], 'time', time.time()-t, flush=True)

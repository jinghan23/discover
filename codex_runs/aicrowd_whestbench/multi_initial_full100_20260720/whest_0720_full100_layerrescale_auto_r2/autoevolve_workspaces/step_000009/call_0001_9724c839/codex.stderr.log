/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import math, time
PHI0=1/math.sqrt(2*math.pi)

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width),dtype=np.float32)
    x=np.concatenate((base,-base),axis=0); x=x-np.mean(x,axis=0,keepdims=True)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/float(n); vals,vecs=np.linalg.eigh(cov.astype(np.float64))
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    y=(x@inv).astype(np.float32); y_norm=np.sqrt(np.maximum(np.sum(y*y,axis=1,keepdims=True),1e-12))
    return y*(row_norm/y_norm)

def relu_mom(mp,vp):
    vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=mp/sig; phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a)
    mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
    return mu,var,c

def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w0 in weights:
        w=w0.astype(np.float64); mp=w.T@mu; vp=(w*w).T@var
        mu,var,_=relu_mom(mp,vp); rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def cov_prop_final(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); cov=np.eye(width)
    for w0 in weights:
        w=w0.astype(np.float64); mp=w.T@mu; cp=w.T@cov@w; vp=np.diag(cp)
        mu,var,gain=relu_mom(mp,vp)
        cov=np.outer(gain,gain)*cp
        np.fill_diagonal(cov,var)
    return mu.astype(np.float32)

def pred_mc_diag(weights,probe):
    dr,dv=diag_prop(weights); x=probe.copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0: cc=-0.14
        elif i==1: cc=0.925
        else: continue
        xc=x-np.mean(x,axis=0,keepdims=True); xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
        xm=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]
        x=cc*x+(1-cc)*xm
    mc=np.mean(np.maximum(x@weights[-1],0),axis=0).astype(np.float32)
    return mc,dr[-1]

def target(weights,n,rng,chunk=2048):
    width=weights[0].shape[0]; s=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(axis=0,dtype=np.float64); done+=m
    return (s/n).astype(np.float32)

width=256; depth=32; n_mlps=12; n_target=90000; n_pred=7078
probes=[make_probe(width,n_pred,np.random.default_rng(2700+i)) for i in range(2)]
comps=[]; t0=time.time()
for k in range(n_mlps):
    wrng=np.random.default_rng(23000+k); scale=math.sqrt(2/width)
    weights=[(wrng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    trg=target(weights,n_target,np.random.default_rng(24000+k))
    mc,di=pred_mc_diag(weights,probes[k%2])
    co=cov_prop_final(weights)
    comps.append((mc,di,co,trg)); print('made',k+1,'elapsed',time.time()-t0,flush=True)

def score(bc,bd):
    ms=[]
    for mc,di,co,trg in comps:
        p=(1-bc-bd)*mc+bc*co+bd*di
        ms.append(np.mean((p-trg)**2))
    return float(np.mean(ms))
print('base',score(0,0.0035),'mc',score(0,0),'cov',score(1,0),'diag',score(0,1),flush=True)
best=(score(0,0.0035),(0,0.0035))
for bc in [-0.05,-0.02,-0.01,0,0.005,0.01,0.02,0.05,0.1,0.2,0.5,1.0]:
 for bd in [0,0.001,0.002,0.0035,0.005,0.008]:
    s=score(bc,bd)
    if s<best[0]: best=(s,(bc,bd)); print('best',best,flush=True)
print('final',best)

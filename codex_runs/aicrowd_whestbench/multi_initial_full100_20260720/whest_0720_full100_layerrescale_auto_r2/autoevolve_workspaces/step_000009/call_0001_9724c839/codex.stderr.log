codex
The next substantive idea is to replace or blend the final sample ReLU average with a Gaussian moment computed from the empirical final preactivation mean and variance. The final preactivation is a sum over width 256, so this may reduce Monte Carlo noise without changing hidden-layer sampling.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import math, time
PHI0=1/math.sqrt(2*math.pi)

def make_probe(width,n,rng):
    half=n//2; base=rng.standard_normal((half,width),dtype=np.float32)
    x=np.concatenate((base,-base),axis=0); x=x-np.mean(x,axis=0,keepdims=True)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/float(n); vals,vecs=np.linalg.eigh(cov.astype(np.float64))
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    y=(x@inv).astype(np.float32); y_norm=np.sqrt(np.maximum(np.sum(y*y,axis=1,keepdims=True),1e-12))
    return y*(row_norm/y_norm)

def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w0 in weights:
        w=w0.astype(np.float64); mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(vp); a=mp/sig; phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a)
        mu=mp*c+sig*phi; ez2=(mp*mp+vp)*c+mp*sig*phi; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return rows,vars

def pred_components(weights,probe):
    dr,dv=diag_prop(weights); x=probe.copy()
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0: cc=-0.14
        elif i==1: cc=0.925
        else: continue
        xc=x-np.mean(x,axis=0,keepdims=True); xv=np.maximum(np.mean(xc*xc,axis=0,keepdims=True),1e-12)
        xm=xc*np.sqrt(np.maximum(dv[i],1e-12)/xv)+dr[i]
        x=cc*x+(1-cc)*xm
    z=x@weights[-1]
    mc=np.mean(np.maximum(z,0),axis=0).astype(np.float32)
    zm=np.mean(z,axis=0)
    zc=z-zm
    zv=np.maximum(np.mean(zc*zc,axis=0),1e-12)
    sig=np.sqrt(zv); a=zm/sig; phi=np.exp(-0.5*a*a)*PHI0; c=ndtr(a)
    ga=(zm*c+sig*phi).astype(np.float32)
    return mc,ga,dr[-1]

def target(weights,n,rng,chunk=2048):
    width=weights[0].shape[0]; s=np.zeros(width,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(axis=0,dtype=np.float64); done+=m
    return (s/n).astype(np.float32)

width=256; depth=32; n_mlps=16; n_target=90000; n_pred=7078
probes=[make_probe(width,n_pred,np.random.default_rng(2500+i)) for i in range(2)]
comps=[]; t0=time.time()
for k in range(n_mlps):
    wrng=np.random.default_rng(21000+k); scale=math.sqrt(2/width)
    weights=[(wrng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
    trg=target(weights,n_target,np.random.default_rng(22000+k))
    mc,ga,di=pred_components(weights,probes[k%2])
    comps.append((mc,ga,di,trg)); print('made',k+1,'elapsed',time.time()-t0,flush=True)

def score(bga,bdiag):
    # pred = (1-bga-bdiag)*mc + bga*ga + bdiag*diag
    ms=[]
    for mc,ga,di,trg in comps:
        p=(1-bga-bdiag)*mc+bga*ga+bdiag*di
        ms.append(np.mean((p-trg)**2))
    return float(np.mean(ms))
print('base',score(0,0.0035),flush=True)
print('mc',score(0,0), 'ga', score(1,0), 'diag',score(0,1), flush=True)
best=(score(0,0.0035),(0,0.0035))
for bg in [-0.5,-0.25,-0.1,-0.05,0,0.05,0.1,0.2,0.35,0.5,0.75,1.0,1.25]:
  for bd in [0,0.001,0.002,0.0035,0.005,0.008,0.012]:
    s=score(bg,bd)
    if s<best[0]: best=(s,(bg,bd)); print('best',best,flush=True)
print('final',best)

/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr, ndtri
from math import sqrt, pi

def pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def cdf(x): return ndtr(x)
def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]
    for W in weights:
        mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; ph=pdf(a); cd=cdf(a)
        mu=mp*cd+s*ph; e2=(mp*mp+vp)*cd+mp*s*ph; var=np.maximum(e2-mu*mu,0); rows.append(mu); vars.append(var)
    return rows,vars
def make_x(width,n,seed,radial):
    rng=np.random.default_rng(seed); half=n//2; base=rng.standard_normal((half,width),dtype=np.float32).astype(float); x=np.concatenate([base,-base]); x-=x.mean(0)
    if radial=='random': rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    elif radial=='const': rn=np.full((n,1),np.sqrt(width))
    elif radial=='wh':
        p=(np.arange(half)+0.5)/half; z=ndtri(p); t=1-2/(9*width)+z*np.sqrt(2/(9*width)); r=np.sqrt(width*np.maximum(t*t*t,1e-12)); rn=np.concatenate([r[:,None],r[:,None]],0)
    vals,vecs=np.linalg.eigh(x.T@x/n); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); return x
def pred(weights,n,seed,radial,b0=1.19,b1=.075):
    rows,vars=diag_prop(weights); x=make_x(weights[0].shape[0],n,seed,radial)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0 or i==1:
            beta=b0 if i==0 else b1; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm

        ph=pdf(a); cd=cdf(a); mu=mu_pre*cd+sig*ph
        ez2=(mu_pre*mu_pre+var_pre)*cd+mu_pre*sig*ph; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var)
    return rows,vars

def pred(weights,n,seed,restore=True,params=(-0.14,1.14,0.925,0.075),blend=(.946,.048,.006)):
    width=weights[0].shape[0]; rows,vars=diag_prop(weights); rng=np.random.default_rng(seed)
    half=n//2; base=rng.standard_normal((half,width), dtype=np.float32).astype(float); x=np.concatenate([base,-base],0); x=x-x.mean(0)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,1,keepdims=True),1e-12))
    cov=x.T@x/n; vals,vecs=np.linalg.eigh(cov); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T))
    if restore:

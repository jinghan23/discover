import numpy as np
from math import erf, sqrt, pi

def norm_pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def norm_cdf(x): return 0.5*(1+np.vectorize(erf)(x/sqrt(2)))
# vectorize erf is slow but okay small; use scipy if present
try:
    from scipy.special import ndtr
    norm_cdf = ndtr
except Exception:
    pass

def diag_prop(weights):
    w0=weights[0]
    width=w0.shape[0]
    mu=np.zeros(width, dtype=np.float64)
    var=np.ones(width, dtype=np.float64)
    rows=[]; vars=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(var_pre); alpha=mu_pre/sig
        phi=norm_pdf(alpha); cdf=norm_cdf(alpha)
        mu=mu_pre*cdf+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var)
    return rows,vars

def features(weights,n,seed, params=(-0.14,1.14,0.925,0.075)):
    width=weights[0].shape[0]
    rows,vars=diag_prop(weights)
    rng=np.random.default_rng(seed)
    half=n//2
    base=rng.standard_normal((half,width), dtype=np.float32).astype(np.float64)
    x=np.concatenate([base,-base],axis=0)
    x=x-x.mean(axis=0)
    row_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    cov=(x.T@x)/float(n)
    vals,vecs=np.linalg.eigh(cov)
    inv=vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)
    x=x@inv
    x_norm=np.sqrt(np.maximum(np.sum(x*x,axis=1,keepdims=True),1e-12))
    x=x*(row_norm/x_norm)
    a,b,c,d=params
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0:
            xc=x-x.mean(axis=0); xv=np.maximum(np.mean(xc*xc,axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=a*x+b*xm
        elif i==1:
            xc=x-x.mean(axis=0); xv=np.maximum(np.mean(xc*xc,axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=c*x+d*xm
    z=x@weights[-1]
    final_mc=np.mean(np.maximum(z,0),axis=0)
    z_mu=np.mean(z,axis=0); zc=z-z_mu
    z_var=np.maximum(np.mean(zc*zc,axis=0),1e-12); z_sig=np.sqrt(z_var)
    alpha=z_mu/z_sig; phi=norm_pdf(alpha); cdf=norm_cdf(alpha)
    final_norm=z_mu*cdf+z_sig*phi
    m3=np.mean(zc**3,axis=0)/(z_sig**3)
    m4=np.mean(zc**4,axis=0)/(z_var*z_var)-3.0
    t=-alpha
    corr=z_sig*phi*((m3/6.0)*t + (m4/24.0)*(t*t-1.0) + ((m3*m3)/72.0)*(t**4-6*t*t+3.0))
    final_edge=final_norm+corr
    return np.vstack([final_mc, final_norm, np.array(rows[-1]), final_edge])

def target(weights,n=300000,seed=12345,batch=50000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(width)
    done=0
    while done<n:
        b=min(batch,n-done)
        x=rng.standard_normal((b,width))
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0); done+=b
    return s/n

def run(width=64,depth=4,scale='he',n=4096,m=12):
    X=[]; y=[]
    for seed in range(m):
        rng=np.random.default_rng(1000+seed)
        if scale=='he': sc=np.sqrt(2/width)
        elif scale=='xavier': sc=1/np.sqrt(width)
        elif scale=='std': sc=1.0
        weights=[rng.standard_normal((width,width))*sc for _ in range(depth)]
        feat=features(weights,n,seed+7)
        tgt=target(weights,n=200000,seed=9000+seed,batch=50000)
        X.append(feat.T); y.append(tgt)
    X=np.concatenate(X,axis=0); y=np.concatenate(y,axis=0)
    base=0.946*X[:,0]+0.048*X[:,1]+0.006*X[:,2]
    print('shape',width,depth,scale,'n',n,'base mse',np.mean((base-y)**2))
    names=['mc','norm','diag','edge']
    for i,name in enumerate(names): print(name,np.mean((X[:,i]-y)**2))
    for cols in ([0,1,2],[0,1,2,3],[0,3,2],[0,3]):
        A=X[:,cols]
        coef=np.linalg.lstsq(A,y,rcond=None)[0]
        pred=A@coef
        print('cols',cols,'coef',coef,'mse',np.mean((pred-y)**2))
    print()

for scale in ['he','xavier']:
  for depth in [3,4,6,8]:
    run(64,depth,scale,n=4096,m=8)

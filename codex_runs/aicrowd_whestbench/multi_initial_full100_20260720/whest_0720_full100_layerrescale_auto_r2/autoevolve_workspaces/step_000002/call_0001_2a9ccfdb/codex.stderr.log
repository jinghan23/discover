        elif i==1:
            xc=x-x.mean(0); xv=np.maximum(np.mean(xc*xc,0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=c*x+d*xm
    z=x@weights[-1]; mc=np.mean(np.maximum(z,0),0); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum(np.mean(zc*zc,0),1e-12)); aa=zm/zs
    norm=zm*cdf(aa)+zs*pdf(aa); diag=np.array(rows[-1]); return blend[0]*mc+blend[1]*norm+blend[2]*diag

def target(weights,n=250000,seed=123,batch=50000):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(w); done=0

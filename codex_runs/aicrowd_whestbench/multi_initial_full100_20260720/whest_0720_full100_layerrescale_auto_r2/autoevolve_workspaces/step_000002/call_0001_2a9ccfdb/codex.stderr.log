/bin/bash -lc "python - <<'PY'
# Reuse a compact local simulation to estimate additive Edgeworth correction coefficient k.
import numpy as np
from scipy.special import ndtr
from math import sqrt, pi

def pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def cdf(x): return ndtr(x)
def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for w in weights:
        mp=w.T@mu; vp=np.maximum((w*w).T@var,1e-12); s=np.sqrt(vp); a=mp/s; ph=pdf(a); cd=cdf(a)
        mu=mp*cd+s*ph; e2=(mp*mp+vp)*cd+mp*s*ph; var=np.maximum(e2-mu*mu,0); rows.append(mu); vars.append(var)
    return rows,vars
def feats(weights,n,seed):
    width=weights[0].shape[0]; rows,vars=diag_prop(weights); rng=np.random.default_rng(seed); half=n//2
    x=np.concatenate([rng.standard_normal((half,width),dtype=np.float32).astype(float), -rng.standard_normal((0,width))])
    # above cannot antithetic after lost base; redo
    base=rng.standard_normal((half,width),dtype=np.float32).astype(float); x=np.concatenate([base,-base]); x-=x.mean(0)
    rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); vals,vecs=np.linalg.eigh(x.T@x/n); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i==0 or i==1:
            beta=1.14 if i==0 else 0.075
            xc=x-x.mean(0); xv=np.maximum(np.mean(xc*xc,0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]
            x=(1-beta)*x+beta*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zc=z-zm; zv=np.maximum(np.mean(zc*zc,0),1e-12); zs=np.sqrt(zv); a=zm/zs; ph=pdf(a); norm=zm*cdf(a)+zs*ph; diag=np.array(rows[-1])
    g3=np.mean(zc**3,0)/(zs**3); g4=np.mean(zc**4,0)/(zv*zv)-3; t=-a
    corr=zs*ph*((g3/6)*t+(g4/24)*(t*t-1)+(g3*g3/72)*(t**4-6*t*t+3))
    return mc,norm,diag,corr
def target(weights,n=150000,seed=0,batch=50000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=b
    return s/n
for depth in [3,4,6,8]:
  allcorr=[]; baseerr=[]; yall=[]; basepred=[]
  for seed in range(6):
    width=64; sc=1/np.sqrt(width); rng=np.random.default_rng(5000+seed); weights=[rng.standard_normal((width,width))*sc for _ in range(depth)]
    mc,norm,diag,corr=feats(weights,4096,seed+33); p=.946*mc+.048*norm+.006*diag; y=target(weights,seed=9500+seed)
    allcorr.append(corr); basepred.append(p); yall.append(y)
  c=np.concatenate(allcorr); p=np.concatenate(basepred); y=np.concatenate(yall)
  print('depth',depth,'base',np.mean((p-y)**2))
  for k in [-.2,-.1,-.05,0,.05,.1,.2,.4,.6]: print(k,np.mean((p+k*c-y)**2),end=' ')
  print('\\nopt',np.dot(c,y-p)/np.dot(c,c))

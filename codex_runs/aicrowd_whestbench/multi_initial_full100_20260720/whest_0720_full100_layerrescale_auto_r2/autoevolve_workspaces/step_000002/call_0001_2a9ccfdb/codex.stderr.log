import numpy as np
from scipy.special import ndtr
from math import sqrt, pi

def pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def cdf(x): return ndtr(x)
def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for W in weights:
        mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; ph=pdf(a); cd=cdf(a); mu=mp*cd+s*ph; e2=(mp*mp+vp)*cd+mp*s*ph; var=np.maximum(e2-mu*mu,0); rows.append(mu); vars.append(var)
    return rows,vars
def first_relu_cov(W):
    v=np.maximum((W*W).sum(0),1e-12); s=np.sqrt(v); mu=s/sqrt(2*pi); G=W.T@W; rho=np.clip(G/(s[:,None]*s[None,:]),-1,1); term=np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho; e=(s[:,None]*s[None,:])*term/(2*np.pi); cov=e-mu[:,None]*mu[None,:]; return mu,cov
def pred(weights,n,seed,fullmatch=False,beta0=1.0,b1=.075):
    rows,vars=diag_prop(weights); width=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2
    base=rng.standard_normal((half,width),dtype=np.float32).astype(float); x=np.concatenate([base,-base]); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); vals,vecs=np.linalg.eigh(x.T@x/n); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0:
            xc=x-x.mean(0)
            if fullmatch:
                mu,cov=first_relu_cov(W); scov=xc.T@xc/n; vs,Us=np.linalg.eigh(scov); ve,Ue=np.linalg.eigh(cov); A=(Us@(np.diag(1/np.sqrt(np.maximum(vs,1e-12)))@Us.T))@(Ue@(np.diag(np.sqrt(np.maximum(ve,1e-12)))@Ue.T)); xm=xc@A+mu
                beta=beta0; x=(1-beta)*x+beta*xm
            else:
                beta=beta0; xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
        elif i==1:
            beta=b1; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=zm/zs; norm=zm*cdf(a)+zs*pdf(a); return .946*mc+.048*norm+.006*rows[-1]
def target(weights,n=150000,seed=0,batch=50000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,width))
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=b
    return s/n
for depth in [3,4,6,8]:

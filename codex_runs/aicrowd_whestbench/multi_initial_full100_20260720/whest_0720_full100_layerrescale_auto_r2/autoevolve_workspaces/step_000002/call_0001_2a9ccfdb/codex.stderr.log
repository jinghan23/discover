import numpy as np
from scipy.special import ndtr, ndtri
from math import sqrt, pi

def pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def cdf(x): return ndtr(x)
def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    for W in weights:
        mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s; ph=pdf(a); cd=cdf(a); mu=mp*cd+s*ph; e2=(mp*mp+vp)*cd+mp*s*ph; var=np.maximum(e2-mu*mu,0); rows.append(mu); vars.append(var)
    return rows,vars
def make_x(width,n,seed,mode):
    rng=np.random.default_rng(seed); half=n//2
    if mode=='normal':
        base=rng.standard_normal((half,width),dtype=np.float32).astype(float)
    elif mode=='lhs_mid':
        r=np.empty((half,width),dtype=int)
        for j in range(width): r[:,j]=rng.permutation(half)
        u=(r+0.5)/half; base=ndtri(u)
    elif mode=='lhs_jitter':
        r=np.empty((half,width),dtype=int)
        for j in range(width): r[:,j]=rng.permutation(half)
        u=(r+rng.random((half,width)))/half; base=ndtri(u)
    elif mode=='rank_normal':
        y=rng.standard_normal((half,width)); r=np.argsort(np.argsort(y,axis=0),axis=0); u=(r+0.5)/half; base=ndtri(u)
    x=np.concatenate([base,-base]); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); vals,vecs=np.linalg.eigh(x.T@x/n); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); return x
def pred(weights,n,seed,mode):
    rows,vars=diag_prop(weights); x=make_x(weights[0].shape[0],n,seed,mode)
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0 or i==1:
            beta=1.19 if i==0 else .075; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=zm/zs; norm=zm*cdf(a)+zs*pdf(a); return .946*mc+.048*norm+.006*rows[-1]
def target(weights,n=150000,seed=0,batch=50000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,width))
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=b
    return s/n
modes=['normal','lhs_mid','lhs_jitter','rank_normal']
for depth in [3,4,6,8]:
    out={m:[] for m in modes}
    for seed in range(6):
        width=64; sc=1/np.sqrt(width); rng=np.random.default_rng(9100+seed); weights=[rng.standard_normal((width,width))*sc for _ in range(depth)]; y=target(weights,seed=9900+seed)
        for mode in modes: out[mode].append(np.mean((pred(weights,4096,seed+66,mode)-y)**2))
    print('depth',depth,{m:float(np.mean(out[m])) for m in modes})

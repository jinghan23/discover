/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import sqrt, pi

def pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def cdf(x): return ndtr(x)
def relu_mom(mp,vp):
    s=np.sqrt(np.maximum(vp,1e-12)); a=mp/s; ph=pdf(a); cd=cdf(a); mu=mp*cd+s*ph; e2=(mp*mp+vp)*cd+mp*s*ph; return mu,np.maximum(e2-mu*mu,0)
def diag_prop(weights,full2=False):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]
    if full2 and len(weights)>=2:
        W0=weights[0]; v=np.maximum((W0*W0).sum(0),1e-12); s=np.sqrt(v); mu=s/sqrt(2*pi); var=v*(0.5-1/(2*pi)); rows.append(mu); vars.append(var)
        G=W0.T@W0; rho=np.clip(G/(s[:,None]*s[None,:]),-1,1); term=np.sqrt(np.maximum(1-rho*rho,0))+(np.pi-np.arccos(rho))*rho; e=(s[:,None]*s[None,:])*term/(2*np.pi); cov=e-mu[:,None]*mu[None,:]
        W1=weights[1]; mp=W1.T@mu; cw=cov@W1; vp=np.maximum((W1*cw).sum(0),1e-12); mu,var=relu_mom(mp,vp); rows.append(mu); vars.append(var)
        for W in weights[2:]:
            mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); mu,var=relu_mom(mp,vp); rows.append(mu); vars.append(var)
        return rows,vars
    for W in weights:
        mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); mu,var=relu_mom(mp,vp); rows.append(mu); vars.append(var)
    return rows,vars
def pred(weights,n,seed,full2=False,b0=1.19,b1=.075):
    rows,vars=diag_prop(weights,full2); width=weights[0].shape[0]; rng=np.random.default_rng(seed); half=n//2
    base=rng.standard_normal((half,width),dtype=np.float32).astype(float); x=np.concatenate([base,-base]); x-=x.mean(0); rn=np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12)); vals,vecs=np.linalg.eigh(x.T@x/n); x=x@(vecs@(np.diag(1/np.sqrt(np.maximum(vals,1e-12)))@vecs.T)); x*=rn/np.sqrt(np.maximum((x*x).sum(1,keepdims=True),1e-12))
    for i,W in enumerate(weights[:-1]):
        x=np.maximum(x@W,0)
        if i==0 or i==1:
            beta=b0 if i==0 else b1; xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12); xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+rows[i]; x=(1-beta)*x+beta*xm
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); a=zm/zs; norm=zm*cdf(a)+zs*pdf(a); return .946*mc+.048*norm+.006*rows[-1]
def target(weights,n=160000,seed=0,batch=40000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    while done<n:
        b=min(batch,n-done); x=rng.standard_normal((b,width))
        for W in weights: x=np.maximum(x@W,0)
        s+=x.sum(0); done+=b
    return s/n
for scale in ['xavier','he']:
  for depth in [2,3,4,6,8]:
    out={False:[],True:[]}
    for seed in range(6):
      width=64; sc=1/np.sqrt(width) if scale=='xavier' else np.sqrt(2/width); rng=np.random.default_rng(8100+seed); weights=[rng.standard_normal((width,width))*sc for _ in range(depth)]; y=target(weights,seed=9800+seed)
      for f in out: out[f].append(np.mean((pred(weights,4096,seed+55,full2=f)-y)**2))
    print(scale,'depth',depth,'diag',float(np.mean(out[False])),'full2',float(np.mean(out[True])),'ratio',float(np.mean(out[True]))/float(np.mean(out[False])))

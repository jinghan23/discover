```python
from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


class Estimator(BaseEstimator):
    def predict(self, mlp, budget):
        width = int(mlp.width)
        depth = int(mlp.depth)

        mu = fnp.zeros(width)
        var = fnp.ones(width)
        means = []
        vars_ = []

        for w in mlp.weights:
            pre_mu = w.T @ mu
            pre_var = fnp.maximum((w * w).T @ var, 1e-12)
            sigma = fnp.sqrt(pre_var)
            alpha = pre_mu / sigma
            pdf = flops.stats.norm.pdf(alpha)
            cdf = flops.stats.norm.cdf(alpha)

            mu = pre_mu * cdf + sigma * pdf
            second = (pre_mu * pre_mu + pre_var) * cdf + pre_mu * sigma * pdf
            var = fnp.maximum(second - mu * mu, 0.0)

            means.append(mu)
            vars_.append(var)

        try:
            budget_value = float(budget)
        except Exception:
            budget_value = 0.0

        per_sample = max(1, depth * (2 * width * width + 4 * width))
        n_samples = int((0.0095 * budget_value) / float(per_sample))
        n_samples = max(256, min(n_samples, 2048))
        n_samples = max(2, 2 * (n_samples // 2))

        rng = fnp.random.default_rng(int(mlp.seed))
        half = n_samples // 2
        base = fnp.asarray(rng.standard_normal((half, width), dtype=fnp.float32))
        x = fnp.concatenate((base, -base), axis=0)
        x = x - fnp.mean(x, axis=0)

        x_var = fnp.maximum(fnp.mean(x * x, axis=0), 1e-12)
        x = x / fnp.sqrt(x_var)

        for i, w in enumerate(mlp.weights[:-1]):
            x = fnp.maximum(x @ w, 0.0)

            if i < 2:
                xc = x - fnp.mean(x, axis=0)
                xv = fnp.maximum(fnp.mean(xc * xc, axis=0), 1e-12)
                xm = xc * fnp.sqrt(fnp.maximum(vars_[i], 1e-12) / xv) + means[i]
                if i == 0:
                    x = -0.5 * x + 1.5 * xm
                else:
                    x = 0.86 * x + 0.14 * xm

        z = x @ mlp.weights[-1]
        z_mu = fnp.mean(z, axis=0)
        zc = z - z_mu
        z_sigma = fnp.sqrt(fnp.maximum(fnp.mean(zc * zc, axis=0), 1e-12))
        z_alpha = z_mu / z_sigma

        final_norm = z_mu * flops.stats.norm.cdf(z_alpha) + z_sigma * flops.stats.norm.pdf(z_alpha)
        final_mc = fnp.mean(fnp.maximum(z, 0.0), axis=0)
        diag = fnp.asarray(fnp.stack(means, axis=0), dtype=fnp.float32)

        final = fnp.asarray(
            0.91 * final_mc + 0.075 * final_norm + 0.015 * diag[-1],
            dtype=fnp.float32,
        )

        return fnp.asarray(
            fnp.concatenate((diag[:-1], final[None, :]), axis=0),
            dtype=fnp.float32,
        )
```

from pathlib import Path
import re, subprocess, sys, time
p=Path('submission.py')
base=p.read_text()
values=[0.005,0.0125,0.020,0.025,0.030,0.0375,0.050]
results=[]
for v in values:
    text=re.sub(r'"'^_FINAL_BLEND = .*$'"', f'_FINAL_BLEND = {v}', base, flags=re.M)
    p.write_text(text)
    t=time.time(); proc=subprocess.run([sys.executable,'eval_client.py'],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
    out=proc.stdout.strip(); raw=None
    for line in out.splitlines():
        if line.startswith('raw_score '): raw=float(line.split()[1])
    print(f'FBLEND={v:.4f} raw={raw} dt={time.time()-t:.1f}s')
    print(out); sys.stdout.flush()
    results.append((raw if raw is not None else float('inf'),v))
best=min(results)
print('BEST',best)
p.write_text(re.sub(r'"'^_FINAL_BLEND = .*$'"', f'_FINAL_BLEND = {best[1]}', base, flags=re.M))

/bin/bash -lc "python - <<'PY'
from pathlib import Path
import re, subprocess, sys, time
p=Path('submission.py')
base=p.read_text()
pairs=[(-0.14,0.27),(-0.14,0.28),(-0.14,0.29),(-0.13,0.27),(-0.13,0.28),(-0.13,0.29),(-0.12,0.27),(-0.12,0.28),(-0.12,0.29)]
results=[]
for first,last in pairs:
    text=re.sub(r'"'^_HIDDEN_BLEND_FIRST = .*$'"', f'_HIDDEN_BLEND_FIRST = {first}', base, flags=re.M)
    text=re.sub(r'"'^_HIDDEN_BLEND_LAST = .*$'"', f'_HIDDEN_BLEND_LAST = {last}', text, flags=re.M)
    p.write_text(text)
    t=time.time(); proc=subprocess.run([sys.executable,'eval_client.py'],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
    out=proc.stdout.strip(); raw=None
    for line in out.splitlines():
        if line.startswith('raw_score '): raw=float(line.split()[1])
    print(f'HB=({first:.3f},{last:.3f}) raw={raw} dt={time.time()-t:.1f}s')
    print(out); sys.stdout.flush()
    results.append((raw if raw is not None else float('inf'),first,last))
best=min(results)
print('BEST',best)
text=re.sub(r'"'^_HIDDEN_BLEND_FIRST = .*$'"', f'_HIDDEN_BLEND_FIRST = {best[1]}', base, flags=re.M)
text=re.sub(r'"'^_HIDDEN_BLEND_LAST = .*$'"', f'_HIDDEN_BLEND_LAST = {best[2]}', text, flags=re.M)
p.write_text(text)

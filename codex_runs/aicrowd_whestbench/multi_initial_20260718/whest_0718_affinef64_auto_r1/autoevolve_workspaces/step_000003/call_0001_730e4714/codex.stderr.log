+                    )
+                    variance_ratio = gaussian_variance / x_variance
+                    scale = fnp.sqrt(
+                        fnp.maximum(1.0 + (variance_ratio - 1.0) * _HIDDEN_VAR_BLEND, 1e-6)
+                    )
+                    x = (x - x_mean) * scale + x_mean
                 x = x + (gaussian_mean - x_mean) * blend
 
         z = x @ mlp.weights[-1]


from pathlib import Path
import re, subprocess, sys, time
p=Path('submission.py')
base=p.read_text()
base=re.sub(r'"'^_FIRST_COV_BLEND = .*$'"', '_FIRST_COV_BLEND = 0.0', base, flags=re.M)
base=re.sub(r'"'^_HIDDEN_VAR_BLEND = .*$'"', '_HIDDEN_VAR_BLEND = 0.0', base, flags=re.M)
values=[0.1690,0.1695,0.1700,0.1705,0.1710,0.1715,0.1720,0.1725]
results=[]
for v in values:
    text=re.sub(r'"'^_BUDGET_FRACTION = .*$'"', f'_BUDGET_FRACTION = {v}', base, flags=re.M)
    p.write_text(text)
    t=time.time(); proc=subprocess.run([sys.executable,'eval_client.py'],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
    out=proc.stdout.strip(); raw=None
    for line in out.splitlines():
        if line.startswith('raw_score '): raw=float(line.split()[1])
    print(f'BF={v:.4f} raw={raw} dt={time.time()-t:.1f}s')
    print(out); sys.stdout.flush()
    results.append((raw if raw is not None else float('inf'),v))
best=min(results)
print('BEST',best)
p.write_text(re.sub(r'"'^_BUDGET_FRACTION = .*$'"', f'_BUDGET_FRACTION = {best[1]}', base, flags=re.M))

"""Setup-cached whitened antithetic submission candidate.

The estimator uses antithetic Gaussian samples with exact empirical input
covariance.  The input quadrature is independent of the MLP weights, so it is
prepared once in setup and reused for every predict call.  Only the officially
scored final-layer mean is estimated.
"""

from __future__ import annotations

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_BUDGET_FRACTION = 0.1105
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = 3
_WHITEN_BLOCKS = 1
_PREDICT_BLOCKS = 1
_HIDDEN_GAUSS_BLEND = -0.08
_HIDDEN_GAUSS_BLEND_END = 0.21
_HIDDEN_VARIANCE_BLEND = 0.0
_HIDDEN_BLEND_START = 2
_HIDDEN_BLEND_STOP = 14
_HIDDEN_BLEND_POWER = 1
_FINAL_GAUSS_BLEND = 0.0
_INV_SQRT_2PI = 0.3989422804014327
_CDF_APPROX_SCALE = 0.7978845608028654
_CDF_APPROX_CUBIC = 0.044715
_FIRST_VARIANCE_FACTOR = 1.0


def _sample_count(budget: int, width: int, depth: int) -> int:
    # Each sample traverses every layer. The covariance uses only k/2 rows,
    # making its 2*(k/2)*w^2 cost equal to k*w^2.
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    return k - (k & 1)


def _gaussian_relu_moments(mean, variance):
    std = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = fnp.clip(mean / std, -8.0, 8.0)
    density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
    cdf = 0.5 * (
        1.0
        + fnp.tanh(_CDF_APPROX_SCALE * (alpha + _CDF_APPROX_CUBIC * alpha * alpha * alpha))
    )
    relu_mean = std * density + mean * cdf
    relu_second = (variance + mean * mean) * cdf + mean * std * density
    return relu_mean, relu_second


def _gaussian_relu_mean(mean, variance):
    relu_mean, _ = _gaussian_relu_moments(mean, variance)
    return relu_mean


class Estimator(BaseEstimator):
    """Whitened antithetic Monte Carlo with setup-cached input samples."""

    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._sample_blocks = self._make_sample_blocks(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )

    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        half_count = k // 2
        block_count = max(1, min(_WHITEN_BLOCKS, half_count // max(width, 1)))
        block_size = half_count // block_count
        remainder = half_count - block_size * block_count
        blocks = []
        for block_index in range(block_count):
            rows = block_size + int(block_index < remainder)
            u = rng.standard_normal((rows, width), dtype=fnp.float32)
            covariance = (u.T @ u) / float(rows)
            eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
            eigenvalues = fnp.maximum(eigenvalues, 1e-6)
            inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
            blocks.append(fnp.asarray(u @ inverse_sqrt, dtype=fnp.float32))
        half = blocks[0] if block_count == 1 else fnp.concatenate(blocks, axis=0)
        return fnp.concatenate([half, -half], axis=0)

    def _make_sample_blocks(self, width, k, seed):
        block_count = max(1, min(_PREDICT_BLOCKS, k // 2))
        block_k = (k // block_count) & ~1
        return [
            self._make_samples(width, block_k, seed + 9973 * block_index)
            for block_index in range(block_count)
        ]

    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        if (
            not hasattr(self, "_sample_blocks")
            or self._sample_blocks[0].shape[1] != width
            or getattr(self, "_depth", depth) != depth
        ):
            self._sample_blocks = self._make_sample_blocks(
                width, _sample_count(budget, width, depth), mlp.seed
            )
            self._depth = depth

        first_weight = mlp.weights[0]
        first_variance = fnp.sum(first_weight * first_weight, axis=0)
        first_mean = fnp.sqrt(first_variance) * _INV_SQRT_2PI
        if depth == 1:
            final_mean = first_mean
            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
            return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)
        target_variance = (
            first_variance
            * (0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI)
            * _FIRST_VARIANCE_FACTOR
        )
        final_mean = None
        total_samples = 0
        for samples in self._sample_blocks:
            x = fnp.maximum(samples @ first_weight, 0.0)
            sample_mean = fnp.mean(x, axis=0)
            sample_second = fnp.mean(x * x, axis=0)
            sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-6)
            x = (x - sample_mean) * fnp.sqrt(target_variance / sample_variance) + first_mean
            for layer_index, weight in enumerate(mlp.weights[1:-1], start=1):
                z = x @ weight
                x = fnp.maximum(z, 0.0)
                if (
                    (_HIDDEN_GAUSS_BLEND or _HIDDEN_GAUSS_BLEND_END)
                    and layer_index >= _HIDDEN_BLEND_START
                    and layer_index <= _HIDDEN_BLEND_STOP
                ):
                    x_mean = fnp.mean(x, axis=0)
                    z_mean = fnp.mean(z, axis=0)
                    z_second = fnp.mean(z * z, axis=0)
                    z_variance = fnp.maximum(z_second - z_mean * z_mean, 1e-8)
                    if _HIDDEN_BLEND_STOP > _HIDDEN_BLEND_START:
                        layer_fraction = float(layer_index - _HIDDEN_BLEND_START) / float(
                            _HIDDEN_BLEND_STOP - _HIDDEN_BLEND_START
                        )
                        if _HIDDEN_BLEND_POWER != 1:
                            layer_fraction = layer_fraction ** _HIDDEN_BLEND_POWER
                        blend = _HIDDEN_GAUSS_BLEND + (
                            _HIDDEN_GAUSS_BLEND_END - _HIDDEN_GAUSS_BLEND
                        ) * layer_fraction
                    else:
                        blend = _HIDDEN_GAUSS_BLEND
                    gaussian_mean, gaussian_second = _gaussian_relu_moments(z_mean, z_variance)

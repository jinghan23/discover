+        diag_mean = first_mean
+        diag_variance = target_variance
+        for weight in mlp.weights[1:]:
+            diag_z_mean = diag_mean @ weight
+            diag_z_variance = diag_variance @ (weight * weight)
+            diag_mean = _gaussian_relu_mean(diag_z_mean, diag_z_variance)
+            diag_second = _gaussian_relu_second(diag_z_mean, diag_z_variance)
+            diag_variance = fnp.maximum(diag_second - diag_mean * diag_mean, 1e-8)
+
         x = fnp.maximum(self._samples @ first_weight, 0.0)
         sample_mean = fnp.mean(x, axis=0)

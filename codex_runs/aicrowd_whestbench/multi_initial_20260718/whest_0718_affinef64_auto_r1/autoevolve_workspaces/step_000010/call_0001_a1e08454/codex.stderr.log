"""Whitened antithetic estimator with a tuned hidden mean correction."""

from __future__ import annotations

import os

import flopscope.numpy as fnp
from whestbench import BaseEstimator


def _env_float(name, default):
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        return float(value)
    except ValueError:
        return default


def _env_int(name, default):
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        return int(value)
    except ValueError:
        return default


_BUDGET_FRACTION = _env_float("WB_BUDGET_FRACTION", 0.1714)
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = _env_int("WB_SETUP_SEED_OFFSET", 3)
_FIRST_MEAN_BLEND = _env_float("WB_FIRST_MEAN_BLEND", 1.210)

_INV_SQRT_2PI = 0.3989422804014327
_CDF_POLY_P = 0.2316419
_CDF_POLY_B1 = 0.319381530
_CDF_POLY_B2 = -0.356563782
_CDF_POLY_B3 = 1.781477937
_CDF_POLY_B4 = -1.821255978
_CDF_POLY_B5 = 1.330274429

_HIDDEN_BLEND_FIRST = _env_float("WB_HIDDEN_BLEND_FIRST", -0.200)
_FIRST_HIDDEN_BLEND = _env_float("WB_FIRST_HIDDEN_BLEND", 0.200)
_PRE9_STOP_HIDDEN_BLEND = _env_float("WB_PRE9_STOP_HIDDEN_BLEND", 0.100)
_PRE8_STOP_HIDDEN_BLEND = _env_float("WB_PRE8_STOP_HIDDEN_BLEND", -0.300)
_PRE7_STOP_HIDDEN_BLEND = _env_float("WB_PRE7_STOP_HIDDEN_BLEND", 0.040)
_PRE6_STOP_HIDDEN_BLEND = _env_float("WB_PRE6_STOP_HIDDEN_BLEND", 0.020)
_PRE5_STOP_HIDDEN_BLEND = _env_float("WB_PRE5_STOP_HIDDEN_BLEND", 0.210)
_PRE4_STOP_HIDDEN_BLEND = _env_float("WB_PRE4_STOP_HIDDEN_BLEND", 0.300)
_PRE3_STOP_HIDDEN_BLEND = _env_float("WB_PRE3_STOP_HIDDEN_BLEND", 0.160)
_PRE2_STOP_HIDDEN_BLEND = _env_float("WB_PRE2_STOP_HIDDEN_BLEND", -0.280)
_PRE_STOP_HIDDEN_BLEND = _env_float("WB_PRE_STOP_HIDDEN_BLEND", 0.340)
_STOP_HIDDEN_BLEND = _env_float("WB_STOP_HIDDEN_BLEND", 0.370)
_POST_RAMP_BLEND = _env_float("WB_POST_RAMP_BLEND", 0.020)
_POST_RAMP2_BLEND = _env_float("WB_POST_RAMP2_BLEND", -0.080)
_HIDDEN_BLENDS = (
    0.0,
    _FIRST_HIDDEN_BLEND,
    _HIDDEN_BLEND_FIRST,
    _PRE9_STOP_HIDDEN_BLEND,
    _PRE8_STOP_HIDDEN_BLEND,
    _PRE7_STOP_HIDDEN_BLEND,
    _PRE6_STOP_HIDDEN_BLEND,
    _PRE5_STOP_HIDDEN_BLEND,
    _PRE4_STOP_HIDDEN_BLEND,
    _PRE3_STOP_HIDDEN_BLEND,
    _PRE2_STOP_HIDDEN_BLEND,
    _PRE_STOP_HIDDEN_BLEND,
    _STOP_HIDDEN_BLEND,
    _POST_RAMP_BLEND,
    _POST_RAMP2_BLEND,
)


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    return k - (k & 1)


def _gaussian_relu_mean(mean, variance):
    std = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = fnp.clip(mean / std, -8.0, 8.0)
    density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
    abs_alpha = fnp.abs(alpha)
    t = 1.0 / (1.0 + _CDF_POLY_P * abs_alpha)
    tail = density * (
        t
        * (
            _CDF_POLY_B1
            + t
            * (
                _CDF_POLY_B2
                + t
                * (_CDF_POLY_B3 + t * (_CDF_POLY_B4 + t * _CDF_POLY_B5))
            )
        )
    )
    cdf = fnp.where(alpha >= 0.0, 1.0 - tail, tail)
    return std * density + mean * cdf


class Estimator(BaseEstimator):
    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._samples = self._make_samples(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )



diff --git a/submission.py b/submission.py
index 545fdebb1765aefae60c05076f4a930d50bc1968..abfdec6f23eacb043025b615d0be189434b2911b
--- a/submission.py
+++ b/submission.py
@@ -12,7 +12,8 @@
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _WORST_CASE_ITEMSIZE = 8
 _SETUP_SEED_OFFSET = 3
-_FIRST_MEAN_BLEND = 1.240
+_USE_SAMPLE_FRACTION = 1.000
+_FIRST_MEAN_BLEND = 1.245
 
 _INV_SQRT_2PI = 0.3989422804014327
 _CDF_POLY_P = 0.2316419
@@ -24,13 +25,22 @@
 
 _HIDDEN_BLEND_START = 2
 _HIDDEN_BLEND_STOP = 12
-_HIDDEN_BLEND_FIRST = -0.150
-_HIDDEN_BLEND_LAST = 0.305
+_HIDDEN_BLEND_FIRST = -0.120
+_HIDDEN_BLEND_LAST = 0.265
 _HIDDEN_BLEND_STEP = (_HIDDEN_BLEND_LAST - _HIDDEN_BLEND_FIRST) / (
     _HIDDEN_BLEND_STOP - _HIDDEN_BLEND_START
 )
-_FIRST_HIDDEN_BLEND = 0.180
-_STOP_HIDDEN_BLEND = 0.360
+_FIRST_HIDDEN_BLEND = 0.200
+_PRE9_STOP_HIDDEN_BLEND = -0.060
+_PRE8_STOP_HIDDEN_BLEND = -0.180
+_PRE7_STOP_HIDDEN_BLEND = 0.020
+_PRE6_STOP_HIDDEN_BLEND = -0.020
+_PRE5_STOP_HIDDEN_BLEND = 0.120
+_PRE4_STOP_HIDDEN_BLEND = 0.180
+_PRE3_STOP_HIDDEN_BLEND = 0.340
+_PRE2_STOP_HIDDEN_BLEND = -0.120
+_PRE_STOP_HIDDEN_BLEND = 0.340
+_STOP_HIDDEN_BLEND = 0.390
 _POST_RAMP_BLEND = 0.020
 _POST_RAMP2_BLEND = -0.040
 
@@ -80,20 +90,22 @@
         rng = fnp.random.default_rng(seed)
         half_count = k // 2
         u = rng.standard_normal((half_count, width), dtype=fnp.float32)
-        raw_u = u
         u = u - fnp.mean(u, axis=0)
         covariance = (u.T @ u) / float(half_count)
         eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
         eigenvalues = fnp.maximum(eigenvalues, 1e-6)
         inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
         whitened = u @ inverse_sqrt
-        raw_radius = fnp.sum(raw_u * raw_u, axis=1)
+        raw_radius = fnp.sum(u * u, axis=1)
         white_radius = fnp.maximum(fnp.sum(whitened * whitened, axis=1), 1e-8)
         half = fnp.asarray(
             whitened * fnp.sqrt(raw_radius / white_radius)[:, None],
             dtype=fnp.float32,
         )
-        return fnp.concatenate([half, -half], axis=0)
+        return fnp.reshape(
+            fnp.stack([half, -half], axis=1),
+            (2 * half_count, width),
+        )
 
     def predict(self, mlp, budget):
         width = mlp.width
@@ -118,7 +130,13 @@
             return fnp.concatenate([zero_rows, first_mean[None, :]], axis=0)
 
         target_variance = first_variance * (0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI)
-        x = fnp.maximum(self._samples @ first_weight, 0.0)
+        samples = self._samples
+        if _USE_SAMPLE_FRACTION < 0.999:
+            use_count = int(samples.shape[0] * _USE_SAMPLE_FRACTION)
+            use_count = max(_MIN_SAMPLES, use_count - (use_count & 1))
+            samples = samples[:use_count]
+
+        x = fnp.maximum(samples @ first_weight, 0.0)
         sample_mean = fnp.mean(x, axis=0)
         sample_second = fnp.mean(x * x, axis=0)
         sample_variance = fnp.maximum(sample_second - sample_mean * sample_mean, 1e-6)
@@ -144,6 +162,24 @@
                 gaussian_mean = _gaussian_relu_mean(z_mean, z_variance)
                 if layer_index == 1:
                     blend = _FIRST_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 9:
+                    blend = _PRE9_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 8:
+                    blend = _PRE8_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 7:
+                    blend = _PRE7_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 6:
+                    blend = _PRE6_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 5:
+                    blend = _PRE5_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 4:
+                    blend = _PRE4_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 3:
+                    blend = _PRE3_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 2:
+                    blend = _PRE2_STOP_HIDDEN_BLEND
+                elif layer_index == _HIDDEN_BLEND_STOP - 1:
+                    blend = _PRE_STOP_HIDDEN_BLEND
                 elif layer_index == _HIDDEN_BLEND_STOP:
                     blend = _STOP_HIDDEN_BLEND
                 elif layer_index == _HIDDEN_BLEND_STOP + 1:


-        final_mean = sampled_mean + (gaussian_mean - sampled_mean) * _FINAL_BLEND
+        z_std = fnp.sqrt(z_variance)
+        z_centered = z - z_mean
+        z_third = fnp.mean(z_centered * z_centered * z_centered, axis=0)
+        z_fourth = fnp.mean(
+            z_centered * z_centered * z_centered * z_centered,
+            axis=0,
+        )
+        alpha = fnp.clip(z_mean / z_std, -8.0, 8.0)
+        density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+        skew = fnp.clip(z_third / fnp.maximum(z_variance * z_std, 1e-12), -2.0, 2.0)
+        excess = fnp.clip(z_fourth / fnp.maximum(z_variance * z_variance, 1e-12) - 3.0, -4.0, 4.0)
+        edge_mean = gaussian_mean + z_std * density * (
+            (-alpha * skew) * (1.0 / 6.0)
+            + ((alpha * alpha - 1.0) * excess) * (1.0 / 24.0)
+        )
+        final_mean = (
+            sampled_mean
+            + (gaussian_mean - sampled_mean) * _FINAL_BLEND
+            + (edge_mean - gaussian_mean) * _FINAL_EDGE_BLEND
+        )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


+def _gaussian_relu_moments(mean, variance):
+    variance = fnp.maximum(variance, 1e-12)
+    std = fnp.sqrt(variance)
+    alpha = fnp.clip(mean / std, -8.0, 8.0)
+    density = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    abs_alpha = fnp.abs(alpha)
+    t = 1.0 / (1.0 + _CDF_POLY_P * abs_alpha)
+    tail = density * (
+        t
+        * (
+            _CDF_POLY_B1
+            + t
+            * (
+                _CDF_POLY_B2
+                + t
+                * (_CDF_POLY_B3 + t * (_CDF_POLY_B4 + t * _CDF_POLY_B5))
+            )
+        )
+    )
+    cdf = fnp.where(alpha >= 0.0, 1.0 - tail, tail)
+    relu_mean = std * density + mean * cdf
+    relu_second = (mean * mean + variance) * cdf + mean * std * density
+    return relu_mean, fnp.maximum(relu_second - relu_mean * relu_mean, 1e-12)

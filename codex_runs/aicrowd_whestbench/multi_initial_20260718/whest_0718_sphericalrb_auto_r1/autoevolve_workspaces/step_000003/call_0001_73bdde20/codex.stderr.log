+def _exact_first_layer_second(weights: fnp.ndarray) -> fnp.ndarray:
+    covariance = weights.T @ weights
+    variance = fnp.sum(weights * weights, axis=0)
+    scale = fnp.sqrt(fnp.maximum(variance[:, None] * variance[None, :], 1e-24))
+    correlation = fnp.clip(covariance / scale, -1.0, 1.0)
+    arc = fnp.arccos(correlation)
+    kernel = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    kernel = kernel + (math.pi - arc) * correlation
+    return scale * (kernel / (2.0 * math.pi))
+
+
+def _match_first_layer_activation_moments(
+    activations: fnp.ndarray,
+    weights: fnp.ndarray,
+) -> fnp.ndarray:
+    exact_mean = _exact_first_layer_mean(weights)
+    exact_second = _exact_first_layer_second(weights)
+    exact_covariance = exact_second - exact_mean[:, None] * exact_mean[None, :]
+
+    sample_mean = fnp.mean(activations, axis=0)
+    centered = activations - sample_mean
+    sample_covariance = (centered.T @ centered) / float(activations.shape[0])
+
+    sample_values, sample_vectors = fnp.linalg.eigh(sample_covariance)
+    exact_values, exact_vectors = fnp.linalg.eigh(exact_covariance)
+    sample_values = fnp.maximum(sample_values, _WHITENING_EIGENVALUE_FLOOR)
+    exact_values = fnp.maximum(exact_values, _WHITENING_EIGENVALUE_FLOOR)
+
+    sample_whitener = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
+    exact_colorer = (exact_vectors * fnp.sqrt(exact_values)) @ exact_vectors.T
+    matched = centered @ (sample_whitener @ exact_colorer) + exact_mean
+    return activations + _FIRST_LAYER_MOMENT_MATCH_BLEND * (matched - activations)
+
+

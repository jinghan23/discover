from __future__ import annotations

import functools
import math

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_MAX_WORKING_SET_BYTES = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8
_MIN_ANTITHETIC_SAMPLES = 32
_TAIL_CLIP = 3.75e-9
_WHITENING_EIGENVALUE_FLOOR = 1e-8
_INV_SQRT_TWO_PI = 1.0 / math.sqrt(2.0 * math.pi)

_ANTITHETIC_HALF_COEFF = -0.04
_PAIR_HALF_COEFF = 0.23
_PAIR_THIRD_COEFF = 0.0
_PAIR_QUARTER_COEFF = -0.004
_PAIR_EIGHTH_COEFF = 0.037
_PAIR_SIXTEENTH_COEFF = -0.016
_PAIR_THIRTYSECOND_COEFF = 0.0115
_PAIR_THIRTYSECOND_SUFFIX_COEFF = 0.0
_PAIR_SIXTYFOURTH_COEFF = 0.017
_PAIR_SIXTYFOURTH_SUFFIX_COEFF = -0.004625
_PAIR_ONE28_COEFF = -0.015
_PAIR_ONE28_SUFFIX_COEFF = 0.0085
_PAIR_TWO56_COEFF = 0.0
_PAIR_TWO56_SUFFIX_COEFF = 0.0
_FINAL_GAUSSIAN_BLEND = -0.05
_DIAGONAL_GAUSSIAN_BLEND = 0.0
_FIRST_LAYER_MOMENT_MATCH_BLEND = 0.0


def whitened_antithetic_sample_count(
    budget: int,
    width: int,
    depth: int,
    target_fraction: float,
) -> int:
    half_lattice_per_sample = (89 * width + 3 * width + 2) // 2
    layer_per_sample = depth * (2 * width * width + 2 * width)
    covariance_per_sample = width * width
    per_sample = half_lattice_per_sample + layer_per_sample + covariance_per_sample
    fixed = 13 * width**3 + 8 * width
    budget_limited = (
        int(float(target_fraction) * budget) - fixed
    ) // max(per_sample, 1)
    memory_limited = _MAX_WORKING_SET_BYTES // max(
        width * _FLOAT64_ITEMSIZE,
        1,
    )
    count = int(
        max(
            _MIN_ANTITHETIC_SAMPLES,
            min(budget_limited, memory_limited),
        )
    )
    return count - (count & 1)


@functools.lru_cache(maxsize=None)
def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


@functools.lru_cache(maxsize=None)
def _mean_chi(dimension: int) -> float:
    half_dimension = 0.5 * float(dimension)
    return math.sqrt(2.0) * math.exp(
        math.lgamma(half_dimension + 0.5) - math.lgamma(half_dimension)
    )


def _lattice_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    generator = roots - fnp.floor(roots)
    shift = rng.random(width)
    indices = (fnp.arange(n_samples, dtype=fnp.float64) + 1.0)[:, None]
    unwrapped = indices * generator[None, :] + shift[None, :]
    uniforms = unwrapped - fnp.floor(unwrapped)
    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
    return flops.stats.norm.ppf(uniforms)


def _qmc_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
    normals = _lattice_normal_samples(n_samples, width, rng)
    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
    return normals / radii[:, None]


def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
    n_samples, width = directions.shape
    scaled_second_moment = (
        directions.T @ directions
    ) * (float(width) / float(n_samples))
    eigenvalues, eigenvectors = fnp.linalg.eigh(scaled_second_moment)
    eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
    return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T


def _exact_first_layer_mean(weights: fnp.ndarray) -> fnp.ndarray:
    standard_deviation = fnp.sqrt(fnp.sum(weights * weights, axis=0))
    return standard_deviation * _INV_SQRT_TWO_PI


def _exact_first_layer_second(weights: fnp.ndarray) -> fnp.ndarray:
    covariance = weights.T @ weights
    variance = fnp.sum(weights * weights, axis=0)
    scale = fnp.sqrt(fnp.maximum(variance[:, None] * variance[None, :], 1e-24))
    correlation = fnp.clip(covariance / scale, -1.0, 1.0)
    arc = fnp.arccos(correlation)
    kernel = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
    kernel = kernel + (math.pi - arc) * correlation
    return scale * (kernel / (2.0 * math.pi))


def _match_first_layer_activation_moments(
    activations: fnp.ndarray,
    weights: fnp.ndarray,
) -> fnp.ndarray:
    exact_mean = _exact_first_layer_mean(weights)
    exact_second = _exact_first_layer_second(weights)
    exact_covariance = exact_second - exact_mean[:, None] * exact_mean[None, :]

    sample_mean = fnp.mean(activations, axis=0)
    centered = activations - sample_mean
    sample_covariance = (centered.T @ centered) / float(activations.shape[0])

    sample_values, sample_vectors = fnp.linalg.eigh(sample_covariance)
    exact_values, exact_vectors = fnp.linalg.eigh(exact_covariance)
    sample_values = fnp.maximum(sample_values, _WHITENING_EIGENVALUE_FLOOR)
    exact_values = fnp.maximum(exact_values, _WHITENING_EIGENVALUE_FLOOR)

    sample_whitener = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
    exact_colorer = (exact_vectors * fnp.sqrt(exact_values)) @ exact_vectors.T
    matched = centered @ (sample_whitener @ exact_colorer) + exact_mean
    return activations + _FIRST_LAYER_MOMENT_MATCH_BLEND * (matched - activations)


def _relu_gaussian_mean(pre_mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = pre_mean / sigma
    return pre_mean * flops.stats.norm.cdf(alpha) + sigma * flops.stats.norm.pdf(
        alpha
    )


def _relu_gaussian_second(
    pre_mean: fnp.ndarray,
    variance: fnp.ndarray,
) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = pre_mean / sigma
    cdf = flops.stats.norm.cdf(alpha)
    pdf = flops.stats.norm.pdf(alpha)
    return (pre_mean * pre_mean + variance) * cdf + pre_mean * sigma * pdf


def _diagonal_gaussian_network_final_mean(weights) -> fnp.ndarray:
    pre_variance = fnp.sum(weights[0] * weights[0], axis=0)
    mean = pre_variance * 0.0 + fnp.sqrt(pre_variance) * _INV_SQRT_TWO_PI
    second = 0.5 * pre_variance
    variance = second - mean * mean

    for layer_weights in weights[1:]:
        pre_mean = mean @ layer_weights
        pre_variance = variance @ (layer_weights * layer_weights)
        mean = _relu_gaussian_mean(pre_mean, pre_variance)
        second = _relu_gaussian_second(pre_mean, pre_variance)
        variance = fnp.maximum(second - mean * mean, 1e-12)
    return mean


def _paired_prefix_mean(
    final_values: fnp.ndarray,
    half_count: int,
    divisor: int,
) -> fnp.ndarray:
    count = max(1, half_count // divisor)
    return 0.5 * (
        fnp.mean(final_values[:count], axis=0)
        + fnp.mean(final_values[half_count : half_count + count], axis=0)
    )


def _paired_suffix_mean(
    final_values: fnp.ndarray,
    half_count: int,
    divisor: int,
) -> fnp.ndarray:
    count = max(1, half_count // divisor)
    return 0.5 * (
        fnp.mean(final_values[half_count - count : half_count], axis=0)
        + fnp.mean(final_values[-count:], axis=0)
    )


class Estimator(BaseEstimator):
    target_flop_fraction = 0.10

    def predict(self, mlp, budget: int) -> fnp.ndarray:
        if mlp.depth == 1:
            first_row = _exact_first_layer_mean(mlp.weights[0])
            return fnp.asarray(first_row[None, :], dtype=fnp.float32)

        n_samples = whitened_antithetic_sample_count(
            budget,
            mlp.width,
            mlp.depth,
            self.target_flop_fraction,
        )
        half_count = n_samples // 2
        rng = fnp.random.default_rng(mlp.seed)
        half_directions = _qmc_directions(half_count, mlp.width, rng)
        whitening = _angular_whitening_transform(half_directions)

        first_weight = whitening @ mlp.weights[0]
        paired_directions = fnp.concatenate(
            (half_directions, -half_directions),
            axis=0,
        )
        activations = paired_directions * _mean_chi(mlp.width)

        rows = []
        activations = fnp.maximum(activations @ first_weight, 0.0)
        if _FIRST_LAYER_MOMENT_MATCH_BLEND != 0.0:
            activations = _match_first_layer_activation_moments(
                activations,
                mlp.weights[0],
            )
        rows.append(_exact_first_layer_mean(mlp.weights[0]))
        for weights in mlp.weights[1:-1]:
            activations = fnp.maximum(activations @ weights, 0.0)
            rows.append(fnp.mean(activations, axis=0))

        final_preactivations = activations @ mlp.weights[-1]
        final_values = fnp.maximum(final_preactivations, 0.0)
        final_sample = fnp.mean(final_values, axis=0)

        antithetic_half = fnp.mean(final_values[:half_count], axis=0)
        final_sample = final_sample + _ANTITHETIC_HALF_COEFF * (
            final_sample - antithetic_half
        )

        pair_half = _paired_prefix_mean(final_values, half_count, 2)
        pair_third = _paired_prefix_mean(final_values, half_count, 3)
        pair_quarter = _paired_prefix_mean(final_values, half_count, 4)
        pair_eighth = _paired_prefix_mean(final_values, half_count, 8)
        pair_sixteenth = _paired_prefix_mean(final_values, half_count, 16)
        pair_thirtysecond = _paired_prefix_mean(final_values, half_count, 32)
        pair_sixtyfourth = _paired_prefix_mean(final_values, half_count, 64)
        pair_one28 = _paired_prefix_mean(final_values, half_count, 128)
        pair_two56 = _paired_prefix_mean(final_values, half_count, 256)
        suffix_sixtyfourth = _paired_suffix_mean(final_values, half_count, 64)
        suffix_thirtysecond = _paired_suffix_mean(final_values, half_count, 32)
        suffix_one28 = _paired_suffix_mean(final_values, half_count, 128)
        suffix_two56 = _paired_suffix_mean(final_values, half_count, 256)

        final_sample = final_sample + _PAIR_HALF_COEFF * (
            final_sample - pair_half
        )
        final_sample = final_sample + _PAIR_THIRD_COEFF * (
            final_sample - pair_third
        )


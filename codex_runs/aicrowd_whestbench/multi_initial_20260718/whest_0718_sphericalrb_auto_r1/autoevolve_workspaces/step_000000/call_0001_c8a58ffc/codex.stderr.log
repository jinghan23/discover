+def _full_gaussian_means(mlp) -> list[fnp.ndarray]:
+    """Propagate a full second-moment Gaussian approximation."""
+
+    width = mlp.width
+    mean = fnp.zeros(width)
+    second_moment = fnp.eye(width)
+    rows = []
+    inv_sqrt_two_pi = 1.0 / math.sqrt(2.0 * math.pi)
+    for weights in mlp.weights:
+        pre_mean = weights.T @ mean
+        pre_second = weights.T @ second_moment @ weights
+        covariance = pre_second - pre_mean[:, None] * pre_mean[None, :]
+        variance = fnp.maximum(fnp.diag(covariance), 1e-12)
+        sigma = fnp.sqrt(variance)
+        alpha = pre_mean / sigma
+        density = flops.stats.norm.pdf(alpha)
+        probability = flops.stats.norm.cdf(alpha)
+        mean = pre_mean * probability + sigma * density
+
+        exact_diagonal = (
+            (pre_mean * pre_mean + variance) * probability
+            + pre_mean * sigma * density
+        )
+
+        normalizer = sigma[:, None] * sigma[None, :]
+        correlation = fnp.clip(
+            covariance / fnp.maximum(normalizer, 1e-12),
+            -1.0,
+            1.0,
+        )
+        root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        angle = fnp.arccos(correlation)
+        zero_mean_second = normalizer * (

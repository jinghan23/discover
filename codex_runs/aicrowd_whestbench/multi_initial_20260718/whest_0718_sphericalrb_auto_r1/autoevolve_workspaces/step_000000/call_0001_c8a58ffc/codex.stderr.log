+class _WhitenedAntitheticGaussianEstimator(BaseEstimator):
+    """Half-lattice antithetic Gaussian RQMC with covariance matching."""
+
+    target_flop_fraction = 0.10
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(mlp.seed)
+        half_normals = _lattice_normal_samples(half_samples, mlp.width, rng)
+        covariance = (half_normals.T @ half_normals) / float(half_samples)
+        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
+        eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
+        whitening = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
+        first_weight = whitening @ mlp.weights[0]
+        activations = fnp.concatenate((half_normals, -half_normals), axis=0)
+
+        rows = []
+        activations = fnp.maximum(activations @ first_weight, 0.0)
+        rows.append(_exact_first_layer_mean(mlp.weights[0]))
+        for weights in mlp.weights[1:]:
+            activations = fnp.maximum(activations @ weights, 0.0)
+            rows.append(fnp.mean(activations, axis=0))
+
+        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
+
+
+def _relu_gaussian_mean(pre_mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
+    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = pre_mean / sigma
+    return pre_mean * flops.stats.norm.cdf(alpha) + sigma * flops.stats.norm.pdf(
+        alpha
+    )
+
+
+class Estimator(_WhitenedAntitheticRaoBlackwellEstimator):
+    """RQMC hidden propagation with Gaussianized final-layer readout."""
+
+    target_flop_fraction = 0.10
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(mlp.seed)
+        half_directions = _qmc_directions(half_samples, mlp.width, rng)
+        whitening = _angular_whitening_transform(half_directions)
+        first_weight = whitening @ mlp.weights[0]
+        paired_directions = fnp.concatenate(
+            (half_directions, -half_directions),
+            axis=0,
+        )
+        activations = paired_directions * _mean_chi(mlp.width)
+
+        rows = []
+        activations = fnp.maximum(activations @ first_weight, 0.0)
+        rows.append(_exact_first_layer_mean(mlp.weights[0]))
+        for weights in mlp.weights[1:-1]:
+            activations = fnp.maximum(activations @ weights, 0.0)
+            rows.append(fnp.mean(activations, axis=0))
+
+        final_preactivations = activations @ mlp.weights[-1]
+        final_values = fnp.maximum(final_preactivations, 0.0)
+        final_sample = fnp.mean(final_values, axis=0)
+        if _FINAL_SUBSET_EXTRAPOLATION != 0.0:
+            coarse_count = n_samples // 2
+            coarse_sample = fnp.mean(final_values[:coarse_count], axis=0)
+            final_sample = final_sample + _FINAL_SUBSET_EXTRAPOLATION * (
+                final_sample - coarse_sample
+            )
+        if _FINAL_PAIR_SUBSET_EXTRAPOLATION != 0.0:
+            quarter_samples = n_samples // 4
+            half_count = n_samples // 2
+            paired_coarse = 0.5 * (
+                fnp.mean(final_values[:quarter_samples], axis=0)
+                + fnp.mean(
+                    final_values[half_count : half_count + quarter_samples],
+                    axis=0,
+                )
+            )
+            final_sample = final_sample + _FINAL_PAIR_SUBSET_EXTRAPOLATION * (
+                final_sample - paired_coarse
+            )
+        final_mean = fnp.mean(final_preactivations, axis=0)
+        final_second = fnp.mean(final_preactivations * final_preactivations, axis=0)
+        final_gaussian = _relu_gaussian_mean(
+            final_mean,
+            final_second - final_mean * final_mean,
+        )
+        rows.append(
+            final_sample
+            + _FINAL_GAUSSIAN_BLEND * (final_gaussian - final_sample)
+        )
+
+        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)


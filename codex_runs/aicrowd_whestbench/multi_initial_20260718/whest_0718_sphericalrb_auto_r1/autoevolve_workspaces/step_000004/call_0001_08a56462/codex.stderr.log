from __future__ import annotations

import functools
import math

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_MAX_WORKING_SET_BYTES = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8
_MIN_ANTITHETIC_SAMPLES = 32
_TAIL_CLIP = 3.75e-9
_WHITENING_EIGENVALUE_FLOOR = 1e-8
_INV_SQRT_TWO_PI = 1.0 / math.sqrt(2.0 * math.pi)

_ANTITHETIC_HALF_COEFF = -0.04
_PAIR_HALF_COEFF = 0.225
_PAIR_QUARTER_COEFF = 0.0
_PAIR_EIGHTH_COEFF = 0.037
_PAIR_SIXTEENTH_COEFF = -0.016
_PAIR_THIRTYSECOND_COEFF = 0.017
_PAIR_SIXTYFOURTH_COEFF = 0.017
_PAIR_SIXTYFOURTH_SUFFIX_COEFF = -0.004625
_PAIR_ONE28_COEFF = -0.0125
_PAIR_ONE28_SUFFIX_COEFF = 0.00625
_FINAL_GAUSSIAN_BLEND = -0.075


def whitened_antithetic_sample_count(
    budget: int,
    width: int,
    depth: int,
    target_fraction: float,
) -> int:
    half_lattice_per_sample = (89 * width + 3 * width + 2) // 2
    layer_per_sample = depth * (2 * width * width + 2 * width)
    covariance_per_sample = width * width
    per_sample = half_lattice_per_sample + layer_per_sample + covariance_per_sample
    fixed = 13 * width**3 + 8 * width
    budget_limited = (
        int(float(target_fraction) * budget) - fixed
    ) // max(per_sample, 1)
    memory_limited = _MAX_WORKING_SET_BYTES // max(
        width * _FLOAT64_ITEMSIZE,
        1,
    )
    count = int(
        max(
            _MIN_ANTITHETIC_SAMPLES,
            min(budget_limited, memory_limited),
        )
    )
    return count - (count & 1)


@functools.lru_cache(maxsize=None)
def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


@functools.lru_cache(maxsize=None)
def _mean_chi(dimension: int) -> float:
    half_dimension = 0.5 * float(dimension)
    return math.sqrt(2.0) * math.exp(
        math.lgamma(half_dimension + 0.5) - math.lgamma(half_dimension)


from __future__ import annotations

import functools
import math

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_MAX_WORKING_SET_BYTES = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8
_MIN_ANTITHETIC_SAMPLES = 32
_TAIL_CLIP = 3.75e-9
_WHITENING_EIGENVALUE_FLOOR = 1e-8
_INV_SQRT_TWO_PI = 1.0 / math.sqrt(2.0 * math.pi)

_ANTITHETIC_HALF_COEFF = -0.04
_PAIR_HALF_COEFF = 0.225
_PAIR_QUARTER_COEFF = 0.014
_PAIR_EIGHTH_COEFF = 0.037
_PAIR_SIXTEENTH_COEFF = -0.016
_PAIR_THIRTYSECOND_COEFF = 0.0115
_PAIR_SIXTYFOURTH_COEFF = 0.017
_PAIR_SIXTYFOURTH_SUFFIX_COEFF = -0.004625
_PAIR_ONE28_COEFF = -0.0125
_PAIR_ONE28_SUFFIX_COEFF = 0.00625
_FINAL_GAUSSIAN_BLEND = -0.075
_DIAGONAL_GAUSSIAN_BLEND = 0.0
_FIRST_MEAN_SCALE_BLEND = 0.0
_FINAL_EDGEWORTH_BLEND = 0.0
_USE_RANDOM_DIRECTIONS = False
_FIXED_LATTICE_SHIFT = None
_RANDOM_INPUT_SIGNS = False
_RNG_SEED_OFFSET = 0


def whitened_antithetic_sample_count(
    budget: int,
    width: int,
    depth: int,
    target_fraction: float,
) -> int:
    half_lattice_per_sample = (89 * width + 3 * width + 2) // 2
    layer_per_sample = depth * (2 * width * width + 2 * width)
    covariance_per_sample = width * width
    per_sample = half_lattice_per_sample + layer_per_sample + covariance_per_sample
    fixed = 13 * width**3 + 8 * width
    budget_limited = (
        int(float(target_fraction) * budget) - fixed
    ) // max(per_sample, 1)
    memory_limited = _MAX_WORKING_SET_BYTES // max(
        width * _FLOAT64_ITEMSIZE,
        1,
    )
    count = int(
        max(
            _MIN_ANTITHETIC_SAMPLES,
            min(budget_limited, memory_limited),
        )
    )
    return count - (count & 1)


@functools.lru_cache(maxsize=None)
def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


@functools.lru_cache(maxsize=None)
def _mean_chi(dimension: int) -> float:
    half_dimension = 0.5 * float(dimension)
    return math.sqrt(2.0) * math.exp(
        math.lgamma(half_dimension + 0.5) - math.lgamma(half_dimension)
    )


def _lattice_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    generator = roots - fnp.floor(roots)
    if _FIXED_LATTICE_SHIFT == "generator":
        shift = generator
    elif _FIXED_LATTICE_SHIFT is None:
        shift = rng.random(width)
    else:
        shift = fnp.full(width, _FIXED_LATTICE_SHIFT, dtype=fnp.float64)
    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    unwrapped = indices * generator[None, :] + shift[None, :]
    uniforms = unwrapped - fnp.floor(unwrapped)
    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
    return flops.stats.norm.ppf(uniforms)


def _qmc_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
    if _USE_RANDOM_DIRECTIONS:
        normals = rng.standard_normal((n_samples, width))
    else:
        normals = _lattice_normal_samples(n_samples, width, rng)
    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
    return normals / radii[:, None]


def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
    n_samples, width = directions.shape
    scaled_second_moment = (
        directions.T @ directions
    ) * (float(width) / float(n_samples))
    eigenvalues, eigenvectors = fnp.linalg.eigh(scaled_second_moment)
    eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
    return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T


def _exact_first_layer_mean(weights: fnp.ndarray) -> fnp.ndarray:
    standard_deviation = fnp.sqrt(fnp.sum(weights * weights, axis=0))
    return standard_deviation * _INV_SQRT_TWO_PI


def _relu_gaussian_mean(pre_mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = pre_mean / sigma
    return pre_mean * flops.stats.norm.cdf(alpha) + sigma * flops.stats.norm.pdf(
        alpha
    )


def _relu_gaussian_second(pre_mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
    alpha = pre_mean / sigma
    cdf = flops.stats.norm.cdf(alpha)
    pdf = flops.stats.norm.pdf(alpha)
    return (pre_mean * pre_mean + variance) * cdf + pre_mean * sigma * pdf


def _diagonal_gaussian_final_mean(mlp) -> fnp.ndarray:
    first_variance = fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0)
    activation_mean = first_variance * 0.0 + fnp.sqrt(first_variance) * _INV_SQRT_TWO_PI
    activation_second = 0.5 * first_variance
    activation_variance = activation_second - activation_mean * activation_mean

    for weights in mlp.weights[1:]:
        pre_mean = activation_mean @ weights
        pre_variance = activation_variance @ (weights * weights)
        activation_mean = _relu_gaussian_mean(pre_mean, pre_variance)
        activation_second = _relu_gaussian_second(pre_mean, pre_variance)
        activation_variance = activation_second - activation_mean * activation_mean

    return activation_mean


def _final_edgeworth_mean(
    final_preactivations: fnp.ndarray,
    pre_mean: fnp.ndarray,
    variance: fnp.ndarray,
    gaussian_mean: fnp.ndarray,
) -> fnp.ndarray:
    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
    centered = final_preactivations - pre_mean[None, :]
    inverse_sigma = 1.0 / sigma
    z3 = fnp.mean(centered * centered * centered, axis=0) * (
        inverse_sigma * inverse_sigma * inverse_sigma
    )
    centered2 = centered * centered
    z4_excess = fnp.mean(centered2 * centered2, axis=0) * (
        inverse_sigma * inverse_sigma * inverse_sigma * inverse_sigma
    ) - 3.0
    alpha = pre_mean * inverse_sigma
    pdf = flops.stats.norm.pdf(alpha)
    alpha2 = alpha * alpha
    correction = sigma * pdf * (
        (-alpha) * (z3 / 6.0)
        + (alpha2 - 1.0) * (z4_excess / 24.0)
        + (alpha2 * alpha2 - 6.0 * alpha2 + 3.0) * ((z3 * z3) / 72.0)
    )
    return gaussian_mean + correction


def _paired_prefix_mean(
    final_values: fnp.ndarray,
    half_count: int,
    divisor: int,
) -> fnp.ndarray:
    count = max(1, half_count // divisor)
    return 0.5 * (
        fnp.mean(final_values[:count], axis=0)
        + fnp.mean(final_values[half_count : half_count + count], axis=0)
    )


def _paired_suffix_mean(
    final_values: fnp.ndarray,
    half_count: int,
    divisor: int,
) -> fnp.ndarray:
    count = max(1, half_count // divisor)
    return 0.5 * (
        fnp.mean(final_values[half_count - count : half_count], axis=0)
        + fnp.mean(final_values[-count:], axis=0)
    )


class Estimator(BaseEstimator):
    target_flop_fraction = 0.10

    def predict(self, mlp, budget: int) -> fnp.ndarray:
        if mlp.depth == 1:
            first_row = _exact_first_layer_mean(mlp.weights[0])
            return fnp.asarray(first_row[None, :], dtype=fnp.float32)

        n_samples = whitened_antithetic_sample_count(
            budget,
            mlp.width,
            mlp.depth,
            self.target_flop_fraction,
        )
        half_count = n_samples // 2
        rng = fnp.random.default_rng(mlp.seed + _RNG_SEED_OFFSET)
        half_directions = _qmc_directions(half_count, mlp.width, rng)
        whitening = _angular_whitening_transform(half_directions)

        if _RANDOM_INPUT_SIGNS:
            signs = 1.0 - 2.0 * (rng.random(mlp.width) < 0.5)
            first_weight = whitening @ (mlp.weights[0] * signs[:, None])
        else:
            first_weight = whitening @ mlp.weights[0]
        paired_directions = fnp.concatenate(
            (half_directions, -half_directions),
            axis=0,
        )
        activations = paired_directions * _mean_chi(mlp.width)

        rows = []
        activations = fnp.maximum(activations @ first_weight, 0.0)
        first_row = _exact_first_layer_mean(mlp.weights[0])
        if _FIRST_MEAN_SCALE_BLEND != 0.0:
            first_sample_mean = fnp.maximum(fnp.mean(activations, axis=0), 1e-12)
            first_scale = first_row / first_sample_mean
            activations = activations * (
                1.0 + _FIRST_MEAN_SCALE_BLEND * (first_scale - 1.0)
            )
        rows.append(first_row)
        for weights in mlp.weights[1:-1]:
            activations = fnp.maximum(activations @ weights, 0.0)
            rows.append(fnp.mean(activations, axis=0))

        final_preactivations = activations @ mlp.weights[-1]
        final_values = fnp.maximum(final_preactivations, 0.0)
        final_sample = fnp.mean(final_values, axis=0)


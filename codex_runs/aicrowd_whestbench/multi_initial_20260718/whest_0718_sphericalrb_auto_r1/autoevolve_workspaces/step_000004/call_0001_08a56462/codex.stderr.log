diff --git a/submission.py b/submission.py
index 198019ee6c3bd31307e5ae414b554584cc17ef4c..dede948b800feb9be2e2764a77d1e9933314f9c5
--- a/submission.py
+++ b/submission.py
@@ -26,6 +26,7 @@
 _PAIR_ONE28_COEFF = -0.0125
 _PAIR_ONE28_SUFFIX_COEFF = 0.00625
 _FINAL_GAUSSIAN_BLEND = -0.075
+_DIAGONAL_GAUSSIAN_BLEND = 0.0
 
 
 def whitened_antithetic_sample_count(
@@ -121,6 +122,30 @@
     )
 
 
+def _relu_gaussian_second(pre_mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
+    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = pre_mean / sigma
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    return (pre_mean * pre_mean + variance) * cdf + pre_mean * sigma * pdf
+
+
+def _diagonal_gaussian_final_mean(mlp) -> fnp.ndarray:
+    first_variance = fnp.sum(mlp.weights[0] * mlp.weights[0], axis=0)
+    activation_mean = first_variance * 0.0 + fnp.sqrt(first_variance) * _INV_SQRT_TWO_PI
+    activation_second = 0.5 * first_variance
+    activation_variance = activation_second - activation_mean * activation_mean
+
+    for weights in mlp.weights[1:]:
+        pre_mean = activation_mean @ weights
+        pre_variance = activation_variance @ (weights * weights)
+        activation_mean = _relu_gaussian_mean(pre_mean, pre_variance)
+        activation_second = _relu_gaussian_second(pre_mean, pre_variance)

+def _relu_gaussian_second(
+    pre_mean: fnp.ndarray,
+    variance: fnp.ndarray,
+) -> fnp.ndarray:
+    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = pre_mean / sigma
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    return (pre_mean * pre_mean + variance) * cdf + pre_mean * sigma * pdf
+
+
+def _diagonal_gaussian_final_mean(weights: list[fnp.ndarray]) -> fnp.ndarray:
+    first_variance = fnp.sum(weights[0] * weights[0], axis=0)
+    mean = first_variance * 0.0 + fnp.sqrt(first_variance) * _INV_SQRT_TWO_PI
+    second = 0.5 * first_variance
+    for layer_weights in weights[1:]:
+        centered_second = second - mean * mean
+        pre_mean = mean @ layer_weights
+        pre_variance = centered_second @ (layer_weights * layer_weights)
+        mean = _relu_gaussian_mean(pre_mean, pre_variance)
+        second = _relu_gaussian_second(pre_mean, pre_variance)
+    return mean
+
+

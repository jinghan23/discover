             final_gaussian - final_sample
         )
+        final_estimate = final_estimate * _radial_correction(mlp.width, mlp.depth)
         rows.append(final_estimate)
 
         return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)


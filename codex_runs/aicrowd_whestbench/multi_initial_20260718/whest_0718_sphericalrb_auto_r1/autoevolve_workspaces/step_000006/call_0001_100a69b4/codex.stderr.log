     )
 
 
+@functools.lru_cache(maxsize=None)
+def _radial_correction(dimension: int, degree: int) -> float:
+    half_dimension = 0.5 * float(dimension)
+    log_moment = 0.5 * float(degree) * math.log(2.0) + math.lgamma(
+        half_dimension + 0.5 * float(degree)
+    ) - math.lgamma(half_dimension)
+    return math.exp(log_moment - float(degree) * math.log(_mean_chi(dimension)))
+
+
 def _lattice_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
     roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
     generator = roots - fnp.floor(roots)
@@ -219,6 +228,7 @@

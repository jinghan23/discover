@@ -131,6 +132,25 @@
     )
 
 
+def _diagonal_propagation_final(mlp) -> fnp.ndarray:
+    mean = fnp.zeros(mlp.width)
+    variance = fnp.ones(mlp.width)
+    for weights in mlp.weights:
+        pre_mean = weights.T @ mean
+        pre_variance = (weights * weights).T @ variance
+        sigma = fnp.sqrt(fnp.maximum(pre_variance, 1e-12))
+        alpha = pre_mean / sigma
+        density = flops.stats.norm.pdf(alpha)
+        distribution = flops.stats.norm.cdf(alpha)
+        mean = pre_mean * distribution + sigma * density
+        second = (
+            (pre_mean * pre_mean + pre_variance) * distribution
+            + pre_mean * sigma * density
+        )
+        variance = fnp.maximum(second - mean * mean, 0.0)
+    return mean

                "setup",
                RunnerErrorDetail(
                    code="SETUP_ERROR",
                    message=str(response.get("error_message", "worker setup failed")),
                    traceback=response.get("traceback"),
                ),
            )
        self._started = True

    def last_predict_stats(self) -> Optional[PredictStats]:
        return self._last_predict_stats


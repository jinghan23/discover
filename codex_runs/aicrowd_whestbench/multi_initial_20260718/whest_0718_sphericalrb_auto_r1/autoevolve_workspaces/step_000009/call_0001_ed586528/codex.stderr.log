class EstimatorRunner(Protocol):
    def start(
        self,
        entrypoint: EstimatorEntrypoint,
        context: SetupContext,
        limits: ResourceLimits,
    ) -> None: ...

    def predict(self, mlp: MLP, budget: int) -> fnp.ndarray: ...

    def close(self) -> None: ...


def _mlp_to_payload(mlp: MLP) -> Dict[str, Any]:
    return {

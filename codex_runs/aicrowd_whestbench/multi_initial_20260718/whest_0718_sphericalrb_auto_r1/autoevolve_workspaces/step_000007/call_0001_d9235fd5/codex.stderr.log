+) -> fnp.ndarray:
+    n_samples = first_activations.shape[0]
+    first_mean = fnp.mean(first_activations, axis=0)
+    final_mean = fnp.mean(final_values, axis=0)
+    first_centered = first_activations - first_mean[None, :]
+    final_centered = final_values - final_mean[None, :]
+    covariance = (first_centered.T @ first_centered) / float(n_samples)
+    cross = (first_centered.T @ final_centered) / float(n_samples)
+    ridge = _FIRST_CONTROL_RIDGE * fnp.mean(fnp.diag(covariance))
+    beta = fnp.linalg.solve(
+        covariance + ridge * fnp.eye(exact_first_mean.shape[0], dtype=fnp.float64),
+        cross,
+    )
+    return (exact_first_mean - first_mean) @ beta
+
+
+def _scalar_first_layer_control_correction(
+    first_activations: fnp.ndarray,
+    final_values: fnp.ndarray,
+    exact_first_mean: fnp.ndarray,
+) -> fnp.ndarray:
+    first_total = fnp.sum(first_activations, axis=1)
+    control_mean = fnp.mean(first_total)
+    final_mean = fnp.mean(final_values, axis=0)
+    control_centered = first_total - control_mean
+    variance = fnp.maximum(fnp.mean(control_centered * control_centered), 1e-12)
+    covariance = fnp.mean(
+        control_centered[:, None] * (final_values - final_mean[None, :]),
+        axis=0,
+    )
+    exact_total = fnp.sum(exact_first_mean)
+    return (exact_total - control_mean) * covariance / variance
+

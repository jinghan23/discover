+def _relu_gaussian_marginal_moments(
+    pre_mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray, fnp.ndarray]:
+    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = pre_mean / sigma
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    mean = pre_mean * cdf + sigma * pdf
+    second = (pre_mean * pre_mean + variance) * cdf + pre_mean * sigma * pdf
+    relu_variance = fnp.maximum(second - mean * mean, 1e-12)
+    return mean, second, relu_variance
+
+
+def _gaussian_copula_relu_second(
+    pre_mean: fnp.ndarray, covariance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(fnp.diag(covariance), 1e-12)
+    mean, marginal_second, relu_variance = _relu_gaussian_marginal_moments(
+        pre_mean, variance
+    )
+    sigma = fnp.sqrt(variance)
+    rho = covariance / fnp.maximum(sigma[:, None] * sigma[None, :], 1e-12)
+    rho = fnp.clip(rho, -0.999999, 0.999999)
+    zero_second = (
+        fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
+        + (math.pi - fnp.arccos(rho)) * rho
+    ) * _INV_TWO_PI
+    zero_corr = (zero_second - _INV_TWO_PI) / (0.5 - _INV_TWO_PI)
+    zero_corr = fnp.clip(zero_corr, -0.999999, 0.999999)
+    second = mean[:, None] * mean[None, :] + zero_corr * fnp.sqrt(
+        relu_variance[:, None] * relu_variance[None, :]
+    )
+    eye = fnp.eye(pre_mean.shape[0], dtype=fnp.float64)
+    second = second * (1.0 - eye) + marginal_second[:, None] * eye
+    return mean, second
+

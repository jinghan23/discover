+def _relu_gaussian_second_moment(
+    pre_mean: fnp.ndarray,
+    variance: fnp.ndarray,
+) -> fnp.ndarray:
+    sigma = fnp.sqrt(fnp.maximum(variance, 1e-12))
+    alpha = pre_mean / sigma
+    return (pre_mean * pre_mean + variance) * flops.stats.norm.cdf(
+        alpha
+    ) + pre_mean * sigma * flops.stats.norm.pdf(alpha)
+

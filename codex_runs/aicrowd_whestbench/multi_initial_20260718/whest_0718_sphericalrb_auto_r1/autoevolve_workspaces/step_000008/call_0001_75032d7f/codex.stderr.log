+    for weights in mlp.weights:
+        weights64 = fnp.asarray(weights, dtype=fnp.float64)
+        pre_mean = mean @ weights64
+        centered_second = fnp.maximum(second - mean * mean, 0.0)
+        variance = centered_second @ (weights64 * weights64)
+        mean = _relu_gaussian_mean(pre_mean, variance)
+        second = _relu_gaussian_second_moment(pre_mean, variance)

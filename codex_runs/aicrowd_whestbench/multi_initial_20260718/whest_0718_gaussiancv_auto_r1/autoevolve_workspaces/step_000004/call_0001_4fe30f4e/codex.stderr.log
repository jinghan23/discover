diff --git a/submission.py b/submission.py
index d0f0f77ae6045f7ae1518ad75e5e03777032af18..a5226ef68766e256318bdfff38bb60637584a31f
--- a/submission.py
+++ b/submission.py
@@ -108,6 +108,7 @@
         z_center = z64 - z_mean
         z_var = fnp.mean(z_center * z_center, axis=0)
         z_sigma = fnp.sqrt(fnp.maximum(z_var, 1e-12))
+        z_m4 = fnp.mean(z_center * z_center * z_center * z_center, axis=0)
 
         z_alpha = z_mean / z_sigma
         z_cdf = flops.stats.norm.cdf(z_alpha)
@@ -121,11 +122,20 @@
         )
 
         final_mc = fnp.sum(fnp.maximum(z64, 0.0), axis=0) / float(n_samples)
+        z_excess = z_m4 / fnp.maximum(z_var * z_var, 1e-24) - 3.0
+        final_edge4 = (
+            z_excess
+            * z_sigma
+            * (z_alpha * z_alpha - 1.0)
+            * z_phi
+            / 24.0
+        )
         final = 0.99965 * (
             1.03700 * final_mc
             - 0.0425 * final_gauss
             + 0.00400 * final_mixed_diag
             + 0.00150 * diag_rows[-1]
+            + 0.01000 * final_edge4
         )
 
         return fnp.asarray(fnp.stack(list(diag_rows[:-1]) + [final], axis=0), dtype=fnp.float32)


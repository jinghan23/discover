+        eye = fnp.eye(width, dtype=fnp.float64)
+        c_mu = fnp.zeros(width)
+        c_cov = eye
+        cov_rows = []
+        for layer_i, w in enumerate(mlp.weights):
+            c_mu_pre = w.T @ c_mu
+            c_cov_pre = w.T @ (c_cov @ w)
+            c_var_pre = fnp.maximum(fnp.diagonal(c_cov_pre), 1e-12)
+            c_sigma = fnp.sqrt(c_var_pre)
+            c_alpha = c_mu_pre / c_sigma
+            c_phi = flops.stats.norm.pdf(c_alpha)
+            c_cdf = flops.stats.norm.cdf(c_alpha)
+            c_mu = c_mu_pre * c_cdf + c_sigma * c_phi
+            c_ez2 = (c_mu_pre * c_mu_pre + c_var_pre) * c_cdf + c_mu_pre * c_sigma * c_phi
+            c_var = fnp.maximum(c_ez2 - c_mu * c_mu, 0.0)
+            cov_rows.append(c_mu)
+            if layer_i != depth - 1:
+                c_scale = fnp.maximum(c_sigma[:, None] * c_sigma[None, :], 1e-12)
+                c_rho = fnp.clip(c_cov_pre / c_scale, -0.95, 0.95)
+                c_h2 = c_phi
+                c_h3 = c_alpha * c_phi
+                c_h4 = (c_alpha * c_alpha - 1.0) * c_phi
+                c_corr = (
+                    c_rho * (c_cdf[:, None] * c_cdf[None, :])
+                    + 0.5 * (c_rho * c_rho) * (c_h2[:, None] * c_h2[None, :])
+                    + (c_rho * c_rho * c_rho / 6.0) * (c_h3[:, None] * c_h3[None, :])
+                    + ((c_rho * c_rho) * (c_rho * c_rho) / 24.0) * (c_h4[:, None] * c_h4[None, :])
+                )
+                c_cov = c_scale * c_corr
+                c_cov = 0.5 * (c_cov + c_cov.T)
+                c_cov = c_cov * (1.0 - eye) + eye * c_var[None, :]

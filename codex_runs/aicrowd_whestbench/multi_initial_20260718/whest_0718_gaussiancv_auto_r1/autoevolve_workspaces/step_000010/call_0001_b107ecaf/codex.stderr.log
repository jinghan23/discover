            pi=3.141592653589793; kernel0=(root0+(pi-fnp.arccos(rho0))*rho0)/(2.0*pi); target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]; target_cov=0.5*(target_cov+target_cov.T); target_cov=target_cov*(1.0-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=fnp.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(fnp.diag(1.0/fnp.sqrt(fnp.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(fnp.diag(fnp.sqrt(fnp.maximum(t_vals,1e-12)))@t_vecs.T)

 y=c/s; t=-a; J=[None]*8; J[0]=ndtr(a); J[1]=phi
 for k in range(2,8): J[k]=(t**(k-1))*phi+(k-1)*J[k-2]
 K3=a*(J[3]-3*J[1])+(J[4]-3*J[2]); K4=a*(J[4]-6*J[2]+3*J[0])+(J[5]-6*J[3]+3*J[1]); K6=a*(J[6]-15*J[4]+45*J[2]-15*J[0])+(J[7]-15*J[5]+45*J[3]-15*J[1])
 g1=np.mean(y*y*y,0); g2=np.mean(y*y*y*y,0)-3; corr=s*(g1/6*K3+g2/24*K4+(g1*g1)/72*K6)
 return base,corr

def true_final(weights,seed,N,b=10000):

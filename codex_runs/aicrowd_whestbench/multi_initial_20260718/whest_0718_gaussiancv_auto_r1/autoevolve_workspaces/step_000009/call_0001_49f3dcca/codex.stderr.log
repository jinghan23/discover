import numpy as np
from scipy.special import ndtr

rng_global=np.random.default_rng(123)

def diag_rows(weights):
    width=weights[0].shape[0]
    d_mu=np.zeros(width,dtype=np.float64)
    d_var=np.ones(width,dtype=np.float64)
    mus=[]; vars=[]; pre_mu=None; pre_var=None
    phi_const=1/np.sqrt(2*np.pi)
    for w in weights:
        pre_mu=w.T@d_mu
        pre_var=(w*w).T@d_var
        pre_var=np.maximum(pre_var,1e-12)
        sig=np.sqrt(pre_var); a=pre_mu/sig
        phi=np.exp(-0.5*a*a)*phi_const; cdf=ndtr(a)
        d_mu=pre_mu*cdf+sig*phi
        ez2=(pre_mu*pre_mu+pre_var)*cdf+pre_mu*sig*phi
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        mus.append(d_mu); vars.append(d_var)
    return mus,vars,pre_mu,pre_var

def current_pred(weights, seed, n_samples=4096, params=None):
    if params is None: params={}
    cscale=params.get('scale',0.99965)
    cmc=params.get('mc',1.03700)
    cgauss=params.get('gauss',-0.0425)
    cmix=params.get('mix',0.00400)
    cdiag=params.get('diag',0.00150)
    meanmatch=params.get('meanmatch',-0.245)
    fullc=params.get('fullc',1.455)
    centerc=params.get('centerc',-0.455)
    width=weights[0].shape[0]
    depth=len(weights)
    mus,vars,pre_mu,pre_var=diag_rows(weights)
    if depth==1: return np.stack(mus)
    rng=np.random.default_rng(seed+2)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float64)
    x=np.concatenate([x0,-x0],0)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(0)
            sample_cov=(z_center.T@z_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(0); x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            pi=np.pi
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-mus[0][:,None]*mus[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+mus[0]
            x=mus[0]+meanmatch*(x_mean0-mus[0])+fullc*(x_full-mus[0])+centerc*x_center
    z=x@weights[-1]
    z_mean=z.mean(0); z_center=z-z_mean; z_var=np.mean(z_center*z_center,0); z_sigma=np.sqrt(np.maximum(z_var,1e-12))
    a=z_mean/z_sigma; phi=np.exp(-.5*a*a)/np.sqrt(2*np.pi); cdf=ndtr(a); final_gauss=z_mean*cdf+z_sigma*phi
    amd=pre_mu/z_sigma; final_mixed=pre_mu*ndtr(amd)+z_sigma*np.exp(-.5*amd*amd)/np.sqrt(2*np.pi)
    final_mc=np.maximum(z,0).mean(0)
    final=cscale*(cmc*final_mc+cgauss*final_gauss+cmix*final_mixed+cdiag*mus[-1])
    return np.stack(mus[:-1]+[final])

def true_means(weights, seed, N=200000, batch=20000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed+999)

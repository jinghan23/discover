        z_k3 = z_alpha_e * (z_j3 - 3.0 * z_j1) + (z_j4 - 3.0 * z_j2)
        z_k4 = (
            z_alpha_e * (z_j4 - 6.0 * z_j2 + 3.0 * z_j0)
            + (z_j5 - 6.0 * z_j3 + 3.0 * z_j1)
        )
        z_k6 = (
            z_alpha_e * (z_j6 - 15.0 * z_j4 + 45.0 * z_j2 - 15.0 * z_j0)
            + (z_j7 - 15.0 * z_j5 + 45.0 * z_j3 - 15.0 * z_j1)
        )
        final_edge = z_sigma * (
            (z_skew / 6.0) * z_k3
            + (z_excess / 24.0) * z_k4
            + ((z_skew * z_skew) / 72.0) * z_k6
        )

        z_alpha_md = d_mu_pre / z_sigma
        final_mixed_diag = (
            d_mu_pre * flops.stats.norm.cdf(z_alpha_md)
            + z_sigma * flops.stats.norm.pdf(z_alpha_md)
        )

        final_mc = fnp.sum(fnp.maximum(z64, 0.0), axis=0) / float(n_samples)
        final = 0.99965 * (
            1.03700 * final_mc
            - 0.0425 * final_gauss
            + 0.00400 * final_mixed_diag
            + 0.00150 * diag_rows[-1]
        ) - 0.055 * final_edge

        return fnp.asarray(fnp.stack(list(diag_rows[:-1]) + [final], axis=0), dtype=fnp.float32)

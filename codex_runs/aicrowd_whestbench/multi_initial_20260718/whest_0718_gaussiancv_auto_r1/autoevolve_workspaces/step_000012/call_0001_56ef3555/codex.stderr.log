codex
For speed, I’m using moderate local target sample counts first. The goal is to compare relative bias patterns, not to recreate the hidden suite exactly.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
from math import pi

INV = 1/np.sqrt(2*np.pi)

def pdf(x): return INV*np.exp(-0.5*x*x)

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0,dtype=np.float64)
    var=np.ones(w0,dtype=np.float64)
    rows=[]; vars=[]; pres=[]; prevars=[]
    for w in weights:
        w=w.astype(np.float64)
        pm=w.T@mu
        pv=(w*w).T@var
        pv=np.maximum(pv,1e-12)
        s=np.sqrt(pv); a=pm/s; ph=pdf(a); c=ndtr(a)
        mu=pm*c+s*ph
        ez2=(pm*pm+pv)*c+pm*s*ph
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pres.append(pm.copy()); prevars.append(pv.copy())
    return rows, vars, pres, prevars

def current_pred(weights,budget=1e9,seed=0, cap=13744, frac=0.625, offset=2, coeff=(0.99965,1.037,-0.0425,0.004,0.0015), first_params=(-0.245,1.455,-0.455)):
    depth=len(weights); width=weights[0].shape[0]
    diag_rows,diag_vars,pres,prevars=diag_prop(weights)
    if depth==1: return np.stack(diag_rows).astype(np.float32)
    per_sample=max(1, depth*(2*width*width+4*width))
    n=max(1024,int((frac*float(budget))/float(per_sample)))
    n=min(n,cap); n=2*max(1,n//2)
    rng=np.random.default_rng(int(seed)+offset)
    half=n//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        w=w.astype(np.float64)
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(axis=0)
            sample_cov=(z_center.T@z_center)/n
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0)
            x_center=x-x_mean0
            sample_cov=(x_center.T@x_center)/n
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale0=np.maximum(sigma0[:,None]*sigma0[None,:],1e-12)
            rho0=np.clip(t_cov/scale0,-0.999999,0.999999)
            root0=np.sqrt(np.maximum(1-rho0*rho0,0))
            kernel0=(root0+(pi-np.arccos(rho0))*rho0)/(2*pi)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel0
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            p0,p1,p2=first_params
            x=diag_rows[0]+p0*(x_mean0-diag_rows[0])+p1*(x_full-diag_rows[0])+p2*x_center
    z=x@weights[-1].astype(np.float64)
    z_mean=z.mean(axis=0); zc=z-z_mean; z_var=(zc*zc).mean(axis=0); z_sigma=np.sqrt(np.maximum(z_var,1e-12))
    a=z_mean/z_sigma; final_gauss=z_mean*ndtr(a)+z_sigma*pdf(a)
    amd=pres[-1]/z_sigma; final_mixed=pres[-1]*ndtr(amd)+z_sigma*pdf(amd)
    final_mc=np.maximum(z,0).sum(axis=0)/n
    c0,c1,c2,c3,c4=coeff
    final=c0*(c1*final_mc+c2*final_gauss+c3*final_mixed+c4*diag_rows[-1])
    return np.stack(diag_rows[:-1]+[final]).astype(np.float32)

def fullcov_pred(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width); cov=np.eye(width)
    rows=[]
    eye=np.eye(width)
    for w in weights:
        w=w.astype(np.float64)
        pm=w.T@mu
        pc=w.T@cov@w
        pc=0.5*(pc+pc.T)
        var=np.maximum(np.diag(pc),1e-12); sig=np.sqrt(var)
        a=pm/sig; ph=pdf(a); c=ndtr(a)
        mu=pm*c+sig*ph
        ez2=(pm*pm+var)*c+pm*sig*ph
        v=np.maximum(ez2-mu*mu,0)
        scale=np.maximum(sig[:,None]*sig[None,:],1e-12)
        rho=np.clip(pc/scale,-0.999999,0.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        # zero-mean ReLU second moment approximation, diagonal replaced exact
        kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
        second=scale*kernel
        cov=second-mu[:,None]*mu[None,:]
        cov=0.5*(cov+cov.T)
        cov=cov*(1-eye)+eye*v[None,:]
        rows.append(mu.copy())
    return np.stack(rows).astype(np.float32)

def target(weights, n=200000, seed=1234, chunk=20000):
    width=weights[0].shape[0]; depth=len(weights)
    rng=np.random.default_rng(seed)
    sums=np.zeros((depth,width),dtype=np.float64)
    done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st)
        x=rng.standard_normal((m,width)).astype(np.float32)
        for i,w in enumerate(weights):
            x=np.maximum(x@w,0)
            sums[i]+=x.sum(axis=0)
        done+=m
    return (sums/done).astype(np.float32)

def run(width=32,depth=8,nmlp=20,budget=1e9,gt=200000):
    rng=np.random.default_rng(2026)
    mses={'diag':[],'fullcov':[],'current':[]}
    for k in range(nmlp):
        weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        t=target(weights,gt,seed=9000+k)
        d=np.stack(diag_prop(weights)[0]).astype(np.float32)
        f=fullcov_pred(weights)
        c=current_pred(weights,budget=budget,seed=100000+k)
        for name,p in [('diag',d),('fullcov',f),('current',c)]:
            mses[name].append(float(((p[-1]-t[-1])**2).mean()))
        print(k, {n: mses[n][-1] for n in mses}, flush=True)
    print('MEAN', {n: float(np.mean(v)) for n,v in mses.items()})
    print('MED', {n: float(np.median(v)) for n,v in mses.items()})
run(width=32,depth=8,nmlp=10,budget=1e9,gt=100000)

        mu=pm*c+s*ph; ez2=(pm*pm+pv)*c+pm*s*ph; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pres.append(pm.copy())
    return rows,vars,pres
def features(weights,budget=1e9,seed=0, cap=13744, frac=.625, fp=(-.245,1.455,-.455)):
    depth=len(weights); width=weights[0].shape[0]; diag_rows,diag_vars,pres=diag_prop(weights)
    per=max(1,depth*(2*width*width+4*width)); n=max(1024,int(frac*budget/per)); n=min(n,cap); n=2*max(1,n//2)
    rng=np.random.default_rng(seed+2); x0=rng.standard_normal((n//2,width)).astype(np.float32); x=np.concatenate([x0,-x0]).astype(float); eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):

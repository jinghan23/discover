# Smaller grid for first-layer correction across depths.
import numpy as np
from scipy.special import ndtr
from math import pi
INV=1/np.sqrt(2*np.pi)
def pdf(x): return INV*np.exp(-.5*x*x)
def diag_prop(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); rows=[]; vars=[]; pres=[]
    for w in weights:
        w=w.astype(float); pm=w.T@mu; pv=(w*w).T@var; pv=np.maximum(pv,1e-12); s=np.sqrt(pv); a=pm/s; ph=pdf(a); c=ndtr(a)
        mu=pm*c+s*ph; ez2=(pm*pm+pv)*c+pm*s*ph; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy()); pres.append(pm.copy())
    return rows,vars,pres
def make_feats(weights,tens,mean_a,gamma,budget=1e9,seed=0):
    diag_rows,diag_vars,pres=tens; depth=len(weights); width=weights[0].shape[0]; n=min(13744,max(1024,int(.625*budget/(depth*(2*width*width+4*width))))); n=2*max(1,n//2)
    rng=np.random.default_rng(seed+2); x=np.concatenate([rng.standard_normal((n//2,width)).astype(np.float32), -rng.standard_normal((0,width)).astype(np.float32)]) if False else None
    x0=rng.standard_normal((n//2,width)).astype(np.float32); x=np.concatenate([x0,-x0]).astype(float); eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        w=w.astype(float); z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=(zc.T@zc)/n; sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc); z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc); sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(pi-np.arccos(rho))*rho)/(2*pi); sec=sig[:,None]*sig[None,:]*ker; tgt=sec-diag_rows[0][:,None]*diag_rows[0][None,:]; tgt=.5*(tgt+tgt.T); tgt=tgt*(1-eye)+eye*diag_vars[0][None,:]
            tv,te=np.linalg.eigh(tgt); xf=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+diag_rows[0]
            x=diag_rows[0]+mean_a*(xm-diag_rows[0])+gamma*(xf-diag_rows[0])+(1-gamma)*xc
    z=x@weights[-1].astype(float); zm=z.mean(0); zc=z-zm; zs=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); fg=zm*ndtr(zm/zs)+zs*pdf(zm/zs); amd=pres[-1]/zs; fm=pres[-1]*ndtr(amd)+zs*pdf(amd); fmc=np.maximum(z,0).mean(0)
    return (.99965*(1.037*fmc-.0425*fg+.004*fm+.0015*diag_rows[-1])).astype(np.float32)
def target(weights,n,seed):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); s=np.zeros(width); done=0
    for st in range(0,n,12000):
        m=min(12000,n-st); x=rng.standard_normal((m,width)).astype(np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/done
for depth in [6,8,12,16]:
    width=64; budget=1e9; nmlp=8; rng=np.random.default_rng(3000+depth); data=[]
    for k in range(nmlp):
        weights=[(rng.standard_normal((width,width))*np.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        data.append((weights,diag_prop(weights),target(weights,100000,5000+k),k))
    print('depth',depth)
    best=None
    for ma in [-.35,-.245,-.15,-.05,0,.05,.15]:

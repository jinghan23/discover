            A=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)); z=zc@A
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=(xc.T@xc)/n; sv,se=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999)

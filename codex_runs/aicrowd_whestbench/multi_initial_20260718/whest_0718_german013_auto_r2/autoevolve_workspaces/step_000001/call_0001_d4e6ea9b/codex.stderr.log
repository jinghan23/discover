 _SEED_OFFSET = -1
-_WHITEN_POWER = 0.455
+_WHITEN_POWER = 0.4525
 _RADIUS_POWER = 0.25
-_FIRST_MEAN_POWER = 0.915
+_FIRST_MEAN_POWER = 0.855
 _FINAL_GAUSSIAN_BLEND = 0.08
 _FINAL_SKEW_WEIGHT = 2.0
+_DIAG_BLEND = 0.02
 _K_ADJUST = -20
 _SAMPLE_DTYPE = fnp.float32
 _MIN_SAMPLES = 32
@@ -34,6 +35,29 @@
     return sigma * phi + mu * _normal_cdf_approx(alpha)
 
 
+def _gaussian_relu_second(mu, var):
+    var = fnp.maximum(var, 1e-20)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    phi = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = _normal_cdf_approx(alpha)
+    return (mu * mu + var) * cdf + mu * sigma * phi
+
+
+def _diag_gaussian_final(weights):
+    weight = weights[0]
+    var = fnp.sum(weight * weight, axis=0)
+    mean = fnp.sqrt(fnp.maximum(var, 1e-20)) * _INV_SQRT_2PI
+    second = 0.5 * var
+    for weight in weights[1:]:
+        centered_second = fnp.maximum(second - mean * mean, 1e-20)
+        mu = mean @ weight
+        var = centered_second @ (weight * weight)
+        mean = _gaussian_relu_mean(mu, var)
+        second = _gaussian_relu_second(mu, var)
+    return mean
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     per_sample = depth * (2 * width * width + width) + width * width
     fixed = 9 * width**3 + 2 * (2 * width**3)
@@ -87,5 +111,7 @@
             (1.0 - final_blend) * sample_final_mean
             + final_blend * gaussian_final_mean
         )
+        diag_final_mean = _diag_gaussian_final(mlp.weights)
+        final_mean = (1.0 - _DIAG_BLEND) * final_mean + _DIAG_BLEND * diag_final_mean
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


+_SEED_OFFSET = -1
+_FIRST_MEAN_POWER = 0.8
+_FIRST_SECOND_POWER = 0.5
+_FINAL_GAUSSIAN_BLEND = 0.025
+_K_ADJUST = -30
 _MIN_SAMPLES = 32
 _MAX_SAMPLES = 1_000_000
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
 _WORST_CASE_ITEMSIZE = 8
 
 
+def _normal_cdf_approx(x):
+    y = _SQRT_2_OVER_PI * (x + 0.044715 * x * x * x)

+def _diagonal_final_mean(mlp):
+    weight = mlp.weights[0]
+    pre_var = fnp.sum(weight * weight, axis=0)
+    mean = _normal_relu_mean(0.0, pre_var)
+    second = 0.5 * pre_var
+    for weight in mlp.weights[1:]:
+        centered_second = fnp.maximum(second - mean * mean, 1e-12)
+        pre_mean = mean @ weight
+        pre_var = centered_second @ (weight * weight)
+        mean = _normal_relu_mean(pre_mean, pre_var)
+        second = _normal_relu_second(pre_mean, pre_var)
+    return mean

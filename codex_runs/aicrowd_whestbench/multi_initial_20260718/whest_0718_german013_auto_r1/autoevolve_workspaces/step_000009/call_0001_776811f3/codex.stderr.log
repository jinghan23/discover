diff --git a/submission.py b/submission.py
index 769056b302a4b6a5edd8b69489176e18796b8fa7..409ad07e5d66b65e8fffa8f5f64c722a8ffb62df
--- a/submission.py
+++ b/submission.py
@@ -10,9 +10,10 @@
 _EXTRA_FRACTION = 0.01022
 _EXTRA_WEIGHT_SCALE = 1.22
 _MAIN_FINAL_NORMAL_BLEND = 0.060
-_EXTRA_FINAL_NORMAL_BLEND = 0.060
-_FIRST_MEAN_STRENGTH = 0.50
-_EXTRA_FIRST_MEAN_STRENGTH = -0.25
+_EXTRA_FINAL_NORMAL_BLEND = 0.100
+_FIRST_MEAN_STRENGTH = 0.45
+_EXTRA_FIRST_MEAN_STRENGTH = -0.38
+_DIAG_BLEND = 0.020
 _INV_SQRT_2PI = 0.3989422804014327
 _SQRT_2_OVER_PI = 0.7978845608028654
 _CDF_CUBIC = 0.044715
@@ -54,6 +55,30 @@
     return sigma * pdf + mu * cdf
 
 
+def _normal_relu_second(mu, var):
+    var = fnp.maximum(var, 1e-12)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = 0.5 * (
+        1.0
+        + fnp.tanh(_SQRT_2_OVER_PI * (alpha + _CDF_CUBIC * alpha * alpha * alpha))
+    )
+    return (var + mu * mu) * cdf + mu * sigma * pdf
+
+
+def _diag_estimate(mlp):
+    mean = fnp.zeros(mlp.width, dtype=fnp.float32)
+    second = fnp.ones(mlp.width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        mu = mean @ weight
+        raw_second = second @ (weight * weight)
+        var = raw_second - mu * mu
+        mean = _normal_relu_mean(mu, var)
+        second = _normal_relu_second(mu, var)
+    return mean
+
+
 def _prepare_block(rng, k: int, width: int):
     u = rng.standard_normal((k // 2, width), dtype=fnp.float32)
     u = u[:, ::-1]

     return sigma * pdf + mu * cdf
 
 
+def _normal_relu_moments(mu, var):
+    var = fnp.maximum(var, 1e-12)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    pdf = _NORMAL_INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = 0.5 * (
+        1.0
+        + fnp.tanh(_SQRT_2_OVER_PI * (alpha + _CDF_CUBIC * alpha * alpha * alpha))
+    )
+    mean = sigma * pdf + mu * cdf
+    second = (mu * mu + var) * cdf + mu * sigma * pdf
+    return mean, fnp.maximum(second - mean * mean, 1e-12)
+
+
+def _diag_final_mean(mlp):
+    width = mlp.width
+    mu = fnp.zeros(width, dtype=fnp.float32)
+    var = fnp.ones(width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        mu_pre = mu @ weight
+        var_pre = var @ (weight * weight)
+        mu, var = _normal_relu_moments(mu_pre, var_pre)
+    return mu
+
+

+++ b/cov_submission.py
@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+import flopscope.numpy as fnp
+from whestbench import BaseEstimator
+
+
+_INV_SQRT_2PI = 0.3989422804014327
+_SQRT_2_OVER_PI = 0.7978845608028654
+_CDF_CUBIC = 0.044715
+
+
+def _moments(mu, var):
+    var = fnp.maximum(var, 1e-12)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = 0.5 * (1.0 + fnp.tanh(_SQRT_2_OVER_PI * (alpha + _CDF_CUBIC * alpha**3)))
+    mean = mu * cdf + sigma * pdf
+    second = (mu * mu + var) * cdf + mu * sigma * pdf
+    return mean, fnp.maximum(second - mean * mean, 1e-12)
+
+
+class Estimator(BaseEstimator):
+    def predict(self, mlp, budget):
+        width = mlp.width
+        mu = fnp.zeros(width, dtype=fnp.float32)
+        cov = fnp.eye(width, dtype=fnp.float32)
+        rows = []
+        for weight in mlp.weights:
+            mu_pre = mu @ weight
+            cov_pre = weight.T @ cov @ weight
+            var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
+            mu, var = _moments(mu_pre, var_pre)
+            gain = 0.5 * (
+                1.0
+                + fnp.tanh(
+                    _SQRT_2_OVER_PI
+                    * ((mu_pre / fnp.sqrt(var_pre)) + _CDF_CUBIC * (mu_pre / fnp.sqrt(var_pre)) ** 3)
+                )
+            )
+            cov = fnp.outer(gain, gain) * cov_pre
+            cov = cov * (1.0 - fnp.eye(width, dtype=fnp.float32)) + fnp.diag(var)
+            rows.append(mu)
+        return fnp.stack(rows, axis=0)

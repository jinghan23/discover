from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)
PI=3.141592653589793; INV=0.3989422804014327

def cov_est(mlp):
    w0=mlp.weights[0]
    pre=w0.T@w0
    for li in range(mlp.depth):
        d=fnp.sqrt(fnp.maximum(fnp.diag(pre),1e-12))
        mean=d*INV
        if li==mlp.depth-1:
            return mean
        outer=d[:,None]*d[None,:]
        rho=fnp.maximum(-1.0,fnp.minimum(1.0,pre/fnp.maximum(outer,1e-12)))
        term=fnp.sqrt(fnp.maximum(0.0,1.0-rho*rho))+(PI-fnp.arccos(rho))*rho
        post=outer*(term/(2.0*PI))
        wt=mlp.weights[li+1]
        pre=wt.T@post@wt
    return mean

from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715

def relu_mom(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig
    pdf=INV*fnp.exp(-0.5*a*a); cdf=0.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a)))
    return sig*pdf+mu*cdf, (var+mu*mu)*cdf+mu*sig*pdf

def diag(mlp):
    w=mlp.width; mean=fnp.zeros(w,dtype=fnp.float32); second=fnp.ones(w,dtype=fnp.float32)
    for wt in mlp.weights:
        var=fnp.maximum(second-mean*mean,1e-12); mean,second=relu_mom(mean@wt, var@(wt*wt))
    return mean
w=256; d=32; budget=272_000_000_000
for i in range(3):
    t=time.time(); mlp=sample_mlp(w,d,fnp.random.default_rng(100+i),seed=200+i)
    target=sample_layer_statistics(mlp,100000,fnp.random.default_rng(300+i))[1]
    print('target done',i,'time',time.time()-t)
    with flops.BudgetContext(flop_budget=budget, quiet=True) as c0: mc=cur.Estimator().predict(mlp,budget)[-1]
    with flops.BudgetContext(flop_budget=budget, quiet=True) as c1:
        mc2=cur.Estimator().predict(mlp,budget)[-1]; an=diag(mlp)
    print('util',c0.flops_used/budget,c1.flops_used/budget)
    for b in [-0.02,0.0,0.02,0.05]:
        p=(1-b)*mc2+b*an
        print('blend',b,'mse',float(fnp.mean((p-target)**2)))

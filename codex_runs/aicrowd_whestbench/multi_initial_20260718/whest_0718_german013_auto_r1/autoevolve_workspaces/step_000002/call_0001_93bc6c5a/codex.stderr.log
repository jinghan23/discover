/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def make_q(k,width,seed=777):
    rng=fnp.random.default_rng(seed)
    u=rng.standard_normal((k//2,width), dtype=fnp.float32); u=u[:, ::-1]
    cov=(u.T@u)/float(k//2); ch=fnp.linalg.cholesky(cov); x=fnp.concatenate([u,-u],axis=0)
    return fnp.linalg.solve(ch, x.T).T

def k_for(width,depth,budget,frac):
    per=depth*(2*width*width+width)+width*width
    k=int(frac*budget)//max(per,1); k=max(max(32,2*width+2), min(1000000,k)); return k-(k&1)

def pred(mlp,q,sign=False):
    if sign:
        rng=fnp.random.default_rng(mlp.seed)
        r=rng.standard_normal((mlp.width,), dtype=fnp.float32)
        s=fnp.where(r < 0.0, -1.0, 1.0)
        w0=mlp.weights[0]*s[:, None]
    else:
        w0=mlp.weights[0]
    x=fnp.maximum(q@w0,0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    return .95*sample+.05*cur._normal_relu_mean(mu,sec-mu*mu)

def eval_case(width,depth,budget,n,target_samples,frac):
    k=k_for(width,depth,budget,frac); q=make_q(k,width,12345)
    gen=fnp.random.default_rng(54321)
    acc={n:0.0 for n in ['cur','pre','sign']}; adj=acc.copy(); util=acc.copy()
    for i in range(n):
        mlp=sample_mlp(width,depth,gen,seed=700+i)
        target=sample_layer_statistics(mlp,target_samples,fnp.random.default_rng(900+i))[1]
        with flops.BudgetContext(flop_budget=budget, quiet=True) as c0: pc=cur.Estimator().predict(mlp,budget)[-1]
        with flops.BudgetContext(flop_budget=budget, quiet=True) as c1: pp=pred(mlp,q,False)
        with flops.BudgetContext(flop_budget=budget, quiet=True) as c2: ps=pred(mlp,q,True)
        for name,p,ctx in [('cur',pc,c0),('pre',pp,c1),('sign',ps,c2)]:
            mse=float(fnp.mean((p-target)**2)); u=ctx.flops_used/budget
            acc[name]+=mse; adj[name]+=mse*max(.1,u); util[name]+=u
    print('case',width,depth,'frac',frac,'k',k)
    for name in ['cur','pre','sign']:
        print(name,'mse',acc[name]/n,'adj',adj[name]/n,'util',util[name]/n)
for case in [(32,8,50_000_000,12,50000,.10),(64,8,200_000_000,8,30000,.11),(64,16,400_000_000,6,20000,.12)]:
    eval_case(*case)

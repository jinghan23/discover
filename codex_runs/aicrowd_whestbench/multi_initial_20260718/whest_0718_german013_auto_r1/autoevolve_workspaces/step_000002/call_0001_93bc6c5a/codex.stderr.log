def relu_mom(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig
    pdf=INV*fnp.exp(-0.5*a*a)
    cdf=0.5*(1.0+fnp.tanh(SQ*(a+CUB*a*a*a)))
    mean=sig*pdf+mu*cdf
    second=(var+mu*mu)*cdf+mu*sig*pdf
    return mean,second

def diag_est(mlp):
    w=mlp.width
    mean=fnp.zeros(w,dtype=fnp.float32); second=fnp.ones(w,dtype=fnp.float32)
    for wt in mlp.weights:
        var=fnp.maximum(second-mean*mean,1e-12)
        pre_mu=mean@wt
        pre_var=var@(wt*wt)
        mean,second=relu_mom(pre_mu,pre_var)
    return mean

def eval_case(width,depth,budget,n,target_samples):
    blends=[-0.2,-0.1,-0.05,-0.02,0.0,0.02,0.05,0.08,0.1,0.15,0.2]

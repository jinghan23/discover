from __future__ import annotations
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util

spec = importlib.util.spec_from_file_location('sub', 'submission.py')
cur = importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715

def normal_relu_mean(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig
    pdf=INV*fnp.exp(-0.5*a*a)
    cdf=0.5*(1.0+fnp.tanh(SQ*(a+CUB*a*a*a)))
    return sig*pdf+mu*cdf

def block_stats(mlp,rng,k):
    w=mlp.width
    u=rng.standard_normal((k//2,w), dtype=fnp.float32)
    u=u[:, ::-1]
    x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2)
    ch=fnp.linalg.cholesky(cov)
    fw=fnp.linalg.solve(ch.T, mlp.weights[0])
    x=fnp.maximum(x@fw,0.0)
    for weight in mlp.weights[1:-1]:
        x=fnp.maximum(x@weight,0.0)
    z=x@mlp.weights[-1]
    return fnp.mean(fnp.maximum(z,0.0),axis=0), fnp.mean(z,axis=0), fnp.mean(z*z,axis=0)

def alt_pred(mlp,budget):
    w=mlp.width; d=mlp.depth; rng=fnp.random.default_rng(mlp.seed)
    km=cur._sample_count(cur._MAIN_FRACTION,budget,w,d); ke=cur._sample_count(cur._EXTRA_FRACTION,budget,w,d)
    sm,mm,ssm=block_stats(mlp,rng,km); se,me,sse=block_stats(mlp,rng,ke)
    tot=float(km+ke)
    sample=(km*sm+ke*se)/tot
    mu=(km*mm+ke*me)/tot
    sec=(km*ssm+ke*sse)/tot
    norm=normal_relu_mean(mu, sec-mu*mu)
    return 0.95*sample+0.05*norm

def score_case(width,depth,budget,n_mlps,target_samples):
    vals=[]; vals_alt=[]
    gen=fnp.random.default_rng(999)
    for i in range(n_mlps):
        mlp=sample_mlp(width,depth,gen,seed=1000+i)
        target=sample_layer_statistics(mlp,target_samples,fnp.random.default_rng(2000+i))[1]
        p=cur.Estimator().predict(mlp,budget)[-1]
        q=alt_pred(mlp,budget)
        vals.append(float(fnp.mean((p-target)**2)))
        vals_alt.append(float(fnp.mean((q-target)**2)))
    print('case',width,depth,'cur',sum(vals)/len(vals),'alt',sum(vals_alt)/len(vals_alt),'ratio',sum(vals_alt)/sum(vals))


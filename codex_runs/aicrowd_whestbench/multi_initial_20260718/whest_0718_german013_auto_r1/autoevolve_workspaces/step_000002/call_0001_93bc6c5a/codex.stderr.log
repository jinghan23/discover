from __future__ import annotations
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def block_pair(mlp,rng,k):
    w=mlp.width
    u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:, ::-1]
    x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(k//2); ch=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(ch.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    norm=cur._normal_relu_mean(mu,sec-mu*mu)
    return sample,norm

def sweep(width,depth,budget,n,target_samples):
    blends=[-0.05,-0.02,0.0,0.02,0.04,0.05,0.06,0.08,0.10,0.15]
    sums={b:0.0 for b in blends}
    gen=fnp.random.default_rng(2024)
    km=cur._sample_count(cur._MAIN_FRACTION,budget,width,depth); ke=cur._sample_count(cur._EXTRA_FRACTION,budget,width,depth)
    for i in range(n):
        mlp=sample_mlp(width,depth,gen,seed=3000+i)
        target=sample_layer_statistics(mlp,target_samples,fnp.random.default_rng(4000+i))[1]
        rng=fnp.random.default_rng(mlp.seed)
        sm,nm=block_pair(mlp,rng,km); se,ne=block_pair(mlp,rng,ke)
        sample=(km*sm+ke*se)/float(km+ke); norm=(km*nm+ke*ne)/float(km+ke)
        for b in blends:
            pred=(1.0-b)*sample+b*norm
            sums[b]+=float(fnp.mean((pred-target)**2))
    print('case',width,depth,'km ke',km,ke)
    best=None
    for b in blends:
        val=sums[b]/n
        print(b,val)
        if best is None or val<best[1]: best=(b,val)
    print('best',best)


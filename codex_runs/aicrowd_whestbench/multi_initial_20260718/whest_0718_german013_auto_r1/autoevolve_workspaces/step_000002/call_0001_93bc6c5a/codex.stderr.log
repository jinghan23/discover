I’m testing a setup-style fixed whitened design: precompute a covariance-normalized antithetic Gaussian matrix once, then spend predict FLOPs only on forward propagation. This should allow more probes at the same per-MLP multiplier, but it changes the randomization pattern.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def make_q(k,width,seed=777):
    rng=fnp.random.default_rng(seed)
    u=rng.standard_normal((k//2,width), dtype=fnp.float32)
    u=u[:, ::-1]
    cov=(u.T@u)/float(k//2)
    ch=fnp.linalg.cholesky(cov)
    # Whiten rows: q = [u,-u] @ inv(ch.T). Use solve(ch, x.T).T for row transform.
    x=fnp.concatenate([u,-u],axis=0)
    q=fnp.linalg.solve(ch, x.T).T
    return q

def preq_pred(mlp,budget,frac=0.112,seed=777):
    w=mlp.width; d=mlp.depth
    per=d*(2*w*w+w)+w*w
    k=int(frac*budget)//max(per,1)
    k=max(max(32,2*w+2), min(1000000, k)); k-=k&1
    q=make_q(k,w,seed)
    x=fnp.maximum(q@mlp.weights[0],0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0)
    mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    return .95*sample+.05*cur._normal_relu_mean(mu,sec-mu*mu)

def preq_predict_only(mlp,q):
    x=fnp.maximum(q@mlp.weights[0],0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    return .95*sample+.05*cur._normal_relu_mean(mu,sec-mu*mu)

def k_for(width,depth,budget,frac):
    per=depth*(2*width*width+width)+width*width
    k=int(frac*budget)//max(per,1)
    k=max(max(32,2*width+2), min(1000000, k)); return k-(k&1)

def eval_case(width,depth,budget,n,target_samples,frac):
    k=k_for(width,depth,budget,frac); q=make_q(k,width,12345)
    gen=fnp.random.default_rng(987)
    sc={'cur':0.0,'pre':0.0}; adj={'cur':0.0,'pre':0.0}; util={'cur':0.0,'pre':0.0}
    for i in range(n):
        mlp=sample_mlp(width,depth,gen,seed=111+i)
        target=sample_layer_statistics(mlp,target_samples,fnp.random.default_rng(222+i))[1]
        with flops.BudgetContext(flop_budget=budget, quiet=True) as c1: p=cur.Estimator().predict(mlp,budget)[-1]
        with flops.BudgetContext(flop_budget=budget, quiet=True) as c2: qpred=preq_predict_only(mlp,q)
        for name,pred,ctx in [('cur',p,c1),('pre',qpred,c2)]:
            mse=float(fnp.mean((pred-target)**2)); u=ctx.flops_used/budget
            sc[name]+=mse; adj[name]+=mse*max(.1,u); util[name]+=u
    print('case',width,depth,'kpre',k,'frac',frac)
    for name in ['cur','pre']:
        print(name,'mse',sc[name]/n,'adj',adj[name]/n,'util',util[name]/n)
for frac in [0.10,0.11,0.12]:
    eval_case(32,8,50_000_000,12,50000,frac)
for frac in [0.10,0.11,0.12]:
    eval_case(64,8,200_000_000,8,30000,frac)
for frac in [0.10,0.11,0.12]:
    eval_case(64,16,400_000_000,6,20000,frac)

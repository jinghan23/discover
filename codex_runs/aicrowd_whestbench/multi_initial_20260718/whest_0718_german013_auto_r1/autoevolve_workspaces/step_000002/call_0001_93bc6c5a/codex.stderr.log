    flag_keys = (
        "budget_exhausted",
        "time_exhausted",
        "residual_wall_time_exhausted",
        "combined_budget_exhausted",
    )

    def _is_failed_entry(e: Dict[str, Any]) -> bool:
        return bool(e.get("error_code")) or any(bool(e.get(k)) for k in flag_keys)


from __future__ import annotations
import math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def mean_radius(w):
    return math.sqrt(2.0)*math.exp(math.lgamma((w+1)*0.5)-math.lgamma(w*0.5))

def k_for(width,depth,budget,frac):
    per=depth*(2*width*width+width)+width*width + 4*width  # rough norm cost
    k=int(frac*budget)//max(per,1)
    k=max(max(32,2*width+2), min(1000000,k)); return k-(k&1)

def spherical(mlp,budget,frac=.10,blend=0.05):
    rng=fnp.random.default_rng(mlp.seed); w=mlp.width; k=k_for(w,mlp.depth,budget,frac)
    u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:, ::-1]
    norm=fnp.sqrt(fnp.maximum(fnp.sum(u*u,axis=1,keepdims=True),1e-12))
    u=(u/norm)*mean_radius(w)
    x=fnp.concatenate([u,-u],axis=0)
    x=fnp.maximum(x@mlp.weights[0],0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    return (1-blend)*sample+blend*cur._normal_relu_mean(mu,sec-mu*mu)
# flops for fractions

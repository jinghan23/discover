from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def est(mlp,budget,main_frac,extra_frac,blend=0.05):
    rng=fnp.random.default_rng(mlp.seed); w=mlp.width; d=mlp.depth
    km=cur._sample_count(main_frac,budget,w,d); ke=cur._sample_count(extra_frac,budget,w,d) if extra_frac>0 else 0
    def block(k):

    failure_breakdown = {
        "budget_exhausted": sum(
            1 for e in per_mlp if isinstance(e, dict) and bool(e.get("budget_exhausted"))
        ),
        "time_exhausted": sum(
            1 for e in per_mlp if isinstance(e, dict) and bool(e.get("time_exhausted"))
        ),
        "residual_wall_time_exhausted": sum(
            1
            for e in per_mlp

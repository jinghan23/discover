from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
import importlib.util
spec=importlib.util.spec_from_file_location('sub','submission.py'); cur=importlib.util.module_from_spec(spec); spec.loader.exec_module(cur)

def block(mlp,rng,k):
    w=mlp.width
    u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:, ::-1]
    x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(k//2); ch=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(ch.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0.0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0.0)
    z=x@mlp.weights[-1]
    sample=fnp.mean(fnp.maximum(z,0.0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0)
    return .95*sample+.05*cur._normal_relu_mean(mu,sec-mu*mu)

def est(mlp,budget,extra):
    rng=fnp.random.default_rng(mlp.seed); w=mlp.width; d=mlp.depth
    km=cur._sample_count(.095,budget,w,d); m=block(mlp,rng,km)
    if extra<=0: return m
    ke=cur._sample_count(extra,budget,w,d); e=block(mlp,rng,ke)
    return (km*m+ke*e)/float(km+ke)
w=256; d=32; budget=272_000_000_000
extras=[0.0,0.005,0.01022]
acc={e:0.0 for e in extras}; adj=acc.copy(); util=acc.copy(); wins={e:0 for e in extras}
N=20; TS=80000
for i in range(N):
    mlp=sample_mlp(w,d,fnp.random.default_rng(22000+i),seed=23000+i)
    target=sample_layer_statistics(mlp,TS,fnp.random.default_rng(24000+i))[1]
    vals=[]
    for e in extras:
        with flops.BudgetContext(flop_budget=budget, quiet=True) as ctx: p=est(mlp,budget,e)
        mse=float(fnp.mean((p-target)**2)); a=mse*max(.1,ctx.flops_used/budget)
        acc[e]+=mse; util[e]+=ctx.flops_used/budget; adj[e]+=a; vals.append((a,e))
    wins[min(vals)[1]]+=1
print('wins',wins)
for e in extras:
    print('extra',e,'mse',acc[e]/N,'util',util[e]/N,'adj',adj[e]/N)

            for e in per_mlp
            if isinstance(e, dict) and bool(e.get("residual_wall_time_exhausted"))
        ),
        "combined_budget_exhausted": sum(
            1 for e in per_mlp if isinstance(e, dict) and bool(e.get("combined_budget_exhausted"))
        ),

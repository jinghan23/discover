+    sample_cov = (centered.T @ centered) / float(x.shape[0])
+    target_cov = target_second - fnp.outer(target_mean, target_mean)
+    blended_cov = sample_cov + blend * (target_cov - sample_cov)
+    jitter = 1e-5 * fnp.maximum(fnp.mean(fnp.diag(target_second)), 1e-12)
+    eye = fnp.eye(width) * jitter

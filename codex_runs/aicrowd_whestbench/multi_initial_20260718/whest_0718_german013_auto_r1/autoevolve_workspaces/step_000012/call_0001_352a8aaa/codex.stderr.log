     return sigma * pdf + mu * cdf
 
 
+def _normal_relu_second(mu, var):
+    var = fnp.maximum(var, 1e-12)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = 0.5 * (
+        1.0
+        + fnp.tanh(_SQRT_2_OVER_PI * (alpha + _CDF_CUBIC * alpha * alpha * alpha))
+    )
+    return (mu * mu + var) * cdf + mu * sigma * pdf
+
+
+def _diag_final_mean(mlp):
+    width = mlp.width
+    mean = fnp.zeros(width, dtype=fnp.float32)
+    second = fnp.ones(width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        centered_second = fnp.maximum(second - mean * mean, 1e-12)
+        mu = mean @ weight
+        var = centered_second @ (weight * weight)
+        mean = _normal_relu_mean(mu, var)
+        second = _normal_relu_second(mu, var)
+    return mean
+
+

+
+class Estimator(BaseEstimator):
+    def setup(self, context):
+        raise RuntimeError(
+            f"width={context.width} depth={context.depth} "
+            f"budget={context.flop_budget} seed={context.seed}"
+        )
+
+    def predict(self, mlp, budget):
+        raise RuntimeError("predict should not run")

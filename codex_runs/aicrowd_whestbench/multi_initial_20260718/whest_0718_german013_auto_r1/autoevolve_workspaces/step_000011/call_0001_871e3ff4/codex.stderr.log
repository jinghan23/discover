base=Path('candidate_preprop.py').read_text().replace('_PREPROP_LAYERS = 4','_PREPROP_LAYERS = 14',1).replace('_EXTRA_FIRST_MEAN_STRENGTH = -0.35','_EXTRA_FIRST_MEAN_STRENGTH = -0.25',1)
variants=[(0,1),(1,0),(1,1),(2,1),(1,2),(0,0),(2,2),(3,1),(1,3)]
best=(1e9,None)
for idx,(a,b) in enumerate(variants,1):

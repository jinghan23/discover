from pathlib import Path
import subprocess, re, sys, time
base = Path('submission.py').read_text()
variants = []
for a,b in [(0,1),(2,1),(1,0),(1,2),(0,0),(2,2),(3,3),(4,4)]:
    variants.append((f'skip=({a},{b})', {'_MAIN_SKIP_ROWS = 1': f'_MAIN_SKIP_ROWS = {a}', '_EXTRA_SKIP_ROWS = 1': f'_EXTRA_SKIP_ROWS = {b}'}))
for idx,(label,repls) in enumerate(variants,1):
    text=base
    for old,new in repls.items():
        text=text.replace(old,new,1)
    Path('candidate_tmp.py').write_text(text)
    t0=time.time()
    p=subprocess.run([sys.executable,'eval_client.py','candidate_tmp.py'],text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=4100)
    m=re.search(r'raw_score ([0-9.eE+-]+)',p.stdout)
    score=float(m.group(1)) if m else float('inf')
    print(f'{idx:02d}/{len(variants)} {label}: {score:.12g} ({time.time()-t0:.1f}s)')
    sys.stdout.flush()

from pathlib import Path
import subprocess, re, sys, time
base=Path('submission.py').read_text()
old_loop='''    for weight in mlp.weights[1:-1]:\\n        x = fnp.maximum(x @ weight, 0.0)\\n\\n    z = x @ mlp.weights[-1]\\n'''
new_loop='''    for weight in mlp.weights[1:-1]:\\n        z = x @ weight\\n        x_relu = fnp.maximum(z, 0.0)\\n        mu_hidden = fnp.mean(z, axis=0)\\n        second_hidden = fnp.mean(z * z, axis=0)\\n        normal_hidden_mean = _normal_relu_mean(\\n            mu_hidden, second_hidden - mu_hidden * mu_hidden\\n        )\\n        sample_hidden_mean = fnp.mean(x_relu, axis=0)\\n        target_hidden_mean = sample_hidden_mean + _HIDDEN_MEAN_STRENGTH * (\\n            normal_hidden_mean - sample_hidden_mean\\n        )\\n        sample_hidden_second = fnp.mean(x_relu * x_relu, axis=0)\\n        hidden_scale = fnp.sqrt(\\n            fnp.maximum(sample_hidden_second - target_hidden_mean * target_hidden_mean, 1e-12)\\n            / fnp.maximum(sample_hidden_second - sample_hidden_mean * sample_hidden_mean, 1e-12)\\n        )\\n        x = (x_relu - sample_hidden_mean) * hidden_scale + target_hidden_mean\\n\\n    z = x @ mlp.weights[-1]\\n'''
variants=[-0.10,-0.05,0.05,0.10,0.20]
for idx,h in enumerate(variants,1):
    text=base.replace('_EXTRA_FIRST_MEAN_STRENGTH = -0.35\\n', f'_EXTRA_FIRST_MEAN_STRENGTH = -0.35\\n_HIDDEN_MEAN_STRENGTH = {h}\\n',1)
    if old_loop not in text: raise SystemExit('loop pattern missing')
    text=text.replace(old_loop,new_loop,1)

import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
LIM=100*1024*1024

def sc(fr,b,w,d):
 p=d*(2*w*w+w)+w*w; fix=13*w**3; k=(int(fr*b)-fix)//max(p,1); k=int(max(max(32,2*w+2), min(1_000_000,LIM//max(w*8,1), k))); return k-(k&1)
def block_plain(mlp,rng,k):
 w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0); fw=fnp.linalg.solve(fnp.linalg.cholesky((u.T@u)/float(k//2)).T,mlp.weights[0]); x=fnp.maximum(x@fw,0)
 for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)

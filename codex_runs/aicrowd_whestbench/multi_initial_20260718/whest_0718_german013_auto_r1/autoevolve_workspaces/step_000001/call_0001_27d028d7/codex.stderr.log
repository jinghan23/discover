from __future__ import annotations
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; LIM=100*1024*1024

def sc(fr,b,w,d,half=False):
 p=(d*(2*w*w+w)+w*w) if not half else ((2*d-1)*w*w+d*w+w*w)
 fix=13*w**3
 k=(int(fr*b)-fix)//max(p,1); k=int(max(max(32,2*w+2), min(1_000_000,LIM//max(w*8,1), k))); return k-(k&1)
def nrm(mu,var):
 var=fnp.maximum(var,1e-12); s=fnp.sqrt(var); a=mu/s; pdf=INV*fnp.exp(-.5*a*a); cdf=.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a))); return s*pdf+mu*cdf
def block(mlp,rng,k,blend=.05,half=True,normal=True):
 w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]
 fw=fnp.linalg.solve(fnp.linalg.cholesky((u.T@u)/float(k//2)).T,mlp.weights[0])
 if half:
  h=u@fw; x=fnp.concatenate([fnp.maximum(h,0),fnp.maximum(-h,0)],0)
 else:
  x=fnp.concatenate([u,-u],0); x=fnp.maximum(x@fw,0)
 for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0)
 z=x@mlp.weights[-1]
 sm=fnp.mean(fnp.maximum(z,0),0)
 if normal:
  mu=fnp.mean(z,0); sec=fnp.mean(z*z,0); nm=nrm(mu,sec-mu*mu); return (1-blend)*sm+blend*nm
 return sm
class Two(BaseEstimator):
 def __init__(self,half=False,halfcnt=False,normal=True,blend=.05): self.half=half; self.halfcnt=halfcnt; self.normal=normal; self.blend=blend
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; rng=fnp.random.default_rng(mlp.seed); km=sc(.095,budget,w,d,self.halfcnt); ke=sc(.01022,budget,w,d,self.halfcnt); m=block(mlp,rng,km,self.blend,self.half,self.normal); e=block(mlp,rng,ke,self.blend,self.half,self.normal); fin=(km*m+ke*e)/float(km+ke); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fin[None,:]],0)
class One(BaseEstimator):
 def __init__(self,frac,normal=False,blend=.0): self.frac=frac; self.normal=normal; self.blend=blend
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; rng=fnp.random.default_rng(mlp.seed); fin=block(mlp,rng,sc(self.frac,budget,w,d,True),self.blend,True,self.normal); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fin[None,:]],0)
for seed in [123,777,2026]:

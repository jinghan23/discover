/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator

INV=0.3989422804014327
SQ=0.7978845608028654
CUB=0.044715
MIN_SAMPLES=32
MAX_SAMPLES=1_000_000
ARRAY_BYTES_LIMIT=100*1024*1024
WORST=8

def sample_count(frac,budget,width,depth):
    per_sample=depth*(2*width*width+width)+width*width
    fixed=9*width**3+2*(2*width**3)
    k=(int(frac*budget)-fixed)//max(per_sample,1)
    max_k=ARRAY_BYTES_LIMIT//max(width*WORST,1)
    min_k=max(MIN_SAMPLES,2*width+2)
    k=int(max(min_k,min(MAX_SAMPLES,max_k,k)))
    return k-(k&1)

def nrm(mu,var):
    var=fnp.maximum(var,1e-12)
    s=fnp.sqrt(var); a=mu/s
    pdf=INV*fnp.exp(-0.5*a*a)
    cdf=0.5*(1.0+fnp.tanh(SQ*(a+CUB*a*a*a)))
    return s*pdf+mu*cdf

def block(mlp,rng,k,blend=0.05,edge=0.0):
    width=mlp.width
    u=rng.standard_normal((k//2,width),dtype=fnp.float32)
    u=u[:,::-1]
    x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2)
    ch=fnp.linalg.cholesky(cov)
    fw=fnp.linalg.solve(ch.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0.0)
    for w in mlp.weights[1:-1]:
        x=fnp.maximum(x@w,0.0)
    z=x@mlp.weights[-1]
    sm=fnp.mean(fnp.maximum(z,0.0),axis=0)
    mu=fnp.mean(z,axis=0)
    d=z-mu
    var=fnp.maximum(fnp.mean(d*d,axis=0),1e-12)
    nm=nrm(mu,var)
    if edge "'!= 0.0:
        sig=fnp.sqrt(var); a=mu/sig
        pdf=INV*fnp.exp(-0.5*a*a)
        m3=fnp.mean(d*d*d,axis=0)/(sig*sig*sig)
        m4=fnp.mean(d*d*d*d,axis=0)/(var*var)-3.0
        corr=sig*pdf*((m3*(-a))/6.0 + (m4*(a*a-1.0))/24.0)
        # clip just to avoid crazy high moment noise
        corr=fnp.maximum(fnp.minimum(corr, 0.25*nm), -0.25*nm)
        nm=nm+edge*corr
    return (1-blend)*sm+blend*nm

class Two(BaseEstimator):
    def __init__(self, blend=0.05, mf=0.095, ef=0.01022): self.blend=blend; self.mf=mf; self.ef=ef
    def predict(self,mlp,budget):
        rng=fnp.random.default_rng(mlp.seed); w=mlp.width; d=mlp.depth
        km=sample_count(self.mf,budget,w,d); ke=sample_count(self.ef,budget,w,d)
        m=block(mlp,rng,km,self.blend)
        e=block(mlp,rng,ke,self.blend)
        fin=(km*m+ke*e)/float(km+ke)
        return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32), fin[None,:]],axis=0)
class One(BaseEstimator):
    def __init__(self, blend=0.05, frac=0.10522): self.blend=blend; self.frac=frac
    def predict(self,mlp,budget):
        rng=fnp.random.default_rng(mlp.seed); w=mlp.width; d=mlp.depth
        k=sample_count(self.frac,budget,w,d)
        fin=block(mlp,rng,k,self.blend)
        return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32), fin[None,:]],axis=0)
class Edge(BaseEstimator):
    def __init__(self, blend=0.05, edge=1.0): self.blend=blend; self.edge=edge
    def predict(self,mlp,budget):
        rng=fnp.random.default_rng(mlp.seed); w=mlp.width; d=mlp.depth
        km=sample_count(0.095,budget,w,d); ke=sample_count(0.01022,budget,w,d)
        m=block(mlp,rng,km,self.blend,self.edge)
        e=block(mlp,rng,ke,self.blend,self.edge)
        fin=(km*m+ke*e)/float(km+ke)
        return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32), fin[None,:]],axis=0)

def run(spec):
    print('"'spec', spec)
    data=make_contest(spec)
    for name, est in [
        ('two b0',Two(0.0)),('two b03',Two(0.03)),('two b05',Two(0.05)),('two b08',Two(0.08)),('one b05',One(0.05)),('one b03',One(0.03)),('edge b05',Edge(0.05,1.0)),('edge b08',Edge(0.08,1.0))]:
        rep=evaluate_estimator(est,data)
        print(name, rep['adjusted_final_layer_score'], 'mse', rep['final_layer_mse'], 'mult', rep['mean_score_multiplier'], 'C', rep['mean_effective_compute'])


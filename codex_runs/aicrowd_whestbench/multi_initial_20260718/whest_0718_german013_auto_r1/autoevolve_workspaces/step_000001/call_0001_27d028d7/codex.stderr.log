from __future__ import annotations
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; LIM=100*1024*1024

def sc(fr,b,w,d):
 p=d*(2*w*w+w)+w*w; fix=13*w**3; k=(int(fr*b)-fix)//max(p,1); k=int(max(max(32,2*w+2), min(1_000_000,LIM//max(w*8,1), k))); return k-(k&1)
def nrm(mu,var):
 var=fnp.maximum(var,1e-12); s=fnp.sqrt(var); a=mu/s; pdf=INV*fnp.exp(-.5*a*a); cdf=.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a))); return s*pdf+mu*cdf
def block(mlp,rng,k,blend):
 w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(k//2); fw=fnp.linalg.solve(fnp.linalg.cholesky(cov).T, mlp.weights[0]); x=fnp.maximum(x@fw,0)
 for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0)
 z=x@mlp.weights[-1]; sm=fnp.mean(fnp.maximum(z,0),axis=0); mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0); return (1-blend)*sm+blend*nrm(mu,sec-mu*mu)
class One(BaseEstimator):
 def __init__(self, frac, blend): self.frac=frac; self.blend=blend
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; rng=fnp.random.default_rng(mlp.seed); fin=block(mlp,rng,sc(self.frac,budget,w,d),self.blend); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fin[None,:]],0)
class Two(BaseEstimator):
 def __init__(self, blend=0.05): self.blend=blend
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; rng=fnp.random.default_rng(mlp.seed); km=sc(.095,budget,w,d); ke=sc(.01022,budget,w,d); m=block(mlp,rng,km,self.blend); e=block(mlp,rng,ke,self.blend); fin=(km*m+ke*e)/float(km+ke); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fin[None,:]],0)
for width,depth,budget,gt in [(32,8,500_000_000,300_000),(64,16,1_500_000_000,100_000),(128,8,4_000_000_000,80_000)]:
 print('---',width,depth,budget)
 data=make_contest(ContestSpec(width=width,depth=depth,n_mlps=4,flop_budget=budget,ground_truth_samples=gt,seed=1000+width+depth))
 for name,est in [('two',Two(.05)),('one105b05',One(.10522,.05)),('one13b05',One(.13,.05)),('one13b0',One(.13,0.0)),('one16b0',One(.16,0.0))]:
  rep=evaluate_estimator(est,data)
  print(name, rep['adjusted_final_layer_score'], rep['final_layer_mse'], rep['mean_score_multiplier'])

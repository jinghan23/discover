 data=make_contest(ContestSpec(width=64,depth=8,n_mlps=5,flop_budget=1_000_000_000,ground_truth_samples=400_000,seed=seed))
 for name,est in [('basefull',Two(False,False,True,.05)),('basesafehalf',Two(True,False,True,.05)),('halfmore',Two(True,True,True,.05)),('halfplain',Two(True,False,False,0)),('one10plain',One(.10)),('one115plain',One(.115)),('one13plain',One(.13))]:

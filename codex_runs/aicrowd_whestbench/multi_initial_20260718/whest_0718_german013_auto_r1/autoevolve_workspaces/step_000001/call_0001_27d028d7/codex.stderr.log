/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope.numpy as fnp
from whestbench import BaseEstimator
from whestbench.scoring import ContestSpec, make_contest, evaluate_estimator
LIM=100*1024*1024

def sc_old(fr,b,w,d):
 p=d*(2*w*w+w)+w*w; fix=13*w**3; k=(int(fr*b)-fix)//max(p,1); k=int(max(max(32,2*w+2), min(1_000_000,LIM//max(w*8,1), k))); return k-(k&1)
def sc_half(fr,b,w,d):
 # covariance half-sample matmul costs about k*w"'^2; first layer matmul costs k*w''^2 instead of 2*k*w''^2.
 p=(2*d-1)*w*w + d*w + w*w
 fix=13*w**3
 k=(int(fr*b)-fix)//max(p,1); k=int(max(max(32,2*w+2), min(1_000_000,LIM//max(w*8,1), k))); return k-(k&1)
def block_old(mlp,rng,k):
 w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],0); fw=fnp.linalg.solve(fnp.linalg.cholesky((u.T@u)/float(k//2)).T,mlp.weights[0]); x=fnp.maximum(x@fw,0)
 for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)
 return fnp.mean(x,0)
def block_half(mlp,rng,k):
 w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; fw=fnp.linalg.solve(fnp.linalg.cholesky((u.T@u)/float(k//2)).T,mlp.weights[0]); h=u@fw; x=fnp.concatenate([fnp.maximum(h,0),fnp.maximum(-h,0)],0)
 for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)
 return fnp.mean(x,0)
class E(BaseEstimator):
 def __init__(self,fr,half=True,use_half_count=True): self.fr=fr; self.half=half; self.use_half_count=use_half_count
 def predict(self,mlp,budget):
  w=mlp.width; d=mlp.depth; k=(sc_half if self.use_half_count else sc_old)(self.fr,budget,w,d); fin=(block_half if self.half else block_old)(mlp,fnp.random.default_rng(mlp.seed),k); return fnp.concatenate([fnp.zeros((d-1,w),dtype=fnp.float32),fin[None,:]],0)

data=make_contest(ContestSpec(width=64,depth=8,n_mlps=5,flop_budget=1_000_000_000,ground_truth_samples=600_000,seed=2026))
for name,est in [('"'old115',E(.115,False,False)),('half115oldk',E(.115,True,False)),('half115newk',E(.115,True,True)),('half13newk',E(.13,True,True)),('half10newk',E(.10,True,True)),('half145newk',E(.145,True,True)),('half16newk',E(.16,True,True))]:
 rep=evaluate_estimator(est,data)
 print(name,'k', (sc_half if est.use_half_count else sc_old)(est.fr,1_000_000_000,64,8), rep['adjusted_final_layer_score'], rep['final_layer_mse'], rep['mean_score_multiplier'], rep['mean_effective_compute'])

import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import _normal_relu_mean, _radial_mean_factor, Estimator
from whestbench import SetupContext
import flopscope as flops, time

def relu_second(mu,var):
    var=fnp.maximum(var,1e-12); sigma=fnp.sqrt(var); a=mu/sigma
    pdf=0.3989422804014327*fnp.exp(-0.5*a*a)
    cdf=0.5*(1.0+fnp.tanh(0.7978845608028654*(a+0.044715*a*a*a)))
    return (var+mu*mu)*cdf + mu*sigma*pdf

def diag(mlp):
    w=mlp.width
    mean=fnp.zeros(w,dtype=fnp.float32)
    second=fnp.ones(w,dtype=fnp.float32)
    for W in mlp.weights:
        mu=mean @ W
        var=(second-mean*mean) @ (W*W)
        mean=_normal_relu_mean(mu,var)
        second=relu_second(mu,var)
    return mean
W=256;D=32;B=272_000_000_000;SEED=1234
ss=fnp.random.SeedSequence(SEED).spawn(3)

est=Estimator(); t=time.time(); est.setup(ctx); print('setup',time.time()-t)
stream=fnp.random.SeedSequence(SEED).spawn(3*M)
# Use each prepared candidate; careful estimator._prepared_index
outs=[]
for i in range(M):
    mlp_ss,sample_ss,est_ss=stream[3*i],stream[3*i+1],stream[3*i+2]
    seed=int(est_ss.generate_state(1)[0])
    mlp=sample_mlp(W,D,fnp.random.default_rng(mlp_ss),seed=seed)
    prep=est._prepared_blocks[i]
    main,extra=_estimate_pair_from_activation(mlp, prep[1], prep[2], est._pre_layers, est._radial_factor)
    print('target',i); t=time.time(); _,target,_=sample_layer_statistics(mlp,N,rng=fnp.random.default_rng(sample_ss)); print('target_s',time.time()-t)
    outs.append((main,extra,target))
# Grid for extra weight scale when base final=(km main + s*ke extra)/(km+s*ke)
km=int(est._prepared_blocks[0][3]); ke=int(est._prepared_blocks[0][4])
for s in [0,0.3,0.6,0.9,1.1,1.3,1.5,1.8,2.2,3.0]:

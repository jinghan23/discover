/bin/bash -lc "python - <<'PY'
import math, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics

INV=0.3989422804014327
SQ=0.7978845608028654
CUB=0.044715
MIN=32
MAX=1000000
BYTES=100*1024*1024
ITEM=8

def sample_count(frac,budget,w,d):
    per=d*(2*w*w+w)+w*w
    fixed=9*w**3+2*(2*w**3)
    k=(int(frac*budget)-fixed)//max(per,1)
    maxk=BYTES//max(w*ITEM,1)
    mink=max(MIN,2*w+2)
    k=int(max(mink,min(MAX,maxk,k)))
    return k-(k&1)

def nrelu(mu,var):
    var=fnp.maximum(var,1e-12)
    sig=fnp.sqrt(var)
    a=mu/sig
    pdf=INV*fnp.exp(-0.5*a*a)
    cdf=0.5*(1.0+fnp.tanh(SQ*(a+CUB*a*a*a)))
    return sig*pdf+mu*cdf

def block(mlp,rng,k,blend):
    w=mlp.width
    u=rng.standard_normal((k//2,w),dtype=fnp.float32)
    u=u[:,::-1]
    x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2)
    chol=fnp.linalg.cholesky(cov)
    fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0.0)
    for weight in mlp.weights[1:-1]:
        x=fnp.maximum(x@weight,0.0)
    z=x@mlp.weights[-1]
    sm=fnp.mean(fnp.maximum(z,0.0),axis=0)
    if blend==0:
        return sm
    mu=fnp.mean(z,axis=0)
    sec=fnp.mean(z*z,axis=0)
    nm=nrelu(mu,sec-mu*mu)
    return (1-blend)*sm+blend*nm

def pred(mlp,budget,mode):
    rng=fnp.random.default_rng(mlp.seed)
    if mode[0]=='two':
        f1,f2,blend,comb=mode[1:]
        k1=sample_count(f1,budget,mlp.width,mlp.depth)
        k2=sample_count(f2,budget,mlp.width,mlp.depth)
        m1=block(mlp,rng,k1,blend)
        m2=block(mlp,rng,k2,blend)
        if comb=='weighted':
            return (k1*m1+k2*m2)/float(k1+k2)
        if comb=='rich':
            return (k1*m1-k2*m2)/float(k1-k2)
        beta=comb
        return m1+beta*(m1-m2)
    else:
        frac,blend=mode[1:]
        k=sample_count(frac,budget,mlp.width,mlp.depth)
        return block(mlp,rng,k,blend)

def eval_modes(w=64,d=32,b=10_000_000_000,n_mlps=4,target_n=200000):
    modes=[]
    for frac in [0.085,0.09,0.095,0.10,0.105,0.11]:
        for blend in [0.0,0.02,0.05,0.08,0.12,0.2]:
            modes.append(('one',frac,blend))
    for extra in [0.005,0.01022,0.015]:
        for blend in [0.0,0.03,0.05,0.08,0.12]:
            modes.append(('two',0.095,extra,blend,'weighted'))
    modes += [('two',0.095,0.01022,0.05,'rich')]
    scores={m:[] for m in modes}; fls={m:[] for m in modes}
    for i in range(n_mlps):
        rng=fnp.random.default_rng(1000+i)
        mlp=sample_mlp(w,d,rng,seed=2000+i)
        with flops.BudgetContext(flop_budget=int(1e16),quiet=True):
            _,target,_=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(3000+i))
        for m in modes:
            with flops.BudgetContext(flop_budget=b,quiet=True) as ctx:
                y=pred(mlp,b,m)
            mse=float(fnp.mean((y-target)**2))
            ratio=max(0.1,(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0.0))/b)
            scores[m].append(mse*ratio)
            fls[m].append(ctx.flops_used/b)
        print('done mlp',i+1)
    res=[]
    for m,ss in scores.items():
        res.append((sum(ss)/len(ss),sum(fls[m])/len(fls[m]),m))
    res.sort()
    for s,fr,m in res[:20]:
        print(f'{s:.4e} fl {fr:.4f} {m}')

t=time.time(); eval_modes(); print('elapsed',time.time()-t)

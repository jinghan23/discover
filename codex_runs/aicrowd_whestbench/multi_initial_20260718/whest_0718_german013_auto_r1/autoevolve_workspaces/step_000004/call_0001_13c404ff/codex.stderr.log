import flopscope.numpy as fnp
from dataclasses import replace
from whestbench.generation import sample_mlp
MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def sc(frac,b,w,d):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3; k=(int(frac*b)-fixed)//per; maxk=BYTES//(w*ITEM); mink=max(MIN,2*w+2); k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def block(mlp,rng,k):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)
    return fnp.mean(x,axis=0)
def pred(mlp,b,mode):
    rng=fnp.random.default_rng(mlp.seed)
    if mode=='one100': return block(mlp,rng,sc(0.1,b,mlp.width,mlp.depth))
    if mode=='one105': return block(mlp,rng,sc(0.105,b,mlp.width,mlp.depth))
    k1=sc(0.095,b,mlp.width,mlp.depth); k2=sc(0.01022,b,mlp.width,mlp.depth); m1=block(mlp,rng,k1); m2=block(mlp,rng,k2); return (k1*m1+k2*m2)/float(k1+k2)
for w,d,b,reps in [(128,32,50_000_000_000,30),(256,32,272_000_000_000,16)]:
    mlp0=sample_mlp(w,d,fnp.random.default_rng(42),seed=100)
    vals={m:[] for m in ['one100','one105','two']}; fl={m:[] for m in vals}
    for r in range(reps):
        mlp=replace(mlp0, seed=1000+r)
        for m in vals:
            with flops.BudgetContext(flop_budget=b,quiet=True) as ctx: y=pred(mlp,b,m)
            vals[m].append(y); fl[m].append(ctx.flops_used/b)
    print('\\nspec',w,d)
    for m,ys in vals.items():
        stack=fnp.stack(ys)
        var=float(fnp.mean(fnp.var(stack,axis=0)))
        print(m,'mean_var_across_seeds',var,'fl',sum(fl[m])/len(fl[m]))

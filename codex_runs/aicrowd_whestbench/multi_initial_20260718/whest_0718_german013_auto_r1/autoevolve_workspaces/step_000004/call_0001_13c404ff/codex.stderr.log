    modes=[('two',0.095,0.01022,0.0),('two',0.095,0.01022,0.03),('two',0.095,0.01022,0.05),('two',0.095,0.005,0.0),('one',0.10,0.0),('one',0.105,0.0),('one',0.11,0.0),('one',0.105,0.05)]

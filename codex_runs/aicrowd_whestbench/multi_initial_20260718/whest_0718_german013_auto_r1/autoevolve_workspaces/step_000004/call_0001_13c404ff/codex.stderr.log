INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def sc(frac,b,w,d):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3
    k=(int(frac*b)-fixed)//max(per,1); maxk=BYTES//max(w*ITEM,1); mink=max(MIN,2*w+2)
    k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def nr(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig
    pdf=INV*fnp.exp(-0.5*a*a); cdf=0.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a)))
    return sig*pdf+mu*cdf
def block(mlp,rng,k,blend):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]
    x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0)
    z=x@mlp.weights[-1]; sm=fnp.mean(fnp.maximum(z,0),axis=0)
    if blend==0: return sm
    mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0); return (1-blend)*sm+blend*nr(mu,sec-mu*mu)
def pred(mlp,b,mode):
    rng=fnp.random.default_rng(mlp.seed)
    typ=mode[0]
    if typ=='two':
        _,f1,f2,blend=mode; k1=sc(f1,b,mlp.width,mlp.depth); k2=sc(f2,b,mlp.width,mlp.depth)
        m1=block(mlp,rng,k1,blend); m2=block(mlp,rng,k2,blend); return (k1*m1+k2*m2)/float(k1+k2)
    _,frac,blend=mode; return block(mlp,rng,sc(frac,b,mlp.width,mlp.depth),blend)

def run(spec):

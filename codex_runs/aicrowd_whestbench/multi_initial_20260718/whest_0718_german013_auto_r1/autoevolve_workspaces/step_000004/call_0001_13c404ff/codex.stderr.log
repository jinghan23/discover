import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; PI=3.141592653589793; MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def cdf_approx(a): return 0.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a)))
def nrelu(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig; pdf=INV*fnp.exp(-0.5*a*a); cdf=cdf_approx(a); return sig*pdf+mu*cdf
def nrelu_mom(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig; pdf=INV*fnp.exp(-0.5*a*a); cdf=cdf_approx(a)
    mean=sig*pdf+mu*cdf; second=(var+mu*mu)*cdf+mu*sig*pdf; return mean, second
def diag_analytic(mlp):
    w=mlp.width; m=fnp.zeros(w,dtype=fnp.float32); v=fnp.ones(w,dtype=fnp.float32)
    for wt in mlp.weights:
        mu=m@wt; var=v@(wt*wt); m,sec=nrelu_mom(mu,var); v=fnp.maximum(sec-m*m,1e-12)
    return m
def full_analytic(mlp):
    w=mlp.width; eye=fnp.eye(w,dtype=fnp.float32); one=1.0-eye
    m=fnp.zeros(w,dtype=fnp.float32); C=fnp.eye(w,dtype=fnp.float32)
    first=True
    for wt in mlp.weights:
        mu=m@wt
        S=wt.T@C@wt
        var=fnp.maximum(fnp.diagonal(S),1e-12)
        sig=fnp.sqrt(var)
        mean,sec=nrelu_mom(mu,var)
        diag=fnp.maximum(sec-mean*mean,1e-12)
        if first:
            denom=sig[:,None]*sig[None,:]
            rho=fnp.clip(S/denom,-0.999999,0.999999)
            eij=denom/(2*PI)*(fnp.sqrt(fnp.maximum(1-rho*rho,0.0))+(PI-fnp.arccos(rho))*rho)
            C=eij-mean[:,None]*mean[None,:]
            C=C*one+diag[:,None]*eye
            first=False
        else:
            a=mu/sig; p=cdf_approx(a)
            C=S*(p[:,None]*p[None,:])
            C=C*one+diag[:,None]*eye
        m=mean
    return m

def sc(frac,b,w,d,extra_fixed=0):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3+extra_fixed
    k=(int(frac*b)-fixed)//max(per,1); maxk=BYTES//max(w*ITEM,1); mink=max(MIN,2*w+2)
    k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def block(mlp,rng,k):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]
    x=fnp.concatenate([u,-u],axis=0); cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)
    return fnp.mean(x,axis=0)
def mc_two(mlp,b):
    rng=fnp.random.default_rng(mlp.seed); k1=sc(0.095,b,mlp.width,mlp.depth); k2=sc(0.01022,b,mlp.width,mlp.depth)
    m1=block(mlp,rng,k1); m2=block(mlp,rng,k2); return (k1*m1+k2*m2)/float(k1+k2)

def run(spec):
    w,d,b,n_mlps,target_n=spec
    alphas=[0,0.01,0.02,0.03,0.05,0.08,0.12,0.2]
    acc={('diag',a):[] for a in alphas}; acc.update({('full',a):[] for a in alphas}); acc['diag_only']=[]; acc['full_only']=[]
    for i in range(n_mlps):
        mlp=sample_mlp(w,d,fnp.random.default_rng(7000+i),seed=8000+i)
        with flops.BudgetContext(flop_budget=int(1e16),quiet=True): _,target,_=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(9000+i))
        with flops.BudgetContext(flop_budget=b,quiet=True) as ctx: mc=mc_two(mlp,b)
        with flops.BudgetContext(flop_budget=b,quiet=True) as ctd: da=diag_analytic(mlp)
        with flops.BudgetContext(flop_budget=b,quiet=True) as ctf: fa=full_analytic(mlp)
        for a in alphas:
            acc[('diag',a)].append(float(fnp.mean(((1-a)*mc+a*da-target)**2))*max(0.1,(ctx.flops_used+ctd.flops_used)/b))
            acc[('full',a)].append(float(fnp.mean(((1-a)*mc+a*fa-target)**2))*max(0.1,(ctx.flops_used+ctf.flops_used)/b))
        acc['diag_only'].append(float(fnp.mean((da-target)**2))*max(0.1,ctd.flops_used/b))
        acc['full_only'].append(float(fnp.mean((fa-target)**2))*max(0.1,ctf.flops_used/b))
    print('\\nspec',spec,'diag_fl',ctd.flops_used/b,'full_fl',ctf.flops_used/b,'mc_fl',ctx.flops_used/b)
    for s,m in sorted((sum(v)/len(v),k) for k,v in acc.items())[:16]: print(f'{s:.4e}',m)
start=time.time()
for spec in [(64,32,10_000_000_000,4,200000),(128,32,50_000_000_000,3,100000),(64,64,20_000_000_000,3,150000),(256,16,100_000_000_000,2,50000)]: run(spec)
print('elapsed',time.time()-start)

modes=[('two',0.095,0.01022,0.05),('two',0.095,0.01022,0.0),('two',0.095,0.005,0.0),('two',0.09,0.01022,0.0),('one',0.1,0.0),('one',0.105,0.0),('one',0.11,0.0),('one',0.105,0.05),('two',0.095,0.01022,0.02),('two',0.1,0.005,0.0)]
acc={m:[] for m in modes}; fl={m:[] for m in modes}; mseacc={m:[] for m in modes}

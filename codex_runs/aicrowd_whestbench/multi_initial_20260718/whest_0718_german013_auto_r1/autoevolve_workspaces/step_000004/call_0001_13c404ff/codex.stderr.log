/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def sc(frac,b,w,d):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3
    k=(int(frac*b)-fixed)//per; maxk=BYTES//(w*ITEM); mink=max(MIN,2*w+2)
    k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def nr(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig; pdf=INV*fnp.exp(-0.5*a*a); cdf=0.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a))); return sig*pdf+mu*cdf
def block(mlp,rng,k,blend):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0)
    z=x@mlp.weights[-1]; sm=fnp.mean(fnp.maximum(z,0),axis=0)
    if blend==0: return sm
    mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0); return (1-blend)*sm+blend*nr(mu,sec-mu*mu)
def pred(mlp,b,mode):
    rng=fnp.random.default_rng(mlp.seed)
    f1,f2,blend=mode
    if f2==0:
        return block(mlp,rng,sc(f1,b,mlp.width,mlp.depth),blend)
    k1=sc(f1,b,mlp.width,mlp.depth); k2=sc(f2,b,mlp.width,mlp.depth); m1=block(mlp,rng,k1,blend); m2=block(mlp,rng,k2,blend); return (k1*m1+k2*m2)/float(k1+k2)

w=64; d=32; b=10_000_000_000; n_mlps=12; target_n=300000
modes=[]
for f1 in [0.085,0.09,0.0925,0.095,0.0975,0.10,0.1025,0.105,0.1075,0.11]:
  for f2 in [0,0.0025,0.005,0.0075,0.01022,0.0125,0.015]:
    if f2==0 and f1<0.095: pass
    for blend in [0,0.01,0.02,0.03,0.05,0.08]:
      modes.append((f1,f2,blend))
# reduce invalid huge combined? keep all; budget ctx catches maybe, sample_count approximates
acc={m:[] for m in modes}; fl={m:[] for m in modes}
start=time.time()
for i in range(n_mlps):
    mlp=sample_mlp(w,d,fnp.random.default_rng(123456+i),seed=654321+i)
    with flops.BudgetContext(flop_budget=int(1e16),quiet=True): _,target,_=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(888888+i))
    for m in modes:
        try:
            with flops.BudgetContext(flop_budget=b,quiet=True) as ctx: y=pred(mlp,b,m)
            ratio=max(0.1,(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/b)
            acc[m].append(float(fnp.mean((y-target)**2))*ratio); fl[m].append(ctx.flops_used/b)
        except Exception:
            acc[m].append(999); fl[m].append(999)
    print('mlp',i+1,'elapsed',time.time()-start)
res=sorted((sum(acc[m])/len(acc[m]),sum(fl[m])/len(fl[m]),m) for m in modes)
for s,fr,m in res[:30]: print(f'{s:.6e} fl {fr:.5f} {m} k {sc(m[0],b,w,d)} {sc(m[1],b,w,d) if m[1] else 0}')
print('current',[(s,fr,m) for s,fr,m in res if m==(0.095,0.01022,0.05)][:1])
print('elapsed',time.time()-start)

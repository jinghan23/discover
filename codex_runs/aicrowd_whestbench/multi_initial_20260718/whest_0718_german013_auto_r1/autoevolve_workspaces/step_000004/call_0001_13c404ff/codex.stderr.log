import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def sc(frac,b,w,d):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3; k=(int(frac*b)-fixed)//per; maxk=BYTES//(w*ITEM); mink=max(MIN,2*w+2); k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def nr(mu,var):
    var=fnp.maximum(var,1e-12); sig=fnp.sqrt(var); a=mu/sig; pdf=INV*fnp.exp(-0.5*a*a); cdf=0.5*(1+fnp.tanh(SQ*(a+CUB*a*a*a))); return sig*pdf+mu*cdf
def block(mlp,rng,k,blend=0):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:-1]: x=fnp.maximum(x@wt,0)
    z=x@mlp.weights[-1]
    sm=fnp.mean(fnp.maximum(z,0),axis=0)
    if blend==0: return sm
    mu=fnp.mean(z,axis=0); sec=fnp.mean(z*z,axis=0); return (1-blend)*sm+blend*nr(mu,sec-mu*mu)
def pred(mlp,b,m):
    rng=fnp.random.default_rng(mlp.seed)
    if m[0]=='one': return block(mlp,rng,sc(m[1],b,mlp.width,mlp.depth),m[2])
    k1=sc(m[1],b,mlp.width,mlp.depth); k2=sc(m[2],b,mlp.width,mlp.depth); m1=block(mlp,rng,k1,m[3]); m2=block(mlp,rng,k2,m[3]); return (k1*m1+k2*m2)/float(k1+k2)

w=256; d=32; b=272_000_000_000; target_n=100000; n_mlps=20
modes=[('two',0.095,0.01022,0.05),('two',0.095,0.01022,0),('two',0.09,0.01022,0),('one',0.1,0),('one',0.105,0),('one',0.095,0)]
acc={m:[] for m in modes}; ms={m:[] for m in modes}; fl={m:[] for m in modes}
start=time.time()
for i in range(n_mlps):
    mlp=sample_mlp(w,d,fnp.random.default_rng(24000+i),seed=25000+i)
    with flops.BudgetContext(flop_budget=int(1e17),quiet=True): _,target,_=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(26000+i))
    for m in modes:
        with flops.BudgetContext(flop_budget=b,quiet=True) as ctx: y=pred(mlp,b,m)
        mse=float(fnp.mean((y-target)**2)); ratio=max(0.1,(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/b)
        acc[m].append(mse*ratio); ms[m].append(mse); fl[m].append(ctx.flops_used/b)
    if (i+1)%5==0: print('mlp',i+1,'elapsed',time.time()-start)
print('\\nresults')
for s,mse,fr,m in sorted((sum(acc[m])/len(acc[m]),sum(ms[m])/len(ms[m]),sum(fl[m])/len(fl[m]),m) for m in modes): print(f'{s:.6e} mse {mse:.6e} fl {fr:.5f} {m}')
print('elapsed',time.time()-start)

# Compute predicted sample counts and approximate measured flops for fraction combos by executing small variants.
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
INV=0.3989422804014327; SQ=0.7978845608028654; CUB=0.044715; MIN=32; MAX=1000000; BYTES=100*1024*1024; ITEM=8

def sc(frac,b,w,d):
    per=d*(2*w*w+w)+w*w; fixed=13*w**3; k=(int(frac*b)-fixed)//per; maxk=BYTES//(w*ITEM); mink=max(MIN,2*w+2); k=int(max(mink,min(MAX,maxk,k))); return k-(k&1)
def block(mlp,rng,k):
    w=mlp.width; u=rng.standard_normal((k//2,w),dtype=fnp.float32); u=u[:,::-1]; x=fnp.concatenate([u,-u],axis=0)
    cov=(u.T@u)/float(k//2); chol=fnp.linalg.cholesky(cov); fw=fnp.linalg.solve(chol.T,mlp.weights[0])
    x=fnp.maximum(x@fw,0)
    for wt in mlp.weights[1:]: x=fnp.maximum(x@wt,0)
    return fnp.mean(x,axis=0)
def pred(mlp,b,f1,f2):
    rng=fnp.random.default_rng(mlp.seed); k1=sc(f1,b,mlp.width,mlp.depth); m1=block(mlp,rng,k1)
    if f2<=0: return m1
    k2=sc(f2,b,mlp.width,mlp.depth); m2=block(mlp,rng,k2); return (k1*m1+k2*m2)/float(k1+k2)
mlp=sample_mlp(256,32,fnp.random.default_rng(123),seed=456); b=272_000_000_000
for f1,f2 in [(0.09,0.01022),(0.091,0.01022),(0.092,0.01022),(0.093,0.01022),(0.095,0.005),(0.095,0.0075),(0.095,0.01022),(0.1,0),(0.102,0),(0.105,0)]:
    with flops.BudgetContext(flop_budget=b,quiet=True) as ctx: pred(mlp,b,f1,f2)
    eff=(ctx.flops_used+1e11*(ctx.residual_wall_time_s or 0))/b
    print((f1,f2),'k',sc(f1,b,256,32),sc(f2,b,256,32) if f2 else 0,'fl',ctx.flops_used/b,'eff',eff,'resid',ctx.residual_wall_time_s)

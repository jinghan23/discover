+def _normal_relu_moments(mu, var):
+    var = fnp.maximum(var, 1e-12)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    cdf = 0.5 * (
+        1.0
+        + fnp.tanh(_SQRT_2_OVER_PI * (alpha + _CDF_CUBIC * alpha * alpha * alpha))
+    )
+    mean = sigma * pdf + mu * cdf
+    second = (var + mu * mu) * cdf + mu * sigma * pdf
+    return mean, second
+
+
+def _diagonal_estimate(mlp):
+    width = mlp.width
+    mean = fnp.zeros(width, dtype=fnp.float32)
+    second = fnp.ones(width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        var_in = fnp.maximum(second - mean * mean, 0.0)
+        mu = mean @ weight
+        var = var_in @ (weight * weight)
+        mean, second = _normal_relu_moments(mu, var)
+    return mean
+

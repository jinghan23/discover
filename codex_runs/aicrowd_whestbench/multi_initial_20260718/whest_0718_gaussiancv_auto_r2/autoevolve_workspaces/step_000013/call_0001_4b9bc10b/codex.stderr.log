codex
Before adding a larger analytic feature to the submitted file, I’m using synthetic MLPs from the public generator logic offline to see whether a full-covariance approximation has useful residual signal. This does not read hidden data and won’t be used as a target source.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
try:
    from scipy.special import ndtr
    import scipy.stats
    HAVE=True
except Exception as e:
    HAVE=False
    print('no scipy',e)

def phi(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)
def Phi(x):
    if HAVE: return ndtr(x)
    return 0.5*(1+np.vectorize(math.erf)(x/math.sqrt(2)))

def relu_mom(mu,var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; c=Phi(a); p=phi(a)
    m=mu*c+sig*p
    e2=(mu*mu+var)*c+mu*sig*p
    return m, np.maximum(e2-m*m,0), e2

def features(weights, seed, budget=1e9, factor=0.5, n_samples=4096):
    width=weights[0].shape[0]; depth=len(weights)
    d_mu=np.zeros(width); d_var=np.ones(width); diag_rows=[]; diag_vars=[]; pre_mus=[]
    for w in weights:
        d_mu_pre=w.T@d_mu
        d_var_pre=np.maximum((w*w).T@d_var,1e-12)
        d_mu,d_var,e2=relu_mom(d_mu_pre,d_var_pre)
        diag_rows.append(d_mu); diag_vars.append(d_var); pre_mus.append(d_mu_pre)
    # fullcov linear gate approx
    f_mu=np.zeros(width); f_second=np.eye(width); full_rows=[]
    for w in weights:
        mu_pre=w.T@f_mu
        pre_second=w.T@(f_second@w)
        pre_cov=pre_second-np.outer(mu_pre,mu_pre)
        pre_cov=0.5*(pre_cov+pre_cov.T)
        var=np.maximum(np.diag(pre_cov),1e-12)
        sig=np.sqrt(var); a=mu_pre/sig; c=Phi(a); p=phi(a)
        m=mu_pre*c+sig*p
        e2=(mu_pre*mu_pre+var)*c+mu_pre*sig*p
        # gate product covariance approx
        cov_post=pre_cov*np.outer(c,c)
        second=np.outer(m,m)+cov_post
        np.fill_diagonal(second,e2)
        f_mu=m; f_second=0.5*(second+second.T); full_rows.append(m)
    rng=np.random.default_rng(int(seed)+2)
    half=n_samples//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],0).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            z_center=z-z.mean(0)
            sample_cov=z_center.T@z_center/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            t_vals,t_vecs=np.linalg.eigh(t_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            z=z_center@(inv_sqrt@target_sqrt)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(0); x_center=x-x_mean0; sample_cov=x_center.T@x_center/n_samples
            s_vals,s_vecs=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); scale=np.maximum(np.outer(sigma0,sigma0),1e-12)
            rho=np.clip(t_cov/scale,-.999999,.999999); root=np.sqrt(np.maximum(1-rho*rho,0)); pi=math.pi
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            target_second=np.outer(sigma0,sigma0)*kernel
            target_cov=target_second-np.outer(diag_rows[0],diag_rows[0]); target_cov=0.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            t_vals,t_vecs=np.linalg.eigh(target_cov)
            inv_sqrt=s_vecs@(np.diag(1/np.sqrt(np.maximum(s_vals,1e-12)))@s_vecs.T)
            target_sqrt=t_vecs@(np.diag(np.sqrt(np.maximum(t_vals,1e-12)))@t_vecs.T)
            x_full=x_center@(inv_sqrt@target_sqrt)+diag_rows[0]
            x=diag_rows[0]-.245*(x_mean0-diag_rows[0])+1.49*(x_full-diag_rows[0])-.49*x_center
    z=x@weights[-1]
    z_mean=z.mean(0); zc=z-z_mean; z_var=(zc*zc).mean(0); z_sig=np.sqrt(np.maximum(z_var,1e-12))
    gauss=relu_mom(z_mean,z_var)[0]
    mu_pre=pre_mus[-1]
    mixed=mu_pre*Phi(mu_pre/z_sig)+z_sig*phi(mu_pre/z_sig)
    mc=np.maximum(z,0).mean(0)
    cur=.99965*(1.034*mc-.039*gauss+.005*mixed)
    return np.vstack([mc,gauss,mixed,full_rows[-1],cur,diag_rows[-1]])

def target(weights, seed, n=100000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+12345)
    bs=10000; s=np.zeros(width); done=0
    while done<n:
        m=min(bs,n-done); x=rng.standard_normal((m,width)).astype(np.float64)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n

for width,depth in [(32,8),(64,8),(32,16)]:
  rng=np.random.default_rng(123)
  X=[]; y=[]; t0=time.time()
  for k in range(8):
    weights=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float64) for _ in range(depth)]
    feat=features(weights,k,n_samples=4096)
    tar=target(weights,k,n=30000)
    X.append(feat.T); y.append(tar)
  X=np.concatenate(X,0); y=np.concatenate(y,0)
  names=['mc','gauss','mixed','full','cur','diag']
  print('\\n',width,depth,'time',time.time()-t0)
  for i,nm in enumerate(names): print(nm, np.mean((X[:,i]-y)**2), 'bias', np.mean(X[:,i]-y))
  # fit residual from cur with full/diag/mixed/mc features no intercept maybe
  A=np.column_stack([X[:,0],X[:,1],X[:,2],X[:,3],np.ones(len(y))])
  coef=np.linalg.lstsq(A,y,rcond=None)[0]
  pred=A@coef
  print('fit',coef,'mse',np.mean((pred-y)**2))

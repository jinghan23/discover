# Lightweight synthetic screen for hidden centered scaling. Uses independent synthetic MLPs only.
import numpy as np, math
from scipy.special import ndtr

def phi(x): return np.exp(-0.5*x*x)/math.sqrt(2*math.pi)
def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-12)); a=mu/sig; c=ndtr(a); p=phi(a)
    m=mu*c+sig*p; e2=(mu*mu+var)*c+mu*sig*p
    return m, np.maximum(e2-m*m,0), e2

def pred(weights, seed, n=4096, center_scale=1.0):
    width=weights[0].shape[0]; depth=len(weights)
    d_mu=np.zeros(width); d_var=np.ones(width); rows=[]; vars=[]
    for w in weights:
        mp=w.T@d_mu; vp=np.maximum((w*w).T@d_var,1e-12)
        d_mu,d_var,_=relu_mom(mp,vp); rows.append(d_mu); vars.append(d_var)
    rng=np.random.default_rng(seed+2); half=n//2
    x0=rng.standard_normal((half,width)).astype(np.float32); x=np.concatenate([x0,-x0]).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            tc=w.T@w; zc=z-z.mean(0); sc=zc.T@zc/n
            sv,se=np.linalg.eigh(sc); tv,te=np.linalg.eigh(tc)
            z=zc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n; sv,se=np.linalg.eigh(sc)
            sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); rho=np.clip(tc/np.maximum(np.outer(sig,sig),1e-12),-.999999,.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
            tsecond=np.outer(sig,sig)*ker; tcov=tsecond-np.outer(rows[0],rows[0]); tcov=.5*(tcov+tcov.T); np.fill_diagonal(tcov,vars[0])
            tv,te=np.linalg.eigh(tcov)
            xfull=xc@(se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T) @ (te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)))+rows[0]
            x=rows[0]-.245*(xm-rows[0])+1.49*(xfull-rows[0])-.49*xc
        elif center_scale "'!= 1.0:
            xm=x.mean(0); x=xm+center_scale*(x-xm)
    z=(x@weights[-1]).astype(np.float32).astype(np.float64)
    zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs; c=ndtr(a); p=phi(a)
    gauss=zm*c+zs*p
    md=mp*ndtr(mp/zs)+zs*phi(mp/zs)
    mc=np.maximum(z,0).mean(0)
    return .99965*(1.034*mc-.039*gauss+.005*md)

def target(weights, seed, n=60000):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed+999); s=np.zeros(width); done=0
    while done<n:
        m=min(10000,n-done); x=rng.standard_normal((m,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); done+=m
    return s/n
for scale in [0.98,0.99,0.995,1.0,1.005,1.01,1.02]:
    ms=[]
    rng=np.random.default_rng(7)
    for k in range(10):
        width=64; depth=12
        weights=[rng.standard_normal((width,width))*math.sqrt(2/width) for _ in range(depth)]
        y=target(weights,k,n=30000); pr=pred(weights,k,n=4096,center_scale=scale)
        ms.append(np.mean((pr-y)**2))
    print(scale, np.mean(ms))

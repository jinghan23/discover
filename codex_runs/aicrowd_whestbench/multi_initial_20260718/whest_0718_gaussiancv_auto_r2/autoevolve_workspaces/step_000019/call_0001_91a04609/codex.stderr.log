/bin/bash -lc "python - <<'PY'
# Synthetic-only experiment: generated weights and generated Monte Carlo targets.
import numpy as np
from math import erf, sqrt, pi

def norm_pdf(x): return np.exp(-0.5*x*x)/sqrt(2*pi)
def norm_cdf(x): return 0.5*(1+np.vectorize(erf)(x/sqrt(2)))

def diag_prop(weights):
    w0=weights[0].shape[0]
    mu=np.zeros(w0); var=np.ones(w0)
    rows=[]; vars=[]; pre=[]
    for w in weights:
        mu_pre=w.T@mu
        var_pre=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(var_pre); alpha=mu_pre/sig
        phi=norm_pdf(alpha); cdf=norm_cdf(alpha)
        mu=mu_pre*cdf+sig*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu); vars.append(var); pre.append(mu_pre)
    return rows,vars,pre[-1]

def estimator(weights, budget=1e9, n=8192, seed=2, factor_params=(-.245,1.49,-.49), blend=(.99965,1.034,-.039,.005), g_override=None):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,d_mu_pre=diag_prop(weights)
    rng=np.random.default_rng(seed)
    half=n//2
    x0=rng.standard_normal((half,width)).astype(np.float32)
    x=np.concatenate([x0,-x0],axis=0).astype(np.float64)
    eye=np.eye(width)
    for i,w in enumerate(weights[:-1]):
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-z.mean(axis=0)
            scov=zc.T@zc/n
            sv, svec=np.linalg.eigh(scov)
            tv, tvec=np.linalg.eigh(t_cov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(axis=0); xc=x-xm
            scov=xc.T@xc/n
            sv,svec=np.linalg.eigh(scov)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            rho=np.clip(t_cov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-.999999,.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
            tsecond=(sigma[:,None]*sigma[None,:])*kernel
            tcov=tsecond-rows[0][:,None]*rows[0][None,:]
            tcov=.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
            tv,tvec=np.linalg.eigh(tcov)
            inv=svec@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@svec.T)
            ts=tvec@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tvec.T)
            xfull=xc@(inv@ts)+rows[0]
            A,B,C=factor_params
            x=rows[0]+A*(xm-rows[0])+B*(xfull-rows[0])+C*xc
    z=x@weights[-1]
    z=z.astype(np.float32)
    zm=z.mean(axis=0); zc=z-zm; zv=(zc*zc).mean(axis=0); zs=np.sqrt(np.maximum(zv,1e-12)); za=zm/zs
    c=norm_cdf(za); p=norm_pdf(za)
    gauss=zm*c+zs*p
    za_md=d_mu_pre/zs
    mixed=d_mu_pre*norm_cdf(za_md)+zs*norm_pdf(za_md)
    mc=np.maximum(z,0).mean(axis=0)
    scale,a,b,cc=blend
    return scale*(a*mc+b*gauss+cc*mixed)

def target(weights, n=400000, seed=123):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    batch=20000
    s=np.zeros(width); total=0
    for _ in range(n//batch):
        x=rng.standard_normal((batch,width)).astype(np.float32)
        for w in weights:
            x=np.maximum(x@w,0)
        s+=x.sum(axis=0); total+=batch
    return s/total

for depth in [3,5,8]:
  errs=[]
  for mseed in range(5):
    rng=np.random.default_rng(1000+depth*10+mseed)
    width=32
    weights=[rng.normal(0,1/np.sqrt(width),(width,width)) for _ in range(depth)]
    t=target(weights,n=200000,seed=9000+mseed)
    for name,blend in [('old',(.99965,1.034,-.039,.005)),('g35',(.99965,1.030,-.035,.005)),('g31',(.99965,1.026,-.031,.005))]:
      y=estimator(weights,n=8192,seed=2,blend=blend)
      errs.append((name,depth,((y-t)**2).mean()))
  print('depth',depth)
  for name in ['old','g35','g31']:
    vals=[e for n,d,e in errs if n==name and d==depth]
    print(name, np.mean(vals), np.median(vals))

import numpy as np
from math import erf, sqrt, pi

def pdf(x): return np.exp(-.5*x*x)/sqrt(2*pi)
def cdf(x): return .5*(1+np.vectorize(erf)(x/sqrt(2)))
def relu_mom(mu,var):
    var=np.maximum(var,1e-12); sig=np.sqrt(var); a=mu/sig; ph=pdf(a); cd=cdf(a)
    m=mu*cd+sig*ph
    e2=(mu*mu+var)*cd+mu*sig*ph
    return m,e2

def full_prop(weights):
    w=weights[0].shape[0]
    mu=np.zeros(w); second=np.eye(w)
    rows=[]
    for W in weights:
        pre_mean=W.T@mu
        pre_second=W.T@second@W
        pre_var=np.maximum(np.diag(pre_second)-pre_mean*pre_mean,1e-12)
        m,e2=relu_mom(pre_mean,pre_var)
        rows.append(m)
        cov=pre_second-pre_mean[:,None]*pre_mean[None,:]
        sig=np.sqrt(np.maximum(np.diag(cov),1e-12))
        rho=np.clip(cov/np.maximum(sig[:,None]*sig[None,:],1e-12),-.999999,.999999)
        root=np.sqrt(np.maximum(1-rho*rho,0))
        kernel=(root+(pi-np.arccos(rho))*rho)/(2*pi)
        second=2*np.sqrt(np.maximum(e2[:,None]*e2[None,:],0))*kernel
        np.fill_diagonal(second,e2)
        mu=m
    return rows[-1]
# use estimator/target definitions from previous? reimplement target quickly
def target(weights,n=200000,seed=123):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed); batch=20000; s=np.zeros(width); total=0
    for _ in range(n//batch):
        x=rng.standard_normal((batch,width)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.sum(0); total+=batch
    return s/total
for depth in [3,5,8]:
    vals=[]
    for mseed in range(20):
        rng=np.random.default_rng(1000+depth*100+mseed); width=32
        weights=[rng.normal(0,1/np.sqrt(width),(width,width)) for _ in range(depth)]
        t=target(weights,n=100000,seed=9000+mseed)
        y=full_prop(weights)
        vals.append(((y-t)**2).mean())
    print(depth,np.mean(vals),np.median(vals))

import numpy as np
from scipy.special import ndtr
import time
PI=np.pi
W=256; D=32
scale=np.sqrt(2.0/W).astype(np.float32)

def gen(seed):
    rng=np.random.default_rng(seed)
    return [(rng.standard_normal((W,W), dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]

def target(weights, seed, n=65536, chunk=8192):
    rng=np.random.default_rng(seed)
    s=np.zeros(W, np.float64); ss=np.zeros(W, np.float64); done=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-done); done+=m
        x=rng.standard_normal((m,W), dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w, 0)
        z=x.astype(np.float64)
        s += z.sum(axis=0); ss += (z*z).sum(axis=0)
    return s/n, np.mean(ss/n-(s/n)**2)

def current(weights, mlpseed, n_samples=13744, coeff=(0.99965,1.03700,-0.0425,0.00550), cap=None):
    d_mu=np.zeros(W, np.float64); d_var=np.ones(W, np.float64)
    diag_rows=[]; diag_vars=[]; d_mu_pres=[]
    for w in weights:
        ww=w.astype(np.float64)
        d_mu_pre=ww.T@d_mu
        d_var_pre=(ww*ww).T@d_var
        d_var_pre=np.maximum(d_var_pre,1e-12)
        sig=np.sqrt(d_var_pre); a=d_mu_pre/sig
        phi=np.exp(-0.5*a*a)/np.sqrt(2*np.pi); cdf=ndtr(a)
        d_mu=d_mu_pre*cdf+sig*phi
        ez2=(d_mu_pre*d_mu_pre+d_var_pre)*cdf+d_mu_pre*sig*phi
        d_var=np.maximum(ez2-d_mu*d_mu,0)
        diag_rows.append(d_mu.copy()); diag_vars.append(d_var.copy()); d_mu_pres.append(d_mu_pre.copy())
    rng=np.random.default_rng(int(mlpseed)+2)
    half=n_samples//2
    x0=rng.standard_normal((half,W), dtype=np.float32).astype(np.float64)
    x=np.concatenate([x0,-x0],axis=0)
    eye=np.eye(W)
    for i,w in enumerate(weights[:-1]):
        ww=w.astype(np.float64)
        z=x@ww
        if i==0:
            t_cov=ww.T@ww
            z_center=z-z.mean(axis=0)
            sample_cov=z_center.T@z_center/float(n_samples)
            sv, sq=np.linalg.eigh(sample_cov)
            tv, tq=np.linalg.eigh(t_cov)
            inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T)
            tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T)
            z=z_center@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            x_mean0=x.mean(axis=0); x_center=x-x_mean0
            sample_cov=x_center.T@x_center/float(n_samples)
            sv,sq=np.linalg.eigh(sample_cov)
            sigma0=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            rho0=np.clip(t_cov/np.maximum(sigma0[:,None]*sigma0[None,:],1e-12),-.999999,.999999)
            root=np.sqrt(np.maximum(1-rho0*rho0,0))
            kernel=(root+(PI-np.arccos(rho0))*rho0)/(2*PI)
            target_second=(sigma0[:,None]*sigma0[None,:])*kernel
            target_cov=target_second-diag_rows[0][:,None]*diag_rows[0][None,:]
            target_cov=.5*(target_cov+target_cov.T)
            target_cov=target_cov*(1-eye)+eye*diag_vars[0][None,:]
            tv,tq=np.linalg.eigh(target_cov)
            inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T)
            tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T)
            x_full=x_center@(inv@tar)+diag_rows[0]
            x=diag_rows[0]-0.245*(x_mean0-diag_rows[0])+1.455*(x_full-diag_rows[0])-0.455*x_center
    z=x@weights[-1].astype(np.float64)
    zm=z.mean(axis=0); zc=z-zm; zv=(zc*zc).mean(axis=0); zs=np.sqrt(np.maximum(zv,1e-12))
    a=zm/zs; cdf=ndtr(a); phi=np.exp(-.5*a*a)/np.sqrt(2*np.pi)
    final_gauss=zm*cdf+zs*phi
    amd=d_mu_pres[-1]/zs; final_mixed=d_mu_pres[-1]*ndtr(amd)+zs*np.exp(-.5*amd*amd)/np.sqrt(2*np.pi)
    final_mc=np.maximum(z,0).sum(axis=0)/float(n_samples)
    c0,c1,c2,c3=coeff
    return c0*(c1*final_mc+c2*final_gauss+c3*final_mixed), (final_mc, final_gauss, final_mixed, d_mu_pres[-1], zs)

seeds=[1000,1001,1002]
weights=[]; targets=[]
t0=time.time()
for s in seeds:
    ws=gen(s); weights.append(ws); targets.append(target(ws, s+999, n=65536))
    print('target done',s,time.time()-t0, 'var', targets[-1][1])
for n in [4096,6144,8192,10240,12288,13744,16384,20480]:
    ms=[]
    for k,ws in enumerate(weights):
        pred,_=current(ws, seeds[k]+12345, n_samples=n)
        ms.append(np.mean((pred-targets[k][0])**2))
    print('n',n,'mse',np.mean(ms),'per',ms)

    kurt_corr=exk*zs*(a*a-1.0)*phi/24.0
    return cur, edge_corr, kurt_corr, mc, gauss, md

seeds=list(range(3000,3006)); Ps=[]; Es=[]; Ks=[]; Ys=[]

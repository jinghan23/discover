codex
I’m exploring a layer-wise mean correction next: after hidden ReLUs beyond the first, lightly pull particle means toward the diagonal analytic propagation. This is cheap and targets accumulated particle noise, but the coefficient needs caution because the analytic diagonal model has bias.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import time
PI=np.pi; W=256; D=32; scale=np.float32(np.sqrt(2.0/W)); SQ=np.sqrt(2*PI)

def gen(seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((W,W), dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]

def target(ws,seed,n=65536,chunk=8192):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,W), dtype=np.float32)
        for w in ws: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done

def pred(ws,seed,beta=0.0,beta_var=0.0,n_samples=13744):
    d_mu=np.zeros(W); d_var=np.ones(W); rows=[]; vars=[]; pre=None
    for w in ws:
        ww=w.astype(np.float64); pre=ww.T@d_mu; vp=(ww*ww).T@d_var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=pre/sig; phi=np.exp(-.5*a*a)/SQ; c=ndtr(a)
        d_mu=pre*c+sig*phi; ez2=(pre*pre+vp)*c+pre*sig*phi; d_var=np.maximum(ez2-d_mu*d_mu,0); rows.append(d_mu.copy()); vars.append(d_var.copy())
    rng=np.random.default_rng(int(seed)+2); half=n_samples//2; x0=rng.standard_normal((half,W), dtype=np.float32).astype(np.float64); x=np.concatenate([x0,-x0]); eye=np.eye(W)
    for i,w in enumerate(ws[:-1]):
        ww=w.astype(np.float64); z=x@ww
        if i==0:
            tcov=ww.T@ww; zc=z-z.mean(0); sc=zc.T@zc/n_samples; sv,sq=np.linalg.eigh(sc); tv,tq=np.linalg.eigh(tcov); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); z=zc@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n_samples; sv,sq=np.linalg.eigh(sc); sigma=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-.999999,.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI); tc=(sigma[:,None]*sigma[None,:])*ker-rows[0][:,None]*rows[0][None,:]; tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,tq=np.linalg.eigh(tc); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); xf=xc@(inv@tar)+rows[0]; x=rows[0]-0.245*(xm-rows[0])+1.455*(xf-rows[0])-0.455*xc
        elif beta or beta_var:
            xm=x.mean(0)
            if beta_var:
                xc=x-xm; xv=np.maximum((xc*xc).mean(0),1e-12); sc=np.sqrt(np.maximum(vars[i],1e-12)/xv); x=x + beta*(rows[i]-xm) + beta_var*(sc-1.0)*xc
            else:
                x=x + beta*(rows[i]-xm)
    z=x@ws[-1].astype(np.float64); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs; phi=np.exp(-.5*a*a)/SQ; ga=zm*ndtr(a)+zs*phi; md=pre*ndtr(pre/zs)+zs*np.exp(-.5*(pre/zs)**2)/SQ; mc=np.maximum(z,0).sum(0)/n_samples
    return .99965*(1.037*mc-.0425*ga+.0055*md)

seeds=range(4100,4104); data=[]; t=time.time()
for s in seeds:
    ws=gen(s); y=target(ws,s+999); data.append((s,ws,y)); print('target',s,time.time()-t)
for beta in [-0.2,-0.1,-0.05,0.0,0.05,0.1,0.2,0.4]:
    ms=[]
    for s,ws,y in data:
        p=pred(ws,s+12345,beta=beta)
        ms.append(np.mean((p-y)**2))
    print('beta',beta,'mse',np.mean(ms),ms)
for bv in [-0.2,-0.1,0.1,0.2]:
    ms=[]
    for s,ws,y in data:
        p=pred(ws,s+12345,beta=0.0,beta_var=bv)
        ms.append(np.mean((p-y)**2))
    print('bvar',bv,'mse',np.mean(ms),ms)

codex
The remaining high-impact parameters are the first-layer covariance blend coefficients. They control how much exact first-layer covariance matching is extrapolated before the deep particle pass. I’m using a small synthetic grid around the current values before trying any official changes.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np
from scipy.special import ndtr
import time
PI=np.pi; W=256; D=32; scale=np.float32(np.sqrt(2.0/W)); SQ=np.sqrt(2*PI)
# m: mean shift coeff on sample_mean-target; r: extrapolation so x=(target+m*(xm-target))+(1+r)(x_full-target)-r*x_center
def gen(seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((W,W), dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]
def target(ws,seed,n=65536,chunk=8192):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,W), dtype=np.float32)
        for w in ws: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done
def pred(ws,seed,mcoef=-0.245,r=0.455,n_samples=13744):
    d_mu=np.zeros(W); d_var=np.ones(W); rows=[]; vars=[]; pre=None
    for w in ws:
        ww=w.astype(np.float64); pre=ww.T@d_mu; vp=(ww*ww).T@d_var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=pre/sig; phi=np.exp(-.5*a*a)/SQ; c=ndtr(a); d_mu=pre*c+sig*phi; ez2=(pre*pre+vp)*c+pre*sig*phi; d_var=np.maximum(ez2-d_mu*d_mu,0); rows.append(d_mu.copy()); vars.append(d_var.copy())
    rng=np.random.default_rng(int(seed)+2); half=n_samples//2; x0=rng.standard_normal((half,W), dtype=np.float32).astype(np.float64); x=np.concatenate([x0,-x0]); eye=np.eye(W)
    for i,w in enumerate(ws[:-1]):
        ww=w.astype(np.float64); z=x@ww
        if i==0:
            tcov=ww.T@ww; zc=z-z.mean(0); sc=zc.T@zc/n_samples; sv,sq=np.linalg.eigh(sc); tv,tq=np.linalg.eigh(tcov); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); z=zc@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n_samples; sv,sq=np.linalg.eigh(sc); sigma=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-.999999,.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI); tc=(sigma[:,None]*sigma[None,:])*ker-rows[0][:,None]*rows[0][None,:]; tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,tq=np.linalg.eigh(tc); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); xf=xc@(inv@tar)+rows[0]; x=rows[0]+mcoef*(xm-rows[0])+(1.0+r)*(xf-rows[0])-r*xc
    z=x@ws[-1].astype(np.float64); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs; ga=zm*ndtr(a)+zs*np.exp(-.5*a*a)/SQ; md=pre*ndtr(pre/zs)+zs*np.exp(-.5*(pre/zs)**2)/SQ; mc=np.maximum(z,0).sum(0)/n_samples; return .99965*(1.037*mc-.0425*ga+.0055*md)
seeds=range(6100,6104); data=[]; t=time.time()
for s in seeds:
    ws=gen(s); y=target(ws,s+999); data.append((s,ws,y)); print('target',s,time.time()-t)
for mcoef in [-0.34,-0.285,-0.245,-0.205,-0.16]:
  row=[]
  for r in [0.32,0.40,0.455,0.52,0.60]:
    ms=[np.mean((pred(ws,s+12345,mcoef,r)-y)**2) for s,ws,y in data]
    row.append(np.mean(ms))
  print('m',mcoef,'grid',row)
PY" in /opt/tiger/discover/workspace

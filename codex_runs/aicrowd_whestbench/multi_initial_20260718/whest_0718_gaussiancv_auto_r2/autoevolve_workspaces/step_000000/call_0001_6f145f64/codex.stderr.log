import numpy as np
from scipy.special import ndtr
import time
PI=np.pi; W=256; D=32; scale=np.float32(np.sqrt(2.0/W)); SQRT2PI=np.sqrt(2*PI)

def gen(seed):
    rng=np.random.default_rng(seed)
    return [(rng.standard_normal((W,W), dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]

def target(weights, seed, n=131072, chunk=8192):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,W), dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done

def features(weights, mlpseed, n_samples=13744):
    d_mu=np.zeros(W); d_var=np.ones(W); rows=[]; vars=[]; pre=None
    for w in weights:
        ww=w.astype(np.float64); pre=ww.T@d_mu; vp=(ww*ww).T@d_var; vp=np.maximum(vp,1e-12)
        sig=np.sqrt(vp); a=pre/sig; phi=np.exp(-.5*a*a)/SQRT2PI; cdf=ndtr(a)
        d_mu=pre*cdf+sig*phi; ez2=(pre*pre+vp)*cdf+pre*sig*phi; d_var=np.maximum(ez2-d_mu*d_mu,0)
        rows.append(d_mu.copy()); vars.append(d_var.copy())
    rng=np.random.default_rng(int(mlpseed)+2); half=n_samples//2
    x0=rng.standard_normal((half,W), dtype=np.float32).astype(np.float64); x=np.concatenate([x0,-x0])
    eye=np.eye(W)
    for i,w in enumerate(weights[:-1]):
        ww=w.astype(np.float64); z=x@ww
        if i==0:
            t_cov=ww.T@ww; zc=z-z.mean(0); sc=zc.T@zc/n_samples
            sv,sq=np.linalg.eigh(sc); tv,tq=np.linalg.eigh(t_cov)
            inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T)
            z=zc@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n_samples; sv,sq=np.linalg.eigh(sc)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12)); rho=np.clip(t_cov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-.999999,.999999)
            ker=(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI)
            tc=(sigma[:,None]*sigma[None,:])*ker-rows[0][:,None]*rows[0][None,:]
            tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]
            tv,tq=np.linalg.eigh(tc); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T)
            xf=xc@(inv@tar)+rows[0]
            x=rows[0]-0.245*(xm-rows[0])+1.455*(xf-rows[0])-0.455*xc
    z=x@weights[-1].astype(np.float64); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs
    phi=np.exp(-.5*a*a)/SQRT2PI; cdf=ndtr(a)
    gauss=zm*cdf+zs*phi; md=pre*ndtr(pre/zs)+zs*np.exp(-.5*(pre/zs)**2)/SQRT2PI; mc=np.maximum(z,0).sum(0)/n_samples
    cur=.99965*(1.037*mc-.0425*gauss+.0055*md)

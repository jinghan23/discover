/bin/bash -lc "python - <<'PY'
# Quick synthetic test: add reference full-covariance Gaussian propagation as a low-cost feature.
import numpy as np
from scipy.special import ndtr
import time
PI=np.pi; W=256; D=32; scale=np.float32(np.sqrt(2.0/W)); SQ=np.sqrt(2*PI)
# Reuse compact current from earlier, returning current only.
def gen(seed):
    rng=np.random.default_rng(seed); return [(rng.standard_normal((W,W), dtype=np.float32)*scale).astype(np.float32) for _ in range(D)]
def target(ws,seed,n=131072,chunk=8192):
    rng=np.random.default_rng(seed); s=np.zeros(W); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,W), dtype=np.float32)
        for w in ws: x=np.maximum(x@w,0)
        s+=x.astype(np.float64).sum(0); done+=m
    return s/done
def diag(ws):
    mu=np.zeros(W); var=np.ones(W); rows=[]; vars=[]; pre=None
    for w in ws:
        ww=w.astype(np.float64); pre=ww.T@mu; vp=(ww*ww).T@var; vp=np.maximum(vp,1e-12); sig=np.sqrt(vp); a=pre/sig; phi=np.exp(-.5*a*a)/SQ; c=ndtr(a); mu=pre*c+sig*phi; ez2=(pre*pre+vp)*c+pre*sig*phi; var=np.maximum(ez2-mu*mu,0); rows.append(mu.copy()); vars.append(var.copy())
    return rows,vars,pre
def covprop(ws):
    mu=np.zeros(W); cov=np.eye(W)
    for w in ws:
        ww=w.astype(np.float64); pre=ww.T@mu; cp=ww.T@cov@ww; vp=np.maximum(np.diag(cp),1e-12); sig=np.sqrt(vp); a=pre/sig; phi=np.exp(-.5*a*a)/SQ; c=ndtr(a); mu=pre*c+sig*phi; ez2=(pre*pre+vp)*c+pre*sig*phi; var=np.maximum(ez2-mu*mu,0); gain=np.where(sig>1e-12,c,0.0); cov=np.outer(gain,gain)*cp; np.fill_diagonal(cov,var)
    return mu
def current(ws,seed,n_samples=13744):
    rows,vars,pre=diag(ws); rng=np.random.default_rng(int(seed)+2); half=n_samples//2; x0=rng.standard_normal((half,W), dtype=np.float32).astype(np.float64); x=np.concatenate([x0,-x0]); eye=np.eye(W)
    for i,w in enumerate(ws[:-1]):
        ww=w.astype(np.float64); z=x@ww
        if i==0:
            tcov=ww.T@ww; zc=z-z.mean(0); sc=zc.T@zc/n_samples; sv,sq=np.linalg.eigh(sc); tv,tq=np.linalg.eigh(tcov); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); z=zc@(inv@tar)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; sc=xc.T@xc/n_samples; sv,sq=np.linalg.eigh(sc); sigma=np.sqrt(np.maximum(np.diag(tcov),1e-12)); rho=np.clip(tcov/np.maximum(sigma[:,None]*sigma[None,:],1e-12),-.999999,.999999); ker=(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI); tc=(sigma[:,None]*sigma[None,:])*ker-rows[0][:,None]*rows[0][None,:]; tc=.5*(tc+tc.T); tc=tc*(1-eye)+eye*vars[0][None,:]; tv,tq=np.linalg.eigh(tc); inv=sq@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@sq.T); tar=tq@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@tq.T); xf=xc@(inv@tar)+rows[0]; x=rows[0]-0.245*(xm-rows[0])+1.455*(xf-rows[0])-0.455*xc
    z=x@ws[-1].astype(np.float64); zm=z.mean(0); zc=z-zm; zv=(zc*zc).mean(0); zs=np.sqrt(np.maximum(zv,1e-12)); a=zm/zs; ga=zm*ndtr(a)+zs*np.exp(-.5*a*a)/SQ; md=pre*ndtr(pre/zs)+zs*np.exp(-.5*(pre/zs)**2)/SQ; mc=np.maximum(z,0).sum(0)/n_samples; return .99965*(1.037*mc-.0425*ga+.0055*md)
seeds=range(5100,5106); P=[]; C=[]; Y=[]; t=time.time()
for s in seeds:
    ws=gen(s); y=target(ws,s+999); p=current(ws,s+12345); c=covprop(ws); Y.append(y); P.append(p); C.append(c); print('done',s,time.time()-t,'cur',np.mean((p-y)**2),'cov',np.mean((c-y)**2))
Y=np.concatenate(Y); P=np.concatenate(P); C=np.concatenate(C); F=C-P
lam=np.dot(F,Y-P)/np.dot(F,F)
print('lambda cov-current',lam,'mse',np.mean((P+lam*F-Y)**2),'cur',np.mean((P-Y)**2))
# fit current scale and cov add separately
X=np.vstack([P,C]).T; coef=np.linalg.lstsq(X,Y,rcond=None)[0]
print('coef p,c',coef,'mse',np.mean((X@coef-Y)**2))

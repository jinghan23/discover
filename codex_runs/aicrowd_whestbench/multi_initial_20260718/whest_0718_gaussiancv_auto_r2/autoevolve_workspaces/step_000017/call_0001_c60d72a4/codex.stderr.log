    z_alpha_md=d_mu_pre/z_sigma
    final_mixed=d_mu_pre*flops.stats.norm.cdf(z_alpha_md)+z_sigma*flops.stats.norm.pdf(z_alpha_md)
    final_mc=fnp.sum(fnp.maximum(z64,0.0),axis=0)/float(n_samples)
    m3=fnp.mean(z_center*z_center*z_center,axis=0)
    z2=z_center*z_center
    m4=fnp.mean(z2*z2,axis=0)
    skew=m3/fnp.maximum(z_var*z_sigma,1e-12)
    exk=m4/fnp.maximum(z_var*z_var,1e-12)-3.0
    edge=final_gauss + z_sigma*phi*((-skew*a)/6.0 + (exk*(a*a-1.0))/24.0)
    cur=0.99965*(1.034*final_mc-0.039*final_gauss+0.005*final_mixed)
    return final_mc, final_gauss, final_mixed, edge, cur

# Synthetic comparison. Keep target MC moderate to avoid spending the whole turn.
width=64; depth=8; n_mlps=4; gt=80000; budget=1_000_000_000
rng=fnp.random.default_rng(123)
ys=[]; comps_list=[]
for i in range(n_mlps):
    mlp=sample_mlp(width,depth,rng,seed=1000+i)
    _, target, _=sample_layer_statistics(mlp, gt, rng=fnp.random.default_rng(2000+i))
    comps_list.append(comps(mlp,budget))
    ys.append(target)
    print('made',i)
# Grid for edge coefficient as current + k*(edge-gauss)
for k in [-0.10,-0.05,-0.02,-0.01,0.0,0.01,0.02,0.05,0.10]:
    ms=[]
    for (mc,ga,mix,edge,cur), y in zip(comps_list,ys):
        pred=cur + k*(edge-ga)
        ms.append(float(fnp.mean((pred-y)**2)))
    print('k_edge',k,'mse',sum(ms)/len(ms))
# final scale grid
for s in [0.9985,0.9990,0.99935,0.99965,1.0,1.0003,1.0007]:
    ms=[]
    for (mc,ga,mix,edge,cur), y in zip(comps_list,ys):
        pred=(s/0.99965)*cur
        ms.append(float(fnp.mean((pred-y)**2)))
    print('scale',s,'mse',sum(ms)/len(ms))

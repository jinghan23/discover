         if depth == 1:
             return fnp.asarray(fnp.stack(diag_rows, axis=0), dtype=fnp.float32)
 
+        eye = fnp.eye(width, dtype=fnp.float64)
+        c_mu = fnp.zeros(width, dtype=fnp.float64)
+        c_cov = eye
+        pi = 3.141592653589793
+        inv_2pi = 0.15915494309189535
+        for w in mlp.weights:
+            c_mu_pre = w.T @ c_mu
+            c_cov_pre = w.T @ (c_cov @ w)
+            c_cov_pre = 0.5 * (c_cov_pre + c_cov_pre.T)
+            c_var_pre = fnp.maximum(fnp.diagonal(c_cov_pre), 1e-12)
+            c_sigma = fnp.sqrt(c_var_pre)
+            c_alpha = c_mu_pre / c_sigma
+            c_phi = flops.stats.norm.pdf(c_alpha)
+            c_cdf = flops.stats.norm.cdf(c_alpha)
+            c_mu = c_mu_pre * c_cdf + c_sigma * c_phi
+            c_ez2 = (c_mu_pre * c_mu_pre + c_var_pre) * c_cdf + c_mu_pre * c_sigma * c_phi
+            c_var = fnp.maximum(c_ez2 - c_mu * c_mu, 0.0)
+            c_scale = fnp.maximum(c_sigma[:, None] * c_sigma[None, :], 1e-12)
+            c_rho = fnp.clip(c_cov_pre / c_scale, -0.999999, 0.999999)
+            c_root = fnp.sqrt(fnp.maximum(1.0 - c_rho * c_rho, 0.0))
+            c_kernel = (c_root + (pi - fnp.arccos(c_rho)) * c_rho) / (2.0 * pi)
+            c_zero_cov = c_scale * (c_kernel - inv_2pi)
+            c_cov = c_zero_cov * (4.0 * (c_cdf[:, None] * c_cdf[None, :]))
+            c_cov = 0.5 * (c_cov + c_cov.T)
+            c_cov = c_cov * (1.0 - eye) + eye * c_var[None, :]
+        final_full_cov = c_mu
+
         per_sample = max(1, depth * (2 * width * width + 4 * width))
         n_samples = max(1024, int((0.625 * float(budget)) / float(per_sample)))
         n_samples = min(n_samples, 13744)

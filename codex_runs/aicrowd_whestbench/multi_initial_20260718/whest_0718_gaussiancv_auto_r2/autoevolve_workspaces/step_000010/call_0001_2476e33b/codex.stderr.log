import numpy as np
from scipy.stats import norm


def diag_prop(weights):
    width=weights[0].shape[0]
    mu=np.zeros(width, dtype=np.float64); var=np.ones(width, dtype=np.float64)
    rows=[]; vars=[]; pre_mus=[]; pre_vars=[]
    for w in weights:
        wf=w.astype(np.float64)
        mu_pre=wf.T@mu
        var_pre=np.maximum((wf*wf).T@var,1e-12)
        sigma=np.sqrt(var_pre); alpha=mu_pre/sigma
        cdf=norm.cdf(alpha); phi=norm.pdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pre_mus.append(mu_pre); pre_vars.append(var_pre)
    return rows,vars,pre_mus,pre_vars

def features(weights, seed=0, n=4096, p=1.53, m=-0.245):
    width=weights[0].shape[0]; depth=len(weights)
    rows,vars,pre_mus,pre_vars=diag_prop(weights)
    rng=np.random.default_rng(seed+2)
    x0=rng.standard_normal((n//2,width), dtype=np.float32)
    x=np.concatenate([x0,-x0],0).astype(np.float64)
    eye=np.eye(width)
    for i,w0 in enumerate(weights[:-1]):
        w=w0.astype(np.float64)
        z=x@w
        if i==0:
            t_cov=w.T@w
            zc=z-z.mean(0)
            scov=zc.T@zc/len(x)
            sv,se=np.linalg.eigh(scov); tv,te=np.linalg.eigh(t_cov)
            inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            z=zc@(inv@ts)
        x=np.maximum(z,0)
        if i==0:
            xm=x.mean(0); xc=x-xm; scov=xc.T@xc/len(x)
            sv,se=np.linalg.eigh(scov)
            sigma=np.sqrt(np.maximum(np.diag(t_cov),1e-12))
            scale=np.maximum(sigma[:,None]*sigma[None,:],1e-12)
            rho=np.clip(t_cov/scale,-0.999999,0.999999)
            root=np.sqrt(np.maximum(1-rho*rho,0))
            kernel=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi)
            tsecond=scale*kernel
            tcov=tsecond-rows[0][:,None]*rows[0][None,:]
            tcov=0.5*(tcov+tcov.T); tcov=tcov*(1-eye)+eye*vars[0][None,:]
            tv,te=np.linalg.eigh(tcov)
            inv=se@(np.diag(1/np.sqrt(np.maximum(sv,1e-12)))@se.T)
            ts=te@(np.diag(np.sqrt(np.maximum(tv,1e-12)))@te.T)
            xf=xc@(inv@ts)+rows[0]
            x=rows[0]+m*(xm-rows[0])+p*(xf-rows[0])+(1-p)*xc
    z=x@weights[-1].astype(np.float64)
    zmean=z.mean(0); zc=z-zmean; zvar=np.mean(zc*zc,0); zsig=np.sqrt(np.maximum(zvar,1e-12)); alpha=zmean/zsig
    fg=zmean*norm.cdf(alpha)+zsig*norm.pdf(alpha)
    amd=pre_mus[-1]/zsig
    fmix=pre_mus[-1]*norm.cdf(amd)+zsig*norm.pdf(amd)
    fmc=np.maximum(z,0).mean(0)
    # additional features
    # sample central moments and positive-side stats
    std=zsig
    skew=np.mean((zc/std)**3,0)
    kurt=np.mean((zc/std)**4,0)-3
    # Edgeworth correction for E[g(Z)], g=relu(mu+sig y), correction k3/6 E[g H3]+k4/24 E[g H4]
    # Numerically derive formulas? approximate feature as phi(alpha)*std*skew etc
    fsk=std*norm.pdf(alpha)*skew
    fku=std*norm.pdf(alpha)*kurt
    return np.stack([fmc,fg,fmix,rows[-1],fsk,fku],axis=1)

def target(weights, seed=123, n=200000, chunk=20000):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(width,dtype=np.float64); done=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st)
        x=rng.standard_normal((m,width), dtype=np.float32).astype(np.float64)
        for w in weights:
            x=np.maximum(x@w.astype(np.float64),0)
        s+=x.sum(0); done+=m
    return s/done

for width,depth,nest,nmlp in [(32,6,4096,16),(64,6,4096,8),(32,10,4096,12)]:
    X=[]; y=[]
    rng=np.random.default_rng(2026)
    scale=np.sqrt(2/width)
    for k in range(nmlp):
        weights=[(rng.standard_normal((width,width))*scale).astype(np.float32) for _ in range(depth)]
        X.append(features(weights, seed=1000+k, n=nest, p=1.53))
        y.append(target(weights, seed=2000+k, n=80000 if width==64 else 120000))
    X=np.concatenate(X,0); y=np.concatenate(y,0)
    base=0.99965*(1.034*X[:,0]-0.039*X[:,1]+0.005*X[:,2])
    mse=np.mean((base-y)**2)
    # fit with sum-to-scale? unconstrained plus no intercept
    coef=np.linalg.lstsq(X[:,:4], y, rcond=None)[0]
    pred=X[:,:4]@coef
    coef6=np.linalg.lstsq(X, y, rcond=None)[0]
    pred6=X@coef6
    print('case',width,depth,'base',mse,'coef4',coef,'mse4',np.mean((pred-y)**2),'coef6',coef6,'mse6',np.mean((pred6-y)**2))

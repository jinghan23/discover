codex
I’ll test a cheap structured covariance feature: exact first-layer ReLU covariance, then a Gaussian linearized covariance propagation through later layers. This adds matrix-sized work, not sample-sized work, and may give a useful final analytic control variate.
exec
/bin/bash -lc "python - <<'PY'
# Quick local check of a linearized full-covariance final feature on fresh random MLPs.
import numpy as np
from scipy.stats import norm

# Reuse compact versions from scratch.
def diag_prop(weights):
    w=weights[0].shape[0]; mu=np.zeros(w); var=np.ones(w); rows=[]; vars=[]; pre=[]
    for W in weights:
        W=W.astype(float); mp=W.T@mu; vp=np.maximum((W*W).T@var,1e-12); s=np.sqrt(vp); a=mp/s
        c=norm.cdf(a); p=norm.pdf(a); mu=mp*c+s*p; ez2=(mp*mp+vp)*c+mp*s*p; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.copy()); vars.append(var.copy()); pre.append(mp.copy())
    return rows,vars,pre

def first_cov(W, mu0, var0):
    tc=W.T@W; sig=np.sqrt(np.maximum(np.diag(tc),1e-12)); scale=np.maximum(sig[:,None]*sig[None,:],1e-12); rho=np.clip(tc/scale,-.999999,.999999)
    root=np.sqrt(np.maximum(1-rho*rho,0)); ker=(root+(np.pi-np.arccos(rho))*rho)/(2*np.pi); second=scale*ker
    cov=second-mu0[:,None]*mu0[None,:]; cov=.5*(cov+cov.T); np.fill_diagonal(cov,var0); return cov

def full_lin(weights, rows, vars):
    mu=rows[0]; cov=first_cov(weights[0].astype(float), rows[0], vars[0])
    for li,W in enumerate(weights[1:], start=1):
        W=W.astype(float); pm=W.T@mu; pc=W.T@cov@W; pv=np.maximum(np.diag(pc),1e-12); s=np.sqrt(pv); a=pm/s
        c=norm.cdf(a); p=norm.pdf(a); mu=pm*c+s*p; ez2=(pm*pm+pv)*c+pm*s*p; var=np.maximum(ez2-mu*mu,0)
        if li "'!= len(weights)-1:
            cov=pc*(c[:,None]*c[None,:]); cov=.5*(cov+cov.T); np.fill_diagonal(cov,var)
    return mu

+        pi = 3.141592653589793
+        c_rows = []
+        for w in mlp.weights:
+            w64 = fnp.asarray(w, dtype=fnp.float64)
+            c_mu_pre = w64.T @ c_mu
+            c_cov_pre = w64.T @ (c_cov @ w64)
+            c_var_pre = fnp.maximum(fnp.diagonal(c_cov_pre), 1e-12)
+            c_sigma = fnp.sqrt(c_var_pre)
+            c_alpha = c_mu_pre / c_sigma
+            c_phi = flops.stats.norm.pdf(c_alpha)
+            c_cdf = flops.stats.norm.cdf(c_alpha)
+            c_mu = c_mu_pre * c_cdf + c_sigma * c_phi
+            c_ez2 = (c_mu_pre * c_mu_pre + c_var_pre) * c_cdf + c_mu_pre * c_sigma * c_phi
+            c_var = fnp.maximum(c_ez2 - c_mu * c_mu, 0.0)

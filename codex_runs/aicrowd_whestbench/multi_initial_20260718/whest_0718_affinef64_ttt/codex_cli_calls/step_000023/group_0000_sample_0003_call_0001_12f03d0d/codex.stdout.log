```python
from __future__ import annotations

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_INV_SQRT_2PI = 0.3989422804014327
_RELU_VAR_FACTOR = 0.5 - _INV_SQRT_2PI * _INV_SQRT_2PI
_EPS = 1e-7


class Estimator(BaseEstimator):
    def setup(self, context):
        pass

    def teardown(self):
        pass

    def predict(self, mlp, budget):
        width = int(mlp.width)
        depth = int(mlp.depth)

        out = fnp.zeros((depth, width), dtype=fnp.float32)

        second = fnp.ones((width,), dtype=fnp.float32)
        mean = fnp.zeros((width,), dtype=fnp.float32)

        for layer, weight in enumerate(mlp.weights):
            pre_second = second @ (weight * weight)
            pre_std = fnp.sqrt(fnp.maximum(pre_second, _EPS))

            mean = pre_std * _INV_SQRT_2PI
            second = pre_second * 0.5

            out[layer, :] = mean

        return out

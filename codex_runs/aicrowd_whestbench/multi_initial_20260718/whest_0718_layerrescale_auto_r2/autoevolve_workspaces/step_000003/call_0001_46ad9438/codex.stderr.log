--- a/submission.py
+++ b/submission.py
@@ -15,6 +15,7 @@
         n_samples = max(1024, int((0.0937 * float(budget)) / float(per_sample)))
         n_samples = min(n_samples, 8192)
         n_samples = max(2, 2 * ((n_samples + 1) // 2))
+        n_samples = n_samples + 2
 
         mu = fnp.zeros(width)
         var = fnp.ones(width)
@@ -53,7 +54,7 @@
             diag_vars.append(var)
 
         half = n_samples // 2
-        base = fnp.asarray(rng.standard_normal((half + 2, width), dtype=fnp.float32))[2:]
+        base = fnp.asarray(rng.standard_normal((half, width), dtype=fnp.float32))
         cov = (base.T @ base) / float(half)
         x = fnp.concatenate((base, -base), axis=0)
         chol = fnp.linalg.cholesky(cov)
@@ -65,26 +66,39 @@
                 x_mean = fnp.mean(x, axis=0)
                 x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                 x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
-                x = x * (-1.40 + 2.40 * x_scale) + 2.40 * (diag_rows[i] - x_mean * x_scale)
+                x = x * (-1.75 + 2.75 * x_scale) + 2.75 * (diag_rows[i] - x_mean * x_scale)
             elif i == 1:
                 x_mean = fnp.mean(x, axis=0)
                 x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                 x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
-                x = x * (0.705 + 0.295 * x_scale) + 0.295 * (diag_rows[i] - x_mean * x_scale)
+                x = x * (0.690 + 0.310 * x_scale) + 0.310 * (diag_rows[i] - x_mean * x_scale)
+            elif i == 2:
+                x_mean = fnp.mean(x, axis=0)
+                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
+                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
+                x = x * (0.9500 + 0.0500 * x_scale) + 0.0500 * (diag_rows[i] - x_mean * x_scale)
             elif i == 3:
                 x_mean = fnp.mean(x, axis=0)
                 x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                 x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
-                x = x * (1.05 - 0.05 * x_scale) - 0.05 * (diag_rows[i] - x_mean * x_scale)
+                x = x * (1.066 - 0.066 * x_scale) - 0.066 * (diag_rows[i] - x_mean * x_scale)
             elif i == 4:
                 x_mean = fnp.mean(x, axis=0)
                 x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                 x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
-                x = x * (0.9825 + 0.0175 * x_scale) + 0.0175 * (diag_rows[i] - x_mean * x_scale)
+                x = x * (0.9875 + 0.0125 * x_scale) + 0.0125 * (diag_rows[i] - x_mean * x_scale)
 
         z = x @ mlp.weights[-1]
         final_mc = fnp.asarray(fnp.mean(fnp.maximum(z, 0.0), axis=0), dtype=fnp.float32)
+        z_mean = fnp.mean(z, axis=0)
+        z_var = fnp.maximum(fnp.mean(z * z, axis=0) - z_mean * z_mean, 1e-12)
+        z_sigma = fnp.sqrt(z_var)
+        z_alpha = z_mean / z_sigma
+        z_gauss = z_mean * flops.stats.norm.cdf(z_alpha) + z_sigma * flops.stats.norm.pdf(z_alpha)
 
         diag = fnp.asarray(fnp.stack(diag_rows, axis=0), dtype=fnp.float32)
-        final_pred = fnp.asarray(final_mc + 0.001 * (diag[-1] - final_mc), dtype=fnp.float32)
+        final_pred = fnp.asarray(
+            final_mc + 0.0250 * (z_gauss - final_mc) + 0.0020 * (diag[-1] - final_mc),
+            dtype=fnp.float32,
+        )
         return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None, :]), axis=0), dtype=fnp.float32)


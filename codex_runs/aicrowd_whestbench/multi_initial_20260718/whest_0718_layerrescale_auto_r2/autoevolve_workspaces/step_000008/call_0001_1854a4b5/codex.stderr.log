import time
import flopscope as flops
import flopscope.numpy as fnp
import numpy as np
from whestbench.scoring import ContestSpec, make_contest
B=272_000_000_000; W=256; D=32
spec=ContestSpec(width=W, depth=D, n_mlps=5, flop_budget=B, ground_truth_samples=131072, seed=112358, wall_time_limit_s=60, lambda_flops_per_second=100_000_000_000)
t=time.time(); data=make_contest(spec); print('make',time.time()-t, flush=True)

def analytic_current(mlp):
    width=int(mlp.width); mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; rows=[]; vars=[]
    for li,w in enumerate(mlp.weights):
        mp=w.T@mu
        if act_cov is None: vp=fnp.maximum((w*w).T@var,1e-12)
        else:
            cw=act_cov@w; vp=fnp.maximum(fnp.sum(w*cw,axis=0),1e-12); act_cov=None
        sig=fnp.sqrt(vp); a=mp/sig; ph=flops.stats.norm.pdf(a); cd=flops.stats.norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=fnp.maximum(ez2-mu*mu,0.0)
        if li==0:
            pc=w.T@w; den=sig[:,None]*sig[None,:]
            rho=fnp.maximum(fnp.minimum(pc/fnp.maximum(den,1e-12),1.0),-1.0)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
            rs=den*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
            act_cov=fnp.maximum(rs-mu[:,None]*mu[None,:],0.0)
        rows.append(mu); vars.append(var)
    return rows,vars

def analytic_full(mlp):
    width=int(mlp.width); mu=fnp.zeros(width); cov=fnp.eye(width); rows=[]; vars=[]
    for li,w in enumerate(mlp.weights):
        mp=w.T@mu
        cov_pre=w.T@cov@w
        vp=fnp.maximum(fnp.diag(cov_pre),1e-12)
        sig=fnp.sqrt(vp); a=mp/sig; ph=flops.stats.norm.pdf(a); cd=flops.stats.norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=fnp.maximum(ez2-mu*mu,0.0)
        if li==0:
            den=sig[:,None]*sig[None,:]
            rho=fnp.maximum(fnp.minimum(cov_pre/fnp.maximum(den,1e-12),1.0),-1.0)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
            rs=den*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
            cov=fnp.maximum(rs-mu[:,None]*mu[None,:],0.0)
        else:
            gain=fnp.where(sig>1e-12, cd, 0.0)
            cov=fnp.outer(gain,gain)*cov_pre
            fnp.fill_diagonal(cov,var)
        rows.append(mu); vars.append(var)
    return rows,vars

def pred(mlp,mode):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1536, int((0.0937*float(B))/float(per_sample)))
    n_samples=min(n_samples,8192); n_samples=max(2,2*((n_samples+1)//2)); n_samples=n_samples+2

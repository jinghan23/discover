    zg=zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
    return fnp.asarray(fm+0.025*(zg-fm)+0.002*(diag[-1]-fm),dtype=fnp.float32), n_samples


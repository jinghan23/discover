codex
One structural idea is to remove radial Monte Carlo noise. The network is positively homogeneous, so only the input direction needs sampling; the Gaussian radius can be integrated analytically. I’m testing that as an input sampler change against synthetic rows.
exec
/bin/bash -lc "python - <<'PY'
import time, math
import flopscope as flops
import flopscope.numpy as fnp
import numpy as np
from whestbench.scoring import ContestSpec, make_contest
B=272_000_000_000; W=256; D=32
spec=ContestSpec(width=W, depth=D, n_mlps=5, flop_budget=B, ground_truth_samples=131072, seed=13579, wall_time_limit_s=60, lambda_flops_per_second=100_000_000_000)
t=time.time(); data=make_contest(spec); print('make', time.time()-t, flush=True)

def predict_final(mlp, mode):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1536, int((0.0937*float(B))/float(per_sample)))
    n_samples=min(n_samples,8192); n_samples=max(2,2*((n_samples+1)//2)); n_samples=n_samples+2
    mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; diag_rows=[]; diag_vars=[]
    for layer_idx,w in enumerate(mlp.weights):
        mu_pre=w.T@mu
        if act_cov is None:
            var_pre=fnp.maximum((w*w).T@var,1e-12)
        else:
            cov_w=act_cov@w; var_pre=fnp.maximum(fnp.sum(w*cov_w,axis=0),1e-12); act_cov=None
        sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma; phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=fnp.maximum(ez2-mu*mu,0.0)
        if layer_idx==0:
            pre_cov=w.T@w; denom=sigma[:,None]*sigma[None,:]
            rho=fnp.maximum(fnp.minimum(pre_cov/fnp.maximum(denom,1e-12),1.0),-1.0)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
            relu_second=denom*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
            act_cov=fnp.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
        diag_rows.append(mu); diag_vars.append(var)
    half=n_samples//2
    base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
    rmean=math.sqrt(width-0.5)
    if mode=='sphere':
        norms=fnp.sqrt(fnp.maximum(fnp.sum(base*base,axis=1,keepdims=True),1e-12))
        base=base*(rmean/norms)
        x=fnp.concatenate((base,-base),axis=0)
    elif mode=='sphere_whiten':
        norms=fnp.sqrt(fnp.maximum(fnp.sum(base*base,axis=1,keepdims=True),1e-12))
        base=base*(rmean/norms)
        cov=(base.T@base)/float(half)
        x=fnp.concatenate((base,-base),axis=0)
        chol=fnp.linalg.cholesky(cov)
        x=fnp.linalg.solve(chol,x.T).T
        xnorm=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))
        x=x*(rmean/fnp.mean(xnorm))
    elif mode=='whiten_scale':
        cov=(base.T@base)/float(half)
        x=fnp.concatenate((base,-base),axis=0)
        chol=fnp.linalg.cholesky(cov)
        x=fnp.linalg.solve(chol,x.T).T
        xnorm=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12))
        x=x*(rmean/fnp.mean(xnorm))
    else:
        cov=(base.T@base)/float(half)
        x=fnp.concatenate((base,-base),axis=0)
        chol=fnp.linalg.cholesky(cov)
        x=fnp.linalg.solve(chol,x.T).T
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        if i==0:
            c=2.75
        elif i==1:
            c=0.310
        elif i==2:
            c=0.0790
        elif i==3:
            c=-0.0785
        else:
            continue
        x_mean=fnp.mean(x,axis=0)
        x_var=fnp.maximum(fnp.mean(x*x,axis=0)-x_mean*x_mean,1e-12)
        x_scale=fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/x_var)
        x=x*(1.0-c+c*x_scale)+c*(diag_rows[i]-x_mean*x_scale)
    z=x@mlp.weights[-1]
    final_mc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0),dtype=fnp.float32)
    z_mean=fnp.mean(z,axis=0); z_var=fnp.maximum(fnp.mean(z*z,axis=0)-z_mean*z_mean,1e-12)
    z_sigma=fnp.sqrt(z_var); z_alpha=z_mean/z_sigma
    z_gauss=z_mean*flops.stats.norm.cdf(z_alpha)+z_sigma*flops.stats.norm.pdf(z_alpha)
    diag=fnp.asarray(fnp.stack(diag_rows,axis=0),dtype=fnp.float32)
    return fnp.asarray(final_mc+0.025*(z_gauss-final_mc)+0.002*(diag[-1]-final_mc),dtype=fnp.float32)

for mode in ['current','whiten_scale','sphere','sphere_whiten']:
    ms=[]; t=time.time()
    fls=[]
    for mlp,target in zip(data.mlps,data.final_targets):
        with flops.BudgetContext(flop_budget=B, wall_time_limit_s=60, quiet=True) as bc:
            pred=predict_final(mlp,mode)
        ms.append(float(fnp.mean((pred-target)**2))); fls.append(bc.flops_used)
    print(mode,'mse',float(np.mean(ms)),'per',[round(x,8) for x in ms],'flops',int(np.mean(fls)),'time',time.time()-t, flush=True)

import time
import flopscope as flops
import flopscope.numpy as fnp
import numpy as np
from whestbench.scoring import ContestSpec, make_contest
B=272_000_000_000; W=256; D=32
spec=ContestSpec(width=W, depth=D, n_mlps=6, flop_budget=B, ground_truth_samples=131072, seed=24680, wall_time_limit_s=60, lambda_flops_per_second=100_000_000_000)
t=time.time(); data=make_contest(spec); print('make',time.time()-t, flush=True)

def pred(mlp,factor):
    import flopscope as flops
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1536, int((factor*float(B))/float(per_sample)))
    n_samples=min(n_samples,8192); n_samples=max(2, 2*((n_samples+1)//2)); n_samples=n_samples+2
    mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; rows=[]; vars=[]
    for li,w in enumerate(mlp.weights):
        mp=w.T@mu
        if act_cov is None: vp=fnp.maximum((w*w).T@var,1e-12)
        else:
            cw=act_cov@w; vp=fnp.maximum(fnp.sum(w*cw,axis=0),1e-12); act_cov=None
        sig=fnp.sqrt(vp); a=mp/sig; ph=flops.stats.norm.pdf(a); cd=flops.stats.norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=fnp.maximum(ez2-mu*mu,0.0)
        if li==0:
            pc=w.T@w; den=sig[:,None]*sig[None,:]
            rho=fnp.maximum(fnp.minimum(pc/fnp.maximum(den,1e-12),1.0),-1.0)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
            rs=den*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
            act_cov=fnp.maximum(rs-mu[:,None]*mu[None,:],0.0)
        rows.append(mu); vars.append(var)
    half=n_samples//2; base=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32))
    cov=(base.T@base)/float(half); x=fnp.concatenate((base,-base),axis=0); chol=fnp.linalg.cholesky(cov); x=fnp.linalg.solve(chol,x.T).T
    cs=(2.75,0.310,0.0790,-0.0785)
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        if i<4:
            xm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-xm*xm,1e-12); xs=fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv); c=cs[i]
            x=x*(1.0-c+c*xs)+c*(rows[i]-xm*xs)
    z=x@mlp.weights[-1]
    fm=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0),dtype=fnp.float32)
    zm=fnp.mean(z,axis=0); zv=fnp.maximum(fnp.mean(z*z,axis=0)-zm*zm,1e-12); zs=fnp.sqrt(zv); za=zm/zs
    zg=zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
    return fnp.asarray(fm+0.025*(zg-fm)+0.002*(diag[-1]-fm),dtype=fnp.float32), n_samples

for factor in [0.082,0.086,0.090,0.092,0.0937,0.095,0.098,0.102,0.110,0.125]:
    ms=[]; effs=[]; ns=[]
    t=time.time()
    for mlp,target in zip(data.mlps,data.final_targets):
        with flops.BudgetContext(flop_budget=B, wall_time_limit_s=60, quiet=True) as bc:
            p,n=pred(mlp,factor)
        ms.append(float(fnp.mean((p-target)**2)))
        effs.append((bc.flops_used+100_000_000_000*(bc.residual_wall_time_s or 0.0))/B)
        ns.append(n)
    mult=[max(0.1,e) for e in effs]
    adj=float(np.mean(np.array(ms)*np.array(mult)))
    print('factor',factor,'n',ns[0],'raw',float(np.mean(ms)),'adj',adj,'util',float(np.mean(effs)),'time',time.time()-t, flush=True)

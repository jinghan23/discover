('combo6',Est(cs=(2.7,0.25,0.079,-0.03),a=0.025,b=0.004)),
('combo7',Est(cs=(2.6,0.25,0.079,-0.03),a=0.015,b=0.006)),
('combo8',Est(cs=(2.6,0.25,0.079,-0.03),a=0.025,b=0.006)),
]
for name,est in variants:

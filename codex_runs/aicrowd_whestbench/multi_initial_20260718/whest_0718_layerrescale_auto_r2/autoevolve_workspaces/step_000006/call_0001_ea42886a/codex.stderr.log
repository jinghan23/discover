import itertools, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
import flopscope as flops_mod

class Est:
    def __init__(self,cs,a,b): self.cs=cs; self.a=a; self.b=b
    def predict(self,mlp,budget):
        w=int(mlp.width); d=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed)); per=max(1,d*(2*w*w+4*w)); n=max(1536,int(0.0937*float(budget)/float(per))); n=min(n,8192); n=max(2,2*((n+1)//2))+2
        mu=fnp.zeros(w); var=fnp.ones(w); ac=None; rows=[]; vars=[]
        for li,W in enumerate(mlp.weights):
            mp=W.T@mu
            if ac is None: vp=fnp.maximum((W*W).T@var,1e-12)
            else:
                cw=ac@W; vp=fnp.maximum(fnp.sum(W*cw,axis=0),1e-12); ac=None
            sig=fnp.sqrt(vp); al=mp/sig; phi=flops_mod.stats.norm.pdf(al); cdf=flops_mod.stats.norm.cdf(al)
            mu=mp*cdf+sig*phi; ez2=(mp*mp+vp)*cdf+mp*sig*phi; var=fnp.maximum(ez2-mu*mu,0.0)
            if li==0:
                pc=W.T@W; den=sig[:,None]*sig[None,:]; rho=fnp.maximum(fnp.minimum(pc/fnp.maximum(den,1e-12),1.0),-1.0); root=fnp.sqrt(fnp.maximum(1-rho*rho,0.0)); sec=den*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2*3.141592653589793); ac=sec-mu[:,None]*mu[None,:]
            rows.append(mu); vars.append(var)
        half=n//2; base=fnp.asarray(rng.standard_normal((half,w),dtype=fnp.float32)); sc=(base.T@base)/float(half); x=fnp.concatenate((base,-base),axis=0); ch=fnp.linalg.cholesky(sc); x=fnp.linalg.solve(ch,x.T).T
        for i,W in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@W,0.0)
            if i<len(self.cs):
                c=self.cs[i]
                if c:
                    xm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-xm*xm,1e-12); xs=fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv); x=x*(1-c+c*xs)+c*(rows[i]-xm*xs)
        z=x@mlp.weights[-1]; fmc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0),dtype=fnp.float32); zm=fnp.mean(z,axis=0); zv=fnp.maximum(fnp.mean(z*z,axis=0)-zm*zm,1e-12); zs=fnp.sqrt(zv); za=zm/zs; zg=zm*flops_mod.stats.norm.cdf(za)+zs*flops_mod.stats.norm.pdf(za); diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32); fp=fnp.asarray(fmc+self.a*(zg-fmc)+self.b*(diag[-1]-fmc),dtype=fnp.float32); return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

def make(seedoff):
    cases=[]
    specs=[(64,5,8,500000,1500000000),(64,8,8,500000,2000000000),(64,16,5,400000,4000000000),(128,5,5,300000,6000000000),(128,8,5,300000,8000000000),(128,16,3,250000,16000000000)]
    for width,depth,n,ts,budget in specs:
        for i in range(n):
            mlp=sample_mlp(width,depth,fnp.random.default_rng(seedoff+width*23+depth*101+i),seed=seedoff+9000+width+depth+i*17)
            target=sample_layer_statistics(mlp,ts,rng=fnp.random.default_rng(seedoff+13000+width*3+depth+i))[1]
            cases.append((mlp,target,budget,width,depth))
    return cases
cases=make(50000)

def evalv(cs,a,b):
    est=Est(cs,a,b); ms=[]
    for mlp,target,budget,w,d in cases:
        p=est.predict(mlp,budget)
        ms.append(float(fnp.mean((fnp.asarray(p[-1],dtype=fnp.float64)-fnp.asarray(target,dtype=fnp.float64))**2)))
    return sum(ms)/len(ms)
# Coordinate-ish candidates around current and combo5.
cands=[]
base=(2.55,0.23,0.04,-0.02,0.02,0.005)
for c0 in [2.35,2.45,2.55,2.65,2.75]:
 for c1 in [0.16,0.20,0.23,0.26,0.30]:
  for c2 in [0.00,0.02,0.04,0.06,0.08]:
   for c3 in [-0.06,-0.04,-0.02,0.0,0.02]:
    # limit grid size by simple near relation? use all 625 okay but too slow. Sample subset via condition
    if abs(c0-2.55)+abs(c1-0.23)*5+abs(c2-0.04)*10+abs(c3+0.02)*10 <= 0.65:
     cands.append((c0,c1,c2,c3,0.02,0.005))
for a in [0.0,0.01,0.02,0.03,0.04]:
 for b in [0.0,0.003,0.005,0.008,0.012]:
  cands.append((2.55,0.23,0.04,-0.02,a,b))
# include known
cands += [(2.75,0.31,0.079,-0.0785,0.025,0.002),(2.6,0.25,0.04,-0.03,0.025,0.004),(2.55,0.23,0.04,-0.02,0.02,0.005)]
seen=set(); results=[]; t=time.time()
for idx,c in enumerate(cands):
    if c in seen: continue
    seen.add(c)
    m=evalv(c[:4],c[4],c[5]); results.append((m,c))
    if idx%20==0: print('done',idx,'best',min(results)[0],min(results)[1],flush=True)
results.sort()
print('elapsed',time.time()-t,'n',len(results))
for m,c in results[:20]: print(m,c)

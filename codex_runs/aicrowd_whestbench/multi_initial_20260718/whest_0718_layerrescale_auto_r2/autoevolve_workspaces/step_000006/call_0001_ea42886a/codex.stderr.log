        n=max(self.min_s,int(self.factor*float(budget)/float(per))); n=min(n,self.cap); n=max(2,2*((n+1)//2))+self.plus
        mu=fnp.zeros(wdt); var=fnp.ones(wdt); ac=None; rows=[]; vars=[]
        for li,W in enumerate(mlp.weights):

                root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
                relu_second=denom*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
                act_cov=fnp.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
            rows.append(mu); vars.append(var)
        half=n_samples//2; base=fnp.asarray(rng.standard_normal((half,width),dtype=fnp.float32)); cov=(base.T@base)/float(half)
        x=fnp.concatenate((base,-base),axis=0); chol=fnp.linalg.cholesky(cov); x=fnp.linalg.solve(chol,x.T).T
        for i,w in enumerate(mlp.weights[:-1]):

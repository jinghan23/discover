            if i<len(self.cs):
                c=self.cs[i]
                if c"'!=0.0:
                    xm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-xm*xm,1e-12); xs=fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)
                    x=x*(1.0-c+c*xs)+c*(rows[i]-xm*xs)
        z=x@mlp.weights[-1]
        fmc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0),dtype=fnp.float32)
        zm=fnp.mean(z,axis=0); zv=fnp.maximum(fnp.mean(z*z,axis=0)-zm*zm,1e-12); zs=fnp.sqrt(zv); za=zm/zs
        zg=zm*flops_mod.stats.norm.cdf(za)+zs*flops_mod.stats.norm.pdf(za)
        diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)
        fp=fnp.asarray(fmc+self.a*(zg-fmc)+self.b*(diag[-1]-fmc),dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1],fp[None,:]),axis=0),dtype=fnp.float32)

def make_cases(specs):
    allcases=[]
    for width,depth,n,target_samples,budget in specs:
        cases=[]; t=time.time()
        for i in range(n):
            mlp=sample_mlp(width,depth,fnp.random.default_rng(9000+101*width+17*depth+i),seed=7000+width*3+depth*11+i*19)
            target=sample_layer_statistics(mlp,target_samples,rng=fnp.random.default_rng(12000+width+depth*37+i))[1]
            cases.append((mlp,target,width,depth,budget))
        allcases += cases
        print('"'made',width,depth,n,'time',time.time()-t,flush=True)
    return allcases

def eval_est(est,cases):
    by={}; total=[]; util=[]
    for mlp,target,w,d,budget in cases:
        with flops.BudgetContext(flop_budget=int(1e15),quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        mse=float(fnp.mean((fnp.asarray(pred[-1],dtype=fnp.float64)-fnp.asarray(target,dtype=fnp.float64))**2))
        by.setdefault((w,d),[]).append(mse); total.append(mse); util.append(ctx.flops_used/budget)
    return sum(total)/len(total), {k:sum(v)/len(v) for k,v in by.items()}, sum(util)/len(util)

specs=[(64,5,8,600000,1_500_000_000),(64,8,8,600000,2_000_000_000),(64,16,6,500000,4_000_000_000),(128,5,5,400000,6_000_000_000),(128,8,5,400000,8_000_000_000),(128,16,4,300000,16_000_000_000)]

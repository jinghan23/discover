        n_samples=min(n_samples,self.cap); n_samples=max(2,2*((n_samples+1)//2)); n_samples=n_samples+self.plus
        mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; rows=[]; vars=[]
        for li,w in enumerate(mlp.weights):
            mu_pre=w.T@mu

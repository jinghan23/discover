            sig=fnp.sqrt(var_pre); alpha=mu_pre/sig; phi=flops_mod.stats.norm.pdf(alpha); cdf=flops_mod.stats.norm.cdf(alpha)
            mu=mu_pre*cdf+sig*phi; ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sig*phi; var=fnp.maximum(ez2-mu*mu,0.0)

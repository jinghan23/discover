The main degrees of freedom in the current algorithm are small: layer-wise affine corrections, the final Gaussian/analytic blend, and sample allocation. I’m going to evaluate those locally around the existing values instead of replacing the estimator wholesale.
exec
/bin/bash -lc "python - <<'PY'
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp, sample_layer_statistics
from submission import Estimator as Current
import flopscope as flops_mod

# Configurable clone of current estimator for local synthetic comparisons.
class Est:
    def __init__(self, cs=(2.75,0.310,0.0790,-0.0785), a=0.0250, b=0.0020, factor=0.0937, min_s=1536, cap=8192, plus=2):
        self.cs=cs; self.a=a; self.b=b; self.factor=factor; self.min_s=min_s; self.cap=cap; self.plus=plus
    def predict(self, mlp, budget):
        width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
        per_sample=max(1, depth*(2*width*width+4*width))
        n_samples=max(self.min_s, int((self.factor*float(budget))/float(per_sample)))
        n_samples=min(n_samples, self.cap)
        n_samples=max(2,2*((n_samples+1)//2)); n_samples=n_samples+self.plus
        mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; diag_rows=[]; diag_vars=[]
        for layer_idx,w in enumerate(mlp.weights):
            mu_pre=w.T@mu
            if act_cov is None:
                var_pre=fnp.maximum((w*w).T@var,1e-12)
            else:
                cov_w=act_cov@w; var_pre=fnp.maximum(fnp.sum(w*cov_w,axis=0),1e-12); act_cov=None
            sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
            phi=flops_mod.stats.norm.pdf(alpha); cdf=flops_mod.stats.norm.cdf(alpha)
            mu=mu_pre*cdf+sigma*phi
            ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
            var=fnp.maximum(ez2-mu*mu,0.0)
            if layer_idx==0:
                pre_cov=w.T@w; denom=sigma[:,None]*sigma[None,:]
                rho=fnp.maximum(fnp.minimum(pre_cov/fnp.maximum(denom,1e-12),1.0),-1.0)
                root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
                relu_second=denom*(root+(3.141592653589793-fnp.arccos(rho))*rho)/(2.0*3.141592653589793)
                act_cov=fnp.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
            diag_rows.append(mu); diag_vars.append(var)
        half=n_samples//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        cov=(base.T@base)/float(half)
        x=fnp.concatenate((base,-base),axis=0)
        chol=fnp.linalg.cholesky(cov)
        x=fnp.linalg.solve(chol,x.T).T
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            if i < len(self.cs):
                c=self.cs[i]
                if c "'!= 0.0:
                    x_mean=fnp.mean(x,axis=0)
                    x_var=fnp.maximum(fnp.mean(x*x,axis=0)-x_mean*x_mean,1e-12)
                    x_scale=fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/x_var)
                    x=x*(1.0-c+c*x_scale)+c*(diag_rows[i]-x_mean*x_scale)
        z=x@mlp.weights[-1]
        final_mc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0), dtype=fnp.float32)
        z_mean=fnp.mean(z,axis=0)
        z_var=fnp.maximum(fnp.mean(z*z,axis=0)-z_mean*z_mean,1e-12)
        z_sigma=fnp.sqrt(z_var); z_alpha=z_mean/z_sigma
        z_gauss=z_mean*flops_mod.stats.norm.cdf(z_alpha)+z_sigma*flops_mod.stats.norm.pdf(z_alpha)
        diag=fnp.asarray(fnp.stack(diag_rows,axis=0), dtype=fnp.float32)
        final_pred=fnp.asarray(final_mc+self.a*(z_gauss-final_mc)+self.b*(diag[-1]-final_mc), dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None,:]), axis=0), dtype=fnp.float32)

def make_cases(width, depth, n_mlps, target_samples):
    cases=[]; t=time.time()
    for i in range(n_mlps):
        mlp=sample_mlp(width, depth, fnp.random.default_rng(1000+17*i+width+depth), seed=2000+31*i+width)
        target=sample_layer_statistics(mlp, target_samples, rng=fnp.random.default_rng(3000+13*i+depth))[1]
        cases.append((mlp,target))
    print('"'made',width,depth,n_mlps,'in',time.time()-t, flush=True)
    return cases

def eval_est(est,cases,budget):
    ms=[]; fls=[]
    for mlp,target in cases:
        with flops.BudgetContext(flop_budget=int(1e15), quiet=True) as ctx:
            pred=est.predict(mlp,budget)
        ms.append(float(fnp.mean((fnp.asarray(pred[-1],dtype=fnp.float64)-fnp.asarray(target,dtype=fnp.float64))**2)))
        fls.append(ctx.flops_used/budget)
    return sum(ms)/len(ms), sum(fls)/len(fls)

cases64=make_cases(64,8,12,500000)
cases128=make_cases(128,8,6,300000)
for name,est in [
    ('current',Est()),
    ('final_a0',Est(a=0.0,b=0.0)),
    ('final_a02b0',Est(a=0.02,b=0.0)),
    ('final_a03b0',Est(a=0.03,b=0.0)),
    ('final_a025b0',Est(a=0.025,b=0.0)),
    ('final_a025b004',Est(a=0.025,b=0.004)),
    ('c0_2.6',Est(cs=(2.6,0.31,0.079,-0.0785))),
    ('c0_2.9',Est(cs=(2.9,0.31,0.079,-0.0785))),
    ('c1_0.25',Est(cs=(2.75,0.25,0.079,-0.0785))),
    ('c1_0.37',Est(cs=(2.75,0.37,0.079,-0.0785))),
    ('c2_0.04',Est(cs=(2.75,0.31,0.04,-0.0785))),
    ('c2_0.12',Est(cs=(2.75,0.31,0.12,-0.0785))),
    ('c3_-0.03',Est(cs=(2.75,0.31,0.079,-0.03))),
    ('c3_-0.12',Est(cs=(2.75,0.31,0.079,-0.12))),
    ('morec',Est(cs=(2.75,0.31,0.079,-0.0785,-0.04,-0.02))),
]:
    m64,u64=eval_est(est,cases64,2_000_000_000)
    m128,u128=eval_est(est,cases128,8_000_000_000)
    print(name, 'm64',m64,'u64',u64,'m128',m128,'u128',u128, flush=True)

import numpy as np
from scipy.special import ndtr, ndtri
import time
PI=np.pi; SQ=np.sqrt(2*np.pi)

def relu_moments(mp,vp):
 vp=np.maximum(vp,1e-12); s=np.sqrt(vp); a=mp/s; phi=np.exp(-.5*a*a)/SQ; c=ndtr(a); mu=mp*c+s*phi; ez2=(mp*mp+vp)*c+mp*s*phi; return mu,np.maximum(ez2-mu*mu,0)

def analytic(weights):
 width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); ac=None; dr=[]; dv=[]
 for li,w0 in enumerate(weights):
  w=w0.astype(np.float64); mp=w.T@mu; vp=(w*w).T@var if ac is None else np.sum(w*(ac@w),0)
  if ac is not None: ac=None
  mu,var=relu_moments(mp,vp)
  if li==0:
   pc=w.T@w; s=np.sqrt(np.maximum(vp,1e-12)); den=s[:,None]*s[None,:]; rho=np.clip(pc/np.maximum(den,1e-12),-1,1); root=np.sqrt(np.maximum(1-rho*rho,0)); rel2=den*(root+(PI-np.arccos(rho))*rho)/(2*PI); ac=np.maximum(rel2-mu[:,None]*mu[None,:],0)
  dr.append(mu.copy()); dv.append(var.copy())
 return dr,dv

def lattice(n,width,rng):
 i=np.arange(n,dtype=np.float64)[:,None]+0.5; j=np.arange(width,dtype=np.float64)[None,:]+1.0
 alpha=np.mod(np.sqrt(j+0.37)*1.324717957244746,1.0); shift=rng.random((1,width))
 return ndtri(np.clip(np.mod(i*alpha+shift,1.0),1e-7,1-1e-7)).astype(np.float32)

def probes(width,half,seed,method):

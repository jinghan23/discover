  i=np.arange(half,dtype=np.float64)[:,None]
  j=np.arange(width,dtype=np.float64)[None,:]
  a=2*j+1
  # random odd-ish offset and jitter per dimension
  b=rng.integers(0, max(1,half), size=(1,width))
  jit=rng.random((1,width))
  u=(np.mod(i*a+b,half)+jit)/half
  u=np.clip(u,1e-7,1-1e-7)
  base=ndtri(u).astype(np.float32)
 else: raise ValueError(method)
 cov=(base.T@base)/half
 x=np.concatenate((base,-base),0)
 L=np.linalg.cholesky(cov+np.eye(width)*1e-7)
 return np.linalg.solve(L,x.T).T.astype(np.float32)

def comps(weights,seed,ns,method,cs=(2.75,.310,.079,-.0785)):
 dr,dv=analytic(weights); width=weights[0].shape[0]; n=max(2,2*((ns+1)//2))+2; half=n//2; x=probes(width,half,seed,method)
 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  if i<len(cs):
   xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12); xs=np.sqrt(np.maximum(dv[i],1e-12)/xv); c=cs[i]; x=x*(1-c+c*xs)+c*(dr[i]-xm*xs)
 z=x@weights[-1]; fm=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12); s=np.sqrt(zv); a=zm/s; zg=zm*ndtr(a)+s*np.exp(-.5*a*a)/SQ
 return fm,zg,np.stack(dr)[-1]

def target(weights,seed,n):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); done=0
 while done<n:
  m=min(32768,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s += x.astype(np.float64).sum(0); done += m
 return s/n


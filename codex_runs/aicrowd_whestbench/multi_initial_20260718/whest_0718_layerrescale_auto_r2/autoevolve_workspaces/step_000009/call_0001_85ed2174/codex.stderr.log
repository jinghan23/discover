  nlat=half//2; base=np.vstack([lattice(nlat,width,rng), rng.standard_normal((half-nlat,width),dtype=np.float32)]).astype(np.float32)
 else: raise ValueError
 cov=(base.T@base)/half; x=np.concatenate([base,-base],0); L=np.linalg.cholesky(cov+np.eye(width)*1e-7); return np.linalg.solve(L,x.T).T.astype(np.float32)

def comps(weights,seed,ns,method):

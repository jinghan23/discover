  j=np.arange(width,dtype=np.float64)[None,:]+1.0
  alpha=np.mod(np.sqrt(j+0.37)*1.324717957244746,1.0)
  shift=rng.random((1,width))
  u=np.mod(i*alpha+shift,1.0)
  u=np.clip(u,1e-7,1-1e-7)
  base=ndtri(u).astype(np.float32)

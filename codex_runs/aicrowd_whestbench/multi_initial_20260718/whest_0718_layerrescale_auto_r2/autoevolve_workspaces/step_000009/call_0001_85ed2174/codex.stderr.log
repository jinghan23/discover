import numpy as np
from scipy.special import ndtr
import time

PI=np.pi

def relu_moments(mu_pre, var_pre):
    var_pre=np.maximum(var_pre,1e-12)
    sigma=np.sqrt(var_pre)
    alpha=mu_pre/sigma
    phi=np.exp(-0.5*alpha*alpha)/np.sqrt(2*np.pi)
    cdf=ndtr(alpha)
    mu=mu_pre*cdf+sigma*phi
    ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
    var=np.maximum(ez2-mu*mu,0.0)
    return mu,var

def components(weights, seed, n_samples, cs=(2.75,.310,.0790,-.0785)):
    width=weights[0].shape[0]
    mu=np.zeros(width,dtype=np.float64); var=np.ones(width,dtype=np.float64); act_cov=None
    diag_rows=[]; diag_vars=[]
    for li,w in enumerate(weights):
        wf=w.astype(np.float64)
        mu_pre=wf.T@mu
        if act_cov is None:
            var_pre=(wf*wf).T@var
        else:
            cov_w=act_cov@wf
            var_pre=np.sum(wf*cov_w,axis=0)
            act_cov=None
        mu,var=relu_moments(mu_pre,var_pre)
        if li==0:
            pre_cov=wf.T@wf
            sigma=np.sqrt(np.maximum(var_pre,1e-12))
            denom=sigma[:,None]*sigma[None,:]
            rho=np.clip(pre_cov/np.maximum(denom,1e-12),-1.0,1.0)
            root=np.sqrt(np.maximum(1-rho*rho,0.0))
            relu_second=denom*(root+(PI-np.arccos(rho))*rho)/(2*PI)
            act_cov=np.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
        diag_rows.append(mu.copy()); diag_vars.append(var.copy())
    rng=np.random.default_rng(int(seed))
    n=max(2,2*((n_samples+1)//2))+2
    half=n//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    cov=(base.T@base)/float(half)
    x=np.concatenate((base,-base),axis=0)
    chol=np.linalg.cholesky(cov)
    x=np.linalg.solve(chol,x.T).T.astype(np.float32)
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i < len(cs):
            xm=x.mean(axis=0)
            xv=np.maximum((x*x).mean(axis=0)-xm*xm,1e-12)
            xs=np.sqrt(np.maximum(diag_vars[i],1e-12)/xv)
            c=cs[i]
            x=x*(1.0-c+c*xs)+c*(diag_rows[i]-xm*xs)
    z=x@weights[-1]
    final_mc=np.maximum(z,0.0).mean(axis=0)
    zm=z.mean(axis=0); zv=np.maximum((z*z).mean(axis=0)-zm*zm,1e-12)
    za=zm/np.sqrt(zv)
    zg=zm*ndtr(za)+np.sqrt(zv)*np.exp(-0.5*za*za)/np.sqrt(2*np.pi)
    diag=np.stack(diag_rows,axis=0)
    return final_mc.astype(np.float64), zg.astype(np.float64), diag[-1].astype(np.float64)

def target(weights, seed, n=262144, chunk=32768):
    rng=np.random.default_rng(seed)
    w=weights[0].shape[0]
    s=np.zeros(w,dtype=np.float64); done=0
    while done<n:
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w), dtype=np.float32)
        for W in weights:
            x=np.maximum(x@W,0.0)
        s += x.astype(np.float64).sum(axis=0)
        done += m
    return s/n

def make_weights(width, depth, seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2.0/width)
    return [(rng.standard_normal((width,width), dtype=np.float32)*scale).astype(np.float32) for _ in range(depth)]

configs=[(64,6,1536),(64,6,4096),(64,6,8192),(128,6,4096)]
for width,depth,ns in configs:
    rows=[]; ys=[]
    t0=time.time()
    for j in range(12 if width==64 else 6):
        weights=make_weights(width,depth,10000+97*j+width)
        seed=20000+131*j+depth
        fm,zg,dg=components(weights, seed, ns)
        y=target(weights, 30000+173*j+width, n=131072 if width==64 else 65536)
        rows.append(np.stack([zg-fm,dg-fm],axis=1))
        ys.append(y-fm)
    X=np.concatenate(rows,axis=0); Y=np.concatenate(ys,axis=0)
    coef=np.linalg.lstsq(X,Y,rcond=None)[0]
    base=np.mean(Y*Y)
    cur=np.mean((Y - X@np.array([0.025,0.002]))**2)
    opt=np.mean((Y-X@coef)**2)
    # grid around current for robustness
    best=(cur,0.025,0.002)
    for a in np.linspace(-0.02,0.08,21):
        for b in np.linspace(-0.02,0.04,25):
            mse=np.mean((Y-X@np.array([a,b]))**2)
            if mse<best[0]: best=(mse,a,b)
    print('config',width,depth,ns,'time',round(time.time()-t0,1),'base_mc',base,'current',cur,'lstsq',coef,opt,'grid',best)

 for i,w in enumerate(weights[:-1]):
  x=np.maximum(x@w,0)
  if i<4:
   c=(2.75,.310,.079,-.0785)[i]; xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12); xs=np.sqrt(np.maximum(dv[i],1e-12)/xv); x=x*(1-c+c*xs)+c*(dr[i]-xm*xs)
 z=x@weights[-1]; fm=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12); s=np.sqrt(zv); a=zm/s; zg=zm*ndtr(a)+s*np.exp(-.5*a*a)/SQ
 return fm,zg,np.stack(dr)[-1]

def target(weights,seed,n):
 rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); done=0
 while done<n:
  m=min(32768,n-done); x=rng.standard_normal((m,width),dtype=np.float32)
  for W in weights: x=np.maximum(x@W,0)
  s+=x.astype(np.float64).sum(0); done+=m
 return s/n

def make(width,depth,seed):
 rng=np.random.default_rng(seed); sc=np.sqrt(2/width); return [(rng.standard_normal((width,width),dtype=np.float32)*sc).astype(np.float32) for _ in range(depth)]
for cfg in [(64,6,4096),(64,8,8192),(128,6,4096),(128,8,8192),(256,6,8192),(256,8,8192)]:
 width,depth,ns=cfg; mlps=10 if width==64 else 6 if width==128 else 4; res={m:[] for m in ['random','lattice','mix25','mix50']}; t=time.time()

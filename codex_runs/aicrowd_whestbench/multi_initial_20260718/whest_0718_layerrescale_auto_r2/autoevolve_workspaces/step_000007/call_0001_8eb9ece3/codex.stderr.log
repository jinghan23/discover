    mu=np.zeros(width); var=np.ones(width); covar=None; rows=[]; vars=[]
    for li,w in enumerate(weights):
        mp=w.T@mu
        if covar is None: vp=np.maximum((w*w).T@var,1e-12)
        else:
            cw=covar@w; vp=np.maximum(np.sum(w*cw,axis=0),1e-12); covar=None
        sig=np.sqrt(vp); a=mp/sig; ph=norm.pdf(a); cd=norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0)
        if li==0:
            den=sig[:,None]*sig[None,:]; rho=np.clip((w.T@w)/np.maximum(den,1e-12),-1,1)
            rel=den*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI)
            covar=np.maximum(rel-mu[:,None]*mu[None,:],0)
        rows.append(mu.copy()); vars.append(var.copy())
    half=n_samples//2; base=rng.standard_normal((half,width),dtype=np.float32).astype(np.float64)
    x=np.concatenate((base,-base),0); x=np.linalg.solve(np.linalg.cholesky((base.T@base)/half),x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i<len(coeffs):
            c=coeffs[i]; xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12); xs=np.sqrt(np.maximum(vars[i],1e-12)/xv)
            x=x*(1-c+c*xs)+c*(rows[i]-xm*xs)
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12)
    zs=np.sqrt(zv); za=zm/zs; ga=zm*norm.cdf(za)+zs*norm.pdf(za); di=rows[-1]
    return mc+0.025*(ga-mc)+0.002*(di-mc)
def target(weights, seed, n=262144, chunk=32768):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width); c=0
    while c<n:
        m=min(chunk,n-c); x=rng.standard_normal((m,width),dtype=np.float32).astype(np.float64)
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); c+=m
    return s/c

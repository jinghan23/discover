 'cur':((2.75,0.310,0.079,-0.0785),0.025,0.002,1.0),
 'new':((2.0,0.15,0.05,-0.02),0.023,0.011,0.9996),
 'new_same_final':((2.0,0.15,0.05,-0.02),0.025,0.002,1.0),
 'final_only':((2.75,0.310,0.079,-0.0785),0.023,0.011,0.9996),
}
configs=[]
for width in [32,64,96]:
  for depth in [5,6,8]:
    for scale_mul in [0.8,1.0,1.2,2**0.5]:

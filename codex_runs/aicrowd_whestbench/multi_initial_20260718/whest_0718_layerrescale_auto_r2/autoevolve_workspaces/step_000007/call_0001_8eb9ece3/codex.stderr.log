for width,depth,scale_mul in configs:
    # keep small count for expensive configs
    n_mlp=8 if width<=64 else 5
    n_probe=4098 if width>=96 else 8194
    scores={k:[] for k in sets}
    for j in range(n_mlp):
        rng=np.random.default_rng(20000+1000*width+100*depth+10*j+int(scale_mul*100))
        scale=scale_mul/np.sqrt(width)
        weights=[rng.standard_normal((width,width))*scale for _ in range(depth)]
        tgt=target(weights,30000+j,n=131072 if width>=96 else 196608)

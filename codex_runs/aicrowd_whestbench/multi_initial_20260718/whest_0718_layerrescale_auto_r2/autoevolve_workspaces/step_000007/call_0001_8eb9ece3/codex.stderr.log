from __future__ import annotations
import numpy as np
from scipy.stats import norm

PI=np.pi

def estimator(weights, seed, n_samples=8194, coeffs=(2.75,0.310,0.0790,-0.0785), gb=0.0250, db=0.0020):
    width=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    mu=np.zeros(width)
    var=np.ones(width)
    act_cov=None
    diag_rows=[]; diag_vars=[]
    for layer_idx,w in enumerate(weights):
        mu_pre=w.T@mu
        if act_cov is None:
            var_pre=np.maximum((w*w).T@var,1e-12)
        else:
            cov_w=act_cov@w
            var_pre=np.maximum(np.sum(w*cov_w,axis=0),1e-12)
            act_cov=None
        sigma=np.sqrt(var_pre); alpha=mu_pre/sigma
        phi=norm.pdf(alpha); cdf=norm.cdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=np.maximum(ez2-mu*mu,0.0)
        if layer_idx==0:
            pre_cov=w.T@w
            denom=sigma[:,None]*sigma[None,:]
            rho=np.maximum(np.minimum(pre_cov/np.maximum(denom,1e-12),1.0),-1.0)
            root=np.sqrt(np.maximum(1-rho*rho,0.0))
            relu_second=denom*(root+(PI-np.arccos(rho))*rho)/(2*PI)
            act_cov=np.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
        diag_rows.append(mu.copy()); diag_vars.append(var.copy())
    half=n_samples//2
    base=rng.standard_normal((half,width),dtype=np.float32).astype(np.float64)
    cov=(base.T@base)/float(half)
    x=np.concatenate((base,-base),axis=0)
    chol=np.linalg.cholesky(cov)
    x=np.linalg.solve(chol,x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i < len(coeffs):
            c=coeffs[i]
            x_mean=np.mean(x,axis=0)
            x_var=np.maximum(np.mean(x*x,axis=0)-x_mean*x_mean,1e-12)
            x_scale=np.sqrt(np.maximum(diag_vars[i],1e-12)/x_var)
            x=x*(1.0-c+c*x_scale)+c*(diag_rows[i]-x_mean*x_scale)
    z=x@weights[-1]
    final_mc=np.mean(np.maximum(z,0.0),axis=0)
    z_mean=np.mean(z,axis=0)
    z_var=np.maximum(np.mean(z*z,axis=0)-z_mean*z_mean,1e-12)
    z_sigma=np.sqrt(z_var); z_alpha=z_mean/z_sigma
    z_gauss=z_mean*norm.cdf(z_alpha)+z_sigma*norm.pdf(z_alpha)
    diag=np.stack(diag_rows,axis=0)
    return final_mc+gb*(z_gauss-final_mc)+db*(diag[-1]-final_mc)

def target(weights, seed, n=262144, chunk=32768):
    rng=np.random.default_rng(seed+1000003)
    width=weights[0].shape[0]
    s=np.zeros(width); count=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-count)
        if m<=0: break
        x=rng.standard_normal((m,width))
        for w in weights:
            x=np.maximum(x@w,0.0)
        s += x.sum(axis=0)
        count += m
    return s/count

def run(width=64,depth=6,scale_kind='xavier',n_mlp=12,n_probe=8194):
    mses=[]
    for k in range(n_mlp):
        rng=np.random.default_rng(1234+k)
        if scale_kind=='xavier': scale=1/np.sqrt(width)
        elif scale_kind=='he': scale=np.sqrt(2/width)
        else: scale=float(scale_kind)/np.sqrt(width)
        weights=[rng.standard_normal((width,width))*scale for _ in range(depth)]
        pred=estimator(weights,seed=9000+k,n_samples=n_probe)
        tgt=target(weights,seed=7000+k,n=131072)
        mses.append(np.mean((pred-tgt)**2))
        print(k, mses[-1])
    print('mean',np.mean(mses),'median',np.median(mses))

run()

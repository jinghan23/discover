from __future__ import annotations
import numpy as np
from scipy.stats import norm
PI=np.pi
# Compact copy for comparing coefficient sets.
def pred(weights, seed, n_samples, coeffs, gb=0.025, db=0.002, sc=1.0):
    width=weights[0].shape[0]; rng=np.random.default_rng(seed)
    mu=np.zeros(width); var=np.ones(width); act_cov=None; rows=[]; vars=[]
    for li,w in enumerate(weights):
        mp=w.T@mu
        if act_cov is None: vp=np.maximum((w*w).T@var,1e-12)
        else:
            cw=act_cov@w; vp=np.maximum(np.sum(w*cw,axis=0),1e-12); act_cov=None
        sig=np.sqrt(vp); a=mp/sig; ph=norm.pdf(a); cd=norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0)
        if li==0:
            pc=w.T@w; den=sig[:,None]*sig[None,:]; rho=np.clip(pc/np.maximum(den,1e-12),-1,1)
            rel=den*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI)
            act_cov=np.maximum(rel-mu[:,None]*mu[None,:],0)
        rows.append(mu.copy()); vars.append(var.copy())
    half=n_samples//2
    base=rng.standard_normal((half,width),dtype=np.float32).astype(np.float64)
    cov=(base.T@base)/half; x=np.concatenate((base,-base),0)
    x=np.linalg.solve(np.linalg.cholesky(cov),x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i<len(coeffs):
            c=coeffs[i]; xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12)
            xs=np.sqrt(np.maximum(vars[i],1e-12)/xv)
            x=x*(1-c+c*xs)+c*(rows[i]-xm*xs)
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12)
    zs=np.sqrt(zv); za=zm/zs; ga=zm*norm.cdf(za)+zs*norm.pdf(za); di=rows[-1]
    return sc*(mc+gb*(ga-mc)+db*(di-mc))
def target(weights, seed, n=262144, chunk=32768):
    rng=np.random.default_rng(seed+1000003); width=weights[0].shape[0]
    s=np.zeros(width); c=0
    while c<n:
        m=min(chunk,n-c); x=rng.standard_normal((m,width))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); c+=m
    return s/c

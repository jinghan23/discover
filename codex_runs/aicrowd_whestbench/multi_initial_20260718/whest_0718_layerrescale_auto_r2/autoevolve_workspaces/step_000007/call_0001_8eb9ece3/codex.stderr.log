    means={k:float(np.mean(v)) for k,v in scores.items()}
    rel=means['new']/means['cur'] if means['cur'] else np.nan
    print(f'w{width} d{depth} sm{scale_mul:.3g} cur {means[\"cur\"]:.3e} new {means[\"new\"]:.3e} rel {rel:.3f} final {means[\"final_only\"]:.3e} nsf {means[\"new_same_final\"]:.3e}', flush=True)

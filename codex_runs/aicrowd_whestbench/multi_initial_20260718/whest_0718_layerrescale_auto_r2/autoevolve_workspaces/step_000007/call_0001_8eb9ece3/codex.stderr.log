from __future__ import annotations
import numpy as np
from scipy.stats import norm
PI=np.pi
def pred(weights, seed, coeffs, n_samples=8194):
    wdt=weights[0].shape[0]; rng=np.random.default_rng(seed)
    mu=np.zeros(wdt); var=np.ones(wdt); ac=None; rows=[]; vars=[]
    for li,w in enumerate(weights):
        mp=w.T@mu
        if ac is None: vp=np.maximum((w*w).T@var,1e-12)
        else:
            cw=ac@w; vp=np.maximum(np.sum(w*cw,axis=0),1e-12); ac=None
        sig=np.sqrt(vp); a=mp/sig; ph=norm.pdf(a); cd=norm.cdf(a)
        mu=mp*cd+sig*ph; ez2=(mp*mp+vp)*cd+mp*sig*ph; var=np.maximum(ez2-mu*mu,0)
        if li==0:
            den=sig[:,None]*sig[None,:]; rho=np.clip((w.T@w)/np.maximum(den,1e-12),-1,1)
            rel=den*(np.sqrt(np.maximum(1-rho*rho,0))+(PI-np.arccos(rho))*rho)/(2*PI)
            ac=np.maximum(rel-mu[:,None]*mu[None,:],0)
        rows.append(mu.copy()); vars.append(var.copy())
    half=n_samples//2; base=rng.standard_normal((half,wdt),dtype=np.float32).astype(np.float64)
    x=np.concatenate((base,-base),0); x=np.linalg.solve(np.linalg.cholesky((base.T@base)/half),x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0)
        if i<len(coeffs):
            c=coeffs[i]
            if c "'!= 0:
                xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12); xs=np.sqrt(np.maximum(vars[i],1e-12)/xv)
                x=x*(1-c+c*xs)+c*(rows[i]-xm*xs)
    z=x@weights[-1]; mc=np.maximum(z,0).mean(0); zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12)
    zs=np.sqrt(zv); za=zm/zs; ga=zm*norm.cdf(za)+zs*norm.pdf(za); di=rows[-1]
    return mc+0.025*(ga-mc)+0.002*(di-mc)
def target(weights, seed, n=196608, chunk=32768):
    rng=np.random.default_rng(seed); wdt=weights[0].shape[0]; s=np.zeros(wdt); c=0
    while c<n:
        m=min(chunk,n-c); x=rng.standard_normal((m,wdt))
        for w in weights: x=np.maximum(x@w,0)
        s+=x.sum(0); c+=m
    return s/c
sets={'"'cur':(2.75,0.310,0.079,-0.0785),'first':(1,0,0,0),'none':(0,0,0,0),'mild':(1,0,0.03,0)}
for sigma in [0.25,0.5,0.8,1.0]:
    scores={k:[] for k in sets}
    for k in range(24):
        width=64; depth=6; rng=np.random.default_rng(210000+100*k+int(sigma*100)); base=1/np.sqrt(width)
        scales=np.exp(rng.normal(0,sigma,size=depth))
        # Normalize product to avoid extreme absolute target scale dominating this check.
        scales=scales/(np.prod(scales)**(1.0/depth))
        weights=[rng.standard_normal((width,width))*base*scales[i] for i in range(depth)]
        tgt=target(weights,220000+k)
        for name,cs in sets.items(): scores[name].append(np.mean((pred(weights,230000+k,cs)-tgt)**2))
    print('sigma',sigma,{name:float(np.mean(v)) for name,v in scores.items()},flush=True)

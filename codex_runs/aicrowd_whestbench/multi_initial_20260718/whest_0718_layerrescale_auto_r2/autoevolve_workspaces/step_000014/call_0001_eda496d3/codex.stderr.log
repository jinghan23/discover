+                approx_cov = fnp.maximum(cdf[:, None] * cdf[None, :] * pre_cov, 0.0)
+                act_cov = approx_cov + eye * (var - fnp.sum(eye * approx_cov, axis=0))
 
             diag_rows.append(mu)
             diag_vars.append(var)


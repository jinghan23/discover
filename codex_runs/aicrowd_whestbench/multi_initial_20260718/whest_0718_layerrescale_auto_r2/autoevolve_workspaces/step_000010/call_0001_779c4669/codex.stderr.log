from .domain import MLP


def sample_mlp(
    width: int,
    depth: int,
    rng: Optional[fnp.random.Generator] = None,
    *,
    seed: int = 0,
) -> MLP:
    """Sample a random MLP with He-initialized weight matrices.

    Each weight matrix has shape ``(width, width)`` with entries drawn from

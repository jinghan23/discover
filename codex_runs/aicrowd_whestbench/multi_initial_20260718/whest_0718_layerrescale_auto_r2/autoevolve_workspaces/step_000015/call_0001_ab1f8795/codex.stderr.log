from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
import math
import os
from whestbench import BaseEstimator


SAMPLE_BUDGET_FRAC = float(os.environ.get("WB_SAMPLE_BUDGET_FRAC", "0.0937"))
CORR0 = float(os.environ.get("WB_CORR0", "1.90"))
CORR0_SCALE = float(os.environ.get("WB_CORR0_SCALE", "12.20"))
CORR1 = float(os.environ.get("WB_CORR1", "0.305"))
CORR1_SCALE = float(os.environ.get("WB_CORR1_SCALE", "0.720"))
CORR2 = float(os.environ.get("WB_CORR2", "0.1100"))
CORR2_SCALE = float(os.environ.get("WB_CORR2_SCALE", "0.3000"))
CORR3 = float(os.environ.get("WB_CORR3", "-0.0745"))
CORR3_SCALE = float(os.environ.get("WB_CORR3_SCALE", "-0.0745"))
CORR4 = float(os.environ.get("WB_CORR4", "-0.0080"))
CORR4_SCALE = float(os.environ.get("WB_CORR4_SCALE", "0.0100"))
FINAL_GAUSS_BLEND = float(os.environ.get("WB_FINAL_GAUSS_BLEND", "0.0450"))
FINAL_DIAG_BLEND = float(os.environ.get("WB_FINAL_DIAG_BLEND", "0.0070"))
ACT_COV_OFFDIAG_SCALE = float(os.environ.get("WB_ACT_COV_OFFDIAG_SCALE", "1.0300"))
RADIUS_MODE = int(os.environ.get("WB_RADIUS_MODE", "0"))
EDGE_SKEW_BLEND = float(os.environ.get("WB_EDGE_SKEW_BLEND", "0.0"))
EDGE_KURT_BLEND = float(os.environ.get("WB_EDGE_KURT_BLEND", "0.0"))


class Estimator(BaseEstimator):
    def predict(self, mlp, budget):
        width = int(mlp.width)
        depth = int(mlp.depth)
        rng = fnp.random.default_rng(int(mlp.seed))

        per_sample = max(1, depth * (2 * width * width + 4 * width))
        n_samples = max(1536, int((SAMPLE_BUDGET_FRAC * float(budget)) / float(per_sample)))
        n_samples = min(n_samples, 8192)
        n_samples = max(2, 2 * ((n_samples + 1) // 2))
        n_samples = n_samples + 2

        mu = fnp.zeros(width, dtype=fnp.float32)
        var = fnp.ones(width, dtype=fnp.float32)
        act_cov = None
        eye = fnp.eye(width, dtype=fnp.float32)
        diag_rows = []
        diag_vars = []

        for layer_idx, w in enumerate(mlp.weights):
            mu_pre = w.T @ mu
            if act_cov is None:
                var_pre = fnp.maximum((w * w).T @ var, 1e-12)
            else:
                cov_w = act_cov @ w
                var_pre = fnp.maximum(fnp.sum(w * cov_w, axis=0), 1e-12)
                act_cov = None

            sigma = fnp.sqrt(var_pre)
            alpha = mu_pre / sigma
            phi = flops.stats.norm.pdf(alpha)
            cdf = flops.stats.norm.cdf(alpha)
            mu = mu_pre * cdf + sigma * phi
            ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
            var = fnp.maximum(ez2 - mu * mu, 0.0)

            if layer_idx == 0:
                pre_cov = w.T @ w
                denom = sigma[:, None] * sigma[None, :]
                rho = fnp.maximum(fnp.minimum(pre_cov / fnp.maximum(denom, 1e-12), 1.0), -1.0)
                root = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
                relu_second = denom * (root + (3.141592653589793 - fnp.arccos(rho)) * rho) / (
                    2.0 * 3.141592653589793
                )
                cov0 = fnp.maximum(relu_second - mu[:, None] * mu[None, :], 0.0)
                diag0 = fnp.sum(eye * cov0, axis=0)
                act_cov = ACT_COV_OFFDIAG_SCALE * cov0 + (1.0 - ACT_COV_OFFDIAG_SCALE) * eye * diag0

            diag_rows.append(mu)
            diag_vars.append(var)

        half = n_samples // 2
        base = fnp.asarray(rng.standard_normal((half, width), dtype=fnp.float32))
        x_raw = fnp.concatenate((base, -base), axis=0)
        mean_radius = math.exp(0.5 * math.log(2.0) + math.lgamma(0.5 * (width + 1)) - math.lgamma(0.5 * width))
        if RADIUS_MODE == 2:
            row_norm = fnp.sqrt(fnp.maximum(fnp.sum(x_raw * x_raw, axis=1), 1e-12))
            x = x_raw * (mean_radius / row_norm)[:, None]
        elif RADIUS_MODE == 3:
            row_norm = fnp.sqrt(fnp.maximum(fnp.sum(x_raw * x_raw, axis=1), 1e-12))
            x = x_raw * (fnp.sqrt(float(width)) / row_norm)[:, None]
        else:
            cov = (base.T @ base) / float(half)
            chol = fnp.linalg.cholesky(cov)
            x = fnp.linalg.solve(chol, x_raw.T).T
            if RADIUS_MODE == 1:
                row_norm = fnp.sqrt(fnp.maximum(fnp.sum(x * x, axis=1), 1e-12))
                x = x * (mean_radius / row_norm)[:, None]
            elif RADIUS_MODE == 4:
                row_norm = fnp.sqrt(fnp.maximum(fnp.sum(x * x, axis=1), 1e-12))
                x = x * (fnp.sqrt(float(width)) / row_norm)[:, None]

        for i, w in enumerate(mlp.weights[:-1]):
            x = fnp.maximum(x @ w, 0.0)
            if i == 0:
                x_mean = fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
                c = CORR0
                scale = 1.0 + CORR0_SCALE * (x_scale - 1.0)
                x = (x - x_mean) * scale + (1.0 - c) * x_mean + c * diag_rows[i]
            elif i == 1:
                x_mean = fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
                c = CORR1
                scale = 1.0 + CORR1_SCALE * (x_scale - 1.0)
                x = (x - x_mean) * scale + (1.0 - c) * x_mean + c * diag_rows[i]
            elif i == 2:
                x_mean = fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
                c = CORR2
                scale = 1.0 + CORR2_SCALE * (x_scale - 1.0)
                x = (x - x_mean) * scale + (1.0 - c) * x_mean + c * diag_rows[i]
            elif i == 3:
                x_mean = fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
                c = CORR3
                scale = 1.0 + CORR3_SCALE * (x_scale - 1.0)
                x = (x - x_mean) * scale + (1.0 - c) * x_mean + c * diag_rows[i]
            elif i == 4:
                x_mean = fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x * x, axis=0) - x_mean * x_mean, 1e-12)
                x_scale = fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var)
                c = CORR4
                scale = 1.0 + CORR4_SCALE * (x_scale - 1.0)
                x = (x - x_mean) * scale + (1.0 - c) * x_mean + c * diag_rows[i]

        z = x @ mlp.weights[-1]
        final_mc = fnp.asarray(fnp.mean(fnp.maximum(z, 0.0), axis=0), dtype=fnp.float32)
        z_mean = fnp.mean(z, axis=0)
        z_var = fnp.maximum(fnp.mean(z * z, axis=0) - z_mean * z_mean, 1e-12)
        z_sigma = fnp.sqrt(z_var)
        z_alpha = z_mean / z_sigma
        z_phi = flops.stats.norm.pdf(z_alpha)
        z_gauss = z_mean * flops.stats.norm.cdf(z_alpha) + z_sigma * z_phi
        z_center = z - z_mean
        inv_sigma = 1.0 / z_sigma
        z_skew = fnp.mean(z_center * z_center * z_center, axis=0) * inv_sigma * inv_sigma * inv_sigma
        z_kurt = fnp.mean(z_center * z_center * z_center * z_center, axis=0) * inv_sigma * inv_sigma * inv_sigma * inv_sigma - 3.0
        edge_skew = (-z_sigma * z_phi * z_alpha) * (z_skew / 6.0)
        edge_kurt = (z_sigma * z_phi * (z_alpha * z_alpha - 1.0)) * (z_kurt / 24.0)


codex
The Latin-hypercube sampler is available under modes `5` and `6`. I’m evaluating those two plus the current mode for a direct comparison. 

exec
/bin/bash -lc "python - <<'PY'
import os
import re
import subprocess

for mode in [0, 5, 6]:
    env = os.environ.copy()
    env['WB_RADIUS_MODE'] = str(mode)
    proc = subprocess.run(['python', 'eval_client.py'], cwd='.', env=env, text=True, capture_output=True)
    out = proc.stdout + proc.stderr
    match = re.search(r'raw_score\\s+([0-9.eE+-]+)', out)
    score = match.group(1) if match else 'ERR'
    print(f'WB_RADIUS_MODE={mode} raw_score={score}')
PY" in /opt/tiger/discover/workspace

EDGE_KURT_BLEND = float(os.environ.get("WB_EDGE_KURT_BLEND", "0.0"))
SEED_OFFSET = int(os.environ.get("WB_SEED_OFFSET", "0"))
EXTRA_SAMPLES = int(os.environ.get("WB_EXTRA_SAMPLES", "2"))
FULL_COV_SCALE = float(os.environ.get("WB_FULL_COV_SCALE", "0.0"))


class Estimator(BaseEstimator):
    def predict(self, mlp, budget):
        width = int(mlp.width)
        depth = int(mlp.depth)
        rng = fnp.random.default_rng(int(mlp.seed) + SEED_OFFSET)

        per_sample = max(1, depth * (2 * width * width + 4 * width))
        n_samples = max(1536, int((SAMPLE_BUDGET_FRAC * float(budget)) / float(per_sample)))
        n_samples = min(n_samples, 8192)
        n_samples = max(2, 2 * ((n_samples + 1) // 2))
        n_samples = n_samples + EXTRA_SAMPLES
        if os.environ.get("WB_DEBUG"):
            print("WB_DEBUG", width, depth, float(budget), n_samples, flush=True)

        mu = fnp.zeros(width, dtype=fnp.float32)
        var = fnp.ones(width, dtype=fnp.float32)
        act_cov = None
        eye = fnp.eye(width, dtype=fnp.float32)
        diag_rows = []
        diag_vars = []

        for layer_idx, w in enumerate(mlp.weights):
            mu_pre = w.T @ mu
            pre_cov = None
            if act_cov is None:
                var_pre = fnp.maximum((w * w).T @ var, 1e-12)
            else:
                cov_w = act_cov @ w
                var_pre = fnp.maximum(fnp.sum(w * cov_w, axis=0), 1e-12)
                if FULL_COV_SCALE != 0.0 and layer_idx + 1 < depth:
                    pre_cov = w.T @ cov_w
                act_cov = None

            sigma = fnp.sqrt(var_pre)
            alpha = mu_pre / sigma
            phi = flops.stats.norm.pdf(alpha)
            cdf = flops.stats.norm.cdf(alpha)
            mu = mu_pre * cdf + sigma * phi
            ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
            var = fnp.maximum(ez2 - mu * mu, 0.0)

            if layer_idx == 0:
                pre_cov = w.T @ w
                denom = sigma[:, None] * sigma[None, :]
                rho = fnp.maximum(fnp.minimum(pre_cov / fnp.maximum(denom, 1e-12), 1.0), -1.0)
                root = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
                relu_second = denom * (root + (3.141592653589793 - fnp.arccos(rho)) * rho) / (
                    2.0 * 3.141592653589793
                )
                cov0 = fnp.maximum(relu_second - mu[:, None] * mu[None, :], 0.0)
                diag0 = fnp.sum(eye * cov0, axis=0)
                act_cov = ACT_COV_OFFDIAG_SCALE * cov0 + (1.0 - ACT_COV_OFFDIAG_SCALE) * eye * diag0
            elif pre_cov is not None:
                denom = sigma[:, None] * sigma[None, :]
                rho = fnp.maximum(fnp.minimum(pre_cov / fnp.maximum(denom, 1e-12), 1.0), -1.0)
                root = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
                relu_second = denom * (root + (3.141592653589793 - fnp.arccos(rho)) * rho) / (
                    2.0 * 3.141592653589793
                )
                cov_next = fnp.maximum(relu_second - mu[:, None] * mu[None, :], 0.0)
                cov_diag = fnp.sum(eye * cov_next, axis=0)
                act_cov = eye * var + FULL_COV_SCALE * (cov_next - eye * cov_diag)

            diag_rows.append(mu)


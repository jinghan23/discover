/bin/bash -lc "python - <<'PY'
import os
import re
import subprocess

values = [1.55, 1.70, 1.82, 1.90, 1.98, 2.10, 2.30]
for v in values:
    env = os.environ.copy()
    env['WB_CORR0'] = str(v)
    proc = subprocess.run(['python', 'eval_client.py'], cwd='.', env=env, text=True, capture_output=True)
    out = proc.stdout + proc.stderr
    match = re.search(r'raw_score\\s+([0-9.eE+-]+)', out)
    score = match.group(1) if match else 'ERR'
    print(f'WB_CORR0={v} raw_score={score}')
PY" in /opt/tiger/discover/workspace

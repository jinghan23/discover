import numpy as np
from scipy.special import ndtr
from math import pi

def pdf(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)
def sample_mlp(width,depth,rng): return [(rng.standard_normal((width,width)).astype(np.float32)*np.float32(np.sqrt(2.0/width))) for _ in range(depth)]
def target_mean(weights,n,seed,chunk=2048):
    rng=np.random.default_rng(seed); width=weights[0].shape[0]; s=np.zeros(width,dtype=np.float64); cnt=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,width),dtype=np.float32)
        for w in weights: x=np.maximum(x@w,0.0)
        s+=x.astype(np.float64).sum(0); cnt+=m
    return (s/cnt).astype(np.float32)
def prep(weights):
    width=weights[0].shape[0]; mu=np.zeros(width); var=np.ones(width); act_cov=None; rows=[]; vars=[]
    for li,w in enumerate(weights):
        mu_pre=w.T@mu
        if act_cov is None: var_pre=np.maximum((w*w).T@var,1e-12)
        else:
            cov_w=act_cov@w; var_pre=np.maximum(np.sum(w*cov_w,axis=0),1e-12); act_cov=None
        sigma=np.sqrt(var_pre); a=mu_pre/sigma; ph=pdf(a); c=ndtr(a)
        mu=mu_pre*c+sigma*ph; ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sigma*ph; var=np.maximum(ez2-mu*mu,0)
        if li==0:
            pc=w.T@w; denom=sigma[:,None]*sigma[None,:]; rho=np.clip(pc/np.maximum(denom,1e-12),-1,1)
            root=np.sqrt(np.maximum(1-rho*rho,0)); relu_second=denom*(root+(pi-np.arccos(rho))*rho)/(2*pi)
            act_cov=np.maximum(relu_second-mu[:,None]*mu[None,:],0)
        rows.append(mu); vars.append(var)
    return rows,vars
def pred(weights,rows,vars,coeff,fb,db,sf=0.0937,cap=8192,budget=272_000_000_000,seed=0):
    width=weights[0].shape[0]; depth=len(weights); rng=np.random.default_rng(seed)
    ps=max(1,depth*(2*width*width+4*width)); n=max(1536,int(sf*budget/ps)); n=min(n,cap); n=max(2,2*((n+1)//2)); n=n+2; half=n//2
    base=rng.standard_normal((half,width),dtype=np.float32); cov=(base.T@base)/float(half); x=np.concatenate((base,-base),0); chol=np.linalg.cholesky(cov); x=np.linalg.solve(chol,x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i<len(coeff):
            xm=x.mean(0); xv=np.maximum((x*x).mean(0)-xm*xm,1e-12); xs=np.sqrt(np.maximum(vars[i],1e-12)/xv); cc=coeff[i]
            x=x*(1-cc+cc*xs)+cc*(rows[i]-xm*xs)
    z=x@weights[-1]; fm=np.maximum(z,0).mean(0)
    zm=z.mean(0); zv=np.maximum((z*z).mean(0)-zm*zm,1e-12); zs=np.sqrt(zv); za=zm/zs; zg=zm*ndtr(za)+zs*pdf(za)
    return (fm+fb*(zg-fm)+db*(rows[-1]-fm)).astype(np.float32)
width=256; depth=32; nmlp=4; ntarget=120000
rng=np.random.default_rng(99); data=[]; print('building',flush=True)
for j in range(nmlp):
    weights=sample_mlp(width,depth,rng); rows,vars=prep(weights); t=target_mean(weights,ntarget,11000+j)
    data.append((weights,rows,vars,t,14000+j))
print('built',flush=True)
base=[2.75,0.310,0.0790,-0.0785]; base_fb=0.025; base_db=0.002
def score(coeff=base,fb=base_fb,db=base_db,sf=0.0937,cap=8192):
    vals=[]
    for w,r,v,t,s in data:
        vals.append(np.mean((pred(w,r,v,coeff,fb,db,sf,cap,seed=s)-t)**2))
    return float(np.mean(vals))
print('base',score(),flush=True)
# selected coordinate sweeps
for k,name,grid in [
(0,'c0',[1.2,1.6,2.0,2.4,2.75,3.1]),
(1,'c1',[-0.1,0,0.15,0.31,0.45]),
(2,'c2',[-0.08,-0.03,0,0.04,0.079,0.13]),
(3,'c3',[-0.25,-0.15,-0.0785,0,0.06])]:

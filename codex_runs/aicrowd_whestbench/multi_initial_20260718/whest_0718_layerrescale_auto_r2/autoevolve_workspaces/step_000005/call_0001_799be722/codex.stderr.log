            root=np.sqrt(np.maximum(1-rho*rho,0)); rs=denom*(root+(pi-np.arccos(rho))*rho)/(2*pi)
            act_cov=np.maximum(rs-mu[:,None]*mu[None,:],0)
        rows.append(mu); vars.append(var)
    return rows,vars

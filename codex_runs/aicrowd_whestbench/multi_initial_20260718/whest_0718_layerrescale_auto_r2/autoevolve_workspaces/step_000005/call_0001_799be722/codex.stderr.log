    base=rng.standard_normal((half,width),dtype=np.float32); cov=(base.T@base)/float(half); x=np.concatenate((base,-base),0); chol=np.linalg.cholesky(cov); x=np.linalg.solve(chol,x.T).T
    for i,w in enumerate(weights[:-1]):

        sigma=np.sqrt(var_pre); a=mu_pre/sigma; ph=pdf(a); c=ndtr(a)
        mu=mu_pre*c+sigma*ph; ez2=(mu_pre*mu_pre+var_pre)*c+mu_pre*sigma*ph; var=np.maximum(ez2-mu*mu,0)

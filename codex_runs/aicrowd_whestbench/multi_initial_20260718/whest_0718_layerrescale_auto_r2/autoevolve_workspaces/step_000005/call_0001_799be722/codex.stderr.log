import numpy as np
from scipy.special import ndtr
from math import pi


def pdf(x): return np.exp(-0.5*x*x)/np.sqrt(2*pi)

def sample_mlp(width, depth, rng):
    scale=np.sqrt(2.0/width).astype(np.float32) if hasattr(np.sqrt(2.0/width),'astype') else np.float32(np.sqrt(2.0/width))
    return [(rng.standard_normal((width,width)).astype(np.float32)*scale) for _ in range(depth)]

def target_mean(weights, n=200000, seed=123, chunk=8192):
    rng=np.random.default_rng(seed)
    w0=weights[0]; width=w0.shape[0]
    s=np.zeros(width, dtype=np.float64); cnt=0
    for st in range(0,n,chunk):
        m=min(chunk,n-st)
        x=rng.standard_normal((m,width), dtype=np.float32)
        for w in weights:
            x=np.maximum(x@w, 0.0)
        s += x.astype(np.float64).sum(axis=0)
        cnt += m
    return (s/cnt).astype(np.float32)

def pred(weights, budget=272_000_000_000, coeff=(2.75,0.310,0.0790,-0.0785), fb=0.0250, db=0.0020, sf=0.0937, cap=8192, seed=0):
    width=weights[0].shape[0]; depth=len(weights); rng=np.random.default_rng(seed)
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1536, int((sf*float(budget))/float(per_sample)))
    n_samples=min(n_samples, cap)
    n_samples=max(2, 2*((n_samples+1)//2))
    n_samples=n_samples+2
    mu=np.zeros(width); var=np.ones(width); act_cov=None; rows=[]; vars=[]
    for li,w in enumerate(weights):
        mu_pre=w.T@mu
        if act_cov is None:
            var_pre=np.maximum((w*w).T@var, 1e-12)
        else:
            cov_w=act_cov@w
            var_pre=np.maximum(np.sum(w*cov_w, axis=0), 1e-12); act_cov=None
        sigma=np.sqrt(var_pre); alpha=mu_pre/sigma; ph=pdf(alpha); cdf=ndtr(alpha)
        mu=mu_pre*cdf+sigma*ph
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*ph
        var=np.maximum(ez2-mu*mu, 0.0)
        if li==0:
            pre_cov=w.T@w; denom=sigma[:,None]*sigma[None,:]
            rho=np.maximum(np.minimum(pre_cov/np.maximum(denom,1e-12),1.0),-1.0)
            root=np.sqrt(np.maximum(1-rho*rho,0.0))
            relu_second=denom*(root+(pi-np.arccos(rho))*rho)/(2*pi)
            act_cov=np.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
        rows.append(mu); vars.append(var)
    half=n_samples//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    cov=(base.T@base)/float(half)
    x=np.concatenate((base,-base),axis=0)
    chol=np.linalg.cholesky(cov)
    x=np.linalg.solve(chol,x.T).T
    for i,w in enumerate(weights[:-1]):
        x=np.maximum(x@w,0.0)
        if i<len(coeff):
            xm=x.mean(axis=0); xv=np.maximum((x*x).mean(axis=0)-xm*xm,1e-12)
            xs=np.sqrt(np.maximum(vars[i],1e-12)/xv); c=coeff[i]
            x=x*(1.0-c+c*xs)+c*(rows[i]-xm*xs)
    z=x@weights[-1]
    final_mc=np.maximum(z,0.0).mean(axis=0).astype(np.float32)
    zm=z.mean(axis=0); zv=np.maximum((z*z).mean(axis=0)-zm*zm,1e-12); zs=np.sqrt(zv); za=zm/zs
    zg=zm*ndtr(za)+zs*pdf(za)
    diag=np.stack(rows).astype(np.float32)
    fp=(final_mc + fb*(zg-final_mc)+db*(diag[-1]-final_mc)).astype(np.float32)
    return fp

for width in [64,128]:
    depth=32; rng=np.random.default_rng(1000+width); ms=[]
    for j in range(4 if width==64 else 2):
        weights=sample_mlp(width,depth,rng)
        t=target_mean(weights, n=200000 if width==64 else 60000, seed=2000+j)
        p=pred(weights, seed=3000+j)
        ms.append(np.mean((p-t)**2))
    print('width',width,'mse',ms,'mean',np.mean(ms))

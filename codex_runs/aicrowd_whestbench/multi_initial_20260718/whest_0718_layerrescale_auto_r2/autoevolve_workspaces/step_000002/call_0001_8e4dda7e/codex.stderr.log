from __future__ import annotations
import math, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics

# Baseline estimator core, parameterized for local tests.
def diag_prop(mlp):
    width=int(mlp.width); mu=fnp.zeros(width); var=fnp.ones(width); act_cov=None; rows=[]; vars=[]
    for layer_idx,w in enumerate(mlp.weights):
        mu_pre=w.T@mu
        if act_cov is None:
            var_pre=fnp.maximum((w*w).T@var,1e-12)
        else:
            cov_w=act_cov@w
            var_pre=fnp.maximum(fnp.sum(w*cov_w,axis=0),1e-12)
            act_cov=None
        sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
        phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=fnp.maximum(ez2-mu*mu,0.0)
        if layer_idx==0:
            pre_cov=w.T@w
            denom=sigma[:,None]*sigma[None,:]
            rho=fnp.maximum(fnp.minimum(pre_cov/fnp.maximum(denom,1e-12),1.0),-1.0)
            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0))
            relu_second=denom*(root+(math.pi-fnp.arccos(rho))*rho)/(2.0*math.pi)
            act_cov=fnp.maximum(relu_second-mu[:,None]*mu[None,:],0.0)
        rows.append(mu); vars.append(var)
    return rows, vars

def apply_corr(x, i, rows, vars, coeffs):
    if i in coeffs:
        a,b=coeffs[i]
        # current form: x * (a + b*x_scale) + b*(diag - x_mean*x_scale), except can represent with a,b
        xm=fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(x*x,axis=0)-xm*xm,1e-12)
        xs=fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)
        x=x*(a+b*xs)+b*(rows[i]-xm*xs)
    return x

def estimate(mlp,n=8192, spherical=False, coeffs=None, blend=0.001):
    if coeffs is None:
        coeffs={0:(-1.40,2.40),1:(0.705,0.295),3:(1.05,-0.05),4:(0.9825,0.0175)}
    width=int(mlp.width); depth=int(mlp.depth)
    rng=fnp.random.default_rng(int(mlp.seed))
    rows, vars=diag_prop(mlp)
    half=n//2
    base=fnp.asarray(rng.standard_normal((half+2,width),dtype=fnp.float32))[2:]
    if spherical:
        # normalize half-set first, whiten approximately, normalize again.
        norm=fnp.sqrt(fnp.maximum(fnp.sum(base*base,axis=1,keepdims=True),1e-12))
        base=base*(math.sqrt(width))/norm
        cov=(base.T@base)/float(half)
        chol=fnp.linalg.cholesky(cov)
        base=fnp.linalg.solve(chol,base.T).T
        norm=fnp.sqrt(fnp.maximum(fnp.sum(base*base,axis=1,keepdims=True),1e-12))
        base=base*(math.sqrt(width))/norm
        radial=math.exp((depth/2.0)*math.log(2.0)+math.lgamma((width+depth)/2.0)-math.lgamma(width/2.0)-(depth/2.0)*math.log(width))
    else:
        cov=(base.T@base)/float(half)
        chol=fnp.linalg.cholesky(cov)
        base=fnp.linalg.solve(chol,base.T).T
        radial=1.0
    x=fnp.concatenate((base,-base),axis=0)
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        x=apply_corr(x,i,rows,vars,coeffs)
    z=x@mlp.weights[-1]
    final=fnp.mean(fnp.maximum(z,0.0),axis=0)*radial
    diag=fnp.stack(rows,axis=0)
    pred=final+blend*(diag[-1]-final)
    return fnp.asarray(pred,dtype=fnp.float32), fnp.asarray(diag[-1],dtype=fnp.float32)

def run(width=64,depth=6,n_mlps=8,target_n=262144,n_est=8192):
    rng=fnp.random.default_rng(12345)
    scores={'diag':0.0,'base':0.0,'sph':0.0,'sph0':0.0}
    for i in range(n_mlps):
        mlp=sample_mlp(width,depth,rng,seed=1000+i)
        _,target,_=sample_layer_statistics(mlp,target_n,rng=fnp.random.default_rng(9000+i))
        base,diag=estimate(mlp,n_est,False)
        sph,_=estimate(mlp,n_est,True)
        sph0,_=estimate(mlp,n_est,True,blend=0.0)
        for k,p in [('diag',diag),('base',base),('sph',sph),('sph0',sph0)]:
            scores[k]+=float(fnp.mean((p-target)*(p-target)))
        print(i,{k:scores[k]/(i+1) for k in scores}, flush=True)
    print('FINAL', {k:scores[k]/n_mlps for k in scores})

st=time.time(); run(); print('time',time.time()-st)

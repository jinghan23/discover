        s=fnp.sqrt(vp); a=mp/s; phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0)
        if li==0:

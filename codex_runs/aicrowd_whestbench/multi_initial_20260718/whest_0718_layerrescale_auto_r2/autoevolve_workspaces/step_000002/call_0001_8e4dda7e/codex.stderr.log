            x=x*(a+b*xs)+b*(rows[i]-xm*xs)
    final=fnp.mean(fnp.maximum(x@mlp.weights[-1],0.0),axis=0)*radial
    return fnp.asarray(final+0.001*(rows[-1]-final),dtype=fnp.float32), fnp.asarray(rows[-1],dtype=fnp.float32)

rng=fnp.random.default_rng(12345); scores={k:0.0 for k in ['diag','basec','base','sph','sphw','sphc','sphwc']}
for i in range(8):

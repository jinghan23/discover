            root=fnp.sqrt(fnp.maximum(1.0-rho*rho,0.0)); rs=denom*(root+(math.pi-fnp.arccos(rho))*rho)/(2*math.pi)
            act_cov=fnp.maximum(rs-mu[:,None]*mu[None,:],0.0)
        rows.append(mu); vars.append(var)
    return rows,vars

def est(mlp,n=8192,mode='base',corr=True):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed)); rows,vars=diag_prop(mlp)
    half=n//2; base=fnp.asarray(rng.standard_normal((half+2,width),dtype=fnp.float32))[2:]
    radial=1.0

import numpy as np, math, time
from scipy.special import ndtr

def pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def cdf(a): return ndtr(a)
def gen_ws(w,d,seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2.0/w)
    return [(rng.standard_normal((w,w)).astype(np.float32)*scale) for _ in range(d)]
def target(ws,n,seed,chunk=4096):
    rng=np.random.default_rng(seed); d=len(ws); w=ws[0].shape[0]; sums=np.zeros((d,w),np.float64)
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,w),dtype=np.float32)
        for i,W in enumerate(ws):
            x=np.maximum(x@W,0); sums[i]+=x.sum(0)
    return (sums/n).astype(np.float32)
def diag(ws):
    w=ws[0].shape[0]; mu=np.zeros(w,np.float64); var=np.ones(w,np.float64); rows=[]; vars=[]
    for W in ws:
        Wd=W.astype(np.float64); mup=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12)
        sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=cdf(a)
        mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars
def exact_relu_cov0(W):
    K=(W.T@W).astype(np.float64)
    v=np.maximum(np.diag(K),1e-12); sig=np.sqrt(v)
    rho=K/(sig[:,None]*sig[None,:]); rho=np.clip(rho,-1.0,1.0)
    theta=np.arccos(rho)
    E=(sig[:,None]*sig[None,:])/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-theta)*rho)
    mu=sig/math.sqrt(2*math.pi)
    C=E-np.outer(mu,mu)
    np.fill_diagonal(C, v*(0.5-1/(2*math.pi)))
    # jitter for numerical
    return mu.astype(np.float32), C.astype(np.float32)
def pred(ws, mode='base', factor=0.09375, seed=0):
    width=ws[0].shape[0]; depth=len(ws); budget=272_000_000_000
    ns=max(1024,int(factor*budget/(depth*(2*width*width+4*width)))); ns=min(ns,8192); ns=max(2,2*(ns//2))
    d,vars=diag(ws); rng=np.random.default_rng(seed); half=ns//2
    base=rng.standard_normal((half,width),dtype=np.float32); x=np.concatenate((base,-base),0)
    L=np.linalg.cholesky((x.T@x)/float(ns)); x=np.linalg.solve(L,x.T).T.astype(np.float32)
    coeffs={0:1.8,1:0.17,3:-0.13,4:0.014,5:0.007,8:0.009}
    if mode.startswith('cov0'):
        coeffs={1:0.17,3:-0.13,4:0.014,5:0.007,8:0.009}
    for i,W in enumerate(ws[:-1]):
        x=np.maximum(x@W,0)
        if i==0 and mode.startswith('cov0'):
            mu0,C0=exact_relu_cov0(W)
            xc=x-x.mean(0)
            S=(xc.T@xc)/float(ns)
            # jitter
            try:
                Ls=np.linalg.cholesky(S+np.eye(width,dtype=np.float32)*1e-6)
                Lt=np.linalg.cholesky(C0+np.eye(width,dtype=np.float32)*1e-6)
                xm=np.linalg.solve(Ls,xc.T).T@Lt.T+mu0
            except np.linalg.LinAlgError:
                xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/np.maximum((xc*xc).mean(0),1e-12))+d[i]
            if mode=='cov0': x=xm.astype(np.float32)
            elif mode=='cov0_half': x=(0.5*x+0.5*xm).astype(np.float32)
            elif mode=='cov0_over': x=(-0.2*x+1.2*xm).astype(np.float32)
            continue
        c=coeffs.get(i,0.0)
        if c:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+d[i]
            x=(1-c)*x+c*xm
    z=x@ws[-1]
    fmc=np.maximum(z,0).mean(0).astype(np.float64)
    zmu=z.mean(0); zc=z-zmu; zsig=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); za=zmu/zsig
    fn=(zmu*cdf(za)+zsig*pdf(za)).astype(np.float64)
    return (0.9497*fmc+0.0475*fn+0.0028*d[-1].astype(np.float64)).astype(np.float32)
width=256; depth=32; ntrue=100000; nmlp=5
modes=['base','cov0','cov0_half','cov0_over']
res={m:[] for m in modes}; t0=time.time()
for k in range(nmlp):
    ws=gen_ws(width,depth,110000+k); tgt=target(ws,ntrue,120000+k); print('target',k,time.time()-t0)
    for m in modes:
        p=pred(ws,m,seed=130000+k)
        res[m].append(float(np.mean((p-tgt[-1])**2)))
    print('case',k,{m:res[m][-1] for m in modes})
print('mean', {m:float(np.mean(v)) for m,v in res.items()}, 'time', time.time()-t0)

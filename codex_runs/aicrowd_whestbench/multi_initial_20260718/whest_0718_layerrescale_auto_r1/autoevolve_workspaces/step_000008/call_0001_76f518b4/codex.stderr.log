import numpy as np, math, time
from scipy.special import ndtr

def pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def cdf(a): return ndtr(a)
def gen_ws(w,d,seed):
    rng=np.random.default_rng(seed); scale=np.sqrt(2.0/w)
    return [(rng.standard_normal((w,w)).astype(np.float32)*scale) for _ in range(d)]
def target(ws,n,seed,chunk=4096):
    rng=np.random.default_rng(seed); d=len(ws); w=ws[0].shape[0]; sums=np.zeros((d,w),np.float64)
    for st in range(0,n,chunk):
        m=min(chunk,n-st); x=rng.standard_normal((m,w),dtype=np.float32)
        for i,W in enumerate(ws):
            x=np.maximum(x@W,0); sums[i]+=x.sum(0)
    return (sums/n).astype(np.float32)
def diag(ws):
    w=ws[0].shape[0]; mu=np.zeros(w,np.float64); var=np.ones(w,np.float64); rows=[]; vars=[]
    for W in ws:
        Wd=W.astype(np.float64); mup=Wd.T@mu; vp=np.maximum((Wd*Wd).T@var,1e-12)
        sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=cdf(a)
        mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars
def cov_gain(ws):
    w=ws[0].shape[0]; mu=np.zeros(w,np.float64); cov=np.eye(w,dtype=np.float64); rows=[]
    for W in ws:
        Wd=W.astype(np.float64); mup=Wd.T@mu; cp=Wd.T@cov@Wd
        vp=np.maximum(np.diag(cp),1e-12); sig=np.sqrt(vp); a=mup/sig; ph=pdf(a); cd=cdf(a)
        mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0)
        cov=np.outer(cd,cd)*cp; np.fill_diagonal(cov,var)
        rows.append(mu.astype(np.float32))
    return np.stack(rows)
def features(ws, coeffs, factor=0.09375, seed=0):
    width=ws[0].shape[0]; depth=len(ws); budget=272_000_000_000
    ns=max(1024,int(factor*budget/(depth*(2*width*width+4*width)))); ns=min(ns,8192); ns=max(2,2*(ns//2))
    d,vars=diag(ws); rng=np.random.default_rng(seed); half=ns//2
    base=rng.standard_normal((half,width),dtype=np.float32); x=np.concatenate((base,-base),0)
    L=np.linalg.cholesky((x.T@x)/float(ns)); x=np.linalg.solve(L,x.T).T.astype(np.float32)
    for i,W in enumerate(ws[:-1]):
        x=np.maximum(x@W,0); c=coeffs.get(i,0.0)
        if c:
            xc=x-x.mean(0); xv=np.maximum((xc*xc).mean(0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+d[i]
            x=(1-c)*x+c*xm
    z=x@ws[-1]
    fmc=np.maximum(z,0).mean(0).astype(np.float64)
    zmu=z.mean(0); zc=z-zmu; zsig=np.sqrt(np.maximum((zc*zc).mean(0),1e-12)); za=zmu/zsig
    fn=(zmu*cdf(za)+zsig*pdf(za)).astype(np.float64)
    return np.vstack([fmc,fn,d[-1].astype(np.float64)])
base_c={0:1.8,1:0.17,3:-0.13,4:0.014,5:0.007,8:0.009}
base_bl=np.array([0.9497,0.0475,0.0028])
width=256; depth=32; ntrue=100000; nmlp=5
X=[]; y=[]; res=[]; t0=time.time()

        mu=mup*cd+sig*ph; ez2=(mup*mup+vp)*cd+mup*sig*ph; var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars
def pred(ws, mode, factor, seed):
    width=ws[0].shape[0]; depth=len(ws); ns=max(1024,int(factor*272_000_000_000/(depth*(2*width*width+4*width)))); ns=min(ns,8192); ns=max(2,2*(ns//2))
    d,vars=diag(ws); rng=np.random.default_rng(seed); half=ns//2; x=np.concatenate((rng.standard_normal((half,width),dtype=np.float32), -rng.standard_normal((0,width),dtype=np.float32)),0) if False else None
    base=rng.standard_normal((half,width),dtype=np.float32); x=np.concatenate((base,-base),0)

# Synthetic local comparison; not part of submission.
import numpy as np, math, time
from math import erf, sqrt, pi

def norm_pdf(a): return np.exp(-0.5*a*a)/math.sqrt(2*math.pi)
def norm_cdf(a): return 0.5*(1+np.vectorize(math.erf)(a/math.sqrt(2)))
# vectorize erf is slow; use scipy if available
try:
    from scipy.special import ndtr
    norm_cdf=lambda a: ndtr(a)
except Exception as e:
    pass

def weights(width,depth,seed):
    rng=np.random.default_rng(seed)
    scale=np.sqrt(2.0/width)
    return [(rng.standard_normal((width,width)).astype(np.float32)*scale) for _ in range(depth)]

def target(ws, n=50000, seed=999, chunk=4096):
    rng=np.random.default_rng(seed)
    depth=len(ws); width=ws[0].shape[0]
    sums=np.zeros((depth,width),np.float64)
    done=0
    for start in range(0,n,chunk):
        m=min(chunk,n-start)
        x=rng.standard_normal((m,width), dtype=np.float32)
        for i,w in enumerate(ws):
            x=np.maximum(x@w,0)
            sums[i]+=x.sum(axis=0)
        done+=m
    return (sums/done).astype(np.float32)

def diag(ws):
    width=ws[0].shape[0]
    mu=np.zeros(width,np.float64); var=np.ones(width,np.float64)
    rows=[]; vars=[]
    for w in ws:
        w=w.astype(np.float64)
        mup=w.T@mu
        vp=np.maximum((w*w).T@var,1e-12)
        sig=np.sqrt(vp); a=mup/sig; phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=mup*cdf+sig*phi
        ez2=(mup*mup+vp)*cdf+mup*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        rows.append(mu.astype(np.float32)); vars.append(var.astype(np.float32))
    return np.stack(rows), vars

def cov_gain(ws):
    width=ws[0].shape[0]
    mu=np.zeros(width,np.float64); cov=np.eye(width,dtype=np.float64)
    rows=[]
    for w in ws:
        w=w.astype(np.float64)
        mup=w.T@mu
        cp=w.T@cov@w
        vp=np.maximum(np.diag(cp),1e-12)
        sig=np.sqrt(vp); a=mup/sig; phi=norm_pdf(a); cdf=norm_cdf(a)
        mu=mup*cdf+sig*phi
        ez2=(mup*mup+vp)*cdf+mup*sig*phi
        var=np.maximum(ez2-mu*mu,0)
        gain=np.where(sig>1e-12,cdf,0)
        cov=np.outer(gain,gain)*cp
        np.fill_diagonal(cov,var)
        rows.append(mu.astype(np.float32))
    return np.stack(rows)

def current(ws,budget=272_000_000_000, est_seed=456):
    width=ws[0].shape[0]; depth=len(ws)
    rng=np.random.default_rng(est_seed)
    per_sample=max(1, depth*(2*width*width+4*width))
    n_samples=max(1024, int((0.09375*float(budget))/float(per_sample)))
    n_samples=min(n_samples,8192); n_samples=max(2,2*(n_samples//2))
    d, vars=diag(ws)
    half=n_samples//2
    base=rng.standard_normal((half,width), dtype=np.float32)
    x=np.concatenate((base,-base),axis=0)
    cov=(x.T@x)/float(n_samples)
    chol=np.linalg.cholesky(cov)
    x=np.linalg.solve(chol,x.T).T.astype(np.float32)
    coefs={0:1.8,1:0.17,3:-0.13,4:0.014,5:0.007,8:0.009} # x = (1-c)*x + c*x_match? for i0 c=1.8, i3 c=-0.13
    for i,w in enumerate(ws[:-1]):
        x=np.maximum(x@w,0)
        if i in coefs:
            xc=x-x.mean(axis=0)
            xv=np.maximum((xc*xc).mean(axis=0),1e-12)
            xm=xc*np.sqrt(np.maximum(vars[i],1e-12)/xv)+d[i]
            c=coefs[i]
            x=(1-c)*x+c*xm
    z=x@ws[-1]
    final_mc=np.maximum(z,0).mean(axis=0).astype(np.float32)
    zmu=z.mean(axis=0); zc=z-zmu; zsig=np.sqrt(np.maximum((zc*zc).mean(axis=0),1e-12)); za=zmu/zsig
    fn=(zmu*norm_cdf(za)+zsig*norm_pdf(za)).astype(np.float32)
    fp=(0.9497*final_mc+0.0475*fn+0.0028*d[-1]).astype(np.float32)
    out=d.copy(); out[-1]=fp
    return out

for width,ntrue,nmlp in [(64,200000,5),(128,100000,3)]:
  print('case',width)
  ms={'diag':[],'cov':[],'cur':[]}
  st=time.time()
  for k in range(nmlp):
    ws=weights(width,32,1000+k)
    tgt=target(ws,n=ntrue,seed=2000+k,chunk=4096)
    dg=diag(ws)[0]
    cv=cov_gain(ws)
    cu=current(ws, est_seed=3000+k)
    for name,p in [('diag',dg),('cov',cv),('cur',cu)]:
      ms[name].append(float(((p[-1]-tgt[-1])**2).mean()))
    print(k,{name:ms[name][-1] for name in ms})
  print('mean', {name:np.mean(v) for name,v in ms.items()}, 'time', time.time()-st)

            K=(W.T@W).astype(np.float64); v=np.maximum(np.diag(K),1e-12); sig=np.sqrt(v); den=sig[:,None]*sig[None,:]
            rho=np.clip(K/den,-1,1); th=np.arccos(rho); E=den/(2*math.pi)*(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-th)*rho)
            C=E-np.outer(d[i],d[i]); np.fill_diagonal(C,np.maximum(vars[i],1e-12))
            xc=x-x.mean(0); S=(xc.T@xc)/float(ns); Ls=np.linalg.cholesky(S+np.eye(width)*1e-6); Lt=np.linalg.cholesky(C+np.eye(width)*1e-6)
            x=(np.linalg.solve(Ls,xc.T).T@Lt.T+d[i]).astype(np.float32); continue
        c=coeffs.get(i,0.0)

/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import time
import warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator as Baseline
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

def cov_estimate(mlp):
    width = int(mlp.width)
    mu = fnp.zeros(width)
    cov = fnp.eye(width)
    rows = []
    for w in mlp.weights:
        mu_pre = w.T @ mu
        cov_pre = w.T @ cov @ w
        var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
        sigma = fnp.sqrt(var_pre)
        alpha = mu_pre / sigma
        phi = flops.stats.norm.pdf(alpha)
        cdf = flops.stats.norm.cdf(alpha)
        mu = mu_pre * cdf + sigma * phi
        ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
        var = fnp.maximum(ez2 - mu * mu, 0.0)
        cov = cov_pre * (cdf[:, None] * cdf[None, :])
        cov = cov + fnp.diag(var - fnp.diag(cov))
        rows.append(mu)
    return fnp.asarray(fnp.stack(rows), dtype=fnp.float32)

def run(seed, width=64, depth=16, gt=262144, budget=272_000_000_000):
    ss = fnp.random.SeedSequence(seed).spawn(3)
    mlp = sample_mlp(width, depth, fnp.random.default_rng(ss[0]), seed=int(ss[2].generate_state(1)[0]))
    target, final, _ = sample_layer_statistics(mlp, gt, rng=fnp.random.default_rng(ss[1]))
    b = Baseline().predict(mlp, budget)[-1]
    c = cov_estimate(mlp)[-1]
    return b, c, final

B=[]; C=[]; T=[]
start=time.time()
for seed in range(20):
    b,c,t=run(1000+seed)
    B.append(b); C.append(c); T.append(t)
B=fnp.concatenate(B); C=fnp.concatenate(C); T=fnp.concatenate(T)
d=C-B
base=float(fnp.mean((B-T)**2))
for beta in [-0.05,-0.02,0.0,0.02,0.04,0.06,0.08,0.10,0.12,0.15]:
    mse=float(fnp.mean((B + beta*d - T)**2))
    print(beta, mse, mse/base)
num=float(fnp.mean((T-B)*d)); den=float(fnp.mean(d*d)); print('opt', num/den, 'base', base, 'elapsed', time.time()-start)

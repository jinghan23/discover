from __future__ import annotations
import time, warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

# Copy current estimator prediction, but allow overriding setup x by sign-flipped x via monkeypatch attr.
def predict_with_x(mlp, budget, x_override):
    est=Estimator(); est._probe_width=mlp.width; est._probe_depth=mlp.depth; est._probe_budget=budget; est._probe_x=x_override
    return est.predict(mlp,budget)[-1]


from __future__ import annotations
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

def comps(mlp,budget):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
    per_sample=max(1, depth*(2*width*width+4*width))
    n=max(1024, int((0.09375*float(budget))/float(per_sample))); n=min(n,8192); n=max(2,2*(n//2))
    mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
    for w in mlp.weights:
        mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s
        phi=flops.stats.norm.pdf(a); cdf=flops.stats.norm.cdf(a)
        mu=mp*cdf+s*phi; ez2=(mp*mp+vp)*cdf+mp*s*phi; var=fnp.maximum(ez2-mu*mu,0.0)
        rows.append(mu); vars.append(var)
    half=n//2; base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0)
    cov=(x.T@x)/float(n); chol=fnp.linalg.cholesky(cov); x=fnp.linalg.solve(chol,x.T).T
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        if i in (0,1,3,4,5,8):
            xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
            xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]
            if i==0: x=-0.8*x+1.8*xm
            elif i==1: x=0.83*x+0.17*xm
            elif i==3: x=1.13*x-0.13*xm
            elif i==4: x=0.986*x+0.014*xm
            elif i==5: x=0.993*x+0.007*xm
            elif i==8: x=0.991*x+0.009*xm
    z=x@mlp.weights[-1]
    fm=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0), dtype=fnp.float32)
    zm=fnp.mean(z,axis=0); zc=z-zm; zs=fnp.sqrt(fnp.maximum(fnp.mean(zc*zc,axis=0),1e-12)); za=zm/zs
    fn=fnp.asarray(zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za), dtype=fnp.float32)
    diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)[-1]
    return fm,fn,diag

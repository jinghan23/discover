codex
One plausible improvement is a Gaussian covariance control variate: propagate a full covariance matrix with a ReLU gate approximation, then use that final Gaussian moment as another low-noise correction. I’m going to test that on synthetic MLPs generated from the public sampler before risking it in `submission.py`.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator as Baseline


def cov_estimate(mlp):
    width = int(mlp.width)
    mu = fnp.zeros(width)
    cov = fnp.eye(width)
    rows = []
    for w in mlp.weights:
        mu_pre = w.T @ mu
        cov_pre = w.T @ cov @ w
        var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
        sigma = fnp.sqrt(var_pre)
        alpha = mu_pre / sigma
        phi = flops.stats.norm.pdf(alpha)
        cdf = flops.stats.norm.cdf(alpha)
        mu = mu_pre * cdf + sigma * phi
        ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
        var = fnp.maximum(ez2 - mu * mu, 0.0)
        gate = cdf[:, None] * cdf[None, :]
        cov = cov_pre * gate
        cov = cov + fnp.diag(var - fnp.diag(cov))
        rows.append(mu)
    return fnp.asarray(fnp.stack(rows), dtype=fnp.float32)


def cov_estimate_arc(mlp):
    width = int(mlp.width)
    mu = fnp.zeros(width)
    cov = fnp.eye(width)
    rows = []
    for w in mlp.weights:
        mu_pre = w.T @ mu
        cov_pre = w.T @ cov @ w
        var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-12)
        sigma = fnp.sqrt(var_pre)
        alpha = mu_pre / sigma
        phi = flops.stats.norm.pdf(alpha)
        cdf = flops.stats.norm.cdf(alpha)
        mu = mu_pre * cdf + sigma * phi
        ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
        var = fnp.maximum(ez2 - mu * mu, 0.0)
        denom = sigma[:, None] * sigma[None, :]
        rho = fnp.clip(cov_pre / fnp.maximum(denom, 1e-12), -0.999, 0.999)
        # zero-mean ReLU covariance / linearized covariance ratio
        term = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0)) + (3.141592653589793 - fnp.arccos(rho)) * rho - 1.0
        rho_safe = fnp.where(fnp.abs(rho) > 1e-4, rho, fnp.where(rho >= 0, 1e-4, -1e-4))
        ratio = term * (2.0 / 3.141592653589793) / rho_safe
        ratio = fnp.clip(ratio, 0.2, 4.0)
        gate = cdf[:, None] * cdf[None, :] * ratio
        cov = cov_pre * gate
        cov = cov + fnp.diag(var - fnp.diag(cov))
        rows.append(mu)
    return fnp.asarray(fnp.stack(rows), dtype=fnp.float32)


def eval_once(width=64, depth=16, seed=1, gt=131072, budget=272_000_000_000):
    ss = fnp.random.SeedSequence(seed).spawn(3)
    mlp = sample_mlp(width, depth, fnp.random.default_rng(ss[0]), seed=int(ss[2].generate_state(1)[0]))
    target, final, _ = sample_layer_statistics(mlp, gt, rng=fnp.random.default_rng(ss[1]))
    pred_b = Baseline().predict(mlp, budget)
    pred_c = cov_estimate(mlp)
    pred_a = cov_estimate_arc(mlp)
    mse_b = float(fnp.mean((pred_b[-1] - final) ** 2))
    mse_c = float(fnp.mean((pred_c[-1] - final) ** 2))
    mse_a = float(fnp.mean((pred_a[-1] - final) ** 2))
    # best blend with baseline and cov across this one mlp, for rough sign only
    d = pred_c[-1] - pred_b[-1]
    num = float(fnp.mean((final - pred_b[-1]) * d))
    den = float(fnp.mean(d * d))
    beta = num / den if den > 0 else 0.0
    pred_bl = pred_b[-1] + beta * d
    mse_bl = float(fnp.mean((pred_bl - final) ** 2))
    da = pred_a[-1] - pred_b[-1]
    numa = float(fnp.mean((final - pred_b[-1]) * da))
    dena = float(fnp.mean(da * da))
    betaa = numa / dena if dena > 0 else 0.0
    pred_bla = pred_b[-1] + betaa * da
    mse_bla = float(fnp.mean((pred_bla - final) ** 2))
    return mse_b, mse_c, mse_a, beta, mse_bl, betaa, mse_bla

start=time.time()
for seed in range(1,5):
    print(seed, eval_once(seed=seed, gt=32768))
print('elapsed', time.time()-start)

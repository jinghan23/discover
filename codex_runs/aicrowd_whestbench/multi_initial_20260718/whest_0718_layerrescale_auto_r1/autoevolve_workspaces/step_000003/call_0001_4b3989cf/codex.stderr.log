codex
Sign-flipping a fixed setup bank is too volatile. I’m testing one last setup-based variant: split the same total sample count into several independently whitened blocks, which can improve higher-order coverage while keeping exact covariance in each block.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import warnings, time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

def make_blocked(width,total,seed,k):
    rng=fnp.random.default_rng(seed); blocks=[]
    per=max(2, 2*((total//k)//2))
    for j in range(k):
        half=per//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base),axis=0)
        cov=(x.T@x)/float(per); chol=fnp.linalg.cholesky(cov)
        blocks.append(fnp.asarray(fnp.linalg.solve(chol,x.T).T, dtype=fnp.float32))
    return fnp.concatenate(blocks, axis=0)

def pred_with_x(mlp,budget,x):
    est=Estimator(); est._probe_width=mlp.width; est._probe_depth=mlp.depth; est._probe_budget=budget; est._probe_x=x
    return est.predict(mlp,budget)[-1]
width=256; depth=32; budget=272_000_000_000
ss=fnp.random.SeedSequence(2026).spawn(3)
mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[0]),seed=int(ss[2].generate_state(1)[0]))
_, final,_=sample_layer_statistics(mlp,1048576,rng=fnp.random.default_rng(ss[1]))
base=Estimator().predict(mlp,budget)[-1]
print('base',float(fnp.mean((base-final)**2)))
for k in [1,2,4,8,16]:
    x=make_blocked(width,6176,999,k)
    pred=pred_with_x(mlp,budget,x)
    print('k',k,'n',x.shape[0],float(fnp.mean((pred-final)**2)))

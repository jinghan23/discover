mlp=sample_mlp(width, depth, fnp.random.default_rng(ss[0]), seed=int(ss[2].generate_state(1)[0]))
_, final, _=sample_layer_statistics(mlp, 1048576, rng=fnp.random.default_rng(ss[1]))
base=Estimator().predict(mlp,budget)[-1]
print('base', float(fnp.mean((base-final)**2)))
# construct setup probe like current
est=Estimator(); est.setup(SetupContext(width=width, depth=depth, flop_budget=budget, api_version='x', seed=999)); x=est._probe_x
print('fixed', float(fnp.mean((predict_with_x(mlp,budget,x)-final)**2)))
for off in [0,1,2,3,4,5,11,17,101]:
    rng=fnp.random.default_rng(int(mlp.seed)+off)
    signs=fnp.where(rng.standard_normal(width, dtype=fnp.float32) >= 0.0, 1.0, -1.0)
    pred=predict_with_x(mlp,budget,x*signs)
    print('sign', off, float(fnp.mean((pred-final)**2)))

for seed in range(6):
    ss=fnp.random.SeedSequence(3000+seed).spawn(3)
    mlp=sample_mlp(width,depth,fnp.random.default_rng(ss[0]),seed=int(ss[2].generate_state(1)[0]))
    _,final,_=sample_layer_statistics(mlp,262144,rng=fnp.random.default_rng(ss[1]))
    B.append(Estimator().predict(mlp,budget)[-1]); P.append(pred_x(mlp,budget,x)); T.append(final)
    print('done',seed,flush=True)
B=fnp.concatenate(B); P=fnp.concatenate(P); T=fnp.concatenate(T)
print('base',float(fnp.mean((B-T)**2)))
print('blocked8',float(fnp.mean((P-T)**2)))
# blend with baseline if both predictions available, theoretical diagnostic only
D=P-B
num=float(fnp.mean((T-B)*D)); den=float(fnp.mean(D*D)); print('optbeta',num/den if den else 0)
for beta in [0.25,0.5,0.75,1.0]: print('blend',beta,float(fnp.mean((B+beta*D-T)**2)))
print('elapsed',time.time()-start)

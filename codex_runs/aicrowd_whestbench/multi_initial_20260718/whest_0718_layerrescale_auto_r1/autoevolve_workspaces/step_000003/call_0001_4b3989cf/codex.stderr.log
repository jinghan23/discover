        T.append(final)
    B=fnp.concatenate(B); P=fnp.concatenate(P); T=fnp.concatenate(T)
    return float(fnp.mean((B-T)**2)), float(fnp.mean((P-T)**2))
start=time.time()
for frac in [0.09375,0.096,0.098,0.10]: print(frac, run(frac), flush=True)
print('elapsed',time.time()-start)

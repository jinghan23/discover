/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import time, warnings
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator, SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator as Baseline
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

class SetupProbe(BaseEstimator):
    def __init__(self, frac=0.098, maxn=8192):
        self.frac=frac; self.maxn=maxn; self._x=None; self._n=None
    def setup(self, context):
        width=int(context.width); depth=int(context.depth); budget=int(context.flop_budget)
        per_sample=max(1, depth*(2*width*width+4*width))
        n=max(1024, int((self.frac*float(budget))/float(per_sample)))
        n=min(n,self.maxn); n=max(2,2*(n//2))
        rng=fnp.random.default_rng(int(context.seed))
        half=n//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base),axis=0)
        cov=(x.T@x)/float(n)
        chol=fnp.linalg.cholesky(cov)
        self._x=fnp.linalg.solve(chol,x.T).T
        self._n=n
    def predict(self, mlp, budget):
        width=int(mlp.width); depth=int(mlp.depth)
        if self._x is None:
            self.setup(SetupContext(width=width, depth=depth, flop_budget=int(budget), api_version='x', seed=int(mlp.seed)))
        mu=fnp.zeros(width); var=fnp.ones(width); diag_rows=[]; diag_vars=[]
        for w in mlp.weights:
            mu_pre=w.T@mu; var_pre=fnp.maximum((w*w).T@var,1e-12)
            sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
            phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
            mu=mu_pre*cdf+sigma*phi
            ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
            var=fnp.maximum(ez2-mu*mu,0.0)
            diag_rows.append(mu); diag_vars.append(var)
        x=self._x
        for i,w in enumerate(mlp.weights[:-1]):
            x=fnp.maximum(x@w,0.0)
            if i == 0:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=-0.8*x+1.8*xm
            elif i == 1:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=0.83*x+0.17*xm
            elif i == 3:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=1.13*x-0.13*xm
            elif i == 4:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=0.986*x+0.014*xm
            elif i == 5:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=0.993*x+0.007*xm
            elif i == 8:
                xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
                xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
                x=0.991*x+0.009*xm
        z=x@mlp.weights[-1]
        final_mc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0), dtype=fnp.float32)
        z_mu=fnp.mean(z,axis=0); zc=z-z_mu
        z_sigma=fnp.sqrt(fnp.maximum(fnp.mean(zc*zc,axis=0),1e-12)); za=z_mu/z_sigma
        final_norm=fnp.asarray(z_mu*flops.stats.norm.cdf(za)+z_sigma*flops.stats.norm.pdf(za), dtype=fnp.float32)
        diag=fnp.asarray(fnp.stack(diag_rows, axis=0), dtype=fnp.float32)
        final_pred=fnp.asarray(0.9497*final_mc+0.0475*final_norm+0.0028*diag[-1], dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None,:]), axis=0), dtype=fnp.float32)

def trial(frac, seeds=4, gt=262144):
    est=SetupProbe(frac=frac); est.setup(SetupContext(width=256,depth=32,flop_budget=272_000_000_000,api_version='x',seed=999))
    B=[]; P=[]; T=[]
    for seed in range(seeds):
        ss=fnp.random.SeedSequence(800+seed).spawn(3)
        mlp=sample_mlp(256,32,fnp.random.default_rng(ss[0]), seed=int(ss[2].generate_state(1)[0]))
        _, final, _=sample_layer_statistics(mlp,gt,rng=fnp.random.default_rng(ss[1]))
        B.append(Baseline().predict(mlp,272_000_000_000)[-1])
        P.append(est.predict(mlp,272_000_000_000)[-1])
        T.append(final)
    B=fnp.concatenate(B); P=fnp.concatenate(P); T=fnp.concatenate(T)
    return est._n, float(fnp.mean((B-T)**2)), float(fnp.mean((P-T)**2))
start=time.time()
for frac in [0.09375,0.096,0.098,0.10]:
    print('frac', frac, trial(frac), flush=True)
print('elapsed', time.time()-start)

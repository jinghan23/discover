from __future__ import annotations
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator, SetupContext
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator as Base
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

def make_probes(width,n,seed):
    rng=fnp.random.default_rng(int(seed)); half=n//2
    base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0)
    cov=(x.T@x)/float(n); chol=fnp.linalg.cholesky(cov)
    return fnp.asarray(fnp.linalg.solve(chol,x.T).T,dtype=fnp.float32)

def make_blocked(width,total,seed,k):
    rng=fnp.random.default_rng(seed); blocks=[]; per=max(2,2*((total//k)//2))
    for _ in range(k):
        half=per//2; base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0)
        cov=(x.T@x)/float(per); chol=fnp.linalg.cholesky(cov); blocks.append(fnp.asarray(fnp.linalg.solve(chol,x.T).T,dtype=fnp.float32))
    return fnp.concatenate(blocks,axis=0)
class Hybrid(BaseEstimator):
    def setup(self, context):
        self.total=6176; self.setup_n=3088; self.mlp_n=self.total-self.setup_n
        self.sx=make_blocked(int(context.width), self.setup_n, int(context.seed), 4)
        self.w=int(context.width); self.d=int(context.depth); self.b=int(context.flop_budget)
    def predict(self, mlp, budget):
        # reuse Base implementation by injecting combined probes
        mx=make_probes(int(mlp.width), self.mlp_n, int(mlp.seed))
        x=fnp.concatenate((mx,self.sx),axis=0)
        est=Base(); est._probe_width=mlp.width; est._probe_depth=mlp.depth; est._probe_budget=int(budget); est._probe_x=x
        return est.predict(mlp,budget)

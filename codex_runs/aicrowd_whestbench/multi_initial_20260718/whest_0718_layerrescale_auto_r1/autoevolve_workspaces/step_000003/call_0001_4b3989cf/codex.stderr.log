from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


class Estimator(BaseEstimator):
    def setup(self, context):
        width = int(context.width)
        depth = int(context.depth)
        budget = int(context.flop_budget)
        n_samples = self._sample_count(width, depth, budget, 0.096)
        self._probe_width = width
        self._probe_depth = depth
        self._probe_budget = budget
        self._probe_n = n_samples
        self._probe_x = self._make_probes(width, n_samples, int(context.seed))

    def _sample_count(self, width, depth, budget, fraction):
        per_sample = max(1, depth * (2 * width * width + 4 * width))
        n_samples = max(1024, int((float(fraction) * float(budget)) / float(per_sample)))
        n_samples = min(n_samples, 8192)
        return max(2, 2 * (n_samples // 2))

    def _make_probes(self, width, n_samples, seed):
        rng = fnp.random.default_rng(int(seed))
        half = n_samples // 2
        base = fnp.asarray(rng.standard_normal((half, width), dtype=fnp.float32))
        x = fnp.concatenate((base, -base), axis=0)
        cov = (x.T @ x) / float(n_samples)
        chol = fnp.linalg.cholesky(cov)
        return fnp.asarray(fnp.linalg.solve(chol, x.T).T, dtype=fnp.float32)

    def predict(self, mlp, budget):
        width = int(mlp.width)
        depth = int(mlp.depth)

        mu = fnp.zeros(width)
        var = fnp.ones(width)
        diag_rows = []
        diag_vars = []
        for w in mlp.weights:
            mu_pre = w.T @ mu
            var_pre = fnp.maximum((w * w).T @ var, 1e-12)
            sigma = fnp.sqrt(var_pre)
            alpha = mu_pre / sigma
            phi = flops.stats.norm.pdf(alpha)
            cdf = flops.stats.norm.cdf(alpha)
            mu = mu_pre * cdf + sigma * phi
            ez2 = (mu_pre * mu_pre + var_pre) * cdf + mu_pre * sigma * phi
            var = fnp.maximum(ez2 - mu * mu, 0.0)
            diag_rows.append(mu)
            diag_vars.append(var)

        x = getattr(self, "_probe_x", None)
        if (
            x is None
            or int(getattr(self, "_probe_width", -1)) != width
            or int(getattr(self, "_probe_depth", -1)) != depth
            or int(getattr(self, "_probe_budget", -1)) != int(budget)
        ):
            n_samples = self._sample_count(width, depth, int(budget), 0.09375)
            x = self._make_probes(width, n_samples, int(mlp.seed))

        for i, w in enumerate(mlp.weights[:-1]):
            x = fnp.maximum(x @ w, 0.0)
            if i == 0:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = -0.8 * x + 1.8 * x_match
            elif i == 1:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = 0.83 * x + 0.17 * x_match
            elif i == 3:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = 1.13 * x - 0.13 * x_match
            elif i == 4:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = 0.986 * x + 0.014 * x_match
            elif i == 5:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = 0.993 * x + 0.007 * x_match
            elif i == 8:
                x_center = x - fnp.mean(x, axis=0)
                x_var = fnp.maximum(fnp.mean(x_center * x_center, axis=0), 1e-12)
                x_match = x_center * fnp.sqrt(fnp.maximum(diag_vars[i], 1e-12) / x_var) + diag_rows[i]
                x = 0.991 * x + 0.009 * x_match

        z = x @ mlp.weights[-1]
        final_mc = fnp.asarray(fnp.mean(fnp.maximum(z, 0.0), axis=0), dtype=fnp.float32)
        z_mu = fnp.mean(z, axis=0)
        z_center = z - z_mu
        z_sigma = fnp.sqrt(fnp.maximum(fnp.mean(z_center * z_center, axis=0), 1e-12))
        z_alpha = z_mu / z_sigma
        final_norm = fnp.asarray(
            z_mu * flops.stats.norm.cdf(z_alpha) + z_sigma * flops.stats.norm.pdf(z_alpha),
            dtype=fnp.float32,
        )

        diag = fnp.asarray(fnp.stack(diag_rows, axis=0), dtype=fnp.float32)
        final_pred = fnp.asarray(0.9497 * final_mc + 0.0475 * final_norm + 0.0028 * diag[-1], dtype=fnp.float32)
        return fnp.asarray(fnp.concatenate((diag[:-1], final_pred[None, :]), axis=0), dtype=fnp.float32)


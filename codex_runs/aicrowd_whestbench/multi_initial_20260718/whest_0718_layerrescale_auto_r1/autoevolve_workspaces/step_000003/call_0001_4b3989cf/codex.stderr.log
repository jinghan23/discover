/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import warnings,time
import flopscope as flops
import flopscope.numpy as fnp
from whestbench.generation import sample_mlp
from whestbench.simulation import sample_layer_statistics
from submission import Estimator
warnings.filterwarnings('ignore')
flops.configure(symmetry_warnings=False)

def make_blocked(width,total,seed,k=8):
    rng=fnp.random.default_rng(seed); blocks=[]
    per=max(2,2*((total//k)//2))
    for j in range(k):
        half=per//2
        base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
        x=fnp.concatenate((base,-base),axis=0)
        cov=(x.T@x)/float(per); chol=fnp.linalg.cholesky(cov)
        blocks.append(fnp.asarray(fnp.linalg.solve(chol,x.T).T,dtype=fnp.float32))
    return fnp.concatenate(blocks,axis=0)

def pred_x(mlp,budget,x):
    est=Estimator(); est._probe_width=mlp.width; est._probe_depth=mlp.depth; est._probe_budget=budget; est._probe_x=x
    return est.predict(mlp,budget)[-1]

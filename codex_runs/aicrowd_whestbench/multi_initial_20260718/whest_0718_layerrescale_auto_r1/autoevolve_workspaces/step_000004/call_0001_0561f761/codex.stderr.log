import flopscope.numpy as fnp
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics


def components(mlp, budget=10_000_000_000, coeffs=None):
    width = int(mlp.width); depth = int(mlp.depth)
    rng = fnp.random.default_rng(int(mlp.seed))
    per_sample = max(1, depth * (2 * width * width + 4 * width))
    n_samples = max(1024, int((0.09375 * float(budget)) / float(per_sample)))
    n_samples = min(n_samples, 8192)
    n_samples = max(2, 2 * (n_samples // 2))
    mu = fnp.zeros(width); var = fnp.ones(width)
    diag_rows=[]; diag_vars=[]
    for w in mlp.weights:
        mu_pre = w.T @ mu
        var_pre = fnp.maximum((w*w).T @ var, 1e-12)
        sigma=fnp.sqrt(var_pre); alpha=mu_pre/sigma
        phi=flops.stats.norm.pdf(alpha); cdf=flops.stats.norm.cdf(alpha)
        mu=mu_pre*cdf+sigma*phi
        ez2=(mu_pre*mu_pre+var_pre)*cdf+mu_pre*sigma*phi
        var=fnp.maximum(ez2-mu*mu,0.0)
        diag_rows.append(mu); diag_vars.append(var)
    half=n_samples//2
    base=fnp.asarray(rng.standard_normal((half,width), dtype=fnp.float32))
    x=fnp.concatenate((base,-base),axis=0)
    cov=(x.T@x)/float(n_samples)
    chol=fnp.linalg.cholesky(cov)
    x=fnp.linalg.solve(chol,x.T).T
    if coeffs is None:
        coeffs={0:(-0.8,1.8),1:(0.83,0.17),3:(1.13,-0.13),4:(0.986,0.014),5:(0.993,0.007),8:(0.991,0.009)}
    for i,w in enumerate(mlp.weights[:-1]):
        x=fnp.maximum(x@w,0.0)
        if i in coeffs:
            a,b=coeffs[i]
            xc=x-fnp.mean(x,axis=0)
            xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12)
            xm=xc*fnp.sqrt(fnp.maximum(diag_vars[i],1e-12)/xv)+diag_rows[i]
            x=a*x+b*xm
    z=x@mlp.weights[-1]
    final_mc=fnp.asarray(fnp.mean(fnp.maximum(z,0.0),axis=0),dtype=fnp.float32)
    zm=fnp.mean(z,axis=0); zc=z-zm
    zs=fnp.sqrt(fnp.maximum(fnp.mean(zc*zc,axis=0),1e-12)); za=zm/zs
    final_norm=fnp.asarray(zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za), dtype=fnp.float32)
    diag=fnp.asarray(fnp.stack(diag_rows,axis=0), dtype=fnp.float32)
    cur=fnp.asarray(0.9497*final_mc+0.0475*final_norm+0.0028*diag[-1], dtype=fnp.float32)
    return cur, final_mc, final_norm, diag[-1]


I’m testing a cheaper radial control-variate variant now: keep the existing whitened Gaussian probes and layer corrections, but add a final weighted mean based on the initial row radius. That avoids rerunning the network.
exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import sample_mlp
from whestbench.simulation import sample_layer_statistics

def comps(mlp,budget):
    width=int(mlp.width); depth=int(mlp.depth); rng=fnp.random.default_rng(int(mlp.seed))
    per=max(1,depth*(2*width*width+4*width)); n=max(1024,int((0.09375*float(budget))/float(per))); n=min(n,8192); n=max(2,2*(n//2))
    mu=fnp.zeros(width); var=fnp.ones(width); rows=[]; vars=[]
    for w in mlp.weights:
      mp=w.T@mu; vp=fnp.maximum((w*w).T@var,1e-12); s=fnp.sqrt(vp); a=mp/s
      ph=flops.stats.norm.pdf(a); cd=flops.stats.norm.cdf(a)
      mu=mp*cd+s*ph; ez2=(mp*mp+vp)*cd+mp*s*ph; var=fnp.maximum(ez2-mu*mu,0.0); rows.append(mu); vars.append(var)
    base=fnp.asarray(rng.standard_normal((n//2,width),dtype=fnp.float32)); x=fnp.concatenate((base,-base),axis=0)
    cov=(x.T@x)/float(n); chol=fnp.linalg.cholesky(cov); x=fnp.linalg.solve(chol,x.T).T
    r0=fnp.sqrt(fnp.maximum(fnp.sum(x*x,axis=1),1e-12)); rw=fnp.sqrt(float(width)-0.5)/r0
    lams={0:1.8,1:0.17,3:-0.13,4:0.014,5:0.007,8:0.009}
    for i,w in enumerate(mlp.weights[:-1]):
      x=fnp.maximum(x@w,0.0)
      if i in lams:
        xc=x-fnp.mean(x,axis=0); xv=fnp.maximum(fnp.mean(xc*xc,axis=0),1e-12); xm=xc*fnp.sqrt(fnp.maximum(vars[i],1e-12)/xv)+rows[i]
        lam=lams[i]; x=(1-lam)*x+lam*xm
    z=x@mlp.weights[-1]; rz=fnp.maximum(z,0.0)
    mc=fnp.asarray(fnp.mean(rz,axis=0),dtype=fnp.float32)
    rad=fnp.asarray(fnp.mean(rz*rw[:,None],axis=0),dtype=fnp.float32)
    zm=fnp.mean(z,axis=0); zc=z-zm; zs=fnp.sqrt(fnp.maximum(fnp.mean(zc*zc,axis=0),1e-12)); za=zm/zs
    norm=fnp.asarray(zm*flops.stats.norm.cdf(za)+zs*flops.stats.norm.pdf(za),dtype=fnp.float32)
    diag=fnp.asarray(fnp.stack(rows,axis=0),dtype=fnp.float32)[-1]
    cur=fnp.asarray(0.9497*mc+0.0475*norm+0.0028*diag,dtype=fnp.float32)
    return mc,rad,norm,diag,cur

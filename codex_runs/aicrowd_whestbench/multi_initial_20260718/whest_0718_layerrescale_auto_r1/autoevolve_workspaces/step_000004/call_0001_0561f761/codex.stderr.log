    print('mlp',i,'cur mse',float(fnp.mean((cur-final)**2)),'mc',float(fnp.mean((mc-final)**2)),'norm',float(fnp.mean((norm-final)**2)),'diag',float(fnp.mean((diag-final)**2)))
print('elapsed',time.time()-t0)
# collect to numpy for regression using fnp linalg if possible
X=fnp.concatenate([fnp.stack([a[0],a[1],a[2]],axis=1) for a in xs],axis=0)
y=fnp.concatenate(ys,axis=0)
# solve LS 3 coeff unconstrained
coef=fnp.linalg.solve(X.T@X, X.T@y)
print('coef',coef,'sum',float(fnp.sum(coef)))
pred=X@coef
print('fit mse',float(fnp.mean((pred-y)**2)))
for a in [0.0,0.02,0.04,0.0475,0.06,0.08,0.1]:
  for b in [0.0,0.0028,0.006,0.01]:
    c=1-a-b
    p=c*X[:,0]+a*X[:,1]+b*X[:,2]
    print('blend norm',a,'diag',b,'mse',float(fnp.mean((p-y)**2)))

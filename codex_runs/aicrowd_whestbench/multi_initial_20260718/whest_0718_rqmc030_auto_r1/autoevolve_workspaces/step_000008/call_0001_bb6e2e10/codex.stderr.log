     return rng.random((_N_SHIFTS, width))
 
 
+def _diag_moment_final(weights, width: int) -> fnp.ndarray:
+    mean = fnp.zeros(width, dtype=fnp.float64)
+    second = fnp.ones(width, dtype=fnp.float64)
+    for weight in weights:
+        weight64 = fnp.asarray(weight, dtype=fnp.float64)
+        variance_in = fnp.maximum(second - mean * mean, 0.0)
+        mu = mean @ weight64
+        variance = variance_in @ (weight64 * weight64)
+        sigma = fnp.sqrt(fnp.maximum(variance, 1e-30))
+        alpha = mu / sigma
+        cdf = flops.stats.norm.cdf(alpha)
+        pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+        mean = sigma * pdf + mu * cdf
+        second = (variance + mu * mu) * cdf + mu * sigma * pdf
+    return mean
+
+
 class Estimator(BaseEstimator):

     return rng.random((_N_SHIFTS, width))
 
 
+def _weighted_block_mean(values: fnp.ndarray, start: int, stop: int) -> fnp.ndarray:
+    block_size = stop - start
+    segment_size = block_size // _N_SEGMENTS
+    if segment_size <= 0:
+        return fnp.mean(values[start:stop], axis=0, dtype=fnp.float64)
+
+    base = 1.0 / _N_SEGMENTS
+    center = 0.5 * (_N_SEGMENTS - 1)
+    result = 0.0

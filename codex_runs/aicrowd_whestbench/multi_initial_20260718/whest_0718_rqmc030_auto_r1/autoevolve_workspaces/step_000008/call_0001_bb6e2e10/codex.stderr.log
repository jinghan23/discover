+        if segment_index == _N_SEGMENTS - 1:
+            segment_stop = stop
+        else:
+            segment_stop = segment_start + segment_size
+        weight = base + (segment_index - center) * _SEGMENT_SLOPE
+        result = result + weight * fnp.mean(
+            values[segment_start:segment_stop],
+            axis=0,
+            dtype=fnp.float64,
+        )
+    return result
+
+
 class Estimator(BaseEstimator):

+def _relu_gaussian_moments(mu: fnp.ndarray, var: fnp.ndarray) -> tuple[fnp.ndarray, fnp.ndarray]:
+    var = fnp.maximum(var, 1e-30)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    phi = flops.stats.norm.pdf(alpha)
+    cdf = flops.stats.norm.cdf(alpha)
+    mean = sigma * phi + mu * cdf
+    second = (var + mu * mu) * cdf + mu * sigma * phi
+    relu_var = fnp.maximum(second - mean * mean, 0.0)
+    return mean, relu_var
+

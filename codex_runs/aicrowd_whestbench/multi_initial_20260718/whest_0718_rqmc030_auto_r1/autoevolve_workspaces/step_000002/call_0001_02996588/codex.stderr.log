     )
 
 
+def _diag_moment_rows(mlp) -> fnp.ndarray:
+    width = mlp.width
+    mu = fnp.zeros(width, dtype=fnp.float64)
+    var = fnp.ones(width, dtype=fnp.float64)
+    rows = []
+    for weight in mlp.weights:
+        mu_pre = weight.T @ mu
+        var_pre = (weight * weight).T @ var
+        var_pre = fnp.maximum(var_pre, 1e-18)
+        sigma_pre = fnp.sqrt(var_pre)
+        alpha = mu_pre / sigma_pre
+        phi = flops.stats.norm.pdf(alpha)
+        Phi = flops.stats.norm.cdf(alpha)
+        mu = mu_pre * Phi + sigma_pre * phi
+        second = (mu_pre * mu_pre + var_pre) * Phi + mu_pre * sigma_pre * phi
+        var = fnp.maximum(second - mu * mu, 0.0)
+        rows.append(mu)
+    return fnp.stack(rows, axis=0)
+
+
 class Estimator(BaseEstimator):
     def setup(self, context):
         self._width = context.width
@@ -79,6 +99,8 @@

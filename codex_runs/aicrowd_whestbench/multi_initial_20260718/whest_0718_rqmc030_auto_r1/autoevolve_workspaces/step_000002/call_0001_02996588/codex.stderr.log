     )
 
 
+def _cov_moment_rows(mlp) -> fnp.ndarray:
+    width = mlp.width
+    mu = fnp.zeros(width, dtype=fnp.float64)
+    cov = fnp.eye(width, dtype=fnp.float64)
+    rows = []
+    for weight in mlp.weights:
+        mu_pre = weight.T @ mu
+        cov_pre = weight.T @ cov @ weight
+        var_pre = fnp.maximum(fnp.diag(cov_pre), 1e-18)
+        sigma_pre = fnp.sqrt(var_pre)
+        alpha = mu_pre / sigma_pre
+        phi = flops.stats.norm.pdf(alpha)
+        Phi = flops.stats.norm.cdf(alpha)
+        mu = mu_pre * Phi + sigma_pre * phi
+        second = (mu_pre * mu_pre + var_pre) * Phi + mu_pre * sigma_pre * phi
+        var_post = fnp.maximum(second - mu * mu, 0.0)
+        gain = fnp.where(sigma_pre > 1e-12, Phi, 0.0)
+        cov = fnp.outer(gain, gain) * cov_pre
+        fnp.fill_diagonal(cov, var_post)
+        rows.append(mu)
+    return fnp.stack(rows, axis=0)
+
+

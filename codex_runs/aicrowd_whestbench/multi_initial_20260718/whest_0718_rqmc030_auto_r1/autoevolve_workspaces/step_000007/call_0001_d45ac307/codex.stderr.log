import numpy as np, math
INV=1/math.sqrt(2*math.pi)

def relu_mom(mu,var):
    sig=np.sqrt(np.maximum(var,1e-30))
    a=mu/sig
    # erf via vectorize math.erf slower; use scipy? check
    from scipy.special import ndtr
    Phi=ndtr(a)
    phi=INV*np.exp(-0.5*a*a)
    mean=sig*phi+mu*Phi
    second=(mu*mu+var)*Phi+mu*sig*phi
    return mean, second

def analytic(Ws):
    w=Ws[0]
    var=(w*w).sum(axis=0)
    m=INV*np.sqrt(var)
    q=0.5*var
    for w in Ws[1:]:
        mu=m@w
        var=(q-m*m)@(w*w)
        m,q=relu_mom(mu,var)
    return m

def qmc_like(Ws,n=1024,rm=1.0002):
    width=Ws[0].shape[0]
    # use random normal radius normalized as proxy, not lattice
    x=np.random.randn(n,width).astype(np.float32)
    r=np.linalg.norm(x,axis=1)
    mean_r=math.sqrt(2)*math.exp(math.lgamma((width+1)/2)-math.lgamma(width/2))
    x=x*(rm*mean_r/r)[:,None]
    for w in Ws:
        x=np.maximum(x@w,0)
    return x.mean(axis=0)

def mc_target(Ws,n=200000,chunk=10000):
    width=Ws[0].shape[0]
    s=np.zeros(width)
    for _ in range(n//chunk):
        x=np.random.randn(chunk,width).astype(np.float32)
        for w in Ws:
            x=np.maximum(x@w,0)
        s += x.sum(axis=0)
    return s/n
for width,depth in [(64,30),(128,30),(128,10),(256,30)]:
    ms=[]; ma=[]; mb=[]
    for seed in range(3):
        rng=np.random.default_rng(seed)
        Ws=[(rng.standard_normal((width,width))*math.sqrt(2/width)).astype(np.float32) for _ in range(depth)]
        t=mc_target(Ws,n=50000,chunk=5000)
        a=analytic(Ws)
        q=qmc_like(Ws,n=1024)
        # best blend scalar over this mlp? report mse
        ms.append(np.mean((q-t)**2)); ma.append(np.mean((a-t)**2)); mb.append(np.mean(((0.9*q+0.1*a)-t)**2))
    print('spec',width,depth,'q',np.mean(ms),'ana',np.mean(ma),'blend.1',np.mean(mb))

        uniforms = _shifted_lattice_uniforms(
            self._samples_per_shift,
            self._generator,
            shifts,
        )
        uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
        inputs = flops.stats.norm.ppf(uniforms)
        radius = fnp.sqrt(fnp.sum(inputs * inputs, axis=1))

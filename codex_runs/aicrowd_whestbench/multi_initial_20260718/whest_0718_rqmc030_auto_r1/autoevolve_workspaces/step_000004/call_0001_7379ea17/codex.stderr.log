     return _INV_SQRT_2PI * fnp.sqrt(fnp.sum(weight64 * weight64, axis=0))
 
 
+def _diagonal_gaussian_prediction(mlp) -> fnp.ndarray:
+    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
+    var = fnp.ones(mlp.width, dtype=fnp.float64)
+    rows = []
+    for weight in mlp.weights:
+        weight64 = fnp.asarray(weight, dtype=fnp.float64)
+        pre_mean = mean @ weight64
+        pre_var = var @ (weight64 * weight64)
+        pre_var = fnp.maximum(pre_var, 1e-30)
+        sigma = fnp.sqrt(pre_var)
+        alpha = pre_mean / sigma
+        cdf = flops.stats.norm.cdf(alpha)
+        pdf = flops.stats.norm.pdf(alpha)
+        next_mean = sigma * pdf + pre_mean * cdf
+        second = (pre_var + pre_mean * pre_mean) * cdf + pre_mean * sigma * pdf
+        mean = next_mean
+        var = fnp.maximum(second - mean * mean, 1e-30)
+        rows.append(fnp.asarray(mean, dtype=fnp.float32))
+    return fnp.stack(rows, axis=0)
+
+
 class Estimator(BaseEstimator):
     def setup(self, context):
         self._width = context.width
@@ -105,6 +126,8 @@

+def _relu_moments(mu: fnp.ndarray, var: fnp.ndarray) -> tuple[fnp.ndarray, fnp.ndarray, fnp.ndarray]:
+    var = fnp.maximum(var, _MIN_VAR)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma

+def _relu_moments(mu: fnp.ndarray, var: fnp.ndarray) -> tuple[fnp.ndarray, fnp.ndarray, fnp.ndarray]:
+    var = fnp.maximum(var, _MIN_VAR)
+    sigma = fnp.sqrt(var)
+    alpha = mu / sigma
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    mean = sigma * pdf + mu * cdf
+    second = (var + mu * mu) * cdf + mu * sigma * pdf
+    relu_var = fnp.maximum(second - mean * mean, 0.0)
+    return mean, relu_var, cdf
+

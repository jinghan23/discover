+def _zero_mean_relu_cov(cov: fnp.ndarray) -> tuple[fnp.ndarray, fnp.ndarray]:
+    var = fnp.maximum(fnp.diag(cov), _MIN_VAR)
+    sigma = fnp.sqrt(var)
+    denom = sigma[:, None] * sigma[None, :]
+    rho = fnp.clip(cov / denom, -1.0, 1.0)
+    second = denom * (
+        fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
+        + (math.pi - fnp.arccos(rho)) * rho
+    ) / (2.0 * math.pi)
+    mean = _INV_SQRT_2PI * sigma
+    out_cov = second - mean[:, None] * mean[None, :]
+    return mean, out_cov

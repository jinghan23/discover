codex
I’m going to use synthetic He-initialized MLPs with large Monte Carlo targets to test ideas quickly. This does not inspect hidden targets; it just helps avoid spending many blackbox runs on variants that are predictably biased.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=0.3989422804014327

def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes,dtype=float)

def gen_inputs(N,w,seed,radmul=1.0,shift_offset=1,mode='lattice'):
    from scipy.stats import norm
    if mode=='mc':
        rng=np.random.default_rng(seed+shift_offset); x=rng.standard_normal((N,w)).astype(np.float32)
    else:
        shifts=np.random.default_rng(seed+shift_offset).random((2,w))
        n=N//2
        idx=np.arange(n)[:,None,None]
        g=np.sqrt(first_primes(w)); g=g-np.floor(g)
        u=(idx*g[None,None,:]+shifts[None,:,:])%1.0
        u=u.reshape(n*2,w)
        u=np.clip(u,1e-12,1-1e-12)
        x=norm.ppf(u).astype(np.float64)
    r=np.linalg.norm(x,axis=1)
    meanr=math.sqrt(2)*math.exp(math.lgamma((w+1)/2)-math.lgamma(w/2))*radmul
    x=(x*(meanr/np.maximum(r,1e-30))[:,None]).astype(np.float32)
    return x

def forward_mean(Ws,x):
    a=x
    for W in Ws:
        a=np.maximum(a@W,0)
    return a.mean(0)

def exact_target(Ws, M=200000, seed=999):
    rng=np.random.default_rng(seed); sums=np.zeros(Ws[0].shape[0],dtype=np.float64); done=0
    chunk=10000
    while done<M:
        n=min(chunk,M-done); x=rng.standard_normal((n,Ws[0].shape[0])).astype(np.float32); a=x
        for W in Ws: a=np.maximum(a@W,0)
        sums+=a.sum(0); done+=n
    return (sums/M).astype(np.float32)

def run(w=32,d=8,N=4096,m=10):
    res={}
    for k in ['base','rad100022','mc','anti','match1']:
        res[k]=[]
    for i in range(m):
        rng=np.random.default_rng(1234+i)
        Ws=[(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]
        tgt=exact_target(Ws,100000,10000+i)
        for rad,name in [(1.0,'base'),(1.00022,'rad100022')]:
            x=gen_inputs(N,w,77,rad)
            pred=forward_mean(Ws,x)
            res[name].append(((pred-tgt)**2).mean())
        # random MC fixed radius
        x=gen_inputs(N,w,77,1.0,mode='mc')
        pred=forward_mean(Ws,x); res['mc'].append(((pred-tgt)**2).mean())
        # antithetic complement approximate using x and -x from qmc half
        x=gen_inputs(N//2,w,77,1.0)
        x=np.concatenate([x,-x],0).astype(np.float32)
        pred=forward_mean(Ws,x); res['anti'].append(((pred-tgt)**2).mean())
        # match first means scale
        x=gen_inputs(N,w,77,1.0)
        a=np.maximum(x@Ws[0],0)
        exact=INV*np.sqrt((Ws[0].astype(np.float64)**2).sum(0))
        a=a*(exact/np.maximum(a.mean(0),1e-30))[None,:]
        for W in Ws[1:]: a=np.maximum(a@W,0)
        pred=a.mean(0); res['match1'].append(((pred-tgt)**2).mean())
    print('w d N',w,d,N)
    for k,v in res.items(): print(k, np.mean(v), np.std(v)/np.sqrt(len(v)))
run(32,8,4096,5)
run(64,8,4096,5)
PY" in /opt/tiger/discover/workspace

Before trying another analytic correction in the official loop, I’ll sanity-check a full second-moment zero-mean kernel approximation on synthetic random MLPs. This uses no evaluation data and helps avoid another obviously biased blackbox run.
exec
/bin/bash -lc "python - <<'PY'
import numpy as np, math, time
INV=1/math.sqrt(2*math.pi)

def sample_mlp(w,d,seed=0):
    rng=np.random.default_rng(seed)
    return [(rng.standard_normal((w,w))*math.sqrt(2/w)).astype(np.float32) for _ in range(d)]

def mc(weights,n=200000,seed=1,chunk=20000):
    w=weights[0].shape[0]
    rng=np.random.default_rng(seed)
    s=np.zeros(w,dtype=np.float64)
    done=0
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-done)
        x=rng.standard_normal((m,w)).astype(np.float32)
        for W in weights:
            x=np.maximum(x@W,0)
        s+=x.astype(np.float64).sum(0)
        done+=m
    return s/n

def nngp(weights):
    w=weights[0].shape[0]
    S=np.eye(w,dtype=np.float64)
    mean=None
    for W in weights:
        W=W.astype(np.float64)
        Q=W.T@S@W
        diag=np.maximum(np.diag(Q),1e-30)
        std=np.sqrt(diag)
        outer=np.outer(std,std)
        corr=np.clip(Q/outer,-1,1)
        th=np.arccos(corr)
        S=outer*(np.sin(th)+(math.pi-th)*corr)/(2*math.pi)
        mean=std*INV
    return mean
for w,d in [(16,4),(32,6),(64,8),(64,16)]:
    errs=[]
    rel=[]
    for seed in range(3):
        weights=sample_mlp(w,d,seed)
        target=mc(weights,100000,seed+100)
        pred=nngp(weights)
        mse=((pred-target)**2).mean()
        errs.append(mse)
        rel.append(np.mean(target**2))
    print((w,d),'mse',errs,'target2',rel)

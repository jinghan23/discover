+def _relu_gaussian_moments(
+    mean: fnp.ndarray,
+    variance: fnp.ndarray,
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, 1e-30)
+    sigma = fnp.sqrt(variance)
+    alpha = mean / sigma
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = _INV_SQRT_2PI * fnp.exp(-0.5 * alpha * alpha)
+    relu_mean = sigma * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * sigma * pdf
+    relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 0.0)
+    return relu_mean, relu_variance
+
+
+def _diag_gaussian_final_mean(weights) -> fnp.ndarray:
+    weight = fnp.asarray(weights[0], dtype=fnp.float64)
+    pre_variance = fnp.sum(weight * weight, axis=0)
+    mean = _INV_SQRT_2PI * fnp.sqrt(pre_variance)
+    variance = fnp.maximum(0.5 * pre_variance - mean * mean, 0.0)
+    for weight in weights[1:]:
+        weight64 = fnp.asarray(weight, dtype=fnp.float64)
+        pre_mean = mean @ weight64
+        pre_variance = variance @ (weight64 * weight64)
+        mean, variance = _relu_gaussian_moments(pre_mean, pre_variance)
+    return mean
+
+
 def _make_shifts(seed: int, width: int) -> fnp.ndarray:

            radius = fnp.sqrt(fnp.sum(activations * activations, axis=1))
            radius = fnp.maximum(radius, 1e-30)
            activations = activations * (radius_scale / radius[:, None])
            activations = fnp.asarray(activations, dtype=fnp.float32)

        for weight in mlp.weights:
            activations = fnp.maximum(activations @ weight, 0.0)

        if _N_SHIFTS == 2:
            split = activations.shape[0] // 2
            eighth = split // 8
            if eighth > 0:
                block1_start = split
                a0, a1, a2, a3, a4, a5, a6, a7 = _EIGHT_WEIGHTS
                b0, b1, b2, b3, b4, b5, b6, b7 = _EIGHT_WEIGHTS_1
                block0 = (
                    a0 * fnp.mean(activations[:eighth], axis=0)
                    + a1 * fnp.mean(activations[eighth : 2 * eighth], axis=0)
                    + a2 * fnp.mean(activations[2 * eighth : 3 * eighth], axis=0)
                    + a3 * fnp.mean(activations[3 * eighth : 4 * eighth], axis=0)
                    + a4 * fnp.mean(activations[4 * eighth : 5 * eighth], axis=0)
                    + a5 * fnp.mean(activations[5 * eighth : 6 * eighth], axis=0)
                    + a6 * fnp.mean(activations[6 * eighth : 7 * eighth], axis=0)
                    + a7 * fnp.mean(activations[7 * eighth : split], axis=0)
                )
                block1 = (
                    b0 * fnp.mean(activations[block1_start : block1_start + eighth], axis=0)
                    + b1
                    * fnp.mean(
                        activations[block1_start + eighth : block1_start + 2 * eighth],
                        axis=0,
                    )
                    + b2
                    * fnp.mean(
                        activations[block1_start + 2 * eighth : block1_start + 3 * eighth],
                        axis=0,
                    )
                    + b3
                    * fnp.mean(
                        activations[block1_start + 3 * eighth : block1_start + 4 * eighth],
                        axis=0,
                    )
                    + b4
                    * fnp.mean(
                        activations[block1_start + 4 * eighth : block1_start + 5 * eighth],
                        axis=0,
                    )
                    + b5
                    * fnp.mean(
                        activations[block1_start + 5 * eighth : block1_start + 6 * eighth],
                        axis=0,
                    )
                    + b6
                    * fnp.mean(
                        activations[block1_start + 6 * eighth : block1_start + 7 * eighth],
                        axis=0,
                    )
                    + b7 * fnp.mean(activations[block1_start + 7 * eighth :], axis=0)
                )
            else:
                quarter = split // 4
                if quarter > 0:
                    w0 = 0.25 - 1.5 * _QUARTER_SLOPE
                    w1 = 0.25 - 0.5 * _QUARTER_SLOPE
                    w2 = 0.25 + 0.5 * _QUARTER_SLOPE
                    w3 = 0.25 + 1.5 * _QUARTER_SLOPE
                    v0 = 0.25 - 1.5 * _QUARTER_SLOPE_1
                    v1 = 0.25 - 0.5 * _QUARTER_SLOPE_1
                    v2 = 0.25 + 0.5 * _QUARTER_SLOPE_1
                    v3 = 0.25 + 1.5 * _QUARTER_SLOPE_1
                    block0 = (
                        w0 * fnp.mean(activations[:quarter], axis=0)
                        + w1 * fnp.mean(activations[quarter : 2 * quarter], axis=0)
                        + w2 * fnp.mean(activations[2 * quarter : 3 * quarter], axis=0)
                        + w3 * fnp.mean(activations[3 * quarter : split], axis=0)
                    )
                    block1_start = split
                    block1 = (
                        v0 * fnp.mean(activations[block1_start : block1_start + quarter], axis=0)
                        + v1
                        * fnp.mean(
                            activations[block1_start + quarter : block1_start + 2 * quarter],
                            axis=0,
                        )
                        + v2
                        * fnp.mean(
                            activations[
                                block1_start + 2 * quarter : block1_start + 3 * quarter
                            ],
                            axis=0,
                        )
                        + v3 * fnp.mean(activations[block1_start + 3 * quarter :], axis=0)
                    )
                else:
                    block0 = fnp.mean(activations[:split], axis=0)
                    block1 = fnp.mean(activations[split:], axis=0)
            final_mean = _SHIFT0_WEIGHT * block0 + (1.0 - _SHIFT0_WEIGHT) * block1
        else:
            final_mean = fnp.mean(activations, axis=0)

        if (
            getattr(self, "_zero_rows", None) is not None
            and mlp.width == getattr(self, "_width", None)
            and mlp.depth == getattr(self, "_depth", None)
        ):
            rows = self._zero_rows + [final_mean]
        else:
            filler = fnp.zeros(mlp.width, dtype=fnp.float32)
            rows = [filler] * (mlp.depth - 1) + [final_mean]
        return fnp.stack(rows, axis=0)

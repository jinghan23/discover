from __future__ import annotations

import math
import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.6520
_N_SHIFTS = 2
_SHIFT0_WEIGHT = 0.425
_QUARTER_SLOPE = 0.064
_QUARTER_SLOPE_1 = 0.0450
_RADIUS_MULTIPLIER = 1.00017
_EIGHT_SLOPE = 0.25 * _QUARTER_SLOPE
_EIGHT_SLOPE_1 = 0.25 * _QUARTER_SLOPE_1
_EIGHT_WEIGHTS = (
    0.125 - 3.5 * _EIGHT_SLOPE,
    0.125 - 2.5 * _EIGHT_SLOPE,
    0.125 - 1.5 * _EIGHT_SLOPE,
    0.125 - 0.5 * _EIGHT_SLOPE,
    0.125 + 0.5 * _EIGHT_SLOPE,
    0.125 + 1.5 * _EIGHT_SLOPE,
    0.125 + 2.5 * _EIGHT_SLOPE,
    0.125 + 3.5 * _EIGHT_SLOPE,
)
_EIGHT_WEIGHTS_1 = (
    0.125 - 3.5 * _EIGHT_SLOPE_1,
    0.125 - 2.5 * _EIGHT_SLOPE_1,
    0.125 - 1.5 * _EIGHT_SLOPE_1,
    0.125 - 0.5 * _EIGHT_SLOPE_1,
    0.125 + 0.5 * _EIGHT_SLOPE_1,
    0.125 + 1.5 * _EIGHT_SLOPE_1,
    0.125 + 2.5 * _EIGHT_SLOPE_1,
    0.125 + 3.5 * _EIGHT_SLOPE_1,
)
_TAIL_CLIP = 1e-12
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_FLOAT32_ITEMSIZE = 4
_INV_SQRT_2PI = 0.3989422804014327
_SHIFT_SEED_OFFSET = 1


def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


def _lattice_generator(width: int) -> fnp.ndarray:

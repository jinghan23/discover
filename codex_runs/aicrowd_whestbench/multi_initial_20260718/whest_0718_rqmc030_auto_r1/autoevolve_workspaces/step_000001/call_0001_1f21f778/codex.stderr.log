import math, numpy as np, scipy.special as sp


def first_primes(count):
    primes=[]; c=2
    while len(primes)<count:
        ok=True
        for p in primes:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: primes.append(c)
        c+=1
    return np.array(primes)

def mean_radius(w):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*(w+1))-math.lgamma(0.5*w))

def rqmc(Ws, seed, n, shifts=2, tail=1e-11, radius_mode='mean'):
    w=Ws[0].shape[0]
    n=(n//shifts)*shifts
    spers=n//shifts
    roots=np.sqrt(first_primes(w)); gen=roots-np.floor(roots)
    rng=np.random.default_rng(seed+1)
    sh=rng.random((shifts,w))
    idx=np.arange(spers,dtype=np.float64)[:,None,None]
    u=(idx*gen[None,None,:]+sh[None,:,:])%1.0
    u=u.reshape(spers*shifts,w)
    u=np.clip(u,tail,1-tail)
    x=sp.ndtri(u)
    if radius_mode=='mean':
        r=np.sqrt((x*x).sum(1)); x=x*(mean_radius(w)/np.maximum(r,1e-30))[:,None]
    elif radius_mode=='none':
        pass
    elif radius_mode=='sqrtw':
        r=np.sqrt((x*x).sum(1)); x=x*(math.sqrt(w)/np.maximum(r,1e-30))[:,None]
    for W in Ws:
        x=np.maximum(x@W,0)
    return x.mean(0)

def mc_target(Ws,n=1000000,seed=999,chunk=50000):
    w=Ws[0].shape[0]
    s=np.zeros(w); ss=np.zeros(w); count=0
    rng=np.random.default_rng(seed)
    for _ in range((n+chunk-1)//chunk):
        m=min(chunk,n-count)
        x=rng.standard_normal((m,w))
        for W in Ws:
            x=np.maximum(x@W,0)
        s+=x.sum(0); ss+=(x*x).sum(0); count+=m
    return s/count, ss/count - (s/count)**2

def diag_prop(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w); var=np.ones(w)
    inv=1/math.sqrt(2*math.pi)
    for W in Ws:
        m=mu@W
        v=var@(W*W)
        sig=np.sqrt(np.maximum(v,1e-300))
        a=m/sig
        Phi=sp.ndtr(a); phi=np.exp(-0.5*a*a)*inv
        mu=sig*phi+m*Phi
        second=(v+m*m)*Phi+m*sig*phi
        var=np.maximum(second-mu*mu,0)
    return mu

def full_central_prop(Ws):
    w=Ws[0].shape[0]
    mu=np.zeros(w); C=np.eye(w)
    inv=1/math.sqrt(2*math.pi)
    for W in Ws:
        m=mu@W
        S=W.T@C@W
        v=np.maximum(np.diag(S),1e-300)
        sig=np.sqrt(v)
        a=m/sig
        Phi=sp.ndtr(a); phi=np.exp(-0.5*a*a)*inv
        out_mu=sig*phi+m*Phi
        second=(v+m*m)*Phi+m*sig*phi
        rho=S/np.sqrt(np.outer(v,v)); rho=np.clip(rho,-1,1)
        # zero-mean ReLU covariance approximation for central part
        k=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
        cov=np.sqrt(np.outer(v,v))*(k-1/(2*math.pi))
        np.fill_diagonal(cov, np.maximum(second-out_mu*out_mu,0))
        mu=out_mu; C=cov
    return mu

def zero_second_prop(Ws):
    w=Ws[0].shape[0]
    K=np.eye(w)
    mu=None
    for W in Ws:
        S=W.T@K@W
        d=np.maximum(np.diag(S),1e-300); sd=np.sqrt(d)
        rho=S/np.sqrt(np.outer(d,d)); rho=np.clip(rho,-1,1)
        k=(np.sqrt(np.maximum(1-rho*rho,0))+(math.pi-np.arccos(rho))*rho)/(2*math.pi)
        K=np.sqrt(np.outer(d,d))*k
        mu=sd/math.sqrt(2*math.pi)
    return mu

for w,d,n,target_n in [(16,8,4096,500000),(32,8,4096,300000),(32,16,4096,300000),(64,8,4096,200000)]:
  print('\\ncase',w,d)
  mses=[]
  for seed in range(5):
    rng=np.random.default_rng(1234+seed)
    Ws=[rng.standard_normal((w,w))*math.sqrt(2/w) for _ in range(d)]
    tgt,var=mc_target(Ws,target_n,seed=5000+seed,chunk=50000)
    preds={
      'rqmc': rqmc(Ws, seed, n,2,'mean'),
      'rqmc1': rqmc(Ws, seed, n,1,'mean'),
      'rqmc_none': rqmc(Ws, seed, n,2,'none'),
      'diag': diag_prop(Ws),
      'full_c': full_central_prop(Ws),
      'zero2': zero_second_prop(Ws),
    }
    for name,p in preds.items():
      mse=((p-tgt)**2).mean()
      mses.append((name,mse))
  for name in sorted(set(n for n,m in mses)):
    vals=[m for n,m in mses if n==name]
    print(name, np.mean(vals), vals)

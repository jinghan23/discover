/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import pathlib,re,subprocess,sys,time
path=pathlib.Path('submission.py'); base=path.read_text()

def repl(text,name,val): return re.sub(rf'("'^'"\\s*{name}\\s*=\\s*)[-+0-9.eE]+', rf'\\g<1>{val}', text, flags=re.M)

def run(label,text):
    path.write_text(text)
    start=time.time(); proc=subprocess.run([sys.executable,'eval_client.py'],capture_output=True,text=True,timeout=120)
    out=(proc.stdout or '')+(proc.stderr or '')
    m=re.search(r'raw_score\\s+([0-9.eE+-]+)',out); score=float(m.group(1)) if m else float('inf')
    print(f'{label:26s} score={score:.12g} elapsed={time.time()-start:.1f}s rc={proc.returncode}',flush=True)
    if not m or proc.returncode: print(out[-1000:],flush=True)
    return score,text
best_score,best_text=run('baseline',base)
for name, vals in [
    ('whitening_strength',[1.036,1.040,1.044,1.048,1.056]),
    ('first_mean_match',[-1.75,-1.65,-1.55,-1.50,-1.45]),
    ('first_variance_match',[0.56,0.58,0.60,0.62,0.66]),
]:
    current=best_text
    for v in vals:
        text=repl(current,name,v)
        score,text=run(f'{name}={v}',text)
        if score<best_score:
            best_score,best_text=score,text
            print('NEW_BEST',name,v,score,flush=True)
    print('DONE',name,'global',best_score,flush=True)
path.write_text(best_text); print('BEST',best_score,flush=True)

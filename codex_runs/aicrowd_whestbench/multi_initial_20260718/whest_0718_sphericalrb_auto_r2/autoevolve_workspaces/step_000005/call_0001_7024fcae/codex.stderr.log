exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import pathlib, re, subprocess, sys, time

path = pathlib.Path('submission.py')
base = path.read_text()

params = {
    'target_flop_fraction': 0.10,
    'sample_delta': -4,
    'whitening_strength': 1.032,
    'final_scale': 0.99938,
    'final_gaussian_blend': -0.03,
    'final_nested_blend': 0.23,
    'final_tail_blend': -0.065,
    'first_mean_match': -1.40,
    'first_variance_match': 0.58,
}

def render(p):
    text = base
    for name, value in p.items():
        if isinstance(value, int):
            literal = str(value)
        else:
            literal = repr(float(value))
        text = re.sub(rf'("'^'"\\s*{name}\\s*=\\s*)[-+0-9.eE]+', rf'\\g<1>{literal}', text, flags=re.M)
    return text

def eval_candidate(label, p):
    path.write_text(render(p))
    start = time.time()
    proc = subprocess.run([sys.executable, 'eval_client.py'], text=True, capture_output=True, timeout=120)
    elapsed = time.time() - start
    out = (proc.stdout or '') + (proc.stderr or '')
    m = re.search(r'raw_score\\s+([0-9.eE+-]+)', out)
    score = float(m.group(1)) if m else float('inf')
    print(f'{label:32s} score={score:.12g} elapsed={elapsed:.1f}s rc={proc.returncode}', flush=True)
    if not m or proc.returncode "'!= 0:
        print(out[-1200:], flush=True)
    return score, out

best_params = dict(params)
best_text = render(best_params)
best_score, _ = eval_candidate('"'baseline', best_params)

sweeps = [
    ('target_flop_fraction', [0.092, 0.096, 0.100, 0.104, 0.108]),
    ('sample_delta', [-6, -4, -2, 2]),
    ('whitening_strength', [1.020, 1.028, 1.032, 1.036, 1.044]),
    ('final_scale', [0.99928, 0.99934, 0.99938, 0.99942, 0.99948]),
    ('final_gaussian_blend', [-0.050, -0.040, -0.030, -0.020, -0.010]),
    ('final_nested_blend', [0.210, 0.220, 0.230, 0.240, 0.250]),
    ('final_tail_blend', [-0.085, -0.075, -0.065, -0.055, -0.045]),
    ('first_mean_match', [-1.55, -1.45, -1.40, -1.35, -1.25]),
    ('first_variance_match', [0.52, 0.56, 0.58, 0.60, 0.64]),
]

for name, values in sweeps:
    local_best_score = best_score
    local_best_value = best_params[name]
    for value in values:
        if value == best_params[name]:
            continue
        trial = dict(best_params)
        trial[name] = value
        score, _ = eval_candidate(f'{name}={value}', trial)
        if score < best_score:
            best_score = score
            best_params = trial
            best_text = render(best_params)
            print(f'NEW_BEST {best_score:.12g} {best_params}', flush=True)
        if score < local_best_score:
            local_best_score = score
            local_best_value = value
    print(f'completed {name}; local best {local_best_value} {local_best_score:.12g}; global {best_score:.12g}', flush=True)

path.write_text(best_text)
print('BEST', best_score, best_params, flush=True)

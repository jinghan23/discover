/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import pathlib, re, subprocess, sys, time
path=pathlib.Path('submission.py')
base=path.read_text()

def run(v):
    text=re.sub(r'("'^'"\\s*final_quarter_blend\\s*=\\s*)[-+0-9.eE]+', rf'\\g<1>{v}', base, flags=re.M)
    path.write_text(text)
    start=time.time()
    proc=subprocess.run([sys.executable,'eval_client.py'],capture_output=True,text=True,timeout=120)
    out=(proc.stdout or '')+(proc.stderr or '')
    m=re.search(r'raw_score\\s+([0-9.eE+-]+)',out)
    score=float(m.group(1)) if m else float('inf')
    print(f'quarter={v:<7} score={score:.12g} elapsed={time.time()-start:.1f}s rc={proc.returncode}',flush=True)
    if not m or proc.returncode "'!= 0: print(out[-1000:],flush=True)
    return score,text
best=(float('"'inf'),base)
for v in [0.0,-0.20,-0.10,-0.05,0.05,0.10,0.20,0.35,-0.35]:
    score,text=run(v)
    if score<best[0]:
        best=(score,text); print('NEW_BEST',v,score,flush=True)
path.write_text(best[1])
print('BEST',best[0],flush=True)

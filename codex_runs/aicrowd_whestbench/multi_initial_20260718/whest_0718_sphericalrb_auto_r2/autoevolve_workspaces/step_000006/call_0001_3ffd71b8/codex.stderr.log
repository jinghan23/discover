+        exact_values, exact_vectors = fnp.linalg.eigh(exact_covariance)
+        sample_values = fnp.maximum(sample_values, _COVARIANCE_EIGENVALUE_FLOOR)
+        exact_values = fnp.maximum(exact_values, _COVARIANCE_EIGENVALUE_FLOOR)
+        covariance_transform = (
+            (sample_vectors / fnp.sqrt(sample_values))
+            @ sample_vectors.T
+            @ (exact_vectors * fnp.sqrt(exact_values))
+            @ exact_vectors.T
+        )
+        covariance_matched = first_exact + centered @ covariance_transform
+        activations = activations + self.first_covariance_match * (
+            covariance_matched - activations
+        )

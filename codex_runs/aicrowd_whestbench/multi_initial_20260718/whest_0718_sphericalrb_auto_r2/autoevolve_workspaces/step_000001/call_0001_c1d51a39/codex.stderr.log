diff --git a/submission.py b/submission.py
index 7d9ce815ce64e36c67c505ae42cf4d6d32867690..b24abf25c0ddbbf213171bcafada933a88be7acb
--- a/submission.py
+++ b/submission.py
@@ -108,13 +108,39 @@
     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _diagonal_propagation_rows(mlp) -> fnp.ndarray:
+    mu = fnp.zeros(mlp.width, dtype=fnp.float64)
+    variance = fnp.ones(mlp.width, dtype=fnp.float64)
+    rows = []
+
+    for weights in mlp.weights:
+        weights64 = fnp.asarray(weights, dtype=fnp.float64)
+        pre_mu = weights64.T @ mu
+        pre_variance = (weights64 * weights64).T @ variance
+        pre_variance = fnp.maximum(pre_variance, 1e-12)
+        pre_sigma = fnp.sqrt(pre_variance)
+        alpha = pre_mu / pre_sigma
+        cdf = flops.stats.norm.cdf(alpha)
+        pdf = flops.stats.norm.pdf(alpha)
+        mu = pre_mu * cdf + pre_sigma * pdf
+        second = (
+            (pre_mu * pre_mu + pre_variance) * cdf
+            + pre_mu * pre_sigma * pdf
+        )
+        variance = fnp.maximum(second - mu * mu, 0.0)
+        rows.append(mu)
+
+    return fnp.stack(rows, axis=0)
+
+

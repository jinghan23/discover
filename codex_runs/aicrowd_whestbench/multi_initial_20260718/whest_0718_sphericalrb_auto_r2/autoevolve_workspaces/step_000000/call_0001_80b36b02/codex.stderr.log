+                    pre_second = fnp.mean(
+                        preactivations * preactivations,
+                        axis=0,
+                    )
+                    pre_variance = fnp.maximum(
+                        pre_second - pre_mean * pre_mean,
+                        1e-12,
+                    )
+                    pre_sigma = fnp.sqrt(pre_variance)
+                    alpha = pre_mean / pre_sigma
+                    gaussian_row = (
+                        pre_mean * flops.stats.norm.cdf(alpha)
+                        + pre_sigma * flops.stats.norm.pdf(alpha)
+                    )
+                    row = row + self.final_gaussian_blend * (
+                        gaussian_row - row
+                    )
+                block_rows.append(row)
+            block_rows = fnp.asarray(
+                fnp.stack(block_rows, axis=0),
+                dtype=fnp.float32,
+            )
+            weighted_blocks.append(block_rows * (2.0 * float(count) / float(n_samples)))
+        rows = weighted_blocks[0]
+        for block_rows in weighted_blocks[1:]:
+            rows = rows + block_rows
+        return fnp.concatenate(
+            (rows[:-1], rows[-1:] * self.final_scale),
+            axis=0,
+        )


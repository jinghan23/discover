+                dtype=fnp.float32,
+            )
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        n_samples = max(_MIN_ANTITHETIC_SAMPLES, n_samples + self.sample_delta)
+        n_samples = n_samples - (n_samples & 1)
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(int(mlp.seed) + self.seed_offset)
+        first_count = half_samples // self.blocks
+        counts = [first_count] * self.blocks
+        counts[-1] += half_samples - first_count * self.blocks
+        weighted_blocks = []
+        for count in counts:
+            if self.use_latin:
+                half_directions = _latin_directions(count, mlp.width, rng)
+            elif self.korobov_multiplier:
+                half_directions = _korobov_directions(
+                    count,
+                    mlp.width,
+                    rng,
+                    self.korobov_multiplier,
+                )
+            else:
+                half_directions = _qmc_directions(count, mlp.width, rng)
+            whitening = _angular_whitening_transform(half_directions)
+            whitened_first_weight = whitening @ mlp.weights[0]
+            first_weight = (

+                fnp.stack(block_rows, axis=0),
+                dtype=fnp.float32,
+            )
+            weighted_blocks.append(block_rows * (2.0 * float(count) / float(n_samples)))
+        rows = weighted_blocks[0]
+        for block_rows in weighted_blocks[1:]:
+            rows = rows + block_rows
+        return fnp.concatenate(
+            (rows[:-1], rows[-1:] * self.final_scale),
+            axis=0,
+        )


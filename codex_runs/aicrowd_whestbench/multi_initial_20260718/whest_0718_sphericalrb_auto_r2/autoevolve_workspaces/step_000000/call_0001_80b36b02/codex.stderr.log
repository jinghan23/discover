+class Estimator(_WhitenedAntitheticRaoBlackwellEstimator):
+    """Whitened RQMC with a final-layer scale correction."""
+
+    target_flop_fraction = 0.10
+    final_scale = 0.9994
+    seed_offset = 0
+    whitening_strength = 1.007
+    sample_delta = -18
+

+    values = []
+    value = 1
+    for _ in range(width):
+        values.append(value)
+        value = (value * multiplier) % modulus
+    generator = fnp.asarray(values, dtype=fnp.float64) / float(modulus)
+    shift = rng.random(width)
+    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]

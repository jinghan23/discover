+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        n_samples = max(_MIN_ANTITHETIC_SAMPLES, n_samples + self.sample_delta)
+        n_samples = n_samples - (n_samples & 1)
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(int(mlp.seed) + self.seed_offset)
+        first_count = half_samples // self.blocks

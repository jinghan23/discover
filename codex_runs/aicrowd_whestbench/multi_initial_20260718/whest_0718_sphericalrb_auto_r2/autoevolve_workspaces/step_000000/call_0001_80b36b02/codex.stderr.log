+    final_scale = 0.99935
+    seed_offset = 0
+    whitening_strength = 1.010
+    use_kurtosis_scale = True
+    sample_delta = -22
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        n_samples = max(_MIN_ANTITHETIC_SAMPLES, n_samples + self.sample_delta)
+        n_samples = n_samples - (n_samples & 1)
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(int(mlp.seed) + self.seed_offset)
+        half_directions = _qmc_directions(half_samples, mlp.width, rng)
+        whitening = _angular_whitening_transform(half_directions)
+        whitened_first_weight = whitening @ mlp.weights[0]
+        transform = (
+            (1.0 - self.whitening_strength) * mlp.weights[0]
+            + self.whitening_strength * whitened_first_weight
+        )
+        if self.use_kurtosis_scale:
+            sample_transform = (
+                (1.0 - self.whitening_strength) * half_directions
+                + self.whitening_strength * (half_directions @ whitening)
+            )
+            fourth_moment = fnp.mean(
+                sample_transform * sample_transform
+                * sample_transform * sample_transform,
+                axis=0,
+            )
+            target_fourth_moment = 3.0 / float(mlp.width * (mlp.width + 2))
+            coordinate_scale = (
+                target_fourth_moment
+                / fnp.maximum(fourth_moment, 1e-18)
+            ) ** 0.25
+            trace_scale = fnp.sqrt(

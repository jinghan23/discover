@@ -149,6 +151,70 @@
     return normals / radii[:, None]
 
 
+def _latin_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
+    columns = []
+    scale = 1.0 / float(n_samples)
+    for _ in range(width):
+        uniforms = (rng.permutation(n_samples) + rng.random(n_samples)) * scale
+        columns.append(uniforms)
+    uniforms = fnp.stack(columns, axis=1)
+    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
+    return flops.stats.norm.ppf(uniforms)
+
+
+def _latin_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
+    normals = _latin_normal_samples(n_samples, width, rng)
+    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
+    return normals / radii[:, None]
+
+
+def _next_prime_at_least(value: int) -> int:
+    candidate = max(2, int(value))
+    while True:
+        is_prime = True
+        divisor = 2
+        while divisor * divisor <= candidate:
+            if candidate % divisor == 0:
+                is_prime = False
+                break
+            divisor += 1
+        if is_prime:
+            return candidate
+        candidate += 1
+
+
+def _korobov_normal_samples(
+    n_samples: int,
+    width: int,
+    rng,
+    multiplier: int,
+) -> fnp.ndarray:
+    modulus = _next_prime_at_least(n_samples)
+    values = []
+    value = 1
+    for _ in range(width):
+        values.append(value)
+        value = (value * multiplier) % modulus
+    generator = fnp.asarray(values, dtype=fnp.float64) / float(modulus)
+    shift = rng.random(width)
+    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
+    unwrapped = indices * generator[None, :] + shift[None, :]
+    uniforms = unwrapped - fnp.floor(unwrapped)
+    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
+    return flops.stats.norm.ppf(uniforms)
+
+
+def _korobov_directions(
+    n_samples: int,
+    width: int,
+    rng,
+    multiplier: int,
+) -> fnp.ndarray:
+    normals = _korobov_normal_samples(n_samples, width, rng, multiplier)
+    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
+    return normals / radii[:, None]
+
+
 def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
     """Match a half-batch's angular second moment to I/width.
 
@@ -167,6 +233,19 @@
     return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
 
 
+def _angular_power_whitening_transform(
+    directions: fnp.ndarray,
+    power: float,
+) -> fnp.ndarray:
+    n_samples, width = directions.shape
+    scaled_second_moment = (
+        directions.T @ directions
+    ) * (float(width) / float(n_samples))
+    eigenvalues, eigenvectors = fnp.linalg.eigh(scaled_second_moment)
+    eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
+    return (eigenvectors / (eigenvalues ** power)) @ eigenvectors.T
+
+
 def _importance_radial_factors(n_samples: int, width: int, rng) -> fnp.ndarray:
     """Sample an exact radial mixture and return likelihood-weighted radii.
 
@@ -397,5 +476,137 @@
     target_flop_fraction = 0.15
 
 
-class Estimator(WhitenedAntitheticRaoBlackwell10Estimator):
-    """Best full-100 stage, targeting approximately 10% effective compute."""
+class _NormalizedWhitenedAntitheticRaoBlackwellEstimator(BaseEstimator):
+    """Apply angular whitening to samples, then project back to the sphere."""
+
+    target_flop_fraction = 0.10
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(mlp.seed)
+        half_directions = _qmc_directions(half_samples, mlp.width, rng)
+        whitening = _angular_whitening_transform(half_directions)
+        half_directions = half_directions @ whitening
+        half_norms = fnp.sqrt(
+            fnp.maximum(fnp.sum(half_directions * half_directions, axis=1), 1e-24)
+        )
+        half_directions = half_directions / half_norms[:, None]
+        paired_directions = fnp.concatenate(
+            (half_directions, -half_directions),
+            axis=0,
+        )
+        activations = paired_directions * _mean_chi(mlp.width)
+
+        rows = _forward_means(mlp, activations)
+        rows[0] = _exact_first_layer_mean(mlp.weights[0])
+        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
+
+
+class Estimator(_WhitenedAntitheticRaoBlackwellEstimator):
+    """Whitened RQMC with a final-layer scale correction."""
+
+    target_flop_fraction = 0.10
+    final_scale = 0.99935
+    seed_offset = 0
+    whitening_strength = 1.010
+    use_kurtosis_scale = False
+    use_latin = False
+    korobov_multiplier = 0
+    sample_delta = -22
+    blocks = 1
+    match_first_mean = False
+    final_gaussian_blend = -0.1
+
+    def predict(self, mlp, budget: int) -> fnp.ndarray:
+        n_samples = whitened_antithetic_sample_count(
+            budget,
+            mlp.width,
+            mlp.depth,
+            self.target_flop_fraction,
+        )
+        n_samples = max(_MIN_ANTITHETIC_SAMPLES, n_samples + self.sample_delta)
+        n_samples = n_samples - (n_samples & 1)
+        half_samples = n_samples // 2
+        rng = fnp.random.default_rng(int(mlp.seed) + self.seed_offset)
+        first_count = half_samples // self.blocks
+        counts = [first_count] * self.blocks
+        counts[-1] += half_samples - first_count * self.blocks
+        weighted_blocks = []
+        for count in counts:
+            if self.use_latin:
+                half_directions = _latin_directions(count, mlp.width, rng)
+            elif self.korobov_multiplier:
+                half_directions = _korobov_directions(
+                    count,
+                    mlp.width,
+                    rng,
+                    self.korobov_multiplier,
+                )
+            else:
+                half_directions = _qmc_directions(count, mlp.width, rng)
+            whitening = _angular_whitening_transform(half_directions)
+            whitened_first_weight = whitening @ mlp.weights[0]
+            first_weight = (
+                (1.0 - self.whitening_strength) * mlp.weights[0]
+                + self.whitening_strength * whitened_first_weight
+            )
+            paired_directions = fnp.concatenate(
+                (half_directions, -half_directions),
+                axis=0,
+            )
+            activations = paired_directions * _mean_chi(mlp.width)
+
+            block_rows = []
+            activations = fnp.maximum(activations @ first_weight, 0.0)
+            exact_first_mean = _exact_first_layer_mean(mlp.weights[0])
+            if self.match_first_mean:
+                sample_first_mean = fnp.mean(activations, axis=0)
+                activations = activations + (
+                    exact_first_mean - sample_first_mean
+                )[None, :]
+            block_rows.append(exact_first_mean)
+            for layer_index, weights in enumerate(mlp.weights[1:], start=1):
+                preactivations = activations @ weights
+                activations = fnp.maximum(preactivations, 0.0)
+                row = fnp.mean(activations, axis=0)
+                if (
+                    self.final_gaussian_blend
+                    and layer_index == mlp.depth - 1
+                ):
+                    pre_mean = fnp.mean(preactivations, axis=0)
+                    pre_second = fnp.mean(
+                        preactivations * preactivations,
+                        axis=0,
+                    )
+                    pre_variance = fnp.maximum(
+                        pre_second - pre_mean * pre_mean,
+                        1e-12,
+                    )
+                    pre_sigma = fnp.sqrt(pre_variance)
+                    alpha = pre_mean / pre_sigma
+                    gaussian_row = (
+                        pre_mean * flops.stats.norm.cdf(alpha)
+                        + pre_sigma * flops.stats.norm.pdf(alpha)
+                    )
+                    row = row + self.final_gaussian_blend * (
+                        gaussian_row - row
+                    )
+                block_rows.append(row)
+            block_rows = fnp.asarray(
+                fnp.stack(block_rows, axis=0),
+                dtype=fnp.float32,
+            )
+            weighted_blocks.append(block_rows * (2.0 * float(count) / float(n_samples)))
+        rows = weighted_blocks[0]
+        for block_rows in weighted_blocks[1:]:
+            rows = rows + block_rows
+        return fnp.concatenate(
+            (rows[:-1], rows[-1:] * self.final_scale),
+            axis=0,
+        )


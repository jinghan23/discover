+def _next_prime_at_least(value: int) -> int:
+    candidate = max(2, int(value))
+    while True:
+        is_prime = True
+        divisor = 2
+        while divisor * divisor <= candidate:
+            if candidate % divisor == 0:
+                is_prime = False
+                break
+            divisor += 1
+        if is_prime:
+            return candidate
+        candidate += 1

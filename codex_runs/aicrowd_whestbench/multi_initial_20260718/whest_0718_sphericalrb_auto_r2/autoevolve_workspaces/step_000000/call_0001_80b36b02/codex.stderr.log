+def _full_gaussian_moment_means(mlp) -> list[fnp.ndarray]:
+    """Gaussian moment closure with a full second-moment state."""
+
+    width = mlp.width
+    mean = fnp.zeros(width)
+    second = fnp.eye(width)
+    identity = fnp.eye(width)
+    rows = []
+    for weights in mlp.weights:
+        pre_mean = weights.T @ mean
+        pre_second = weights.T @ second @ weights
+        pre_second_diag = fnp.diag(pre_second)
+        pre_variance = fnp.maximum(pre_second_diag - pre_mean * pre_mean, 1e-12)
+        pre_sigma = fnp.sqrt(pre_variance)
+        alpha = pre_mean / pre_sigma
+        density = flops.stats.norm.pdf(alpha)
+        probability = flops.stats.norm.cdf(alpha)
+        mean = pre_mean * probability + pre_sigma * density
+        diagonal_second = (
+            (pre_mean * pre_mean + pre_variance) * probability
+            + pre_mean * pre_sigma * density
+        )
+
+        covariance = pre_second - pre_mean[:, None] * pre_mean[None, :]
+        sigma_outer = pre_sigma[:, None] * pre_sigma[None, :]
+        correlation = fnp.clip(covariance / sigma_outer, -1.0, 1.0)
+        root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        angle = fnp.arccos(correlation)
+        zero_second = sigma_outer * (
+            root + (fnp.pi - angle) * correlation
+        ) / (2.0 * fnp.pi)
+        zero_mean = pre_sigma / fnp.sqrt(2.0 * fnp.pi)
+        zero_covariance = (
+            zero_second - zero_mean[:, None] * zero_mean[None, :]
+        )
+        second = mean[:, None] * mean[None, :] + zero_covariance
+        second = second * (1.0 - identity) + diagonal_second[:, None] * identity
+        rows.append(mean)
+    return rows

import math, time
from functools import lru_cache
import numpy as np
from scipy import stats

TAIL=1e-11
MIN=32
W=256; D=32; BUDGET=272_000_000_000

# current params
params=dict(
 target_flop_fraction=0.10, sample_delta=-4, whitening_strength=1.04,
 final_scale=0.99938, final_gaussian_blend=-0.03, final_nested_blend=0.23,
 final_quarter_blend=0.012, final_eighth_blend=0.03,
 final_sixteenth_blend=-0.022, final_thirtysecond_blend=0.02,
 final_sixtyfourth_blend=0.010, final_one28_blend=-0.0055,
 final_tail_blend=-0.065, final_middle_blend=0.005,
 first_mean_match=-1.40, first_variance_match=0.58)

def sample_count(budget,w,d,frac):
    half_lattice_per_sample=(89*w+3*w+2)//2
    layer_per_sample=d*(2*w*w+2*w)
    covariance_per_sample=w*w
    per_sample=half_lattice_per_sample+layer_per_sample+covariance_per_sample
    fixed=13*w**3+8*w
    budget_limited=(int(float(frac)*budget)-fixed)//max(per_sample,1)
    memory_limited=(100*1024*1024)//max(w*8,1)
    count=int(max(MIN,min(budget_limited,memory_limited)))
    return count-(count&1)

@lru_cache(None)
def primes(n):
    ps=[]; c=2
    while len(ps)<n:
        ok=True
        for p in ps:
            if p*p>c: break
            if c%p==0: ok=False; break
        if ok: ps.append(c)
        c+=1
    return np.array(ps,dtype=np.float64)

def lattice_normals(n,w,rng):
    roots=np.sqrt(primes(w)); gen=roots-np.floor(roots); shift=rng.random(w)
    idx=np.arange(n,dtype=np.float64)[:,None]
    u=idx*gen[None,:]+shift[None,:]
    u=u-np.floor(u); u=np.clip(u,TAIL,1-TAIL)
    return stats.norm.ppf(u)

def mean_chi(d):
    return math.sqrt(2.0)*math.exp(math.lgamma(0.5*d+0.5)-math.lgamma(0.5*d))

def qmc_dirs(n,w,rng):
    z=lattice_normals(n,w,rng)
    r=np.sqrt(np.maximum(np.sum(z*z,axis=1),1e-24))
    return z/r[:,None]

def whitening_transform(dirs):
    n,w=dirs.shape
    S=(dirs.T@dirs)*(float(w)/float(n))
    vals, vecs=np.linalg.eigh(S)
    vals=np.maximum(vals,1e-8)
    return (vecs/np.sqrt(vals))@vecs.T

def exact_first_mean(W):
    return np.sqrt(np.sum(W*W,axis=0))/math.sqrt(2*math.pi)

def exact_first_second(W,w):
    sq=np.sum(W*W,axis=0); r=mean_chi(w)
    return sq*((r*r)/(2.0*w))

def gaussian_relu(mean,var):
    sigma=np.sqrt(np.maximum(var,1e-12)); alpha=mean/sigma
    cdf=stats.norm.cdf(alpha); pdf=stats.norm.pdf(alpha)
    return mean*cdf+sigma*pdf

def he_weights(seed,w=W,d=D):
    rng=np.random.default_rng(seed); scale=np.sqrt(2.0/w).astype(np.float32)
    return [(rng.standard_normal((w,w)).astype(np.float32)*scale) for _ in range(d)]

def estimator_features(weights, est_seed):
    w=weights[0].shape[0]; d=len(weights)
    n=sample_count(BUDGET,w,d,params['target_flop_fraction'])
    n=max(MIN,n+params['sample_delta']); n=n-(n&1); h=n//2
    rng=np.random.default_rng(est_seed)
    hd=qmc_dirs(h,w,rng)
    whitening=whitening_transform(hd)
    first_weight=(1-params['whitening_strength'])*weights[0]+params['whitening_strength']*(whitening@weights[0])
    first_weight=first_weight.astype(np.float32)
    dirs=np.concatenate([hd,-hd],axis=0)
    act=(dirs*mean_chi(w)).astype(np.float32)
    act=np.maximum(act@first_weight,0)
    first_exact=exact_first_mean(weights[0])
    first_sample=np.maximum(act.mean(0),1e-12)
    factor=first_exact/first_sample
    act=act*(1+params['first_mean_match']*(factor-1))
    cm=act.mean(0); cs=(act*act).mean(0); cv=np.maximum(cs-cm*cm,1e-12)
    fs=exact_first_second(weights[0],w); fv=np.maximum(fs-first_exact*first_exact,1e-12)
    vf=np.sqrt(fv/cv)
    vm=first_exact+(act-cm)*vf
    act=act+params['first_variance_match']*(vm-act)
    for layer_index,Wt in enumerate(weights[1:],start=1):
        pre=act@Wt
        act=np.maximum(pre,0)
        if layer_index==d-1:
            base=act.mean(0)
            pm=pre.mean(0); ps=(pre*pre).mean(0); pv=np.maximum(ps-pm*pm,1e-12)
            gauss=gaussian_relu(pm,pv)
            counts=[]; rows=[]
            for div in [2,4,8,16,32,64,128]:
                c=max(1,h//div)
                r=(act[:c].sum(0)+act[h:h+c].sum(0))/float(2*c)
                rows.append(r)
            midc=max(1,h//128); mids=max(0,h//2-midc//2)
            mid=(act[mids:mids+midc].sum(0)+act[h+mids:h+mids+midc].sum(0))/float(2*midc)
            tailc=h//5
            tail=(act[h-tailc:h].sum(0)+act[n-tailc:].sum(0))/float(2*tailc)
            return np.stack([base,gauss]+rows+[mid,tail],axis=1), base
    raise RuntimeError

def current_from_features(F):
    base=F[:,0]; gauss=F[:,1]
    sub,quarter,eighth,sixteenth,thirtysecond,sixtyfourth,one28=F[:,2:9].T
    mid=F[:,9]; tail=F[:,10]
    row=base + params['final_gaussian_blend']*(gauss-base)
    full=row.copy()
    row=row+params['final_nested_blend']*(row-sub)
    row=row+params['final_quarter_blend']*(sub-quarter)
    row=row+params['final_eighth_blend']*(quarter-eighth)
    row=row+params['final_sixteenth_blend']*(eighth-sixteenth)
    row=row+params['final_thirtysecond_blend']*(sixteenth-thirtysecond)
    row=row+params['final_sixtyfourth_blend']*(thirtysecond-sixtyfourth)
    row=row+params['final_one28_blend']*(sixtyfourth-one28)
    row=row+params['final_middle_blend']*(mid-full)
    row=row+params['final_tail_blend']*(tail-full)
    return row*params['final_scale']

def target_qmc(weights, seed, n_total=65536, block=65536):
    w=weights[0].shape[0]; h=n_total//2
    rng=np.random.default_rng(seed)
    dirs=np.concatenate([qmc_dirs(h,w,rng), -qmc_dirs(h,w,rng)],axis=0) # wrong two shifts? keep for now
    # Actually above uses two independent qmc calls; pair first only? okay target ensemble-ish
    x=(dirs*mean_chi(w)).astype(np.float32)
    for Wt in weights:
        x=np.maximum(x@Wt,0)
    return x.mean(0).astype(np.float64)

def target_random(weights, seed, n_total=131072):
    w=weights[0].shape[0]; rng=np.random.default_rng(seed)
    z=rng.standard_normal((n_total,w)).astype(np.float32)
    z/=np.sqrt(np.maximum((z*z).sum(1,keepdims=True),1e-24)); x=(z*mean_chi(w)).astype(np.float32)
    for Wt in weights: x=np.maximum(x@Wt,0)
    return x.mean(0).astype(np.float64)

print('n estimator', sample_count(BUDGET,W,D,0.10)-4)
train=[]; y=[]; cur=[]
t0=time.time()
for i,seed in enumerate(range(1000,1008)):
    weights=he_weights(seed)
    F,_=estimator_features(weights, seed+9999)
    # target: paired QMC correctly use one half then antithetic
    # use 131072 random for now
    t=target_random(weights, seed+123456, n_total=131072)
    train.append(F); y.append(t); cur.append(current_from_features(F))
    print('mlp',i,'cur_mse',np.mean((cur[-1]-t)**2),'elapsed',time.time()-t0, flush=True)

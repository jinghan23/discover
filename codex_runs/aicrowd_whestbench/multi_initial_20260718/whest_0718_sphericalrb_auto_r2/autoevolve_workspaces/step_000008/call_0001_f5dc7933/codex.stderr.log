    sample_delta = -4
    whitening_strength = 1.04
    final_scale = 0.999396071
    final_gaussian_blend = -0.0198569657
    final_nested_blend = 0.1789232064
    final_quarter_blend = 0.0172020448
    final_eighth_blend = 0.0091645137
    final_sixteenth_blend = -0.0154021913
    final_thirtysecond_blend = 0.0229938937
    final_sixtyfourth_blend = 0.0137914861
    final_one28_blend = -0.0007198773
    final_tail_blend = -0.0402805476
    final_middle_blend = 0.0040543876
    first_mean_match = -1.40
    first_variance_match = 0.58

    def predict(self, mlp, budget: int) -> fnp.ndarray:
        n_samples = _sample_count(
            budget,
            mlp.width,
            mlp.depth,
            self.target_flop_fraction,
        )

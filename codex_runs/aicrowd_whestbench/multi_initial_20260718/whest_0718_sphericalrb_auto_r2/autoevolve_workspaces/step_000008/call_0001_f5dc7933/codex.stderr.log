                sixtyfourth_count = max(1, half_samples // 64)
                sixtyfourth_row = (
                    fnp.sum(activations[:sixtyfourth_count], axis=0)
                    + fnp.sum(
                        activations[half_samples : half_samples + sixtyfourth_count],
                        axis=0,
                    )
                ) / float(2 * sixtyfourth_count)
                row = row + self.final_sixtyfourth_blend * (
                    thirtysecond_row - sixtyfourth_row
                )

                one28_count = max(1, half_samples // 128)
                one28_row = (
                    fnp.sum(activations[:one28_count], axis=0)
                    + fnp.sum(
                        activations[half_samples : half_samples + one28_count],
                        axis=0,
                    )
                ) / float(2 * one28_count)
                row = row + self.final_one28_blend * (sixtyfourth_row - one28_row)

                middle_count = max(1, half_samples // 128)
                middle_start = max(0, half_samples // 2 - middle_count // 2)
                middle_row = (
                    fnp.sum(
                        activations[middle_start : middle_start + middle_count],
                        axis=0,
                    )
                    + fnp.sum(
                        activations[
                            half_samples
                            + middle_start : half_samples
                            + middle_start
                            + middle_count
                        ],
                        axis=0,
                    )
                ) / float(2 * middle_count)
                row = row + self.final_middle_blend * (middle_row - full_row)

                tail_count = half_samples // 5
                tail_row = (
                    fnp.sum(
                        activations[half_samples - tail_count : half_samples],
                        axis=0,
                    )
                    + fnp.sum(activations[n_samples - tail_count :], axis=0)
                ) / float(2 * tail_count)
                row = row + self.final_tail_blend * (tail_row - full_row)

            rows.append(row)

        rows = fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
        return fnp.concatenate((rows[:-1], rows[-1:] * self.final_scale), axis=0)

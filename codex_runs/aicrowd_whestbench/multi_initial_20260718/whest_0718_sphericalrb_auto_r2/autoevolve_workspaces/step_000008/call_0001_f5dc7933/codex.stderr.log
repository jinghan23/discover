# least squares direct coefficients
coef, *_=np.linalg.lstsq(X, Y, rcond=None)
print('coef',repr(coef))
P=X@coef
print('fit train mse',np.mean((P-Y)**2))
# ridge small around current equivalent direct? no
# validate
for start in [2000]:

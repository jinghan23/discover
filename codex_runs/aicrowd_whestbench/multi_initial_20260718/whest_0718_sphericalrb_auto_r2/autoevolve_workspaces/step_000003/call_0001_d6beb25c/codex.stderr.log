+def _exact_first_layer_covariance(
+    weights: fnp.ndarray,
+    width: int,
+    mean: fnp.ndarray,
+) -> fnp.ndarray:
+    gram = weights.T @ weights
+    squared_norm = fnp.maximum(fnp.sum(weights * weights, axis=0), 1e-24)
+    norms = fnp.sqrt(squared_norm)
+    norm_products = norms[:, None] * norms[None, :]
+    rho = fnp.clip(gram / norm_products, -1.0, 1.0)

```python
from __future__ import annotations

import math

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_INV_SQRT_2PI = 1.0 / math.sqrt(2.0 * math.pi)


def _relu_gaussian_mean(mu, var):
    sigma = fnp.sqrt(fnp.maximum(var, 1e-30))
    alpha = mu / sigma
    return sigma * fnp.exp(-0.5 * alpha * alpha) * _INV_SQRT_2PI + mu * (
        0.5 * (1.0 + fnp.erf(alpha / math.sqrt(2.0)))
    )


def _relu_gaussian_second(mu, var):
    sigma = fnp.sqrt(fnp.maximum(var, 1e-30))
    alpha = mu / sigma
    phi = fnp.exp(-0.5 * alpha * alpha) * _INV_SQRT_2PI
    Phi = 0.5 * (1.0 + fnp.erf(alpha / math.sqrt(2.0)))
    return (var + mu * mu) * Phi + mu * sigma * phi


class Estimator(BaseEstimator):
    def setup(self, context):
        self._setup_seed = context.seed

    def predict(self, mlp, budget: int | None):
        width = mlp.width
        depth = mlp.depth

        rows = []

        w0 = mlp.weights[0]
        var = fnp.sum(w0 * w0, axis=0)
        mean = fnp.sqrt(var) * _INV_SQRT_2PI
        second = 0.5 * var
        rows.append(mean)

        for weights in mlp.weights[1:]:
            centered_second = fnp.maximum(second - mean * mean, 0.0)
            pre_mean = mean @ weights
            pre_var = centered_second @ (weights * weights)

            mean = _relu_gaussian_mean(pre_mean, pre_var)
            second = _relu_gaussian_second(pre_mean, pre_var)
            rows.append(mean)

        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)

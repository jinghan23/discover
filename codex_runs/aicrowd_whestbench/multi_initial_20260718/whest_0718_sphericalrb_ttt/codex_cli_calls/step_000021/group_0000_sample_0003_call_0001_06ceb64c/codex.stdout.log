```python
from __future__ import annotations

import math

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.045
_MAX_WORKING_SET_BYTES = 96 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8
_TAIL_CLIP = 1e-11
_MIN_SAMPLES = 32
_WHITENING_EIGENVALUE_FLOOR = 1e-8
_PRIME_CACHE: dict[int, tuple[int, ...]] = {}


def _first_primes(count: int) -> tuple[int, ...]:
    cached = _PRIME_CACHE.get(count)
    if cached is not None:
        return cached

    primes = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1

    result = tuple(primes)
    _PRIME_CACHE[count] = result
    return result


def _mean_chi(dimension: int) -> float:
    half_dimension = 0.5 * float(dimension)
    return math.sqrt(2.0) * math.exp(
        math.lgamma(half_dimension + 0.5) - math.lgamma(half_dimension)
    )


def _sample_count(budget: int | None, width: int, depth: int) -> int:
    if budget is None:
        budget = 2 * depth * width * width * 4096

    fixed = 13 * width**3 + 3 * max(depth - 1, 0) * width * width + 12 * width
    per_sample = depth * (2 * width * width + 8 * width) + width * width + 60 * width
    budget_limited = (int(_TARGET_FLOP_FRACTION * int(budget)) - fixed) // max(
        per_sample, 1
    )
    memory_limited = _MAX_WORKING_SET_BYTES // max(width * _FLOAT64_ITEMSIZE, 1)
    count = int(max(_MIN_SAMPLES, min(budget_limited, memory_limited)))
    return count - (count & 1)


def _lattice_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.asarray(_first_primes(width), dtype=fnp.float64))
    generator = roots - fnp.floor(roots)
    shift = rng.random(width)

    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    uniforms = indices * generator[None, :] + shift[None, :]
    uniforms = uniforms - fnp.floor(uniforms)
    uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
    return flops.stats.norm.ppf(uniforms)


def _qmc_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
    normals = _lattice_normal_samples(n_samples, width, rng)
    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
    return normals / radii[:, None]


def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
    n_samples, width = directions.shape
    second = (directions.T @ directions) * (float(width) / float(n_samples))
    eigenvalues, eigenvectors = fnp.linalg.eigh(second)
    eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
    return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T


def _relu_mean_from_normal(mean: fnp.ndarray, variance: fnp.ndarray) -> fnp.ndarray:
    std = fnp.sqrt(fnp.maximum(variance, 1e-30))
    alpha = mean / std
    return std * flops.stats.norm.pdf(alpha) + mean * flops.stats.norm.cdf(alpha)


class Estimator(BaseEstimator):
    def predict(self, mlp, budget: int | None) -> fnp.ndarray:
        width = mlp.width
        depth = mlp.depth
        n_samples = _sample_count(budget, width, depth)
        half_samples = n_samples // 2

        rng = fnp.random.default_rng(mlp.seed)
        half_directions = _qmc_directions(half_samples, width, rng)
        whitening = _angular_whitening_transform(half_directions)
        directions = fnp.concatenate((half_directions, -half_directions), axis=0)
        activations = directions * _mean_chi(width)

        weights0 = mlp.weights[0]
        first_variance = fnp.sum(weights0 * weights0, axis=0)
        first_mean = fnp.sqrt(first_variance) / fnp.sqrt(2.0 * fnp.pi)
        rows = [first_mean]

        activations = fnp.maximum(activations @ (whitening @ weights0), 0.0)
        previous_mean = first_mean
        previous_second = first_variance * 0.5

        for weights in mlp.weights[1:]:
            preactivations = activations @ weights
            activations = fnp.maximum(preactivations, 0.0)

            linear_mean = previous_mean @ weights
            centered = preactivations - fnp.mean(preactivations, axis=0)[None, :]
            sample_variance = fnp.mean(centered * centered, axis=0)
            diag_variance = (previous_second - previous_mean * previous_mean) @ (
                weights * weights
            )
            variance = fnp.maximum(0.5 * sample_variance + 0.5 * diag_variance, 1e-30)

            abs_mean = fnp.mean(fnp.abs(preactivations), axis=0)
            empirical_mean = 0.5 * (linear_mean + abs_mean)
            gaussian_mean = _relu_mean_from_normal(linear_mean, variance)
            layer_mean = fnp.maximum(0.78 * empirical_mean + 0.22 * gaussian_mean, 0.0)

            rows.append(layer_mean)
            previous_mean = layer_mean
            previous_second = variance + linear_mean * linear_mean
            previous_second = 0.5 * (
                previous_second
                + linear_mean * fnp.sqrt(fnp.maximum(variance, 1e-30))
                * flops.stats.norm.pdf(linear_mean / fnp.sqrt(fnp.maximum(variance, 1e-30)))
                / fnp.maximum(flops.stats.norm.cdf(linear_mean / fnp.sqrt(fnp.maximum(variance, 1e-30))), 1e-12)
            )
            previous_second = fnp.maximum(previous_second, layer_mean * layer_mean)

        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
```

```python
from __future__ import annotations

import math

import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.09
_MAX_WORKING_SET_BYTES = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8
_TAIL_CLIP = 1e-11
_MIN_ANTITHETIC_SAMPLES = 32
_WHITENING_EIGENVALUE_FLOOR = 1e-8
_PRIME_CACHE: dict[int, tuple[int, ...]] = {}

_PPF_LOW = 0.02425
_PPF_HIGH = 1.0 - _PPF_LOW

_PPF_A = (
    -3.969683028665376e01,
    2.209460984245205e02,
    -2.759285104469687e02,
    1.383577518672690e02,
    -3.066479806614716e01,
    2.506628277459239e00,
)
_PPF_B = (
    -5.447609879822406e01,
    1.615858368580409e02,
    -1.556989798598866e02,
    6.680131188771972e01,
    -1.328068155288572e01,
)
_PPF_C = (
    -7.784894002430293e-03,
    -3.223964580411365e-01,
    -2.400758277161838e00,
    -2.549732539343734e00,
    4.374664141464968e00,
    2.938163982698783e00,
)
_PPF_D = (
    7.784695709041462e-03,
    3.224671290700398e-01,
    2.445134137142996e00,
    3.754408661907416e00,
)


def _poly(coefficients: tuple[float, ...], x):
    value = coefficients[0]
    for coefficient in coefficients[1:]:
        value = value * x + coefficient
    return value


def _normal_ppf(probabilities: fnp.ndarray) -> fnp.ndarray:
    p = fnp.clip(probabilities, _TAIL_CLIP, 1.0 - _TAIL_CLIP)

    q = p - 0.5
    r = q * q
    central = (_poly(_PPF_A, r) * q) / (_poly(_PPF_B, r) * r + 1.0)

    q_low = fnp.sqrt(-2.0 * fnp.log(p))
    lower = _poly(_PPF_C, q_low) / (_poly(_PPF_D, q_low) * q_low + 1.0)

    q_high = fnp.sqrt(-2.0 * fnp.log(1.0 - p))
    upper = -_poly(_PPF_C, q_high) / (_poly(_PPF_D, q_high) * q_high + 1.0)

    return fnp.where(p < _PPF_LOW, lower, fnp.where(p > _PPF_HIGH, upper, central))


def _first_primes(count: int) -> tuple[int, ...]:
    cached = _PRIME_CACHE.get(count)
    if cached is not None:
        return cached

    primes = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1

    result = tuple(primes)
    _PRIME_CACHE[count] = result
    return result


def _mean_chi(dimension: int) -> float:
    half_dimension = 0.5 * float(dimension)
    return math.sqrt(2.0) * math.exp(
        math.lgamma(half_dimension + 0.5) - math.lgamma(half_dimension)
    )


def _sample_count(budget: int | None, width: int, depth: int) -> int:
    if budget is None:
        budget = 2 * depth * width * width * 4096

    half_lattice_per_sample = (92 * width + 2) // 2
    layer_per_sample = depth * (2 * width * width + 3 * width)
    covariance_per_sample = width * width
    fixed = 13 * width**3 + 2 * max(depth - 1, 0) * width * width + 8 * width
    per_sample = half_lattice_per_sample + layer_per_sample + covariance_per_sample

    budget_limited = (int(_TARGET_FLOP_FRACTION * int(budget)) - fixed) // max(
        per_sample, 1
    )
    memory_limited = _MAX_WORKING_SET_BYTES // max(width * _FLOAT64_ITEMSIZE, 1)
    count = int(max(_MIN_ANTITHETIC_SAMPLES, min(budget_limited, memory_limited)))
    return count - (count & 1)


def _lattice_normal_samples(n_samples: int, width: int, rng) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    generator = roots - fnp.floor(roots)
    shift = rng.random(width)

    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    uniforms = indices * generator[None, :] + shift[None, :]
    uniforms = uniforms - fnp.floor(uniforms)
    return _normal_ppf(uniforms)


def _qmc_directions(n_samples: int, width: int, rng) -> fnp.ndarray:
    normals = _lattice_normal_samples(n_samples, width, rng)
    radii = fnp.sqrt(fnp.maximum(fnp.sum(normals * normals, axis=1), 1e-24))
    return normals / radii[:, None]


def _angular_whitening_transform(directions: fnp.ndarray) -> fnp.ndarray:
    n_samples, width = directions.shape
    second = (directions.T @ directions) * (float(width) / float(n_samples))
    eigenvalues, eigenvectors = fnp.linalg.eigh(second)
    eigenvalues = fnp.maximum(eigenvalues, _WHITENING_EIGENVALUE_FLOOR)
    return (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T


def _exact_first_layer_mean(weights: fnp.ndarray) -> fnp.ndarray:
    std = fnp.sqrt(fnp.sum(weights * weights, axis=0))
    return std / fnp.sqrt(2.0 * fnp.pi)


class Estimator(BaseEstimator):
    def predict(self, mlp, budget: int | None) -> fnp.ndarray:
        width = mlp.width
        depth = mlp.depth
        n_samples = _sample_count(budget, width, depth)
        half_samples = n_samples // 2

        rng = fnp.random.default_rng(mlp.seed)
        half_directions = _qmc_directions(half_samples, width, rng)
        whitening = _angular_whitening_transform(half_directions)

        paired_directions = fnp.concatenate((half_directions, -half_directions), axis=0)
        activations = paired_directions * _mean_chi(width)

        first_weight = whitening @ mlp.weights[0]
        first_mean = _exact_first_layer_mean(mlp.weights[0])
        rows = [first_mean]

        activations = fnp.maximum(activations @ first_weight, 0.0)
        previous_mean = first_mean

        for weights in mlp.weights[1:]:
            preactivations = activations @ weights
            activations = fnp.maximum(preactivations, 0.0)

            linear_mean = previous_mean @ weights
            absolute_mean = fnp.mean(fnp.abs(preactivations), axis=0)
            layer_mean = fnp.maximum(0.5 * (linear_mean + absolute_mean), 0.0)

            rows.append(layer_mean)
            previous_mean = layer_mean

        return fnp.asarray(fnp.stack(rows, axis=0), dtype=fnp.float32)
```

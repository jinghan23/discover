            final_mean = (
                final_mean * (1.0 - _EDGEWORTH_FINAL_BLEND)
                + edgeworth_final_mean * _EDGEWORTH_FINAL_BLEND
            )
        if _DIAGONAL_FINAL_BLEND != 0.0:
            diagonal_final_mean = _diagonal_gaussian_final_mean(mlp.weights)
            final_mean = (

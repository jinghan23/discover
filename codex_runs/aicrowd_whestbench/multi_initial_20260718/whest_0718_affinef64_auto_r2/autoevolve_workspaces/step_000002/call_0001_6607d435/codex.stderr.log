            diagonal_final_mean = _diagonal_gaussian_final_mean(mlp.weights)
            final_mean = (
                final_mean * (1.0 - _DIAGONAL_FINAL_BLEND)
                + diagonal_final_mean * _DIAGONAL_FINAL_BLEND
            )
        zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


mlp=sample_mlp(16,4,fnp.random.default_rng(2),seed=3)
with flops.BudgetContext(flop_budget=10_000_000, quiet=True):
    y=est.predict(mlp,10_000_000)
print(y.shape, bool(fnp.all(fnp.isfinite(y))))

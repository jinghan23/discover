diff --git a/submission.py b/submission.py
index ee6f9b35dfc9834dab6c3bc8b8fdc7b1ce1ea9a0..801d92807b3ae9d1b0aaa6a3cd8fb8d10d733206
--- a/submission.py
+++ b/submission.py
@@ -8,7 +8,11 @@
 
 
 _BUDGET_FRACTION = 0.090
-_GAUSSIAN_FINAL_BLEND = -0.030
+_GAUSSIAN_FINAL_BLEND = -0.037
+_GAUSSIAN_BLEND_ACTIVE_SLOPE = -0.04
+_SAMPLE_COUNT_ADJUST = 2
+_FIRST_MEAN_BLEND = 1.25
+_FIRST_COVARIANCE_BLEND = 1.18
 _MIN_SAMPLES = 32
 _MAX_SAMPLES = 1_000_000
 _ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
@@ -18,7 +22,7 @@
 _INV_SQRT_2PI = 0.3989422804014327
 _INV_2PI = 0.15915494309189535
 _PI = 3.141592653589793
-_COVARIANCE_EIGEN_FLOOR = 1e-7
+_COVARIANCE_EIGEN_FLOOR = 1e-6
 _FIRST_COVARIANCE_DOF = 7
 _FINAL_COVARIANCE_DOF = 2.65
 
@@ -29,6 +33,7 @@
     k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
     max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
     k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
+    k = max(_MIN_SAMPLES, min(_MAX_SAMPLES, k + _SAMPLE_COUNT_ADJUST))
     return k - (k & 1)
 
 
@@ -104,7 +109,16 @@
         target_values = fnp.maximum(target_values, _COVARIANCE_EIGEN_FLOOR)
         sample_inverse_sqrt = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
         target_sqrt = (target_vectors * fnp.sqrt(target_values)) @ target_vectors.T
-        x = centered @ (sample_inverse_sqrt @ target_sqrt) + first_mean
+        remapped_centered = centered @ (sample_inverse_sqrt @ target_sqrt)
+        if _FIRST_MEAN_BLEND != 1.0 or _FIRST_COVARIANCE_BLEND != 1.0:
+            x = (
+                centered * (1.0 - _FIRST_COVARIANCE_BLEND)
+                + remapped_centered * _FIRST_COVARIANCE_BLEND
+                + sample_mean * (1.0 - _FIRST_MEAN_BLEND)
+                + first_mean * _FIRST_MEAN_BLEND
+            )
+        else:
+            x = remapped_centered + first_mean
 
         for weight in mlp.weights[1:-1]:
             x = fnp.maximum(x @ weight, 0.0)
@@ -133,9 +147,15 @@
             fnp.mean(fnp.asarray(sampled_final, dtype=fnp.float64), axis=0),
             dtype=fnp.float32,
         )
-        final_mean = (
-            sampled_final_mean * (1.0 - _GAUSSIAN_FINAL_BLEND)
-            + gaussian_final_mean * _GAUSSIAN_FINAL_BLEND
-        )
+        if _GAUSSIAN_BLEND_ACTIVE_SLOPE != 0.0:
+            final_blend = _GAUSSIAN_FINAL_BLEND + _GAUSSIAN_BLEND_ACTIVE_SLOPE * (
+                distribution - 0.5
+            )
+            final_mean = sampled_final_mean * (1.0 - final_blend) + gaussian_final_mean * final_blend
+        else:
+            final_mean = (
+                sampled_final_mean * (1.0 - _GAUSSIAN_FINAL_BLEND)
+                + gaussian_final_mean * _GAUSSIAN_FINAL_BLEND
+            )
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


"""Setup-cached whitened antithetic submission candidate."""

from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
import os
from whestbench import BaseEstimator


def _env_float(name, default):
    value = os.environ.get(name)
    return default if value is None else float(value)


def _env_int(name, default):
    value = os.environ.get(name)
    return default if value is None else int(value)


_BUDGET_FRACTION = _env_float("WB_BUDGET_FRACTION", 0.090)
_GAUSSIAN_FINAL_BLEND = _env_float("WB_GAUSSIAN_FINAL_BLEND", 0.0300)
_GAUSSIAN_BLEND_ACTIVE_SLOPE = _env_float("WB_GAUSSIAN_BLEND_ACTIVE_SLOPE", -0.183)
_GAUSSIAN_BLEND_ACTIVE_QUAD = _env_float("WB_GAUSSIAN_BLEND_ACTIVE_QUAD", -0.414)
_EDGEWORTH_CORRECTION_SCALE = _env_float("WB_EDGEWORTH_CORRECTION_SCALE", 0.0)
_DIAGONAL_GAUSSIAN_BLEND = _env_float("WB_DIAGONAL_GAUSSIAN_BLEND", 0.0)
_HIDDEN_GAUSSIAN_MEAN_BLEND = _env_float("WB_HIDDEN_GAUSSIAN_MEAN_BLEND", 0.0)
_DEPTH_TWO_EXACT_GAUSSIAN_BLEND = _env_float("WB_DEPTH_TWO_EXACT_GAUSSIAN_BLEND", 0.10)
_SAMPLE_COUNT_ADJUST = _env_int("WB_SAMPLE_COUNT_ADJUST", 0)
_FIRST_MEAN_BLEND = _env_float("WB_FIRST_MEAN_BLEND", 1.275)
_FIRST_COVARIANCE_BLEND = _env_float("WB_FIRST_COVARIANCE_BLEND", 1.0920)
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = _env_int("WB_SETUP_SEED_OFFSET", 3)
_WHITEN_BLOCKS = _env_int("WB_WHITEN_BLOCKS", 8)
_RADIAL_POWER = _env_float("WB_RADIAL_POWER", 1.75)
_INV_SQRT_2PI = 0.3989422804014327
_INV_2PI = 0.15915494309189535
_PI = 3.141592653589793
_COVARIANCE_EIGEN_FLOOR = _env_float("WB_COVARIANCE_EIGEN_FLOOR", 1e-6)
_FIRST_COVARIANCE_DOF = _env_float("WB_FIRST_COVARIANCE_DOF", 5.95)
_FINAL_COVARIANCE_DOF = _env_float("WB_FINAL_COVARIANCE_DOF", -670.0)


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    k = max(_MIN_SAMPLES, min(_MAX_SAMPLES, k + _SAMPLE_COUNT_ADJUST))
    return k - (k & 1)


class Estimator(BaseEstimator):
    """Whitened antithetic Monte Carlo with first-layer moment matching."""

    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._samples = self._make_samples(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )

    def _sample_block(self, rng, rows, width):
        u = rng.standard_normal((rows, width), dtype=fnp.float32)


"""Setup-cached whitened antithetic submission candidate."""

from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
import os
from whestbench import BaseEstimator


def _env_float(name, default):
    value = os.environ.get(name)
    return default if value is None else float(value)


def _env_int(name, default):
    value = os.environ.get(name)
    return default if value is None else int(value)


_BUDGET_FRACTION = _env_float("WB_BUDGET_FRACTION", 0.090)
_GAUSSIAN_FINAL_BLEND = _env_float("WB_GAUSSIAN_FINAL_BLEND", 0.0300)
_GAUSSIAN_BLEND_ACTIVE_SLOPE = _env_float("WB_GAUSSIAN_BLEND_ACTIVE_SLOPE", -0.183)
_GAUSSIAN_BLEND_ACTIVE_QUAD = _env_float("WB_GAUSSIAN_BLEND_ACTIVE_QUAD", -0.414)
_EDGEWORTH_CORRECTION_SCALE = _env_float("WB_EDGEWORTH_CORRECTION_SCALE", 0.0)
_DIAGONAL_GAUSSIAN_BLEND = _env_float("WB_DIAGONAL_GAUSSIAN_BLEND", 0.0)
_HIDDEN_GAUSSIAN_MEAN_BLEND = _env_float("WB_HIDDEN_GAUSSIAN_MEAN_BLEND", 0.0)
_DEPTH_TWO_EXACT_GAUSSIAN_BLEND = _env_float("WB_DEPTH_TWO_EXACT_GAUSSIAN_BLEND", 0.10)
_SAMPLE_COUNT_ADJUST = _env_int("WB_SAMPLE_COUNT_ADJUST", 0)
_FIRST_MEAN_BLEND = _env_float("WB_FIRST_MEAN_BLEND", 1.275)
_FIRST_COVARIANCE_BLEND = _env_float("WB_FIRST_COVARIANCE_BLEND", 1.0900)
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = _env_int("WB_SETUP_SEED_OFFSET", 3)
_WHITEN_BLOCKS = _env_int("WB_WHITEN_BLOCKS", 8)
_RADIAL_POWER = _env_float("WB_RADIAL_POWER", 1.75)
_INV_SQRT_2PI = 0.3989422804014327
_INV_2PI = 0.15915494309189535
_PI = 3.141592653589793
_COVARIANCE_EIGEN_FLOOR = _env_float("WB_COVARIANCE_EIGEN_FLOOR", 1e-6)
_FIRST_COVARIANCE_DOF = _env_float("WB_FIRST_COVARIANCE_DOF", 5.95)
_FINAL_COVARIANCE_DOF = _env_float("WB_FINAL_COVARIANCE_DOF", -670.0)


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    k = max(_MIN_SAMPLES, min(_MAX_SAMPLES, k + _SAMPLE_COUNT_ADJUST))
    return k - (k & 1)


class Estimator(BaseEstimator):
    """Whitened antithetic Monte Carlo with first-layer moment matching."""

    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._samples = self._make_samples(
            self._width,
            _sample_count(int(context.flop_budget), self._width, self._depth),
            int(context.seed) + _SETUP_SEED_OFFSET,
        )

    def _sample_block(self, rng, rows, width):
        u = rng.standard_normal((rows, width), dtype=fnp.float32)
        u_norm = fnp.sqrt(fnp.sum(u * u, axis=1))
        radial_scale = fnp.sqrt(float(width)) / fnp.maximum(u_norm, 1e-12)
        if _RADIAL_POWER != 1.0:
            radial_scale = radial_scale**_RADIAL_POWER
        u = u * radial_scale[:, None]
        covariance = (u.T @ u) / float(rows)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        return fnp.asarray(u @ inverse_sqrt, dtype=fnp.float32)

    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        blocks = []
        block_count = max(1, min(_WHITEN_BLOCKS, k // (2 * width)))
        block_rows = max(width, k // (2 * block_count))
        for _ in range(block_count):
            blocks.append(self._sample_block(rng, block_rows, width))
        half = fnp.concatenate(blocks, axis=0)
        return fnp.concatenate([half, -half], axis=0)

    def _diagonal_gaussian_final_mean(self, weights, width):
        mean = fnp.zeros(width, dtype=fnp.float32)
        variance = fnp.ones(width, dtype=fnp.float32)
        for weight in weights:
            pre_mean = mean @ weight
            pre_variance = fnp.maximum(variance @ (weight * weight), 1e-12)
            pre_scale = fnp.sqrt(pre_variance)
            alpha = pre_mean / pre_scale
            density = flops.stats.norm.pdf(alpha)
            distribution = flops.stats.norm.cdf(alpha)
            next_mean = pre_mean * distribution + pre_scale * density
            second_moment = (
                (pre_mean * pre_mean + pre_variance) * distribution
                + pre_mean * pre_scale * density
            )
            mean = fnp.asarray(next_mean, dtype=fnp.float32)
            variance = fnp.asarray(
                fnp.maximum(second_moment - next_mean * next_mean, 1e-12),
                dtype=fnp.float32,
            )
        return mean

    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        if (
            not hasattr(self, "_samples")
            or self._samples.shape[1] != width
            or getattr(self, "_depth", depth) != depth
        ):
            self._samples = self._make_samples(width, _sample_count(budget, width, depth), mlp.seed)
            self._depth = depth

        first_weight = mlp.weights[0]
        first_variance = fnp.sum(first_weight * first_weight, axis=0)
        first_mean = fnp.sqrt(first_variance) * _INV_SQRT_2PI
        x = fnp.maximum(self._samples @ first_weight, 0.0)
        if depth == 1:
            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
            return fnp.concatenate([zero_rows, first_mean[None, :]], axis=0)

        sample_mean = fnp.mean(x, axis=0)
        centered = x - sample_mean
        sample_covariance = (centered.T @ centered) / float(
            max(centered.shape[0] - _FIRST_COVARIANCE_DOF, 1)
        )
        pre_covariance = first_weight.T @ first_weight
        first_scale = fnp.sqrt(fnp.maximum(first_variance, 1e-12))
        scale_outer = first_scale[:, None] * first_scale[None, :]
        correlation = pre_covariance / fnp.maximum(scale_outer, 1e-12)
        correlation = fnp.maximum(fnp.minimum(correlation, 1.0), -1.0)
        kernel = (
            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
            + (_PI - fnp.arccos(correlation)) * correlation
        ) * _INV_2PI
        target_covariance = scale_outer * kernel - first_mean[:, None] * first_mean[None, :]
        sample_values, sample_vectors = fnp.linalg.eigh(sample_covariance)
        target_values, target_vectors = fnp.linalg.eigh(target_covariance)
        sample_values = fnp.maximum(sample_values, _COVARIANCE_EIGEN_FLOOR)
        target_values = fnp.maximum(target_values, _COVARIANCE_EIGEN_FLOOR)
        sample_inverse_sqrt = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
        target_sqrt = (target_vectors * fnp.sqrt(target_values)) @ target_vectors.T
        remapped_centered = centered @ (sample_inverse_sqrt @ target_sqrt)
        x = (
            centered * (1.0 - _FIRST_COVARIANCE_BLEND)
            + remapped_centered * _FIRST_COVARIANCE_BLEND
            + sample_mean * (1.0 - _FIRST_MEAN_BLEND)
            + first_mean * _FIRST_MEAN_BLEND
        )

        for weight in mlp.weights[1:-1]:
            pre = x @ weight
            x = fnp.maximum(pre, 0.0)
            if _HIDDEN_GAUSSIAN_MEAN_BLEND != 0.0:
                hidden_pre_mean = fnp.mean(pre, axis=0)
                hidden_centered = pre - hidden_pre_mean
                hidden_pre_variance = fnp.mean(hidden_centered * hidden_centered, axis=0)
                hidden_pre_variance = fnp.maximum(hidden_pre_variance, 1e-12)
                hidden_pre_scale = fnp.sqrt(hidden_pre_variance)
                hidden_alpha = hidden_pre_mean / hidden_pre_scale
                hidden_density = flops.stats.norm.pdf(hidden_alpha)
                hidden_distribution = flops.stats.norm.cdf(hidden_alpha)
                hidden_gaussian_mean = (
                    hidden_pre_mean * hidden_distribution
                    + hidden_pre_scale * hidden_density
                )
                hidden_sample_mean = fnp.mean(x, axis=0)
                x = x + _HIDDEN_GAUSSIAN_MEAN_BLEND * (
                    hidden_gaussian_mean - hidden_sample_mean
                )

        final_weight = mlp.weights[-1]
        sampled_pre = x @ final_weight
        sampled_pre64 = fnp.asarray(sampled_pre, dtype=fnp.float64)
        pre_mean = fnp.mean(sampled_pre64, axis=0)
        pre_centered = sampled_pre64 - pre_mean
        pre_variance = fnp.sum(pre_centered * pre_centered, axis=0) / float(
            max(pre_centered.shape[0] - _FINAL_COVARIANCE_DOF, 1)
        )
        pre_variance = fnp.maximum(pre_variance, 1e-12)
        pre_scale = fnp.sqrt(pre_variance)
        alpha = pre_mean / pre_scale
        density = flops.stats.norm.pdf(alpha)
        distribution = flops.stats.norm.cdf(alpha)
        gaussian_final_mean = fnp.asarray(
            pre_mean * distribution + pre_scale * density,
            dtype=fnp.float32,
        )
        if _EDGEWORTH_CORRECTION_SCALE != 0.0:
            standardized = pre_centered / pre_scale
            skew = fnp.mean(standardized * standardized * standardized, axis=0)
            fourth = standardized * standardized
            excess_kurtosis = fnp.mean(fourth * fourth, axis=0) - 3.0
            skew = fnp.maximum(fnp.minimum(skew, 3.0), -3.0)
            excess_kurtosis = fnp.maximum(fnp.minimum(excess_kurtosis, 6.0), -6.0)
            threshold = -alpha
            threshold2 = threshold * threshold
            threshold3 = threshold2 * threshold
            threshold4 = threshold2 * threshold2
            skew_term = (
                pre_mean * (threshold2 - 1.0)
                + pre_scale * threshold3
            ) * density * (skew / 6.0)
            kurtosis_term = (
                pre_mean * (threshold3 - 3.0 * threshold)
                + pre_scale * (threshold4 - 2.0 * threshold2 - 1.0)
            ) * density * (excess_kurtosis / 24.0)
            gaussian_final_mean = fnp.asarray(
                gaussian_final_mean
                + _EDGEWORTH_CORRECTION_SCALE * (skew_term + kurtosis_term),
                dtype=fnp.float32,
            )
        sampled_final_mean = fnp.asarray(
            fnp.mean(fnp.maximum(sampled_pre64, 0.0), axis=0),
            dtype=fnp.float32,
        )
        active_delta = distribution - 0.5
        final_blend = _GAUSSIAN_FINAL_BLEND + _GAUSSIAN_BLEND_ACTIVE_SLOPE * active_delta
        if _GAUSSIAN_BLEND_ACTIVE_QUAD != 0.0:
            final_blend = final_blend + _GAUSSIAN_BLEND_ACTIVE_QUAD * active_delta * active_delta
        final_mean = sampled_final_mean * (1.0 - final_blend) + gaussian_final_mean * final_blend
        if _DIAGONAL_GAUSSIAN_BLEND != 0.0:
            diagonal_mean = self._diagonal_gaussian_final_mean(mlp.weights, width)
            final_mean = (
                final_mean * (1.0 - _DIAGONAL_GAUSSIAN_BLEND)
                + diagonal_mean * _DIAGONAL_GAUSSIAN_BLEND
            )
        if depth == 2 and _DEPTH_TWO_EXACT_GAUSSIAN_BLEND != 0.0:
            exact_pre_mean = first_mean @ final_weight
            exact_pre_variance = fnp.sum((target_covariance @ final_weight) * final_weight, axis=0)
            exact_pre_variance = fnp.maximum(exact_pre_variance, 1e-12)
            exact_pre_scale = fnp.sqrt(exact_pre_variance)
            exact_alpha = exact_pre_mean / exact_pre_scale
            exact_density = flops.stats.norm.pdf(exact_alpha)
            exact_distribution = flops.stats.norm.cdf(exact_alpha)
            exact_final_mean = fnp.asarray(
                exact_pre_mean * exact_distribution + exact_pre_scale * exact_density,
                dtype=fnp.float32,
            )
            final_mean = (
                final_mean * (1.0 - _DEPTH_TWO_EXACT_GAUSSIAN_BLEND)
                + exact_final_mean * _DEPTH_TWO_EXACT_GAUSSIAN_BLEND
            )
        zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


    with sock:
        sock.sendall(data); chunks=[]
        while True:
            c=sock.recv(65536)
            if not c: break
            chunks.append(c)
            if b'\\n' in c: break
    return json.loads(b''.join(chunks).split(b'\\n',1)[0].decode())


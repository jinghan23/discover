exec
/bin/bash -lc "python - <<'PY'
from __future__ import annotations
import json, os, re, socket, uuid
from pathlib import Path
SOCKET_PATH = os.environ.get('TTT_BLACKBOX_EVAL_SOCKET') or '/tmp/wb_affinef64_a2.sock'
HOST = os.environ.get('TTT_BLACKBOX_EVAL_HOST') or '127.0.0.1'
PORT = os.environ.get('TTT_BLACKBOX_EVAL_PORT')
source0 = Path('submission.py').read_text()
source0 = re.sub(r'_SETUP_SEED_OFFSET = [-0-9]+', '_SETUP_SEED_OFFSET = 3', source0)
source0 = re.sub(r'_FINAL_COVARIANCE_DOF = [-0-9.]+', '_FINAL_COVARIANCE_DOF = 0.0', source0)

def evaluate(src):
    req={'request_id':str(uuid.uuid4()),'problem_type':'arc_whestbench_2026','submission':src}
    data=json.dumps(req,separators=(',',':')).encode()+b'\\n'
    if SOCKET_PATH:
        sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); sock.settimeout(4000); sock.connect(SOCKET_PATH)
    else:
        sock=socket.create_connection((HOST,int(PORT)),timeout=4000); sock.settimeout(4000)
    with sock:
        sock.sendall(data); chunks=[]
        while True:
            c=sock.recv(65536)
            if not c: break
            chunks.append(c)
            if b'\\n' in c: break
    return json.loads(b''.join(chunks).split(b'\\n',1)[0].decode())

best=None
for blocks in [1,2,3,4,6,8,10,12,16,24]:
    src=re.sub(r'_WHITEN_BLOCKS = [0-9]+', f'_WHITEN_BLOCKS = {blocks}', source0)
    resp=evaluate(src); score=resp.get('raw_score')
    print(f'blocks={blocks} ok={resp.get(\"ok\")} score={score} msg={resp.get(\"message\")}')
    if resp.get('ok') and score is not None and (best is None or score < best[0]): best=(score,blocks)
print('BEST',best)

s0=re.sub(r'_FINAL_COVARIANCE_DOF = [-0-9.]+','_FINAL_COVARIANCE_DOF = -4.0',s0)
s0=re.sub(r'_GAUSSIAN_FINAL_BLEND = [-0-9.]+','_GAUSSIAN_FINAL_BLEND = -0.037',s0)

def ev(src):

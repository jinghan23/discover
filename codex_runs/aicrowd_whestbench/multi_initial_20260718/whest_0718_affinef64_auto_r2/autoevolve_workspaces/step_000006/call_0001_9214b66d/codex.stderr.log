from __future__ import annotations
import json, os, re, socket, uuid
from pathlib import Path
SOCKET_PATH=os.environ.get('TTT_BLACKBOX_EVAL_SOCKET') or '/tmp/wb_affinef64_a2.sock'
HOST=os.environ.get('TTT_BLACKBOX_EVAL_HOST') or '127.0.0.1'
PORT=os.environ.get('TTT_BLACKBOX_EVAL_PORT')
s0=Path('submission.py').read_text()
s0=re.sub(r'_SETUP_SEED_OFFSET = [-0-9]+','_SETUP_SEED_OFFSET = 3',s0)
s0=re.sub(r'_RADIAL_POWER = [-0-9.]+','_RADIAL_POWER = 1.75',s0)
s0=re.sub(r'_GAUSSIAN_FINAL_BLEND = [-0-9.]+','_GAUSSIAN_FINAL_BLEND = -0.035',s0)
s0=re.sub(r'_GAUSSIAN_BLEND_ACTIVE_SLOPE = [-0-9.]+','_GAUSSIAN_BLEND_ACTIVE_SLOPE = -0.082',s0)
s0=re.sub(r'_FIRST_MEAN_BLEND = [-0-9.]+','_FIRST_MEAN_BLEND = 1.19',s0)
s0=re.sub(r'_FIRST_COVARIANCE_BLEND = [-0-9.]+','_FIRST_COVARIANCE_BLEND = 1.105',s0)

def ev(src):
    req={'request_id':str(uuid.uuid4()),'problem_type':'arc_whestbench_2026','submission':src}
    data=json.dumps(req,separators=(',',':')).encode()+b'\\n'
    if SOCKET_PATH:
        sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); sock.settimeout(4000); sock.connect(SOCKET_PATH)
    else:
        sock=socket.create_connection((HOST,int(PORT)),timeout=4000); sock.settimeout(4000)
    with sock:
        sock.sendall(data); chunks=[]
        while True:
            c=sock.recv(65536)
            if not c: break
            chunks.append(c)
            if b'\\n' in c: break
    return json.loads(b''.join(chunks).split(b'\\n',1)[0].decode())

best=None
for dof in [-8,-6,-5,-4,-3,-2,-1,0,1,2,3]:
    src=re.sub(r'_FINAL_COVARIANCE_DOF = [-0-9.]+',f'_FINAL_COVARIANCE_DOF = {float(dof)}',s0)
    r=ev(src); score=r.get('raw_score')
    print(f'dof={dof} score={score} msg={r.get(\"message\")}')
    if r.get('ok') and score is not None and (best is None or score<best[0]): best=(score,dof)
print('BEST',best)

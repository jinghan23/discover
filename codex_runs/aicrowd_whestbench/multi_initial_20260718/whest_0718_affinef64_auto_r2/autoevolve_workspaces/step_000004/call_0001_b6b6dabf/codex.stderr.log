+                diag_covariance = fnp.maximum(diag_second - diag_mean * diag_mean, 1e-12)
+                diag_pre_mean = diag_mean @ analytic_weight
+                diag_pre_variance = diag_covariance @ (analytic_weight * analytic_weight)
+                diag_pre_variance = fnp.maximum(diag_pre_variance, 1e-12)
+                diag_pre_scale = fnp.sqrt(diag_pre_variance)
+                diag_alpha = diag_pre_mean / diag_pre_scale
+                diag_density = flops.stats.norm.pdf(diag_alpha)
+                diag_distribution = flops.stats.norm.cdf(diag_alpha)
+                diag_mean = fnp.asarray(
+                    diag_pre_mean * diag_distribution + diag_pre_scale * diag_density,
+                    dtype=fnp.float32,
+                )
+                diag_second = fnp.asarray(
+                    (diag_pre_variance + diag_pre_mean * diag_pre_mean) * diag_distribution
+                    + diag_pre_mean * diag_pre_scale * diag_density,
+                    dtype=fnp.float32,
+                )
+            final_mean = final_mean * (1.0 - _DIAG_FINAL_BLEND) + diag_mean * _DIAG_FINAL_BLEND
         zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
         return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


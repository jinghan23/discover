--- a/submission.py
+++ b/submission.py
@@ -8,9 +8,10 @@
 
 
 _BUDGET_FRACTION = 0.090
-_GAUSSIAN_FINAL_BLEND = -0.026
+_GAUSSIAN_FINAL_BLEND = -0.0235
 _GAUSSIAN_BLEND_ACTIVE_SLOPE = -0.132
 _GAUSSIAN_BLEND_ACTIVE_QUAD = -0.04
+_HIDDEN_MEAN_BLEND = 0.10
 _SAMPLE_COUNT_ADJUST = 2
 _FIRST_MEAN_BLEND = 1.19
 _FIRST_COVARIANCE_BLEND = 1.105
@@ -123,7 +124,25 @@
         )
 
         for weight in mlp.weights[1:-1]:
-            x = fnp.maximum(x @ weight, 0.0)
+            pre = x @ weight
+            x = fnp.maximum(pre, 0.0)
+            if _HIDDEN_MEAN_BLEND != 0.0:
+                pre64 = fnp.asarray(pre, dtype=fnp.float64)
+                pre_mean = fnp.mean(pre64, axis=0)
+                pre_centered = pre64 - pre_mean
+                pre_variance = fnp.mean(pre_centered * pre_centered, axis=0)
+                pre_scale = fnp.sqrt(fnp.maximum(pre_variance, 1e-12))
+                alpha = pre_mean / pre_scale
+                gaussian_mean = fnp.asarray(
+                    pre_mean * flops.stats.norm.cdf(alpha)
+                    + pre_scale * flops.stats.norm.pdf(alpha),
+                    dtype=fnp.float32,
+                )
+                sample_mean = fnp.asarray(
+                    fnp.mean(fnp.asarray(x, dtype=fnp.float64), axis=0),
+                    dtype=fnp.float32,
+                )
+                x = x + (gaussian_mean - sample_mean) * _HIDDEN_MEAN_BLEND
 
         final_weight = mlp.weights[-1]
         penultimate_x = fnp.asarray(x, dtype=fnp.float64)


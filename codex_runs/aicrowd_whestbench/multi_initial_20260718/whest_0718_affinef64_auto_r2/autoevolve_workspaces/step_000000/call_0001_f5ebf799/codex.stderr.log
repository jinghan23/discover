        for entry in per_mlp
        if isinstance(entry, dict) and "adjusted_final_layer_score" in entry
    ]
    effective_computes = [
        float(entry.get("effective_compute", 0.0)) for entry in per_mlp if isinstance(entry, dict)
    ]



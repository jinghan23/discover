"""Setup-cached whitened antithetic submission candidate."""

from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_BUDGET_FRACTION = 0.090
_GAUSSIAN_FINAL_BLEND = 0.0300
_GAUSSIAN_BLEND_ACTIVE_SLOPE = -0.183
_GAUSSIAN_BLEND_ACTIVE_QUAD = -0.410
_DIAGONAL_FINAL_BLEND = 0.0
_FULL_GAUSSIAN_FINAL_BLEND = 0.0
_SKEW_FINAL_CORRECTION = 0.0
_CLIP_FIRST_REMAP = False
_HIDDEN_VARIANCE_SCALE = 1.0
_HIDDEN_MEAN_BLEND = 0.0
_SAMPLE_COUNT_ADJUST = 2
_FIRST_MEAN_BLEND = 1.275
_FIRST_COVARIANCE_BLEND = 1.0900
_MIN_SAMPLES = 32
_MAX_SAMPLES = 1_000_000
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_WORST_CASE_ITEMSIZE = 8
_SETUP_SEED_OFFSET = 3
_USE_MLP_SEED_SAMPLES = False
_WHITEN_BLOCKS = 8
_RADIAL_POWER = 1.75
_INV_SQRT_2PI = 0.3989422804014327
_INV_2PI = 0.15915494309189535
_PI = 3.141592653589793
_COVARIANCE_EIGEN_FLOOR = 1e-6
_FIRST_COVARIANCE_DOF = 5.95
_FINAL_COVARIANCE_DOF = -650.0


def _sample_count(budget: int, width: int, depth: int) -> int:
    per_sample = depth * (2 * width * width + width) + width * width
    fixed = 9 * width**3 + 2 * (2 * width**3)
    k = (int(_BUDGET_FRACTION * budget) - fixed) // max(per_sample, 1)
    max_k_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _WORST_CASE_ITEMSIZE, 1)
    k = int(max(_MIN_SAMPLES, min(_MAX_SAMPLES, max_k_by_bytes, k)))
    k = max(_MIN_SAMPLES, min(_MAX_SAMPLES, k + _SAMPLE_COUNT_ADJUST))
    return k - (k & 1)


class Estimator(BaseEstimator):
    """Whitened antithetic Monte Carlo with first-layer moment matching."""

    def setup(self, context):
        self._width = int(context.width)
        self._depth = int(context.depth)
        self._sample_count_value = _sample_count(int(context.flop_budget), self._width, self._depth)
        if not _USE_MLP_SEED_SAMPLES:
            self._samples = self._make_samples(
                self._width,
                self._sample_count_value,
                int(context.seed) + _SETUP_SEED_OFFSET,
            )

    def _sample_block(self, rng, rows, width):
        u = rng.standard_normal((rows, width), dtype=fnp.float32)
        u_norm = fnp.sqrt(fnp.sum(u * u, axis=1))
        radial_scale = fnp.sqrt(float(width)) / fnp.maximum(u_norm, 1e-12)
        if _RADIAL_POWER != 1.0:
            radial_scale = radial_scale**_RADIAL_POWER
        u = u * radial_scale[:, None]
        covariance = (u.T @ u) / float(rows)
        eigenvalues, eigenvectors = fnp.linalg.eigh(covariance)
        eigenvalues = fnp.maximum(eigenvalues, 1e-6)
        inverse_sqrt = (eigenvectors / fnp.sqrt(eigenvalues)) @ eigenvectors.T
        return fnp.asarray(u @ inverse_sqrt, dtype=fnp.float32)

    def _make_samples(self, width, k, seed):
        rng = fnp.random.default_rng(seed)
        blocks = []
        block_count = max(1, min(_WHITEN_BLOCKS, k // (2 * width)))
        block_rows = max(width, k // (2 * block_count))
        for _ in range(block_count):
            blocks.append(self._sample_block(rng, block_rows, width))
        half = fnp.concatenate(blocks, axis=0)
        return fnp.concatenate([half, -half], axis=0)

    def predict(self, mlp, budget):
        width = mlp.width
        depth = mlp.depth
        if _USE_MLP_SEED_SAMPLES:
            samples = self._make_samples(
                width,
                getattr(self, "_sample_count_value", _sample_count(budget, width, depth)),
                int(mlp.seed) + _SETUP_SEED_OFFSET,
            )
        elif (
            not hasattr(self, "_samples")
            or self._samples.shape[1] != width
            or getattr(self, "_depth", depth) != depth
        ):
            self._samples = self._make_samples(width, _sample_count(budget, width, depth), mlp.seed)
            self._depth = depth
            samples = self._samples
        else:
            samples = self._samples

        first_weight = mlp.weights[0]
        first_variance = fnp.sum(first_weight * first_weight, axis=0)
        first_mean = fnp.sqrt(first_variance) * _INV_SQRT_2PI
        x = fnp.maximum(samples @ first_weight, 0.0)
        if depth == 1:
            zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
            return fnp.concatenate([zero_rows, first_mean[None, :]], axis=0)

        sample_mean = fnp.mean(x, axis=0)
        centered = x - sample_mean
        sample_covariance = (centered.T @ centered) / float(
            max(centered.shape[0] - _FIRST_COVARIANCE_DOF, 1)
        )
        pre_covariance = first_weight.T @ first_weight
        first_scale = fnp.sqrt(fnp.maximum(first_variance, 1e-12))
        scale_outer = first_scale[:, None] * first_scale[None, :]
        correlation = pre_covariance / fnp.maximum(scale_outer, 1e-12)
        correlation = fnp.maximum(fnp.minimum(correlation, 0.999999), -0.999999)
        kernel = (
            fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
            + (_PI - fnp.arccos(correlation)) * correlation
        ) * _INV_2PI
        target_covariance = scale_outer * kernel - first_mean[:, None] * first_mean[None, :]
        sample_values, sample_vectors = fnp.linalg.eigh(sample_covariance)
        target_values, target_vectors = fnp.linalg.eigh(target_covariance)
        sample_values = fnp.maximum(sample_values, _COVARIANCE_EIGEN_FLOOR)
        target_values = fnp.maximum(target_values, _COVARIANCE_EIGEN_FLOOR)
        sample_inverse_sqrt = (sample_vectors / fnp.sqrt(sample_values)) @ sample_vectors.T
        target_sqrt = (target_vectors * fnp.sqrt(target_values)) @ target_vectors.T
        remapped_centered = centered @ (sample_inverse_sqrt @ target_sqrt)
        x = (
            centered * (1.0 - _FIRST_COVARIANCE_BLEND)
            + remapped_centered * _FIRST_COVARIANCE_BLEND
            + sample_mean * (1.0 - _FIRST_MEAN_BLEND)
            + first_mean * _FIRST_MEAN_BLEND
        )
        if _CLIP_FIRST_REMAP:
            x = fnp.maximum(x, 0.0)

        for weight in mlp.weights[1:-1]:
            pre = x @ weight
            relu_pre = fnp.maximum(pre, 0.0)
            if _HIDDEN_MEAN_BLEND != 0.0:
                hidden_pre_mean = fnp.mean(pre, axis=0)
                hidden_pre_centered = pre - hidden_pre_mean
                hidden_pre_variance = fnp.mean(hidden_pre_centered * hidden_pre_centered, axis=0)
                hidden_pre_scale = fnp.sqrt(fnp.maximum(hidden_pre_variance, 1e-12))
                hidden_alpha = hidden_pre_mean / hidden_pre_scale
                hidden_gaussian_mean = fnp.asarray(
                    hidden_pre_mean * flops.stats.norm.cdf(hidden_alpha)
                    + hidden_pre_scale * flops.stats.norm.pdf(hidden_alpha),
                    dtype=fnp.float32,
                )
                hidden_sample_mean = fnp.mean(relu_pre, axis=0)
                x = relu_pre + _HIDDEN_MEAN_BLEND * (hidden_gaussian_mean - hidden_sample_mean)
            else:
                x = relu_pre
            if _HIDDEN_VARIANCE_SCALE != 1.0:
                hidden_mean = fnp.mean(x, axis=0)
                x = hidden_mean + (x - hidden_mean) * _HIDDEN_VARIANCE_SCALE

        final_weight = mlp.weights[-1]
        sampled_pre = x @ final_weight
        sampled_pre64 = fnp.asarray(sampled_pre, dtype=fnp.float64)
        pre_mean = fnp.mean(sampled_pre64, axis=0)
        pre_centered = sampled_pre64 - pre_mean
        pre_variance = fnp.sum(pre_centered * pre_centered, axis=0) / float(
            max(pre_centered.shape[0] - _FINAL_COVARIANCE_DOF, 1)
        )
        pre_variance = fnp.maximum(pre_variance, 1e-12)
        pre_scale = fnp.sqrt(pre_variance)
        alpha = pre_mean / pre_scale
        density = flops.stats.norm.pdf(alpha)
        distribution = flops.stats.norm.cdf(alpha)
        gaussian_final_mean = fnp.asarray(
            pre_mean * distribution + pre_scale * density,
            dtype=fnp.float32,
        )
        if _SKEW_FINAL_CORRECTION != 0.0:
            pre_third = fnp.mean(pre_centered * pre_centered * pre_centered, axis=0)
            skew = pre_third / fnp.maximum(pre_scale * pre_scale * pre_scale, 1e-12)
            skew_correction = -pre_scale * skew * alpha * density * (1.0 / 6.0)
            gaussian_final_mean = fnp.asarray(
                gaussian_final_mean + _SKEW_FINAL_CORRECTION * skew_correction,
                dtype=fnp.float32,
            )
        sampled_final_mean = fnp.asarray(
            fnp.mean(fnp.maximum(sampled_pre64, 0.0), axis=0),
            dtype=fnp.float32,
        )
        active_delta = distribution - 0.5
        final_blend = _GAUSSIAN_FINAL_BLEND + _GAUSSIAN_BLEND_ACTIVE_SLOPE * active_delta
        if _GAUSSIAN_BLEND_ACTIVE_QUAD != 0.0:
            final_blend = final_blend + _GAUSSIAN_BLEND_ACTIVE_QUAD * active_delta * active_delta
        final_mean = sampled_final_mean * (1.0 - final_blend) + gaussian_final_mean * final_blend
        if _DIAGONAL_FINAL_BLEND != 0.0:
            diagonal_mean = fnp.zeros(width, dtype=fnp.float32)
            diagonal_variance = fnp.ones(width, dtype=fnp.float32)
            for diagonal_weight in mlp.weights:
                diagonal_pre_mean = diagonal_mean @ diagonal_weight
                diagonal_pre_variance = diagonal_variance @ (diagonal_weight * diagonal_weight)
                diagonal_pre_variance = fnp.maximum(diagonal_pre_variance, 1e-12)
                diagonal_pre_scale = fnp.sqrt(diagonal_pre_variance)
                diagonal_alpha = diagonal_pre_mean / diagonal_pre_scale
                diagonal_density = flops.stats.norm.pdf(diagonal_alpha)
                diagonal_distribution = flops.stats.norm.cdf(diagonal_alpha)
                diagonal_second = (
                    (diagonal_pre_variance + diagonal_pre_mean * diagonal_pre_mean)
                    * diagonal_distribution
                    + diagonal_pre_mean * diagonal_pre_scale * diagonal_density
                )
                diagonal_mean = fnp.asarray(
                    diagonal_pre_mean * diagonal_distribution
                    + diagonal_pre_scale * diagonal_density,
                    dtype=fnp.float32,
                )
                diagonal_variance = fnp.maximum(
                    fnp.asarray(diagonal_second, dtype=fnp.float32) - diagonal_mean * diagonal_mean,
                    1e-12,
                )
            final_mean = final_mean * (1.0 - _DIAGONAL_FINAL_BLEND) + diagonal_mean * _DIAGONAL_FINAL_BLEND
        if _FULL_GAUSSIAN_FINAL_BLEND != 0.0:
            full_mean = first_mean
            full_covariance = target_covariance
            for gaussian_weight in mlp.weights[1:-1]:
                gaussian_pre_mean = full_mean @ gaussian_weight
                gaussian_pre_covariance = gaussian_weight.T @ full_covariance @ gaussian_weight
                gaussian_pre_variance = fnp.maximum(fnp.diag(gaussian_pre_covariance), 1e-12)
                gaussian_pre_scale = fnp.sqrt(gaussian_pre_variance)
                gaussian_alpha = gaussian_pre_mean / gaussian_pre_scale
                full_mean = fnp.asarray(
                    gaussian_pre_mean * flops.stats.norm.cdf(gaussian_alpha)
                    + gaussian_pre_scale * flops.stats.norm.pdf(gaussian_alpha),
                    dtype=fnp.float32,
                )
                gaussian_scale_outer = gaussian_pre_scale[:, None] * gaussian_pre_scale[None, :]
                gaussian_correlation = gaussian_pre_covariance / fnp.maximum(gaussian_scale_outer, 1e-12)
                gaussian_correlation = fnp.maximum(
                    fnp.minimum(gaussian_correlation, 0.999999),
                    -0.999999,
                )
                gaussian_kernel = (
                    fnp.sqrt(fnp.maximum(1.0 - gaussian_correlation * gaussian_correlation, 0.0))
                    + (_PI - fnp.arccos(gaussian_correlation)) * gaussian_correlation
                ) * _INV_2PI
                zero_mean = gaussian_pre_scale * _INV_SQRT_2PI
                full_covariance = (
                    gaussian_scale_outer * gaussian_kernel
                    - zero_mean[:, None] * zero_mean[None, :]
                )
            gaussian_weight = mlp.weights[-1]
            gaussian_pre_mean = full_mean @ gaussian_weight
            gaussian_pre_covariance = gaussian_weight.T @ full_covariance @ gaussian_weight
            gaussian_pre_variance = fnp.maximum(fnp.diag(gaussian_pre_covariance), 1e-12)
            gaussian_pre_scale = fnp.sqrt(gaussian_pre_variance)
            gaussian_alpha = gaussian_pre_mean / gaussian_pre_scale
            full_gaussian_final_mean = fnp.asarray(
                gaussian_pre_mean * flops.stats.norm.cdf(gaussian_alpha)
                + gaussian_pre_scale * flops.stats.norm.pdf(gaussian_alpha),
                dtype=fnp.float32,
            )
            final_mean = (
                final_mean * (1.0 - _FULL_GAUSSIAN_FINAL_BLEND)
                + full_gaussian_final_mean * _FULL_GAUSSIAN_FINAL_BLEND
            )
        zero_rows = fnp.zeros((depth - 1, width), dtype=fnp.float32)
        return fnp.concatenate([zero_rows, final_mean[None, :]], axis=0)


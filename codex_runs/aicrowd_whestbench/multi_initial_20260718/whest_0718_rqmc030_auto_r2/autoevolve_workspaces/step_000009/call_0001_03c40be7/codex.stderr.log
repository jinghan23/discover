+    pre_covariance = first_weight.T @ first_weight
+    pre_variance = fnp.maximum(fnp.diagonal(pre_covariance), 1e-30)
+    standard_deviation = fnp.sqrt(pre_variance)
+    denominator = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(pre_covariance / denominator, -0.999999, 0.999999)
+    kernel = (
+        fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        + (fnp.pi - fnp.arccos(correlation)) * correlation
+    ) / (2.0 * fnp.pi)
+    covariance = denominator * kernel - exact_mean[:, None] * exact_mean[None, :]
+    return covariance + fnp.diag(exact_variance - fnp.diagonal(covariance))

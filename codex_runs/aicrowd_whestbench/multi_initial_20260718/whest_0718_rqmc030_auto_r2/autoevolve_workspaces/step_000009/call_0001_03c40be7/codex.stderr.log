     return second - exact_mean * exact_mean
 
 
+def _relu_gaussian_moments(
+    pre_mean: fnp.ndarray, pre_variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    pre_variance = fnp.maximum(pre_variance, 1e-30)
+    standard_deviation = fnp.sqrt(pre_variance)
+    alpha = pre_mean / standard_deviation
+    pdf = flops.stats.norm.pdf(alpha)
+    cdf = flops.stats.norm.cdf(alpha)
+    mean = standard_deviation * pdf + pre_mean * cdf
+    second = (
+        (pre_variance + pre_mean * pre_mean) * cdf
+        + pre_mean * standard_deviation * pdf
+    )
+    return mean, second
+
+
+def _diagonal_relu_step(
+    mean: fnp.ndarray, second: fnp.ndarray, weight: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    centered_second = fnp.maximum(second - mean * mean, 1e-30)
+    pre_mean = mean @ weight
+    pre_variance = centered_second @ (weight * weight)
+    return _relu_gaussian_moments(pre_mean, pre_variance)
+
+

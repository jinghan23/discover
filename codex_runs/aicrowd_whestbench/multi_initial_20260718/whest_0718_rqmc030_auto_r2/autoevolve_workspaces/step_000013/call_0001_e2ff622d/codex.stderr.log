+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray, exact_mean: fnp.ndarray
+) -> fnp.ndarray:
+    gram = first_weight.T @ first_weight
+    norm_squared = fnp.maximum(fnp.diag(gram), 1e-30)
+    scale = fnp.sqrt(norm_squared[:, None] * norm_squared[None, :])
+    rho = fnp.clip(gram / fnp.maximum(scale, 1e-30), -1.0, 1.0)
+    second = scale * (
+        fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
+        + (_PI - fnp.arccos(rho)) * rho
+    ) * _INV_2PI
+    return second - exact_mean[:, None] * exact_mean[None, :]
+
+
 def _diagonal_final_moment(mlp) -> fnp.ndarray:

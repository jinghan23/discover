"""RQMC + Rao-Blackwell submission candidate at 30% tracked budget.

Public method description:
https://discourse.aicrowd.com/t/unbiased-randomized-qmc-rao-blackwell-for-post-relu-activation-means-method-unbiasedness-proof-and-where-the-frontier-is/18053
"""

from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.40
_SHIFT_COUNT = 4
_SEED_OFFSET = 0
_FINITE_LATTICE = False
_USE_HALTON = False
_USE_FIRST_CONTROL = True
_USE_FULL_FIRST_CONTROL = False
_FIRST_CONTROL_SCALE = 0.48
_FIRST_CONTROL_RIDGE = 1e-4
_USE_FIRST_SECOND_CONTROL = False
_FIRST_SECOND_CONTROL_SCALE = 0.20
_EQUAL_SHIFT_BLOCKS = True
_TAIL_CLIP = 1e-11
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8


def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


def _is_prime(value: int) -> bool:
    if value < 2:
        return False
    divisor = 2
    while divisor * divisor <= value:
        if value % divisor == 0:
            return False
        divisor += 1
    return True


def _previous_prime(value: int) -> int:
    value = max(2, value)
    while not _is_prime(value):
        value -= 1
    return value


def _lattice_generator(width: int, denominator: int | None = None) -> fnp.ndarray:
    if denominator is not None:
        return fnp.array(_first_primes(width), dtype=fnp.float64) / float(denominator)
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    return roots - fnp.floor(roots)


def _lattice_uniforms(
    n_samples: int, generator: fnp.ndarray, shift: fnp.ndarray
) -> fnp.ndarray:
    if _USE_HALTON:
        bases = fnp.array(_first_primes(int(shift.shape[0])), dtype=fnp.float64)
        remaining = fnp.arange(n_samples, dtype=fnp.float64)[:, None] + 1.0
        factor = 1.0 / bases[None, :]
        uniforms = fnp.zeros((n_samples, int(shift.shape[0])), dtype=fnp.float64)
        max_remaining = n_samples
        while max_remaining > 0:
            quotient = fnp.floor(remaining / bases[None, :])
            digit = remaining - quotient * bases[None, :]
            uniforms = uniforms + digit * factor
            remaining = quotient
            factor = factor / bases[None, :]
            max_remaining //= 2
        shifted = uniforms + shift[None, :]
        return shifted - fnp.floor(shifted)
    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    unwrapped = indices * generator[None, :] + shift[None, :]
    return unwrapped - fnp.floor(unwrapped)


def _antithetic_normal_lattice(
    n_samples: int, generator: fnp.ndarray, shifts: fnp.ndarray
) -> fnp.ndarray:
    paired_count = n_samples // 2
    shift_count = int(shifts.shape[0])
    per_shift = (paired_count + shift_count - 1) // shift_count
    normal_blocks = []
    remaining = paired_count
    for shift_index in range(shift_count):
        block_count = min(per_shift, remaining)
        if block_count <= 0:
            break
        uniforms = _lattice_uniforms(block_count, generator, shifts[shift_index])
        uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
        normal_blocks.append(flops.stats.norm.ppf(uniforms))
        remaining -= block_count
    normals = fnp.concatenate(normal_blocks, axis=0)
    activations = fnp.concatenate([normals, -normals], axis=0)
    if n_samples % 2:
        activations = fnp.concatenate([activations, normals[:1]], axis=0)
    return activations


def _exact_first_layer_mean(first_weight: fnp.ndarray) -> fnp.ndarray:
    standard_deviation = fnp.sqrt(fnp.sum(first_weight * first_weight, axis=0))
    return standard_deviation / fnp.sqrt(2.0 * fnp.pi)


def _exact_first_layer_second(first_weight: fnp.ndarray) -> fnp.ndarray:
    return 0.5 * fnp.sum(first_weight * first_weight, axis=0)


def _sample_count(budget: int, width: int, depth: int) -> int:
    # Each row pays for the lattice construction and inverse-normal map, every
    # layer's matmul/ReLU, and sampled means for rows 1..depth-1. The first row
    # uses the exact Gaussian ReLU mean instead.
    lattice_per_sample = 89 * width
    forward_per_sample = depth * (2 * width * width + width)
    later_means_per_sample = max(depth - 1, 0) * width
    per_sample = lattice_per_sample + forward_per_sample + later_means_per_sample

    # Fixed work is tiny relative to the forward pass; reserve it explicitly
    # so the phase-1 count remains under the requested tracked-FLOP fraction.
    fixed = 2 * width * width + 8 * width
    n_samples = (int(_TARGET_FLOP_FRACTION * budget) - fixed) // per_sample
    max_samples_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _FLOAT64_ITEMSIZE, 1)
    n_samples = int(max(1, min(n_samples, max_samples_by_bytes)))
    if _FINITE_LATTICE:
        block_count = _previous_prime(n_samples // max(2 * _SHIFT_COUNT, 1))
        n_samples = max(1, 2 * _SHIFT_COUNT * block_count)
    elif _EQUAL_SHIFT_BLOCKS:
        n_samples = max(1, (n_samples // max(2 * _SHIFT_COUNT, 1)) * 2 * _SHIFT_COUNT)
    return n_samples


class Estimator(BaseEstimator):
    """Single-shift rank-1 lattice estimator with an exact first output row."""

    def predict(self, mlp, budget):
        n_samples = _sample_count(budget, mlp.width, mlp.depth)
        rng = fnp.random.default_rng(mlp.seed + _SEED_OFFSET)
        denominator = n_samples // (2 * _SHIFT_COUNT) if _FINITE_LATTICE else None
        generator = _lattice_generator(mlp.width, denominator)
        shifts = rng.random((_SHIFT_COUNT, mlp.width))
        activations = _antithetic_normal_lattice(n_samples, generator, shifts)

        rows = []
        first_activations = None
        first_exact_mean = None
        first_exact_second = None
        first_sample_mean = None
        first_sample_second = None
        for layer_index, weight in enumerate(mlp.weights):
            activations = fnp.maximum(activations @ weight, 0.0)
            if layer_index == 0:
                exact_mean = _exact_first_layer_mean(weight)
                if _USE_FIRST_CONTROL:
                    first_activations = activations
                    first_exact_mean = exact_mean
                    first_exact_second = _exact_first_layer_second(weight)
                    first_sample_mean = fnp.mean(activations, axis=0)
                    first_sample_second = fnp.mean(activations * activations, axis=0)
                rows.append(exact_mean)
            elif layer_index == mlp.depth - 1 and _USE_FIRST_CONTROL:
                sampled_mean = fnp.mean(activations, axis=0)
                centered_first = first_activations - first_sample_mean
                first_variance = fnp.mean(centered_first * centered_first, axis=0)
                covariance = (centered_first.T @ activations) / float(n_samples)
                if _USE_FULL_FIRST_CONTROL:
                    control_covariance = (centered_first.T @ centered_first) / float(
                        n_samples
                    )
                    ridge = _FIRST_CONTROL_RIDGE * fnp.mean(first_variance)
                    beta = fnp.linalg.solve(
                        control_covariance + ridge * fnp.eye(mlp.width), covariance
                    )
                    correction = (first_exact_mean - first_sample_mean) @ beta
                else:
                    correction_weights = (
                        first_exact_mean - first_sample_mean
                    ) / fnp.maximum(first_variance, 1e-30)
                    correction = correction_weights @ covariance
                rows.append(
                    sampled_mean
                    + _FIRST_CONTROL_SCALE * correction
                )
                if _USE_FIRST_SECOND_CONTROL:
                    first_squared = first_activations * first_activations
                    centered_second = first_squared - first_sample_second
                    second_variance = fnp.mean(
                        centered_second * centered_second, axis=0
                    )
                    second_covariance = (centered_second.T @ activations) / float(
                        n_samples
                    )
                    second_weights = (
                        first_exact_second - first_sample_second
                    ) / fnp.maximum(second_variance, 1e-30)
                    rows[-1] = rows[-1] + _FIRST_SECOND_CONTROL_SCALE * (
                        second_weights @ second_covariance
                    )
            else:
                rows.append(fnp.mean(activations, axis=0))
        return fnp.stack(rows, axis=0)


     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _diagonal_mean_final(mlp) -> fnp.ndarray:
+    mu = fnp.zeros(mlp.width, dtype=fnp.float32)
+    variance = fnp.ones(mlp.width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        mu_pre = mu @ weight
+        variance_pre = variance @ (weight * weight)
+        variance_pre = fnp.maximum(variance_pre, 1e-12)
+        sigma_pre = fnp.sqrt(variance_pre)
+        alpha = mu_pre / sigma_pre
+        density = flops.stats.norm.pdf(alpha)
+        distribution = flops.stats.norm.cdf(alpha)
+        mu = mu_pre * distribution + sigma_pre * density
+        second = (
+            (mu_pre * mu_pre + variance_pre) * distribution
+            + mu_pre * sigma_pre * density
+        )
+        variance = fnp.maximum(second - mu * mu, 0.0)
+    return mu
+
+

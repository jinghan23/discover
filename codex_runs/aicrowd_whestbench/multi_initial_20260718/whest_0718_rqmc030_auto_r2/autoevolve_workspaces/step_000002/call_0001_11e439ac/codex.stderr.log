+def _diagonal_mean_final(mlp) -> fnp.ndarray:
+    mu = fnp.zeros(mlp.width, dtype=fnp.float32)
+    variance = fnp.ones(mlp.width, dtype=fnp.float32)
+    for weight in mlp.weights:
+        mu_pre = mu @ weight
+        variance_pre = variance @ (weight * weight)

+    second = scale * (root + (_PI - fnp.arccos(rho)) * rho) * _INV_2PI
+    covariance = second - exact_mean[:, None] * exact_mean[None, :]
+    ridge = _FIRST_COVARIANCE_RIDGE * fnp.maximum(exact_variance, 1e-30)
+    return covariance + fnp.diag(ridge)

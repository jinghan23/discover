                 correction = (control_scores @ activations) / float(n_samples)
                 controlled_mean = sampled_mean + _FIRST_CONTROL_SCALE * correction
+                if _FINAL_GAUSSIAN_BLEND:
+                    pre_mean = fnp.mean(pre_activations, axis=0)
+                    pre_second = fnp.mean(pre_activations * pre_activations, axis=0)
+                    pre_var = fnp.maximum(pre_second - pre_mean * pre_mean, 1e-12)
+                    pre_sigma = fnp.sqrt(pre_var)

+    scales = fnp.sqrt(norm_squared)
+    mean = scales * _INV_SQRT_2PI
+    gram = first_weight.T @ first_weight
+    denom = fnp.maximum(scales[:, None] * scales[None, :], 1e-30)
+    rho = fnp.clip(gram / denom, -1.0, 1.0)
+    curved = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))

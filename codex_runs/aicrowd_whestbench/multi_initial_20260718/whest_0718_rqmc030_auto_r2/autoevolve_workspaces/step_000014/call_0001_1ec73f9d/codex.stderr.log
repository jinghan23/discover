+def _relu_gaussian_mean(mu_pre: fnp.ndarray, var_pre: fnp.ndarray) -> fnp.ndarray:
+    var_pre = fnp.maximum(var_pre, 1e-12)
+    sigma_pre = fnp.sqrt(var_pre)
+    alpha = mu_pre / sigma_pre
+    return mu_pre * flops.stats.norm.cdf(alpha) + sigma_pre * flops.stats.norm.pdf(
+        alpha
+    )
+
+
+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray,
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    norm_squared = fnp.sum(first_weight * first_weight, axis=0)
+    scales = fnp.sqrt(norm_squared)
+    mean = scales * _INV_SQRT_2PI
+    gram = first_weight.T @ first_weight
+    denom = fnp.maximum(scales[:, None] * scales[None, :], 1e-30)
+    rho = fnp.clip(gram / denom, -1.0, 1.0)
+    curved = fnp.sqrt(fnp.maximum(1.0 - rho * rho, 0.0))
+    second = denom * (curved + (_PI - fnp.arccos(rho)) * rho) * _INV_2PI
+    covariance = second - mean[:, None] * mean[None, :]
+    return mean, covariance
+
+
+def _structured_final_moment(mlp) -> fnp.ndarray:
+    mu, covariance = _exact_first_layer_covariance(mlp.weights[0])
+    identity = fnp.eye(mlp.width, dtype=fnp.float32)
+    for weight in mlp.weights[1:]:
+        pre_mu = weight.T @ mu
+        pre_covariance = weight.T @ covariance @ weight
+        pre_variance = fnp.maximum(fnp.diag(pre_covariance), 1e-12)
+        pre_sigma = fnp.sqrt(pre_variance)
+        alpha = pre_mu / pre_sigma
+        phi_alpha = flops.stats.norm.pdf(alpha)
+        Phi_alpha = flops.stats.norm.cdf(alpha)
+        mu = pre_mu * Phi_alpha + pre_sigma * phi_alpha
+        second = (
+            (pre_mu * pre_mu + pre_variance) * Phi_alpha
+            + pre_mu * pre_sigma * phi_alpha
+        )
+        variance = fnp.maximum(second - mu * mu, 0.0)
+        covariance = pre_covariance * (Phi_alpha[:, None] * Phi_alpha[None, :])
+        covariance = covariance + identity * (variance - fnp.diag(covariance))
+    return fnp.asarray(mu, dtype=fnp.float32)

+def _relu_gaussian_mean(mu_pre: fnp.ndarray, var_pre: fnp.ndarray) -> fnp.ndarray:
+    var_pre = fnp.maximum(var_pre, 1e-12)
+    sigma_pre = fnp.sqrt(var_pre)
+    alpha = mu_pre / sigma_pre
+    return mu_pre * flops.stats.norm.cdf(alpha) + sigma_pre * flops.stats.norm.pdf(
+        alpha

+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray,
+    exact_mean: fnp.ndarray,
+    exact_variance: fnp.ndarray,
+    identity: fnp.ndarray,
+) -> fnp.ndarray:
+    gram = first_weight.T @ first_weight
+    standard_deviation = fnp.sqrt(fnp.maximum(fnp.diagonal(gram), 1e-30))
+    scale = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(gram / fnp.maximum(scale, 1e-30), -1.0, 1.0)
+    root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    angle = fnp.arccos(correlation)
+    second = scale * (

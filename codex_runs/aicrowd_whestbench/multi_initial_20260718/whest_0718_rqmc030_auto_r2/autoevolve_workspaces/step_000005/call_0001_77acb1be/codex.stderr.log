     return second - exact_mean * exact_mean
 
 
+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray, exact_mean: fnp.ndarray
+) -> fnp.ndarray:
+    standard_deviation = fnp.sqrt(fnp.sum(first_weight * first_weight, axis=0))
+    denominator = fnp.maximum(
+        standard_deviation[:, None] * standard_deviation[None, :], 1e-30
+    )
+    correlation = (first_weight.T @ first_weight) / denominator
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    kernel = (
+        fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+        + (fnp.pi - fnp.arccos(correlation)) * correlation
+    )
+    second = denominator * kernel / (2.0 * fnp.pi)
+    return second - exact_mean[:, None] * exact_mean[None, :]
+
+
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    standard_deviation = fnp.sqrt(fnp.maximum(variance, 1e-30))
+    alpha = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    relu_variance = fnp.maximum(second - relu_mean * relu_mean, 1e-30)
+    return relu_mean, relu_variance
+
+

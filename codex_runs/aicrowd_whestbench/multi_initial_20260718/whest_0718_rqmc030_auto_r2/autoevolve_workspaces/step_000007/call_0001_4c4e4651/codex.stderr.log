     return second - exact_mean * exact_mean
 
 
+def _relu_gaussian_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, 1e-30)
+    standard_deviation = fnp.sqrt(variance)
+    alpha = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    relu_second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    relu_variance = fnp.maximum(relu_second - relu_mean * relu_mean, 1e-30)
+    return relu_mean, relu_variance
+
+
+def _diagonal_moment_final(mlp) -> fnp.ndarray:
+    mean = _exact_first_layer_mean(mlp.weights[0])
+    variance = _exact_first_layer_variance(mlp.weights[0], mean)
+    for weight in mlp.weights[1:]:
+        pre_mean = mean @ weight
+        pre_variance = variance @ (weight * weight)
+        mean, variance = _relu_gaussian_moments(pre_mean, pre_variance)
+    return mean
+
+
 def _sample_count(budget: int, width: int, depth: int) -> int:
     lattice_per_sample = 89 * width
     forward_per_sample = depth * (2 * width * width + width)

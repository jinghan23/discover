     return second - exact_mean * exact_mean
 
 
+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray, exact_mean: fnp.ndarray
+) -> fnp.ndarray:
+    gram = first_weight.T @ first_weight
+    standard_deviation = fnp.sqrt(fnp.maximum(fnp.diag(gram), 1e-30))
+    denominator = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = gram / fnp.maximum(denominator, 1e-30)
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    angular = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0)) + (
+        fnp.pi - fnp.arccos(correlation)

def _relu_gaussian_moments(mean: fnp.ndarray, variance: fnp.ndarray):
    variance = fnp.maximum(variance, 1e-30)
    standard_deviation = fnp.sqrt(variance)
    alpha = mean / standard_deviation
    density = flops.stats.norm.pdf(alpha)
    distribution = flops.stats.norm.cdf(alpha)
    relu_mean = standard_deviation * density + mean * distribution
    second_moment = (variance + mean * mean) * distribution + mean * standard_deviation * density
    relu_variance = fnp.maximum(second_moment - relu_mean * relu_mean, 0.0)
    return relu_mean, relu_variance


def _diagonal_moment_estimate(mlp) -> fnp.ndarray:
    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
    variance = fnp.ones(mlp.width, dtype=fnp.float64)
    rows = []
    for weight in mlp.weights:
        weight64 = fnp.asarray(weight, dtype=fnp.float64)
        pre_mean = mean @ weight64
        pre_variance = variance @ (weight64 * weight64)
        mean, variance = _relu_gaussian_moments(pre_mean, pre_variance)
        rows.append(mean)
    return fnp.stack(rows, axis=0)


def _sample_count(budget: int, width: int, depth: int) -> int:
    # Each row pays for the lattice construction and inverse-normal map, every
    # layer's matmul/ReLU, and sampled means for rows 1..depth-1. The first row
    # uses the exact Gaussian ReLU mean instead.
    lattice_per_sample = 89 * width
    forward_per_sample = depth * (2 * width * width + width)
    later_means_per_sample = max(depth - 1, 0) * width
    per_sample = lattice_per_sample + forward_per_sample + later_means_per_sample

    # Fixed work is tiny relative to the forward pass; reserve it explicitly
    # so the phase-1 count remains under the requested tracked-FLOP fraction.
    fixed = 2 * width * width + 8 * width
    n_samples = (int(_TARGET_FLOP_FRACTION * budget) - fixed) // per_sample
    max_samples_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _FLOAT64_ITEMSIZE, 1)
    n_samples = int(max(1, min(n_samples, max_samples_by_bytes)))
    block_size = max(2 * _SHIFT_COUNT, 1)
    return max(1, (n_samples // block_size) * block_size)


class Estimator(BaseEstimator):
    """Four-shift antithetic lattice estimator with first-layer control."""

    def predict(self, mlp, budget):
        n_samples = _sample_count(budget, mlp.width, mlp.depth)
        rng = fnp.random.default_rng(mlp.seed)
        generator = _lattice_generator(mlp.width)
        shifts = rng.random((_SHIFT_COUNT, mlp.width))
        activations = _antithetic_normal_lattice(n_samples, generator, shifts)
        input_second = fnp.mean(activations * activations)
        input_second = fnp.maximum(input_second, 1e-30)
        activations = activations / (
            fnp.sqrt(input_second) * fnp.sqrt(fnp.sqrt(input_second))
        )

        rows = []
        first_activations = None
        first_exact_mean = None
        first_sample_mean = None
        for layer_index, weight in enumerate(mlp.weights):
            activations = fnp.maximum(activations @ weight, 0.0)
            if layer_index == 0:
                exact_mean = _exact_first_layer_mean(weight)
                first_sample_mean = fnp.mean(activations, axis=0)
                first_activations = activations
                first_exact_mean = exact_mean
                rows.append(exact_mean)
            elif layer_index == mlp.depth - 1:
                sampled_mean = fnp.mean(activations, axis=0)
                centered_first = first_activations - first_sample_mean
                first_variance = fnp.mean(centered_first * centered_first, axis=0)
                covariance = (centered_first.T @ activations) / float(n_samples)
                correction_weights = (
                    first_exact_mean - first_sample_mean
                ) / fnp.maximum(first_variance, 1e-30)
                correction = correction_weights @ covariance
                rows.append(sampled_mean + _FIRST_CONTROL_SCALE * correction)
            else:
                rows.append(fnp.mean(activations, axis=0))
        return fnp.stack(rows, axis=0)


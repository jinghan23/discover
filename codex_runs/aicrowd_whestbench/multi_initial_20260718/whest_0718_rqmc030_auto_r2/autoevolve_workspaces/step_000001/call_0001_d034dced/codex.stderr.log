"""Antithetic RQMC estimator with a first-layer control variate.

Public method description:
https://discourse.aicrowd.com/t/unbiased-randomized-qmc-rao-blackwell-for-post-relu-activation-means-method-unbiasedness-proof-and-where-the-frontier-is/18053
"""

from __future__ import annotations

import flopscope as flops
import flopscope.numpy as fnp
from whestbench import BaseEstimator


_TARGET_FLOP_FRACTION = 0.40
_SHIFT_COUNT = 4
_FIRST_CONTROL_SCALE = 0.46
_TAIL_CLIP = 1e-8
_ARRAY_BYTES_LIMIT = 100 * 1024 * 1024
_FLOAT64_ITEMSIZE = 8


def _first_primes(count: int) -> tuple[int, ...]:
    primes: list[int] = []
    candidate = 2
    while len(primes) < count:
        is_prime = True
        for prime in primes:
            if prime * prime > candidate:
                break
            if candidate % prime == 0:
                is_prime = False
                break
        if is_prime:
            primes.append(candidate)
        candidate += 1
    return tuple(primes)


def _lattice_generator(width: int) -> fnp.ndarray:
    roots = fnp.sqrt(fnp.array(_first_primes(width), dtype=fnp.float64))
    return roots - fnp.floor(roots)


def _lattice_uniforms(
    n_samples: int, generator: fnp.ndarray, shift: fnp.ndarray
) -> fnp.ndarray:
    indices = fnp.arange(n_samples, dtype=fnp.float64)[:, None]
    unwrapped = indices * generator[None, :] + shift[None, :]
    return unwrapped - fnp.floor(unwrapped)


def _antithetic_normal_lattice(
    n_samples: int, generator: fnp.ndarray, shifts: fnp.ndarray
) -> fnp.ndarray:
    paired_count = n_samples // 2
    shift_count = int(shifts.shape[0])
    per_shift = (paired_count + shift_count - 1) // shift_count
    antithetic_blocks = []
    remaining = paired_count
    for shift_index in range(shift_count):
        block_count = min(per_shift, remaining)
        if block_count <= 0:
            break
        uniforms = _lattice_uniforms(block_count, generator, shifts[shift_index])
        uniforms = fnp.clip(uniforms, _TAIL_CLIP, 1.0 - _TAIL_CLIP)
        normals = fnp.asarray(flops.stats.norm.ppf(uniforms), dtype=fnp.float32)
        antithetic_blocks.append(fnp.concatenate([normals, -normals], axis=0))
        remaining -= block_count
    activations = fnp.concatenate(antithetic_blocks, axis=0)
    if n_samples % 2:
        activations = fnp.concatenate([activations, antithetic_blocks[0][:1]], axis=0)
    return activations


def _shiftwise_control_mean(
    activations: fnp.ndarray,
    first_activations: fnp.ndarray,
    first_exact_mean: fnp.ndarray,
    n_samples: int,
) -> fnp.ndarray:
    group_size = n_samples // _SHIFT_COUNT
    if group_size <= 0:
        return fnp.mean(activations, axis=0)
    estimates = []
    for shift_index in range(_SHIFT_COUNT):
        start = shift_index * group_size
        stop = start + group_size
        first_block = first_activations[start:stop]
        final_block = activations[start:stop]
        first_sample_mean = fnp.mean(first_block, axis=0)
        final_sample_mean = fnp.mean(final_block, axis=0)
        centered_first = first_block - first_sample_mean
        first_variance = fnp.mean(centered_first * centered_first, axis=0)
        covariance = (centered_first.T @ final_block) / float(group_size)
        correction_weights = (
            first_exact_mean - first_sample_mean
        ) / fnp.maximum(first_variance, 1e-30)
        estimates.append(
            final_sample_mean + _FIRST_CONTROL_SCALE * (correction_weights @ covariance)
        )
    return fnp.mean(fnp.stack(estimates, axis=0), axis=0)


def _trimmed_shift_mean(activations: fnp.ndarray, n_samples: int) -> fnp.ndarray:
    group_size = n_samples // _SHIFT_COUNT
    if _SHIFT_COUNT <= 2 or group_size <= 0:
        return fnp.mean(activations, axis=0)
    means = []
    for shift_index in range(_SHIFT_COUNT):
        start = shift_index * group_size
        means.append(fnp.mean(activations[start : start + group_size], axis=0))
    shift_means = fnp.stack(means, axis=0)
    return (
        fnp.sum(shift_means, axis=0)
        - fnp.min(shift_means, axis=0)
        - fnp.max(shift_means, axis=0)
    ) / float(_SHIFT_COUNT - 2)


def _antithetic_random_normals(n_samples: int, width: int, rng) -> fnp.ndarray:
    paired_count = n_samples // 2
    normals = rng.standard_normal((max(paired_count, 1), width), dtype=fnp.float32)
    activations = fnp.concatenate([normals[:paired_count], -normals[:paired_count]], axis=0)
    if n_samples % 2:
        activations = fnp.concatenate([activations, normals[:1]], axis=0)
    return activations


def _exact_first_layer_mean(first_weight: fnp.ndarray) -> fnp.ndarray:
    standard_deviation = fnp.sqrt(fnp.sum(first_weight * first_weight, axis=0))
    return standard_deviation / fnp.sqrt(2.0 * fnp.pi)


def _exact_first_layer_covariance(
    first_weight: fnp.ndarray, exact_mean: fnp.ndarray
) -> fnp.ndarray:
    weight64 = fnp.asarray(first_weight, dtype=fnp.float64)
    pre_covariance = weight64.T @ weight64
    pre_variance = fnp.maximum(fnp.diag(pre_covariance), 1e-30)
    pre_deviation = fnp.sqrt(pre_variance)
    normalizer = pre_deviation[:, None] * pre_deviation[None, :]
    correlation = fnp.clip(pre_covariance / normalizer, -1.0, 1.0)
    angle = fnp.arccos(correlation)
    second_moment = normalizer * (
        fnp.sin(angle) + (fnp.pi - angle) * correlation
    ) / (2.0 * fnp.pi)
    return second_moment - exact_mean[:, None] * exact_mean[None, :]


def _relu_gaussian_moments(mean: fnp.ndarray, variance: fnp.ndarray):
    variance = fnp.maximum(variance, 1e-30)
    standard_deviation = fnp.sqrt(variance)
    alpha = mean / standard_deviation
    density = flops.stats.norm.pdf(alpha)
    distribution = flops.stats.norm.cdf(alpha)
    relu_mean = standard_deviation * density + mean * distribution
    second_moment = (variance + mean * mean) * distribution + mean * standard_deviation * density
    relu_variance = fnp.maximum(second_moment - relu_mean * relu_mean, 0.0)
    return relu_mean, relu_variance


def _diagonal_moment_estimate(mlp) -> fnp.ndarray:
    mean = fnp.zeros(mlp.width, dtype=fnp.float64)
    variance = fnp.ones(mlp.width, dtype=fnp.float64)
    rows = []
    for weight in mlp.weights:
        weight64 = fnp.asarray(weight, dtype=fnp.float64)
        pre_mean = mean @ weight64
        pre_variance = variance @ (weight64 * weight64)
        mean, variance = _relu_gaussian_moments(pre_mean, pre_variance)
        rows.append(mean)
    return fnp.stack(rows, axis=0)


def _sample_count(budget: int, width: int, depth: int) -> int:
    # Each row pays for the lattice construction and inverse-normal map, every
    # layer's matmul/ReLU, and sampled means for rows 1..depth-1. The first row
    # uses the exact Gaussian ReLU mean instead.
    lattice_per_sample = 89 * width
    forward_per_sample = depth * (2 * width * width + width)
    later_means_per_sample = max(depth - 1, 0) * width
    per_sample = lattice_per_sample + forward_per_sample + later_means_per_sample

    # Fixed work is tiny relative to the forward pass; reserve it explicitly
    # so the phase-1 count remains under the requested tracked-FLOP fraction.
    fixed = 2 * width * width + 8 * width
    n_samples = (int(_TARGET_FLOP_FRACTION * budget) - fixed) // per_sample
    max_samples_by_bytes = _ARRAY_BYTES_LIMIT // max(width * _FLOAT64_ITEMSIZE, 1)
    n_samples = int(max(1, min(n_samples, max_samples_by_bytes)))
    block_size = max(2 * _SHIFT_COUNT, 1)
    return max(1, (n_samples // block_size) * block_size)


class Estimator(BaseEstimator):
    """Four-shift antithetic lattice estimator with first-layer control."""

    def predict(self, mlp, budget):
        n_samples = _sample_count(budget, mlp.width, mlp.depth)
        rng = fnp.random.default_rng(mlp.seed)
        generator = _lattice_generator(mlp.width)
        shifts = rng.random((_SHIFT_COUNT, mlp.width))
        activations = _antithetic_normal_lattice(n_samples, generator, shifts)

        rows = []
        first_activations = None
        first_exact_mean = None
        first_sample_mean = None
        for layer_index, weight in enumerate(mlp.weights):
            activations = fnp.maximum(activations @ weight, 0.0)
            if layer_index == 0:
                exact_mean = _exact_first_layer_mean(weight)
                first_sample_mean = fnp.mean(activations, axis=0)
                first_activations = activations
                first_exact_mean = exact_mean
                rows.append(exact_mean)
            elif layer_index == mlp.depth - 1:
                sampled_mean = fnp.mean(activations, axis=0)
                centered_first = first_activations - first_sample_mean
                first_variance = fnp.mean(centered_first * centered_first, axis=0)
                covariance = (centered_first.T @ activations) / float(n_samples)
                correction_weights = (
                    first_exact_mean - first_sample_mean
                ) / fnp.maximum(first_variance, 1e-30)
                correction = correction_weights @ covariance
                rows.append(sampled_mean + _FIRST_CONTROL_SCALE * correction)
            else:
                rows.append(fnp.mean(activations, axis=0))
        return fnp.stack(rows, axis=0)


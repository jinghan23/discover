     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _exact_first_layer_cross(first_weight: fnp.ndarray) -> fnp.ndarray:
+    gram = first_weight.T @ first_weight
+    diagonal = fnp.maximum(fnp.diag(gram), 1e-30)
+    standard_deviation = fnp.sqrt(diagonal)
+    scale = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = gram / scale
+    correlation = fnp.clip(correlation, -1.0, 1.0)
+    root = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    angle = fnp.arccos(correlation)
+    return scale * (root + (fnp.pi - angle) * correlation) / (2.0 * fnp.pi)
+
+

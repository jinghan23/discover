     return standard_deviation / fnp.sqrt(2.0 * fnp.pi)
 
 
+def _exact_first_layer_second(first_weight: fnp.ndarray) -> fnp.ndarray:
+    return 0.5 * fnp.sum(first_weight * first_weight, axis=0)
+
+
+def _relu_diag_step(
+    mean: fnp.ndarray, second: fnp.ndarray, weight: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    pre_mean = mean @ weight
+    variance = (second - mean * mean) @ (weight * weight)
+    variance = fnp.maximum(variance, 1e-30)
+    deviation = fnp.sqrt(variance)
+    alpha = pre_mean / deviation
+    cdf = flops.stats.norm.cdf(alpha)
+    pdf = flops.stats.norm.pdf(alpha)
+    next_mean = deviation * pdf + pre_mean * cdf
+    next_second = (variance + pre_mean * pre_mean) * cdf + pre_mean * deviation * pdf
+    return next_mean, next_second
+
+

+def _exact_first_layer_covariance(
+    first_weight: fnp.ndarray, exact_mean: fnp.ndarray
+) -> fnp.ndarray:
+    pre_covariance = first_weight.T @ first_weight
+    standard_deviation = fnp.sqrt(fnp.maximum(fnp.diag(pre_covariance), 1e-30))
+    scale = standard_deviation[:, None] * standard_deviation[None, :]
+    correlation = fnp.clip(pre_covariance / fnp.maximum(scale, 1e-30), -1.0, 1.0)
+    root_term = fnp.sqrt(fnp.maximum(1.0 - correlation * correlation, 0.0))
+    angle = fnp.arccos(correlation)
+    second = scale * (root_term + (fnp.pi - angle) * correlation) / (2.0 * fnp.pi)
+    covariance = second - exact_mean[:, None] * exact_mean[None, :]
+    diagonal = fnp.maximum(fnp.diag(covariance), 1e-30)
+    return covariance + _FULL_CONTROL_RIDGE * fnp.diag(diagonal)
+
+
+def _relu_normal_moments(
+    mean: fnp.ndarray, variance: fnp.ndarray
+) -> tuple[fnp.ndarray, fnp.ndarray]:
+    variance = fnp.maximum(variance, 1e-30)
+    standard_deviation = fnp.sqrt(variance)
+    standardized_mean = mean / standard_deviation
+    cdf = flops.stats.norm.cdf(standardized_mean)
+    pdf = flops.stats.norm.pdf(standardized_mean)
+    relu_mean = standard_deviation * pdf + mean * cdf
+    second = (variance + mean * mean) * cdf + mean * standard_deviation * pdf
+    return relu_mean, fnp.maximum(second - relu_mean * relu_mean, 1e-30)
+
+

+def _zero_mean_relu_moment_and_cov(cov_pre: fnp.ndarray) -> tuple[fnp.ndarray, fnp.ndarray]:
+    diag_pre = fnp.maximum(fnp.diag(cov_pre), 1e-30)
+    std = fnp.sqrt(diag_pre)
+    mean = std * _INV_SQRT_2PI
+    std_outer = std[:, None] * std[None, :]
+    corr = fnp.clip(cov_pre / fnp.maximum(std_outer, 1e-30), -1.0, 1.0)
+    root_term = fnp.sqrt(fnp.maximum(1.0 - corr * corr, 0.0))
+    second = std_outer * (root_term + (_PI - fnp.arccos(corr)) * corr) * _INV_2PI
+    covariance = second - mean[:, None] * mean[None, :]
+    return fnp.asarray(mean, dtype=fnp.float32), fnp.asarray(covariance, dtype=fnp.float32)
+
+
+def _linearized_full_moments(mlp) -> fnp.ndarray:
+    width = int(mlp.width)
+    mu = fnp.zeros(width, dtype=fnp.float32)
+    covariance = fnp.eye(width, dtype=fnp.float32)
+    eye = fnp.eye(width, dtype=fnp.float32)
+    offdiag_mask = 1.0 - eye
+    rows = []
+

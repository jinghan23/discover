"""
TriMul outgoing forward using fused Triton LayerNorm/gating kernels plus dense
CUDA GEMMs. For the large B=1 cases, projections are written directly in
channel-major order so gated left/right activations can feed batched GEMM
without an extra transpose buffer.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None
_MM_OUT_DTYPE_WITH_OUT_OK = None
_MM_F_OUT_OK = None


@triton.jit
def _layernorm_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                           BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    row_ok = rows < M
    d_ok = ds < D
    mask = row_ok[:, None] & d_ok[None, :]

    vals = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    vals = tl.where(d_ok[None, :], vals, 0.0)
    mean = tl.sum(vals, axis=1) / D
    centered = tl.where(d_ok[None, :], vals - mean[:, None], 0.0)
    var = tl.sum(centered * centered, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=d_ok, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=d_ok, other=0.0).to(tl.float32)
    out = centered * inv[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + rows[:, None] * D + ds[None, :], out, mask=mask)


@triton.jit
def _gate_cm_nomask_kernel(proj, TOTAL: tl.constexpr, NN: tl.constexpr, H: tl.constexpr,
                           BLOCK: tl.constexpr):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    ok = offs < TOTAL
    h = offs // NN
    pair = offs - h * NN

    left_p = h * NN + pair
    right_p = (H + h) * NN + pair
    lg_p = (2 * H + h) * NN + pair
    rg_p = (3 * H + h) * NN + pair

    left = tl.load(proj + left_p, mask=ok, other=0.0).to(tl.float32)
    right = tl.load(proj + right_p, mask=ok, other=0.0).to(tl.float32)
    lg = tl.load(proj + lg_p, mask=ok, other=0.0).to(tl.float32)
    rg = tl.load(proj + rg_p, mask=ok, other=0.0).to(tl.float32)

    tl.store(proj + left_p, left * tl.sigmoid(lg), mask=ok)
    tl.store(proj + right_p, right * tl.sigmoid(rg), mask=ok)


@triton.jit
def _gate_cm_mask_kernel(proj, mask_ptr, TOTAL: tl.constexpr, NN: tl.constexpr, H: tl.constexpr,
                         BLOCK: tl.constexpr):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    ok = offs < TOTAL
    h = offs // NN
    pair = offs - h * NN
    mv = tl.load(mask_ptr + pair, mask=ok, other=0.0).to(tl.float32)

    left_p = h * NN + pair
    right_p = (H + h) * NN + pair
    lg_p = (2 * H + h) * NN + pair
    rg_p = (3 * H + h) * NN + pair

    left = tl.load(proj + left_p, mask=ok, other=0.0).to(tl.float32)
    right = tl.load(proj + right_p, mask=ok, other=0.0).to(tl.float32)
    lg = tl.load(proj + lg_p, mask=ok, other=0.0).to(tl.float32)
    rg = tl.load(proj + rg_p, mask=ok, other=0.0).to(tl.float32)

    tl.store(proj + left_p, left * mv * tl.sigmoid(lg), mask=ok)
    tl.store(proj + right_p, right * mv * tl.sigmoid(rg), mask=ok)


@triton.jit
def _prep_nomask_kernel(proj, left_out, right_out, M: tl.constexpr, N: tl.constexpr,
                        H: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn
    base = rows[:, None] * (5 * H) + hs[None, :]
    out_ptrs = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    out_mask = h_ok[:, None] & row_ok[None, :]

    left = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left_out + out_ptrs, tl.trans(left * tl.sigmoid(lg)), mask=out_mask)
    tl.store(right_out + out_ptrs, tl.trans(right * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _prep_mask_kernel(proj, mask_ptr, left_out, right_out, M: tl.constexpr, N: tl.constexpr,
                      H: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn
    mv = tl.load(mask_ptr + rows, mask=row_ok, other=0.0).to(tl.float32)
    base = rows[:, None] * (5 * H) + hs[None, :]
    out_ptrs = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    out_mask = h_ok[:, None] & row_ok[None, :]

    left = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left_out + out_ptrs, tl.trans(left * mv[:, None] * tl.sigmoid(lg)), mask=out_mask)
    tl.store(right_out + out_ptrs, tl.trans(right * mv[:, None] * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _post_norm_gate_kernel(tri, proj, norm_w, norm_b, tmp, M: tl.constexpr, N: tl.constexpr,
                           H: tl.constexpr, EPS: tl.constexpr, BLOCK_M: tl.constexpr,
                           BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    row_ok = rows < M
    h_ok = hs < H

    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn

    tri_ptrs = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(tri_ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    centered = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(centered * centered, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bias = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)
    valid = row_ok[:, None] & h_ok[None, :]
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.0).to(tl.float32)

    y = (centered * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


@triton.jit
def _post_norm_gate_cm_kernel(tri, gate_cm, norm_w, norm_b, tmp, M: tl.constexpr,
                              N: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
                              BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    row_ok = rows < M
    h_ok = hs < H
    nn: tl.constexpr = N * N
    pair = rows

    ptrs = hs[:, None] * nn + pair[None, :]
    load_mask = h_ok[:, None] & row_ok[None, :]
    x = tl.trans(tl.load(tri + ptrs, mask=load_mask, other=0.0).to(tl.float32))
    gate = tl.trans(tl.load(gate_cm + ptrs, mask=load_mask, other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    centered = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(centered * centered, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bias = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)
    valid = row_ok[:, None] & h_ok[None, :]
    y = (centered * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


def _tensor_key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1, getattr(t, "_version", 0))


def _get_buffer(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    buf = _BUFFER_CACHE.get(key)
    if buf is None:
        buf = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = buf
    return buf


def _get_packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight",
             "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (src, torch.cat(src, dim=0).to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _get_to_out_t(w, dtype):
    key = ("to_out_t", dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (w, w.to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _mm_to_f_order(a, b, out):
    global _MM_F_OUT_OK
    if _MM_F_OUT_OK is True:
        torch.mm(a, b, out=out)
        return True
    if _MM_F_OUT_OK is None:
        try:
            torch.mm(a, b, out=out)
            _MM_F_OUT_OK = True
            return True
        except (TypeError, RuntimeError):
            _MM_F_OUT_OK = False
    return False


def _mm_half_to_float(a, b, out=None):
    global _MM_OUT_DTYPE_OK, _MM_OUT_DTYPE_WITH_OUT_OK
    if out is not None:
        if _MM_OUT_DTYPE_WITH_OUT_OK is True:
            torch.mm(a, b, out=out, out_dtype=torch.float32)
            return out
        if _MM_OUT_DTYPE_WITH_OUT_OK is None:
            try:
                torch.mm(a, b, out=out, out_dtype=torch.float32)
                _MM_OUT_DTYPE_WITH_OUT_OK = True
                return out
            except (TypeError, RuntimeError):
                _MM_OUT_DTYPE_WITH_OUT_OK = False

    if _MM_OUT_DTYPE_OK is True:
        return torch.mm(a, b, out_dtype=torch.float32)
    if _MM_OUT_DTYPE_OK is None:
        try:
            res = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return res
        except (TypeError, RuntimeError):
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        NN = N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()
        xh = _get_buffer("x_norm_h", (M, D), device, half)

        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else (4 if D <= 384 else 2)
        _layernorm_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps, BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        packed_proj_t = _get_packed_proj_t(weights, half)
        has_mask = mask is not None and not bool(config.get("nomask", False))

        if B == 1:
            proj_cm = _get_buffer("proj_cm_b1", (5 * H, N, N), device, half)
            proj_view = proj_cm.reshape(5 * H, NN).t()
            if _mm_to_f_order(xh, packed_proj_t, proj_view):
                total = H * NN
                block_gate = 1024
                if has_mask:
                    mask_flat = mask.reshape(NN).contiguous()
                    _gate_cm_mask_kernel[(triton.cdiv(total, block_gate),)](
                        proj_cm, mask_flat, total, NN, H, BLOCK=block_gate, num_warps=4,
                    )
                else:
                    _gate_cm_nomask_kernel[(triton.cdiv(total, block_gate),)](
                        proj_cm, total, NN, H, BLOCK=block_gate, num_warps=4,
                    )

                left = proj_cm[:H].reshape(H, N, N)
                right = proj_cm[H:2 * H].reshape(H, N, N)
                tri = _get_buffer("tri_b1", (H, N, N), device, half)
                torch.bmm(left, right.transpose(1, 2), out=tri)

                tmp = xh if D == H else _get_buffer("tmp", (M, H), device, half)
                bm_post = 16
                bh_post = triton.next_power_of_2(H)
                _post_norm_gate_cm_kernel[(triton.cdiv(M, bm_post),)](
                    tri, proj_cm[4 * H:5 * H], weights["to_out_norm.weight"],
                    weights["to_out_norm.bias"], tmp, M, N, H, eps,
                    BLOCK_M=bm_post, BLOCK_H=bh_post, num_warps=8,
                )

                to_out_t = _get_to_out_t(weights["to_out.weight"], half)
                out_buf = _get_buffer("out_f32", (M, D), device, torch.float32)
                out = _mm_half_to_float(tmp, to_out_t, out_buf)
                return out.reshape(B, N, N, D)

        proj = _get_buffer("proj", (M, 5 * H), device, half)
        torch.mm(xh, packed_proj_t, out=proj)

        left = _get_buffer("left", (B * H, N, N), device, half)
        right = _get_buffer("right", (B * H, N, N), device, half)

        bm_prep = 16
        bh_prep = 64
        if has_mask:
            mask_flat = mask.reshape(M).contiguous()
            _prep_mask_kernel[(triton.cdiv(M, bm_prep), triton.cdiv(H, bh_prep))](
                proj, mask_flat, left, right, M, N, H,
                BLOCK_M=bm_prep, BLOCK_H=bh_prep, num_warps=4,
            )
        else:
            _prep_nomask_kernel[(triton.cdiv(M, bm_prep), triton.cdiv(H, bh_prep))](
                proj, left, right, M, N, H,
                BLOCK_M=bm_prep, BLOCK_H=bh_prep, num_warps=4,
            )

        tri = _get_buffer("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = xh if D == H else _get_buffer("tmp", (M, H), device, half)
        bm_post = 16
        bh_post = triton.next_power_of_2(H)
        _post_norm_gate_kernel[(triton.cdiv(M, bm_post),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"],
            tmp, M, N, H, eps, BLOCK_M=bm_post, BLOCK_H=bh_post, num_warps=8,
        )

        to_out_t = _get_to_out_t(weights["to_out.weight"], half)
        out_buf = _get_buffer("out_f32", (M, D), device, torch.float32)
        out = _mm_half_to_float(tmp, to_out_t, out_buf)
        return out.reshape(B, N, N, D)
```

```python
"""
TriMul outgoing forward, optimized around the expensive N^3 contraction.

The code fuses both LayerNorm stages into Triton kernels, packs the five input
linear projections into one GEMM, stores gated left/right tensors in
channel-major layout for a fast strided batched GEMM, and fuses output
LayerNorm with the output gate before the final projection. Cached packed
weights and scratch buffers avoid repeated allocation and transpose overhead.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    mask = (rows[:, None] < M) & (ds[None, :] < D)

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    v = tl.where(ds[None, :] < D, v, 0.0)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(ds[None, :] < D, v - mean[:, None], 0.0)
    rstd = tl.rsqrt(tl.sum(c * c, axis=1) / D + EPS)

    ww = tl.load(w + ds, mask=ds < D, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.0).to(tl.float32)
    tl.store(y + rows[:, None] * D + ds[None, :],
             c * rstd[:, None] * ww[None, :] + bb[None, :], mask=mask)


@triton.jit
def _prep_kernel(proj, mask, left, right,
                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 HAS_MASK: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn

    p = rows[:, None] * (5 * H) + hs[None, :]
    o = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    om = h_ok[:, None] & row_ok[None, :]

    mv = 1.0
    if HAS_MASK:
        mv = tl.load(mask + rows, mask=row_ok, other=0.0).to(tl.float32)

    l = tl.load(proj + p, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + p + 2 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(left + o, tl.trans(l * mv[:, None] * tl.sigmoid(lg)), mask=om)

    r = tl.load(proj + p + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + p + 3 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(right + o, tl.trans(r * mv[:, None] * tl.sigmoid(rg)), mask=om)


@triton.jit
def _post_kernel(tri, proj, nw, nb, tmp,
                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
                 BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn

    tp = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(tp, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    c = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    rstd = tl.rsqrt(tl.sum(c * c, axis=1) / H + EPS)

    w = tl.load(nw + hs, mask=h_ok, other=0.0).to(tl.float32)
    bias = tl.load(nb + hs, mask=h_ok, other=0.0).to(tl.float32)

    valid = row_ok[:, None] & h_ok[None, :]
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.0).to(tl.float32)

    y = (c * rstd[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


def _tensor_key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1,
            getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index, dtype)
    out = _BUFFER_CACHE.get(key)
    if out is None:
        out = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = out
    return out


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight",
             "right_gate.weight", "out_gate.weight")
    key = ("proj", dtype) + tuple(_tensor_key(weights[n]) for n in names)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = torch.cat([weights[n] for n in names], dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _to_out_t(w, dtype):
    key = ("to_out", dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _mm(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _ln_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps, BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)
        has_mask = mask is not None and not bool(config.get("nomask", False))
        mask_flat = mask.reshape(M) if has_mask else proj

        _prep_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
            proj, mask_flat, left, right, M, N, H, has_mask,
            BLOCK_M=16, BLOCK_H=64, num_warps=4,
        )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), device, half)
        _post_kernel[(triton.cdiv(M, 16),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps, BLOCK_M=16, BLOCK_H=triton.next_power_of_2(H), num_warps=8,
        )

        out = _mm(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

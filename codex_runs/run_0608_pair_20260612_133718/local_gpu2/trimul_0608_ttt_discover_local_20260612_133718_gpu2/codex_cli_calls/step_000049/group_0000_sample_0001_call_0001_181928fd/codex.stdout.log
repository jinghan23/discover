```python
"""
TriMul outgoing forward using Triton for normalization, gating/repacking, and
post-processing, with cuBLAS tensor-core GEMMs for the large dense products.
The implementation keeps the N^3 triangular product in fp16 and returns fp32.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_FLAGS_SET = False
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln128_kernel(x, w, b, y, M: tl.constexpr, EPS: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, 128)
    ok = rows < M

    v = tl.load(x + rows[:, None] * 128 + ds[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) * 0.0078125
    c = v - mean[:, None]
    var = tl.sum(c * c, axis=1) * 0.0078125
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds).to(tl.float32)
    bb = tl.load(b + ds).to(tl.float32)
    tl.store(y + rows[:, None] * 128 + ds[None, :], c * inv[:, None] * ww[None, :] + bb[None, :], mask=ok[:, None])


@triton.jit
def _ln_kernel(
    x, w, b, y,
    M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    ok_r = rows < M
    ok_d = ds < D
    mask = ok_r[:, None] & ok_d[None, :]

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    v = tl.where(ok_d[None, :], v, 0.0)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(ok_d[None, :], v - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=ok_d, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=ok_d, other=0.0).to(tl.float32)
    tl.store(y + rows[:, None] * D + ds[None, :], c * inv[:, None] * ww[None, :] + bb[None, :], mask=mask)


@triton.jit
def _prep_nomask_kernel(
    proj, left, right,
    M: tl.constexpr, N: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    ok = rows < M

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    p = rows[:, None] * 640 + hs[None, :]
    o = bidx[None, :] * (128 * nn) + hs[:, None] * nn + pair[None, :]

    l = tl.load(proj + p, mask=ok[:, None], other=0.0).to(tl.float32)
    lg = tl.load(proj + p + 256, mask=ok[:, None], other=0.0).to(tl.float32)
    r = tl.load(proj + p + 128, mask=ok[:, None], other=0.0).to(tl.float32)
    rg = tl.load(proj + p + 384, mask=ok[:, None], other=0.0).to(tl.float32)

    tl.store(left + o, tl.trans(l * tl.sigmoid(lg)), mask=ok[None, :])
    tl.store(right + o, tl.trans(r * tl.sigmoid(rg)), mask=ok[None, :])


@triton.jit
def _prep_mask_kernel(
    proj, mask, left, right,
    M: tl.constexpr, N: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    ok = rows < M

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    p = rows[:, None] * 640 + hs[None, :]
    o = bidx[None, :] * (128 * nn) + hs[:, None] * nn + pair[None, :]
    mv = tl.load(mask + rows, mask=ok, other=0.0).to(tl.float32)

    l = tl.load(proj + p, mask=ok[:, None], other=0.0).to(tl.float32)
    lg = tl.load(proj + p + 256, mask=ok[:, None], other=0.0).to(tl.float32)
    r = tl.load(proj + p + 128, mask=ok[:, None], other=0.0).to(tl.float32)
    rg = tl.load(proj + p + 384, mask=ok[:, None], other=0.0).to(tl.float32)

    tl.store(left + o, tl.trans(l * mv[:, None] * tl.sigmoid(lg)), mask=ok[None, :])
    tl.store(right + o, tl.trans(r * mv[:, None] * tl.sigmoid(rg)), mask=ok[None, :])


@triton.jit
def _post_kernel(
    tri, proj, nw, nb, tmp,
    M: tl.constexpr, N: tl.constexpr, EPS: tl.constexpr,
    BLOCK_M: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, 128)
    ok = rows < M

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    ptrs = tri + bidx[None, :] * (128 * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) * 0.0078125
    c = x - mean[:, None]
    var = tl.sum(c * c, axis=1) * 0.0078125
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs).to(tl.float32)
    b = tl.load(nb + hs).to(tl.float32)
    g = tl.load(proj + rows[:, None] * 640 + 512 + hs[None, :], mask=ok[:, None], other=0.0).to(tl.float32)
    y = (c * inv[:, None] * w[None, :] + b[None, :]) * tl.sigmoid(g)
    tl.store(tmp + rows[:, None] * 128 + hs[None, :], y, mask=ok[:, None])


def _set_flags():
    global _FLAGS_SET
    if not _FLAGS_SET:
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _FLAGS_SET = True


def _key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype), t.device.index, getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    k = (name, tuple(shape), device.index, dtype)
    v = _BUFFER_CACHE.get(k)
    if v is None:
        v = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[k] = v
    return v


def _packed_proj_t(weights, dtype):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    src = tuple(weights[n] for n in names)
    k = ("proj", dtype) + tuple(_key(t) for t in src)
    v = _WEIGHT_CACHE.get(k)
    if v is None:
        v = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[k] = v
    return v


def _to_out_t(w, dtype):
    k = ("to_out", dtype, _key(w))
    v = _WEIGHT_CACHE.get(k)
    if v is None:
        v = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[k] = v
    return v


def _mm_f32(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            y = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return y
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        _set_flags()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        if D == 128:
            _ln128_kernel[(triton.cdiv(M, 8),)](
                x, weights["norm.weight"], weights["norm.bias"], xh,
                M, eps, BLOCK_M=8, num_warps=4,
            )
        else:
            _ln_kernel[(triton.cdiv(M, 4),)](
                x, weights["norm.weight"], weights["norm.bias"], xh,
                M, D, eps, BLOCK_M=4, BLOCK_D=triton.next_power_of_2(D),
                num_warps=8,
            )

        proj = _buf("proj", (M, 640), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * 128, N, N), device, half)
        right = _buf("right", (B * 128, N, N), device, half)
        grid = (triton.cdiv(M, 16), 2)

        has_mask = mask is not None and not bool(config.get("nomask", False))
        if has_mask:
            _prep_mask_kernel[grid](
                proj, mask.reshape(M).contiguous(), left, right,
                M, N, BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )
        else:
            _prep_nomask_kernel[grid](
                proj, left, right,
                M, N, BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )

        tri = _buf("tri", (B * 128, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = xh if D == 128 else _buf("tmp", (M, 128), device, half)
        _post_kernel[(triton.cdiv(M, 16),)](
            tri, proj,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            tmp, M, N, eps,
            BLOCK_M=16, num_warps=4,
        )

        out = _mm_f32(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

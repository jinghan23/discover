```python
"""
TriMul outgoing forward pass.

Uses Triton for the two LayerNorms and elementwise gate/mask packing, and uses
cuBLAS batched GEMM for the N^3 outgoing contraction. The five input projections
are packed into one GEMM and cached; left/right are stored channel-major so the
contraction is a strided batch of H independent N x N GEMMs. Final output is
returned as float32.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                    BM: tl.constexpr, BD: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BM + tl.arange(0, BM)
    ds = tl.arange(0, BD)
    m = (rows[:, None] < M) & (ds[None, :] < D)

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=m, other=0.).to(tl.float32)
    v = tl.where(ds[None, :] < D, v, 0.)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(ds[None, :] < D, v - mean[:, None], 0.)
    var = tl.sum(c * c, axis=1) / D
    r = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=ds < D, other=0.).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.).to(tl.float32)
    tl.store(y + rows[:, None] * D + ds[None, :],
             c * r[:, None] * ww[None, :] + bb[None, :], mask=m)


@triton.jit
def _prep_nomask_kernel(p, lout, rout, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                        BM: tl.constexpr, BH: tl.constexpr):
    pm = tl.program_id(0)
    ph = tl.program_id(1)
    rows = pm * BM + tl.arange(0, BM)
    hs = ph * BH + tl.arange(0, BH)
    ok = (rows[:, None] < M) & (hs[None, :] < H)

    NN: tl.constexpr = N * N
    b = rows // NN
    pair = rows - b * NN
    base = rows[:, None] * (5 * H) + hs[None, :]

    left = tl.load(p + base, mask=ok, other=0.).to(tl.float32)
    right = tl.load(p + base + H, mask=ok, other=0.).to(tl.float32)
    lg = tl.load(p + base + 2 * H, mask=ok, other=0.).to(tl.float32)
    rg = tl.load(p + base + 3 * H, mask=ok, other=0.).to(tl.float32)

    ptrs = b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    om = (hs[:, None] < H) & (rows[None, :] < M)
    tl.store(lout + ptrs, tl.trans(left * tl.sigmoid(lg)), mask=om)
    tl.store(rout + ptrs, tl.trans(right * tl.sigmoid(rg)), mask=om)


@triton.jit
def _prep_mask_kernel(p, mask, lout, rout, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                      BM: tl.constexpr, BH: tl.constexpr):
    pm = tl.program_id(0)
    ph = tl.program_id(1)
    rows = pm * BM + tl.arange(0, BM)
    hs = ph * BH + tl.arange(0, BH)
    ok = (rows[:, None] < M) & (hs[None, :] < H)

    NN: tl.constexpr = N * N
    b = rows // NN
    pair = rows - b * NN
    mv = tl.load(mask + rows, mask=rows < M, other=0.).to(tl.float32)
    base = rows[:, None] * (5 * H) + hs[None, :]

    left = tl.load(p + base, mask=ok, other=0.).to(tl.float32)
    right = tl.load(p + base + H, mask=ok, other=0.).to(tl.float32)
    lg = tl.load(p + base + 2 * H, mask=ok, other=0.).to(tl.float32)
    rg = tl.load(p + base + 3 * H, mask=ok, other=0.).to(tl.float32)

    ptrs = b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    om = (hs[:, None] < H) & (rows[None, :] < M)
    tl.store(lout + ptrs, tl.trans(left * mv[:, None] * tl.sigmoid(lg)), mask=om)
    tl.store(rout + ptrs, tl.trans(right * mv[:, None] * tl.sigmoid(rg)), mask=om)


@triton.jit
def _post_kernel(tri, proj, nw, nb, tmp, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 EPS: tl.constexpr, BM: tl.constexpr, BH: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BM + tl.arange(0, BM)
    hs = tl.arange(0, BH)
    NN: tl.constexpr = N * N

    b = rows // NN
    pair = rows - b * NN
    ptrs = b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    ht = tl.load(tri + ptrs, mask=(hs[:, None] < H) & (rows[None, :] < M), other=0.).to(tl.float32)
    x = tl.trans(ht)

    mean = tl.sum(x, axis=1) / H
    c = tl.where(hs[None, :] < H, x - mean[:, None], 0.)
    var = tl.sum(c * c, axis=1) / H
    r = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hs < H, other=0.).to(tl.float32)
    bb = tl.load(nb + hs, mask=hs < H, other=0.).to(tl.float32)
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.).to(tl.float32)

    y = (c * r[:, None] * w[None, :] + bb[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


def _key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1, getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    v = _BUFFER_CACHE.get(key)
    if v is None:
        v = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = v
    return v


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight",
             "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_key(x) for x in src)
    v = _WEIGHT_CACHE.get(key)
    if v is None:
        v = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = v
    return v


def _to_out_t(w, dtype):
    key = ("to_out_t", dtype, _key(w))
    v = _WEIGHT_CACHE.get(key)
    if v is None:
        v = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = v
    return v


def _mm32(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            y = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return y
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        dev = input_tensor.device
        half = torch.float16
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), dev, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _ln_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps, BM=bm_ln, BD=bd, num_warps=4 if D <= 128 else 8
        )

        proj = _buf("proj", (M, 5 * H), dev, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), dev, half)
        right = _buf("right", (B * H, N, N), dev, half)

        has_mask = mask is not None and not bool(config.get("nomask", False))
        if has_mask:
            _prep_mask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, mask.reshape(M).contiguous(), left, right,
                M, N, H, BM=16, BH=64, num_warps=4
            )
        else:
            _prep_nomask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, left, right, M, N, H, BM=16, BH=64, num_warps=4
            )

        tri = _buf("tri", (B * H, N, N), dev, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), dev, half)
        _post_kernel[(triton.cdiv(M, 16),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps, BM=16, BH=triton.next_power_of_2(H), num_warps=8
        )

        out = _mm32(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

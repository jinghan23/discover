```python
"""
Outgoing TriMul forward using cached workspaces.

The implementation fuses input LayerNorm into the five input projections, writes
left/right gated factors in channel-major layout, computes the triangle update as
B*H strided batched GEMMs, then fuses output LayerNorm, output gate, and final
projection in a tiled Triton kernel. Weights and temporary buffers are cached by
shape/version to avoid repeated allocations and transposes during benchmarking.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_BACKENDS_READY = False


@triton.jit
def _ln_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
               BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    mask = (rows[:, None] < M) & (ds[None, :] < D)

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    v = tl.where(ds[None, :] < D, v, 0.0)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(ds[None, :] < D, v - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=ds < D, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.0).to(tl.float32)
    out = c * inv[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + rows[:, None] * D + ds[None, :], out, mask=mask)


@triton.jit
def _prep_nomask(proj, left, right, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    base = proj + rows[:, None] * (5 * H) + hs[None, :]
    outp = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    om = (hs[:, None] < H) & (rows[None, :] < M)

    l = tl.load(base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(base + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left + outp, tl.trans(l * tl.sigmoid(lg)), mask=om)
    tl.store(right + outp, tl.trans(r * tl.sigmoid(rg)), mask=om)


@triton.jit
def _prep_mask(proj, mask, left, right, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
               BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    base = proj + rows[:, None] * (5 * H) + hs[None, :]
    outp = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    om = (hs[:, None] < H) & (rows[None, :] < M)
    mv = tl.load(mask + rows, mask=rows < M, other=0.0).to(tl.float32)

    l = tl.load(base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(base + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left + outp, tl.trans(l * mv[:, None] * tl.sigmoid(lg)), mask=om)
    tl.store(right + outp, tl.trans(r * mv[:, None] * tl.sigmoid(rg)), mask=om)


@triton.jit
def _post_project_kernel(tri, proj, nw, nb, tow, out,
                         M: tl.constexpr, N: tl.constexpr, H: tl.constexpr, D: tl.constexpr,
                         EPS: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
                         BLOCK_D: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_d = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    ds = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    tri_ptrs = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    t = tl.load(tri_ptrs, mask=(hs[:, None] < H) & (rows[None, :] < M), other=0.0).to(tl.float32)
    x = tl.trans(t)

    mean = tl.sum(x, axis=1) / H
    c = tl.where(hs[None, :] < H, x - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hs < H, other=0.0).to(tl.float32)
    bias = tl.load(nb + hs, mask=hs < H, other=0.0).to(tl.float32)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=(rows[:, None] < M) & (hs[None, :] < H), other=0.0).to(tl.float32)
    y = (c * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)

    tw = tl.load(tow + hs[:, None] * D + ds[None, :],
                 mask=(hs[:, None] < H) & (ds[None, :] < D), other=0.0).to(tl.float32)
    acc = tl.dot(y.to(tl.float16), tw.to(tl.float16), out_dtype=tl.float32)
    tl.store(out + rows[:, None] * D + ds[None, :],
             acc, mask=(rows[:, None] < M) & (ds[None, :] < D))


def _ensure_backends():
    global _BACKENDS_READY
    if not _BACKENDS_READY:
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _BACKENDS_READY = True


def _tensor_key(t):
    return (
        t.data_ptr(),
        tuple(t.shape),
        tuple(t.stride()),
        str(t.dtype),
        t.device.index if t.device.type == "cuda" else -1,
        getattr(t, "_version", 0),
    )


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    v = _BUFFER_CACHE.get(key)
    if v is None:
        v = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = v
    return v


def _packed_proj_t(weights, dtype):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _to_out_t(weights, dtype):
    w = weights["to_out.weight"]
    key = ("to_out_t", dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        _ensure_backends()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _ln_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps, BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)
        has_mask = mask is not None and not bool(config.get("nomask", False))
        grid_prep = (triton.cdiv(M, 16), triton.cdiv(H, 64))

        if has_mask:
            mf = mask.reshape(M).contiguous()
            _prep_mask[grid_prep](
                proj, mf, left, right, M, N, H,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )
        else:
            _prep_nomask[grid_prep](
                proj, left, right, M, N, H,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        out = _buf("out", (M, D), device, torch.float32)
        bd_out = 64 if D <= 128 else 128
        _post_project_kernel[(triton.cdiv(M, 16), triton.cdiv(D, bd_out))](
            tri, proj,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"],
            _to_out_t(weights, half), out,
            M, N, H, D, eps,
            BLOCK_M=16, BLOCK_H=128, BLOCK_D=bd_out,
            num_warps=8,
        )

        return out.reshape(B, N, N, D)
```

```python
"""
TriMul outgoing forward using Triton for layer norms, gating/layout epilogues,
and a fused D=128 final norm/gate/output projection. The two dominant dense
contractions use Ampere tensor-core GEMMs: packed input projection and the
per-channel N x N triangular multiplication.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_BACKENDS_READY = False
_MM_OUT_DTYPE_OK = None


@triton.jit
def _layernorm_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                           BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    ok = (rows[:, None] < M) & (ds[None, :] < D)

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=ok, other=0.).to(tl.float32)
    v = tl.where(ds[None, :] < D, v, 0.)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(ds[None, :] < D, v - mean[:, None], 0.)
    var = tl.sum(c * c, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=ds < D, other=0.).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.).to(tl.float32)
    tl.store(y + rows[:, None] * D + ds[None, :],
             c * inv[:, None] * ww[None, :] + bb[None, :], mask=ok)


@triton.jit
def _prep_nomask_kernel(proj, left, right, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                        BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pm = tl.program_id(0)
    ph = tl.program_id(1)
    rows = pm * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = ph * BLOCK_H + tl.arange(0, BLOCK_H)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    base = rows[:, None] * (5 * H) + hs[None, :]

    dst = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    dmask = (hs[:, None] < H) & (rows[None, :] < M)

    l = tl.load(proj + base, mask=valid, other=0.).to(tl.float32)
    r = tl.load(proj + base + H, mask=valid, other=0.).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.).to(tl.float32)

    tl.store(left + dst, tl.trans(l * tl.sigmoid(lg)), mask=dmask)
    tl.store(right + dst, tl.trans(r * tl.sigmoid(rg)), mask=dmask)


@triton.jit
def _prep_mask_kernel(proj, mask, left, right, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                      BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pm = tl.program_id(0)
    ph = tl.program_id(1)
    rows = pm * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = ph * BLOCK_H + tl.arange(0, BLOCK_H)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    base = rows[:, None] * (5 * H) + hs[None, :]

    mv = tl.load(mask + rows, mask=rows < M, other=0.).to(tl.float32)
    dst = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    dmask = (hs[:, None] < H) & (rows[None, :] < M)

    l = tl.load(proj + base, mask=valid, other=0.).to(tl.float32)
    r = tl.load(proj + base + H, mask=valid, other=0.).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.).to(tl.float32)

    tl.store(left + dst, tl.trans(l * mv[:, None] * tl.sigmoid(lg)), mask=dmask)
    tl.store(right + dst, tl.trans(r * mv[:, None] * tl.sigmoid(rg)), mask=dmask)


@triton.jit
def _post_norm_gate_kernel(tri, proj, nw, nb, tmp, M: tl.constexpr, N: tl.constexpr,
                           H: tl.constexpr, EPS: tl.constexpr, BLOCK_M: tl.constexpr,
                           BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    ptrs = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=(hs[:, None] < H) & (rows[None, :] < M),
                         other=0.).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    c = tl.where(hs[None, :] < H, x - mean[:, None], 0.)
    var = tl.sum(c * c, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hs < H, other=0.).to(tl.float32)
    bias = tl.load(nb + hs, mask=hs < H, other=0.).to(tl.float32)
    valid = (rows[:, None] < M) & (hs[None, :] < H)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.).to(tl.float32)

    y = (c * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


@triton.jit
def _post_gate_out_kernel(tri, proj, nw, nb, wout_t, out,
                          M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                          D: tl.constexpr, EPS: tl.constexpr,
                          BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
                          BLOCK_D: tl.constexpr):
    pm = tl.program_id(0)
    pd = tl.program_id(1)
    rows = pm * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    ds = pd * BLOCK_D + tl.arange(0, BLOCK_D)
    nn: tl.constexpr = N * N

    b = rows // nn
    pair = rows - b * nn
    rmask = rows < M
    hmask = hs < H

    tri_ptrs = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(tri_ptrs, mask=hmask[:, None] & rmask[None, :],
                         other=0.).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    c = tl.where(hmask[None, :], x - mean[:, None], 0.)
    var = tl.sum(c * c, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hmask, other=0.).to(tl.float32)
    bias = tl.load(nb + hs, mask=hmask, other=0.).to(tl.float32)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=rmask[:, None] & hmask[None, :], other=0.).to(tl.float32)

    y = (c * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    wt = tl.load(wout_t + hs[:, None] * D + ds[None, :],
                 mask=hmask[:, None] & (ds[None, :] < D), other=0.).to(tl.float16)

    acc = tl.dot(y.to(tl.float16), wt)
    tl.store(out + rows[:, None] * D + ds[None, :], acc,
             mask=rmask[:, None] & (ds[None, :] < D))


def _init_backends():
    global _BACKENDS_READY
    if not _BACKENDS_READY:
        torch.backends.cuda.matmul.allow_tf32 = True
        try:
            torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        except Exception:
            pass
        try:
            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
        except Exception:
            pass
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _BACKENDS_READY = True


def _tensor_key(t):
    try:
        v = t._version
    except Exception:
        v = 0
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1, v)


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    out = _BUFFER_CACHE.get(key)
    if out is None:
        out = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = out
    return out


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight",
             "left_gate.weight", "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(t) for t in src)
    val = _WEIGHT_CACHE.get(key)
    if val is None:
        val = (src, torch.cat(src, dim=0).to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = val
    return val[1]


def _to_out_t(w, dtype):
    key = ("to_out_t", dtype, _tensor_key(w))
    val = _WEIGHT_CACHE.get(key)
    if val is None:
        val = (w, w.to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = val
    return val[1]


def _mm_half_to_float(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            y = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return y
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    with torch.no_grad():
        _init_backends()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()
        xh = _buf("x_norm_h", (M, D), device, half)

        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _layernorm_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh, M, D, eps,
            BLOCK_M=bm_ln, BLOCK_D=bd, num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)

        if mask is not None and not bool(config.get("nomask", False)):
            mf = mask.reshape(M).contiguous()
            _prep_mask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, mf, left, right, M, N, H,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )
        else:
            _prep_nomask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, left, right, M, N, H,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        if D == 128:
            out = torch.empty((M, D), device=device, dtype=torch.float32)
            _post_gate_out_kernel[(triton.cdiv(M, 16), triton.cdiv(D, 128))](
                tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"],
                _to_out_t(weights["to_out.weight"], half), out,
                M, N, H, D, eps,
                BLOCK_M=16, BLOCK_H=triton.next_power_of_2(H), BLOCK_D=128,
                num_warps=8,
            )
            return out.reshape(B, N, N, D)

        tmp = _buf("tmp", (M, H), device, half)
        _post_norm_gate_kernel[(triton.cdiv(M, 16),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps,
            BLOCK_M=16, BLOCK_H=triton.next_power_of_2(H), num_warps=8,
        )

        out = _mm_half_to_float(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

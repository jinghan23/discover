```python
"""
TriMul outgoing forward.

LayerNorm/projection prep/post-gate are fused with Triton kernels, while the
N^3 triangular contraction and dense output projections use cuBLAS tensor cores.
Intermediate left/right tensors are stored as [B*H, N, N] so the outgoing
einsum becomes a strided batched GEMM over each hidden channel.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln128_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr):
    pid = tl.program_id(0)
    ds = tl.arange(0, 128)
    mask = ds < D

    vals = tl.load(x + pid * D + ds, mask=mask, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / D
    c = tl.where(mask, vals - mean, 0.0)
    var = tl.sum(c * c, axis=0) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=mask, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=mask, other=0.0).to(tl.float32)
    tl.store(y + pid * D + ds, c * inv * ww + bb, mask=mask)


@triton.jit
def _ln384_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr):
    pid = tl.program_id(0)
    ds = tl.arange(0, 512)
    mask = ds < D

    vals = tl.load(x + pid * D + ds, mask=mask, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / D
    c = tl.where(mask, vals - mean, 0.0)
    var = tl.sum(c * c, axis=0) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=mask, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=mask, other=0.0).to(tl.float32)
    tl.store(y + pid * D + ds, c * inv * ww + bb, mask=mask)


@triton.jit
def _prep_nomask_kernel(proj, left_out, right_out, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * 16 + tl.arange(0, 16)
    hs = pid_h * 64 + tl.arange(0, 64)
    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    p = proj + rows[:, None] * (5 * H) + hs[None, :]
    o = bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    om = h_ok[:, None] & row_ok[None, :]

    l = tl.load(p, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(p + 2 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(left_out + o, tl.trans(l * tl.sigmoid(lg)), mask=om)

    r = tl.load(p + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(p + 3 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(right_out + o, tl.trans(r * tl.sigmoid(rg)), mask=om)


@triton.jit
def _prep_mask_kernel(proj, mask, left_out, right_out, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * 16 + tl.arange(0, 16)
    hs = pid_h * 64 + tl.arange(0, 64)
    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    p = proj + rows[:, None] * (5 * H) + hs[None, :]
    o = bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    om = h_ok[:, None] & row_ok[None, :]

    mv = tl.load(mask + rows, mask=row_ok, other=0.0).to(tl.float32)

    l = tl.load(p, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(p + 2 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(left_out + o, tl.trans(l * mv[:, None] * tl.sigmoid(lg)), mask=om)

    r = tl.load(p + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(p + 3 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(right_out + o, tl.trans(r * mv[:, None] * tl.sigmoid(rg)), mask=om)


@triton.jit
def _post_norm_gate_kernel(tri, proj, nw, nb, tmp, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * 16 + tl.arange(0, 16)
    hs = tl.arange(0, 128)
    row_ok = rows < M

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    ptrs = tri + bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    c = x - mean[:, None]
    var = tl.sum(c * c, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs).to(tl.float32)
    b = tl.load(nb + hs).to(tl.float32)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :], mask=row_ok[:, None], other=0.0).to(tl.float32)
    y = (c * inv[:, None] * w[None, :] + b[None, :]) * tl.sigmoid(gate)

    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=row_ok[:, None])


def _tensor_key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype), t.device.index, getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index, dtype)
    out = _BUFFER_CACHE.get(key)
    if out is None:
        out = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = out
    return out


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight", "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _to_out_t(w, dtype):
    key = ("to_out_t", dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _mm_f32(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()
        xh = _buf("x_norm_h", (M, D), device, half)

        if D <= 128:
            _ln128_cast_kernel[(M,)](x, weights["norm.weight"], weights["norm.bias"], xh, M, D, eps, num_warps=4)
        else:
            _ln384_cast_kernel[(M,)](x, weights["norm.weight"], weights["norm.bias"], xh, M, D, eps, num_warps=8)

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)

        has_mask = mask is not None and not bool(config.get("nomask", False))
        if has_mask:
            mf = mask.reshape(M).contiguous()
            _prep_mask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](proj, mf, left, right, M, N, H, num_warps=4)
        else:
            _prep_nomask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](proj, left, right, M, N, H, num_warps=4)

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), device, half)
        _post_norm_gate_kernel[(triton.cdiv(M, 16),)](
            tri,
            proj,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            tmp,
            M,
            N,
            H,
            eps,
            num_warps=8,
        )

        out = _mm_f32(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

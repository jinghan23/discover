"""
TriMul outgoing forward using mixed precision and fused Triton stages.

The pipeline normalizes the pair tensor, computes input projections with cuBLAS,
materializes gated left/right tensors in channel-major layout, evaluates the
outgoing contraction with batched GEMM, then uses Triton to fuse output
LayerNorm, output gating, and for dim=128 the final projection.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None
_FLAGS_SET = False


@triton.jit
def _layernorm_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                           BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    mask = (rows[:, None] < M) & (ds[None, :] < D)

    vals = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    vals = tl.where(ds[None, :] < D, vals, 0.0)
    mean = tl.sum(vals, axis=1) / D
    cen = tl.where(ds[None, :] < D, vals - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / D

    ww = tl.load(w + ds, mask=ds < D, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.0).to(tl.float32)
    out = cen * tl.rsqrt(var[:, None] + EPS) * ww[None, :] + bb[None, :]
    tl.store(y + rows[:, None] * D + ds[None, :], out, mask=mask)


@triton.jit
def _prep_nomask_kernel(proj, left_out, right_out, M: tl.constexpr, N: tl.constexpr,
                        H: tl.constexpr, P: tl.constexpr,
                        BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    base = rows[:, None] * P + hs[None, :]
    out_ptrs = bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    out_mask = h_ok[:, None] & row_ok[None, :]

    left = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(left_out + out_ptrs, tl.trans(left * tl.sigmoid(lg)), mask=out_mask)

    right = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(right_out + out_ptrs, tl.trans(right * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _prep_mask_kernel(proj, mask, left_out, right_out, M: tl.constexpr, N: tl.constexpr,
                      H: tl.constexpr, P: tl.constexpr,
                      BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn
    mv = tl.load(mask + rows, mask=row_ok, other=0.0).to(tl.float32)

    base = rows[:, None] * P + hs[None, :]
    out_ptrs = bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    out_mask = h_ok[:, None] & row_ok[None, :]

    left = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(left_out + out_ptrs, tl.trans(left * mv[:, None] * tl.sigmoid(lg)), mask=out_mask)

    right = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
    tl.store(right_out + out_ptrs, tl.trans(right * mv[:, None] * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _post_norm_gate_kernel(tri, proj, norm_w, norm_b, tmp, M: tl.constexpr, N: tl.constexpr,
                           H: tl.constexpr, EPS: tl.constexpr,
                           BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    ptrs = tri + bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    cen = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bb = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)
    valid = row_ok[:, None] & h_ok[None, :]

    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.0).to(tl.float32)
    y = (cen * tl.rsqrt(var[:, None] + EPS) * w[None, :] + bb[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


@triton.jit
def _final_from_proj_gate_kernel(tri, proj, norm_w, norm_b, to_out_t, out,
                                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                                 D: tl.constexpr, EPS: tl.constexpr,
                                 BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
                                 BLOCK_D: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_d = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    ds = pid_d * BLOCK_D + tl.arange(0, BLOCK_D)

    row_ok = rows < M
    h_ok = hs < H
    d_ok = ds < D
    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    ptrs = tri + bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    cen = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bb = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=row_ok[:, None] & h_ok[None, :], other=0.0).to(tl.float32)

    a = ((cen * tl.rsqrt(var[:, None] + EPS) * w[None, :] + bb[None, :]) * tl.sigmoid(gate)).to(tl.float16)
    wt = tl.load(to_out_t + hs[:, None] * D + ds[None, :],
                 mask=h_ok[:, None] & d_ok[None, :], other=0.0).to(tl.float16)
    acc = tl.dot(a, wt)
    tl.store(out + rows[:, None] * D + ds[None, :], acc, mask=row_ok[:, None] & d_ok[None, :])


@triton.jit
def _final_direct_gate_d128_kernel(tri, xh, out_gate_t, norm_w, norm_b, to_out_t, out,
                                   M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                                   D: tl.constexpr, EPS: tl.constexpr,
                                   BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
                                   BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    ds = tl.arange(0, BLOCK_D)

    row_ok = rows < M
    h_ok = hs < H
    d_ok = ds < D
    nn: tl.constexpr = N * N
    bidx = rows // nn
    pair = rows - bidx * nn

    ptrs = tri + bidx[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    x = tl.trans(tl.load(ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    cen = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H

    xhn = tl.load(xh + rows[:, None] * D + ds[None, :],
                  mask=row_ok[:, None] & d_ok[None, :], other=0.0).to(tl.float16)
    gw = tl.load(out_gate_t + ds[:, None] * H + hs[None, :],
                 mask=d_ok[:, None] & h_ok[None, :], other=0.0).to(tl.float16)
    gate = tl.dot(xhn, gw)

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bb = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)
    a = ((cen * tl.rsqrt(var[:, None] + EPS) * w[None, :] + bb[None, :]) * tl.sigmoid(gate)).to(tl.float16)

    ow = tl.load(to_out_t + hs[:, None] * D + ds[None, :],
                 mask=h_ok[:, None] & d_ok[None, :], other=0.0).to(tl.float16)
    acc = tl.dot(a, ow)
    tl.store(out + rows[:, None] * D + ds[None, :], acc, mask=row_ok[:, None] & d_ok[None, :])


def _tensor_key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1, getattr(t, "_version", 0))


def _get_buffer(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    buf = _BUFFER_CACHE.get(key)
    if buf is None:
        buf = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = buf
    return buf


def _get_packed_t(weights, names, tag, dtype):
    src = tuple(weights[n] for n in names)
    key = (tag, dtype) + tuple(_tensor_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (src, torch.cat(src, dim=0).to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _get_linear_t(w, tag, dtype):
    key = (tag, dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (w, w.to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _mm_half_to_float(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def _setup_flags():
    global _FLAGS_SET
    if not _FLAGS_SET:
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _FLAGS_SET = True


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        _setup_flags()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()
        xh = _get_buffer("x_norm_h", (M, D), device, half)

        _layernorm_cast_kernel[(triton.cdiv(M, 8 if D <= 128 else 4),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps,
            BLOCK_M=8 if D <= 128 else 4,
            BLOCK_D=triton.next_power_of_2(D),
            num_warps=4 if D <= 128 else 8,
        )

        has_mask = mask is not None and not bool(config.get("nomask", False))
        use_direct_gate = (D == 128 and H == 128 and (not has_mask) and N >= 512)

        if use_direct_gate:
            packed_proj_t = _get_packed_t(
                weights,
                ("left_proj.weight", "right_proj.weight", "left_gate.weight", "right_gate.weight"),
                "packed_proj4_t",
                half,
            )
            proj = _get_buffer("proj4", (M, 4 * H), device, half)
            torch.mm(xh, packed_proj_t, out=proj)
            proj_stride = 4 * H
        else:
            packed_proj_t = _get_packed_t(
                weights,
                ("left_proj.weight", "right_proj.weight", "left_gate.weight",
                 "right_gate.weight", "out_gate.weight"),
                "packed_proj5_t",
                half,
            )
            proj = _get_buffer("proj5", (M, 5 * H), device, half)
            torch.mm(xh, packed_proj_t, out=proj)
            proj_stride = 5 * H

        left = _get_buffer("left", (B * H, N, N), device, half)
        right = _get_buffer("right", (B * H, N, N), device, half)

        if has_mask:
            mask_flat = mask.reshape(M).contiguous()
            _prep_mask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, mask_flat, left, right, M, N, H, proj_stride,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )
        else:
            _prep_nomask_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
                proj, left, right, M, N, H, proj_stride,
                BLOCK_M=16, BLOCK_H=64, num_warps=4,
            )

        tri = _get_buffer("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        to_out_t = _get_linear_t(weights["to_out.weight"], "to_out_t", half)

        if use_direct_gate:
            out_gate_t = _get_linear_t(weights["out_gate.weight"], "out_gate_t", half)
            out = torch.empty((M, D), device=device, dtype=torch.float32)
            _final_direct_gate_d128_kernel[(triton.cdiv(M, 16),)](
                tri, xh, out_gate_t,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"],
                to_out_t, out,
                M, N, H, D, eps,
                BLOCK_M=16, BLOCK_H=128, BLOCK_D=128,
                num_warps=4,
            )
            return out.reshape(B, N, N, D)

        if D == 128 and H == 128:
            out = torch.empty((M, D), device=device, dtype=torch.float32)
            _final_from_proj_gate_kernel[(triton.cdiv(M, 16), 1)](
                tri, proj,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"],
                to_out_t, out,
                M, N, H, D, eps,
                BLOCK_M=16, BLOCK_H=128, BLOCK_D=128,
                num_warps=4,
            )
            return out.reshape(B, N, N, D)

        tmp = _get_buffer("tmp", (M, H), device, half)
        _post_norm_gate_kernel[(triton.cdiv(M, 16),)](
            tri, proj,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"],
            tmp,
            M, N, H, eps,
            BLOCK_M=16,
            BLOCK_H=triton.next_power_of_2(H),
            num_warps=4,
        )

        out = _mm_half_to_float(tmp, to_out_t)
        return out.reshape(B, N, N, D)

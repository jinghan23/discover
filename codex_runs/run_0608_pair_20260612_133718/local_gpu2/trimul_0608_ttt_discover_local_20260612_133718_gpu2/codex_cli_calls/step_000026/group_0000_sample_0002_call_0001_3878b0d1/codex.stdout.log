```python
"""
TriMul outgoing forward. The implementation keeps the expensive N^3 triangle
product on cuBLAS batched GEMM, while Triton fuses both LayerNorms, sigmoid
gating, masking, and layout transforms around the GEMMs. Projections are packed
into one input GEMM and the final projection uses a cached transposed weight.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln_fwd_kernel(x, w, b, y,
                   M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                   BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)

    m = (rows[:, None] < M) & (ds[None, :] < D)
    dmask = ds < D

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=m, other=0.0).to(tl.float32)
    v = tl.where(dmask[None, :], v, 0.0)

    mean = tl.sum(v, axis=1) / D
    c = tl.where(dmask[None, :], v - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / D
    rstd = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=dmask, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=dmask, other=0.0).to(tl.float32)
    o = c * rstd[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + rows[:, None] * D + ds[None, :], o, mask=m)


@triton.jit
def _prep_nomask_kernel(p, left, right,
                        M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                        BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    rok = rows < M
    hok = hs < H
    valid = rok[:, None] & hok[None, :]

    NN: tl.constexpr = N * N
    b = rows // NN
    pair = rows - b * NN

    base = rows[:, None] * (5 * H) + hs[None, :]
    out_ptr = b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    out_mask = hok[:, None] & rok[None, :]

    lv = tl.load(p + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(p + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rv = tl.load(p + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(p + base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left + out_ptr, tl.trans(lv * tl.sigmoid(lg)), mask=out_mask)
    tl.store(right + out_ptr, tl.trans(rv * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _prep_mask_kernel(p, mask, left, right,
                      M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                      BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    rok = rows < M
    hok = hs < H
    valid = rok[:, None] & hok[None, :]

    NN: tl.constexpr = N * N
    b = rows // NN
    pair = rows - b * NN

    base = rows[:, None] * (5 * H) + hs[None, :]
    out_ptr = b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    out_mask = hok[:, None] & rok[None, :]

    mv = tl.load(mask + rows, mask=rok, other=0.0).to(tl.float32)

    lv = tl.load(p + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(p + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rv = tl.load(p + base + H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(p + base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left + out_ptr, tl.trans(lv * mv[:, None] * tl.sigmoid(lg)), mask=out_mask)
    tl.store(right + out_ptr, tl.trans(rv * mv[:, None] * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _post_kernel(tri, p, nw, nb, tmp,
                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
                 BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)

    rok = rows < M
    hok = hs < H

    NN: tl.constexpr = N * N
    b = rows // NN
    pair = rows - b * NN

    ptr = tri + b[None, :] * (H * NN) + hs[:, None] * NN + pair[None, :]
    xt = tl.load(ptr, mask=hok[:, None] & rok[None, :], other=0.0).to(tl.float32)
    x = tl.trans(xt)

    mean = tl.sum(x, axis=1) / H
    c = tl.where(hok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / H
    rstd = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hok, other=0.0).to(tl.float32)
    bb = tl.load(nb + hs, mask=hok, other=0.0).to(tl.float32)

    valid = rok[:, None] & hok[None, :]
    gate = tl.load(p + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.0).to(tl.float32)

    y = (c * rstd[:, None] * w[None, :] + bb[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


def _key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1,
            getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    out = _BUFFER_CACHE.get(key)
    if out is None:
        out = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = out
    return out


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight",
             "left_gate.weight", "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    key = ("proj_t", dtype) + tuple(_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _to_out_t(w, dtype):
    key = ("to_out_t", dtype, _key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = item
    return item


def _mm_fp32(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _ln_fwd_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps,
            BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)

        bm_prep = 16
        bh_prep = 64
        has_mask = mask is not None and not bool(config.get("nomask", False))
        if has_mask:
            _prep_mask_kernel[(triton.cdiv(M, bm_prep), triton.cdiv(H, bh_prep))](
                proj, mask.reshape(M), left, right,
                M, N, H,
                BLOCK_M=bm_prep, BLOCK_H=bh_prep,
                num_warps=4,
            )
        else:
            _prep_nomask_kernel[(triton.cdiv(M, bm_prep), triton.cdiv(H, bh_prep))](
                proj, left, right,
                M, N, H,
                BLOCK_M=bm_prep, BLOCK_H=bh_prep,
                num_warps=4,
            )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), device, half)
        _post_kernel[(triton.cdiv(M, 16),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps,
            BLOCK_M=16, BLOCK_H=128,
            num_warps=8,
        )

        out = _mm_fp32(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

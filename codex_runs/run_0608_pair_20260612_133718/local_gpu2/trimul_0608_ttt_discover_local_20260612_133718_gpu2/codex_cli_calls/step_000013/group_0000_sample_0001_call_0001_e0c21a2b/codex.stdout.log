"""
TriMul outgoing forward pass.

Fuses both LayerNorms with Triton, packs the five input projections into one
tensor-core GEMM, stores gated left/right in channel-major layout, evaluates the
outgoing N^3 contraction as batched GEMM over hidden channels, then fuses
output LayerNorm with the output gate before the final tensor-core projection.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln_cast_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
                    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    mask = (rows[:, None] < M) & (ds[None, :] < D)

    vals = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=1) / D
    cen = tl.where(ds[None, :] < D, vals - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=ds < D, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=ds < D, other=0.0).to(tl.float32)
    out = cen * inv[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + rows[:, None] * D + ds[None, :], out, mask=mask)


@triton.jit
def _prep_kernel(proj, maskp, left, right, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 HAS_MASK: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    valid = row_ok[:, None] & h_ok[None, :]

    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn

    base = rows[:, None] * (5 * H) + hs[None, :]
    out_ptrs = b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    out_mask = h_ok[:, None] & row_ok[None, :]

    m = 1.0
    if HAS_MASK:
        m = tl.load(maskp + rows, mask=row_ok, other=0.0).to(tl.float32)

    l = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)

    tl.store(left + out_ptrs, tl.trans(l * m[:, None] * tl.sigmoid(lg)), mask=out_mask)
    tl.store(right + out_ptrs, tl.trans(r * m[:, None] * tl.sigmoid(rg)), mask=out_mask)


@triton.jit
def _post_kernel(tri, proj, nw, nb, tmp, M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 EPS: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H
    nn: tl.constexpr = N * N
    b = rows // nn
    pair = rows - b * nn

    ptrs = tri + b[None, :] * (H * nn) + hs[:, None] * nn + pair[None, :]
    vals = tl.trans(tl.load(ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(vals, axis=1) / H
    cen = tl.where(h_ok[None, :], vals - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=h_ok, other=0.0).to(tl.float32)
    b0 = tl.load(nb + hs, mask=h_ok, other=0.0).to(tl.float32)
    gate = tl.load(
        proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
        mask=row_ok[:, None] & h_ok[None, :],
        other=0.0,
    ).to(tl.float32)

    out = (cen * inv[:, None] * w[None, :] + b0[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], out, mask=row_ok[:, None] & h_ok[None, :])


def _tensor_key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype),
            t.device.index if t.device.type == "cuda" else -1, getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    out = _BUFFER_CACHE.get(key)
    if out is None:
        out = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = out
    return out


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight",
             "right_gate.weight", "out_gate.weight")
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(weights[n]) for n in names)
    val = _WEIGHT_CACHE.get(key)
    if val is None:
        val = torch.cat([weights[n] for n in names], dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = val
    return val


def _to_out_t(w, dtype):
    key = ("to_out_t", dtype, _tensor_key(w))
    val = _WEIGHT_CACHE.get(key)
    if val is None:
        val = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[key] = val
    return val


def _mm_f32(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    with torch.no_grad():
        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4
        _ln_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps, BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)
        has_mask = mask is not None and not bool(config.get("nomask", False))
        mask_flat = mask.reshape(M).contiguous() if has_mask else proj

        _prep_kernel[(triton.cdiv(M, 16), triton.cdiv(H, 64))](
            proj, mask_flat, left, right, M, N, H, has_mask,
            BLOCK_M=16, BLOCK_H=64, num_warps=4,
        )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), device, half)
        _post_kernel[(triton.cdiv(M, 16),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps, BLOCK_M=16, BLOCK_H=128, num_warps=8,
        )

        out = _mm_f32(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

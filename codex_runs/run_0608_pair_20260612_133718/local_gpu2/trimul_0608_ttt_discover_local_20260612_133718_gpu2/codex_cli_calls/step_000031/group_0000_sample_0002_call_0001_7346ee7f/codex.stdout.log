```python
"""
TriMul outgoing forward with fused Triton normalization/prep/post stages and
cuBLAS tensor-core GEMMs. Projections are written in feature-major layout so the
left/right gated tensors can be consumed by batched GEMM without an extra
transpose buffer; the D=128 final projection is fused into the post-normalization
kernel.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_BACKENDS_READY = False
_MM_OUT_DTYPE_OK = None


@triton.jit
def _layernorm_cast_kernel(
    x, w, b, y,
    M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)

    row_ok = rows < M
    d_ok = ds < D
    mask = row_ok[:, None] & d_ok[None, :]

    vals = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    vals = tl.where(d_ok[None, :], vals, 0.0)

    mean = tl.sum(vals, axis=1) / D
    cen = tl.where(d_ok[None, :], vals - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=d_ok, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=d_ok, other=0.0).to(tl.float32)
    out = cen * inv[:, None] * ww[None, :] + bb[None, :]

    tl.store(y + rows[:, None] * D + ds[None, :], out, mask=mask)


@triton.jit
def _prep_store_nomask_kernel(
    store,
    M: tl.constexpr, H: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    valid = (rows[None, :] < M) & (hs[:, None] < H)

    left_ptr = store + hs[:, None] * M + rows[None, :]
    right_ptr = store + (H + hs[:, None]) * M + rows[None, :]
    lg_ptr = store + (2 * H + hs[:, None]) * M + rows[None, :]
    rg_ptr = store + (3 * H + hs[:, None]) * M + rows[None, :]

    left = tl.load(left_ptr, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(lg_ptr, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(right_ptr, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(rg_ptr, mask=valid, other=0.0).to(tl.float32)

    tl.store(left_ptr, left * tl.sigmoid(lg), mask=valid)
    tl.store(right_ptr, right * tl.sigmoid(rg), mask=valid)


@triton.jit
def _prep_store_mask_kernel(
    store, mask_ptr,
    M: tl.constexpr, H: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    row_ok = rows < M
    valid = row_ok[None, :] & (hs[:, None] < H)
    mv = tl.load(mask_ptr + rows, mask=row_ok, other=0.0).to(tl.float32)

    left_ptr = store + hs[:, None] * M + rows[None, :]
    right_ptr = store + (H + hs[:, None]) * M + rows[None, :]
    lg_ptr = store + (2 * H + hs[:, None]) * M + rows[None, :]
    rg_ptr = store + (3 * H + hs[:, None]) * M + rows[None, :]

    left = tl.load(left_ptr, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(lg_ptr, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(right_ptr, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(rg_ptr, mask=valid, other=0.0).to(tl.float32)

    tl.store(left_ptr, left * mv[None, :] * tl.sigmoid(lg), mask=valid)
    tl.store(right_ptr, right * mv[None, :] * tl.sigmoid(rg), mask=valid)


@triton.jit
def _post_norm_gate_store_kernel(
    tri, store, norm_w, norm_b, tmp,
    M: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)

    row_ok = rows < M
    h_ok = hs < H

    ptrs = tri + hs[:, None] * M + rows[None, :]
    x = tl.trans(tl.load(ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    cen = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bias = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)

    gate_ptrs = store + (4 * H + hs[:, None]) * M + rows[None, :]
    gate = tl.trans(tl.load(gate_ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    valid = row_ok[:, None] & h_ok[None, :]
    y = (cen * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


@triton.jit
def _post_out_d128_store_kernel(
    tri, store, norm_w, norm_b, to_out_t, out,
    M: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    ds = tl.arange(0, BLOCK_D)

    row_ok = rows < M
    h_ok = hs < H

    tri_ptrs = tri + hs[:, None] * M + rows[None, :]
    x = tl.trans(tl.load(tri_ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    mean = tl.sum(x, axis=1) / H
    cen = tl.where(h_ok[None, :], x - mean[:, None], 0.0)
    var = tl.sum(cen * cen, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(norm_w + hs, mask=h_ok, other=0.0).to(tl.float32)
    bias = tl.load(norm_b + hs, mask=h_ok, other=0.0).to(tl.float32)

    gate_ptrs = store + (4 * H + hs[:, None]) * M + rows[None, :]
    gate = tl.trans(tl.load(gate_ptrs, mask=h_ok[:, None] & row_ok[None, :], other=0.0).to(tl.float32))

    y = (cen * inv[:, None] * w[None, :] + bias[None, :]) * tl.sigmoid(gate)
    yh = y.to(tl.float16)

    wt = tl.load(to_out_t + hs[:, None] * BLOCK_D + ds[None, :], mask=h_ok[:, None], other=0.0)
    acc = tl.dot(yh, wt)

    tl.store(out + rows[:, None] * BLOCK_D + ds[None, :], acc, mask=row_ok[:, None])


def _init_backends():
    global _BACKENDS_READY
    if not _BACKENDS_READY:
        torch.backends.cuda.matmul.allow_tf32 = True
        try:
            torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        except Exception:
            pass
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _BACKENDS_READY = True


def _tensor_key(t):
    try:
        version = t._version
    except Exception:
        version = 0
    return (
        t.data_ptr(),
        tuple(t.shape),
        str(t.dtype),
        t.device.index if t.device.type == "cuda" else -1,
        version,
    )


def _get_buffer(name, shape, device, dtype):
    key = (name, tuple(shape), device.index if device.type == "cuda" else -1, dtype)
    buf = _BUFFER_CACHE.get(key)
    if buf is None:
        buf = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[key] = buf
    return buf


def _get_packed_proj_t(weights, dtype):
    names = (
        "left_proj.weight",
        "right_proj.weight",
        "left_gate.weight",
        "right_gate.weight",
        "out_gate.weight",
    )
    src = tuple(weights[n] for n in names)
    key = ("packed_proj_t", dtype) + tuple(_tensor_key(t) for t in src)
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (src, torch.cat(src, dim=0).to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _get_to_out_t(w, dtype):
    key = ("to_out_t", dtype, _tensor_key(w))
    item = _WEIGHT_CACHE.get(key)
    if item is None:
        item = (w, w.to(dtype).t().contiguous())
        _WEIGHT_CACHE[key] = item
    return item[1]


def _mm_half_to_float(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            out = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return out
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data

    with torch.no_grad():
        _init_backends()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _get_buffer("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else (4 if D <= 384 else 2)
        _layernorm_cast_kernel[(triton.cdiv(M, bm_ln),)](
            x,
            weights["norm.weight"],
            weights["norm.bias"],
            xh,
            M,
            D,
            eps,
            BLOCK_M=bm_ln,
            BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        packed_proj_t = _get_packed_proj_t(weights, half)

        proj_store = _get_buffer("proj_store_fmajor", (5 * H, M), device, half)
        proj_view = proj_store.t()
        torch.mm(xh, packed_proj_t, out=proj_view)

        has_mask = mask is not None and not bool(config.get("nomask", False))
        if has_mask:
            mask_flat = mask.reshape(M).contiguous()
            _prep_store_mask_kernel[(triton.cdiv(M, 64), triton.cdiv(H, 16))](
                proj_store, mask_flat, M, H,
                BLOCK_M=64, BLOCK_H=16, num_warps=4,
            )
        else:
            _prep_store_nomask_kernel[(triton.cdiv(M, 64), triton.cdiv(H, 16))](
                proj_store, M, H,
                BLOCK_M=64, BLOCK_H=16, num_warps=4,
            )

        left = proj_store[:H].reshape(H * B, N, N)
        right = proj_store[H:2 * H].reshape(H * B, N, N)

        tri = _get_buffer("tri_hmajor", (H * B, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        to_out_t = _get_to_out_t(weights["to_out.weight"], half)

        if D == 128 and H == 128:
            out = torch.empty((M, D), device=device, dtype=torch.float32)
            _post_out_d128_store_kernel[(triton.cdiv(M, 16),)](
                tri,
                proj_store,
                weights["to_out_norm.weight"],
                weights["to_out_norm.bias"],
                to_out_t,
                out,
                M,
                H,
                eps,
                BLOCK_M=16,
                BLOCK_H=128,
                BLOCK_D=128,
                num_warps=8,
            )
            return out.reshape(B, N, N, D)

        tmp = _get_buffer("tmp_post", (M, H), device, half)
        _post_norm_gate_store_kernel[(triton.cdiv(M, 16),)](
            tri,
            proj_store,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            tmp,
            M,
            H,
            eps,
            BLOCK_M=16,
            BLOCK_H=triton.next_power_of_2(H),
            num_warps=8,
        )

        out = _mm_half_to_float(tmp, to_out_t)
        return out.reshape(B, N, N, D)
```

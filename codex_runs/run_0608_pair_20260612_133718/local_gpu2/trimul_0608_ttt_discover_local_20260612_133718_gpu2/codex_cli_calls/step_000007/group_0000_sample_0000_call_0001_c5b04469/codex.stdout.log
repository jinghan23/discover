```python
"""
TriMul outgoing forward.

Strategy:
- Fuse input LayerNorm into a Triton kernel that writes fp16 rows for tensor-core GEMMs.
- Pack the five input projections into one GEMM.
- Prepare left/right in channel-major layout with Triton, applying mask and sigmoid gates.
- Use strided batched GEMM for the N^3 triangular multiplication, one batch per hidden channel.
- Fuse hidden LayerNorm and output gate in Triton, then use one final tensor-core GEMM.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_BUFFER_CACHE = {}
_MATMUL_READY = False
_MM_OUT_DTYPE_OK = None


@triton.jit
def _ln_kernel(x, w, b, y, M: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr,
               BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    dmask = ds < D
    mask = (rows[:, None] < M) & dmask[None, :]

    v = tl.load(x + rows[:, None] * D + ds[None, :], mask=mask, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) / D
    c = tl.where(dmask[None, :], v - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / D
    inv = tl.rsqrt(var + EPS)

    ww = tl.load(w + ds, mask=dmask, other=0.0).to(tl.float32)
    bb = tl.load(b + ds, mask=dmask, other=0.0).to(tl.float32)
    tl.store(y + rows[:, None] * D + ds[None, :],
             c * inv[:, None] * ww[None, :] + bb[None, :],
             mask=mask)


@triton.jit
def _prep_kernel(proj, mask_ptr, left, right,
                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr,
                 HAS_MASK: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    valid = (rows[:, None] < M) & (hs[None, :] < H)

    nn = N * N
    b = rows // nn
    pair = rows - b * nn

    p = rows[:, None] * (5 * H) + hs[None, :]
    o = b[:, None] * (H * nn) + hs[None, :] * nn + pair[:, None]

    l = tl.load(proj + p, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj + p + H, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + p + 2 * H, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + p + 3 * H, mask=valid, other=0.0).to(tl.float32)

    scale = 1.0
    if HAS_MASK:
        scale = tl.load(mask_ptr + rows, mask=rows < M, other=0.0).to(tl.float32)[:, None]

    tl.store(left + o, l * tl.sigmoid(lg) * scale, mask=valid)
    tl.store(right + o, r * tl.sigmoid(rg) * scale, mask=valid)


@triton.jit
def _post_kernel(tri, proj, nw, nb, tmp,
                 M: tl.constexpr, N: tl.constexpr, H: tl.constexpr, EPS: tl.constexpr,
                 BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    hmask = hs < H
    valid = (rows[:, None] < M) & hmask[None, :]

    nn = N * N
    b = rows // nn
    pair = rows - b * nn
    src = b[:, None] * (H * nn) + hs[None, :] * nn + pair[:, None]

    x = tl.load(tri + src, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(x, axis=1) / H
    c = tl.where(hmask[None, :], x - mean[:, None], 0.0)
    var = tl.sum(c * c, axis=1) / H
    inv = tl.rsqrt(var + EPS)

    w = tl.load(nw + hs, mask=hmask, other=0.0).to(tl.float32)
    bb = tl.load(nb + hs, mask=hmask, other=0.0).to(tl.float32)
    gate = tl.load(proj + rows[:, None] * (5 * H) + 4 * H + hs[None, :],
                   mask=valid, other=0.0).to(tl.float32)

    y = (c * inv[:, None] * w[None, :] + bb[None, :]) * tl.sigmoid(gate)
    tl.store(tmp + rows[:, None] * H + hs[None, :], y, mask=valid)


def _configure():
    global _MATMUL_READY
    if not _MATMUL_READY:
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
        try:
            torch.set_float32_matmul_precision("high")
        except Exception:
            pass
        _MATMUL_READY = True


def _key(t):
    return (t.data_ptr(), tuple(t.shape), str(t.dtype), t.device.index, getattr(t, "_version", 0))


def _buf(name, shape, device, dtype):
    k = (name, tuple(shape), device.index, dtype)
    v = _BUFFER_CACHE.get(k)
    if v is None:
        v = torch.empty(shape, device=device, dtype=dtype)
        _BUFFER_CACHE[k] = v
    return v


def _packed_proj_t(weights, dtype):
    names = ("left_proj.weight", "right_proj.weight", "left_gate.weight",
             "right_gate.weight", "out_gate.weight")
    src = tuple(weights[n] for n in names)
    k = ("packed_proj_t", dtype) + tuple(_key(t) for t in src)
    v = _WEIGHT_CACHE.get(k)
    if v is None:
        v = torch.cat(src, dim=0).to(dtype).t().contiguous()
        _WEIGHT_CACHE[k] = v
    return v


def _to_out_t(w, dtype):
    k = ("to_out_t", dtype, _key(w))
    v = _WEIGHT_CACHE.get(k)
    if v is None:
        v = w.to(dtype).t().contiguous()
        _WEIGHT_CACHE[k] = v
    return v


def _mm(a, b):
    global _MM_OUT_DTYPE_OK
    if _MM_OUT_DTYPE_OK is not False:
        try:
            y = torch.mm(a, b, out_dtype=torch.float32)
            _MM_OUT_DTYPE_OK = True
            return y
        except TypeError:
            _MM_OUT_DTYPE_OK = False
    return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    with torch.no_grad():
        _configure()

        B, N, _, D = input_tensor.shape
        H = int(config["hidden_dim"])
        M = B * N * N
        eps = float(config.get("eps", config.get("norm_eps", 1e-5)))
        device = input_tensor.device
        half = torch.float16

        x = input_tensor if input_tensor.is_contiguous() else input_tensor.contiguous()

        xh = _buf("x_norm_h", (M, D), device, half)
        bd = triton.next_power_of_2(D)
        bm_ln = 8 if D <= 128 else 4

        _ln_kernel[(triton.cdiv(M, bm_ln),)](
            x, weights["norm.weight"], weights["norm.bias"], xh,
            M, D, eps,
            BLOCK_M=bm_ln, BLOCK_D=bd,
            num_warps=4 if D <= 128 else 8,
        )

        proj = _buf("proj", (M, 5 * H), device, half)
        torch.mm(xh, _packed_proj_t(weights, half), out=proj)

        left = _buf("left", (B * H, N, N), device, half)
        right = _buf("right", (B * H, N, N), device, half)

        bm = 16
        bh = triton.next_power_of_2(H)
        has_mask = mask is not None and not bool(config.get("nomask", False))
        mask_flat = mask.reshape(M).contiguous() if has_mask else proj

        _prep_kernel[(triton.cdiv(M, bm),)](
            proj, mask_flat, left, right,
            M, N, H, has_mask,
            BLOCK_M=bm, BLOCK_H=bh,
            num_warps=8,
        )

        tri = _buf("tri", (B * H, N, N), device, half)
        torch.bmm(left, right.transpose(1, 2), out=tri)

        tmp = _buf("tmp", (M, H), device, half)
        _post_kernel[(triton.cdiv(M, bm),)](
            tri, proj, weights["to_out_norm.weight"], weights["to_out_norm.bias"], tmp,
            M, N, H, eps,
            BLOCK_M=bm, BLOCK_H=bh,
            num_warps=8,
        )

        out = _mm(tmp, _to_out_t(weights["to_out.weight"], half))
        return out.reshape(B, N, N, D)
```

import torch, torch.nn.functional as F
from reference import generate_input
import submission as s

def measure(t):
 print('\\nCASE', t)
 data=generate_input(**t); input_tensor, mask, weights, config=data
 B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']; use_fp16=C==128; proj_dtype=torch.float16 if use_fp16 else torch.bfloat16
 s.custom_kernel(data); torch.cuda.synchronize()
 for rep in range(3):
  events=[]; names=[]
  def mark(name):
   e=torch.cuda.Event(True); e.record(); events.append(e); names.append(name)
  torch.cuda.synchronize(); mark('start')
  x=(s._layernorm_fp16 if use_fp16 else s._layernorm_bf16)(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); mark('ln')
  pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(proj_dtype); mark('cat')
  proj=F.linear(x,pw); mark('proj')
  left,right=(s._sigmoid_mask_layout_packed_fp16 if use_fp16 else s._sigmoid_mask_layout_packed)(proj,mask,B,N,H); mark('pack')
  out_h=torch.bmm(left,right.transpose(1,2)); mark('bmm')
  z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,proj_dtype); mark('normgate')
  out=torch.mm(z.reshape(B*N*N,H), weights['to_out.weight'].to(proj_dtype).t(), out_dtype=torch.float32).reshape(B,N,N,C); mark('final')
  torch.cuda.synchronize(); print('rep', rep)
  for i in range(len(events)-1): print(names[i]+'->'+names[i+1], events[i].elapsed_time(events[i+1])*1000)
  del x,pw,proj,left,right,out_h,z,out

for t in [dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal'), dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')]: measure(t)

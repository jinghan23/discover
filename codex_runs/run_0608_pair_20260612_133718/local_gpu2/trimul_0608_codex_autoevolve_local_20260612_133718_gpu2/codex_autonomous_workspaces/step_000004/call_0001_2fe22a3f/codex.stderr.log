The LN tuning has only marginal gains. I’m tuning the pack kernel dimensions now because it moves more than a gigabyte on the large no-mask cases and is a consistent fixed cost.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission as s

def make_proj(t):
 data=generate_input(**t); x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']; dtype=torch.float16 if C==128 else torch.bfloat16
 ln=(s._layernorm_fp16 if C==128 else s._layernorm_bf16)(x,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
 proj=F.linear(ln,pw); torch.cuda.synchronize(); return proj,mask,B,N,H,dtype

def time_pack(proj,mask,B,N,H,dtype,nomask,block_m,block_h,warps,reps=8):
 left=torch.empty((B*H,N,N),device=proj.device,dtype=dtype); right=torch.empty_like(left)
 if nomask:
  grid=(triton.cdiv(B*N*N,block_m),triton.cdiv(H,block_h))
  s._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=block_m,BLOCK_H=block_h,num_warps=warps)
 else:
  grid=(triton.cdiv(B*N*N,block_m),triton.cdiv(H,block_h))
  s._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=block_m,BLOCK_H=block_h,num_warps=warps)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  left=torch.empty((B*H,N,N),device=proj.device,dtype=dtype); right=torch.empty_like(left)
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record()
  if nomask:
   s._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=block_m,BLOCK_H=block_h,num_warps=warps)
  else:
   s._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=block_m,BLOCK_H=block_h,num_warps=warps)
  en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sum(times)/len(times),min(times)

cases=[dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=1,nomask=True,distribution='normal'), dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal'), dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal')]
configs=[(16,32,4),(16,64,4),(16,128,4),(32,32,4),(32,64,4),(32,128,4),(64,32,4),(64,64,4),(64,128,4),(128,32,4),(128,64,4),(32,64,8),(64,64,8),(64,128,8),(128,64,8)]
for t in cases:
 print('\\nCASE',t)
 proj,mask,B,N,H,dtype=make_proj(t)
 for cfg in configs:
  try:
   avg,best=time_pack(proj,mask,B,N,H,dtype,t['nomask'],*cfg,reps=5)
   print(cfg,'avg',avg,'best',best)
  except Exception as e:
   print(cfg,'ERR',type(e).__name__,e)

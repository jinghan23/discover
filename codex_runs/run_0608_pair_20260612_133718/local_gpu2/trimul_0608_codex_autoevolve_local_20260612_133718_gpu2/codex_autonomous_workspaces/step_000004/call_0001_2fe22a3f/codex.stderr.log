import torch, torch.nn.functional as F, time
from reference import generate_input
import submission as s

def pack_pt(proj, mask, B:int,N:int,H:int, nomask:bool):
    lp=proj[..., :H]
    rp=proj[..., H:2*H]
    lg=proj[..., 2*H:3*H]
    rg=proj[..., 3*H:4*H]
    if not nomask:
        m=mask.unsqueeze(-1).to(lp.dtype)
        left=lp*m*torch.sigmoid(lg)
        right=rp*m*torch.sigmoid(rg)
    else:
        left=lp*torch.sigmoid(lg)
        right=rp*torch.sigmoid(rg)
    return left.permute(0,3,1,2).reshape(B*H,N,N).contiguous(), right.permute(0,3,1,2).reshape(B*H,N,N).contiguous()

pack_comp=torch.compile(pack_pt, mode='max-autotune', fullgraph=True, dynamic=False)

def make_proj(t):
 data=generate_input(**t); x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']; dtype=torch.float16 if C==128 else torch.bfloat16
 ln=(s._layernorm_fp16 if C==128 else s._layernorm_bf16)(x,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
 proj=F.linear(ln,pw); torch.cuda.synchronize(); return proj,mask,B,N,H,dtype

def time_op(fn,reps=8):
 out=fn(); torch.cuda.synchronize(); del out
 times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=fn(); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000); del out
 return sum(times)/len(times), min(times)
for t in [dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'),dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal'),dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal')]:
 print('\\nCASE',t)
 proj,mask,B,N,H,dtype=make_proj(t)
 # compile
 pack_comp(proj,mask,B,N,H,t['nomask']); torch.cuda.synchronize()
 print('triton', time_op(lambda: (s._sigmoid_mask_layout_packed_fp16 if dtype is torch.float16 else s._sigmoid_mask_layout_packed)(proj,mask,B,N,H), reps=5))
 print('pt eager', time_op(lambda: pack_pt(proj,mask,B,N,H,t['nomask']), reps=5))
 print('compiled', time_op(lambda: pack_comp(proj,mask,B,N,H,t['nomask']), reps=5))

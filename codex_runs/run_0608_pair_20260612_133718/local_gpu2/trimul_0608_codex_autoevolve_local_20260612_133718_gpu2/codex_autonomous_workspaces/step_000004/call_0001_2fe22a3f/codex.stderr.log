    y = torch.empty_like(input_tensor, dtype=torch.bfloat16)
    rows = B * N * N
    if C <= 128:
        block_m = 16
        block_c = 128
        warps = 4
    elif C <= 256:
        block_m = 16
        block_c = 256
        warps = 4
    elif C <= 512:
        block_m = 16

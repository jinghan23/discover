Native layer norm is much slower on the large benchmark shapes, so the custom Triton LN is the right base. I’m tuning its row-block size now; this is a parameter-only change if a better point exists.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch
from reference import generate_input
import submission as s
import triton

def time_ln(x,w,b,B,N,C,dtype,block_m,block_c,warps,reps=8):
 y=torch.empty_like(x,dtype=dtype)
 rows=B*N*N
 # compile/warm
 s._layernorm_bf16_kernel[(triton.cdiv(rows,block_m),)](x,w,b,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps)
 torch.cuda.synchronize()
 times=[]
 for _ in range(reps):
  y=torch.empty_like(x,dtype=dtype)
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record()
  s._layernorm_bf16_kernel[(triton.cdiv(rows,block_m),)](x,w,b,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps)
  en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sum(times)/len(times), min(times)
for C,N,B in [(128,1024,1),(384,1024,1),(384,768,1),(128,256,2),(384,256,2)]:
 data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=2,nomask=True,distribution='normal')
 x,mask,w,c=data; dtype=torch.float16 if C==128 else torch.bfloat16
 print('\\nC,N,B',C,N,B)
 if C==128:
  configs=[(4,128,4),(8,128,4),(16,128,4),(32,128,4),(64,128,4),(8,128,8),(16,128,8),(32,128,8)]
 elif C==384:
  configs=[(4,512,4),(8,512,4),(16,512,4),(32,512,4),(64,512,4),(8,512,8),(16,512,8),(32,512,8),(16,512,16)]
 for cfg in configs:
  try:
   avg,best=time_ln(x,w['norm.weight'],w['norm.bias'],B,N,C,dtype,*cfg,reps=5)
   print(cfg,'avg',avg,'best',best)
  except Exception as e:
   print(cfg,'ERR',type(e).__name__,e)

import torch, torch.nn.functional as F
from reference import generate_input
import submission as s

def time_op(fn, reps=10):
 out=fn(); torch.cuda.synchronize(); del out
 times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=fn(); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000); del out
 return sum(times)/len(times), min(times)
for C,N,B in [(128,1024,1),(384,1024,1),(384,768,1),(768,128,1),(256,64,2)]:
 data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=1,nomask=True,distribution='normal')
 x,mask,w,c=data; dtype=torch.float16 if C==128 else torch.bfloat16
 rows=B*N*N
 print('\\nC,N,B', C,N,B)
 print('triton', time_op(lambda: (s._layernorm_fp16 if C==128 else s._layernorm_bf16)(x,w['norm.weight'],w['norm.bias'],B,N,C), reps=5))
 print('torch+to', time_op(lambda: F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias']).to(dtype), reps=5))
 with torch.autocast('cuda', dtype=dtype):
  y=F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias'])
 print('autocast dtype', y.dtype)
 print('autocast+maybe', time_op(lambda: F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias']).to(dtype), reps=5))
 del data

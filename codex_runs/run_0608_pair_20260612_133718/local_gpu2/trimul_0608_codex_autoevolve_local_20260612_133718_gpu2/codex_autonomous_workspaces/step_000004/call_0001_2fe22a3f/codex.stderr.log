codex
I’m measuring the candidate’s own stages with CUDA events now. The profiler output double-counts some cuBLAS rows, so explicit segment events are cleaner for deciding which kernels are worth replacing.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, time
from reference import generate_input
import submission as s

def evtime(fn, reps=5):
    # warm
    out=fn(); torch.cuda.synchronize(); del out
    times=[]
    for _ in range(reps):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        torch.cuda.synchronize(); st.record(); out=fn(); en.record(); torch.cuda.synchronize()
        times.append(st.elapsed_time(en)*1000); del out
    return sum(times)/len(times), min(times)

def measure(t):
    print('\\nCASE', t)
    data=generate_input(**t)
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    use_fp16=C==128
    proj_dtype=torch.float16 if use_fp16 else torch.bfloat16
    # full warm
    s.custom_kernel(data); torch.cuda.synchronize()
    # segment sequential once with events list repeated
    for rep in range(3):
      torch.cuda.synchronize()
      events=[]; names=[]
      def mark(name):
        e=torch.cuda.Event(True); e.record(); events.append(e); names.append(name)
      mark('start')
      x=(s._layernorm_fp16 if use_fp16 else s._layernorm_bf16)(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C); mark('ln')
      pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(proj_dtype); mark('cat')
      proj=F.linear(x,pw); mark('proj')
      left,right=(s._sigmoid_mask_layout_packed_fp16 if use_fp16 else s._sigmoid_mask_layout_packed)(proj,mask,B,N,H); mark('pack')
      out_h=torch.bmm(left,right.transpose(1,2)); mark('bmm')
      z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H); mark('normgate')
      out=F.linear(z,weights['to_out.weight']).to(torch.float32); mark('final')
      torch.cuda.synchronize()
      print('rep', rep)
      for i in range(len(events)-1):
        print(names[i]+'->'+names[i+1], events[i].elapsed_time(events[i+1])*1000)
      del x,pw,proj,left,right,out_h,z,out
    del data

for t in [dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal'), dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')]:
    measure(t)

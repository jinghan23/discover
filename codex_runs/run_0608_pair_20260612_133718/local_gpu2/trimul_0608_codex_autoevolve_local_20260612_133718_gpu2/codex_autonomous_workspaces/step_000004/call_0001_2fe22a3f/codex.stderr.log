+    gate = tl.sigmoid(gate_logits)
+    z_hm = ((centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate).to(
+        tl.float16
+    )
+
+    a = tl.trans(z_hm)
+    w = tl.load(out_w + offs_c[None, :] * H + offs_h[:, None])
+    acc = tl.dot(a, w)
+    tl.store(output + offs_m[:, None] * 128 + offs_c[None, :], acc)

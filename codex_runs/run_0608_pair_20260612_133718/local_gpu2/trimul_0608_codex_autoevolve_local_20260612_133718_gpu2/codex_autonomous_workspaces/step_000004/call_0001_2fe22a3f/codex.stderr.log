Pack block tuning confirms the current choices are close to optimal. I’m checking whether flattening the projection into an explicit `torch.mm` buys anything over `F.linear`; sometimes it avoids a small reshape path, but the main GEMM should be identical.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input
import submission as s

def time_op(fn,reps=10):
 out=fn(); torch.cuda.synchronize(); del out
 times=[]
 for _ in range(reps):
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=fn(); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000); del out
 return sum(times)/len(times), min(times)
for C,N,B in [(128,1024,1),(384,1024,1),(384,768,1),(128,256,2),(384,256,2)]:
 data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=3,nomask=True,distribution='normal')
 inp,mask,w,c=data; dtype=torch.float16 if C==128 else torch.bfloat16
 x=(s._layernorm_fp16 if C==128 else s._layernorm_bf16)(inp,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
 torch.cuda.synchronize()
 print('\\nC,N,B',C,N,B)
 print('F.linear4d',time_op(lambda: F.linear(x,pw),reps=5))
 print('mm flat',time_op(lambda: torch.mm(x.reshape(B*N*N,C), pw.t()).reshape(B,N,N,5*128),reps=5))
 print('matmul flat',time_op(lambda: (x.reshape(B*N*N,C) @ pw.t()).reshape(B,N,N,5*128),reps=5))

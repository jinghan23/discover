import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission as s

def build(t):
 data=generate_input(**t); inp,mask,w,c=data; B,N,C,H=inp.shape[0],inp.shape[1],c['dim'],c['hidden_dim']; dtype=torch.float16 if C==128 else torch.bfloat16
 x=(s._layernorm_fp16 if C==128 else s._layernorm_bf16)(inp,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
 proj=F.linear(x,pw)
 left,right=(s._sigmoid_mask_layout_packed_fp16 if dtype is torch.float16 else s._sigmoid_mask_layout_packed)(proj,mask,B,N,H)
 out_h=torch.bmm(left,right.transpose(1,2)); torch.cuda.synchronize()
 return out_h,proj,w,B,N,H,dtype

def time_norm(out_h,proj,w,B,N,H,dtype,bm,warps,reps=8):
 z=torch.empty((B,N,N,H),device=out_h.device,dtype=dtype)
 s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  z=torch.empty((B,N,N,H),device=out_h.device,dtype=dtype)
  st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record()
  s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
  en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
 return sum(times)/len(times),min(times)
for t in [dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'),dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=1,nomask=True,distribution='normal'),dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal'),dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal')]:
 print('\\nCASE',t)
 out_h,proj,w,B,N,H,dtype=build(t)
 for cfg in [(8,4),(16,4),(32,4),(64,4),(128,4),(256,4),(16,8),(32,8),(64,8),(128,8)]:

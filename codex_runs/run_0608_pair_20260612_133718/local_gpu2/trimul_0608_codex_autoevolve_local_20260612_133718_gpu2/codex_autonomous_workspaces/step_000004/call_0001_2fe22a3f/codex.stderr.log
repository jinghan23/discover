+    offs_h = tl.arange(0, 128)
+    offs_c = tl.arange(0, 128)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) * (1.0 / 128.0)
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) * (1.0 / 128.0)

def time(fn, reps=10):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)
for i,cfg in enumerate(benchmarks):
    data=generate_input(**cfg)
    print(i, round(time(lambda: submission.custom_kernel(data), 5),1))

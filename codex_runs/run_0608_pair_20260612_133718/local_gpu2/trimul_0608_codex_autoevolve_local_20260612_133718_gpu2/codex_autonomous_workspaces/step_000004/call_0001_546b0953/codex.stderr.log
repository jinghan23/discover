def ev(fn,reps=5):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)
vals=[]
for i,cfg in enumerate(benchmarks):
    data=generate_input(**cfg)
    t=ev(lambda data=data: submission.custom_kernel(data),5)
    vals.append(t)
    print(i, round(t,1), cfg)
print('geom', round(math.exp(sum(math.log(x) for x in vals)/len(vals)),1))

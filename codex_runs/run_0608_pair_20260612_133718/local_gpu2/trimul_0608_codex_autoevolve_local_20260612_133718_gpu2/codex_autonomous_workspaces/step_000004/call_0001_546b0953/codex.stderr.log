    print('F.linear 2D', round(ev(lambda: F.linear(x.reshape(-1,C),pw).reshape(B,N,N,5*H),5),1))
    print('matmul', round(ev(lambda: (x.reshape(-1,C) @ pw.t()).reshape(B,N,N,5*H),5),1))
    # final
    proj=F.linear(x,pw); left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H); out_h=torch.bmm(left,right.transpose(1,2)); z=submission._norm_gate_packed(out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H); torch.cuda.synchronize()
    print('final ND', round(ev(lambda: F.linear(z,w['to_out.weight']).to(torch.float32),5),1))
    print('final 2D', round(ev(lambda: F.linear(z.reshape(-1,H),w['to_out.weight']).reshape(B,N,N,C).to(torch.float32),5),1))
    print('final matmul', round(ev(lambda: (z.reshape(-1,H) @ w['to_out.weight'].t()).reshape(B,N,N,C).to(torch.float32),5),1))

/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission

torch._dynamo.config.suppress_errors=True

def impl(input_tensor, mask, nw, nb, lpw, rpw, lgw, rgw, ogw, tonw, tonb, tow, C:int, H:int):
    B=input_tensor.shape[0]; N=input_tensor.shape[1]
    x=submission._layernorm_fp16(input_tensor,nw,nb,B,N,C)
    pw=torch.cat((lpw,rpw,lgw,rgw,ogw),0).to(torch.float16)
    if C==128:
        proj=F.linear(x.reshape(-1,C),pw).reshape(B,N,N,5*H)
    else:
        proj=F.linear(x,pw)
    left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=submission._norm_gate_packed(out_h,proj,tonw,tonb,B,N,H)
    return F.linear(z.reshape(-1,H),tow).reshape(B,N,N,C).to(torch.float32)

cimpl=torch.compile(impl, mode='reduce-overhead', fullgraph=False, dynamic=False)

def ev(fn,reps=5):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)
for cfg in [dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'), dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=2,nomask=True,distribution='cauchy')]:
    data=generate_input(**cfg); inp,mask,w,conf=data; C=conf['dim']; H=conf['hidden_dim']
    args=(inp,mask,w['norm.weight'],w['norm.bias'],w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight'],w['to_out_norm.weight'],w['to_out_norm.bias'],w['to_out.weight'],C,H)
    print('compile/warm',cfg)
    out=cimpl(*args); torch.cuda.synchronize()
    print('ok?', check_implementation(data,out)[0])
    print('compiled', ev(lambda: cimpl(*args),5))
    print('plain', ev(lambda: submission.custom_kernel(data),5))

import torch
from reference import generate_input
import submission

def ev(fn,reps=10):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)

def ln_custom(input_tensor,w,b,B,N,C,dtype,block_m,block_c,warps):
    y=torch.empty_like(input_tensor,dtype=dtype)
    rows=B*N*N
    submission._layernorm_bf16_kernel[(triton.cdiv(rows, block_m),)](input_tensor,w,b,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps)
    return y

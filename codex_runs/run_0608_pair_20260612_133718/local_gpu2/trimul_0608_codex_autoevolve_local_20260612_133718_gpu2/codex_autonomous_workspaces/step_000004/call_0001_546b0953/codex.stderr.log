/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, math
import torch.nn.functional as F
from reference import generate_input
import submission
benchmarks=[
  dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
  dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
  dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
  dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
  dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
  dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
  dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]
def ev(fn,reps=5):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)
for i,cfg in enumerate(benchmarks):
    data=generate_input(**cfg)
    input_tensor, mask, weights, config=data; B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    use_fp16=True; proj_dtype=torch.float16
    x=submission._layernorm_fp16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C); torch.cuda.synchronize()
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),0).to(proj_dtype); torch.cuda.synchronize()
    proj=F.linear(x,pw); torch.cuda.synchronize()
    left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H); torch.cuda.synchronize()
    out_h=torch.bmm(left,right.transpose(1,2)); torch.cuda.synchronize()
    z=submission._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H); torch.cuda.synchronize()
    print('case',i,cfg)
    print({
      'full':round(ev(lambda: submission.custom_kernel(data)),1),
      'ln':round(ev(lambda: submission._layernorm_fp16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C)),1),
      'linear5':round(ev(lambda: F.linear(x,pw)),1),
      'prep':round(ev(lambda: submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)),1),
      'bmm':round(ev(lambda: torch.bmm(left,right.transpose(1,2))),1),
      'norm_gate':round(ev(lambda: submission._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)),1),
      'final':round(ev(lambda: F.linear(z,weights['to_out.weight']).to(torch.float32)),1),
    })

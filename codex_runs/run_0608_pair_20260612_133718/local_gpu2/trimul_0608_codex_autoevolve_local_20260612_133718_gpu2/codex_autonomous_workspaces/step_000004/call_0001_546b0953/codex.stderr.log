/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input
import submission

def ev(fn,reps=8):
    fn(); torch.cuda.synchronize(); ts=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del out
    return sum(ts)/len(ts)

def prep_nomask(proj,B,N,H,bm,bh,warps):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16); right=torch.empty_like(left)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    submission._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

def prep_mask(proj,mask,B,N,H,bm,bh,warps):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16); right=torch.empty_like(left)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    submission._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right
for cfg in [
 dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'),
 dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal'),
 dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal'),
]:
    data=generate_input(**cfg); inp,mask,w,conf=data; B,N,C,H=inp.shape[0],inp.shape[1],conf['dim'],conf['hidden_dim']
    x=submission._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C); pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),0).to(torch.float16); proj=F.linear(x,pw); torch.cuda.synchronize()
    print('case',cfg,'maskdtype',mask.dtype)
    for bm in [16,32,64,128]:
      for bh in [32,64,128]:
        if bm*bh>8192: continue
        for warps in [4,8]:
          try:
            fn=(lambda bm=bm,bh=bh,warps=warps: prep_nomask(proj,B,N,H,bm,bh,warps)) if mask.dtype is torch.float32 else (lambda bm=bm,bh=bh,warps=warps: prep_mask(proj,mask,B,N,H,bm,bh,warps))
            t=ev(fn,5)
            print(' bm',bm,'bh',bh,'w',warps,'us',round(t,1))
          except Exception as e:
            print('err',bm,bh,warps,type(e).__name__,e)

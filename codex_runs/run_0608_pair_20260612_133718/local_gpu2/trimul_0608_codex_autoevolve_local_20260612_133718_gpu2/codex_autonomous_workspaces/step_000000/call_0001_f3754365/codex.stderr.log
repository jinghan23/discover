+"""
+Outgoing Triangle Multiplicative Update with a fused Triton output stage.
+
+The input is LayerNormed once, all five hidden projections are computed with a
+single TF32 GEMM, and the O(N^3) triangle contraction is performed as a batched
+BF16 matrix multiply over the hidden channels.  A Triton kernel then reads that
+contracted tensor in [B, H, N, N] layout and fuses output LayerNorm, output
+gating, and the final projection to avoid a large layout-conversion copy.
+"""
+
+
+torch.backends.cuda.matmul.allow_tf32 = True
+torch.set_float32_matmul_precision("high")
+
+
+@triton.jit
+def _project_kernel(
+    x_ptr,
+    mask_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    left_w_ptr,
+    right_w_ptr,
+    left_gate_w_ptr,
+    right_gate_w_ptr,
+    out_gate_w_ptr,
+    left_ptr,
+    right_ptr,
+    out_gate_ptr,
+    total_rows: tl.constexpr,
+    nn: tl.constexpr,
+    dim: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    H: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    cols = tl.arange(0, BLOCK_D)
+    hs = tl.arange(0, H)
+    row_mask = rows < total_rows
+
+    x_full = tl.load(
+        x_ptr + rows[:, None] * dim + cols[None, :],
+        mask=row_mask[:, None] & (cols[None, :] < dim),
+        other=0.0,
+    ).to(tl.float32)
+    valid_cols = cols < dim
+    x_sum = tl.sum(x_full, axis=1)
+    mean = x_sum * (1.0 / dim)
+    centered_full = tl.where(valid_cols[None, :], x_full - mean[:, None], 0.0)
+    var = tl.sum(centered_full * centered_full, axis=1) * (1.0 / dim)
+    rstd = tl.rsqrt(var + 1.0e-5)
 

+@triton.jit
+def _final_kernel(
+    tri_ptr,
+    gate_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    to_out_w_ptr,
+    out_ptr,
+    total_rows: tl.constexpr,
+    nn: tl.constexpr,

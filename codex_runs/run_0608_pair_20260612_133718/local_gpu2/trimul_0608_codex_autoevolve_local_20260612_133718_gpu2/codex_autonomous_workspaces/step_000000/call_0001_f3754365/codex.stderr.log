import torch, torch.nn.functional as F
from reference import generate_input, check_implementation

torch.set_float32_matmul_precision('high'); torch.backends.cuda.matmul.allow_tf32=True

def combined(data):
 x,mask,w,c=data; D=c['dim']; H=c['hidden_dim']
 xn=F.layer_norm(x,(D,),w['norm.weight'],w['norm.bias'],eps=1e-5)
 # maybe cat all five
 W=torch.cat([w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']],0)
 p=F.linear(xn,W)
 left,right,lg,rg,og = p.split(H, dim=-1)
 m=mask.unsqueeze(-1)
 left=left*m*torch.sigmoid(lg)
 right=right*m*torch.sigmoid(rg)
 out_gate=torch.sigmoid(og)
 b,n,_,h=left.shape
 l=left.permute(0,3,1,2).reshape(b*h,n,n).bfloat16()
 r=right.permute(0,3,1,2).reshape(b*h,n,n).bfloat16()
 out=torch.bmm(l,r.transpose(1,2)).reshape(b,h,n,n).permute(0,2,3,1).contiguous().float()
 out=F.layer_norm(out,(h,),w['to_out_norm.weight'],w['to_out_norm.bias'],eps=1e-5)
 return F.linear(out*out_gate,w['to_out.weight']).float()


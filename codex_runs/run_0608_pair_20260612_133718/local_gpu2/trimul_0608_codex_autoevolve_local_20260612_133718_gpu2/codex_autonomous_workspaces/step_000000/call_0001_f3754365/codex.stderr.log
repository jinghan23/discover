+    acc = tl.dot(v, w, input_precision="tf32")
+
+    tl.store(
+        out_ptr + rows[:, None] * dim + ds[None, :],
+        acc,
+        mask=row_mask[:, None] & (ds[None, :] < dim),
+    )

import torch, torch.nn.functional as F
from reference import generate_input, check_implementation

def eager(input_tensor, mask, nw, nb, lp, rp, lg, rg, og, onw, onb, tow):
    dim = input_tensor.shape[-1]
    x = F.layer_norm(input_tensor, (dim,), nw, nb, eps=1e-5)
    left = F.linear(x, lp)
    right = F.linear(x, rp)
    m = mask.unsqueeze(-1)
    left = left * m * torch.sigmoid(F.linear(x, lg))
    right = right * m * torch.sigmoid(F.linear(x, rg))
    out_gate = torch.sigmoid(F.linear(x, og))
    bsz,n,_,hidden=left.shape
    l=left.permute(0,3,1,2).reshape(bsz*hidden,n,n).to(torch.bfloat16)
    r=right.permute(0,3,1,2).reshape(bsz*hidden,n,n).to(torch.bfloat16)
    out=torch.bmm(l,r.transpose(1,2)).reshape(bsz,hidden,n,n).permute(0,2,3,1).contiguous().float()
    out=F.layer_norm(out,(hidden,),onw,onb,eps=1e-5)
    out=out*out_gate
    return F.linear(out,tow).float()

compiled=torch.compile(eager, mode='max-autotune', fullgraph=False)
spec={\"seqlen\": 512, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 12819, \"nomask\": True, \"distribution\": \"normal\"}
data=generate_input(**spec)
x,mask,w,c=data
args=(x,mask,w['norm.weight'],w['norm.bias'],w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight'],w['to_out_norm.weight'],w['to_out_norm.bias'],w['to_out.weight'])
out=compiled(*args); torch.cuda.synchronize()
print(check_implementation(data,out)[0])
# second warm
out=compiled(*args); torch.cuda.synchronize()
t=[]
for i in range(5):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); out=compiled(*args); e.record(); torch.cuda.synchronize(); t.append(s.elapsed_time(e)*1000)
print(t, sum(t)/len(t))

+    valid = valid_h[None, :]
+    lp_v = tl.load(lp + in_offs, mask=valid, other=0.0).to(tl.float32)
+    rp_v = tl.load(rp + in_offs, mask=valid, other=0.0).to(tl.float32)
+    lg_v = tl.load(lg + in_offs, mask=valid, other=0.0).to(tl.float32)

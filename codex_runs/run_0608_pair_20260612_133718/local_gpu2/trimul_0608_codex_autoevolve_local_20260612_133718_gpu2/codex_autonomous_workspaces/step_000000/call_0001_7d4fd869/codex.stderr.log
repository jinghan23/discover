+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid_h = offs_h < H
+    pair = offs_m
+    b = pair // n_pairs
+    rem = pair - b * n_pairs
+
+    base = pair[:, None] * PACK + offs_h[None, :]
+    valid = valid_h[None, :]

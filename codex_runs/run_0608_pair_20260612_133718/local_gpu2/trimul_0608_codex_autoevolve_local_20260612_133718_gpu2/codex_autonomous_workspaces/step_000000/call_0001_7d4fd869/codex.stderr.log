def _norm_gate(out_h, out_gate_logits, norm_w, norm_b, B: int, N: int, H: int):
    z = torch.empty((B, N, N, H), device=out_h.device, dtype=torch.float32)
    _norm_gate_tile_kernel[(triton.cdiv(B * N * N, 32),)](
        out_h,
        out_gate_logits,
        norm_w,
        norm_b,
        z,
        N * N,
        N,
        H,
        BLOCK_M=32,
        BLOCK_H=128,
        num_warps=4,
    )
    return z


def _prep_side(proj, gate, mask, B: int, N: int, H: int):
    out = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
    if mask.dtype is torch.float32:
        _prep_side_nomask_kernel[grid](
            proj,
            gate,
            out,
            N * N,
            H,
            BLOCK_M=16,
            BLOCK_H=64,
            num_warps=4,
        )
    else:
        _prep_side_mask_kernel[grid](
            proj,
            gate,
            mask,
            out,
            N * N,
            H,
            BLOCK_M=16,
            BLOCK_H=64,
            num_warps=4,
        )
    return out


def _prep_out_gate(gate, B: int, N: int, H: int):
    out_gate = torch.empty((B, N, N, H), device=gate.device, dtype=torch.bfloat16)
    _prep_gate_kernel[(triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))](
        gate,
        out_gate,
        H,
        BLOCK_M=16,
        BLOCK_H=64,
        num_warps=4,
    )
    return out_gate


def _input_layer_norm(x, weight, bias, B: int, N: int, C: int):
    y = torch.empty_like(x)
    rows = B * N * N
    if C == 128:
        bm = 8
        bc = 128
    elif C <= 384:
        bm = 4
        bc = 512
    else:
        bm = 2
        bc = 1024
    _input_layernorm_kernel[(triton.cdiv(rows, bm),)](
        x,
        weight,
        bias,
        y,
        C,
        BLOCK_M=bm,
        BLOCK_C=bc,
        num_warps=8,
    )
    return y


def custom_kernel(data: input_t) -> output_t:
    input_tensor, mask, weights, config = data
    B = input_tensor.shape[0]
    N = input_tensor.shape[1]
    C = config["dim"]
    H = config["hidden_dim"]

    x = F.layer_norm(
        input_tensor,
        (C,),
        weights["norm.weight"],
        weights["norm.bias"],
        eps=1.0e-5,
    )

    left_proj = F.linear(x, weights["left_proj.weight"])
    right_proj = F.linear(x, weights["right_proj.weight"])
    left_gate = F.linear(x, weights["left_gate.weight"])
    right_gate = F.linear(x, weights["right_gate.weight"])
    out_gate_logits = F.linear(x, weights["out_gate.weight"])

    left, right = _sigmoid_mask_layout(
        left_proj,
        right_proj,
        left_gate,
        right_gate,
        mask,
        B,
        N,
        H,
    )

    out_h = torch.bmm(left, right.transpose(1, 2))
    z = _norm_gate(
        out_h,
        out_gate_logits,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        B,
        N,
        H,
    )
    return F.linear(z, weights["to_out.weight"]).to(torch.float32)


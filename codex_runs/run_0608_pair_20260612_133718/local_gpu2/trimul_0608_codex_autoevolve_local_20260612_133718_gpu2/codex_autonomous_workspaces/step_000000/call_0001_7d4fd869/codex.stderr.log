  ev[0].record()
  xn=F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias'],eps=1e-5); ev[1].record()
  lp=F.linear(xn,w['left_proj.weight']); rp=F.linear(xn,w['right_proj.weight']); lg=F.linear(xn,w['left_gate.weight']); rg=F.linear(xn,w['right_gate.weight']); og=F.linear(xn,w['out_gate.weight']); ev[2].record()

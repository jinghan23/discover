+@triton.jit
+def _prep_packed_mask_kernel(
+    proj,
+    mask,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    PACK: tl.constexpr,
+    BLOCK_M: tl.constexpr,

import torch, torch.nn.functional as F, time
from reference import generate_input

def core(x, mask, norm_w,norm_b,lp_w,rp_w,lg_w,rg_w,og_w,on_w,on_b,to_w, C:int, H:int):
    B=x.shape[0]; N=x.shape[1]
    x = F.layer_norm(x, (C,), norm_w, norm_b)
    lp=F.linear(x,lp_w); rp=F.linear(x,rp_w); lgw=F.linear(x,lg_w); rgw=F.linear(x,rg_w); og=torch.sigmoid(F.linear(x,og_w))
    m=mask.unsqueeze(-1)
    left=(lp*m*torch.sigmoid(lgw)).to(torch.bfloat16)
    right=(rp*m*torch.sigmoid(rgw)).to(torch.bfloat16)
    a=left.permute(0,3,1,2).reshape(B*H,N,N).contiguous()
    b=right.permute(0,3,1,2).reshape(B*H,N,N).contiguous()
    out=torch.bmm(a,b.transpose(1,2)).reshape(B,H,N,N).permute(0,2,3,1).float()
    out=F.layer_norm(out, (H,), on_w, on_b)
    return F.linear(out*og,to_w).float()

compiled=torch.compile(core, mode='max-autotune', fullgraph=True)

def call(data, comp=False):
 x,mask,w,cfg=data; C=cfg['dim']; H=cfg['hidden_dim']
 fn=compiled if comp else core
 return fn(x,mask,w['norm.weight'],w['norm.bias'],w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight'],w['to_out_norm.weight'],w['to_out_norm.bias'],w['to_out.weight'],C,H)

def bench(args):
 print('case',args)
 data=generate_input(**args)
 for comp in [False, True]:
  try:
   y=call(data,comp); torch.cuda.synchronize(); del y
   y=call(data,comp); torch.cuda.synchronize(); del y
   ts=[]
   for _ in range(5):
    torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=call(data,comp); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)); del y
   print('compiled',comp,'mean',sum(ts)/len(ts),'best',min(ts))
  except Exception as e:
   print('compiled',comp,'ERR',type(e),e)


+
+def _prep_out_gate(gate, B: int, N: int, H: int):
+    out_gate = torch.empty((B, N, N, H), device=gate.device, dtype=torch.bfloat16)
+    _prep_gate_kernel[(triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))](
+        gate,
+        out_gate,
+        H,
+        BLOCK_M=16,
+        BLOCK_H=64,
+        num_warps=4,
+    )
+    return out_gate
+

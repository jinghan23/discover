+@triton.jit
+def _prep_packed_mask_kernel(
+    proj,
+    mask,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    PACK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid_h = offs_h < H
+    pair = offs_m
+    b = pair // n_pairs
+    rem = pair - b * n_pairs
 
+    base = pair[:, None] * PACK + offs_h[None, :]
+    valid = valid_h[None, :]
+    m = tl.load(mask + pair).to(tl.float32)
 
+    lp_v = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
+    rp_v = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
+    lg_v = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
+    rg_v = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
+    og_v = tl.load(proj + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
+
+    left_v = lp_v * m[:, None] / (1.0 + tl.exp(-lg_v))
+    right_v = rp_v * m[:, None] / (1.0 + tl.exp(-rg_v))
+    out_gate_v = 1.0 / (1.0 + tl.exp(-og_v))
+
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, left_v, mask=valid)
+    tl.store(right + hmajor, right_v, mask=valid)
+    tl.store(out_gate + pair[:, None] * H + offs_h[None, :], out_gate_v, mask=valid)
+
+
+@triton.jit
+def _prep_packed_nomask_kernel(
+    proj,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    PACK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid_h = offs_h < H
+    pair = offs_m
+    b = pair // n_pairs
+    rem = pair - b * n_pairs
+
+    base = pair[:, None] * PACK + offs_h[None, :]
+    valid = valid_h[None, :]
+    lp_v = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
+    rp_v = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
+    lg_v = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
+    rg_v = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
+    og_v = tl.load(proj + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
+
+    left_v = lp_v / (1.0 + tl.exp(-lg_v))
+    right_v = rp_v / (1.0 + tl.exp(-rg_v))
+    out_gate_v = 1.0 / (1.0 + tl.exp(-og_v))
+
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, left_v, mask=valid)
+    tl.store(right + hmajor, right_v, mask=valid)
+    tl.store(out_gate + pair[:, None] * H + offs_h[None, :], out_gate_v, mask=valid)
+
+
+@triton.jit
+def _norm_gate_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    row = tl.program_id(0)
+    h = tl.arange(0, BLOCK_H)
+    valid_h = h < H
+
+    b = row // n_pairs
+    rem = row - b * n_pairs
+    i = rem // N
+    j = rem - i * N
+    hmajor = ((b * H + h) * N + i) * N + j
+
+    v = tl.load(out_h + hmajor, mask=valid_h, other=0.0).to(tl.float32)
+    mean = tl.sum(v, axis=0) / H
+    centered = v - mean
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + h, mask=valid_h, other=0.0).to(tl.float32)
+    nb = tl.load(norm_b + h, mask=valid_h, other=0.0).to(tl.float32)
+    gate = tl.load(out_gate + row * H + h, mask=valid_h, other=0.0).to(tl.float32)
+    out = (centered * inv * nw + nb) * gate
+    tl.store(z + row * H + h, out, mask=valid_h)
+
+
+@triton.jit
+def _norm_gate_tile_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / H
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    cl = offs_m[None, :] * H + offs_h[:, None]
+    gate = tl.load(out_gate + cl).to(tl.float32)
+    out = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
+    tl.store(z + cl, out)
+
+
+def _sigmoid_mask_layout(lp, rp, lg, rg, og, mask, B: int, N: int, H: int):
+    left = torch.empty((B * H, N, N), device=lp.device, dtype=torch.bfloat16)
+    right = torch.empty((B * H, N, N), device=lp.device, dtype=torch.bfloat16)
+    out_gate = torch.empty((B, N, N, H), device=lp.device, dtype=torch.float32)
+    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
+    if mask.dtype is torch.float32:
+        _prep_hmajor_nomask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            og,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    else:
+        _prep_hmajor_mask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            og,
+            mask,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    return left, right, out_gate
+
+
+def _sigmoid_mask_layout_packed(proj, mask, B: int, N: int, H: int):
+    left = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
+    right = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
+    out_gate = torch.empty((B, N, N, H), device=proj.device, dtype=torch.float32)
+    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
+    if mask.dtype is torch.float32:
+        _prep_packed_nomask_kernel[grid](
+            proj,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            5 * H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    else:
+        _prep_packed_mask_kernel[grid](
+            proj,
+            mask,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            5 * H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    return left, right, out_gate
+
+
+def _norm_gate(out_h, out_gate, norm_w, norm_b, B: int, N: int, H: int):
+    z = torch.empty((B, N, N, H), device=out_h.device, dtype=torch.float32)
+    _norm_gate_tile_kernel[(triton.cdiv(B * N * N, 16),)](
+        out_h,
+        out_gate,
+        norm_w,
+        norm_b,
+        z,
+        N * N,
+        N,
+        H,
+        BLOCK_M=16,
+        BLOCK_H=128,
+        num_warps=8,
+    )
+    return z
+

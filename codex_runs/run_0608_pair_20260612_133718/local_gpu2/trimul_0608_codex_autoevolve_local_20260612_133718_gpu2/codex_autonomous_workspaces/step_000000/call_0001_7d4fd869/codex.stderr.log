import torch, time, math
import torch.nn.functional as F
from reference import generate_input

def sync(): torch.cuda.synchronize()

def bench(fn, data, name, iters=10):
    # warm
    for _ in range(2):
        y=fn(data); sync(); del y
    times=[]
    for _ in range(iters):
        sync(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=fn(data); e.record(); sync(); times.append(s.elapsed_time(e)); del y
    print(name, 'ms mean', sum(times)/len(times), 'best', min(times))


def current_like(data, use_bmm=False, contig=False, cat=False):
    x, mask, w, cfg = data; C=cfg['dim']; H=cfg['hidden_dim']; B,N=x.shape[0],x.shape[1]
    x = F.layer_norm(x, (C,), w['norm.weight'], w['norm.bias'])
    if cat:
        wl=torch.cat([w['left_proj.weight'], w['left_gate.weight']], dim=0)
        wr=torch.cat([w['right_proj.weight'], w['right_gate.weight']], dim=0)
        lg=F.linear(x, wl); rg=F.linear(x, wr)
        lp, lgw=lg.split(H, dim=-1); rp, rgw=rg.split(H, dim=-1)
    else:
        lp=F.linear(x,w['left_proj.weight']); rp=F.linear(x,w['right_proj.weight']); lgw=F.linear(x,w['left_gate.weight']); rgw=F.linear(x,w['right_gate.weight'])
    og=torch.sigmoid(F.linear(x,w['out_gate.weight']))
    m=mask.unsqueeze(-1)
    left=(lp*m*torch.sigmoid(lgw)).to(torch.bfloat16)
    right=(rp*m*torch.sigmoid(rgw)).to(torch.bfloat16)
    if use_bmm:
        a=left.permute(0,3,1,2).reshape(B*H,N,N)
        b=right.permute(0,3,1,2).reshape(B*H,N,N)
        if contig:
            a=a.contiguous(); b=b.contiguous()
        out=torch.bmm(a,b.transpose(1,2)).reshape(B,H,N,N).permute(0,2,3,1)
    else:
        out=torch.einsum('bikd,bjkd->bijd', left, right)
    out=out.float()
    out=F.layer_norm(out, (H,), w['to_out_norm.weight'], w['to_out_norm.bias'])
    out=out*og
    return F.linear(out,w['to_out.weight']).float()

for args in [dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
             dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal')]:
    print('\\ncase', args)
    data=generate_input(**args)
    for name,kw in [('einsum',{}),('bmm_strided',{'use_bmm':True}),('bmm_contig',{'use_bmm':True,'contig':True}),('cat_einsum',{'cat':True}),('cat_bmm_contig',{'cat':True,'use_bmm':True,'contig':True})]:
        bench(lambda d,kw=kw: current_like(d,**kw), data, name, iters=5)

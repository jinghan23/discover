+@triton.jit
+def _prep_packed_nomask_kernel(
+    proj,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    PACK: tl.constexpr,
+    BLOCK_M: tl.constexpr,

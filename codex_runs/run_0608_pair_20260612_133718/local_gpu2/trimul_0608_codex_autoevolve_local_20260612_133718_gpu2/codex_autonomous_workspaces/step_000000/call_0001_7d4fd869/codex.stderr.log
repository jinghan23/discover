+def _sigmoid_mask_layout(lp, rp, lg, rg, og, mask, B: int, N: int, H: int):
+    left = torch.empty((B * H, N, N), device=lp.device, dtype=torch.bfloat16)
+    right = torch.empty((B * H, N, N), device=lp.device, dtype=torch.bfloat16)
+    out_gate = torch.empty((B, N, N, H), device=lp.device, dtype=torch.float32)
+    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
+    if mask.dtype is torch.float32:
+        _prep_hmajor_nomask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            og,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    else:
+        _prep_hmajor_mask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            og,
+            mask,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=4,
+        )
+    return left, right, out_gate
+

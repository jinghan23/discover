+        _prep_hmajor_nomask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            og,
+            left,
+            right,
+            out_gate,
+            N * N,
+            N,
+            H,
+            BLOCK_M=32,
+            BLOCK_H=32,
+            num_warps=4,
+        )

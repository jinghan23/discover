+        N * N,
+        N,
+        H,
+        BLOCK_M=32,
+        BLOCK_H=128,
+        num_warps=4,
+    )
+    return z
+
+
+def _prep_side(proj, gate, mask, B: int, N: int, H: int):
+    out = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
+    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
+    if mask.dtype is torch.float32:
+        _prep_side_nomask_kernel[grid](
+            proj,
+            gate,
+            out,
+            N * N,
+            H,

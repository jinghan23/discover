+
+@triton.jit
+def _norm_gate_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,

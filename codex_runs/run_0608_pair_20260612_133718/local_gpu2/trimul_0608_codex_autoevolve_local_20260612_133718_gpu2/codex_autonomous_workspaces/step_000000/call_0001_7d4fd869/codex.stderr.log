+    rp_v = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
+    lg_v = tl.load(proj + base + 2 * H, mask=valid, other=0.0).to(tl.float32)
+    rg_v = tl.load(proj + base + 3 * H, mask=valid, other=0.0).to(tl.float32)
+    og_v = tl.load(proj + base + 4 * H, mask=valid, other=0.0).to(tl.float32)
+
+    left_v = lp_v / (1.0 + tl.exp(-lg_v))
+    right_v = rp_v / (1.0 + tl.exp(-rg_v))
+    out_gate_v = 1.0 / (1.0 + tl.exp(-og_v))
+
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, left_v, mask=valid)
+    tl.store(right + hmajor, right_v, mask=valid)
+    tl.store(out_gate + pair[:, None] * H + offs_h[None, :], out_gate_v, mask=valid)
+
+
+@triton.jit
+def _norm_gate_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    row = tl.program_id(0)
+    h = tl.arange(0, BLOCK_H)
+    valid_h = h < H
+
+    b = row // n_pairs
+    rem = row - b * n_pairs
+    i = rem // N
+    j = rem - i * N
+    hmajor = ((b * H + h) * N + i) * N + j
+
+    v = tl.load(out_h + hmajor, mask=valid_h, other=0.0).to(tl.float32)
+    mean = tl.sum(v, axis=0) / H
+    centered = v - mean
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + h, mask=valid_h, other=0.0).to(tl.float32)
+    nb = tl.load(norm_b + h, mask=valid_h, other=0.0).to(tl.float32)
+    gate = tl.load(out_gate + row * H + h, mask=valid_h, other=0.0).to(tl.float32)
+    out = (centered * inv * nw + nb) * gate
+    tl.store(z + row * H + h, out, mask=valid_h)
+
+
+@triton.jit
+def _norm_gate_tile_kernel(
+    out_h,
+    out_gate_logits,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / H
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    cl = offs_m[None, :] * H + offs_h[:, None]
+    gate_logits = tl.load(out_gate_logits + cl).to(tl.float32)
+    gate = 1.0 / (1.0 + tl.exp(-gate_logits))
+    out = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
+    tl.store(z + cl, out)
+
+
+@triton.jit
+def _prep_side_mask_kernel(
+    proj,
+    gate,
+    mask,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    pair = offs_m
+    b = pair // n_pairs
+    rem = pair - b * n_pairs
+    in_offs = pair[:, None] * H + offs_h[None, :]
+    m = tl.load(mask + pair).to(tl.float32)
+    p = tl.load(proj + in_offs).to(tl.float32)
+    g = tl.load(gate + in_offs).to(tl.float32)
+    v = p * m[:, None] / (1.0 + tl.exp(-g))
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(out + hmajor, v)
+
+
+@triton.jit
+def _prep_side_nomask_kernel(
+    proj,
+    gate,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,

+def _input_layer_norm(x, weight, bias, B: int, N: int, C: int):
+    y = torch.empty_like(x)
+    rows = B * N * N
+    if C == 128:
+        bm = 8
+        bc = 128
+    elif C <= 384:
+        bm = 4
+        bc = 512
+    else:
+        bm = 2
+        bc = 1024
+    _input_layernorm_kernel[(triton.cdiv(rows, bm),)](
+        x,
+        weight,
+        bias,
+        y,
+        C,
+        BLOCK_M=bm,
+        BLOCK_C=bc,
+        num_warps=8,
+    )
+    return y

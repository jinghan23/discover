+        _prep_hmajor_nomask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            left,
+            right,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=8,
+        )
+    else:
+        _prep_hmajor_mask_kernel[grid](
+            lp,
+            rp,
+            lg,
+            rg,
+            mask,
+            left,
+            right,
+            N * N,
+            N,
+            H,
+            BLOCK_M=16,
+            BLOCK_H=64,
+            num_warps=8,

+@triton.jit
+def _norm_gate_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    z,
+    n_pairs: tl.constexpr,
+    N: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    row = tl.program_id(0)
+    h = tl.arange(0, BLOCK_H)
+    valid_h = h < H
+
+    b = row // n_pairs

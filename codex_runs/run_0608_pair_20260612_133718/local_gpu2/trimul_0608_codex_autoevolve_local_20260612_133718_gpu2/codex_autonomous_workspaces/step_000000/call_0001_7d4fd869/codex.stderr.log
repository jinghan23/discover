import torch, torch.nn.functional as F
from reference import generate_input, check_implementation

def fn(data, allow):
    old=torch.backends.cuda.matmul.allow_tf32
    torch.backends.cuda.matmul.allow_tf32=allow
    torch.set_float32_matmul_precision('high' if allow else 'highest')
    x, mask, w, cfg=data; C=cfg['dim']; H=cfg['hidden_dim']; B,N=x.shape[0],x.shape[1]
    x=F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias'])
    lp=F.linear(x,w['left_proj.weight']); rp=F.linear(x,w['right_proj.weight']); lg=F.linear(x,w['left_gate.weight']); rg=F.linear(x,w['right_gate.weight']); og=torch.sigmoid(F.linear(x,w['out_gate.weight']))
    m=mask.unsqueeze(-1); left=(lp*m*torch.sigmoid(lg)).to(torch.bfloat16); right=(rp*m*torch.sigmoid(rg)).to(torch.bfloat16)
    a=left.permute(0,3,1,2).reshape(B*H,N,N).contiguous(); b=right.permute(0,3,1,2).reshape(B*H,N,N).contiguous()
    out=torch.bmm(a,b.transpose(1,2)).reshape(B,H,N,N).permute(0,2,3,1).float()
    out=F.layer_norm(out,(H,),w['to_out_norm.weight'],w['to_out_norm.bias'])
    y=F.linear(out*og,w['to_out.weight']).float()
    torch.backends.cuda.matmul.allow_tf32=old
    return y

def bench(case):
 print('\\ncase',case)
 data=generate_input(**case)
 # exact ref with tf32 false
 old=torch.backends.cuda.matmul.allow_tf32; torch.backends.cuda.matmul.allow_tf32=False; torch.set_float32_matmul_precision('highest')
 for allow in [False, True]:
  y=fn(data,allow); torch.cuda.synchronize()
  torch.backends.cuda.matmul.allow_tf32=False; torch.set_float32_matmul_precision('highest')
  ok,msg=check_implementation(data,y); print('allow',allow,'ok exactref',ok,msg.split('\\n')[0] if msg else '')
  for _ in range(2): y=fn(data,allow); torch.cuda.synchronize(); del y
  ts=[]
  for _ in range(5):
   torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=fn(data,allow); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)); del y
  print('mean',sum(ts)/len(ts),'best',min(ts))
 torch.backends.cuda.matmul.allow_tf32=old


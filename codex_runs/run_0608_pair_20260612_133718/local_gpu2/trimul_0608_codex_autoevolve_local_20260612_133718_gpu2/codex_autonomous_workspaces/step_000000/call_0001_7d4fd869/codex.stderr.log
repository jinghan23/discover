+    BLOCK_H: tl.constexpr,
+):
+    row = tl.program_id(0)
+    h = tl.arange(0, BLOCK_H)
+    valid_h = h < H
+
+    b = row // n_pairs
+    rem = row - b * n_pairs
+    i = rem // N
+    j = rem - i * N
+    hmajor = ((b * H + h) * N + i) * N + j

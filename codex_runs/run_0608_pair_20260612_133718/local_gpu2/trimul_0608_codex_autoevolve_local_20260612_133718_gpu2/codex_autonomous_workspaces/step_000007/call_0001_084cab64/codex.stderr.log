+    a_ptrs = left + base + offs_m[:, None] * N + offs_k[None, :]
+    b_ptrs = right + base + offs_n[None, :] * N + offs_k[:, None]
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)

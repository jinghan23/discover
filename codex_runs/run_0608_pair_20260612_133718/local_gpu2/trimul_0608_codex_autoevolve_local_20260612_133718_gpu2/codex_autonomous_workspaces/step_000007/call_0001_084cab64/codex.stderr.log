import torch, time, math
from reference import generate_input, check_implementation
import submission as s

def evtime(fn):
    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return r, st.elapsed_time(en)*1000

cases=[
 {'seqlen':256,'bs':2,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
 {'seqlen':1024,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
 {'seqlen':256,'bs':2,'dim':384,'hiddendim':128,'seed':2301,'nomask':False,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'},
 {'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':23291,'nomask':True,'distribution':'normal'},
]
for cfg in cases:
    data=generate_input(**cfg); input_tensor, mask, weights, config=data; B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    print('\\ncase', cfg)
    # warmup full
    y=s.custom_kernel(data); torch.cuda.synchronize(); print('check', check_implementation(data,y)[0])
    times=[]
    for rep in range(3):
        if C==128 and mask.dtype is torch.float32:
            x,t=evtime(lambda: s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C));
            left_right_gate,t2=evtime(lambda: s._proj_gate_pack_c128_nomask(x,weights,B,N,H)); left,right,out_gate=left_right_gate
            out_h,t3=evtime(lambda: torch.bmm(left, right.transpose(1,2)))
            z,t4=evtime(lambda: s._norm_gate_from_gate(out_h,out_gate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16))
            out,t5=evtime(lambda: torch.mm(z.reshape(B*N*N,H), weights['to_out.weight'].to(torch.float16).t(), out_dtype=torch.float32).reshape(B,N,N,C))
            times.append((t,t2,t3,t4,t5,sum((t,t2,t3,t4,t5))))
        else:
            use_fp16=C==128
            x,t=evtime(lambda: (s._layernorm_fp16 if use_fp16 else s._layernorm_bf16)(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C));
            proj_dtype=torch.float16 if use_fp16 else torch.bfloat16
            proj_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(proj_dtype)
            proj,t2=evtime(lambda: torch.nn.functional.linear(x,proj_weight))
            if use_fp16:
                left_right,t25=evtime(lambda: s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H))
            else:
                left_right,t25=evtime(lambda: s._sigmoid_mask_layout_packed(proj,mask,B,N,H))
            left,right=left_right
            out_h,t3=evtime(lambda: torch.bmm(left, right.transpose(1,2)))
            z,t4=evtime(lambda: s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16))
            out,t5=evtime(lambda: torch.mm(z.reshape(B*N*N,H), weights['to_out.weight'].to(torch.float16).t(), out_dtype=torch.float32).reshape(B,N,N,C))
            times.append((t,t2,t25,t3,t4,t5,sum((t,t2,t25,t3,t4,t5))))
    print('times us')
    for row in times: print(row)

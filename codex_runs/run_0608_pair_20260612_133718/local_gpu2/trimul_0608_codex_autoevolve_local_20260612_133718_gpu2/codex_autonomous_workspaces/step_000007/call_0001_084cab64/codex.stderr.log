codex
A more promising low-risk knob is precision choice for the C=384 path. I’m testing FP16 instead of BF16 there; on A100 the tensor cores are both fast, but FP16 may reduce overhead and still fit the loose tolerance after layernorm.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as s

def fp16_c384(data):
 inp,mask,w,conf=data; B=inp.shape[0]; N=inp.shape[1]; C=conf['dim']; H=conf['hidden_dim']
 x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16)
 proj=F.linear(x,pw)
 left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
 oh=torch.bmm(left,right.transpose(1,2))
 z=s._norm_gate_packed(oh,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,torch.float16)
 return torch.mm(z.reshape(B*N*N,H), w['to_out.weight'].to(torch.float16).t(), out_dtype=torch.float32).reshape(B,N,N,C)

def ev(fn):
 torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); return r,a.elapsed_time(b)*1000
cases=[
 {'seqlen':256,'bs':2,'dim':384,'hiddendim':128,'seed':2301,'nomask':False,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'},
 {'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':23291,'nomask':True,'distribution':'normal'},
 {'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':5321,'nomask':False,'distribution':'cauchy'},
]
for cfg in cases:
 data=generate_input(**cfg)
 print('\\ncase',cfg)
 y=fp16_c384(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,y); print('check',ok,msg[:200] if msg else '')
 # time complete after compile
 for i in range(3):
  _,t=ev(lambda: fp16_c384(data)); print('fp16 full',t)
 for i in range(2):
  _,t=ev(lambda: s.custom_kernel(data)); print('base full',t)

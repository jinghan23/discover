The sparse masked prototype is much slower, mostly due to scatter and extra indexing. I’m going back to dense math and tuning the output layernorm/gate kernels, which have a smaller but consistent cost.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
from reference import generate_input
import submission as s

def norm_gate_from(out_h,out_gate,w,B,N,H,bm,warps):
 z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float16)
 s._norm_gate_from_gate_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,out_gate,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
 return z

def norm_gate_packed(out_h,proj,w,B,N,H,bm,warps):
 z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float16)
 s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
 return z

def ev(fn):
 torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); return r,a.elapsed_time(b)*1000
# c128 from_gate
for cfg in [
 {'seqlen':256,'bs':2,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
 {'seqlen':1024,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
]:
 data=generate_input(**cfg); inp,mask,w,conf=data; B=inp.shape[0];N=inp.shape[1];C=128;H=128
 x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C); l,r,og=s._proj_gate_pack_c128_nomask(x,w,B,N,H); oh=torch.bmm(l,r.transpose(1,2)); torch.cuda.synchronize()
 print('\\nfrom_gate',cfg)
 for bm in [16,32,64,128,256]:
  for warps in [4,8]:
   try:
    _,t=ev(lambda: norm_gate_from(oh,og,w,B,N,H,bm,warps)); _,t=ev(lambda: norm_gate_from(oh,og,w,B,N,H,bm,warps)); print(bm,warps,t)
   except Exception as e: print('fail',bm,warps,str(e)[:80])
# c384 packed
for cfg in [
 {'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'},
 {'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':23291,'nomask':True,'distribution':'normal'},
]:
 data=generate_input(**cfg); inp,mask,w,conf=data; B=inp.shape[0];N=inp.shape[1];C=384;H=128
 x=s._layernorm_bf16(inp,w['norm.weight'],w['norm.bias'],B,N,C); pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16); proj=torch.nn.functional.linear(x,pw); l,r=s._sigmoid_mask_layout_packed(proj,mask,B,N,H); oh=torch.bmm(l,r.transpose(1,2)); torch.cuda.synchronize()
 print('\\npacked',cfg)
 for bm in [16,32,64,128,256]:
  for warps in [4,8]:
   try:
    _,t=ev(lambda: norm_gate_packed(oh,proj,w,B,N,H,bm,warps)); _,t=ev(lambda: norm_gate_packed(oh,proj,w,B,N,H,bm,warps)); print(bm,warps,t)
   except Exception as e: print('fail',bm,warps,str(e)[:80])

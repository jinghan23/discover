+        mask=valid_c[None, :],
+        other=0.0,
+    ).to(tl.float16)
+    acc = tl.dot(z_mh, w, out_dtype=tl.float32)
+    tl.store(out + offs_m[:, None] * C + offs_c[None, :], acc, mask=valid_c[None, :])
+

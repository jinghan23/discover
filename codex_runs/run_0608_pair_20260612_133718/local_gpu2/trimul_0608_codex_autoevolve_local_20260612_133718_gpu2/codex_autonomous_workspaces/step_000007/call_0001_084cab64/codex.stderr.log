/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input
import submission as s

def ev(fn):
 torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); return r,a.elapsed_time(b)*1000
for cfg in [
 {'seqlen':256,'bs':2,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
 {'seqlen':1024,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
]:
 data=generate_input(**cfg); inp,mask,w,conf=data; B=inp.shape[0];N=inp.shape[1];C=128;H=128
 x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C); l,r,og=s._proj_gate_pack_c128_nomask(x,w,B,N,H); torch.cuda.synchronize()
 ref=torch.bmm(l,r.transpose(1,2)); torch.cuda.synchronize()
 print('\\ncase',cfg)
 for bm,bn,bk,warps in [(16,16,32,4),(16,32,32,4),(32,32,32,4),(32,32,64,4),(32,64,32,4),(64,32,32,4),(64,64,32,4),(64,64,64,4),(32,64,64,4),(32,32,64,8)]:
  try:
   out,t=ev(lambda: s._bmm_hmajor(l,r,B,N,H,block_m=bm,block_n=bn,block_k=bk,warps=warps));
   out,t=ev(lambda: s._bmm_hmajor(l,r,B,N,H,block_m=bm,block_n=bn,block_k=bk,warps=warps));
   diff=(out.float()-ref.float()).abs().max().item()
   print('tri',bm,bn,bk,warps,t,'diff',diff)
  except Exception as e: print('fail',bm,bn,bk,warps,str(e)[:100])
 for i in range(3):
  _,t=ev(lambda: torch.bmm(l,r.transpose(1,2))); print('torch',t)

+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
+    w_lg = tl.load(
+        left_gate_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,

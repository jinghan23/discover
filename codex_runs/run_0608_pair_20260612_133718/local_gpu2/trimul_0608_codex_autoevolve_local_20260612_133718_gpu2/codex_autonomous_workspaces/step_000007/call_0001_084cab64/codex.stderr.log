+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+
+    vals = tl.load(x + offs_m[None, :] * 128 + offs_c[:, None]).to(tl.float32)
+    mean = tl.sum(vals, axis=0) * (1.0 / 128.0)
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) * (1.0 / 128.0)
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_c).to(tl.float32)
+    nb = tl.load(norm_b + offs_c).to(tl.float32)
+    xnorm = (centered * inv[None, :] * nw[:, None] + nb[:, None]).to(tl.float16)
+    xv = tl.trans(xnorm)
+
+    w_l = tl.load(left_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    w_lg = tl.load(left_gate_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)

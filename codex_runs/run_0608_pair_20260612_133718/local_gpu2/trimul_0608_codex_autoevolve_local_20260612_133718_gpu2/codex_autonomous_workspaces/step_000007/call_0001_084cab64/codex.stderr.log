+def _ln_proj_gate_pack_c128_nomask_kernel(
+    x,
+    norm_w,
+    norm_b,
+    left_w,
+    right_w,
+    left_gate_w,
+    right_gate_w,
+    out_gate_w,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,

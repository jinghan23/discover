+@triton.jit
+def _ln_proj_gate_pack_c128_nomask_kernel(
+    x,
+    norm_w,
+    norm_b,
+    left_w,
+    right_w,
+    left_gate_w,
+    right_gate_w,
+    out_gate_w,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+
+    vals = tl.load(x + offs_m[None, :] * 128 + offs_c[:, None]).to(tl.float32)
+    mean = tl.sum(vals, axis=0) * (1.0 / 128.0)
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) * (1.0 / 128.0)
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_c).to(tl.float32)
+    nb = tl.load(norm_b + offs_c).to(tl.float32)
+    xnorm = (centered * inv[None, :] * nw[:, None] + nb[:, None]).to(tl.float16)
+    xv = tl.trans(xnorm)
+
+    w_l = tl.load(left_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    w_lg = tl.load(left_gate_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    lp = tl.dot(xv, w_l, out_dtype=tl.float32)
+    lg = tl.dot(xv, w_lg, out_dtype=tl.float32)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, lp * tl.sigmoid(lg))
+
+    w_r = tl.load(right_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    w_rg = tl.load(right_gate_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    rp = tl.dot(xv, w_r, out_dtype=tl.float32)
+    rg = tl.dot(xv, w_rg, out_dtype=tl.float32)
+    tl.store(right + hmajor, rp * tl.sigmoid(rg))
+
+    w_og = tl.load(out_gate_w + offs_h[None, :] * 128 + offs_c[:, None]).to(tl.float16)
+    og = tl.dot(xv, w_og, out_dtype=tl.float32)
+    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og)
+
+
+@triton.jit
+def _norm_gate_to_out_from_gate_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    to_out_w,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    C: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_c = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_c = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    valid_c = offs_c < C
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / H
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    gate_logits = tl.load(out_gate + offs_m[None, :] * H + offs_h[:, None]).to(tl.float32)
+    z = ((centered * inv[None, :] * nw[:, None] + nb[:, None]) * tl.sigmoid(gate_logits)).to(tl.float16)
+    z_mh = tl.trans(z)

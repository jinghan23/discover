+def _cached_empty(name: str, shape, device, dtype):
+    key = (name, tuple(shape), dtype, device.index)
+    out = _BUFFER_CACHE.get(key)
+    if out is None or out.shape != tuple(shape) or out.dtype != dtype or out.device != device:

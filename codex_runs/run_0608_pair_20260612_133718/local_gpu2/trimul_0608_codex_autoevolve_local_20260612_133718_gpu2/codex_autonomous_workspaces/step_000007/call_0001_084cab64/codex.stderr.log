+@triton.jit
+def _proj_gate_pack_c384_kernel(
+    x,
+    mask,
+    left_w,
+    right_w,
+    left_gate_w,
+    right_gate_w,
+    out_gate_w,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid_c = offs_c < C
+
+    xv = tl.load(
+        x + offs_m[:, None] * C + offs_c[None, :],
+        mask=valid_c[None, :],
+        other=0.0,
+    )
+
+    w_l = tl.load(
+        left_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
+    w_lg = tl.load(
+        left_gate_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
+    lp = tl.dot(xv, w_l, out_dtype=tl.float32)
+    lg = tl.dot(xv, w_lg, out_dtype=tl.float32)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    left_v = lp * tl.sigmoid(lg)
+
+    w_r = tl.load(
+        right_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
+    w_rg = tl.load(
+        right_gate_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
+    rp = tl.dot(xv, w_r, out_dtype=tl.float32)
+    rg = tl.dot(xv, w_rg, out_dtype=tl.float32)
+    right_v = rp * tl.sigmoid(rg)
+
+    if HAS_MASK:
+        m = tl.load(mask + offs_m).to(tl.float32)
+        left_v = left_v * m[:, None]
+        right_v = right_v * m[:, None]
+
+    tl.store(left + hmajor, left_v)
+    tl.store(right + hmajor, right_v)
+
+    w_og = tl.load(
+        out_gate_w + offs_h[None, :] * C + offs_c[:, None],
+        mask=valid_c[:, None],
+        other=0.0,
+    ).to(tl.bfloat16)
     og = tl.dot(xv, w_og, out_dtype=tl.float32)
     tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og)
 

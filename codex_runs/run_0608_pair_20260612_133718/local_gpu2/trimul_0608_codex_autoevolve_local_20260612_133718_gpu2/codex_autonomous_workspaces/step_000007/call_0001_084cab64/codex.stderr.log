/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as s

def masked_proto(data):
 inp,mask,w,conf=data; B=inp.shape[0]; N=inp.shape[1]; C=conf['dim']; H=conf['hidden_dim']; M=B*N*N
 x=s._layernorm_bf16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
 xf=x.reshape(M,C)
 idx=torch.nonzero(mask.reshape(M),as_tuple=False).flatten()
 xs=xf.index_select(0,idx)
 lrw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight']),dim=0).to(torch.bfloat16)
 proj_lr=F.linear(xs,lrw)
 og=F.linear(xf,w['out_gate.weight'].to(torch.bfloat16))
 left=torch.zeros((B*H,N,N),device=inp.device,dtype=torch.bfloat16)
 right=torch.zeros_like(left)
 lp=proj_lr[:,:H]; rp=proj_lr[:,H:2*H]; lg=proj_lr[:,2*H:3*H]; rg=proj_lr[:,3*H:4*H]
 lv=lp*torch.sigmoid(lg); rv=rp*torch.sigmoid(rg)
 b=idx//(N*N); rem=idx-b*(N*N); h=torch.arange(H,device=inp.device)
 hm=((b[:,None]*H+h[None,:])*(N*N)+rem[:,None]).reshape(-1)
 left.reshape(-1).scatter_(0,hm,lv.reshape(-1))
 right.reshape(-1).scatter_(0,hm,rv.reshape(-1))
 oh=torch.bmm(left,right.transpose(1,2))
 z=s._norm_gate_from_gate(oh,og,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,torch.float16)
 return torch.mm(z.reshape(M,H),w['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

def ev(fn):
 torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); return r,a.elapsed_time(b)*1000
for cfg in [
 {'seqlen':256,'bs':2,'dim':384,'hiddendim':128,'seed':2301,'nomask':False,'distribution':'normal'},
 {'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'},
]:
 data=generate_input(**cfg)
 print('\\ncase',cfg,'nonzero',int(data[1].sum().item()))
 y=masked_proto(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,y); print('check',ok,msg[:200] if msg else '')
 for i in range(3):
  _,t=ev(lambda: masked_proto(data)); print('proto',t)
 for i in range(3):
  _,t=ev(lambda: s.custom_kernel(data)); print('base',t)

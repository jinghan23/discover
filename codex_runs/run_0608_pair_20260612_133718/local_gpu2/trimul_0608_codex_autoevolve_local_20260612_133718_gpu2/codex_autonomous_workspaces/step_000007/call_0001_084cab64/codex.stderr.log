+
+    if HAS_MASK:
+        m = tl.load(mask + offs_m).to(tl.float32)
+        left_v = left_v * m[:, None]
+        right_v = right_v * m[:, None]
+
+    tl.store(left + hmajor, left_v)
+    tl.store(right + hmajor, right_v)
+
+    og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    for c0 in tl.static_range(0, 384, 128):

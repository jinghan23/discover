+@triton.jit
+def _bmm_hmajor_kernel(
+    left,
+    right,
+    out,
+    N: tl.constexpr,
+    n_pairs: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,

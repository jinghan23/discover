/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input, check_implementation
import submission as s

def ev(fn):
 torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); r=fn(); b.record(); torch.cuda.synchronize(); return r,a.elapsed_time(b)*1000
for cfg in [
 {'seqlen':256,'bs':2,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'},
 {'seqlen':1024,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'},
]:
 data=generate_input(**cfg); inp,mask,w,conf=data; B=inp.shape[0]; N=inp.shape[1]; C=128; H=128
 y=s.custom_kernel(data); torch.cuda.synchronize(); print('\\ncheck',cfg,check_implementation(data,y)[0])
 x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C); torch.cuda.synchronize()
 for i in range(5):
  _,t=ev(lambda: s._proj_gate_pack_c128_nomask(x,w,B,N,H)); print('proj',t)

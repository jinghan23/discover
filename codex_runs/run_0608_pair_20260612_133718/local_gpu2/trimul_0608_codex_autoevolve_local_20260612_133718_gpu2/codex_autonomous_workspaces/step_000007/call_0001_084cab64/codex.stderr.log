import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as s

def fsig(x):
 return 0.5 * (x / (1.0 + torch.abs(x))) + 0.5

def approx(data):
 inp,mask,w,conf=data; B=inp.shape[0];N=inp.shape[1];C=conf['dim'];H=conf['hidden_dim']; dtype=torch.float16 if C==128 else torch.bfloat16
 x=(s._layernorm_fp16 if C==128 else s._layernorm_bf16)(inp,w['norm.weight'],w['norm.bias'],B,N,C)
 pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
 proj=F.linear(x,pw)
 lp,rp,lg,rg,og=proj.split(H,dim=-1)
 m=mask.unsqueeze(-1)
 left=(lp*m*fsig(lg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
 right=(rp*m*fsig(rg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
 oh=torch.bmm(left,right.transpose(1,2))
 # norm exact-ish via existing needs packed gate, so manually
 out=oh.reshape(B,H,N,N).permute(0,2,3,1).contiguous()
 out=F.layer_norm(out,(H,),w['to_out_norm.weight'],w['to_out_norm.bias'],1e-5)
 out=out*fsig(og)
 return torch.mm(out.reshape(B*N*N,H).to(torch.float16),w['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
for cfg in [
 {'seqlen':32,'bs':1,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'},

import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as s

def custom_c384_fp16(data):
    input_tensor, mask, weights, config = data
    B,N=input_tensor.shape[0],input_tensor.shape[1]
    C=config['dim']; H=config['hidden_dim']
    x=s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    proj_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,proj_weight)
    left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)


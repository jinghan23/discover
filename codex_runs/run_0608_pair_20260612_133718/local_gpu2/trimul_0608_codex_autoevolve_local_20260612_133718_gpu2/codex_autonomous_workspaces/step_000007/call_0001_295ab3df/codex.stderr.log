 @triton.jit
+def _norm_gate_to_out_c128_kernel(
+    out_h,
+    out_gate,
+    norm_w,
+    norm_b,
+    to_out_w,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    GATE_STRIDE: tl.constexpr,
+    GATE_OFFSET: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_c = tl.arange(0, BLOCK_C)
+
+    b = rows // n_pairs
+    rem = rows - b * n_pairs
+    hm = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=1) / H
+    centered = vals - mean[:, None]
+    var = tl.sum(centered * centered, axis=1) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    gate_logits = tl.load(out_gate + rows[:, None] * GATE_STRIDE + GATE_OFFSET + offs_h[None, :]).to(tl.float32)
+    z = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]) * tl.sigmoid(gate_logits)
+
+    w = tl.load(to_out_w + offs_c[None, :] * H + offs_h[:, None]).to(tl.float32)
+    acc = tl.dot(z.to(tl.float16), w.to(tl.float16), out_dtype=tl.float32)
+    tl.store(out + rows[:, None] * BLOCK_C + offs_c[None, :], acc)

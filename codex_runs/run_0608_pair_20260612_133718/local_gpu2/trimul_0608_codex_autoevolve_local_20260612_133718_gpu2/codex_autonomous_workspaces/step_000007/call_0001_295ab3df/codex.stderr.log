/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission as s
for case in [dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')]:
    data=generate_input(**case); inp,mask,w,cfg=data; B,N,C,H=inp.shape[0],inp.shape[1],cfg['dim'],128
    x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
    proj_weight=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,proj_weight)
    left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2)); torch.cuda.synchronize()
    print('case',case)
    for bm,warps in [(16,4),(32,4),(32,8),(64,4),(64,8),(128,4),(128,8)]:
        z=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
        for _ in range(3):
            s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
        torch.cuda.synchronize(); times=[]
        for _ in range(20):
            ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record()
            s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
            ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
        print(bm,warps,sum(times)/len(times),min(times))

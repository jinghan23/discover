codex
Before changing `custom_kernel`, I’m timing the direct C384 helper in a standalone pipeline against the known path. That avoids taking a full evaluator hit if the tiled projection is slower than cuBLAS.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch
from reference import generate_input, check_implementation
import submission as s

def custom_c384_direct(data,bm=32,warps=4):
    input_tensor, mask, weights, config=data
    B,N=input_tensor.shape[0],input_tensor.shape[1]
    C=config['dim']; H=config['hidden_dim']
    x=s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    left,right,og=s._proj_gate_pack_c384(x,mask,weights,B,N,H,block_m=bm,warps=warps)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_from_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

cases=[dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=2301,nomask=False,distribution='normal'), dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')]
for bm,warps in [(16,4),(32,4),(32,8),(64,4),(64,8)]:
    print('variant',bm,warps)
    for case in cases:
        data=generate_input(**case)
        try:
            out=custom_c384_direct(data,bm,warps); torch.cuda.synchronize()
            good,msg=check_implementation(data,out)
            if not good:
                print('bad',case,msg[:100]); continue
            for _ in range(2): custom_c384_direct(data,bm,warps)
            torch.cuda.synchronize(); times=[]
            reps=5
            for _ in range(reps):
                ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record(); custom_c384_direct(data,bm,warps); ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
            print(case['seqlen'],case['nomask'],'mean',sum(times)/len(times),'best',min(times))
        except Exception as e:
            print('ERR',case,e)

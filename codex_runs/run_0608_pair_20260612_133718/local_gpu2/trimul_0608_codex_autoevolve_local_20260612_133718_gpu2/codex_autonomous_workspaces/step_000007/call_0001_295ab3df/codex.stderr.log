from submission import custom_kernel
cases=[dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal'), dict(seqlen=512,bs=1,dim=128,hiddendim=128,seed=12819,nomask=True,distribution='normal'), dict(seqlen=768,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'), dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')]

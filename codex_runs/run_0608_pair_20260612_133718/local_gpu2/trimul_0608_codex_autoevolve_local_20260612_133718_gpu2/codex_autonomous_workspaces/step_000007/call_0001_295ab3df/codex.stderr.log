            good,msg=check_implementation(data,out)
            print('check',case['seqlen'],case['nomask'],good,msg[:80])
            if not good: continue
            for _ in range(2): custom_c384_direct(data,bm,warps)
            torch.cuda.synchronize(); times=[]
            reps=5
            for _ in range(reps):
                ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record(); custom_c384_direct(data,bm,warps); ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
            print('time',sum(times)/len(times),'best',min(times))
        except Exception as e:

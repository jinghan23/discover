            ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record(); custom_c384_fp16(data); ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
        print('time',sum(times)/len(times),min(times))

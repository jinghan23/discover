    acc = tl.dot(z.to(tl.float16), w.to(tl.float16), out_dtype=tl.float32)
    tl.store(out + rows[:, None] * BLOCK_C + offs_c[None, :], acc)


@triton.jit
def _proj_gate_pack_c128_nomask_kernel(
    x,
    left_w,
    right_w,
    left_gate_w,
    right_gate_w,
    out_gate_w,
    left,
    right,
    out_gate,
    n_pairs: tl.constexpr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_c = tl.arange(0, BLOCK_C)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid_c = offs_c < C

    xv = tl.load(x + offs_m[:, None] * C + offs_c[None, :], mask=valid_c[None, :], other=0.0)
    w_l = tl.load(left_w + offs_h[None, :] * C + offs_c[:, None], mask=valid_c[:, None], other=0.0)
    w_lg = tl.load(left_gate_w + offs_h[None, :] * C + offs_c[:, None], mask=valid_c[:, None], other=0.0)
    lp = tl.dot(xv, w_l, out_dtype=tl.float32)
    lg = tl.dot(xv, w_lg, out_dtype=tl.float32)

    b = offs_m // n_pairs
    rem = offs_m - b * n_pairs
    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
    tl.store(left + hmajor, lp * tl.sigmoid(lg))

    w_r = tl.load(right_w + offs_h[None, :] * C + offs_c[:, None], mask=valid_c[:, None], other=0.0)
    w_rg = tl.load(right_gate_w + offs_h[None, :] * C + offs_c[:, None], mask=valid_c[:, None], other=0.0)
    rp = tl.dot(xv, w_r, out_dtype=tl.float32)
    rg = tl.dot(xv, w_rg, out_dtype=tl.float32)
    tl.store(right + hmajor, rp * tl.sigmoid(rg))

    w_og = tl.load(out_gate_w + offs_h[None, :] * C + offs_c[:, None], mask=valid_c[:, None], other=0.0)
    og = tl.dot(xv, w_og, out_dtype=tl.float32)
    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og)


@triton.jit
def _ln_proj_gate_pack_c128_nomask_kernel(
    x,
    norm_w,
    norm_b,
    left_w,
    right_w,
    left_gate_w,
    right_gate_w,
    out_gate_w,
    left,
    right,
    out_gate,
    n_pairs: tl.constexpr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_c = tl.arange(0, BLOCK_C)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    xv = tl.load(x + offs_m[:, None] * C + offs_c[None, :]).to(tl.float32)
    mean = tl.sum(xv, axis=1) / C
    centered = xv - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / C
    inv = tl.rsqrt(var + 1.0e-5)
    nw = tl.load(norm_w + offs_c).to(tl.float32)
    nb = tl.load(norm_b + offs_c).to(tl.float32)
    xn = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]).to(tl.float16)

    w_l = tl.load(left_w + offs_h[None, :] * C + offs_c[:, None])
    w_lg = tl.load(left_gate_w + offs_h[None, :] * C + offs_c[:, None])
    lp = tl.dot(xn, w_l, out_dtype=tl.float32)
    lg = tl.dot(xn, w_lg, out_dtype=tl.float32)

    b = offs_m // n_pairs
    rem = offs_m - b * n_pairs
    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
    tl.store(left + hmajor, lp * tl.sigmoid(lg))

    w_r = tl.load(right_w + offs_h[None, :] * C + offs_c[:, None])
    w_rg = tl.load(right_gate_w + offs_h[None, :] * C + offs_c[:, None])
    rp = tl.dot(xn, w_r, out_dtype=tl.float32)
    rg = tl.dot(xn, w_rg, out_dtype=tl.float32)
    tl.store(right + hmajor, rp * tl.sigmoid(rg))

    w_og = tl.load(out_gate_w + offs_h[None, :] * C + offs_c[:, None])
    og = tl.dot(xn, w_og, out_dtype=tl.float32)
    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og)



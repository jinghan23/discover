codex
One remaining small overhead is the per-call FP16 conversion of C128 projection weights. I’m testing an in-kernel weight cast variant in a standalone script; if repeated weight loads make it slower, I’ll leave the current pre-converted path.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton, triton.language as tl
from reference import generate_input
import submission as s

@triton.jit
def kern(x,left_w,right_w,left_gate_w,right_gate_w,out_gate_w,left,right,out_gate,n_pairs:tl.constexpr,C:tl.constexpr,H:tl.constexpr,BLOCK_M:tl.constexpr,BLOCK_C:tl.constexpr,BLOCK_H:tl.constexpr):
    pid_m=tl.program_id(0); pid_h=tl.program_id(1)
    offs_m=pid_m*BLOCK_M+tl.arange(0,BLOCK_M)
    offs_c=tl.arange(0,BLOCK_C); offs_h=pid_h*BLOCK_H+tl.arange(0,BLOCK_H)
    xv=tl.load(x+offs_m[:,None]*C+offs_c[None,:])
    w_l=tl.load(left_w+offs_h[None,:]*C+offs_c[:,None]).to(tl.float16)
    w_lg=tl.load(left_gate_w+offs_h[None,:]*C+offs_c[:,None]).to(tl.float16)
    lp=tl.dot(xv,w_l,out_dtype=tl.float32); lg=tl.dot(xv,w_lg,out_dtype=tl.float32)
    b=offs_m//n_pairs; rem=offs_m-b*n_pairs
    hmajor=(b[:,None]*H+offs_h[None,:])*n_pairs+rem[:,None]
    tl.store(left+hmajor,lp*tl.sigmoid(lg))
    w_r=tl.load(right_w+offs_h[None,:]*C+offs_c[:,None]).to(tl.float16)
    w_rg=tl.load(right_gate_w+offs_h[None,:]*C+offs_c[:,None]).to(tl.float16)
    rp=tl.dot(xv,w_r,out_dtype=tl.float32); rg=tl.dot(xv,w_rg,out_dtype=tl.float32)
    tl.store(right+hmajor,rp*tl.sigmoid(rg))
    w_og=tl.load(out_gate_w+offs_h[None,:]*C+offs_c[:,None]).to(tl.float16)
    og=tl.dot(xv,w_og,out_dtype=tl.float32)
    tl.store(out_gate+offs_m[:,None]*H+offs_h[None,:],og)

case=dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')
data=generate_input(**case); inp,mask,w,cfg=data; B,N,C,H=2,256,128,128

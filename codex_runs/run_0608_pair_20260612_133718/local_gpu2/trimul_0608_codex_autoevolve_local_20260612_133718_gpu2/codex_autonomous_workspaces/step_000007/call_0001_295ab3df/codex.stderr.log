import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as s
for C,N,B in [(128,1024,1),(384,1024,1),(384,768,1),(768,128,1)]:
    case=dict(seqlen=N,bs=B,dim=C,hiddendim=128,seed=123,nomask=True,distribution='normal')
    data=generate_input(**case); inp,mask,w,cfg=data
    print('C,N',C,N)
    # warm
    for _ in range(5):
        y=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C) if C<=384 else s._layernorm_bf16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
    torch.cuda.synchronize(); times=[]
    for _ in range(20):
        ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record()
        y=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C) if C<=384 else s._layernorm_bf16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
        ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
    print('triton',sum(times)/len(times),min(times), y.dtype)
    dtype=torch.float16 if C<=384 else torch.bfloat16
    for _ in range(5):
        y2=F.layer_norm(inp,(C,),w['norm.weight'],w['norm.bias']).to(dtype)
    torch.cuda.synchronize(); times=[]
    for _ in range(20):

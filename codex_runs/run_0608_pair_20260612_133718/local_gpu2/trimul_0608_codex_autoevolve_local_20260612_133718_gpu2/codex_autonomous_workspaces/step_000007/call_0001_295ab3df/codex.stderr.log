def custom_kernel(data: input_t) -> output_t:
    input_tensor, mask, weights, config = data
    B = input_tensor.shape[0]
    N = input_tensor.shape[1]
    C = config["dim"]
    H = config["hidden_dim"]

    use_fp16 = C == 128
    fused_c128_nomask = use_fp16 and mask.dtype is torch.float32
    if fused_c128_nomask:
        x = _layernorm_fp16(
            input_tensor,
            weights["norm.weight"],
            weights["norm.bias"],
            B,
            N,
            C,
        )
        left, right, out_gate = _proj_gate_pack_c128_nomask(
            x,
            weights,
            B,
            N,
            H,
        )
    else:
        if use_fp16:
            x = _layernorm_fp16(
                input_tensor,
                weights["norm.weight"],
                weights["norm.bias"],
                B,
                N,
                C,
            )
            proj_dtype = torch.float16
        else:
            x = _layernorm_bf16(
                input_tensor,
                weights["norm.weight"],
                weights["norm.bias"],
                B,
                N,
                C,
            )
            proj_dtype = torch.bfloat16

        proj_weight = torch.cat(
            (
                weights["left_proj.weight"],
                weights["right_proj.weight"],
                weights["left_gate.weight"],
                weights["right_gate.weight"],
                weights["out_gate.weight"],
            ),
            dim=0,
        ).to(proj_dtype)

        proj = F.linear(x, proj_weight)

        if use_fp16:
            left, right = _sigmoid_mask_layout_packed_fp16(
                proj,
                mask,
                B,
                N,
                H,
            )
        else:
            left, right = _sigmoid_mask_layout_packed(
                proj,
                mask,
                B,
                N,
                H,
            )

    out_h = torch.bmm(left, right.transpose(1, 2))
    final_dtype = torch.float16
    if fused_c128_nomask:
        z = _norm_gate_from_gate(
            out_h,
            out_gate,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            B,
            N,
            H,
            final_dtype,
        )
    else:
        z = _norm_gate_packed(
            out_h,
            proj,
            weights["to_out_norm.weight"],
            weights["to_out_norm.bias"],
            B,
            N,
            H,
            final_dtype,
        )
    return torch.mm(
        z.reshape(B * N * N, H),
        weights["to_out.weight"].to(final_dtype).t(),
        out_dtype=torch.float32,
    ).reshape(B, N, N, C)


codex
The direct C384 projection is not viable: it is much slower than the cuBLAS projection and has mask-path numerical issues from the prototype. I’m leaving the production path on `F.linear` and tuning the lightweight pack/norm kernels instead.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission as s
for case in [dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal'), dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')]:
    data=generate_input(**case); inp,mask,w,cfg=data; B,N,C,H=inp.shape[0],inp.shape[1],cfg['dim'],128
    x=s._layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
    proj_weight=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,proj_weight); torch.cuda.synchronize()
    print('case',case)
    for bm,bh,warps in [(16,64,4),(32,64,4),(32,64,8),(64,64,4),(64,64,8),(128,64,4),(64,128,4)]:
        try:
            left=torch.empty((B*H,N,N),device='cuda',dtype=torch.float16); right=torch.empty_like(left)
            grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
            kern=s._prep_packed_hmajor_nomask_kernel if mask.dtype is torch.float32 else s._prep_packed_hmajor_mask_kernel
            for _ in range(3):
                if mask.dtype is torch.float32:
                    kern[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
                else:
                    kern[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
            torch.cuda.synchronize(); times=[]
            for _ in range(20):
                ev1=torch.cuda.Event(True); ev2=torch.cuda.Event(True); ev1.record()
                if mask.dtype is torch.float32:
                    kern[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
                else:
                    kern[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
                ev2.record(); torch.cuda.synchronize(); times.append(ev1.elapsed_time(ev2)*1000)
            print(bm,bh,warps,sum(times)/len(times),min(times))
        except Exception as e:
            print('ERR',bm,bh,warps,e)

import torch, triton
import torch.nn.functional as F
from reference import generate_input
import submission as s

def norm_gate(out_h, gate, nw, nb, B,N,H,bm,bh,warps,packed=False):
  z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float32)
  if packed:
    s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,gate,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
  else:
    s._norm_gate_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,gate,nw,nb,z,N*N,N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
  return z
# create out_h/proj for cases using current helpers
for case, packed in [((1024,1,128,128,381,True,'cauchy'),False),((1024,1,384,128,23291,True,'normal'),True),((768,1,384,128,481,False,'normal'),True),((256,2,128,128,9371,True,'normal'),False)]:
  data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
  x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
  if packed:
    xn=s._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(xn,pw)
    l,r=s._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(l,r.transpose(1,2)); gate=proj
  else:
    xn=s._layernorm_fp32(x,w['norm.weight'],w['norm.bias'],B,N,C)
    tw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight']),dim=0)
    proj=F.linear(xn.to(torch.bfloat16) if N>256 else xn, tw.to(torch.bfloat16) if N>256 else tw)
    l,r=s._sigmoid_mask_layout_packed4(proj,mask,B,N,H)
    out_h=torch.bmm(l,r.transpose(1,2)); gate=F.linear(xn,w['out_gate.weight'])
  torch.cuda.synchronize()
  print('\\ncase',case,'packed',packed)
  for bm in [8,16,32,64,128]:
    for warps in [1,2,4,8]:
      try:
        z=norm_gate(out_h,gate,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,bm,128,warps,packed); torch.cuda.synchronize()
        times=[]
        for _ in range(8):
          st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); z=norm_gate(out_h,gate,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,bm,128,warps,packed); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
        print('bm',bm,'w',warps,'avg',sum(times)/len(times),'best',min(times))
      except Exception as e:
        print('fail',bm,warps,e)

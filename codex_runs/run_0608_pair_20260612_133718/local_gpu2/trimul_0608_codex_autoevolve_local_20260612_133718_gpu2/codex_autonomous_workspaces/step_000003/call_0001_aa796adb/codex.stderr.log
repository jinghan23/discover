import torch, triton
import torch.nn.functional as F
from reference import generate_input
import submission as s

def build_packed(data):
  x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
  xn=s._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
  pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
  proj=F.linear(xn,pw); l,r=s._sigmoid_mask_layout_packed(proj,mask,B,N,H); oh=torch.bmm(l,r.transpose(1,2)); torch.cuda.synchronize(); return oh,proj,w,B,N,H

def run(oh,proj,w,B,N,H,bm,warps):
  z=torch.empty((B,N,N,H),device=oh.device,dtype=torch.float32)
  s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](oh,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
  return z
for case in [(1024,1,128,128,381,True,'cauchy'),(1024,1,384,128,23291,True,'normal'),(768,1,384,128,481,False,'normal'),(768,1,128,128,381,True,'cauchy')]:
  data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
  oh,proj,w,B,N,H=build_packed(data)
  print('\\ncase',case)
  for bm in [8,16,32,64]:
    for warps in [1,2,4,8]:
      z=run(oh,proj,w,B,N,H,bm,warps); torch.cuda.synchronize()
      times=[]
      for _ in range(8):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); z=run(oh,proj,w,B,N,H,bm,warps); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
      print('bm',bm,'w',warps,'avg',sum(times)/len(times),'best',min(times))

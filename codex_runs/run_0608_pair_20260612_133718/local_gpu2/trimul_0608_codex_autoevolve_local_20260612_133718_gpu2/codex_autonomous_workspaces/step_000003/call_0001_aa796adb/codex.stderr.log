from pathlib import Path
import os, sys, math, tempfile
sys.path.insert(0, str(Path.cwd()))
from libkernelbot.consts import SubmissionMode
from libkernelbot.run_eval import run_config
from libkernelbot.task import build_task_config, make_task_definition

task=make_task_definition(Path('task.yml')).task
config=build_task_config(task=task, submission_content=Path('submission.py').read_text(), arch=None, mode=SubmissionMode.LEADERBOARD)
eval_root=Path.cwd()/'eval_tmp'; eval_root.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(prefix='detail_', dir=eval_root) as tmp_dir:
    old=os.getcwd(); os.chdir(tmp_dir)
    try: result=run_config(config)
    finally: os.chdir(old)
run=result.runs['leaderboard'].run
print('passed',run.passed)
vals=[]
for i in range(int(run.result['benchmark-count'])):
    mean=float(run.result[f'benchmark.{i}.mean'])/1000
    best=float(run.result[f'benchmark.{i}.best'])/1000
    err=float(run.result[f'benchmark.{i}.err'])/1000
    vals.append(mean)
    print(i, mean, 'best', best, 'err', err, run.result[f'benchmark.{i}.spec'])
print('geom', math.exp(sum(math.log(x) for x in vals)/len(vals)))

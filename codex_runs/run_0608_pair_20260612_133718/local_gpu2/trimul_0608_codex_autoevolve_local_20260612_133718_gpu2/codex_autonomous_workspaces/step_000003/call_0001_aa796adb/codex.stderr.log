+    lp_v = (tl.load(proj + base, mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws0[None, :]) * rstd[:, None] + wb0[None, :]
+    rp_v = (tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws1[None, :]) * rstd[:, None] + wb1[None, :]
+    lg_v = (tl.load(proj + base + (2 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws2[None, :]) * rstd[:, None] + wb2[None, :]
+    rg_v = (tl.load(proj + base + (3 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws3[None, :]) * rstd[:, None] + wb3[None, :]
+    og_v = (tl.load(proj + base + (4 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws4[None, :]) * rstd[:, None] + wb4[None, :]

def ln_meta(x,w,b,B,N,C,block_m,block_c,warps):
    y=torch.empty_like(x,dtype=torch.bfloat16)
    s._layernorm_bf16_kernel[(triton.cdiv(B*N*N,block_m),)](x,w,b,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps)

import torch, triton, math
import torch.nn.functional as F
from reference import generate_input, ref_kernel
from utils import verbose_allclose
import submission as s

def sig4_fp16(proj, mask, B,N,H):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    grid=(triton.cdiv(B*N*N,16), triton.cdiv(H,64))
    if mask.dtype is torch.float32:
        s._prep_packed4_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=16,BLOCK_H=64,num_warps=4)
    else:
        s._prep_packed4_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=16,BLOCK_H=64,num_warps=4)
    return left,right

def sig5_fp16(proj, mask, B,N,H):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    grid=(triton.cdiv(B*N*N,16), triton.cdiv(H,64))
    if mask.dtype is torch.float32:
        s._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=16,BLOCK_H=64,num_warps=4)
    else:
        s._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=16,BLOCK_H=64,num_warps=4)
    return left,right

def custom_fp16(data):
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    if C==128:
      if not (B==1 and N==768):
        x=s._layernorm_fp32(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
        tri_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight']),dim=0)
        if N<=256:
          tri_proj=F.linear(x,tri_weight).to(torch.float16)
        else:
          tri_proj=F.linear(x.to(torch.float16),tri_weight.to(torch.float16))
        out_gate_logits=F.linear(x,weights['out_gate.weight'])
        left,right=sig4_fp16(tri_proj,mask,B,N,H)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=s._norm_gate(out_h,out_gate_logits,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
        return F.linear(z,weights['to_out.weight']).to(torch.float32)
      x=s._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C).to(torch.float16)
      pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
      proj=F.linear(x,pw)
      left,right=sig5_fp16(proj,mask,B,N,H)
      out_h=torch.bmm(left,right.transpose(1,2))
      z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
      return F.linear(z,weights['to_out.weight']).to(torch.float32)
    x=s._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C).to(torch.float16)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=sig5_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

cases=[(256,2,128,128,9371,True,'normal'),(768,1,128,128,381,True,'cauchy'),(1024,1,128,128,381,True,'cauchy'),(1024,1,384,128,23291,True,'normal')]
for case in cases:
    print('\\ncase',case)
    data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
    out=custom_fp16(data); exp=ref_kernel(data); torch.cuda.synchronize()
    ok,msg=verbose_allclose(out,exp,rtol=2e-2,atol=2e-2,max_print=3)
    print('ok',ok,msg[:300])
    # time rough 5
    times=[]
    for _ in range(5):
      st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=custom_fp16(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
    print('time us',sum(times)/len(times), 'best',min(times))

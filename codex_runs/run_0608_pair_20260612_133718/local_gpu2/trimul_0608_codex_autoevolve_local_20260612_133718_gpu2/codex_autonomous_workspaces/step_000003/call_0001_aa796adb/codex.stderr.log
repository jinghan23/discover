+    wb2 = tl.load(wbias + (2 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    wb3 = tl.load(wbias + (3 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
+    wb4 = tl.load(wbias + (4 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)

codex
The N=256 C=128 path still uses FP32 for the left/right/gate projection to preserve the tight output gate margin. I’m testing a narrower mixed path: keep `out_gate` FP32, but compute only the four left/right projections in BF16.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input, ref_kernel
from utils import verbose_allclose
import submission as s

def c128_n256_mixed(data):
    x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
    xn=s._layernorm_fp32(x,w['norm.weight'],w['norm.bias'],B,N,C)
    tw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight']),dim=0).to(torch.bfloat16)
    tri=F.linear(xn.to(torch.bfloat16),tw)
    og=F.linear(xn,w['out_gate.weight'])
    l,r=s._sigmoid_mask_layout_packed4(tri,mask,B,N,H)
    oh=torch.bmm(l,r.transpose(1,2))
    z=s._norm_gate(oh,og,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H)
    return F.linear(z,w['to_out.weight']).float()
for case in [(256,2,128,128,9371,True,'normal'),(256,1,128,128,1932,True,'normal'),(256,1,128,128,10432,False,'normal'),(256,1,128,128,932,True,'cauchy'),(32,1,128,128,9371,True,'normal')]:
  print('\\ncase',case)
  data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
  out=c128_n256_mixed(data); exp=ref_kernel(data); torch.cuda.synchronize()
  ok,msg=verbose_allclose(out,exp,rtol=2e-2,atol=2e-2,max_print=3)
  print('ok',ok,msg[:300])
  times=[]
  for _ in range(8):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=c128_n256_mixed(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
  print('avg',sum(times)/len(times),'best',min(times), 'times', times)

import torch, triton
import torch.nn.functional as F
from reference import generate_input
import submission as s

def prep5(proj,mask,B,N,H,bm,bh,warps):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    if mask.dtype is torch.float32:
      s._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
      s._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

def prep4(proj,mask,B,N,H,bm,bh,warps):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    if mask.dtype is torch.float32:
      s._prep_packed4_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
      s._prep_packed4_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

for case, packed4 in [((1024,1,384,128,23291,True,'normal'),False),((768,1,384,128,481,False,'normal'),False),((1024,1,128,128,381,True,'cauchy'),True),((256,2,128,128,9371,True,'normal'),True)]:
    data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
    x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
    if packed4:
      xnorm=s._layernorm_fp32(x,w['norm.weight'],w['norm.bias'],B,N,C)
      tw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight']),dim=0)
      proj=F.linear(xnorm.to(torch.bfloat16) if N>256 else xnorm, tw.to(torch.bfloat16) if N>256 else tw)
      fn=prep4
    else:
      xnorm=s._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
      tw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
      proj=F.linear(xnorm,tw)
      fn=prep5
    torch.cuda.synchronize()
    print('\\ncase',case,'packed4',packed4)
    for bm in [8,16,32,64]:
      for bh in [32,64,128]:
        for warps in [4,8]:
          if bm*bh>8192: continue
          try:
            l,r=fn(proj,mask,B,N,H,bm,bh,warps); torch.cuda.synchronize()
            times=[]
            for _ in range(8):
              st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); l,r=fn(proj,mask,B,N,H,bm,bh,warps); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
            print('bm',bm,'bh',bh,'w',warps,'avg',sum(times)/len(times),'best',min(times))
          except Exception as e:

import torch, math, triton
import torch.nn.functional as F
from reference import generate_input, ref_kernel
from utils import verbose_allclose
import submission as s

def formula_custom(data, use_bf16_input=True):
    x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
    rows=B*N*N
    ww=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0)
    wg=ww * w['norm.weight'][None,:]
    wb=(ww * w['norm.bias'][None,:]).sum(dim=1)
    wsum=wg.sum(dim=1)
    xf=x.reshape(rows,C)
    mean=xf.mean(dim=1)
    var=((xf-mean[:,None])**2).mean(dim=1)
    rstd=torch.rsqrt(var+1e-5)
    if use_bf16_input:
      S=F.linear(x.to(torch.bfloat16), wg.to(torch.bfloat16))
    else:
      S=F.linear(x, wg)
    proj=(S.float() - mean.reshape(B,N,N,1)*wsum.reshape(1,1,1,-1))*rstd.reshape(B,N,N,1)+wb.reshape(1,1,1,-1)
    # maybe cast proj to bf16 like current F.linear bf16 output
    proj=proj.to(torch.bfloat16)
    left,right=s._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_packed(out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H)
    return F.linear(z,w['to_out.weight']).float()

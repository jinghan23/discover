+    mean = tl.sum(vals, axis=0) / C
+    centered = tl.where(valid_c[:, None], vals - mean[None, :], 0.0)
+    var = tl.sum(centered * centered, axis=0) / C
+    rstd = tl.rsqrt(var + 1.0e-5)
+
+    tl.store(y + rows[None, :] * C + offs_c[:, None], vals, mask=valid_c[:, None])
+    tl.store(stats + rows * 2, mean)
+    tl.store(stats + rows * 2 + 1, rstd)

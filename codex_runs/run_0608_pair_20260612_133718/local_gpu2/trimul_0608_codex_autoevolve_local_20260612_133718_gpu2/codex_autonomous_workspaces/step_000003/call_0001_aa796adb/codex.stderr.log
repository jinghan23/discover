/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton, math
import torch.nn.functional as F
from reference import generate_input, ref_kernel
from utils import verbose_allclose
import submission as s

def c128_packed(data):
    x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
    xn=s._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(xn,pw)
    left,right=s._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_packed(out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H)
    return F.linear(z,w['to_out.weight']).to(torch.float32)

cases=[(256,2,128,128,9371,True,'normal'),(512,1,128,128,12819,True,'normal'),(768,1,128,128,381,True,'cauchy'),(1024,1,128,128,381,True,'cauchy'),(256,1,128,128,932,True,'cauchy'),(256,1,128,128,10432,False,'normal'),(768,2,128,128,31,True,'cauchy')]
for case in cases:
  print('\\ncase',case)
  data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
  out=c128_packed(data); exp=ref_kernel(data); torch.cuda.synchronize()
  ok,msg=verbose_allclose(out,exp,rtol=2e-2,atol=2e-2,max_print=5)
  print('ok',ok,msg[:500])
  times=[]
  for _ in range(5):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=c128_packed(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
  print('time avg',sum(times)/len(times),'best',min(times))

@triton.jit
def _prep_adjust_packed_hmajor_mask_kernel(
    proj,
    stats,
    wsum,
    wbias,
    mask,
    left,
    right,
    n_pairs: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid_h = offs_h < H

    b = offs_m // n_pairs
    rem = offs_m - b * n_pairs
    base = offs_m[:, None] * (5 * H) + offs_h[None, :]
    valid = valid_h[None, :]
    mean = tl.load(stats + offs_m * 2).to(tl.float32)
    rstd = tl.load(stats + offs_m * 2 + 1).to(tl.float32)
    m = tl.load(mask + offs_m).to(tl.float32)

    ws0 = tl.load(wsum + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    ws1 = tl.load(wsum + H + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    ws2 = tl.load(wsum + (2 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    ws3 = tl.load(wsum + (3 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    ws4 = tl.load(wsum + (4 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    wb0 = tl.load(wbias + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    wb1 = tl.load(wbias + H + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    wb2 = tl.load(wbias + (2 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    wb3 = tl.load(wbias + (3 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)
    wb4 = tl.load(wbias + (4 * H) + offs_h, mask=valid_h, other=0.0).to(tl.float32)

    lp_v = (tl.load(proj + base, mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws0[None, :]) * rstd[:, None] + wb0[None, :]
    rp_v = (tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws1[None, :]) * rstd[:, None] + wb1[None, :]
    lg_v = (tl.load(proj + base + (2 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws2[None, :]) * rstd[:, None] + wb2[None, :]
    rg_v = (tl.load(proj + base + (3 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws3[None, :]) * rstd[:, None] + wb3[None, :]
    og_v = (tl.load(proj + base + (4 * H), mask=valid, other=0.0).to(tl.float32) - mean[:, None] * ws4[None, :]) * rstd[:, None] + wb4[None, :]

    tl.store(proj + base, lp_v, mask=valid)
    tl.store(proj + base + H, rp_v, mask=valid)
    tl.store(proj + base + (2 * H), lg_v, mask=valid)
    tl.store(proj + base + (3 * H), rg_v, mask=valid)
    tl.store(proj + base + (4 * H), og_v, mask=valid)

    left_v = lp_v * m[:, None] * tl.sigmoid(lg_v)
    right_v = rp_v * m[:, None] * tl.sigmoid(rg_v)
    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
    tl.store(left + hmajor, left_v, mask=valid)
    tl.store(right + hmajor, right_v, mask=valid)

def _sigmoid_mask_layout_packed4(proj, mask, B: int, N: int, H: int):
    left = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
    right = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
    block_m = 32 if N >= 512 else 16
    block_h = 128 if N >= 512 else 64
    grid = (triton.cdiv(B * N * N, block_m), triton.cdiv(H, block_h))
    if mask.dtype is torch.float32:
        _prep_packed4_hmajor_nomask_kernel[grid](
            proj,
            left,
            right,
            N * N,
            H,
            BLOCK_M=block_m,
            BLOCK_H=block_h,
            num_warps=4,
        )
    else:
        _prep_packed4_hmajor_mask_kernel[grid](
            proj,
            mask,
            left,
            right,
            N * N,
            H,
            BLOCK_M=block_m,
            BLOCK_H=block_h,
            num_warps=4,
        )
    return left, right



/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input, ref_kernel
from utils import verbose_allclose
import submission as s

def outgate_mm(xb,w):
    a=xb.reshape(-1, xb.shape[-1])
    b=w.t().to(torch.bfloat16)
    try:
        y=torch.mm(a,b,out_dtype=torch.float32)
        return y.reshape(*xb.shape[:-1], w.shape[0])
    except Exception as e:
        print('mm out_dtype failed',type(e),e)
        return F.linear(xb,b.t()).float()

def c128_bf16_gatefp32(data):
    x,mask,w,c=data; B,N,C,H=x.shape[0],x.shape[1],c['dim'],c['hidden_dim']
    xb=s._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
    tw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight']),dim=0).to(torch.bfloat16)
    tri=F.linear(xb,tw)
    og=outgate_mm(xb,w['out_gate.weight'])
    l,r=s._sigmoid_mask_layout_packed4(tri,mask,B,N,H)
    oh=torch.bmm(l,r.transpose(1,2))
    z=s._norm_gate(oh,og,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H)
    return F.linear(z,w['to_out.weight']).float()
for case in [(512,1,128,128,12819,True,'normal'),(1024,1,128,128,381,True,'cauchy'),(768,1,128,128,381,True,'cauchy'),(256,2,128,128,9371,True,'normal')]:
  print('\\ncase',case)
  data=generate_input(seqlen=case[0],bs=case[1],dim=case[2],hiddendim=case[3],seed=case[4],nomask=case[5],distribution=case[6])
  out=c128_bf16_gatefp32(data); exp=ref_kernel(data); torch.cuda.synchronize()
  ok,msg=verbose_allclose(out,exp,rtol=2e-2,atol=2e-2,max_print=3)
  print('ok',ok,msg[:300])
  times=[]
  for _ in range(6):
    st=torch.cuda.Event(True); en=torch.cuda.Event(True); torch.cuda.synchronize(); st.record(); out=c128_bf16_gatefp32(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
  print('avg',sum(times)/len(times),'best',min(times), times)

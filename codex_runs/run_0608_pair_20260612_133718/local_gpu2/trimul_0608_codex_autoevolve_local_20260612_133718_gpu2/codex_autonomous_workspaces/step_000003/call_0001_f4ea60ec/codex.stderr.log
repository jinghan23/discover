   126	    proj,
   127	    left,
   128	    right,
   129	    n_pairs: tl.constexpr,
   130	    H: tl.constexpr,
   131	    BLOCK_M: tl.constexpr,
   132	    BLOCK_H: tl.constexpr,
   133	):
   134	    pid_m = tl.program_id(0)
   135	    pid_h = tl.program_id(1)
   136	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   137	    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
   138	    valid_h = offs_h < H
   139	
   140	    b = offs_m // n_pairs
   141	    rem = offs_m - b * n_pairs
   142	    base = offs_m[:, None] * (5 * H) + offs_h[None, :]
   143	    valid = valid_h[None, :]
   144	
   145	    lp_v = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
   146	    rp_v = tl.load(proj + base + H, mask=valid, other=0.0).to(tl.float32)
   147	    lg_v = tl.load(proj + base + (2 * H), mask=valid, other=0.0).to(tl.float32)
   148	    rg_v = tl.load(proj + base + (3 * H), mask=valid, other=0.0).to(tl.float32)
   149	    left_v = lp_v * tl.sigmoid(lg_v)
   150	    right_v = rp_v * tl.sigmoid(rg_v)
   151	
   152	    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
   153	    tl.store(left + hmajor, left_v, mask=valid)
   154	    tl.store(right + hmajor, right_v, mask=valid)

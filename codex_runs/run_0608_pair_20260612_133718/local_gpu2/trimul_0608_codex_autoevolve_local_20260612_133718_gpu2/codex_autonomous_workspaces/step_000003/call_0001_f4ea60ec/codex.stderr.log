   115	    rg_v = tl.load(proj + base + (3 * H), mask=load_valid, other=0.0).to(tl.float32)
   116	    left_v = lp_v * m[:, None] * tl.sigmoid(lg_v)
   117	    right_v = rp_v * m[:, None] * tl.sigmoid(rg_v)
   118	
   119	    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
   120	    tl.store(left + hmajor, left_v, mask=valid)
   121	    tl.store(right + hmajor, right_v, mask=valid)

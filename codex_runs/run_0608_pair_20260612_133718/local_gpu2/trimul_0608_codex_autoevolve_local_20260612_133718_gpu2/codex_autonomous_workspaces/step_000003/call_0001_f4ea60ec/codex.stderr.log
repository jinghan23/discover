import torch, torch.nn.functional as F
from reference import generate_input
import submission
c=dict(seqlen=16, bs=1, dim=384, hiddendim=128, seed=1, nomask=True, distribution='normal')
data=generate_input(**c)
input_tensor,mask,weights,config=data
B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
x=submission._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
print('x',x.dtype)
pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
proj=F.linear(x,pw); print('proj',proj.dtype)
left,right=submission._sigmoid_mask_layout_packed(proj,mask,B,N,H); print(left.dtype,right.dtype)
out_h=torch.bmm(left,right.transpose(1,2)); print('out_h',out_h.dtype)
z=submission._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H); print('z',z.dtype,weights['to_out.weight'].dtype)
y=F.linear(z,weights['to_out.weight']); print('y', y.dtype)

/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission

def make_proj(data):
    input_tensor,mask,weights,config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    x=submission._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw); torch.cuda.synchronize()
    return proj,mask,B,N,H

def prep_variant(proj,mask,B,N,H,bm,bh,warps,maskcase):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.bfloat16)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    if maskcase:
        submission._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        submission._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

def bench(args,bm,bh,warps,maskcase,it=20):
    proj,mask,B,N,H=args
    for _ in range(5):
        l,r=prep_variant(proj,mask,B,N,H,bm,bh,warps,maskcase); torch.cuda.synchronize(); del l,r
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); l,r=prep_variant(proj,mask,B,N,H,bm,bh,warps,maskcase); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del l,r
    return sum(ts)/len(ts)

cases=[
 ('c128n1024', dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'), False),
 ('c384n1024', dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), False),
 ('c384n768mask', dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'), True),
 ('c384n256maskb2', dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'), True),
]
for name,c,maskcase in cases:
    data=generate_input(**c)
    args=make_proj(data)
    print('\\n',name)
    for bm in [8,16,32,64]:
      for bh in [32,64,128]:
        for warps in [4,8]:
          try:
            t=bench(args,bm,bh,warps,maskcase,8)
            print('bm',bm,'bh',bh,'warps',warps,'us',round(t,3))
          except Exception as e:
            print('ERR',bm,bh,warps,type(e).__name__,str(e)[:100])
    del data,args
    torch.cuda.empty_cache()

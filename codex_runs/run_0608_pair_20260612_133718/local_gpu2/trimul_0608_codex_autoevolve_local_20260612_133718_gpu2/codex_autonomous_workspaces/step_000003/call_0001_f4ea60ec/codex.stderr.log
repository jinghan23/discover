codex
Another precision lever is FP16 rather than BF16 for the packed projection and contraction. FP16 has the same tensor-core throughput on A100 and more mantissa bits, but less exponent range, so I’m testing it against the Cauchy cases before considering it.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
import submission

def sigmoid_mask_layout_fp16(proj,mask,B,N,H):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    if mask.dtype is torch.float32:
        grid=(triton.cdiv(B*N*N,64),triton.cdiv(H,64))
        submission._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=64,BLOCK_H=64,num_warps=8)
    else:
        grid=(triton.cdiv(B*N*N,32),triton.cdiv(H,64))
        submission._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=32,BLOCK_H=64,num_warps=4)
    return left,right

def alt_fp16(data):
    input_tensor,mask,weights,config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    x=torch.empty_like(input_tensor,dtype=torch.float16)
    bm=16 if C<=512 else 8; bc=128 if C<=128 else (256 if C<=256 else (512 if C<=512 else 1024)); warps=4 if C<=256 else 8
    submission._layernorm_bf16_kernel[(triton.cdiv(B*N*N,bm),)](input_tensor,weights['norm.weight'],weights['norm.bias'],x,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=sigmoid_mask_layout_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=submission._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def bench(fn,data,it=8):
    for _ in range(4):
        o=fn(data); torch.cuda.synchronize(); del o
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del o
    return sum(ts)/len(ts)

cases=[
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=5321, nomask=False, distribution='cauchy'),
]
for c in cases:
    data=generate_input(**c)
    out=alt_fp16(data); torch.cuda.synchronize()
    ok,msg=check_implementation(data,out)
    print('case',c,'ok',ok,msg[:200])
    if ok:
        print('current',bench(submission.custom_kernel,data,5),'fp16',bench(alt_fp16,data,5))
    del data,out
    torch.cuda.empty_cache()

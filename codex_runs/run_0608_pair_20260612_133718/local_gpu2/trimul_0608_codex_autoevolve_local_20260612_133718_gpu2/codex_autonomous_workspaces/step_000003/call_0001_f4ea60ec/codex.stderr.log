import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission

def make_outh(data):
    input_tensor,mask,weights,config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    if C==128:
        x=submission._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.float16; layout=submission._sigmoid_mask_layout_packed_fp16
    else:
        x=submission._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.bfloat16; layout=submission._sigmoid_mask_layout_packed
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,pw)
    left,right=layout(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2)); torch.cuda.synchronize()
    return out_h,proj,weights,B,N,H

def norm_variant(args,bm,warps):
    out_h,proj,weights,B,N,H=args
    z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float32)
    submission._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    return z

def bench(args,bm,warps,it=20):
    for _ in range(5):
        z=norm_variant(args,bm,warps); torch.cuda.synchronize(); del z
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); z=norm_variant(args,bm,warps); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del z
    return sum(ts)/len(ts)


/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission

def make_proj(data):
    input_tensor,mask,weights,config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    x=submission._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw); torch.cuda.synchronize()
    return proj,mask,B,N,H

def prep_fp16(args,bm,bh,warps,maskcase):
    proj,mask,B,N,H=args
    left=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    right=torch.empty((B*H,N,N),device=proj.device,dtype=torch.float16)
    grid=(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))
    if maskcase:
        submission._prep_packed_hmajor_mask_kernel[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        submission._prep_packed_hmajor_nomask_kernel[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

def bench(args,bm,bh,warps,maskcase,it=10):
    for _ in range(5):
        l,r=prep_fp16(args,bm,bh,warps,maskcase); torch.cuda.synchronize(); del l,r
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); l,r=prep_fp16(args,bm,bh,warps,maskcase); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del l,r
    return sum(ts)/len(ts)

cases=[('n256b2',dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),False),('n1024',dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),False),('n256mask',dict(seqlen=256, bs=1, dim=128, hiddendim=128, seed=10432, nomask=False, distribution='normal'),True)]
for name,c,maskcase in cases:
    data=generate_input(**c); args=make_proj(data)
    print('\\n',name)
    for bm in [16,32,64,128]:
      for bh in [32,64,128]:
        for warps in [4,8]:
          try: print('bm',bm,'bh',bh,'w',warps,'us',round(bench(args,bm,bh,warps,maskcase,6),3))
          except Exception as e: print('ERR',bm,bh,warps,type(e).__name__,str(e)[:80])
    del data,args
    torch.cuda.empty_cache()

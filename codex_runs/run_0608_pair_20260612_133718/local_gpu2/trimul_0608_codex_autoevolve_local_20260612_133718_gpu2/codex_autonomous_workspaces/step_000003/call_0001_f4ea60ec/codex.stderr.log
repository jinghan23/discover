   157	@triton.jit
   158	def _norm_gate_packed_tile_kernel(
   159	    out_h,
   160	    out_gate_packed,
   161	    norm_w,
   162	    norm_b,
   163	    z,
   164	    n_pairs: tl.constexpr,
   165	    H: tl.constexpr,
   166	    BLOCK_M: tl.constexpr,
   167	    BLOCK_H: tl.constexpr,
   168	):
   169	    pid = tl.program_id(0)
   170	    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
   171	    offs_h = tl.arange(0, BLOCK_H)
   172	
   173	    b = offs_m // n_pairs
   174	    rem = offs_m - b * n_pairs
   175	    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
   176	    vals = tl.load(out_h + hm).to(tl.float32)
   177	
   178	    mean = tl.sum(vals, axis=0) / H
   179	    centered = vals - mean[None, :]
   180	    var = tl.sum(centered * centered, axis=0) / H
   181	    inv = tl.rsqrt(var + 1.0e-5)
   182	
   183	    nw = tl.load(norm_w + offs_h).to(tl.float32)
   184	    nb = tl.load(norm_b + offs_h).to(tl.float32)
   185	    cl = offs_m[None, :] * H + offs_h[:, None]
   186	    gate_logits = tl.load(out_gate_packed + offs_m[None, :] * (5 * H) + (4 * H) + offs_h[:, None]).to(tl.float32)
   187	    gate = tl.sigmoid(gate_logits)
   188	    out = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
   189	    tl.store(z + cl, out)
   190	
   191	
   192	@triton.jit
   193	def _norm_gate_out128_kernel(
   194	    out_h,
   195	    out_gate_packed,
   196	    norm_w,
   197	    norm_b,
   198	    to_out_w,
   199	    out,
   200	    n_pairs: tl.constexpr,
   201	    H: tl.constexpr,
   202	    BLOCK_M: tl.constexpr,
   203	    BLOCK_H: tl.constexpr,
   204	    BLOCK_C: tl.constexpr,
   205	):
   206	    pid = tl.program_id(0)
   207	    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
   208	    offs_h = tl.arange(0, BLOCK_H)
   209	    offs_c = tl.arange(0, BLOCK_C)
   210	
   211	    b = offs_m // n_pairs
   212	    rem = offs_m - b * n_pairs
   213	    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
   214	    vals = tl.load(out_h + hm).to(tl.float32)
   215	
   216	    mean = tl.sum(vals, axis=0) / H
   217	    centered = vals - mean[None, :]
   218	    var = tl.sum(centered * centered, axis=0) / H
   219	    inv = tl.rsqrt(var + 1.0e-5)
   220	
   221	    nw = tl.load(norm_w + offs_h).to(tl.float32)
   222	    nb = tl.load(norm_b + offs_h).to(tl.float32)
   223	    gate_logits = tl.load(
   224	        out_gate_packed + offs_m[None, :] * (5 * H) + (4 * H) + offs_h[:, None]
   225	    ).to(tl.float32)
   226	    gate = tl.sigmoid(gate_logits)
   227	    z = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
   228	
   229	    w = tl.load(to_out_w + offs_c[None, :] * H + offs_h[:, None]).to(tl.float32)
   230	    acc = tl.dot(tl.trans(z), w, input_precision="tf32")
   231	    tl.store(out + offs_m[:, None] * BLOCK_C + offs_c[None, :], acc)
   232	

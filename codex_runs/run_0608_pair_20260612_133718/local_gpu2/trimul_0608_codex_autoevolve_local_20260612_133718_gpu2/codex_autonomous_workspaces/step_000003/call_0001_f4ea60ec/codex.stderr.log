import torch, triton
from reference import generate_input
import submission

def ln_variant(input_tensor,w,b,B,N,C,bm,bc,warps,dtype=torch.bfloat16):
    y=torch.empty_like(input_tensor,dtype=dtype)
    rows=B*N*N
    submission._layernorm_bf16_kernel[(triton.cdiv(rows,bm),)](input_tensor,w,b,y,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
    return y

def bench_ln(data,bm,bc,warps,it=20):
    input_tensor,mask,weights,config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']
    for _ in range(5):
        y=ln_variant(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,bm,bc,warps); torch.cuda.synchronize(); del y
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=ln_variant(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,bm,bc,warps); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del y
    return sum(ts)/len(ts)

cases=[
 ('c128n1024', dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'), [128]),
 ('c128n256b2', dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'), [128]),
 ('c384n1024', dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), [512]),
 ('c384n768', dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'), [512]),
]
for name,c,bcs in cases:
    data=generate_input(**c)
    print('\\n',name)
    for bc in bcs:
      for bm in [4,8,16,32,64]:
        for warps in ([4,8] if bc>=512 else [1,2,4,8]):
          try:
            t=bench_ln(data,bm,bc,warps,10)
            print('bm',bm,'bc',bc,'warps',warps,'us',round(t,3))
          except Exception as e:
            print('ERR',bm,bc,warps,type(e).__name__,str(e)[:80])
    del data
    torch.cuda.empty_cache()

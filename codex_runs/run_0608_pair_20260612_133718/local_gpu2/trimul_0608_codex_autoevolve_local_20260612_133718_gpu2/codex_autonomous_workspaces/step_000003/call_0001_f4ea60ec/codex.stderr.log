 @triton.jit
+def _norm_gate_out128_kernel(
+    out_h,
+    out_gate_packed,
+    norm_w,
+    norm_b,
+    to_out_w,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,

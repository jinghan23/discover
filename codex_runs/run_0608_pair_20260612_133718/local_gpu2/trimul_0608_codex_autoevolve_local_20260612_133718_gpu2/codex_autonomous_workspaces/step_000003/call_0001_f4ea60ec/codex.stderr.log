   348	    right = torch.empty((B * H, N, N), device=proj.device, dtype=torch.bfloat16)
   349	    grid = (triton.cdiv(B * N * N, 16), triton.cdiv(H, 64))
   350	    if mask.dtype is torch.float32:
   351	        _prep_packed4_hmajor_nomask_kernel[grid](
   352	            proj,

import torch, torch.nn.functional as F, time
from reference import generate_input, check_implementation
import submission

def alt_bf16_final(data):
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    x=submission._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=submission._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=submission._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z.to(torch.bfloat16),weights['to_out.weight'].to(torch.bfloat16)).to(torch.float32)

def alt_current_c384_bf16_final(data):
    return alt_bf16_final(data)

def bench(fn,data,it=10):
    for _ in range(5):
        o=fn(data); torch.cuda.synchronize(); del o
    times=[]
    for _ in range(it):
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); o=fn(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000); del o
    return sum(times)/len(times)


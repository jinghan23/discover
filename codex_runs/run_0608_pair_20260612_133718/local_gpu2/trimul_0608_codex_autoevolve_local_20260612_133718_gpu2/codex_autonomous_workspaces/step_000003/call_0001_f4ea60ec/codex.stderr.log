   303	@triton.jit
   304	def _project_prep_gate_c128_nomask_kernel(
   305	    x,
   306	    packed_w,
   307	    left,
   308	    right,
   309	    out_gate,
   310	    n_pairs: tl.constexpr,
   311	    H: tl.constexpr,
   312	    BLOCK_M: tl.constexpr,
   313	    BLOCK_H: tl.constexpr,
   314	    BLOCK_C: tl.constexpr,
   315	):
   316	    pid_m = tl.program_id(0)
   317	    pid_h = tl.program_id(1)
   318	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   319	    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
   320	    offs_c = tl.arange(0, BLOCK_C)
   321	
   322	    b = offs_m // n_pairs
   323	    rem = offs_m - b * n_pairs
   324	    xv = tl.load(x + offs_m[:, None] * BLOCK_C + offs_c[None, :])
   325	
   326	    w_l = tl.load(packed_w + offs_c[:, None] + offs_h[None, :] * BLOCK_C)
   327	    w_lg = tl.load(packed_w + (2 * H * BLOCK_C) + offs_c[:, None] + offs_h[None, :] * BLOCK_C)
   328	    lp = tl.dot(xv, w_l)
   329	    lg = tl.dot(xv, w_lg)
   330	    left_v = lp * tl.sigmoid(lg)
   331	    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
   332	    tl.store(left + hmajor, left_v)
   333	
   334	    w_r = tl.load(packed_w + (H * BLOCK_C) + offs_c[:, None] + offs_h[None, :] * BLOCK_C)
   335	    w_rg = tl.load(packed_w + (3 * H * BLOCK_C) + offs_c[:, None] + offs_h[None, :] * BLOCK_C)
   336	    rp = tl.dot(xv, w_r)
   337	    rg = tl.dot(xv, w_rg)
   338	    right_v = rp * tl.sigmoid(rg)
   339	    tl.store(right + hmajor, right_v)
   340	
   341	    w_og = tl.load(packed_w + (4 * H * BLOCK_C) + offs_c[:, None] + offs_h[None, :] * BLOCK_C)
   342	    og = tl.dot(xv, w_og)
   343	    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], og)
   344	

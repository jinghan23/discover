codex
One more precision test: store the output-normalized `z` in FP16 and use an FP16 final projection for `C=128`. BF16 `z` was not safe for the largest Cauchy case, but FP16 has more mantissa and may pass while reducing final projection bandwidth.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
import submission

def norm_gate_packed_fp16(out_h,proj,nw,nb,B,N,H):
    z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float16)
    bm=64 if N>=1024 else 32
    submission._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=4)
    return z

def alt_c128_zfp16(data):
    input_tensor,mask,weights,config=data
    B,N,C,H=input_tensor.shape[0],input_tensor.shape[1],config['dim'],config['hidden_dim']
    x=submission._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=norm_gate_packed_fp16(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight'].to(torch.float16)).to(torch.float32)

def bench(fn,data,it=8):
    for _ in range(4):
        o=fn(data); torch.cuda.synchronize(); del o
    ts=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e)*1000); del o
    return sum(ts)/len(ts)

cases=[
 dict(seqlen=32, bs=1, dim=128, hiddendim=128, seed=937321, nomask=True, distribution='cauchy'),
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
 dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=256, bs=1, dim=128, hiddendim=128, seed=10432, nomask=False, distribution='normal'),
]
for c in cases:
    data=generate_input(**c)
    out=alt_c128_zfp16(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('case',c,'ok',ok,msg[:200])
    if ok and c['seqlen']>=256:
        print('current',bench(submission.custom_kernel,data,5),'zfp16',bench(alt_c128_zfp16,data,5))
    del data,out
    torch.cuda.empty_cache()

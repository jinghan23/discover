/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, time, math
from reference import generate_input, check_implementation
from submission import custom_kernel

cases = [
  {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hiddendim\":128,\"seed\":9371,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hiddendim\":128,\"seed\":2301,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":12819,\"nomask\":True,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"},
  {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":481,\"nomask\":False,\"distribution\":\"normal\"},
  {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":23291,\"nomask\":True,\"distribution\":\"normal\"},
]

def clone_data(data):
    if isinstance(data, tuple): return tuple(clone_data(x) for x in data)
    if isinstance(data, dict): return {k: clone_data(v) for k,v in data.items()}
    if isinstance(data, torch.Tensor): return data.clone()
    return data

for idx, case in enumerate(cases):
    print('case', idx, case, flush=True)
    data = generate_input(**case)
    out = custom_kernel(clone_data(data)); torch.cuda.synchronize()
    good,msg = check_implementation(data, out)
    print('correct', good, str(msg).split('\\n')[0], flush=True)
    # warm
    for _ in range(3):
        out = custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(15):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); out=custom_kernel(data); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000)
    print('us mean', sum(times)/len(times), 'min', min(times), 'max', max(times), flush=True)
    del data,out
    torch.cuda.empty_cache()

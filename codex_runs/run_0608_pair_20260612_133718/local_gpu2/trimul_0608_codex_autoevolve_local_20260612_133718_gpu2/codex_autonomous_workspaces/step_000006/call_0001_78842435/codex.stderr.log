/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
import submission as s

def layernorm_alt(input_tensor, norm_w, norm_b, B,N,C, dtype, bm, bc, warps):
    y=torch.empty_like(input_tensor,dtype=dtype)
    s._layernorm_bf16_kernel[(triton.cdiv(B*N*N,bm),)](input_tensor,norm_w,norm_b,y,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
    return y

def make_custom(bm128=16, warps128=4, bm384=16, warps384=8):
    def custom(data):
        input_tensor, mask, weights, config=data; B,N=input_tensor.shape[:2]; C=config['dim']; H=config['hidden_dim']
        use_fp16=C==128
        if use_fp16:
            x=layernorm_alt(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,torch.float16,bm128,128,warps128); dt=torch.float16
        else:
            x=layernorm_alt(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,torch.bfloat16,bm384,512,warps384); dt=torch.bfloat16
        pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
        proj=F.linear(x,pw)
        if use_fp16: left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
        else: left,right=s._sigmoid_mask_layout_packed(proj,mask,B,N,H)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=s._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
        return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
    return custom

cases = [
 ('c128n1024', {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"}),
 ('c384n1024', {\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":23291,\"nomask\":True,\"distribution\":\"normal\"}),
]
configs=[(8,4,8,8),(16,4,16,8),(32,4,16,8),(32,8,16,8),(64,8,16,8),(16,4,8,4),(16,4,8,8),(16,4,32,8),(16,4,32,4)]
for cfg in configs:
    fun=make_custom(*cfg)
    print('CFG',cfg, flush=True)
    for name,case in cases:
        data=generate_input(**case)
        out=fun(data); torch.cuda.synchronize(); good,msg=check_implementation(data,out)
        if not good:
            print(name,'BAD',str(msg).split('\\n')[0], flush=True); break
        for _ in range(2): fun(data)
        torch.cuda.synchronize(); ts=[]
        for _ in range(8):
            a=torch.cuda.Event(True); b=torch.cuda.Event(True); torch.cuda.synchronize(); a.record(); out=fun(data); b.record(); torch.cuda.synchronize(); ts.append(a.elapsed_time(b)*1000)
        print(name, sum(ts)/len(ts), min(ts), flush=True)
        del data,out; torch.cuda.empty_cache()

codex
Another possible tradeoff is splitting `out_gate` out of the 5-way projection: it reduces the packed tensor width and packing traffic, but adds a separate GEMM. I’m benchmarking that directly because the result depends on cuBLAS shape efficiency.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton, triton.language as tl
from reference import generate_input, check_implementation
import submission as s

@triton.jit
def norm_gate_sep_kernel(out_h, out_gate, norm_w, norm_b, z, n_pairs:tl.constexpr,H:tl.constexpr,BLOCK_M:tl.constexpr,BLOCK_H:tl.constexpr):
    pid=tl.program_id(0)
    offs_m=pid*BLOCK_M+tl.arange(0,BLOCK_M); offs_h=tl.arange(0,BLOCK_H)
    b=offs_m//n_pairs; rem=offs_m-b*n_pairs
    hm=(b[None,:]*H+offs_h[:,None])*n_pairs+rem[None,:]
    vals=tl.load(out_h+hm).to(tl.float32)
    mean=tl.sum(vals,axis=0)/H
    centered=vals-mean[None,:]
    var=tl.sum(centered*centered,axis=0)/H
    inv=tl.rsqrt(var+1.0e-5)
    nw=tl.load(norm_w+offs_h).to(tl.float32); nb=tl.load(norm_b+offs_h).to(tl.float32)
    gate=tl.sigmoid(tl.load(out_gate+offs_m[None,:]*H+offs_h[:,None]).to(tl.float32))
    out=(centered*inv[None,:]*nw[:,None]+nb[:,None])*gate
    tl.store(z+offs_m[None,:]*H+offs_h[:,None],out)

def norm_gate_sep(out_h,out_gate,nw,nb,B,N,H,dtype):
    z=torch.empty((B,N,N,H),device=out_h.device,dtype=dtype)
    bm=64; warps=8 if 512<=N<1024 else 4
    norm_gate_sep_kernel[(triton.cdiv(B*N*N,bm),)](out_h,out_gate,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    return z

def custom_sep(data):
    input_tensor, mask, weights, config=data; B,N=input_tensor.shape[:2]; C=config['dim']; H=config['hidden_dim']; use_fp16=C==128
    if use_fp16:
        x=s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.float16
    else:
        x=s._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.bfloat16
    lrw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,lrw)
    out_gate=F.linear(x,weights['out_gate.weight'].to(dt))
    # Need prep kernels expect 5H layout; custom prep for 4H copied inline using existing with fake impossible not possible
    # Use torch split/ops for quick test of GEMM split plus same layout via a temporary 5H concat.
    proj5=torch.cat((proj,out_gate),dim=-1)
    if use_fp16: left,right=s._sigmoid_mask_layout_packed_fp16(proj5,mask,B,N,H)
    else: left,right=s._sigmoid_mask_layout_packed(proj5,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=s._norm_gate_packed(out_h,proj5,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

def custom_sep_true(data):
    input_tensor, mask, weights, config=data; B,N=input_tensor.shape[:2]; C=config['dim']; H=config['hidden_dim']; use_fp16=C==128
    if use_fp16:
        x=s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.float16
    else:
        x=s._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.bfloat16
    lrw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,lrw)
    # custom prep4 using 5H kernel would read wrong offsets. Use torch materialize for estimate? skip
    # fallback returns sep with concat, so includes extra concat cost; lower bound not tested.
    return custom_sep(data)


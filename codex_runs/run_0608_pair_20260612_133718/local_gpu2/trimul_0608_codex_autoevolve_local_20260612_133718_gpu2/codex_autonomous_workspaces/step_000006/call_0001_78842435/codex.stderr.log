    use_fp16=C==128
    if use_fp16:
        x=s._layernorm_fp16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C); proj_dtype=torch.float16
    else:
        x=s._layernorm_bf16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C); proj_dtype=torch.bfloat16
    proj_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(proj_dtype)
    proj=F.linear(x,proj_weight)
    if use_fp16: left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)

/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
import submission as s

def norm_gate_alt(out_h,proj,nw,nb,B,N,H,dtype,bm,warps):
 z=torch.empty((B,N,N,H),device=out_h.device,dtype=dtype)
 s._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
 return z

def make_custom(bm,warps):
 def custom(data):
  input_tensor,mask,weights,config=data; B,N=input_tensor.shape[:2]; C=config['dim']; H=config['hidden_dim']; use_fp16=C==128
  if use_fp16:
   x=s._layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.float16
  else:
   x=s._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.bfloat16
  pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
  if use_fp16: proj=F.linear(x,pw)
  else: proj=torch.mm(x.reshape(B*N*N,C),pw.t().contiguous()).reshape(B,N,N,5*H)
  if use_fp16: left,right=s._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
  else: left,right=s._sigmoid_mask_layout_packed(proj,mask,B,N,H)
  out_h=torch.bmm(left,right.transpose(1,2))
  z=norm_gate_alt(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16,bm,warps)
  return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
 return custom

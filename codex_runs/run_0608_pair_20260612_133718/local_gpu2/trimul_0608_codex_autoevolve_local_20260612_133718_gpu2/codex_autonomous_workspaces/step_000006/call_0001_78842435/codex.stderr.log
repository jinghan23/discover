+def _ln_proj_c128_kernel(
+    x,
+    norm_weight,
+    norm_bias,
+    proj_weight,
+    proj,
+    total_cols: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+
+    vals_m_c = tl.load(x + rows[:, None] * BLOCK_C + offs_c[None, :]).to(tl.float32)
+    vals = tl.trans(vals_m_c)
+    mean = tl.sum(vals, axis=0) / BLOCK_C
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / BLOCK_C
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    w_norm = tl.load(norm_weight + offs_c).to(tl.float32)
+    b_norm = tl.load(norm_bias + offs_c).to(tl.float32)
+    norm_m_c = tl.trans(centered * inv[None, :] * w_norm[:, None] + b_norm[:, None])
+
+    for n0 in tl.static_range(0, 640, BLOCK_N):
+        offs_n = n0 + tl.arange(0, BLOCK_N)
+        w = tl.load(proj_weight + offs_n[None, :] * BLOCK_C + offs_c[:, None])
+        acc = tl.dot(norm_m_c.to(tl.float16), w, out_dtype=tl.float32)
+        tl.store(proj + rows[:, None] * total_cols + offs_n[None, :], acc)
+
+

 for name,c in cases:
  data=generate_input(**c); out=fun(data); torch.cuda.synchronize(); good,msg=check_implementation(data,out)
  if not good: print(name,'BAD',str(msg).split('\\n')[0],flush=True); break
  for _ in range(3): fun(data)
  torch.cuda.synchronize(); ts=[]
  for _ in range(8):
   a=torch.cuda.Event(True); b=torch.cuda.Event(True); torch.cuda.synchronize(); a.record(); out=fun(data); b.record(); torch.cuda.synchronize(); ts.append(a.elapsed_time(b)*1000)
  print(name,sum(ts)/len(ts),min(ts),max(ts),flush=True)
  del data,out; torch.cuda.empty_cache()

/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, base64
from torch.profiler import profile, ProfilerActivity
from reference import generate_input
from submission import custom_kernel
cases = [
  (0,{\"seqlen\":256,\"bs\":2,\"dim\":128,\"hiddendim\":128,\"seed\":9371,\"nomask\":True,\"distribution\":\"normal\"}),
  (4,{\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"}),
  (6,{\"seqlen\":1024,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":23291,\"nomask\":True,\"distribution\":\"normal\"}),
  (5,{\"seqlen\":768,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":481,\"nomask\":False,\"distribution\":\"normal\"}),
]
for idx, case in cases:
    data = generate_input(**case)
    for _ in range(3): custom_kernel(data)
    torch.cuda.synchronize()
    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA], record_shapes=True) as prof:
        custom_kernel(data)
        torch.cuda.synchronize()
    print('\\nCASE', idx, case)
    print(prof.key_averages().table(sort_by='self_cuda_time_total', row_limit=24))

import torch, triton, torch.nn.functional as F
from reference import generate_input
from submission import _layernorm_fp16,_layernorm_bf16,_prep_packed_hmajor_nomask_kernel,_prep_packed_hmajor_mask_kernel

def make_proj(data):
    input_tensor, mask, weights, cfg=data; B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=cfg['dim']; H=cfg['hidden_dim']; use=C==128
    x=(_layernorm_fp16 if use else _layernorm_bf16)(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    dt=torch.float16 if use else torch.bfloat16
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,pw)
    return proj,mask,B,N,H,dt

def pack(proj,mask,B,N,H,dt,bm,bh,warps,nomask):
    left=torch.empty((B*H,N,N),device='cuda',dtype=dt); right=torch.empty_like(left)
    if nomask:
        _prep_packed_hmajor_nomask_kernel[(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        _prep_packed_hmajor_mask_kernel[(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right
for spec in [
 {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":768,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":256,\"bs\":2,\"dim\":384,\"hiddendim\":128,\"seed\":1,\"nomask\":False,\"distribution\":\"normal\"},
 {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":1,\"nomask\":False,\"distribution\":\"normal\"},
]:
    print('\\n',spec)
    proj,mask,B,N,H,dt=make_proj(generate_input(**spec)); torch.cuda.synchronize(); nomask=mask.dtype is torch.float32
    configs=[]
    for bm in ([16,32,64,128] if nomask else [16,32,64,128]):
      for bh in [32,64,128]:
        for warps in [4,8]: configs.append((bm,bh,warps))
    for bm,bh,warps in configs:
        try:
            left,right=pack(proj,mask,B,N,H,dt,bm,bh,warps,nomask); torch.cuda.synchronize()
            times=[]
            for i in range(8):
                torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); left,right=pack(proj,mask,B,N,H,dt,bm,bh,warps,nomask); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
            print((bm,bh,warps),sum(times)/len(times),min(times))
        except Exception as e:
            print('ERR',(bm,bh,warps),e)

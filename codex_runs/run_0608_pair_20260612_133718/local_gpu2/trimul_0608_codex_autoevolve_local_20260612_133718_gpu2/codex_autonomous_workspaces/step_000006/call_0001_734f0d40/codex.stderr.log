+    w = tl.load(to_out_w + offs_c[None, :] * H + offs_h[:, None]).to(tl.float32)
+    acc = tl.dot(tl.trans(z).to(tl.float16), w.to(tl.float16), out_dtype=tl.float32)
+    tl.store(out + offs_m[:, None] * C + offs_c[None, :], acc)

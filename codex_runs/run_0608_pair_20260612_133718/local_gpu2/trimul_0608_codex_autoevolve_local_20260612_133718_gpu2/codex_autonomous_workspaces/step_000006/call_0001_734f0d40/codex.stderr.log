+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+
+    xv = tl.load(x + offs_m[:, None] * C + offs_c[None, :])
+    w_l = tl.load(left_w + offs_h[None, :] * C + offs_c[:, None]).to(tl.float32)
+    w_lg = tl.load(left_gate_w + offs_h[None, :] * C + offs_c[:, None]).to(tl.float32)
+    lp = tl.dot(xv, w_l.to(tl.float16), out_dtype=tl.float32)
+    lg = tl.dot(xv, w_lg.to(tl.float16), out_dtype=tl.float32)

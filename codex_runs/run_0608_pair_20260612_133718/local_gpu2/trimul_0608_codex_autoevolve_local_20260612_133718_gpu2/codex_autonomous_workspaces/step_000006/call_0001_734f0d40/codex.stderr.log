/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
from submission import _layernorm_fp16,_sigmoid_mask_layout_packed_fp16,_norm_gate_packed

def custom_fp16_wide(data):
    input_tensor, mask, weights, cfg=data; B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=cfg['dim']; H=cfg['hidden_dim']
    x=_layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=_sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

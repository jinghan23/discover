The better fused tile is now active. I’m running the seven benchmark shapes again to see the geometric effect, not just the isolated projection win.
exec
/bin/bash -lc "python - <<'PY'
import torch, math
from reference import generate_input, check_implementation
from submission import custom_kernel
benchmarks = [
  {\"seqlen\": 256, \"bs\": 2, \"dim\": 128, \"hiddendim\": 128, \"seed\": 9371, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 768, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 381, \"nomask\": True, \"distribution\": \"cauchy\"},
  {\"seqlen\": 256, \"bs\": 2, \"dim\": 384, \"hiddendim\": 128, \"seed\": 2301, \"nomask\": False, \"distribution\": \"normal\"},
  {\"seqlen\": 512, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 12819, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 1024, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 381, \"nomask\": True, \"distribution\": \"cauchy\"},
  {\"seqlen\": 768, \"bs\": 1, \"dim\": 384, \"hiddendim\": 128, \"seed\": 481, \"nomask\": False, \"distribution\": \"normal\"},
  {\"seqlen\": 1024, \"bs\": 1, \"dim\": 384, \"hiddendim\": 128, \"seed\": 23291, \"nomask\": True, \"distribution\": \"normal\"},
]
means=[]
for spec in benchmarks:
    data=generate_input(**spec)
    out=custom_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('\\n', spec, 'ok', ok, msg[:100] if msg else '')
    times=[]
    for i in range(10):
        torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); out=custom_kernel(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
    m=sum(times)/len(times); means.append(m)
    print('mean', m, 'min', min(times), 'max', max(times))
print('geom', math.exp(sum(math.log(x) for x in means)/len(means)))
PY" in /opt/tiger/discover/workspace

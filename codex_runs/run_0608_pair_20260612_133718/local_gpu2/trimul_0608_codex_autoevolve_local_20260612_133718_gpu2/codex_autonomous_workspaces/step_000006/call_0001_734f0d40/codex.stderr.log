I’m benchmarking the BF16 fused projection standalone against the baseline `F.linear + packing` on the three wide-channel leaderboard shapes. This keeps the experiment isolated from downstream noise.
exec
/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input
from submission import _layernorm_bf16,_sigmoid_mask_layout_packed,_proj_gate_pack_bf16

def baseline_proj_pack(x,w,mask,B,N,C,H):
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=_sigmoid_mask_layout_packed(proj,mask,B,N,H)
    return left,right,proj

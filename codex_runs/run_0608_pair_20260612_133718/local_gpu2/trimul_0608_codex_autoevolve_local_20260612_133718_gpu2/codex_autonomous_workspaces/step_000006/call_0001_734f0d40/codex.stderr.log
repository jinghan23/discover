+@triton.jit
+def _proj_gate_pack_bf16_kernel(
+    x,
+    mask,
+    left_w,
+    right_w,
+    left_gate_w,
+    right_gate_w,
+    out_gate_w,
+    left,
+    right,
+    out_gate,
+    n_pairs: tl.constexpr,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    offs_k = tl.arange(0, BLOCK_K)
+
+    acc_l = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    acc_r = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    acc_lg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    acc_rg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+
+    for k0 in range(0, C, BLOCK_K):
+        k = k0 + offs_k
+        xv = tl.load(x + offs_m[:, None] * C + k[None, :])
+
+        w_l = tl.load(left_w + offs_h[None, :] * C + k[:, None]).to(tl.float32)
+        w_r = tl.load(right_w + offs_h[None, :] * C + k[:, None]).to(tl.float32)
+        w_lg = tl.load(left_gate_w + offs_h[None, :] * C + k[:, None]).to(tl.float32)
+        w_rg = tl.load(right_gate_w + offs_h[None, :] * C + k[:, None]).to(tl.float32)
+        w_og = tl.load(out_gate_w + offs_h[None, :] * C + k[:, None]).to(tl.float32)
+
+        acc_l += tl.dot(xv, w_l.to(tl.bfloat16), out_dtype=tl.float32)
+        acc_r += tl.dot(xv, w_r.to(tl.bfloat16), out_dtype=tl.float32)
+        acc_lg += tl.dot(xv, w_lg.to(tl.bfloat16), out_dtype=tl.float32)
+        acc_rg += tl.dot(xv, w_rg.to(tl.bfloat16), out_dtype=tl.float32)
+        acc_og += tl.dot(xv, w_og.to(tl.bfloat16), out_dtype=tl.float32)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    left_v = acc_l * tl.sigmoid(acc_lg)
+    right_v = acc_r * tl.sigmoid(acc_rg)
+    if HAS_MASK:
+        m = tl.load(mask + offs_m).to(tl.float32)
+        left_v *= m[:, None]
+        right_v *= m[:, None]
+
+    tl.store(left + hmajor, left_v)
+    tl.store(right + hmajor, right_v)
+    tl.store(out_gate + offs_m[:, None] * H + offs_h[None, :], acc_og)
+
+
+@triton.jit
+def _scatter_lr_packed_from_indices_kernel(
+    lr_proj,
+    idx,
+    left,
+    right,
+    S: tl.constexpr,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid_m = offs_m < S
+
+    rows = tl.load(idx + offs_m, mask=valid_m, other=0)
+    base = offs_m[:, None] * (4 * H) + offs_h[None, :]
+    mask = valid_m[:, None]
+    lp = tl.load(lr_proj + base, mask=mask, other=0.0).to(tl.float32)
+    rp = tl.load(lr_proj + base + H, mask=mask, other=0.0).to(tl.float32)
+    lg = tl.load(lr_proj + base + (2 * H), mask=mask, other=0.0).to(tl.float32)
+    rg = tl.load(lr_proj + base + (3 * H), mask=mask, other=0.0).to(tl.float32)
+
+    b = rows // n_pairs
+    rem = rows - b * n_pairs
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, lp * tl.sigmoid(lg), mask=mask)
+    tl.store(right + hmajor, rp * tl.sigmoid(rg), mask=mask)
+
+
+@triton.jit
+def _norm_gate_to_out_c128_kernel(
+    out_h,
+    out_gate_packed,
+    norm_w,
+    norm_b,
+    to_out_w,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    C: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_c = tl.arange(0, BLOCK_C)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / H
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    gate_logits = tl.load(out_gate_packed + offs_m[None, :] * (5 * H) + (4 * H) + offs_h[:, None]).to(tl.float32)
+    gate = tl.sigmoid(gate_logits)

+    w_lg = tl.load(left_gate_w + offs_h[None, :] * C + offs_c[:, None]).to(tl.float32)
+    lp = tl.dot(xv, w_l.to(tl.float16), out_dtype=tl.float32)
+    lg = tl.dot(xv, w_lg.to(tl.float16), out_dtype=tl.float32)
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hmajor = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    tl.store(left + hmajor, lp * tl.sigmoid(lg))
+
+    w_r = tl.load(right_w + offs_h[None, :] * C + offs_c[:, None]).to(tl.float32)
+    w_rg = tl.load(right_gate_w + offs_h[None, :] * C + offs_c[:, None]).to(tl.float32)
+    rp = tl.dot(xv, w_r.to(tl.float16), out_dtype=tl.float32)
+    rg = tl.dot(xv, w_rg.to(tl.float16), out_dtype=tl.float32)

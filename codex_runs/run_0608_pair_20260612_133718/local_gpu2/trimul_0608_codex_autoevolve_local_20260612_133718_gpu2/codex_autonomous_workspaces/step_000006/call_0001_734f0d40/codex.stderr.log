/bin/bash -lc "python - <<'PY'
import torch, triton, torch.nn.functional as F
from reference import generate_input
from submission import _layernorm_fp16,_layernorm_bf16,_sigmoid_mask_layout_packed_fp16,_sigmoid_mask_layout_packed,_norm_gate_packed_tile_kernel

def make_out_h(data):
    input_tensor, mask, weights, config=data; B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']; use=C==128
    x=(_layernorm_fp16 if use else _layernorm_bf16)(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    dt=torch.float16 if use else torch.bfloat16
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,pw)
    left,right=(_sigmoid_mask_layout_packed_fp16 if use else _sigmoid_mask_layout_packed)(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    return out_h,proj,weights,B,N,H

def norm_gate(out_h,proj,w,B,N,H,bm,warps):
    z=torch.empty((B,N,N,H),device=out_h.device,dtype=torch.float16)
    _norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    return z
for spec in [
 {\"seqlen\":256,\"bs\":2,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":512,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"},
 {\"seqlen\":768,\"bs\":1,\"dim\":384,\"hiddendim\":128,\"seed\":1,\"nomask\":False,\"distribution\":\"normal\"},
]:
    print('\\n',spec)
    out_h,proj,w,B,N,H=make_out_h(generate_input(**spec)); torch.cuda.synchronize()
    for bm in [16,32,64,128]:
      for warps in [4,8]:
        z=norm_gate(out_h,proj,w,B,N,H,bm,warps); torch.cuda.synchronize()
        times=[]
        for i in range(10):
            torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); z=norm_gate(out_h,proj,w,B,N,H,bm,warps); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
        print((bm,warps),sum(times)/len(times),min(times))

codex
The projection tile itself is shape-sensitive too: `N=256` preferred a narrower hidden tile, while `N=512/1024` preferred the current one. I’m checking `N=768` before making the projection launch shape-specific.
exec
/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input
from submission import _layernorm_fp16,_proj_gate_pack_c128_nomask,_sigmoid_mask_layout_packed_fp16
spec={\"seqlen\":768,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":1,\"nomask\":True,\"distribution\":\"normal\"}
data=generate_input(**spec); inp,mask,w,cfg=data; B=1; N=768; H=128
x=_layernorm_fp16(inp,w['norm.weight'],w['norm.bias'],B,N,128); torch.cuda.synchronize()
# baseline proj+pack
pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16); proj=F.linear(x,pw); _sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H); torch.cuda.synchronize(); times=[]
for i in range(6):
 torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16); proj=F.linear(x,pw); _sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
print('baseline',sum(times)/len(times),min(times))
for bm in [64,128,256]:
 for bh in [32,64,128]:
  for warps in [4,8]:
   try:
    _proj_gate_pack_c128_nomask(x,w,B,N,H,bm,bh,warps); torch.cuda.synchronize(); times=[]
    for i in range(6):

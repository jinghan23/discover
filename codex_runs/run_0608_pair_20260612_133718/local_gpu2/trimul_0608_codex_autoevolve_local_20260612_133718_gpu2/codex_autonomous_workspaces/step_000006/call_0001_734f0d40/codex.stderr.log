/bin/bash -lc "python - <<'PY'
import torch, torch.nn.functional as F
from reference import generate_input, check_implementation
from submission import _layernorm_bf16,_sigmoid_mask_layout_packed_fp16,_norm_gate_packed

def custom_bfproj_fp16bmm(data):
    inp,mask,w,cfg=data; B=inp.shape[0]; N=inp.shape[1]; C=cfg['dim']; H=cfg['hidden_dim']
    x=_layernorm_bf16(inp,w['norm.weight'],w['norm.bias'],B,N,C)
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=_sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate_packed(out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),w['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

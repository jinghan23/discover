def _sparse_mask_proj_pack_bf16(x, mask, weights, B: int, N: int, C: int, H: int):
    idx = torch.nonzero(mask.reshape(B * N * N), as_tuple=False).reshape(-1)
    left = torch.empty((B * H, N, N), device=x.device, dtype=torch.bfloat16)
    right = torch.empty((B * H, N, N), device=x.device, dtype=torch.bfloat16)
    left.zero_()
    right.zero_()

    out_gate = F.linear(
        x,
        weights["out_gate.weight"].to(torch.bfloat16),
    ).reshape(B * N * N, H)

    lr_weight = torch.cat(
        (
            weights["left_proj.weight"],
            weights["right_proj.weight"],
            weights["left_gate.weight"],
            weights["right_gate.weight"],
        ),
        dim=0,
    ).to(torch.bfloat16)
    x_sel = x.reshape(B * N * N, C).index_select(0, idx)
    lr_proj = F.linear(x_sel, lr_weight)
    block_m = 64
    block_h = 64
    _scatter_lr_packed_from_indices_kernel[(triton.cdiv(idx.numel(), block_m), triton.cdiv(H, block_h))](

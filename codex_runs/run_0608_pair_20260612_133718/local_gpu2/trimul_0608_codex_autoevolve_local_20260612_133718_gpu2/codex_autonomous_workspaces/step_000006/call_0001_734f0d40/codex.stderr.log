/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input, check_implementation
from submission import custom_kernel
for spec in [
  {\"seqlen\": 32, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 9371, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 256, \"bs\": 2, \"dim\": 128, \"hiddendim\": 128, \"seed\": 9371, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 1024, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 381, \"nomask\": True, \"distribution\": \"cauchy\"},
  {\"seqlen\": 256, \"bs\": 2, \"dim\": 384, \"hiddendim\": 128, \"seed\": 2301, \"nomask\": False, \"distribution\": \"normal\"},
]:
    data=generate_input(**spec)
    out=custom_kernel(data); torch.cuda.synchronize()
    ok,msg=check_implementation(data,out)
    print(spec, ok, msg[:200] if msg else '')
    if spec['seqlen'] >= 256:
        times=[]
        for i in range(5):
            torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True)
            st.record(); out=custom_kernel(data); en.record(); torch.cuda.synchronize()
            times.append(st.elapsed_time(en)*1000)
        print('times', times, 'mean', sum(times)/len(times))

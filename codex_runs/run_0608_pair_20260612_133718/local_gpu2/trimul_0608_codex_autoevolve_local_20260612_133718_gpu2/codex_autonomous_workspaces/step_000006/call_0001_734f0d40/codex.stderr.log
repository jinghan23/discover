+    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+
+    vals = tl.load(x + offs_c[:, None] + offs_m[None, :] * C).to(tl.float32)
+    mean = tl.sum(vals, axis=0) / C
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / C

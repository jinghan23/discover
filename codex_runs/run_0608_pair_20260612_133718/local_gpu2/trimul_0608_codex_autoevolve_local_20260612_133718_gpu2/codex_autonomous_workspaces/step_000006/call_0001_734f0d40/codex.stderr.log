def custom_fp16acc(data):
    input_tensor, mask, weights, config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']; use=C==128
    if use:
        x=_layernorm_fp16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.float16
    else:
        x=_layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C); dt=torch.bfloat16
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dt)
    proj=F.linear(x,pw)
    left,right=(_sigmoid_mask_layout_packed_fp16 if use else _sigmoid_mask_layout_packed)(proj,mask,B,N,H)
    old=torch.backends.cuda.matmul.allow_fp16_accumulation
    if use:
        torch.backends.cuda.matmul.allow_fp16_accumulation=True
    out_h=torch.bmm(left,right.transpose(1,2))
    if use:
        torch.backends.cuda.matmul.allow_fp16_accumulation=False
    z=_norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    y=torch.mm(z.reshape(B*N*N,H),weights['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
    torch.backends.cuda.matmul.allow_fp16_accumulation=old
    return y


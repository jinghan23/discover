   190	@triton.jit
   191	def _norm_gate_packed_tile_kernel(
   192	    out_h,
   193	    out_gate_packed,
   194	    norm_w,
   195	    norm_b,
   196	    z,
   197	    n_pairs: tl.constexpr,
   198	    H: tl.constexpr,
   199	    BLOCK_M: tl.constexpr,
   200	    BLOCK_H: tl.constexpr,
   201	):
   202	    pid = tl.program_id(0)
   203	    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
   204	    offs_h = tl.arange(0, BLOCK_H)
   205	
   206	    b = offs_m // n_pairs
   207	    rem = offs_m - b * n_pairs
   208	    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
   209	    vals = tl.load(out_h + hm).to(tl.float32)
   210	
   211	    mean = tl.sum(vals, axis=0) / H
   212	    centered = vals - mean[None, :]
   213	    var = tl.sum(centered * centered, axis=0) / H
   214	    inv = tl.rsqrt(var + 1.0e-5)
   215	
   216	    nw = tl.load(norm_w + offs_h).to(tl.float32)
   217	    nb = tl.load(norm_b + offs_h).to(tl.float32)
   218	    cl = offs_m[None, :] * H + offs_h[:, None]
   219	    gate_logits = tl.load(out_gate_packed + offs_m[None, :] * (5 * H) + (4 * H) + offs_h[:, None]).to(tl.float32)
   220	    gate = tl.sigmoid(gate_logits)
   221	    out = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
   222	    tl.store(z + cl, out)

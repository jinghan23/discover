from pathlib import Path
from libkernelbot.consts import SubmissionMode
from libkernelbot.run_eval import run_config
from libkernelbot.task import build_task_config, make_task_definition
import tempfile, os, math

task=make_task_definition(Path('task.yml')).task
config=build_task_config(task=task, submission_content=Path('submission.py').read_text(), arch=None, mode=SubmissionMode.LEADERBOARD)
with tempfile.TemporaryDirectory(prefix='run_', dir='eval_tmp') as tmp:
    old=os.getcwd(); os.chdir(tmp)
    try: result=run_config(config)
    finally: os.chdir(old)
run=result.runs['leaderboard'].run
if not run.passed:
    print('FAILED', run.result, run.stdout, run.stderr); raise SystemExit(1)
means=[]
for i in range(int(run.result['benchmark-count'])):
    mean=float(run.result[f'benchmark.{i}.mean'])/1000; means.append(mean)
    print(i, f'{mean:.3f} us best {float(run.result[f\"benchmark.{i}.best\"])/1000:.3f}', run.result[f'benchmark.{i}.spec'])
print('geom', math.exp(sum(math.log(x) for x in means)/len(means)))

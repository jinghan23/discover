/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch, triton, torch.nn.functional as F
from reference import generate_input, check_implementation
import submission

def prep(N=1024):
    data=generate_input(seqlen=N,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='normal')
    x0,mask,w,cfg=data; B=1; C=128; H=128
    x=submission._layernorm_fp16(x0,w['norm.weight'],w['norm.bias'],B,N,C)
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    torch.cuda.synchronize()
    return out_h,proj,w,B,N,H,C

def bench(N,bm,bc,warps):
    out_h,proj,w,B,N,H,C=prep(N)
    out=torch.empty((B,N,N,C),device='cuda',dtype=torch.float32)
    def fn():
        submission._norm_gate_to_out_c128_kernel[(triton.cdiv(B*N*N,bm),triton.cdiv(C,bc))](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],w['to_out.weight'],out,N*N,H,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
        return out
    for _ in range(5): fn(); torch.cuda.synchronize()
    vals=[]; st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    for _ in range(20): st.record(); fn(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
    print('N',N,'bm',bm,'bc',bc,'w',warps,'avg',sum(vals)/len(vals),'min',min(vals))

for bm in [8,16,32,64]:
  for bc in [32,64,128]:
    for warps in [4,8]:
      try: bench(512,bm,bc,warps)
      except Exception as e: print('ERR',bm,bc,warps,e)

import torch, triton
from reference import generate_input
import submission

def run_ln(B,N,C,bm,bc,warps):
    data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=7,nomask=True,distribution='normal')
    x,mask,w,cfg=data
    y=torch.empty_like(x, dtype=torch.float16 if C==128 else torch.bfloat16)
    rows=B*N*N
    def fn():
        submission._layernorm_bf16_kernel[(triton.cdiv(rows,bm),)](x,w['norm.weight'],w['norm.bias'],y,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
        return y
    for _ in range(5): fn(); torch.cuda.synchronize()
    vals=[]; st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    for _ in range(20):
        st.record(); fn(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
    print('C',C,'bm',bm,'bc',bc,'w',warps,'avg',sum(vals)/len(vals),'min',min(vals))

for C,bc in [(128,128),(384,512),(768,1024)]:
    for bm in [4,8,16,32]:
        for warps in ([4,8] if C>=384 else [4,8]):
            try: run_ln(1,1024,C,bm,bc,warps)
            except Exception as e: print('ERR',C,bm,warps,e)

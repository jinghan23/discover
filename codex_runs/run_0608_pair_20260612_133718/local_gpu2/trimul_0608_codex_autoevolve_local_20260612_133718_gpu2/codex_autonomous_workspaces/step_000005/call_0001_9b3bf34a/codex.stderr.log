   274	    pid_m = tl.program_id(0)
   275	    pid_c = tl.program_id(1)
   276	    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
   277	    offs_h = tl.arange(0, H)
   278	    offs_c = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
   279	
   280	    b = offs_m // n_pairs
   281	    rem = offs_m - b * n_pairs
   282	    hm = (b[None, :] * H + offs_h[:, None]) * n_pairs + rem[None, :]
   283	    vals_t = tl.load(out_h + hm).to(tl.float32)
   284	
   285	    mean = tl.sum(vals_t, axis=0) / H
   286	    centered = vals_t - mean[None, :]
   287	    var = tl.sum(centered * centered, axis=0) / H
   288	    inv = tl.rsqrt(var + 1.0e-5)
   289	
   290	    nw = tl.load(norm_w + offs_h).to(tl.float32)
   291	    nb = tl.load(norm_b + offs_h).to(tl.float32)
   292	    gate_logits = tl.load(out_gate_packed + offs_m[None, :] * (5 * H) + (4 * H) + offs_h[:, None]).to(tl.float32)

import torch, triton, torch.nn.functional as F
from reference import generate_input
import submission

def prep(N=512):
    data=generate_input(seqlen=N,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='normal')
    x0,mask,w,cfg=data; B=1; C=128; H=128
    x=submission._layernorm_fp16(x0,w['norm.weight'],w['norm.bias'],B,N,C)
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x,pw)
    left,right=submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    torch.cuda.synchronize()
    return out_h,proj,w,B,N,H,C
out_h,proj,w,B,N,H,C=prep()
def orig():
    z=submission._norm_gate_packed(out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(B*N*N,H),w['to_out.weight'].to(torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
for _ in range(5): y=orig(); torch.cuda.synchronize(); del y
st=torch.cuda.Event(True); en=torch.cuda.Event(True); vals=[]
for _ in range(20): st.record(); y=orig(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000); del y
print(sum(vals)/len(vals), min(vals))

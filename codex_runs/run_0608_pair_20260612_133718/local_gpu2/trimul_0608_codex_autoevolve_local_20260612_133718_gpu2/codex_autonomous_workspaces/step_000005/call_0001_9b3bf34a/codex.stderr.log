import torch, torch.nn.functional as F, triton
from reference import generate_input
import submission

def bench_ln(spec):
    data=generate_input(**spec)
    x,mask,w,cfg=data; B,N,C=x.shape[0],x.shape[1],cfg['dim']
    def triton_ln():
        return submission._layernorm_fp16(x,w['norm.weight'],w['norm.bias'],B,N,C) if C==128 else submission._layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
    def torch_ln_half():

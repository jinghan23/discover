The FP16-for-384 change passed but did not improve the score, so it is not a useful direction by itself. Next I’m comparing the current explicit H-major packing against PyTorch/einsum layouts to see whether the `0.9 ms` pack is actually buying faster contraction.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from torch.profiler import profile, ProfilerActivity
from reference import generate_input, check_implementation
import submission

# use current module helpers but compare post-projection layouts
def current_until_proj(data):
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0], input_tensor.shape[1], config['dim'], config['hidden_dim']
    x=submission._layernorm_fp16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C) if C==128 else submission._layernorm_bf16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C)
    dtype=torch.float16 if C==128 else torch.bfloat16
    w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dtype)
    proj=F.linear(x,w)
    return proj

def variant_einsum(data):
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0], input_tensor.shape[1], config['dim'], config['hidden_dim']
    proj=current_until_proj(data)
    m=mask.unsqueeze(-1)
    lp=proj[...,0:H]; rp=proj[...,H:2*H]; lg=proj[...,2*H:3*H]; rg=proj[...,3*H:4*H]
    left=lp*torch.sigmoid(lg)*m
    right=rp*torch.sigmoid(rg)*m
    out=torch.einsum('bikd,bjkd->bijd', left, right)
    z=submission._norm_gate_packed(out.permute(0,3,1,2).contiguous().reshape(B*H,N,N), proj, weights['to_out_norm.weight'], weights['to_out_norm.bias'], B,N,H, torch.float16)
    return torch.mm(z.reshape(B*N*N,H), weights['to_out.weight'].to(torch.float16).t(), out_dtype=torch.float32).reshape(B,N,N,C)

def variant_matmul4(data):
    input_tensor, mask, weights, config=data
    B,N,C,H=input_tensor.shape[0], input_tensor.shape[1], config['dim'], config['hidden_dim']
    proj=current_until_proj(data)
    m=mask.unsqueeze(-1)
    lp=proj[...,0:H]; rp=proj[...,H:2*H]; lg=proj[...,2*H:3*H]; rg=proj[...,3*H:4*H]
    left=(lp*torch.sigmoid(lg)*m).permute(0,3,1,2).contiguous().reshape(B*H,N,N)
    right=(rp*torch.sigmoid(rg)*m).permute(0,3,1,2).contiguous().reshape(B*H,N,N)
    out_h=torch.bmm(left, right.transpose(1,2))
    z=submission._norm_gate_packed(out_h, proj, weights['to_out_norm.weight'], weights['to_out_norm.bias'], B,N,H, torch.float16)
    return torch.mm(z.reshape(B*N*N,H), weights['to_out.weight'].to(torch.float16).t(), out_dtype=torch.float32).reshape(B,N,N,C)

def time(fn, data, name):
    for _ in range(3):
        o=fn(data); torch.cuda.synchronize(); del o
    st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    vals=[]
    for _ in range(10):
        st.record(); o=fn(data); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000); del o
    print(name, sum(vals)/len(vals), min(vals))
    #print(check_implementation(data, fn(data))[0])

spec=dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal')
data=generate_input(**spec)
time(submission.custom_kernel, data, 'current')
time(variant_matmul4, data, 'matmul4')
#time(variant_einsum, data, 'einsum')

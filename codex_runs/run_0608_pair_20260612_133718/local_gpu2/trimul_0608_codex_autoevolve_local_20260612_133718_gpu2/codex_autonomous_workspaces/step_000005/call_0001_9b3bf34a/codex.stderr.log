codex
With sigmoid approximation ruled out, I’m tuning the output norm/gate tile itself. It is a pure Triton kernel and runs for every shape, so even small improvements matter.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch, triton, torch.nn.functional as F
from reference import generate_input
import submission

def prep(N=1024,C=128,B=1,nomask=True):
    data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=9,nomask=nomask,distribution='normal')
    x0,mask,w,cfg=data; H=128
    x=submission._layernorm_fp16(x0,w['norm.weight'],w['norm.bias'],B,N,C) if C==128 else submission._layernorm_bf16(x0,w['norm.weight'],w['norm.bias'],B,N,C)
    dtype=torch.float16 if C==128 else torch.bfloat16
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
    proj=F.linear(x,pw)
    left,right=(submission._sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H) if C==128 else submission._sigmoid_mask_layout_packed(proj,mask,B,N,H))
    out_h=torch.bmm(left,right.transpose(1,2))
    torch.cuda.synchronize()
    return out_h,proj,w,B,N,H

def bench(N,C,bm,warps):
    out_h,proj,w,B,N,H=prep(N,C)
    z=torch.empty((B,N,N,H),device='cuda',dtype=torch.float16)
    def fn():
        submission._norm_gate_packed_tile_kernel[(triton.cdiv(B*N*N,bm),)](out_h,proj,w['to_out_norm.weight'],w['to_out_norm.bias'],z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    for _ in range(5): fn(); torch.cuda.synchronize()
    vals=[]; st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    for _ in range(30): st.record(); fn(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
    print('N',N,'C',C,'bm',bm,'w',warps,'avg',sum(vals)/len(vals),'min',min(vals))

for C,N in [(128,1024),(128,512),(384,1024),(384,768)]:
  for bm in [16,32,64,128]:
    for warps in [4,8]:
      try: bench(N,C,bm,warps)
      except Exception as e: print('ERR',N,C,bm,warps,e)

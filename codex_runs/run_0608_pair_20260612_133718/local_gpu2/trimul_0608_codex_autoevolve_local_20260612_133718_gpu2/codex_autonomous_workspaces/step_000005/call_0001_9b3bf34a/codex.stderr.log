  vals=[]; st=torch.cuda.Event(True); en=torch.cuda.Event(True)
  for _ in range(20): st.record(); y=fn(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000); del y
  print('N',N,'C',C,name,sum(vals)/len(vals),min(vals))
bench(1024,128)
bench(1024,384)
bench(256,384,B=2)

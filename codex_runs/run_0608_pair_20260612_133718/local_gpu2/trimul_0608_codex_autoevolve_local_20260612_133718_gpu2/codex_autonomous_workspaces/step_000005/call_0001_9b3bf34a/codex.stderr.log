Layer-norm tiling is flat; there is no large win there. The next tunable kernel is the H-major pack, which dominates the non-GEMM time on large shapes.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID python - <<'PY'
import torch, triton
from reference import generate_input
import submission

def get_proj(B,N,C,nomask):
    import torch.nn.functional as F
    data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=3,nomask=nomask,distribution='normal')
    x0,mask,w,cfg=data
    x=submission._layernorm_fp16(x0,w['norm.weight'],w['norm.bias'],B,N,C) if C==128 else submission._layernorm_bf16(x0,w['norm.weight'],w['norm.bias'],B,N,C)
    dtype=torch.float16 if C==128 else torch.bfloat16
    pw=torch.cat((w['left_proj.weight'],w['right_proj.weight'],w['left_gate.weight'],w['right_gate.weight'],w['out_gate.weight']),dim=0).to(dtype)
    proj=F.linear(x,pw)
    torch.cuda.synchronize()
    return proj,mask

def bench(B,N,C,nomask,bm,bh,warps):
    proj,mask=get_proj(B,N,C,nomask)
    dtype=torch.float16 if C==128 else torch.bfloat16
    left=torch.empty((B*128,N,N),device='cuda',dtype=dtype); right=torch.empty_like(left)
    n_pairs=N*N
    if nomask:
        def fn():
            submission._prep_packed_hmajor_nomask_kernel[(triton.cdiv(B*n_pairs,bm),triton.cdiv(128,bh))](proj,left,right,n_pairs,128,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        def fn():
            submission._prep_packed_hmajor_mask_kernel[(triton.cdiv(B*n_pairs,bm),triton.cdiv(128,bh))](proj,mask,left,right,n_pairs,128,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    for _ in range(5): fn(); torch.cuda.synchronize()
    vals=[]; st=torch.cuda.Event(True); en=torch.cuda.Event(True)
    for _ in range(20): st.record(); fn(); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
    print('nomask',nomask,'C',C,'bm',bm,'bh',bh,'w',warps,'avg',sum(vals)/len(vals),'min',min(vals))

for nomask in [True,False]:
  for bm in [16,32,64,128]:
    for bh in [32,64,128]:
      for warps in [4,8]:
        try: bench(1,1024,128,nomask,bm,bh,warps)
        except Exception as e: print('ERR',nomask,bm,bh,warps,e)

/bin/bash -lc "python - <<'PY'
import numpy as np
for deg in [3,5,7,9]:
    xs=np.linspace(-4,4,20001)
    y=1/(1+np.exp(-xs))-0.5
    # odd powers 1..deg
    powers=list(range(1,deg+1,2))
    A=np.stack([xs**p for p in powers],axis=1)
    coef=np.linalg.lstsq(A,y,rcond=None)[0]
    pred=0.5+A@coef
    err=np.max(np.abs(pred-(y+0.5)))
    print('deg',deg,'coef',coef,'maxerr',err,'edge pred',pred[0],pred[-1])
PY" in /opt/tiger/discover/workspace

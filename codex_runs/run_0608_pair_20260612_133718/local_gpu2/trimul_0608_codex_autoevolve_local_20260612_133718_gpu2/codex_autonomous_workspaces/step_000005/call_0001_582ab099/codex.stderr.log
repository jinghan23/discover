    x=_layernorm_fp16(inp,weights['norm.weight'],weights['norm.bias'],B,N,C)
    W=_cached_proj_weight(weights,dtype); rows=B*N*N; proj=torch.mm(W,x.reshape(rows,C).t())
    print('shape',N,B)
    for bm in [16,32,64,128,256]:
      for bh in [32,64,128]:
        for warps in [4,8]:
          try:
            a,b=bench(lambda bm=bm,bh=bh,warps=warps: prep(proj,mask,B,N,H,dtype,bm,bh,warps,False),it=20)
            print(' bm',bm,'bh',bh,'w',warps,'mean',round(a,2),'min',round(b,2))
          except Exception as e:
            print('err',bm,bh,warps,type(e).__name__,str(e)[:60])
    print()

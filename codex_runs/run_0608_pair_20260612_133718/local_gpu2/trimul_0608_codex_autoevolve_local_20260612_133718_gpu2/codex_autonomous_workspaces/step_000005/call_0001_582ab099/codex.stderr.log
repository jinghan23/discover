+@triton.jit
+def _norm_gate_tproj_tile_kernel(
+    out_h,
+    out_gate_tproj,
+    norm_w,
+    norm_b,
+    z,
+    rows_total: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,

def bench(fn,it=30):
    for _ in range(5): y=fn()
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    return sum(vals)/len(vals), min(vals)

def prep(proj,mask,B,N,H,dtype,bm,bh,warps,masked):
    left=torch.empty((H*B,N,N),device=proj.device,dtype=dtype); right=torch.empty_like(left); rows=B*N*N
    if masked:
        _prep_tproj_hmajor_mask_kernel[(triton.cdiv(rows,bm),triton.cdiv(H,bh))](proj,mask,left,right,rows,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        _prep_tproj_hmajor_nomask_kernel[(triton.cdiv(rows,bm),triton.cdiv(H,bh))](proj,left,right,rows,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right
for spec in [
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
]:

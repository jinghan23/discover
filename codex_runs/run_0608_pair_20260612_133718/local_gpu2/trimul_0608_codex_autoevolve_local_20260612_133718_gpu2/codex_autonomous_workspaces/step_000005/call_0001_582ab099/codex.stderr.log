    print('spec',spec['seqlen'],spec['distribution'],spec['nomask'],'good',good,msg.split('\\n')[0])
    if spec['distribution']=='normal':
      print(' bf16lr',bench(data,False,10),'fp16lr',bench(data,True,10))

+    pid_m = tl.program_id(0)
+    pid_c = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_c = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    valid_m = offs_m < rows_total
+
+    hm = offs_h[:, None] * rows_total + offs_m[None, :]
+    vals = tl.load(out_h + hm, mask=valid_m[None, :], other=0.0).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / H
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    gate_logits = tl.load(out_gate_tproj + (4 * H + offs_h[:, None]) * rows_total + offs_m[None, :], mask=valid_m[None, :], other=0.0).to(tl.float32)
+    gate = tl.sigmoid(gate_logits)
+    z_hm = ((centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate).to(tl.float16)
+
+    w = tl.load(to_out_w + offs_c[None, :] * H + offs_h[:, None], mask=offs_c[None, :] < C, other=0.0)
+    acc = tl.dot(tl.trans(z_hm), w, out_dtype=tl.float32)
+    tl.store(out + offs_m[:, None] * C + offs_c[None, :], acc, mask=valid_m[:, None] & (offs_c[None, :] < C))

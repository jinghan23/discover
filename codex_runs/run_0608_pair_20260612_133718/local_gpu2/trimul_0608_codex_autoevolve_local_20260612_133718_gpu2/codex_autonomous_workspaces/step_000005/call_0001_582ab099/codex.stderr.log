/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, time
import torch.nn.functional as F
from reference import generate_input
from submission import _layernorm_fp16, _layernorm_bf16

def bench(fn, it=20):
    for _ in range(5): y=fn()
    torch.cuda.synchronize()
    evs=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); y=fn(); e.record(); torch.cuda.synchronize(); evs.append(s.elapsed_time(e)*1000)
    return sum(evs)/len(evs), min(evs)
for spec in [
    dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
    dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
    dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
]:
    data=generate_input(**spec)
    inp, mask, weights, config=data
    B,N,C=inp.shape[0], inp.shape[1], config['dim']; H=config['hidden_dim']
    dtype=torch.float16 if C==128 else torch.bfloat16
    x=(_layernorm_fp16 if C==128 else _layernorm_bf16)(inp, weights['norm.weight'], weights['norm.bias'], B,N,C)
    W=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(dtype)
    rows=B*N*N
    a,b=bench(lambda: F.linear(x,W))
    c,d=bench(lambda: torch.mm(W, x.reshape(rows,C).t()))
    print(spec['seqlen'],B,C,'F.linear mean/min',a,b,'W@Xt mean/min',c,d)

import torch.nn.functional as F

def bench(fn,it=40):
    for _ in range(5): y=fn()
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    return sum(vals)/len(vals), min(vals)

def prep_row(proj,mask,B,N,H,dtype,bm,bh,warps,masked):
    left=torch.empty((B*H,N,N),device=proj.device,dtype=dtype); right=torch.empty_like(left)
    if masked:
        _prep_packed_hmajor_mask_kernel[(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    else:
        _prep_packed_hmajor_nomask_kernel[(triton.cdiv(B*N*N,bm),triton.cdiv(H,bh))](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    return left,right

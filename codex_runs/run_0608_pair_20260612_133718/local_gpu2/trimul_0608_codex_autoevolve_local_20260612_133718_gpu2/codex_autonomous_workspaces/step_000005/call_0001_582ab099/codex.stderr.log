    c,d=bench(f)
    out=torch.empty((rows,C),device='cuda',dtype=torch.float32)
    e,g=bench(lambda: torch.mm(z,w.t(),out=out,out_dtype=torch.float32))
    print(rows,C,'alloc',a,b,'explicit alloc',c,d,'reuse out',e,g)

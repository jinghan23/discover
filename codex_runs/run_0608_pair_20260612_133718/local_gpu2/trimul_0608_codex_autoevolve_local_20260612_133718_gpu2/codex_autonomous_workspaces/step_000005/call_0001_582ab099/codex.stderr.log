 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]
vals=[]
for spec in benchmarks:
    data=generate_input(**spec)
    for _ in range(5): out=custom_kernel(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(20):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); out=custom_kernel(data); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000)
    mean=sum(times)/len(times); vals.append(mean)
    print(spec['seqlen'],spec['bs'],spec['dim'],spec['nomask'],f'mean {mean:.3f} min {min(times):.3f}')
print('geom', math.exp(sum(math.log(v) for v in vals)/len(vals)))

+    gate = tl.sigmoid(gate_logits)
+    out = (centered * inv[None, :] * nw[:, None] + nb[:, None]) * gate
+    tl.store(z + offs_m[None, :] * H + offs_h[:, None], out, mask=valid[None, :])

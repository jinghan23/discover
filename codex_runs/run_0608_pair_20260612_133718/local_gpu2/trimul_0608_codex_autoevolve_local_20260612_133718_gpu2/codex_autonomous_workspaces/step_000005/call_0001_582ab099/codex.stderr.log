def bench(fn,it=30):
    for _ in range(5): y=fn()
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    return sum(vals)/len(vals), min(vals)

def run_path(data, tproj):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']; rows=B*N*N
    use_fp16=C==128; dtype=torch.float16 if use_fp16 else torch.bfloat16
    x=(_layernorm_fp16 if use_fp16 else _layernorm_bf16)(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    W=_cached_proj_weight(weights,dtype)
    if tproj:
        proj=torch.mm(W, x.reshape(rows,C).t())
        left,right=_sigmoid_mask_layout_tproj(proj,mask,B,N,H,dtype)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=_norm_gate_tproj(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    else:
        proj=F.linear(x,W)
        if use_fp16:
            left,right=_sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
        else:
            left,right=_sigmoid_mask_layout_packed(proj,mask,B,N,H)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=_norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(rows,H),_cached_to_out_weight(weights,torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

for spec in [
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
]:
    data=generate_input(**spec)
    a,b=bench(lambda: run_path(data, False), it=20)
    c,d=bench(lambda: run_path(data, True), it=20)
    print(spec['seqlen'],spec['bs'],spec['dim'],spec['nomask'],'row',a,b,'tproj',c,d)

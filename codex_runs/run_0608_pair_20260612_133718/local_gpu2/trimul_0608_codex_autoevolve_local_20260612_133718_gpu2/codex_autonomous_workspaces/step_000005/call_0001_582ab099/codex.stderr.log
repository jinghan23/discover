/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, math
import torch.nn.functional as F
from reference import generate_input
from submission import (_layernorm_fp16,_cached_proj_weight,_sigmoid_mask_layout_tproj,_sigmoid_mask_layout_packed_fp16,_norm_gate_tproj,_norm_gate_packed,_cached_to_out_weight)

def bench(fn,it=20):
    for _ in range(5): y=fn()
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    return sum(vals)/len(vals), min(vals)

def run_path(data,tproj):
    inp,mask,weights,config=data; B,N,C=inp.shape[0],inp.shape[1],config['dim']; H=config['hidden_dim']; rows=B*N*N; dtype=torch.float16
    x=_layernorm_fp16(inp,weights['norm.weight'],weights['norm.bias'],B,N,C)
    W=_cached_proj_weight(weights,dtype)
    if tproj:
        proj=torch.mm(W,x.reshape(rows,C).t())
        left,right=_sigmoid_mask_layout_tproj(proj,mask,B,N,H,dtype)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=_norm_gate_tproj(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    else:
        proj=F.linear(x,W)
        left,right=_sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
        out_h=torch.bmm(left,right.transpose(1,2))
        z=_norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(rows,H),_cached_to_out_weight(weights,torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)
for spec in [
 dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
]:
    data=generate_input(**spec)
    a,b=bench(lambda: run_path(data,False),20)
    c,d=bench(lambda: run_path(data,True),20)
    print(spec['seqlen'],'row',a,b,'tproj',c,d)

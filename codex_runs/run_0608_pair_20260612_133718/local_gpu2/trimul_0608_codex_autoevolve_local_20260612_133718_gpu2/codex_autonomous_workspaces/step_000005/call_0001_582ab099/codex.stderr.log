import torch, math
import torch.nn.functional as F
from reference import generate_input, check_implementation
from submission import (_layernorm_bf16,_cached_proj_weight,_sigmoid_mask_layout_packed_fp16,_sigmoid_mask_layout_packed,_norm_gate_packed,_cached_to_out_weight)

def variant(data, fp16_lr):
    inp,mask,weights,config=data; B,N,C=inp.shape[0],inp.shape[1],config['dim']; H=config['hidden_dim']; rows=B*N*N
    x=_layernorm_bf16(inp,weights['norm.weight'],weights['norm.bias'],B,N,C)
    W=_cached_proj_weight(weights,torch.bfloat16)
    proj=F.linear(x,W)
    if fp16_lr:
        left,right=_sigmoid_mask_layout_packed_fp16(proj,mask,B,N,H)
    else:
        left,right=_sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H,torch.float16)
    return torch.mm(z.reshape(rows,H),_cached_to_out_weight(weights,torch.float16).t(),out_dtype=torch.float32).reshape(B,N,N,C)

def bench(data,fp16_lr,it=15):
    for _ in range(4): out=variant(data,fp16_lr)
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); out=variant(data,fp16_lr); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    return sum(vals)/len(vals),min(vals)

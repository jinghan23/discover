import torch

def bench(fn,it=30):
    for _ in range(5): y=fn()
    torch.cuda.synchronize(); vals=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)

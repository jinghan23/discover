        block_m = 8
        block_c = 1024
        warps = 8
    _layernorm_bf16_kernel[(triton.cdiv(rows, block_m),)](
        input_tensor,
        norm_w,
        norm_b,
        y,
        C,
        BLOCK_M=block_m,
        BLOCK_C=block_c,
        num_warps=warps,
    )
    return y



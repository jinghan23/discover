import torch, triton
from reference import generate_input
from submission import _norm_gate_packed_tile_kernel, _norm_gate_tile_kernel

def bench_packed(B,N,H,bm,warps,reps=30):
    out_h=torch.randn((B*H,N,N),device='cuda',dtype=torch.bfloat16)
    proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.bfloat16)
    nw=torch.randn((H,),device='cuda'); nb=torch.randn((H,),device='cuda')
    z=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32)
    grid=(triton.cdiv(B*N*N,bm),)
    for _ in range(10):
        _norm_gate_packed_tile_kernel[grid](out_h,proj,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    torch.cuda.synchronize()
    times=[]
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record();
        _norm_gate_packed_tile_kernel[grid](out_h,proj,nw,nb,z,N*N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
        e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)

def bench_tile(B,N,H,bm,warps,reps=30):
    out_h=torch.randn((B*H,N,N),device='cuda',dtype=torch.bfloat16)
    gate=torch.randn((B,N,N,H),device='cuda',dtype=torch.float32)
    nw=torch.randn((H,),device='cuda'); nb=torch.randn((H,),device='cuda')
    z=torch.empty((B,N,N,H),device='cuda',dtype=torch.float32)
    grid=(triton.cdiv(B*N*N,bm),)
    for _ in range(10):
        _norm_gate_tile_kernel[grid](out_h,gate,nw,nb,z,N*N,N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
    torch.cuda.synchronize(); times=[]
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record();
        _norm_gate_tile_kernel[grid](out_h,gate,nw,nb,z,N*N,N,H,BLOCK_M=bm,BLOCK_H=128,num_warps=warps)
        e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)

for kind in ['packed','tile']:
  print('kind',kind)
  for N,B in [(256,2),(512,1),(768,1),(1024,1)]:
    print('N,B',N,B)
    for bm in [8,16,32,64,128]:
      for w in [4,8]:
        try:
          mean,best=(bench_packed if kind=='packed' else bench_tile)(B,N,128,bm,w,15)
          print('bm',bm,'w',w,'mean',round(mean,2),'best',round(best,2))
        except Exception as e: print('ERR',bm,w,e)
    print()

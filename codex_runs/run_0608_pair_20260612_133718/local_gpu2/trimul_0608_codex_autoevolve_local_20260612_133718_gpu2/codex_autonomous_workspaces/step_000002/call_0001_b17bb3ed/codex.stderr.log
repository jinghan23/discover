import torch, triton
from submission import _prep_packed_hmajor_nomask_kernel, _prep_packed_hmajor_mask_kernel

def bench(N,B,bm,bh,warps,masked=False,reps=20):
    H=128; M=B*N*N
    proj=torch.randn((B,N,N,5*H),device='cuda',dtype=torch.bfloat16)
    mask=torch.randint(0,2,(B,N,N),device='cuda') if masked else torch.ones((B,N,N),device='cuda')
    left=torch.empty((B*H,N,N),device='cuda',dtype=torch.bfloat16); right=torch.empty_like(left)
    grid=(triton.cdiv(M,bm), triton.cdiv(H,bh))
    kern=_prep_packed_hmajor_mask_kernel if masked else _prep_packed_hmajor_nomask_kernel
    for _ in range(10):
      if masked: kern[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
      else: kern[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
    torch.cuda.synchronize(); times=[]
    for _ in range(reps):
      s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
      if masked: kern[grid](proj,mask,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
      else: kern[grid](proj,left,right,N*N,H,BLOCK_M=bm,BLOCK_H=bh,num_warps=warps)
      e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times),min(times)


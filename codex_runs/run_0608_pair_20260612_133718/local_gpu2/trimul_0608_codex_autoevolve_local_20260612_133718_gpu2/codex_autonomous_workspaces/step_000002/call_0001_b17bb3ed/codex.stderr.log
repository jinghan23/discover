 @triton.jit
+def _norm_gate_project_packed_kernel(
+    out_h,
+    out_gate_packed,
+    norm_w,
+    norm_b,
+    out_w,
+    out,
+    n_pairs: tl.constexpr,
+    H: tl.constexpr,
+    C: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_c = tl.program_id(1)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_h = tl.arange(0, BLOCK_H)
+    offs_c = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    valid_c = offs_c < C
+
+    b = offs_m // n_pairs
+    rem = offs_m - b * n_pairs
+    hm = (b[:, None] * H + offs_h[None, :]) * n_pairs + rem[:, None]
+    vals = tl.load(out_h + hm).to(tl.float32)
+
+    mean = tl.sum(vals, axis=1) / H
+    centered = vals - mean[:, None]
+    var = tl.sum(centered * centered, axis=1) / H
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w + offs_h).to(tl.float32)
+    nb = tl.load(norm_b + offs_h).to(tl.float32)
+    gate_logits = tl.load(
+        out_gate_packed + offs_m[:, None] * (5 * H) + (4 * H) + offs_h[None, :]
+    ).to(tl.float32)
+    gate = 1.0 / (1.0 + tl.exp(-gate_logits))
+    z = (centered * inv[:, None] * nw[None, :] + nb[None, :]) * gate
+
+    w = tl.load(
+        out_w + offs_c[None, :] * H + offs_h[:, None],
+        mask=valid_c[None, :],
+        other=0.0,
+    ).to(tl.float32)
+    acc = tl.dot(z, w, input_precision="tf32")
+    tl.store(out + offs_m[:, None] * C + offs_c[None, :], acc, mask=valid_c[None, :])

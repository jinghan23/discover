from pathlib import Path
import os,tempfile,sys,math
sys.path.insert(0,str(Path.cwd()))
from libkernelbot.consts import SubmissionMode
from libkernelbot.run_eval import run_config
from libkernelbot.task import build_task_config, make_task_definition
config=build_task_config(task=make_task_definition(Path('task.yml')).task, submission_content=Path('submission.py').read_text(), arch=None, mode=SubmissionMode.LEADERBOARD)
with tempfile.TemporaryDirectory(prefix='run_',dir=Path.cwd()/'eval_tmp') as tmp_dir:
 old=os.getcwd(); os.chdir(tmp_dir)
 try: result=run_config(config)
 finally: os.chdir(old)
for name, rr in result.runs.items(): print(name, rr.run.passed if rr.run else None)
if 'leaderboard' in result.runs:
 res=result.runs['leaderboard'].run.result; print(res)
 if result.runs['leaderboard'].run.passed:
  means=[]
  for i in range(int(res['benchmark-count'])):
   x=float(res[f'benchmark.{i}.mean'])/1000; means.append(x); print(i,x)
  print('geom', math.exp(sum(math.log(x) for x in means)/len(means)))
else: print(result.runs['test'].run.result)

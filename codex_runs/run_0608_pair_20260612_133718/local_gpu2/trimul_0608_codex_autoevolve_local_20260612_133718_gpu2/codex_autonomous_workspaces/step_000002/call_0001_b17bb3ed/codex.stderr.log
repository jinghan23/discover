/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
from pathlib import Path
import math, os, tempfile, sys
sys.path.insert(0, str(Path.cwd()))
from libkernelbot.consts import SubmissionMode
from libkernelbot.run_eval import run_config
from libkernelbot.task import build_task_config, make_task_definition

task=make_task_definition(Path('task.yml')).task
code=Path('submission.py').read_text()
config=build_task_config(task=task, submission_content=code, arch=None, mode=SubmissionMode.LEADERBOARD)
with tempfile.TemporaryDirectory(prefix='run_', dir=Path.cwd()/'eval_tmp') as tmp_dir:
    old=os.getcwd(); os.chdir(tmp_dir)
    try: result=run_config(config)
    finally: os.chdir(old)
run=result.runs['leaderboard'].run
print('passed', run.passed)
if not run.passed:
    print(run.result); raise SystemExit(1)
res=run.result; means=[]

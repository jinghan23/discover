def _norm_gate_project_packed(out_h, proj, norm_w, norm_b, out_w, B: int, N: int, H: int, C: int):
    out = torch.empty((B, N, N, C), device=out_h.device, dtype=torch.float32)
    block_c = 64
    _norm_gate_project_packed_kernel[(triton.cdiv(B * N * N, 16), triton.cdiv(C, block_c))](

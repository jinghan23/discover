codex
The conditional C=128 fast path drops the geometric mean to about `2546 us`. The remaining large cost is the C=384 path, especially input layer norm and the two projections, so I’m going to microbenchmark Triton tile choices before changing those kernels.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
from reference import generate_input
from submission import _layernorm_bf16_kernel

def bench(B,N,C, block_m, block_c, warps, reps=50):
    data=generate_input(seqlen=N,bs=B,dim=C,hiddendim=128,seed=1,nomask=True,distribution='normal')
    x,_,w,_=data; nw=w['norm.weight']; nb=w['norm.bias']
    y=torch.empty_like(x, dtype=torch.bfloat16)
    grid=(triton.cdiv(B*N*N, block_m),)
    for _ in range(10):
        _layernorm_bf16_kernel[grid](x,nw,nb,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps)
    torch.cuda.synchronize()
    times=[]
    for _ in range(reps):
        start=torch.cuda.Event(True); end=torch.cuda.Event(True)
        start.record(); _layernorm_bf16_kernel[grid](x,nw,nb,y,C,BLOCK_M=block_m,BLOCK_C=block_c,num_warps=warps); end.record(); torch.cuda.synchronize()
        times.append(start.elapsed_time(end)*1000)
    return sum(times)/len(times), min(times)

for C,N,B in [(128,1024,1),(384,1024,1),(384,768,1),(384,256,2)]:
    print('C,N,B',C,N,B)
    bcs = [128] if C<=128 else ([256] if C<=256 else [512])
    for bm in [4,8,16,32,64]:
        for bc in bcs:
            for warps in [4,8]:
                try:
                    mean,best=bench(B,N,C,bm,bc,warps,20)
                    print('bm',bm,'bc',bc,'w',warps,'mean_us',round(mean,2),'best',round(best,2))
                except Exception as e:
                    print('ERR',bm,bc,warps,e)
    print()

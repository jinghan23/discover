/bin/bash -lc "python - <<'PY'
import random, torch
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def fp32ln_packed5(data):
    input_tensor,mask,weights,config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_fp32(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C).to(torch.bfloat16)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=sub._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=sub._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

fails=0
for k in range(300):
    seed=random.randrange(1,10000000)
    data=generate_input(256,2,128,128,seed,True,'normal')
    out=fp32ln_packed5(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    if not ok:
        fails+=1; print('fail',seed,msg.split('\\n')[0], msg.split('\\n')[1] if '\\n' in msg else '')
        if fails>=3: break
print('fails',fails)
case=dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal')
data=generate_input(**case)
for name,fn in [('fp32ln5',fp32ln_packed5),('current',sub.custom_kernel)]:
    out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out); print(name,ok,msg.split('\\n')[0] if msg else '')
    for _ in range(3): fn(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(name,sum(times)/len(times), ['%.1f'%t for t in times])

codex
The current profile shows packing is now as expensive as the batched GEMM on N=1024. I’m comparing the Triton packing kernel against a PyTorch elementwise plus `permute().contiguous()` path to see whether library kernels copy the layout faster.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def torch_pack(proj, mask, B,N,H):
    lp=proj[..., :H]
    rp=proj[..., H:2*H]
    lg=proj[..., 2*H:3*H]
    rg=proj[..., 3*H:4*H]
    if mask.dtype is torch.float32:
        left=(lp*torch.sigmoid(lg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
        right=(rp*torch.sigmoid(rg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
    else:
        m=mask.unsqueeze(-1).to(lp.dtype)
        left=(lp*m*torch.sigmoid(lg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
        right=(rp*m*torch.sigmoid(rg)).permute(0,3,1,2).reshape(B*H,N,N).contiguous()
    return left,right

def torch_pack_kernel(data):
    input_tensor,mask,weights,config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=torch_pack(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=sub._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

for case in [
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]:
    data=generate_input(**case)
    out=torch_pack_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('case',case,ok,msg.split('\\n')[0] if msg else '')
    if not ok: continue
    for _ in range(3): torch_pack_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); torch_pack_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('torchpack mean',sum(times)/len(times), ['%.1f'%t for t in times])
    for _ in range(3): sub.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); sub.custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('tritonpack mean',sum(times)/len(times), ['%.1f'%t for t in times])

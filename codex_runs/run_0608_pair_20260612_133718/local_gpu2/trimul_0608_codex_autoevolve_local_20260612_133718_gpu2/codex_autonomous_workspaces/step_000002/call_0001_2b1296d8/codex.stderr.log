+    vals = tl.where(valid_c[:, None], vals, 0.0)
+    mean = tl.sum(vals, axis=0) / C
+    centered = tl.where(valid_c[:, None], vals - mean[None, :], 0.0)
+    var = tl.sum(centered * centered, axis=0) / C
+    inv = tl.rsqrt(var + 1.0e-5)

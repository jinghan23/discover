codex
The packed-5 FP32-layernorm variant is faster but still fails random seeds, so the small-N robust path needs the FP32 output gate. I’ll focus remaining effort on larger cases where the robust fallback does not apply.
codex
For C=384 large cases, projection dominates. I’m checking whether splitting 5H projection into 4H plus out-gate changes cuBLAS efficiency enough to help, even though total math is the same.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def split_c384(data):
    input_tensor,mask,weights,config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    tw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight']),dim=0).to(torch.bfloat16)
    tri=F.linear(x,tw)
    og=F.linear(x,weights['out_gate.weight'].to(torch.bfloat16))
    left,right=sub._sigmoid_mask_layout_packed4(tri,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=sub._norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

for case in [
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]:
    data=generate_input(**case)
    out=split_c384(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('case',case,ok,msg.split('\\n')[0] if msg else '')
    if not ok: continue
    for _ in range(3): split_c384(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); split_c384(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('split mean',sum(times)/len(times), ['%.1f'%t for t in times])
    for _ in range(3): sub.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); sub.custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('packed5 mean',sum(times)/len(times), ['%.1f'%t for t in times])

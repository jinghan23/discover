codex
Avoiding packing entirely would require batched GEMM over non-contiguous H-strided matrices. I’m prototyping that layout to confirm whether cuBLAS can handle it efficiently or whether K-contiguous packing is necessary.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def nopack_kernel(data):
    input_tensor,mask,weights,config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    lp=proj[..., :H]; rp=proj[..., H:2*H]; lg=proj[..., 2*H:3*H]; rg=proj[..., 3*H:4*H]
    if mask.dtype is torch.float32:
        left_pair=lp*torch.sigmoid(lg)
        right_pair=rp*torch.sigmoid(rg)
    else:
        m=mask.unsqueeze(-1).to(lp.dtype)
        left_pair=lp*m*torch.sigmoid(lg)
        right_pair=rp*m*torch.sigmoid(rg)
    if B==1:
        left=left_pair.as_strided((H,N,N),(1,N*H,H))
        right=right_pair.as_strided((H,N,N),(1,N*H,H))
        out_h=torch.bmm(left,right.transpose(1,2))
    else:
        chunks=[]
        for b in range(B):
            left=left_pair[b].as_strided((H,N,N),(1,N*H,H))
            right=right_pair[b].as_strided((H,N,N),(1,N*H,H))
            chunks.append(torch.bmm(left,right.transpose(1,2)))
        out_h=torch.cat(chunks, dim=0)
    z=sub._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

for case in [
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
]:
    data=generate_input(**case)
    out=nopack_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('case',case,ok,msg.split('\\n')[0] if msg else '')
    if not ok: continue
    for _ in range(3): nopack_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); nopack_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('nopack mean',sum(times)/len(times), ['%.1f'%t for t in times])
    for _ in range(3): sub.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); sub.custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('packed mean',sum(times)/len(times), ['%.1f'%t for t in times])

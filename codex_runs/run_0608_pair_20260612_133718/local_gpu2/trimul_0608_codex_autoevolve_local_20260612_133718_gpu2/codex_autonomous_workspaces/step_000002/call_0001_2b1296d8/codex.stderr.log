/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input, check_implementation
from submission import custom_kernel
cases = [
 dict(seqlen=32, bs=1, dim=128, hiddendim=128, seed=1092, nomask=False, distribution='normal'),
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=5321, nomask=False, distribution='cauchy'),
]
for idx, case in enumerate(cases):
    data=generate_input(**case)
    out=custom_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print(idx, ok, msg.split('\\n')[0] if msg else '')
    if not ok: break
    for _ in range(3): custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    reps=5
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(sum(times)/len(times), ['%.1f'%t for t in times])

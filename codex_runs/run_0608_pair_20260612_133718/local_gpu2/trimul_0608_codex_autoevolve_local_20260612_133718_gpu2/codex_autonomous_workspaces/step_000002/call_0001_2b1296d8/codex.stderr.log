/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input, check_implementation
from submission import custom_kernel
cases = [
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=32, bs=1, dim=128, hiddendim=128, seed=1092, nomask=False, distribution='normal'),
]
for idx, case in enumerate(cases):
    data=generate_input(**case)
    out=custom_kernel(data); torch.cuda.synchronize()
    ok,msg=check_implementation(data,out)
    print(idx, ok, msg.split('\\n')[0] if msg else '')
    if ok:
        for _ in range(3): out=custom_kernel(data)
        torch.cuda.synchronize(); times=[]
        for _ in range(5):
            s=torch.cuda.Event(True); e=torch.cuda.Event(True)
            s.record(); out=custom_kernel(data); e.record(); torch.cuda.synchronize()
            times.append(s.elapsed_time(e)*1000)
        print('mean', sum(times)/len(times), ['%.1f'%t for t in times])

/bin/bash -lc "python - <<'PY'
import random, torch
from reference import generate_input, check_implementation
from submission import custom_kernel
fails=0
for k in range(100):
    seed=random.randrange(1,1000000)
    case=dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=seed, nomask=True, distribution='normal')
    data=generate_input(**case)
    out=custom_kernel(data); torch.cuda.synchronize()
    ok,msg=check_implementation(data,out)
    if not ok:
        fails+=1
        print('fail',seed,msg.split('\\n')[0], msg.split('\\n')[1] if '\\n' in msg else '')
        if fails>=3: break
print('fails',fails)
PY" in /opt/tiger/discover/workspace

codex
The contraction itself is a single batched GEMM call. I’m checking whether PyTorch routes `bmm`, `matmul`, or `baddbmm` differently for these BF16 strided batches.
exec
/bin/bash -lc "python - <<'PY'
import torch
from reference import generate_input
import submission as sub

def make_lr(data):
    input_tensor, mask, weights, config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_bf16(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C)
    import torch.nn.functional as F
    pw=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,pw)
    left,right=sub._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    return left,right
for case in [
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
]:
    data=generate_input(**case); left,right=make_lr(data); rt=right.transpose(1,2); torch.cuda.synchronize()
    print('case', case, left.shape)
    methods=[]
    methods.append(('bmm', lambda: torch.bmm(left,rt)))
    methods.append(('matmul', lambda: torch.matmul(left,rt)))
    out=torch.empty_like(left)
    methods.append(('baddbmm', lambda: torch.baddbmm(out,left,rt,beta=0.0,alpha=1.0)))
    for name,fn in methods:
        for _ in range(5): y=fn()
        torch.cuda.synchronize(); times=[]
        for _ in range(10):
            s=torch.cuda.Event(True); e=torch.cuda.Event(True)
            s.record(); y=fn(); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
        print(name, sum(times)/len(times), ['%.1f'%t for t in times])

/bin/bash -lc "python - <<'PY'
import random, torch
from reference import generate_input, check_implementation
from submission import custom_kernel
for N,B,dist,nomask,samples in [(32,1,'normal',False,100),(256,1,'normal',False,150),(256,1,'cauchy',True,150),(256,2,'normal',True,200),(1024,1,'cauchy',True,100),(768,2,'cauchy',True,30)]:
    fails=0
    for k in range(samples):
        seed=random.randrange(1,10000000)
        data=generate_input(N,B,128,128,seed,nomask,dist)
        out=custom_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
        if not ok:
            fails+=1; print('fail',N,B,dist,nomask,seed,msg.split('\\n')[0], msg.split('\\n')[1] if '\\n' in msg else '')
            break
    print('case',N,B,dist,nomask,'fails',fails)

/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def ln_alt(input_tensor, w, b, B,N,C, bm, bc, warps):
    y=torch.empty_like(input_tensor, dtype=torch.bfloat16)
    sub._layernorm_bf16_kernel[(triton.cdiv(B*N*N,bm),)](input_tensor,w,b,y,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
    return y

def alt_kernel(data,bm,bc,warps):
    input_tensor, mask, weights, config=data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=ln_alt(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,bm,bc,warps)
    proj_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    proj=F.linear(x,proj_weight)
    left,right=sub._sigmoid_mask_layout_packed(proj,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=sub._norm_gate_packed(out_h,proj,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

for case, configs in [
 (dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'), [(16,128,4),(32,128,4),(64,128,4),(64,128,8)]),
 (dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), [(8,512,8),(16,512,8),(32,512,8),(16,512,4),(8,512,4)]),
]:
    data=generate_input(**case)
    print('case', case)
    for cfg in configs:
        out=alt_kernel(data,*cfg); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
        print('cfg', cfg, ok, msg.split('\\n')[0] if msg else '')
        for _ in range(3): alt_kernel(data,*cfg)
        torch.cuda.synchronize(); times=[]
        for _ in range(5):
            s=torch.cuda.Event(True); e=torch.cuda.Event(True)
            s.record(); alt_kernel(data,*cfg); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
        print('mean', sum(times)/len(times), ['%.1f'%t for t in times])

codex
For masked C=384 cases, dense projection spends work on rows that will be zeroed. I’m prototyping a compacted masked projection path in a one-off script to see whether saving GEMM work beats `nonzero`/gather/scatter overhead.
exec
/bin/bash -lc "python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission as sub

def sparse_mask_kernel(data):
    input_tensor, mask, weights, config = data
    B=input_tensor.shape[0]; N=input_tensor.shape[1]; C=config['dim']; H=config['hidden_dim']
    x=sub._layernorm_bf16(input_tensor, weights['norm.weight'], weights['norm.bias'], B,N,C)
    flat_mask=mask.reshape(-1).bool()
    idx=torch.nonzero(flat_mask, as_tuple=False).flatten()
    x2=x.reshape(-1,C)
    x_sel=x2.index_select(0, idx)
    tri_weight=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight']), dim=0).to(torch.bfloat16)
    tri_sel=F.linear(x_sel, tri_weight)
    tri_full=torch.empty((B*N*N, 4*H), device=x.device, dtype=torch.bfloat16)
    tri_full.zero_()
    tri_full.index_copy_(0, idx, tri_sel)
    out_gate=F.linear(x, weights['out_gate.weight'].to(torch.bfloat16))
    left,right=sub._sigmoid_mask_layout_packed4(tri_full, torch.ones((),device=x.device), B,N,H)
    out_h=torch.bmm(left, right.transpose(1,2))
    z=sub._norm_gate(out_h, out_gate, weights['to_out_norm.weight'], weights['to_out_norm.bias'], B,N,H)
    return F.linear(z, weights['to_out.weight']).to(torch.float32)

for case in [
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=5321, nomask=False, distribution='cauchy'),
]:
    data=generate_input(**case)
    out=sparse_mask_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
    print('case', case, ok, msg.split('\\n')[0] if msg else '')
    for _ in range(3): sparse_mask_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); sparse_mask_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('sparse mean', sum(times)/len(times), ['%.1f'%t for t in times])
    for _ in range(3): sub.custom_kernel(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); sub.custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print('dense mean', sum(times)/len(times), ['%.1f'%t for t in times])
PY" in /opt/tiger/discover/workspace

I’ll test the dual-output layernorm on the C=128 random cases that previously exposed precision failures.
exec
/bin/bash -lc "python - <<'PY'
import random, torch
from reference import generate_input, check_implementation
from submission import custom_kernel
checks=[(256,2,'normal',True,120),(768,2,'cauchy',True,60),(1024,1,'cauchy',True,60)]
for N,B,dist,nomask,samples in checks:
    fails=0
    for k in range(samples):
        seed=random.randrange(1,10000000)
        data=generate_input(N,B,128,128,seed,nomask,dist)
        out=custom_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
        if not ok:
            fails+=1; print('fail',N,B,dist,seed,msg.split('\\n')[0], msg.split('\\n')[1] if '\\n' in msg else '')
            break
    print('case',N,B,dist,'fails',fails)
case=dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal')
data=generate_input(**case)
for _ in range(3): custom_kernel(data)
torch.cuda.synchronize(); times=[]
for _ in range(8):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True)
    s.record(); custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
print('N256B2 mean',sum(times)/len(times), ['%.1f'%t for t in times])
case=dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy')
data=generate_input(**case)
for _ in range(3): custom_kernel(data)
torch.cuda.synchronize(); times=[]
for _ in range(5):
    s=torch.cuda.Event(True); e=torch.cuda.Event(True)
    s.record(); custom_kernel(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
print('N1024 mean',sum(times)/len(times), ['%.1f'%t for t in times])

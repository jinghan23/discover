    for k in range(120):
        seed=random.randrange(1,10000000)
        data=generate_input(768,bs,128,128,seed,True,dist)
        out=custom_kernel(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
        if not ok:
            fails+=1; print('fail',dist,bs,seed,msg.split('\\n')[0], msg.split('\\n')[1] if '\\n' in msg else '')
            break
    print('dist',dist,'bs',bs,'fails',fails)

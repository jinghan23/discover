 dict(seqlen=768, bs=2, dim=128, hiddendim=128, seed=731, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=53121, nomask=False, distribution='normal'),

from reference import generate_input
from submission import custom_kernel
import torch
from torch.profiler import profile, ProfilerActivity
cases=[dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal'),
       dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'),
       dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')]
for c in cases:
    data=generate_input(**c)
    for _ in range(3): custom_kernel(data)
    torch.cuda.synchronize()
    with profile(activities=[ProfilerActivity.CUDA]) as prof:
        out=custom_kernel(data)
        torch.cuda.synchronize()
    print('\\nCASE', c)
    print(prof.key_averages().table(sort_by='self_cuda_time_total', row_limit=30))

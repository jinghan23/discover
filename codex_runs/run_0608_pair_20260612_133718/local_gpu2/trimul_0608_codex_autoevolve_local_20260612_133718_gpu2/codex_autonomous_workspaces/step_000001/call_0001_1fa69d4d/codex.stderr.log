+    mean = tl.sum(vals, axis=0) / C
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / C
+    has_extreme = tl.max(tl.abs(vals), axis=0) > 10.0
+    inv_fast = tl.rsqrt(var + 1.0e-5)

from reference import generate_input
from submission import _layernorm_bf16
import torch, torch.nn.functional as F
cases=[dict(seqlen=768,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'),
       dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'),
       dict(seqlen=128,bs=1,dim=768,hiddendim=128,seed=8134,nomask=True,distribution='cauchy')]
for c in cases:
    data=generate_input(**c); x,mask,w,cfg=data; B,N=x.shape[:2]; C=cfg['dim']
    y=_layernorm_bf16(x,w['norm.weight'],w['norm.bias'],B,N,C)
    ref=F.layer_norm(x,(C,),w['norm.weight'],w['norm.bias'],eps=1e-5).to(torch.bfloat16)
    torch.cuda.synchronize()
    diff=(y.float()-ref.float()).abs()
    print(c, 'max', diff.max().item(), 'num"'!='"', (y"'!=ref).sum().item(), '"'mean', diff.float().mean().item())
    idx=diff.argmax().item(); print('idx flat', idx, 'y/ref', y.flatten()[idx].item(), ref.flatten()[idx].item())

from reference import generate_input, check_implementation
from submission import custom_kernel
import torch, random
cases=[('b0',dict(seqlen=256,bs=2,dim=128,hiddendim=128,nomask=True,distribution='normal')),
       ('b3',dict(seqlen=512,bs=1,dim=128,hiddendim=128,nomask=True,distribution='normal')),

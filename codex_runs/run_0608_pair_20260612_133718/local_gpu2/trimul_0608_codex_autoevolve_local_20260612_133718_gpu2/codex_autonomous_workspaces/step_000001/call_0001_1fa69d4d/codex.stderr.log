for name,base in cases:
    fails=0
    for seed in range(1000,1020):
        c=base.copy(); c['seed']=seed
        data=generate_input(**c)
        out=custom_kernel(data); torch.cuda.synchronize()
        good,msg=check_implementation(data,out)

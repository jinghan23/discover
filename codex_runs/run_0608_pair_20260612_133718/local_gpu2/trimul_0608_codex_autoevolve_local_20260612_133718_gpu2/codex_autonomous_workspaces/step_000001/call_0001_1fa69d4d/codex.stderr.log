+def _layernorm_bf16_kernel(
+    x,
+    w,
+    b,
+    y,
+    n_rows: tl.constexpr,
+    C: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_c = tl.arange(0, BLOCK_C)
+    mask = (rows[None, :] < n_rows) & (offs_c[:, None] < C)
+    ptrs = x + rows[None, :] * C + offs_c[:, None]
+    vals = tl.load(ptrs, mask=mask, other=0.0).to(tl.float32)
+
+    mean = tl.sum(vals, axis=0) / C
+    centered = vals - mean[None, :]
+    var = tl.sum(centered * centered, axis=0) / C
+    has_extreme = tl.max(tl.abs(vals), axis=0) > 10.0
+    inv_fast = tl.rsqrt(var + 1.0e-5)
+    inv_safe = 1.0 / tl.sqrt(var + 1.0e-5)
+    inv = tl.where(has_extreme, inv_safe, inv_fast)
+
+    nw = tl.load(w + offs_c, mask=offs_c < C, other=0.0).to(tl.float32)
+    nb = tl.load(b + offs_c, mask=offs_c < C, other=0.0).to(tl.float32)
+    out = centered * inv[None, :] * nw[:, None] + nb[:, None]
+    tl.store(y + rows[None, :] * C + offs_c[:, None], out, mask=mask)
+
+
+@triton.jit
+def _layernorm128_welford_bf16_kernel(
+    x,
+    w,
+    b,
+    y,
+    n_rows: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    valid_m = rows < n_rows
+
+    mean = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    m2 = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    count = tl.full((BLOCK_M,), 0.0, dtype=tl.float32)
+    for c in tl.static_range(0, 128):
+        vals = tl.load(x + rows * 128 + c, mask=valid_m, other=0.0).to(tl.float32)
+        count += 1.0
+        delta = vals - mean
+        mean += delta / count
+        delta2 = vals - mean
+        m2 += delta * delta2
+
+    inv = tl.rsqrt(m2 / 128.0 + 1.0e-5)
+    offs_c = tl.arange(0, 128)
+    vals = tl.load(x + rows[None, :] * 128 + offs_c[:, None], mask=valid_m[None, :], other=0.0).to(tl.float32)
+    nw = tl.load(w + offs_c).to(tl.float32)
+    nb = tl.load(b + offs_c).to(tl.float32)
+    out = (vals - mean[None, :]) * inv[None, :] * nw[:, None] + nb[:, None]
+    tl.store(y + rows[None, :] * 128 + offs_c[:, None], out, mask=valid_m[None, :])
+
+

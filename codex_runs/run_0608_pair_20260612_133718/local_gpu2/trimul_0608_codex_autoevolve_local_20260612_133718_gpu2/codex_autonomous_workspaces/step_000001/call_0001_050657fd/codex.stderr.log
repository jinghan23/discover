    for name,fn in [('fp32_pack_current',custom_kernel),('bf16tri_fp32og',fn_bf16_tri_fp32_og),('fp32tri_bf16og',fn_fp32_tri_bf16_og)]:
        out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(_clone_data(data),out)

codex
Two plausible optimizations are worth measuring before a rewrite: using one wider projection GEMM instead of five separate GEMMs, and doing the projection/final dense matmuls in BF16. The tolerance may allow BF16, but the small-output absolute tolerance is the deciding factor.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=2 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
from eval import _clone_data
from submission import _sigmoid_mask_layout, _norm_gate, custom_kernel

torch.backends.cuda.matmul.allow_tf32=True
torch.set_float32_matmul_precision('high')

def timed(fn,data,it=5):
    for _ in range(2):
        o=fn(data); torch.cuda.synchronize(); del o
    ds=[]
    for _ in range(it):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); ds.append(s.elapsed_time(e)*1000); del o
    return sum(ds)/len(ds), min(ds), [round(x,1) for x in ds]

def fn_cat_fp32(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5)
    w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']), dim=0)
    p=F.linear(x,w)
    lp,rp,lg,rg,og=p.split(H, dim=-1)
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def fn_bf16_sep(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5).to(torch.bfloat16)
    lp=F.linear(x,weights['left_proj.weight'].to(torch.bfloat16))
    rp=F.linear(x,weights['right_proj.weight'].to(torch.bfloat16))
    lg=F.linear(x,weights['left_gate.weight'].to(torch.bfloat16))
    rg=F.linear(x,weights['right_gate.weight'].to(torch.bfloat16))
    og=F.linear(x,weights['out_gate.weight'].to(torch.bfloat16))
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def fn_bf16_cat(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5).to(torch.bfloat16)
    w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']), dim=0).to(torch.bfloat16)
    p=F.linear(x,w)
    lp,rp,lg,rg,og=p.split(H, dim=-1)
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def fn_bf16_cat_final(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5).to(torch.bfloat16)
    w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']), dim=0).to(torch.bfloat16)
    p=F.linear(x,w)
    lp,rp,lg,rg,og=p.split(H, dim=-1)
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z.to(torch.bfloat16),weights['to_out.weight'].to(torch.bfloat16)).to(torch.float32)

cases=[
  {\"seqlen\": 256, \"bs\": 2, \"dim\": 128, \"hiddendim\": 128, \"seed\": 9371, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 1024, \"bs\": 1, \"dim\": 128, \"hiddendim\": 128, \"seed\": 381, \"nomask\": True, \"distribution\": \"cauchy\"},
  {\"seqlen\": 1024, \"bs\": 1, \"dim\": 384, \"hiddendim\": 128, \"seed\": 23291, \"nomask\": True, \"distribution\": \"normal\"},
  {\"seqlen\": 768, \"bs\": 1, \"dim\": 384, \"hiddendim\": 128, \"seed\": 481, \"nomask\": False, \"distribution\": \"normal\"},
]
variants=[('base',custom_kernel),('cat_fp32',fn_cat_fp32),('bf16_sep',fn_bf16_sep),('bf16_cat',fn_bf16_cat),('bf16_cat_final',fn_bf16_cat_final)]
for ci,c in enumerate(cases):
    print('\\nCASE',ci,c)
    data=generate_input(**c)
    for name,fn in variants:
        try:
            out=fn(data); torch.cuda.synchronize()
            ok,msg=check_implementation(_clone_data(data),out)
            print(' ',name,'ok',ok,msg.split('\\n')[0] if msg else '')
            if ok:
                print('   time',timed(fn,data,it=4))
            del out
        except Exception as e:
            torch.cuda.synchronize()
            print(' ',name,'EXC',type(e).__name__,e)
    del data

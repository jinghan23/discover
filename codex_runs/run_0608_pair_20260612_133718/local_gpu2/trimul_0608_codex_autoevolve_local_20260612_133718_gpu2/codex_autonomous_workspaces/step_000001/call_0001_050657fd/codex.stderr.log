import torch, triton, torch.nn.functional as F
from reference import generate_input, check_implementation
from eval import _clone_data
from submission import _layernorm_bf16_kernel, _sigmoid_mask_layout_packed, _norm_gate_packed, custom_kernel

def ln_param(input_tensor,w,b,B,N,C,bm,bc,warps,dtype=torch.bfloat16):
    y=torch.empty_like(input_tensor,dtype=dtype)
    _layernorm_bf16_kernel[(triton.cdiv(B*N*N,bm),)](input_tensor,w,b,y,C,BLOCK_M=bm,BLOCK_C=bc,num_warps=warps)
    return y

def fn_param(data,bm,warps):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    bc=512 if C<=512 else 1024
    x=ln_param(input_tensor,weights['norm.weight'],weights['norm.bias'],B,N,C,bm,bc,warps,torch.bfloat16)
    w=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.bfloat16)
    p=F.linear(x,w)
    left,right=_sigmoid_mask_layout_packed(p,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate_packed(out_h,p,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def timed(fn,it=5):
    for _ in range(2): o=fn(); torch.cuda.synchronize(); del o
    ds=[]
    for _ in range(it):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); o=fn(); e.record(); torch.cuda.synchronize(); ds.append(s.elapsed_time(e)*1000); del o
    return sum(ds)/len(ds),min(ds),[round(x,1) for x in ds]

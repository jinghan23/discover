import torch, random, torch.nn.functional as F
from reference import generate_input, check_implementation
from eval import _clone_data
from submission import _sigmoid_mask_layout, _norm_gate, _sigmoid_mask_layout_packed, _norm_gate_packed, custom_kernel

def fn_bf16_tri_fp32_og(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5)
    xb=x.to(torch.bfloat16)
    lp=F.linear(xb,weights['left_proj.weight'].to(torch.bfloat16))
    rp=F.linear(xb,weights['right_proj.weight'].to(torch.bfloat16))
    lg=F.linear(xb,weights['left_gate.weight'].to(torch.bfloat16))
    rg=F.linear(xb,weights['right_gate.weight'].to(torch.bfloat16))
    og=F.linear(x,weights['out_gate.weight'])
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def fn_fp32_tri_bf16_og(data):
    input_tensor, mask, weights, config=data
    B,N,C=input_tensor.shape[0],input_tensor.shape[1],config['dim']; H=config['hidden_dim']
    x=F.layer_norm(input_tensor,(C,),weights['norm.weight'],weights['norm.bias'],eps=1e-5)
    lp=F.linear(x,weights['left_proj.weight'])
    rp=F.linear(x,weights['right_proj.weight'])
    lg=F.linear(x,weights['left_gate.weight'])
    rg=F.linear(x,weights['right_gate.weight'])
    xb=x.to(torch.bfloat16)
    og=F.linear(xb,weights['out_gate.weight'].to(torch.bfloat16))
    left,right=_sigmoid_mask_layout(lp,rp,lg,rg,mask,B,N,H)
    out_h=torch.bmm(left,right.transpose(1,2))
    z=_norm_gate(out_h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],B,N,H)
    return F.linear(z,weights['to_out.weight']).to(torch.float32)

def timed(fn,data,it=4):
    for _ in range(2): o=fn(data); torch.cuda.synchronize(); del o
    ds=[]
    for _ in range(it):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); ds.append(s.elapsed_time(e)*1000); del o
    return sum(ds)/len(ds), min(ds), [round(x,1) for x in ds]

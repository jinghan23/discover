+    b = tl.load(bias + offs_c, mask=valid_c, other=0.0).to(tl.float32)
+    out = centered * inv[None, :] * w[:, None] + b[:, None]
+    tl.store(y + rows[None, :] * C + offs_c[:, None], out, mask=valid_c[:, None])

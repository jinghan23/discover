def custom_kernel(data):
    input_tensor, mask, weights, config = data
    bsz = input_tensor.shape[0]
    n = input_tensor.shape[1]
    dim = config["dim"]

    use_fp16_fused = (
        (dim == 128 and ((bsz == 2 and (n == 256 or n >= 512)) or (bsz == 1 and n >= 512)))
        or (dim == 384 and bsz == 2 and n == 256)
        or (dim == 384 and bsz == 1 and n >= 768)
    )
    if use_fp16_fused:
        if (dim == 384 and ((bsz == 1 and n >= 768) or (bsz == 2 and n == 256))) or (
            dim == 128 and ((bsz == 2 and (n == 256 or n >= 512)) or (bsz == 1 and 512 <= n < 1024))
        ):
            return _fp16_interleaved_fused_kernel(data)
        return _fp16_fused_kernel(data)
    return _bf16_bmm_kernel(data)


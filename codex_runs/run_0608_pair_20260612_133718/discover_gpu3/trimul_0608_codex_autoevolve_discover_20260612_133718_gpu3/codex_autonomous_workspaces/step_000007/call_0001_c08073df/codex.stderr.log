import torch,triton
from reference import generate_input, check_implementation
import submission as s

def clone_data(data):
 x,m,w,c=data; return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))

def rawout_inter(data):
 x,m,w,c=data; b=x.shape[0]; n=x.shape[1]; dim=c['dim']; h=c['hidden_dim']; total=b*n*n
 xnorm=s._workspace('ro_x',(total,dim),torch.float16,x.device)
 lbm=8 if dim==384 else 128
 s._row_ln_fp16_kernel[(triton.cdiv(total,lbm),)](x.reshape(total,dim),xnorm,w['norm.weight'],w['norm.bias'],total,dim,1e-5,BLOCK_M=lbm,BLOCK_C=512 if dim==384 else 128,num_warps=4 if dim==384 else 8)
 pw=s._pack_interleaved_proj_workspace(w,dim,h,x.device)
 left=s._workspace('ro_l',(b,h,n,n),torch.float16,x.device); right=s._workspace('ro_r',(b,h,n,n),torch.float16,x.device); og=s._workspace('ro_og',(total,h),torch.float16,x.device)
 s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128),triton.cdiv(h,32))](xnorm,m.reshape(total),pw,left,right,og,total,n,dim,h,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=m.dtype"'!=torch.float32,num_warps=4)
 hidden=s._workspace('"'ro_h',(b*h,n,n),torch.float16,x.device); torch.bmm(left.reshape(b*h,n,n),right.reshape(b*h,n,n).transpose(1,2),out=hidden)
 out=s._workspace('ro_out',(b,n,n,dim),torch.float16,x.device)
 bm=128 if dim==384 and n>=1024 else 64
 s._ln_gate_out_linear_raw_fp16_kernel[(triton.cdiv(total,bm),)](hidden,og,w['to_out_norm.weight'],w['to_out_norm.bias'],w['to_out.weight'],out,b,n,h,dim,1e-5,BLOCK_M=bm,BLOCK_H=128,BLOCK_D=64 if dim==384 else 32,num_warps=4)
 return out

def bench(fn,spec,reps=3):
 data=generate_input(**spec); out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(clone_data(data),out); print('ok',ok,msg.split('\\n')[0] if msg else '')
 vals=[]
 for r in range(reps):
  sp=dict(spec); sp['seed']+=1000+r*13; data=generate_input(**sp); torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); out=fn(data); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
 print('mean',sum(vals)/len(vals),'best',min(vals))
for spec in [dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'), dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'), dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal')]:
 print('\\n',spec); bench(rawout_inter,spec,2)

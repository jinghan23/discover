 for name,fn in [('bf16',s._bf16_bmm_kernel),('inter',s._fp16_interleaved_fused_kernel),('fused',s._fp16_fused_kernel)]:
  try:
   out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(clone_data(data),out); print(dist,name,ok,msg.split('\\n')[0])
  except Exception as e: print(dist,name,'ERR',type(e).__name__,str(e).split('\\n')[0])

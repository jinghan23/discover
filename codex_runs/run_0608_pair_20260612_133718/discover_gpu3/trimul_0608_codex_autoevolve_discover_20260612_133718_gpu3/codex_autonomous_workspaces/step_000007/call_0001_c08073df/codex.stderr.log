import torch, triton
from reference import generate_input, check_implementation
import submission as s

def clone_data(data):
    x,m,w,c=data
    return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))

def make_wrap(bm,bk,warps=4):
  def fn(data):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    left=s._workspace(f'tlp_left_{bm}_{bk}',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    right=s._workspace(f'tlp_right_{bm}_{bk}',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    og=s._workspace(f'tlp_og_{bm}_{bk}',(total,hdim),torch.float16,input_tensor.device)
    lw=s._cached_transpose_to(weights['left_proj.weight'],torch.float16,'tlp')
    lg=s._cached_transpose_to(weights['left_gate.weight'],torch.float16,'tlg')
    rw=s._cached_transpose_to(weights['right_proj.weight'],torch.float16,'trp')
    rg=s._cached_transpose_to(weights['right_gate.weight'],torch.float16,'trg')
    ow=s._cached_transpose_to(weights['out_gate.weight'],torch.float16,'tog')
    s._ln_proj_gate_mask_fp16_kernel[(triton.cdiv(total,bm),)](
        input_tensor.reshape(total,dim), mask.reshape(total), weights['norm.weight'], weights['norm.bias'],
        lw,lg,rw,rg,ow,left,right,og,total,n,dim,hdim,1.0e-5,
        BLOCK_M=bm,BLOCK_H=128,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=warps,num_stages=3)
    hidden=s._workspace(f'"'tlp_hidden_{bm}_{bk}',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    outw=s._cached_transpose_to(weights['to_out.weight'],torch.float16,'out16')
    out=s._workspace(f'tlp_out_{bm}_{bk}',(bsz,n,n,dim),torch.float32,input_tensor.device)
    s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],outw,out,bsz,n,hdim,dim,1.0e-5,
        BLOCK_M=64,BLOCK_H=128,BLOCK_D=64 if dim==384 else 32,num_warps=4)
    return out
  return fn

def bench(fn,spec):
    data=generate_input(**spec)

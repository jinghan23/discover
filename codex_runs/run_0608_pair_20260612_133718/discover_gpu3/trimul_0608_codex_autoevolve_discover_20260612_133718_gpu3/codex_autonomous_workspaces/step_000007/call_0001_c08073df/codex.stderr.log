import torch, triton
from reference import generate_input, check_implementation
import submission as s

@triton.jit
def affine_kernel(x,w,b,y,M:tl.constexpr,C:tl.constexpr,BM:tl.constexpr,BC:tl.constexpr):
    pid=tl.program_id(0); rows=pid*BM+tl.arange(0,BM); cs=tl.arange(0,BC); mask=(rows[:,None]<M)&(cs[None,:]<C)
    xv=tl.load(x+rows[:,None]*C+cs[None,:],mask=mask,other=0.).to(tl.float32)
    ww=tl.load(w+cs,mask=cs<C,other=0.).to(tl.float32); bb=tl.load(b+cs,mask=cs<C,other=0.).to(tl.float32)
    tl.store(y+rows[:,None]*C+cs[None,:],xv*ww[None,:]+bb[None,:],mask=mask)

def clone_data(data):
 x,m,w,c=data; return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))

def approx(data):
 x,m,w,c=data; b=x.shape[0]; n=x.shape[1]; dim=c['dim']; h=c['hidden_dim']; total=b*n*n
 xnorm=s._workspace('approx_aff',(total,dim),torch.float16,x.device)
 affine_kernel[(triton.cdiv(total,64),)](x.reshape(total,dim),w['norm.weight'],w['norm.bias'],xnorm,total,dim,BM=64,BC=triton.next_power_of_2(dim),num_warps=4)
 pw=s._pack_interleaved_proj_workspace(w,dim,h,x.device)
 left=s._workspace('approx_l',(b,h,n,n),torch.float16,x.device); right=s._workspace('approx_r',(b,h,n,n),torch.float16,x.device); og=s._workspace('approx_og',(total,h),torch.float16,x.device)
 s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128),triton.cdiv(h,32))](xnorm,m.reshape(total),pw,left,right,og,total,n,dim,h,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=m.dtype"'!=torch.float32,num_warps=4)
 hidden=s._workspace('"'approx_hid',(b*h,n,n),torch.float16,x.device); torch.bmm(left.reshape(b*h,n,n),right.reshape(b*h,n,n).transpose(1,2),out=hidden)
 outw=s._cached_transpose_to(w['to_out.weight'],torch.float16,'out16'); out=s._workspace('approx_out',(b,n,n,dim),torch.float32,x.device)
 s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,og,w['to_out_norm.weight'],w['to_out_norm.bias'],outw,out,b,n,h,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=64 if dim==384 else 32,num_warps=4)
 return out
for spec in [dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'), dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal')]:

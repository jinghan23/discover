import torch, math, traceback, importlib
from reference import generate_input, check_implementation
import submission as s

variants = [
    ('inter', s._fp16_interleaved_fused_kernel),
    ('fused5', s._fp16_fused_kernel),
    ('raw', s._fp16_rawproj_kernel),
    ('packed', s._fp16_packed_fused_kernel),
    ('linear', s._fp16_linear_kernel),
    ('quad', s._fp16_quad_fused_kernel),
    ('normproj', lambda d: s._fp16_normproj_interleaved_kernel(d, False)),
    ('normtf32', lambda d: s._fp16_normproj_interleaved_kernel(d, True)),
    ('split', s._fp16_interleaved_split_kernel),
    ('bf16', s._bf16_bmm_kernel),
]
shapes = [
    dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
    dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
    dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
    dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
    dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
    dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
    dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]

def clone_data(data):
    x,m,w,c = data
    return (x.clone(), m.clone(), {k:v.clone() for k,v in w.items()}, dict(c))

def time_variant(fn, spec, reps=5):
    # compile and correctness on one data
    data = generate_input(**spec)
    out = fn(data)
    torch.cuda.synchronize()
    ok, msg = check_implementation(clone_data(data), out)
    if not ok:
        return None, 'bad ' + msg.split('\\n')[0]
    vals=[]
    for r in range(reps):
        spec2 = dict(spec); spec2['seed'] += 1000 + r*13
        data = generate_input(**spec2)
        torch.cuda.synchronize()
        st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); out=fn(data); en.record(); torch.cuda.synchronize()
        vals.append(st.elapsed_time(en)*1000)
        del out, data
    return sum(vals)/len(vals), f'best {min(vals):.1f}'

for si, spec in enumerate(shapes):
    print('\\nSHAPE', si, spec)
    for name, fn in variants:
        try:
            val, info = time_variant(fn, spec, reps=3)
            if val is None:
                print(name, info)
            else:
                print(name, f'{val:.1f} us', info)
        except torch.cuda.OutOfMemoryError as e:
            torch.cuda.empty_cache(); print(name, 'OOM')
        except Exception as e:
            torch.cuda.synchronize(); print(name, 'ERR', type(e).__name__, str(e).split('\\n')[0])

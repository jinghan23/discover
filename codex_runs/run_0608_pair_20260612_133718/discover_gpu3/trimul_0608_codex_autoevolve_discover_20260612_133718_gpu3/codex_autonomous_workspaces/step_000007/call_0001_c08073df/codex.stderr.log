The large-case improvement could come from either the smaller LayerNorm row tile or the output row tile. I’m isolating those two parameters in a wrapper so the final file keeps only changes that hold up independently.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch,triton
from reference import generate_input, check_implementation
import submission as s

def clone_data(data):
 x,m,w,c=data; return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))

def inter_param(data,ln_bm,out_bm):
 x,m,w,c=data; b=x.shape[0]; n=x.shape[1]; dim=c['dim']; h=c['hidden_dim']; total=b*n*n
 xnorm=s._workspace(f'ip_x_{ln_bm}_{out_bm}',(total,dim),torch.float16,x.device)
 s._row_ln_fp16_kernel[(triton.cdiv(total,ln_bm),)](x.reshape(total,dim),xnorm,w['norm.weight'],w['norm.bias'],total,dim,1e-5,BLOCK_M=ln_bm,BLOCK_C=512 if dim==384 else 128,num_warps=4 if dim==384 else 8)
 pw=s._pack_interleaved_proj_workspace(w,dim,h,x.device)
 left=s._workspace(f'ip_l_{ln_bm}_{out_bm}',(b,h,n,n),torch.float16,x.device); right=s._workspace(f'ip_r_{ln_bm}_{out_bm}',(b,h,n,n),torch.float16,x.device); og=s._workspace(f'ip_o_{ln_bm}_{out_bm}',(total,h),torch.float16,x.device)
 s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128),triton.cdiv(h,32))](xnorm,m.reshape(total),pw,left,right,og,total,n,dim,h,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=m.dtype"'!=torch.float32,num_warps=4)
 hidden=s._workspace(f'"'ip_h_{ln_bm}_{out_bm}',(b*h,n,n),torch.float16,x.device); torch.bmm(left.reshape(b*h,n,n),right.reshape(b*h,n,n).transpose(1,2),out=hidden)
 outw=s._cached_transpose_to(w['to_out.weight'],torch.float16,'out16'); out=s._workspace(f'ip_out_{ln_bm}_{out_bm}',(b,n,n,dim),torch.float16,x.device)
 s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,out_bm),)](hidden,og,w['to_out_norm.weight'],w['to_out_norm.bias'],outw,out,b,n,h,dim,1e-5,BLOCK_M=out_bm,BLOCK_H=128,BLOCK_D=64 if dim==384 else 32,num_warps=4)
 return out

def bench(spec):
 print('\\nSPEC',spec)
 for ln_bm,out_bm in [(32,64),(8,64),(32,128),(8,128),(16,64),(16,128)]:
  fn=lambda d,ln_bm=ln_bm,out_bm=out_bm: inter_param(d,ln_bm,out_bm)
  data=generate_input(**spec); out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(clone_data(data),out)
  if not ok: print(ln_bm,out_bm,'bad',msg.split('\\n')[0]); continue
  vals=[]
  for r in range(3):
   sp=dict(spec); sp['seed']+=2000+r*13; data=generate_input(**sp); torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); out=fn(data); en.record(); torch.cuda.synchronize(); vals.append(st.elapsed_time(en)*1000)
  print('ln',ln_bm,'out',out_bm,'mean',round(sum(vals)/len(vals),1),'best',round(min(vals),1))
for spec in [dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'), dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal')]:
 bench(spec)

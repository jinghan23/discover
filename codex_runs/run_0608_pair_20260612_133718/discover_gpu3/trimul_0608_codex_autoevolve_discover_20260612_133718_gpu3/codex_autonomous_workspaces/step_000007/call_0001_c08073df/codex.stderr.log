import torch,triton
from reference import generate_input, check_implementation
import submission as s

def clone_data(data):
 x,m,w,c=data; return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))

def inter_param(data,bd):
 x,m,w,c=data; b=x.shape[0]; n=x.shape[1]; dim=c['dim']; h=c['hidden_dim']; total=b*n*n
 xnorm=s._workspace(f'bd_x_{bd}',(total,dim),torch.float16,x.device)
 s._row_ln_fp16_kernel[(triton.cdiv(total,16),)](x.reshape(total,dim),xnorm,w['norm.weight'],w['norm.bias'],total,dim,1e-5,BLOCK_M=16,BLOCK_C=512,num_warps=4)
 pw=s._pack_interleaved_proj_workspace(w,dim,h,x.device)
 left=s._workspace(f'bd_l_{bd}',(b,h,n,n),torch.float16,x.device); right=s._workspace(f'bd_r_{bd}',(b,h,n,n),torch.float16,x.device); og=s._workspace(f'bd_o_{bd}',(total,h),torch.float16,x.device)
 s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128),triton.cdiv(h,32))](xnorm,m.reshape(total),pw,left,right,og,total,n,dim,h,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=m.dtype"'!=torch.float32,num_warps=4)
 hidden=s._workspace(f'"'bd_h_{bd}',(b*h,n,n),torch.float16,x.device); torch.bmm(left.reshape(b*h,n,n),right.reshape(b*h,n,n).transpose(1,2),out=hidden)
 outw=s._cached_transpose_to(w['to_out.weight'],torch.float16,'out16'); out=s._workspace(f'bd_out_{bd}',(b,n,n,dim),torch.float16,x.device)

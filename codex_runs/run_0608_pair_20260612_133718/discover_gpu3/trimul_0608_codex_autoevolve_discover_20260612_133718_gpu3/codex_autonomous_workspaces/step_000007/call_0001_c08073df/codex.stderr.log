@triton.jit
def _row_stats_kernel(
    x_ptr,
    mean_ptr,
    inv_ptr,
    M,
    C: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_C: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    row_mask = rows < M

    sum_val = tl.zeros((BLOCK_M,), dtype=tl.float32)
    sumsq_val = tl.zeros((BLOCK_M,), dtype=tl.float32)
    for c0 in range(0, C, BLOCK_C):
        cs = c0 + tl.arange(0, BLOCK_C)
        cmask = cs < C
        x = tl.load(
            x_ptr + rows[:, None] * C + cs[None, :],
            mask=row_mask[:, None] & cmask[None, :],
            other=0.0,
        ).to(tl.float32)
        sum_val += tl.sum(x, axis=1)
        sumsq_val += tl.sum(x * x, axis=1)

    mean = sum_val / C
    var = sumsq_val / C - mean * mean
    inv = tl.rsqrt(var + eps)
    tl.store(mean_ptr + rows, mean, mask=row_mask)
    tl.store(inv_ptr + rows, inv, mask=row_mask)



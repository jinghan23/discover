@triton.jit
def _proj_gate_mask_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_lp_ptr,
    w_lg_ptr,
    w_rp_ptr,
    w_rg_ptr,
    w_og_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    row_mask = rows < M
    hmask = hs < H

    acc_lp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_lg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        w_lp = tl.load(w_lp_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_lg = tl.load(w_lg_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_rp = tl.load(w_rp_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_rg = tl.load(w_rg_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_og = tl.load(w_og_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)

        acc_lp += tl.dot(a, w_lp)
        acc_lg += tl.dot(a, w_lg)
        acc_rp += tl.dot(a, w_rp)
        acc_rg += tl.dot(a, w_rg)
        acc_og += tl.dot(a, w_og)

    lg = tl.sigmoid(acc_lg)
    rg = tl.sigmoid(acc_rg)
    og = tl.sigmoid(acc_og)
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
        left_out = acc_lp * lg * mval[:, None]
        right_out = acc_rp * rg * mval[:, None]
    else:
        left_out = acc_lp * lg
        right_out = acc_rp * rg

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _proj_gate_mask_packed_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H

    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        pair_h = pair_cols // 2
        pair_second = pair_cols - pair_h * 2
        lcols = h_base + pair_h + pair_second * H
        rcols = 2 * H + h_base + pair_h + pair_second * H
        w_l = tl.load(
            w_ptr + ks[:, None] * (5 * H) + lcols[None, :],
            mask=kmask[:, None] & (lcols[None, :] < 5 * H),
            other=0.0,
        )
        w_r = tl.load(
            w_ptr + ks[:, None] * (5 * H) + rcols[None, :],
            mask=kmask[:, None] & (rcols[None, :] < 5 * H),
            other=0.0,
        )
        w_og = tl.load(
            w_ptr + ks[:, None] * (5 * H) + (4 * H + hs)[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc_l += tl.dot(a, w_l)
        acc_r += tl.dot(a, w_r)
        acc_og += tl.dot(a, w_og)

    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _proj_gate_mask_interleaved_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H

    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        lcols = 2 * h_base + pair_cols
        rcols = 2 * H + 2 * h_base + pair_cols
        ogcols = 4 * H + hs
        w_l = tl.load(
            w_ptr + ks[:, None] * (5 * H) + lcols[None, :],
            mask=kmask[:, None] & (lcols[None, :] < 2 * H),
            other=0.0,
        )
        w_r = tl.load(
            w_ptr + ks[:, None] * (5 * H) + rcols[None, :],
            mask=kmask[:, None] & (rcols[None, :] < 4 * H),
            other=0.0,
        )
        w_og = tl.load(
            w_ptr + ks[:, None] * (5 * H) + ogcols[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc_l += tl.dot(a, w_l)
        acc_r += tl.dot(a, w_r)
        acc_og += tl.dot(a, w_og)

    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _proj_gate_mask_interleaved_normed_fp16_kernel(
    x_ptr,
    mean_ptr,
    inv_ptr,
    mask_ptr,
    w_ptr,
    sum_ptr,
    bias_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
    USE_TF32: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H

    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        x = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        ).to(tl.float32)

        lcols = 2 * h_base + pair_cols
        rcols = 2 * H + 2 * h_base + pair_cols
        ogcols = 4 * H + hs
        w_l = tl.load(
            w_ptr + ks[:, None] * (5 * H) + lcols[None, :],
            mask=kmask[:, None] & (lcols[None, :] < 2 * H),
            other=0.0,
        )
        w_r = tl.load(
            w_ptr + ks[:, None] * (5 * H) + rcols[None, :],
            mask=kmask[:, None] & (rcols[None, :] < 4 * H),
            other=0.0,
        )
        w_og = tl.load(
            w_ptr + ks[:, None] * (5 * H) + ogcols[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        if USE_TF32:
            acc_l += tl.dot(x, w_l.to(tl.float32), input_precision="tf32")
            acc_r += tl.dot(x, w_r.to(tl.float32), input_precision="tf32")
            acc_og += tl.dot(x, w_og.to(tl.float32), input_precision="tf32")
        else:
            xh = x.to(tl.float16)
            acc_l += tl.dot(xh, w_l)
            acc_r += tl.dot(xh, w_r)
            acc_og += tl.dot(xh, w_og)

    mean = tl.load(mean_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    inv = tl.load(inv_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)

    lcols = 2 * h_base + pair_cols
    rcols = 2 * H + 2 * h_base + pair_cols
    ogcols = 4 * H + hs
    sl = tl.load(sum_ptr + lcols, mask=lcols < 2 * H, other=0.0).to(tl.float32)
    bl = tl.load(bias_ptr + lcols, mask=lcols < 2 * H, other=0.0).to(tl.float32)
    sr = tl.load(sum_ptr + rcols, mask=(rcols >= 2 * H) & (rcols < 4 * H), other=0.0).to(tl.float32)
    br = tl.load(bias_ptr + rcols, mask=(rcols >= 2 * H) & (rcols < 4 * H), other=0.0).to(tl.float32)
    so = tl.load(sum_ptr + ogcols, mask=hmask, other=0.0).to(tl.float32)
    bo = tl.load(bias_ptr + ogcols, mask=hmask, other=0.0).to(tl.float32)

    acc_l = (acc_l - mean[:, None] * sl[None, :]) * inv[:, None] + bl[None, :]
    acc_r = (acc_r - mean[:, None] * sr[None, :]) * inv[:, None] + br[None, :]
    acc_og = (acc_og - mean[:, None] * so[None, :]) * inv[:, None] + bo[None, :]

    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _proj_gate_mask_interleaved_lr_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,

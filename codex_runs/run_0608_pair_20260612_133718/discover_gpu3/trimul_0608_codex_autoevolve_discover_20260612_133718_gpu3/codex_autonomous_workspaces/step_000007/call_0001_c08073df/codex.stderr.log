import torch
from reference import generate_input, check_implementation
import submission as s

def clone_data(data):
 x,m,w,c=data; return (x.clone(),m.clone(),{k:v.clone() for k,v in w.items()},dict(c))
def bench(fn,spec,reps=3):
 data=generate_input(**spec); out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(clone_data(data),out); print('ok',ok,msg.split('\\n')[0] if msg else '')

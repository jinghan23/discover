            dim == 128 and ((bsz == 2 and n == 256) or (bsz == 1 and 512 <= n < 1024))
        ):
            return _fp16_interleaved_fused_kernel(data)
        return _fp16_fused_kernel(data)
    return _bf16_bmm_kernel(data)


    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _proj_gate_mask_interleaved_lr_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H

    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        lcols = 2 * h_base + pair_cols
        rcols = 2 * H + 2 * h_base + pair_cols
        w_l = tl.load(
            w_ptr + ks[:, None] * (5 * H) + lcols[None, :],
            mask=kmask[:, None] & (lcols[None, :] < 2 * H),
            other=0.0,
        )
        w_r = tl.load(
            w_ptr + ks[:, None] * (5 * H) + rcols[None, :],
            mask=kmask[:, None] & (rcols[None, :] < 4 * H),
            other=0.0,
        )
        acc_l += tl.dot(a, w_l)
        acc_r += tl.dot(a, w_r)

    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)


@triton.jit
def _out_gate_interleaved_fp16_kernel(
    x_ptr,
    w_ptr,
    ogate_ptr,
    M,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_mask = rows < M
    hmask = hs < H
    acc = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )
        w = tl.load(
            w_ptr + ks[:, None] * (5 * H) + (4 * H + hs)[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc += tl.dot(a, w)

    tl.store(
        ogate_ptr + rows[:, None] * H + hs[None, :],
        tl.sigmoid(acc),
        mask=row_mask[:, None] & hmask[None, :],
    )


@triton.jit
def _pack_interleaved_weights_fp16_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    out_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_c = tl.program_id(0)
    pid_col = tl.program_id(1)
    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    vals = lp + lg + rp + rg + og
    tl.store(
        out_ptr + cs[:, None] * (5 * H) + cols[None, :],
        vals,
        mask=cmask[:, None] & colmask[None, :],
    )


@triton.jit
def _pack_interleaved_norm_weights_fp16_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    nw_ptr,
    out_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_c = tl.program_id(0)
    pid_col = tl.program_id(1)
    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)
    nw = tl.load(nw_ptr + cs, mask=cmask, other=0.0).to(tl.float32)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    vals = (lp + lg + rp + rg + og).to(tl.float32) * nw[:, None]
    tl.store(
        out_ptr + cs[:, None] * (5 * H) + cols[None, :],
        vals,
        mask=cmask[:, None] & colmask[None, :],
    )


@triton.jit
def _interleaved_norm_constants_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    nw_ptr,
    nb_ptr,
    sum_ptr,
    bias_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_col = tl.program_id(0)
    cs = tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    w = (lp + lg + rp + rg + og).to(tl.float32)
    nw = tl.load(nw_ptr + cs, mask=cmask, other=0.0).to(tl.float32)
    nb = tl.load(nb_ptr + cs, mask=cmask, other=0.0).to(tl.float32)
    s = tl.sum(w * nw[:, None], axis=0)
    b = tl.sum(w * nb[:, None], axis=0)
    tl.store(sum_ptr + cols, s, mask=colmask)
    tl.store(bias_ptr + cols, b, mask=colmask)


@triton.jit
def _proj_gate_mask_quad_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    quad_cols = tl.arange(0, BLOCK_H * 4)
    row_mask = rows < M
    hmask = hs < H

    acc_q = tl.zeros((BLOCK_M, BLOCK_H * 4), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        qcols = 4 * h_base + quad_cols
        ogcols = 4 * H + hs
        w_q = tl.load(
            w_ptr + ks[:, None] * (5 * H) + qcols[None, :],
            mask=kmask[:, None] & (qcols[None, :] < 4 * H),
            other=0.0,
        )
        w_og = tl.load(
            w_ptr + ks[:, None] * (5 * H) + ogcols[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc_q += tl.dot(a, w_q)
        acc_og += tl.dot(a, w_og)

    q0, q1 = tl.split(tl.reshape(acc_q, (BLOCK_M, BLOCK_H, 2, 2)))
    lp, rp = tl.split(q0)
    lg, rg = tl.split(q1)
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)



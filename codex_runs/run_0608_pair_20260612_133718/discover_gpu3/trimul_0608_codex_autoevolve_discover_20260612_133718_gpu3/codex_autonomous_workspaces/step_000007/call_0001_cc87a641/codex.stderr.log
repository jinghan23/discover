import torch, torch.nn.functional as F, triton
from reference import generate_input, check_implementation
import submission as s

def clone(x):
    if isinstance(x, tuple): return tuple(clone(v) for v in x)
    if isinstance(x, dict): return {k: clone(v) for k,v in x.items()}
    if isinstance(x, torch.Tensor): return x.clone()
    return x

def torchln_interleaved(data):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    x_norm = F.layer_norm(input_tensor, (dim,), weights['norm.weight'], weights['norm.bias']).reshape(total, dim).to(torch.float16)
    packed_w = s._pack_interleaved_proj_workspace(weights, dim, hdim, input_tensor.device)
    left = s._workspace('test_torchln_left', (bsz, hdim, n, n), torch.float16, input_tensor.device)
    right = s._workspace('test_torchln_right', (bsz, hdim, n, n), torch.float16, input_tensor.device)
    ogate = s._workspace('test_torchln_ogate', (total, hdim), torch.float16, input_tensor.device)
    s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128), triton.cdiv(hdim,32))](
        x_norm, mask.reshape(total), packed_w, left, right, ogate, total, n, dim, hdim,
        BLOCK_M=128, BLOCK_H=32, BLOCK_K=64, HAS_MASK=mask.dtype "'!= torch.float32, num_warps=4)
    hidden = s._workspace('"'test_torchln_hidden', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=s._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out=s._workspace('test_torchln_out', (bsz,n,n,dim), torch.float32, input_tensor.device)
    s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden, ogate, weights['to_out_norm.weight'], weights['to_out_norm.bias'], out_w, out, bsz, n, hdim, dim, 1.0e-5, BLOCK_M=64, BLOCK_H=128, BLOCK_D=64 if dim==384 else 32, num_warps=4)
    return out


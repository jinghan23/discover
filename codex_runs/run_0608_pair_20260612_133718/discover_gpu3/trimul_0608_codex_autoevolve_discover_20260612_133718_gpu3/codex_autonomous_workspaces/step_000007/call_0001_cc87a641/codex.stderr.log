    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H

    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        lcols = 2 * h_base + pair_cols
        rcols = 2 * H + 2 * h_base + pair_cols
        w_l = tl.load(
            w_ptr + ks[:, None] * (5 * H) + lcols[None, :],
            mask=kmask[:, None] & (lcols[None, :] < 2 * H),
            other=0.0,
        )
        w_r = tl.load(
            w_ptr + ks[:, None] * (5 * H) + rcols[None, :],
            mask=kmask[:, None] & (rcols[None, :] < 4 * H),
            other=0.0,
        )
        acc_l += tl.dot(a, w_l)
        acc_r += tl.dot(a, w_r)

    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)


@triton.jit
def _out_gate_interleaved_fp16_kernel(
    x_ptr,
    w_ptr,
    ogate_ptr,
    M,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_mask = rows < M
    hmask = hs < H
    acc = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )
        w = tl.load(
            w_ptr + ks[:, None] * (5 * H) + (4 * H + hs)[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc += tl.dot(a, w)

    tl.store(
        ogate_ptr + rows[:, None] * H + hs[None, :],
        tl.sigmoid(acc),
        mask=row_mask[:, None] & hmask[None, :],
    )


@triton.jit
def _pack_interleaved_weights_fp16_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    out_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_c = tl.program_id(0)
    pid_col = tl.program_id(1)
    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    vals = lp + lg + rp + rg + og
    tl.store(
        out_ptr + cs[:, None] * (5 * H) + cols[None, :],
        vals,
        mask=cmask[:, None] & colmask[None, :],
    )


@triton.jit
def _pack_interleaved_norm_weights_fp16_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    nw_ptr,
    out_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_c = tl.program_id(0)
    pid_col = tl.program_id(1)
    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)
    nw = tl.load(nw_ptr + cs, mask=cmask, other=0.0).to(tl.float32)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    vals = (lp + lg + rp + rg + og).to(tl.float32) * nw[:, None]
    tl.store(
        out_ptr + cs[:, None] * (5 * H) + cols[None, :],
        vals,
        mask=cmask[:, None] & colmask[None, :],
    )


@triton.jit
def _interleaved_norm_constants_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    nw_ptr,
    nb_ptr,
    sum_ptr,
    bias_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_col = tl.program_id(0)
    cs = tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)

    q_l = cols
    h_l = q_l // 2
    is_lg = q_l - h_l * 2
    l_valid = cols < (2 * H)
    lp = tl.load(lp_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h_l[None, :] * C + cs[:, None], mask=cmask[:, None] & l_valid[None, :] & (is_lg[None, :] == 1), other=0.0)

    q_r = cols - 2 * H
    h_r = q_r // 2
    is_rg = q_r - h_r * 2
    r_valid = (cols >= 2 * H) & (cols < 4 * H)
    rp = tl.load(rp_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 0), other=0.0)
    rg = tl.load(rg_ptr + h_r[None, :] * C + cs[:, None], mask=cmask[:, None] & r_valid[None, :] & (is_rg[None, :] == 1), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    w = (lp + lg + rp + rg + og).to(tl.float32)
    nw = tl.load(nw_ptr + cs, mask=cmask, other=0.0).to(tl.float32)
    nb = tl.load(nb_ptr + cs, mask=cmask, other=0.0).to(tl.float32)
    s = tl.sum(w * nw[:, None], axis=0)
    b = tl.sum(w * nb[:, None], axis=0)
    tl.store(sum_ptr + cols, s, mask=colmask)
    tl.store(bias_ptr + cols, b, mask=colmask)


@triton.jit
def _proj_gate_mask_quad_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    quad_cols = tl.arange(0, BLOCK_H * 4)
    row_mask = rows < M
    hmask = hs < H

    acc_q = tl.zeros((BLOCK_M, BLOCK_H * 4), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        qcols = 4 * h_base + quad_cols
        ogcols = 4 * H + hs
        w_q = tl.load(
            w_ptr + ks[:, None] * (5 * H) + qcols[None, :],
            mask=kmask[:, None] & (qcols[None, :] < 4 * H),
            other=0.0,
        )
        w_og = tl.load(
            w_ptr + ks[:, None] * (5 * H) + ogcols[None, :],
            mask=kmask[:, None] & hmask[None, :],
            other=0.0,
        )
        acc_q += tl.dot(a, w_q)
        acc_og += tl.dot(a, w_og)

    q0, q1 = tl.split(tl.reshape(acc_q, (BLOCK_M, BLOCK_H, 2, 2)))
    lp, rp = tl.split(q0)
    lg, rg = tl.split(q1)
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _pack_quad_weights_fp16_kernel(
    lp_ptr,
    lg_ptr,
    rp_ptr,
    rg_ptr,
    og_ptr,
    out_ptr,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_C: tl.constexpr,
    BLOCK_COL: tl.constexpr,
):
    pid_c = tl.program_id(0)
    pid_col = tl.program_id(1)
    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
    cols = pid_col * BLOCK_COL + tl.arange(0, BLOCK_COL)
    cmask = cs < C
    colmask = cols < (5 * H)

    q = cols
    h = q // 4
    kind = q - h * 4
    q_valid = cols < (4 * H)
    lp = tl.load(lp_ptr + h[None, :] * C + cs[:, None], mask=cmask[:, None] & q_valid[None, :] & (kind[None, :] == 0), other=0.0)
    lg = tl.load(lg_ptr + h[None, :] * C + cs[:, None], mask=cmask[:, None] & q_valid[None, :] & (kind[None, :] == 1), other=0.0)
    rp = tl.load(rp_ptr + h[None, :] * C + cs[:, None], mask=cmask[:, None] & q_valid[None, :] & (kind[None, :] == 2), other=0.0)
    rg = tl.load(rg_ptr + h[None, :] * C + cs[:, None], mask=cmask[:, None] & q_valid[None, :] & (kind[None, :] == 3), other=0.0)

    h_og = cols - 4 * H
    og_valid = cols >= 4 * H
    og = tl.load(og_ptr + h_og[None, :] * C + cs[:, None], mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H), other=0.0)

    vals = lp + lg + rp + rg + og
    tl.store(
        out_ptr + cs[:, None] * (5 * H) + cols[None, :],
        vals,
        mask=cmask[:, None] & colmask[None, :],
    )


@triton.jit
def _proj_gate_mask_raw_fp16_kernel(
    x_ptr,
    mask_ptr,
    w_lp_ptr,
    w_lg_ptr,
    w_rp_ptr,
    w_rg_ptr,
    w_og_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    row_mask = rows < M
    hmask = hs < H

    acc_lp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_lg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        )

        raw_off = hs[None, :] * C + ks[:, None]
        raw_mask = kmask[:, None] & hmask[None, :]
        w_lp = tl.load(w_lp_ptr + raw_off, mask=raw_mask, other=0.0).to(tl.float16)
        w_lg = tl.load(w_lg_ptr + raw_off, mask=raw_mask, other=0.0).to(tl.float16)
        w_rp = tl.load(w_rp_ptr + raw_off, mask=raw_mask, other=0.0).to(tl.float16)
        w_rg = tl.load(w_rg_ptr + raw_off, mask=raw_mask, other=0.0).to(tl.float16)
        w_og = tl.load(w_og_ptr + raw_off, mask=raw_mask, other=0.0).to(tl.float16)

        acc_lp += tl.dot(a, w_lp)
        acc_lg += tl.dot(a, w_lg)
        acc_rp += tl.dot(a, w_rp)
        acc_rg += tl.dot(a, w_rg)
        acc_og += tl.dot(a, w_og)

    lg = tl.sigmoid(acc_lg)
    rg = tl.sigmoid(acc_rg)
    og = tl.sigmoid(acc_og)
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
        left_out = acc_lp * lg * mval[:, None]
        right_out = acc_rp * rg * mval[:, None]
    else:
        left_out = acc_lp * lg
        right_out = acc_rp * rg

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _ln_proj_gate_mask_fp16_kernel(
    x_ptr,
    mask_ptr,
    norm_w_ptr,
    norm_b_ptr,
    w_lp_ptr,
    w_lg_ptr,
    w_rp_ptr,
    w_rg_ptr,
    w_og_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    M,
    N,
    C: tl.constexpr,
    H: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_K: tl.constexpr,
    HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    row_mask = rows < M

    sum_val = tl.zeros((BLOCK_M,), dtype=tl.float32)
    sumsq_val = tl.zeros((BLOCK_M,), dtype=tl.float32)
    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        x = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        ).to(tl.float32)
        sum_val += tl.sum(x, axis=1)
        sumsq_val += tl.sum(x * x, axis=1)

    mean = sum_val / C
    var = sumsq_val / C - mean * mean
    inv = tl.rsqrt(var + eps)

    hs = tl.arange(0, BLOCK_H)
    hmask = hs < H
    acc_lp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_lg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rp = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_rg = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)

    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        x = tl.load(
            x_ptr + rows[:, None] * C + ks[None, :],
            mask=row_mask[:, None] & kmask[None, :],
            other=0.0,
        ).to(tl.float32)
        nw = tl.load(norm_w_ptr + ks, mask=kmask, other=0.0).to(tl.float32)
        nb = tl.load(norm_b_ptr + ks, mask=kmask, other=0.0).to(tl.float32)
        a = ((x - mean[:, None]) * inv[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)

        w_lp = tl.load(w_lp_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_lg = tl.load(w_lg_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_rp = tl.load(w_rp_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_rg = tl.load(w_rg_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        w_og = tl.load(w_og_ptr + ks[:, None] * H + hs[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)

        acc_lp += tl.dot(a, w_lp)
        acc_lg += tl.dot(a, w_lg)
        acc_rp += tl.dot(a, w_rp)
        acc_rg += tl.dot(a, w_rg)
        acc_og += tl.dot(a, w_og)

    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)

    lg = tl.sigmoid(acc_lg)
    rg = tl.sigmoid(acc_rg)
    og = tl.sigmoid(acc_og)
    left_out = acc_lp * lg * mval[:, None]
    right_out = acc_rp * rg * mval[:, None]

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]

    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)


@triton.jit
def _ln_gate_out_linear_fp16_kernel(
    hidden_ptr,
    ogate_ptr,
    ln_w_ptr,
    ln_b_ptr,
    w_out_ptr,
    out_ptr,
    B,
    N,
    H: tl.constexpr,
    D: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    row_mask = rows < (B * N * N)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    hs = tl.arange(0, BLOCK_H)
    hmask = hs < H

    hidden_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    vals = tl.load(hidden_ptr + hidden_off, mask=row_mask[:, None] & hmask[None, :], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) / H
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / H
    inv = tl.rsqrt(var + eps)

    nw = tl.load(ln_w_ptr + hs, mask=hmask, other=0.0)
    nb = tl.load(ln_b_ptr + hs, mask=hmask, other=0.0)
    og = tl.load(ogate_ptr + rows[:, None] * H + hs[None, :], mask=row_mask[:, None] & hmask[None, :], other=0.0).to(tl.float32)
    gated = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]) * og
    gated = gated.to(tl.float16)

    for d0 in range(0, D, BLOCK_D):
        ds = d0 + tl.arange(0, BLOCK_D)
        dmask = ds < D
        w = tl.load(
            w_out_ptr + hs[:, None] * D + ds[None, :],
            mask=hmask[:, None] & dmask[None, :],
            other=0.0,
        )
        res = tl.dot(gated, w)
        tl.store(out_ptr + rows[:, None] * D + ds[None, :], res, mask=row_mask[:, None] & dmask[None, :])


@triton.jit
def _ln_gate_out_linear_raw_fp16_kernel(
    hidden_ptr,
    ogate_ptr,
    ln_w_ptr,
    ln_b_ptr,
    w_out_ptr,
    out_ptr,
    B,
    N,
    H: tl.constexpr,
    D: tl.constexpr,
    eps: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
    BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    row_mask = rows < (B * N * N)

    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    hs = tl.arange(0, BLOCK_H)
    hmask = hs < H

    hidden_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    vals = tl.load(hidden_ptr + hidden_off, mask=row_mask[:, None] & hmask[None, :], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) / H
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / H
    inv = tl.rsqrt(var + eps)

    nw = tl.load(ln_w_ptr + hs, mask=hmask, other=0.0)
    nb = tl.load(ln_b_ptr + hs, mask=hmask, other=0.0)
    og = tl.load(ogate_ptr + rows[:, None] * H + hs[None, :], mask=row_mask[:, None] & hmask[None, :], other=0.0).to(tl.float32)
    gated = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]) * og
    gated = gated.to(tl.float16)

    for d0 in range(0, D, BLOCK_D):
        ds = d0 + tl.arange(0, BLOCK_D)
        dmask = ds < D
        w = tl.load(
            w_out_ptr + ds[None, :] * H + hs[:, None],
            mask=hmask[:, None] & dmask[None, :],
            other=0.0,
        ).to(tl.float16)
        res = tl.dot(gated, w)
        tl.store(out_ptr + rows[:, None] * D + ds[None, :], res, mask=row_mask[:, None] & dmask[None, :])


@torch.no_grad()
def _fp16_fused_kernel(data):
    input_tensor, mask, weights, config = data
    bsz = input_tensor.shape[0]
    n = input_tensor.shape[1]
    dim = config["dim"]
    hdim = config["hidden_dim"]
    total_rows = bsz * n * n

    x_norm = _workspace("fp16_x_norm", (total_rows, dim), torch.float16, input_tensor.device)
    ln_block_m = 32 if dim == 384 else 128
    ln_block_c = 512 if dim == 384 else 128
    ln_warps = 4 if dim == 384 else 8
    _row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](
        input_tensor.reshape(total_rows, dim),
        x_norm,
        weights["norm.weight"],
        weights["norm.bias"],
        total_rows,
        dim,
        1.0e-5,
        BLOCK_M=ln_block_m,
        BLOCK_C=ln_block_c,
        num_warps=ln_warps,
    )

    left_w = _cached_transpose_to(weights["left_proj.weight"], torch.float16, "lp16")
    left_gate_w = _cached_transpose_to(weights["left_gate.weight"], torch.float16, "lg16")
    right_w = _cached_transpose_to(weights["right_proj.weight"], torch.float16, "rp16")
    right_gate_w = _cached_transpose_to(weights["right_gate.weight"], torch.float16, "rg16")
    out_gate_w = _cached_transpose_to(weights["out_gate.weight"], torch.float16, "og16")

    has_mask = mask.dtype != torch.float32
    mask_flat = mask.reshape(total_rows)

    left = _workspace("fp16_left", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    right = _workspace("fp16_right", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    ogate = _workspace("fp16_ogate", (total_rows, hdim), torch.float16, input_tensor.device)

    grid_proj = (triton.cdiv(total_rows, 128), triton.cdiv(hdim, 32))
    proj_block_k = 32 if ((dim == 128 and n <= 256) or (dim == 384 and n >= 1024)) else 64
    _proj_gate_mask_fp16_kernel[grid_proj](
        x_norm,
        mask_flat,
        left_w,
        left_gate_w,
        right_w,
        right_gate_w,
        out_gate_w,
        left,
        right,
        ogate,
        total_rows,
        n,
        dim,
        hdim,
        BLOCK_M=128,
        BLOCK_H=32,
        BLOCK_K=proj_block_k,
        HAS_MASK=has_mask,
        num_warps=4,
    )

    hidden = _workspace("fp16_hidden", (bsz * hdim, n, n), torch.float16, input_tensor.device)
    torch.bmm(
        left.reshape(bsz * hdim, n, n),
        right.reshape(bsz * hdim, n, n).transpose(1, 2),
        out=hidden,
    )

    out_w = _cached_transpose_to(weights["to_out.weight"], torch.float16, "out16")
    out = _workspace("fp16_out", (bsz, n, n, dim), torch.float16, input_tensor.device)
    out_block_d = 32 if dim == 128 else 64
    _ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows, 64),)](
        hidden,
        ogate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        out_w,
        out,
        bsz,
        n,
        hdim,
        dim,
        1.0e-5,
        BLOCK_M=64,
        BLOCK_H=128,
        BLOCK_D=out_block_d,
        num_warps=4,
    )
    return out


@torch.no_grad()
def _fp16_interleaved_fused_kernel(data):
    input_tensor, mask, weights, config = data
    bsz = input_tensor.shape[0]
    n = input_tensor.shape[1]
    dim = config["dim"]
    hdim = config["hidden_dim"]
    total_rows = bsz * n * n

    x_norm = _workspace("fp16_x_norm", (total_rows, dim), torch.float16, input_tensor.device)
    ln_block_m = 32 if dim == 384 else 128
    ln_block_c = 512 if dim == 384 else 128
    ln_warps = 4 if dim == 384 else 8
    _row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](
        input_tensor.reshape(total_rows, dim),
        x_norm,
        weights["norm.weight"],
        weights["norm.bias"],
        total_rows,
        dim,
        1.0e-5,
        BLOCK_M=ln_block_m,
        BLOCK_C=ln_block_c,
        num_warps=ln_warps,
    )

    packed_w = _pack_interleaved_proj_workspace(weights, dim, hdim, input_tensor.device)
    left = _workspace("fp16_left", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    right = _workspace("fp16_right", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    ogate = _workspace("fp16_ogate", (total_rows, hdim), torch.float16, input_tensor.device)

    block_k = 64
    _proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total_rows, 128), triton.cdiv(hdim, 32))](
        x_norm,
        mask.reshape(total_rows),
        packed_w,
        left,
        right,
        ogate,
        total_rows,
        n,
        dim,
        hdim,
        BLOCK_M=128,
        BLOCK_H=32,
        BLOCK_K=block_k,
        HAS_MASK=mask.dtype != torch.float32,
        num_warps=4,
    )

    hidden = _workspace("fp16_hidden", (bsz * hdim, n, n), torch.float16, input_tensor.device)
    torch.bmm(
        left.reshape(bsz * hdim, n, n),
        right.reshape(bsz * hdim, n, n).transpose(1, 2),
        out=hidden,
    )

    out_w = _cached_transpose_to(weights["to_out.weight"], torch.float16, "out16")
    out = _workspace("fp16_out", (bsz, n, n, dim), torch.float16, input_tensor.device)
    out_block_d = 32 if dim == 128 else 64
    _ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows, 64),)](
        hidden,
        ogate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        out_w,
        out,
        bsz,
        n,
        hdim,
        dim,
        1.0e-5,
        BLOCK_M=64,
        BLOCK_H=128,
        BLOCK_D=out_block_d,
        num_warps=4,
    )
    return out


@torch.no_grad()
def _fp16_interleaved_split_kernel(data):
    input_tensor, mask, weights, config = data
    bsz = input_tensor.shape[0]
    n = input_tensor.shape[1]
    dim = config["dim"]
    hdim = config["hidden_dim"]
    total_rows = bsz * n * n

    x_norm = _workspace("fp16_x_norm", (total_rows, dim), torch.float16, input_tensor.device)
    ln_block_m = 32 if dim == 384 else 128
    ln_block_c = 512 if dim == 384 else 128
    ln_warps = 4 if dim == 384 else 8
    _row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](
        input_tensor.reshape(total_rows, dim),
        x_norm,
        weights["norm.weight"],
        weights["norm.bias"],
        total_rows,
        dim,
        1.0e-5,
        BLOCK_M=ln_block_m,
        BLOCK_C=ln_block_c,
        num_warps=ln_warps,
    )

    packed_w = _pack_interleaved_proj_workspace(weights, dim, hdim, input_tensor.device)
    left = _workspace("fp16_left", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    right = _workspace("fp16_right", (bsz, hdim, n, n), torch.float16, input_tensor.device)
    ogate = _workspace("fp16_ogate", (total_rows, hdim), torch.float16, input_tensor.device)

    side = _side_stream(input_tensor.device)
    current = torch.cuda.current_stream(input_tensor.device)
    side.wait_stream(current)
    with torch.cuda.stream(side):
        _out_gate_interleaved_fp16_kernel[(triton.cdiv(total_rows, 128), triton.cdiv(hdim, 32))](
            x_norm,
            packed_w,
            ogate,
            total_rows,
            dim,
            hdim,
            BLOCK_M=128,
            BLOCK_H=32,
            BLOCK_K=64,
            num_warps=4,
        )

    _proj_gate_mask_interleaved_lr_fp16_kernel[(triton.cdiv(total_rows, 128), triton.cdiv(hdim, 32))](
        x_norm,
        mask.reshape(total_rows),
        packed_w,
        left,
        right,
        total_rows,
        n,
        dim,
        hdim,
        BLOCK_M=128,
        BLOCK_H=32,
        BLOCK_K=64,
        HAS_MASK=mask.dtype != torch.float32,
        num_warps=4,
    )

    hidden = _workspace("fp16_hidden", (bsz * hdim, n, n), torch.float16, input_tensor.device)
    torch.bmm(
        left.reshape(bsz * hdim, n, n),
        right.reshape(bsz * hdim, n, n).transpose(1, 2),
        out=hidden,
    )
    current.wait_stream(side)

    out_w = _cached_transpose_to(weights["to_out.weight"], torch.float16, "out16")
    out = _workspace("fp16_out", (bsz, n, n, dim), torch.float32, input_tensor.device)
    out_block_d = 32 if dim == 128 else 64
    _ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows, 64),)](
        hidden,
        ogate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        out_w,
        out,
        bsz,
        n,
        hdim,
        dim,
        1.0e-5,
        BLOCK_M=64,
        BLOCK_H=128,
        BLOCK_D=out_block_d,
        num_warps=4,
    )
    return out



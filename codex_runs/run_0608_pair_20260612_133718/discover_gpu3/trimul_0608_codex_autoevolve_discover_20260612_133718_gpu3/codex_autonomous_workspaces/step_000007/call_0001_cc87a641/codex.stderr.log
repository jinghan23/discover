for label,c in [('n1024',{\"seqlen\":1024,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"}),('n768',{\"seqlen\":768,\"bs\":1,\"dim\":128,\"hiddendim\":128,\"seed\":381,\"nomask\":True,\"distribution\":\"cauchy\"}),('n256b2',{\"seqlen\":256,\"bs\":2,\"dim\":128,\"hiddendim\":128,\"seed\":9371,\"nomask\":True,\"distribution\":\"normal\"})]:
 data=generate_input(**c); x,mask,w,config=data; b=x.shape[0]; n=x.shape[1]; dim=config['dim']; h=128; total=b*n*n

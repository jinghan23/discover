/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
# Quick high-level check: approximate sigmoid gates in PyTorch reference-style path for small case.
import torch, torch.nn.functional as F
from reference import generate_input, check_implementation

def approx_sigmoid(x):
    return 0.5 * (x / (1.0 + torch.abs(x)) + 1.0)

def hard_sigmoid(x):
    return torch.clamp(x * 0.25 + 0.5, 0, 1)

def run(data, sig):
    x,mask,w,c=data; b,n,_,dim=x.shape; h=c['hidden_dim']
    xn=F.layer_norm(x,(dim,),w['norm.weight'],w['norm.bias'])
    lp=F.linear(xn,w['left_proj.weight']); rp=F.linear(xn,w['right_proj.weight'])
    lg=sig(F.linear(xn,w['left_gate.weight'])); rg=sig(F.linear(xn,w['right_gate.weight'])); og=sig(F.linear(xn,w['out_gate.weight']))
    left=lp*lg*mask.unsqueeze(-1); right=rp*rg*mask.unsqueeze(-1)
    out=torch.einsum('bikd,bjkd->bijd',left,right)
    out=F.layer_norm(out,(h,),w['to_out_norm.weight'],w['to_out_norm.bias']) * og
    return F.linear(out,w['to_out.weight'])
for c in [

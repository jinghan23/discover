import torch, triton
from reference import generate_input, check_implementation
import submission as s

def clone(x):
    if isinstance(x, tuple): return tuple(clone(v) for v in x)
    if isinstance(x, dict): return {k: clone(v) for k,v in x.items()}
    if isinstance(x, torch.Tensor): return x.clone()
    return x

def make_lnproj(BLOCK_M, BLOCK_K, num_warps=8):
 def fn(data):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    left=s._workspace(f'test_lnproj_left_{BLOCK_M}_{BLOCK_K}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    right=s._workspace(f'test_lnproj_right_{BLOCK_M}_{BLOCK_K}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    ogate=s._workspace(f'test_lnproj_ogate_{BLOCK_M}_{BLOCK_K}', (total,hdim), torch.float16, input_tensor.device)
    lw=s._cached_transpose_to(weights['left_proj.weight'], torch.float16, 'lp16')
    lgw=s._cached_transpose_to(weights['left_gate.weight'], torch.float16, 'lg16')
    rw=s._cached_transpose_to(weights['right_proj.weight'], torch.float16, 'rp16')
    rgw=s._cached_transpose_to(weights['right_gate.weight'], torch.float16, 'rg16')
    ogw=s._cached_transpose_to(weights['out_gate.weight'], torch.float16, 'og16')
    s._ln_proj_gate_mask_fp16_kernel[(triton.cdiv(total,BLOCK_M),)](
        input_tensor.reshape(total,dim), mask.reshape(total), weights['norm.weight'], weights['norm.bias'],
        lw, lgw, rw, rgw, ogw, left, right, ogate, total, n, dim, hdim, 1.0e-5,
        BLOCK_M=BLOCK_M, BLOCK_H=128, BLOCK_K=BLOCK_K, HAS_MASK=mask.dtype "'!= torch.float32, num_warps=num_warps)
    hidden=s._workspace(f'"'test_lnproj_hidden_{BLOCK_M}_{BLOCK_K}', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=s._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out=s._workspace(f'test_lnproj_out_{BLOCK_M}_{BLOCK_K}', (bsz,n,n,dim), torch.float32, input_tensor.device)
    s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden, ogate, weights['to_out_norm.weight'], weights['to_out_norm.bias'], out_w, out, bsz, n, hdim, dim, 1.0e-5, BLOCK_M=64, BLOCK_H=128, BLOCK_D=64 if dim==384 else 32, num_warps=4)
    return out

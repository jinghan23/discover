]

def clone_data(data):
    if isinstance(data, tuple): return tuple(clone_data(x) for x in data)
    if isinstance(data, dict): return {k: clone_data(v) for k,v in data.items()}
    if isinstance(data, torch.Tensor): return data.clone()
    return data

def bench(fn, c, reps=6):
    # compile/check
    data=generate_input(**c); chk=clone_data(data); out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(chk,out); del data,chk,out
    if not ok: return False,msg,None
    durs=[]
    for r in range(reps):
        cc=dict(c); cc['seed']=c['seed']+17*r
        data=generate_input(**cc); torch.cuda.synchronize()
        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)
        st.record(); out=fn(data); en.record(); torch.cuda.synchronize()
        durs.append(st.elapsed_time(en)*1000.0)
        del data,out
    return True,'',sum(durs[2:])/max(1,len(durs[2:])),durs

for i,c in enumerate(cases):
    ok,msg,mean,durs=bench(_fp16_lnfused_input_kernel,c)
    print('lnfused',i,ok,msg if not ok else '', 'mean',mean,'durs',[round(x,1) for x in durs] if durs else None)

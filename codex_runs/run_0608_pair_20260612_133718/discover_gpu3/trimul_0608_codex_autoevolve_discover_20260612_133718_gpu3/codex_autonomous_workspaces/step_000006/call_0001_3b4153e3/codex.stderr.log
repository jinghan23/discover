    out=s._workspace('half_out',(bsz,n,n,dim),torch.float16,input_tensor.device)
    s._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=(32 if dim==128 else 64),num_warps=4)

    ogate = _workspace("fp16_ogate", (total_rows, hdim), torch.float16, input_tensor.device)

    grid_proj = (triton.cdiv(total_rows, 128), triton.cdiv(hdim, 32))
    proj_block_k = 32 if ((dim == 128 and n <= 256) or (dim == 384 and n >= 1024)) else 64

    ds=[]
    for r in range(6):
        cc=dict(c); cc['seed']=c['seed']+41*r
        data=generate_input(**cc); torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)
        st.record(); out=custom_kernel(data); en.record(); torch.cuda.synchronize(); ds.append(st.elapsed_time(en)*1000); del data,out
    mean=sum(ds[2:])/4; geo.append(mean); print('time',i,round(mean,1),[round(x,1) for x in ds])
print('geom', math.exp(sum(math.log(x) for x in geo)/len(geo)))

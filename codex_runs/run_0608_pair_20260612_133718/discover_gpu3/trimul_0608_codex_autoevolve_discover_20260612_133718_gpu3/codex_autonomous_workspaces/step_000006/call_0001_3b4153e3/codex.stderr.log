+        packed_w,
+        left,
+        right,
+        ogate,
+        total_rows,
+        n,
+        dim,
+        hdim,
+        BLOCK_M=128,
+        BLOCK_H=32,
+        BLOCK_K=64,
+        HAS_MASK=mask.dtype != torch.float32,
+        num_warps=4,
+    )
+
+    hidden = _workspace("fp16_hidden", (bsz * hdim, n, n), torch.float16, input_tensor.device)
+    torch.bmm(
+        left.reshape(bsz * hdim, n, n),
+        right.reshape(bsz * hdim, n, n).transpose(1, 2),
+        out=hidden,
+    )
+
+    tmp = _workspace("fp16_out_norm_tmp", (total_rows, hdim), torch.float32, input_tensor.device)
+    _out_norm_gate_kernel[(triton.cdiv(total_rows, 32),)](
+        hidden,
+        ogate,
+        weights["to_out_norm.weight"],
+        weights["to_out_norm.bias"],
+        tmp,
+        total_rows,
+        nn,
+        hdim,
+        BLOCK_M=32,
+        BLOCK_H=128,
+        num_warps=4,
+    )
+    return F.linear(tmp, weights["to_out.weight"]).view(bsz, n, n, dim)
+

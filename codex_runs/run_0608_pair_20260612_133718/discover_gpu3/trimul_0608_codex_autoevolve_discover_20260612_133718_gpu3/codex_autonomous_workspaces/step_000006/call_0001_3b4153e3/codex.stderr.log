import time, math, torch
from reference import generate_input, check_implementation
from submission import custom_kernel
cases = [
    dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
    dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
    dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
    dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
    dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
    dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
    dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]

def clone_data(data):
    if isinstance(data, tuple): return tuple(clone_data(x) for x in data)
    if isinstance(data, dict): return {k: clone_data(v) for k,v in data.items()}
    if isinstance(data, torch.Tensor): return data.clone()
    return data

# compile and check each once
for idx,c in enumerate(cases):
    data = generate_input(**c)
    chk = clone_data(data)
    torch.cuda.synchronize()
    out = custom_kernel(data)
    torch.cuda.synchronize()
    ok,msg = check_implementation(chk,out)
    print('check',idx,ok,msg[:120] if isinstance(msg,str) else msg)
    del out, data, chk

torch.cuda.synchronize()
print('timings recheck-like')
geo=[]
for idx,c in enumerate(cases):
    durs=[]
    for r in range(8):
        cc=dict(c); cc['seed']=c['seed']+13*r
        data = generate_input(**cc)
        torch.cuda.synchronize()
        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)
        st.record(); out=custom_kernel(data); en.record(); torch.cuda.synchronize()
        d=st.elapsed_time(en)*1000.0
        durs.append(d)
        del out, data
    mean=sum(durs[2:])/len(durs[2:])
    geo.append(mean)
    print(idx, c, 'mean_us', mean, 'all', [round(x,1) for x in durs])
print('geom', math.exp(sum(math.log(x) for x in geo)/len(geo)))

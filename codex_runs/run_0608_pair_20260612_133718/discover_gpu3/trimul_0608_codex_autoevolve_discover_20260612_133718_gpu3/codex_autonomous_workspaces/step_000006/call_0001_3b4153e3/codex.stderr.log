import torch
from torch.profiler import profile, ProfilerActivity
from reference import generate_input
from submission import _fp16_fused_kernel,_fp16_interleaved_fused_kernel,_fp16_quad_fused_kernel
c=dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')
for name,fn in [('fused',_fp16_fused_kernel),('inter',_fp16_interleaved_fused_kernel),('quad',_fp16_quad_fused_kernel)]:
 data=generate_input(**c); out=fn(data); torch.cuda.synchronize(); del data,out
 data=generate_input(**c)
 with profile(activities=[ProfilerActivity.CPU,ProfilerActivity.CUDA]) as prof:
  out=fn(data); torch.cuda.synchronize()
 print('---',name,'---')
 print(prof.key_averages().table(sort_by='self_cuda_time_total', row_limit=15))

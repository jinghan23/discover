    if isinstance(data, dict): return {k: clone_data(v) for k,v in data.items()}
    if isinstance(data, torch.Tensor): return data.clone()
    return data

def inter_half(data):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    x=s._workspace('half_x_norm',(total,dim),torch.float16,input_tensor.device)
    lbm=32 if dim==384 else 128; lbc=512 if dim==384 else 128; lnw=4 if dim==384 else 8
    s._row_ln_fp16_kernel[(triton.cdiv(total,lbm),)](input_tensor.reshape(total,dim),x,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lbm,BLOCK_C=lbc,num_warps=lnw)
    packed=s._pack_interleaved_proj_workspace(weights,dim,hdim,input_tensor.device)
    left=s._workspace('half_left',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=s._workspace('half_right',(bsz,hdim,n,n),torch.float16,input_tensor.device); og=s._workspace('half_og',(total,hdim),torch.float16,input_tensor.device)
    s._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total,128),triton.cdiv(hdim,32))](x,mask.reshape(total),packed,left,right,og,total,n,dim,hdim,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
    hidden=s._workspace('"'half_hidden',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)

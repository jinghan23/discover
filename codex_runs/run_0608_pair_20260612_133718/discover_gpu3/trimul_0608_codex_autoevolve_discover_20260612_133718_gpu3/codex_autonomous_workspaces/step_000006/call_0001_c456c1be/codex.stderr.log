@torch.no_grad()
def path(data, proj_bm=128, proj_bh=32, proj_bk=64, out_bm=64, out_bd=64, inter=True):
    input_tensor, mask, weights, config=data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total_rows=bsz*n*n
    x_norm=submission._workspace(f'tp_x_{dim}_{n}', (total_rows,dim), torch.float16, input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total_rows, 32 if dim==384 else 128),)](
        input_tensor.reshape(total_rows,dim), x_norm, weights['norm.weight'], weights['norm.bias'], total_rows, dim, 1e-5,
        BLOCK_M=32 if dim==384 else 128, BLOCK_C=512 if dim==384 else 128, num_warps=4 if dim==384 else 8)
    left=submission._workspace(f'tp_l_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    right=submission._workspace(f'tp_r_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    ogate=submission._workspace(f'tp_o_{dim}_{n}', (total_rows,hdim), torch.float16, input_tensor.device)

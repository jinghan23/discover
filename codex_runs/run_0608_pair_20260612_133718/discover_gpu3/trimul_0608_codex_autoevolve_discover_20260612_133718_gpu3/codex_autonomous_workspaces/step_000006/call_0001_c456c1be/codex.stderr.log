            BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=mask.dtype "'!= torch.float32,num_warps=4)
    else:
        left=submission._workspace(f'"'ln_l_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
        right=submission._workspace(f'ln_r_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
        ogate=submission._workspace(f'ln_o_{dim}_{n}', (total_rows,hdim), torch.float16, input_tensor.device)
        lw=submission._cached_transpose_to(weights['left_proj.weight'], torch.float16, 'lp16')
        lgw=submission._cached_transpose_to(weights['left_gate.weight'], torch.float16, 'lg16')
        rw=submission._cached_transpose_to(weights['right_proj.weight'], torch.float16, 'rp16')
        rgw=submission._cached_transpose_to(weights['right_gate.weight'], torch.float16, 'rg16')
        ogw=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, 'og16')
        submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total_rows,128), triton.cdiv(hdim,32))](
            x_norm, mask.reshape(total_rows), lw,lgw,rw,rgw,ogw,left,right,ogate,total_rows,n,dim,hdim,
            BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=mask.dtype "'!= torch.float32,num_warps=4)
    hidden=submission._workspace(f'"'ln_h_{dim}_{n}', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=submission._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out=submission._workspace(f'ln_out_{dim}_{n}', (bsz,n,n,dim), torch.float32, input_tensor.device)

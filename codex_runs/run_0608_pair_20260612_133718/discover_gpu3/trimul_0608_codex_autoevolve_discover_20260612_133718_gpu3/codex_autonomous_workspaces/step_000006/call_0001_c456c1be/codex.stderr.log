            for _ in range(2): path(data,*cfg, inter=inter); torch.cuda.synchronize()
            times=[]
            for _ in range(4):
                s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); path(data,*cfg, inter=inter); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
            print(cfg,'mean',round(sum(times)/len(times),1),'times',[round(t,1) for t in times])
        except Exception as e:
            torch.cuda.synchronize(); print(cfg,'ERR',type(e).__name__,str(e)[:120])


    hidden = submission._workspace('"'test_lnproj_hidden', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w = submission._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out = submission._workspace('test_lnproj_out', (bsz,n,n,dim), torch.float32, input_tensor.device)

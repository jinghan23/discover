+def _active_gate_scatter_kernel(
+    proj_ptr,
+    idx_ptr,
+    left_ptr,
+    right_ptr,
+    active_rows: tl.constexpr,
+    nn: tl.constexpr,
+    hdim: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    valid = (rows[:, None] < active_rows) & (hs[None, :] < hdim)
+
+    src = rows[:, None] * (4 * hdim) + hs[None, :]
+    lp = tl.load(proj_ptr + src, mask=valid, other=0.0).to(tl.float32)
+    rp = tl.load(proj_ptr + src + hdim, mask=valid, other=0.0).to(tl.float32)
+    lg = tl.load(proj_ptr + src + 2 * hdim, mask=valid, other=0.0).to(tl.float32)
+    rg = tl.load(proj_ptr + src + 3 * hdim, mask=valid, other=0.0).to(tl.float32)
+
+    flat = tl.load(idx_ptr + rows, mask=rows < active_rows, other=0)
+    batch = flat // nn
+    inner = flat - batch * nn
+    ch_major = batch[:, None] * (hdim * nn) + hs[None, :] * nn + inner[:, None]
+
+    tl.store(left_ptr + ch_major, lp * tl.sigmoid(lg), mask=valid)
+    tl.store(right_ptr + ch_major, rp * tl.sigmoid(rg), mask=valid)

import torch, triton
from reference import generate_input, check_implementation
import submission

@torch.no_grad()
def inter_variant(data, out_bm=64, out_bd=64, proj_bm=128, proj_bh=32, proj_bk=64):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total_rows=bsz*n*n
    x_norm=submission._workspace(f'tune_x_{dim}_{n}', (total_rows,dim), torch.float16, input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total_rows, 32 if dim==384 else 128),)](
        input_tensor.reshape(total_rows,dim), x_norm, weights['norm.weight'], weights['norm.bias'], total_rows, dim, 1e-5,
        BLOCK_M=32 if dim==384 else 128, BLOCK_C=512 if dim==384 else 128, num_warps=4 if dim==384 else 8)
    packed=submission._pack_interleaved_proj_workspace(weights, dim, hdim, input_tensor.device)
    left=submission._workspace(f'tune_left_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    right=submission._workspace(f'tune_right_{dim}_{n}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    ogate=submission._workspace(f'tune_og_{dim}_{n}', (total_rows,hdim), torch.float16, input_tensor.device)
    submission._proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(total_rows,proj_bm), triton.cdiv(hdim,proj_bh))](
        x_norm, mask.reshape(total_rows), packed, left, right, ogate, total_rows, n, dim, hdim,
        BLOCK_M=proj_bm, BLOCK_H=proj_bh, BLOCK_K=proj_bk, HAS_MASK=mask.dtype "'!= torch.float32, num_warps=4)
    hidden=submission._workspace(f'"'tune_hidden_{dim}_{n}', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=submission._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out=submission._workspace(f'tune_out_{dim}_{n}', (bsz,n,n,dim), torch.float32, input_tensor.device)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows,out_bm),)](
        hidden, ogate, weights['to_out_norm.weight'], weights['to_out_norm.bias'], out_w, out, bsz, n, hdim, dim, 1e-5,
        BLOCK_M=out_bm, BLOCK_H=128, BLOCK_D=out_bd, num_warps=4)
    return out

for spec, configs in [
 (dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'), [(64,32),(64,64),(64,128),(32,64),(32,128),(128,32),(128,64)]),
 (dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'), [(64,32),(64,64),(64,128),(32,64),(128,32),(128,64)]),
]:

        lgw=submission._cached_transpose_to(weights['left_gate.weight'], torch.float16, 'lg16')
        rw=submission._cached_transpose_to(weights['right_proj.weight'], torch.float16, 'rp16')
        rgw=submission._cached_transpose_to(weights['right_gate.weight'], torch.float16, 'rg16')
        ogw=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, 'og16')
        submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total_rows,proj_bm), triton.cdiv(hdim,proj_bh))](
            x_norm, mask.reshape(total_rows), lw, lgw, rw, rgw, ogw, left, right, ogate, total_rows, n, dim, hdim,
            BLOCK_M=proj_bm, BLOCK_H=proj_bh, BLOCK_K=proj_bk, HAS_MASK=mask.dtype "'!= torch.float32, num_warps=4)
    hidden=submission._workspace(f'"'tp_h_{dim}_{n}', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=submission._cached_transpose_to(weights['to_out.weight'], torch.float16, 'out16')
    out=submission._workspace(f'tp_out_{dim}_{n}', (bsz,n,n,dim), torch.float32, input_tensor.device)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows,out_bm),)](
        hidden, ogate, weights['to_out_norm.weight'], weights['to_out_norm.bias'], out_w, out, bsz, n, hdim, dim, 1e-5,
        BLOCK_M=out_bm, BLOCK_H=128, BLOCK_D=out_bd, num_warps=4)
    return out

def bench(spec, configs, inter=True):
    print('\\nCASE', spec, 'inter', inter)
    data=generate_input(**spec)
    for cfg in configs:
        try:
            out=path(data,*cfg, inter=inter); torch.cuda.synchronize()
            good,msg=check_implementation(data,out)
            if not good:

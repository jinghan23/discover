+@triton.jit
+def _proj_pair_fp16_kernel(
+    x_ptr,
+    mask_ptr,
+    w_proj_ptr,
+    w_gate_ptr,
+    dst_ptr,
+    M,
+    N,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    row_mask = rows < M
+    hmask = hs < H
+
+    if HAS_MASK:
+        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
+    else:
+        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)
+
+    acc_proj = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    acc_gate = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    for k0 in range(0, C, BLOCK_K):
+        ks = k0 + tl.arange(0, BLOCK_K)
+        kmask = ks < C
+        a = tl.load(
+            x_ptr + rows[:, None] * C + ks[None, :],
+            mask=row_mask[:, None] & kmask[None, :],
+            other=0.0,
+        )
+        wp = tl.load(
+            w_proj_ptr + ks[:, None] * H + hs[None, :],
+            mask=kmask[:, None] & hmask[None, :],
+            other=0.0,
+        )
+        wg = tl.load(
+            w_gate_ptr + ks[:, None] * H + hs[None, :],
+            mask=kmask[:, None] & hmask[None, :],
+            other=0.0,
+        )
+        acc_proj += tl.dot(a, wp)
+        acc_gate += tl.dot(a, wg)
+
+    val = acc_proj * tl.sigmoid(acc_gate) * mval[:, None]
+    nn = N * N
+    batch = rows // nn
+    inner = rows - batch * nn
+    off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
+    tl.store(dst_ptr + off, val, mask=row_mask[:, None] & hmask[None, :])
+
+
+@triton.jit
+def _proj_out_gate_fp16_kernel(
+    x_ptr,
+    w_ptr,
+    ogate_ptr,
+    M,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    row_mask = rows < M
+    hmask = hs < H
+
+    acc = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    for k0 in range(0, C, BLOCK_K):
+        ks = k0 + tl.arange(0, BLOCK_K)
+        kmask = ks < C
+        a = tl.load(
+            x_ptr + rows[:, None] * C + ks[None, :],
+            mask=row_mask[:, None] & kmask[None, :],
+            other=0.0,
+        )
+        w = tl.load(
+            w_ptr + ks[:, None] * H + hs[None, :],
+            mask=kmask[:, None] & hmask[None, :],
+            other=0.0,
+        )
+        acc += tl.dot(a, w)
+
+    tl.store(
+        ogate_ptr + rows[:, None] * H + hs[None, :],
+        tl.sigmoid(acc),
+        mask=row_mask[:, None] & hmask[None, :],
+    )

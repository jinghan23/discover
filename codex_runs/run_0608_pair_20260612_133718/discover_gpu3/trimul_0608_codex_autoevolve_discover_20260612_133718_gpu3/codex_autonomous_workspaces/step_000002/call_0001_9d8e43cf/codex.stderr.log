+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    row_mask = rows < M
+    hmask = hs < H
+
+    acc = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
+    for k0 in range(0, C, BLOCK_K):
+        ks = k0 + tl.arange(0, BLOCK_K)
+        kmask = ks < C
+        a = tl.load(
+            x_ptr + rows[:, None] * C + ks[None, :],
+            mask=row_mask[:, None] & kmask[None, :],
+            other=0.0,
+        )
+        w = tl.load(
+            w_ptr + ks[:, None] * H + hs[None, :],
+            mask=kmask[:, None] & hmask[None, :],
+            other=0.0,
+        )
+        acc += tl.dot(a, w)
+
+    tl.store(
+        ogate_ptr + rows[:, None] * H + hs[None, :],
+        tl.sigmoid(acc),
+        mask=row_mask[:, None] & hmask[None, :],
+    )

import sys, torch, math
import triton, triton.language as tl
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@triton.jit
def _proj_pair_kernel(x_ptr, mask_ptr, w_p_ptr, w_g_ptr, out_ptr, M, N, C:tl.constexpr, H:tl.constexpr, BLOCK_M:tl.constexpr, BLOCK_H:tl.constexpr, BLOCK_K:tl.constexpr, HAS_MASK:tl.constexpr):
    pid_m=tl.program_id(0); pid_h=tl.program_id(1)
    rows=pid_m*BLOCK_M+tl.arange(0,BLOCK_M); hs=pid_h*BLOCK_H+tl.arange(0,BLOCK_H)
    row_mask=rows<M; hmask=hs<H
    if HAS_MASK:
        mval=tl.load(mask_ptr+rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval=tl.full((BLOCK_M,),1.0,dtype=tl.float32)
    acc_p=tl.zeros((BLOCK_M,BLOCK_H),tl.float32)
    acc_g=tl.zeros((BLOCK_M,BLOCK_H),tl.float32)
    for k0 in range(0,C,BLOCK_K):
        ks=k0+tl.arange(0,BLOCK_K); kmask=ks<C
        a=tl.load(x_ptr+rows[:,None]*C+ks[None,:], mask=row_mask[:,None]&kmask[None,:], other=0.0)
        wp=tl.load(w_p_ptr+ks[:,None]*H+hs[None,:], mask=kmask[:,None]&hmask[None,:], other=0.0)
        wg=tl.load(w_g_ptr+ks[:,None]*H+hs[None,:], mask=kmask[:,None]&hmask[None,:], other=0.0)
        acc_p += tl.dot(a,wp)
        acc_g += tl.dot(a,wg)
    val=acc_p*tl.sigmoid(acc_g)*mval[:,None]
    nn=N*N; batch=rows//nn; inner=rows-batch*nn
    off=batch[:,None]*(H*nn)+hs[None,:]*nn+inner[:,None]
    tl.store(out_ptr+off, val, mask=row_mask[:,None]&hmask[None,:])

@triton.jit
def _proj_og_kernel(x_ptr, w_ptr, og_ptr, M, C:tl.constexpr, H:tl.constexpr, BLOCK_M:tl.constexpr, BLOCK_H:tl.constexpr, BLOCK_K:tl.constexpr):
    pid_m=tl.program_id(0); pid_h=tl.program_id(1)
    rows=pid_m*BLOCK_M+tl.arange(0,BLOCK_M); hs=pid_h*BLOCK_H+tl.arange(0,BLOCK_H)
    row_mask=rows<M; hmask=hs<H
    acc=tl.zeros((BLOCK_M,BLOCK_H),tl.float32)
    for k0 in range(0,C,BLOCK_K):
        ks=k0+tl.arange(0,BLOCK_K); kmask=ks<C
        a=tl.load(x_ptr+rows[:,None]*C+ks[None,:], mask=row_mask[:,None]&kmask[None,:], other=0.0)
        w=tl.load(w_ptr+ks[:,None]*H+hs[None,:], mask=kmask[:,None]&hmask[None,:], other=0.0)
        acc += tl.dot(a,w)
    tl.store(og_ptr+rows[:,None]*H+hs[None,:], tl.sigmoid(acc), mask=row_mask[:,None]&hmask[None,:])

def split_kernel(data):
    input_tensor, mask, weights, config=data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    x_norm=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,128),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=128,BLOCK_C=128,num_warps=8)
    lw=weights['left_proj.weight'].t().contiguous().to(torch.float16)
    lgw=weights['left_gate.weight'].t().contiguous().to(torch.float16)
    rw=weights['right_proj.weight'].t().contiguous().to(torch.float16)
    rgw=weights['right_gate.weight'].t().contiguous().to(torch.float16)
    ogw=weights['out_gate.weight'].t().contiguous().to(torch.float16)
    has_mask=mask.dtype"'!=torch.float32
    mf=mask.reshape(total).to(torch.float16) if has_mask else torch.empty((0,),device=input_tensor.device,dtype=torch.float16)
    left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
    grid=(triton.cdiv(total,64),triton.cdiv(hdim,64))
    _proj_pair_kernel[grid](x_norm,mf,lw,lgw,left,total,n,dim,hdim,BLOCK_M=64,BLOCK_H=64,BLOCK_K=32,HAS_MASK=has_mask,num_warps=4)
    _proj_pair_kernel[grid](x_norm,mf,rw,rgw,right,total,n,dim,hdim,BLOCK_M=64,BLOCK_H=64,BLOCK_K=32,HAS_MASK=has_mask,num_warps=4)
    _proj_og_kernel[grid](x_norm,ogw,og,total,dim,hdim,BLOCK_M=64,BLOCK_H=64,BLOCK_K=32,num_warps=4)
    hidden=torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2))
    out_w=weights['"'to_out.weight'].t().contiguous().to(torch.float16)
    out=torch.empty((bsz,n,n,dim),device=input_tensor.device,dtype=torch.float32)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=64,num_warps=4)
    return out


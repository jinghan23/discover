codex
I’m testing a packed-FP16 projection variant without committing it yet. It uses cuBLAS for the five projections as one `[rows, C] x [C, 5H]` GEMM, then reuses the existing Triton layout and output kernels; this trades extra projection storage for potentially better tensor-core utilization.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import sys, torch, math
import torch.nn.functional as F
import triton
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

def fp16_packed(data):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']
    total=bsz*n*n; nn=n*n
    x_norm=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,128),)](
        input_tensor.reshape(total,dim), x_norm, weights['norm.weight'], weights['norm.bias'], total, dim, 1.0e-5,
        BLOCK_M=128, BLOCK_C=128, num_warps=8)
    packed=torch.cat((weights['left_proj.weight'], weights['right_proj.weight'], weights['left_gate.weight'], weights['right_gate.weight'], weights['out_gate.weight']),dim=0).to(torch.float16)
    proj=F.linear(x_norm, packed)
    has_mask = mask.dtype "'!= torch.float32
    left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16)
    right=torch.empty_like(left)
    ogate=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float32)
    submission._gate_layout_kernel[(triton.cdiv(total,64),triton.cdiv(hdim,64))](
        proj, mask.reshape(total), left, right, ogate, total, nn, hdim, HAS_MASK=has_mask, BLOCK_M=64, BLOCK_H=64, num_warps=8)
    hidden=torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2))

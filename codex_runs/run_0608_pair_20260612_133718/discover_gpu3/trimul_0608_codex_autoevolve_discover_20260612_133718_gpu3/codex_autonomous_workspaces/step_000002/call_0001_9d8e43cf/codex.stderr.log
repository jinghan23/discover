import sys, math, torch, gc
sys.path.insert(0, '.')
from reference import generate_input, check_implementation
from submission import custom_kernel
cases = [
 dict(seqlen=256, bs=2, dim=128, hiddendim=128, seed=9371, nomask=True, distribution='normal'),
 dict(seqlen=768, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal'),
 dict(seqlen=512, bs=1, dim=128, hiddendim=128, seed=12819, nomask=True, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=128, hiddendim=128, seed=381, nomask=True, distribution='cauchy'),
 dict(seqlen=768, bs=1, dim=384, hiddendim=128, seed=481, nomask=False, distribution='normal'),
 dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal'),
]
# compile all
for c in cases:
    d=generate_input(**c); o=custom_kernel(d); torch.cuda.synchronize(); del d,o

times=[]
for idx,c0 in enumerate(cases):
    ds=[]
    seed=c0['seed']
    for i in range(6):
        c=dict(c0); c['seed']=seed+13*i
        data=generate_input(**c)
        check_copy=tuple(x.clone() if torch.is_tensor(x) else ({k:(v.clone() if torch.is_tensor(v) else v) for k,v in x.items()} if isinstance(x,dict) else x) for x in data)
        torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True)
        st.record(); out=custom_kernel(data); en.record(); torch.cuda.synchronize()
        ds.append(st.elapsed_time(en)*1000.0)
        good,msg=check_implementation(check_copy,out)
        if not good: print('bad',idx,msg[:300]); break
        del data,check_copy,out
        gc.collect()
    mean=sum(ds)/len(ds); times.append(mean)
    print('case',idx,'us', ['%.1f'%x for x in ds], 'mean %.1f best %.1f'% (mean,min(ds)))
print('geom', math.exp(sum(math.log(x) for x in times)/len(times)))

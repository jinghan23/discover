   560	    mask = (rows[:, None] < total_rows) & (ds[None, :] < dim)
   561	    vals = tl.load(x_ptr + rows[:, None] * dim + ds[None, :], mask=mask, other=0.0).to(tl.float32)
   562	
   563	    mean = tl.sum(vals, axis=1) / dim
   564	    centered = vals - mean[:, None]
   565	    var = tl.sum(centered * centered, axis=1) / dim

def _all_model_tensors(data):
    input_tensor, mask, weights, _ = data
    return (
        input_tensor,
        mask,
        weights["norm.weight"],
        weights["norm.bias"],
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        weights["to_out.weight"],
    )


def _graph_key(tag, data):
    tensors = _all_model_tensors(data)
    input_tensor, _, _, config = data
    key = [tag, input_tensor.shape[0], input_tensor.shape[1], config["dim"], config["hidden_dim"]]
    for t in tensors:
        key.append((id(t), tuple(t.shape), tuple(t.stride()), t.dtype, t.device.index))
    return tuple(key), tensors


def _lookup_graph(tag, data):
    key, tensors = _graph_key(tag, data)
    entry = _GRAPH_CACHE.get(key)
    if entry is not None:
        refs, graph, out, buffers = entry
        ok = True
        for ref, tensor in zip(refs, tensors):
            ok = ok and (ref() is tensor)
        if ok:
            return key, tensors, graph, out, buffers
    return key, tensors, None, None, None


def _store_graph(key, tensors, graph, out, buffers):
    try:
        _GRAPH_CACHE[key] = (tuple(weakref.ref(t) for t in tensors), graph, out, buffers)
    except TypeError:
        pass



+@torch.no_grad()
+def _fp16_linear_graph_kernel(data):
+    key, tensors, graph, out, _ = _lookup_graph("fp16_linear_graph", data)
+    if graph is not None:
+        graph.replay()
+        return out
+
+    try:
+        input_tensor, mask, weights, config = data
+        bsz = input_tensor.shape[0]
+        n = input_tensor.shape[1]
+        dim = config["dim"]
+        hdim = config["hidden_dim"]
+        nn = n * n
+        total_rows = bsz * nn
+
+        ln_block_m = 32 if dim == 384 else 128
+        ln_block_c = 256 if dim == 384 else 128
+        ln_warps = 4 if dim == 384 else 8
+        out_block_d = 32 if dim == 128 else 64
+
+        packed_w = _cached_packed_proj(weights, torch.float16)
+        packed_w_t = packed_w.t()
+        out_w = _cached_transpose_to(weights["to_out.weight"], torch.float16, "out16")
+
+        x_norm = torch.empty((total_rows, dim), device=input_tensor.device, dtype=torch.float16)
+        proj = torch.empty((total_rows, 5 * hdim), device=input_tensor.device, dtype=torch.float16)
+        left = torch.empty((bsz, hdim, n, n), device=input_tensor.device, dtype=torch.float16)
+        right = torch.empty_like(left)
+        ogate = torch.empty((total_rows, hdim), device=input_tensor.device, dtype=torch.float16)
+        hidden = torch.empty((bsz * hdim, n, n), device=input_tensor.device, dtype=torch.float16)
+        out = torch.empty((bsz, n, n, dim), device=input_tensor.device, dtype=torch.float32)
+
+        def ops():
+            _row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](
+                input_tensor.reshape(total_rows, dim),
+                x_norm,
+                weights["norm.weight"],
+                weights["norm.bias"],
+                total_rows,
+                dim,
+                1.0e-5,
+                BLOCK_M=ln_block_m,
+                BLOCK_C=ln_block_c,
+                num_warps=ln_warps,
+            )
+            torch.mm(x_norm, packed_w_t, out=proj)
+            _gate_layout_kernel[(triton.cdiv(total_rows, 64), triton.cdiv(hdim, 64))](
+                proj,
+                mask.reshape(total_rows),
+                left,
+                right,
+                ogate,
+                total_rows,
+                nn,
+                hdim,
+                HAS_MASK=mask.dtype != torch.float32,
+                BLOCK_M=64,
+                BLOCK_H=64,
+                num_warps=8,
+            )
+            torch.bmm(
+                left.reshape(bsz * hdim, n, n),
+                right.reshape(bsz * hdim, n, n).transpose(1, 2),
+                out=hidden,
+            )
+            _ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows, 64),)](
+                hidden,
+                ogate,
+                weights["to_out_norm.weight"],
+                weights["to_out_norm.bias"],
+                out_w,
+                out,
+                bsz,
+                n,
+                hdim,
+                dim,
+                1.0e-5,
+                BLOCK_M=64,
+                BLOCK_H=128,
+                BLOCK_D=out_block_d,
+                num_warps=4,
+            )
+
+        ops()
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            ops()
+        _store_graph(key, tensors, graph, out, (x_norm, proj, left, right, ogate, hidden, packed_w_t))
+        return out
+    except Exception:
+        return _fp16_linear_kernel(data)

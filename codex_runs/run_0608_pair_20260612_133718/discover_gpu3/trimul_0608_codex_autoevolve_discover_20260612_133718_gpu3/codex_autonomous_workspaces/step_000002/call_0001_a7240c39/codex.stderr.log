        mask_flat=mask.reshape(total)
        left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16)
        right=torch.empty_like(left)
        ogate=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
        ev[2].record()
        _proj_gate_mask_fp16_kernel[(triton.cdiv(total,64),triton.cdiv(hdim,64))](x_norm,mask_flat,left_w,left_gate_w,right_w,right_gate_w,out_gate_w,left,right,ogate,total,n,dim,hdim,BLOCK_M=64,BLOCK_H=64,BLOCK_K=32,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
        ev[3].record()
        hidden=torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2))
        ev[4].record()
        out_w=_cached_transpose_to(weights['"'to_out.weight'],torch.float16,'out16')

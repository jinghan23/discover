import sys, torch, triton
sys.path.insert(0,'.')
from reference import generate_input
from submission import (_row_ln_fp16_kernel,_proj_gate_mask_fp16_kernel,_ln_gate_out_linear_fp16_kernel,
    _cached_transpose_to)

def timed_fp16(data, iters=10):
    input_tensor, mask, weights, config = data
    bsz,n=input_tensor.shape[0], input_tensor.shape[1]
    dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    # compile/cache
    from submission import _fp16_fused_kernel
    for _ in range(3): _fp16_fused_kernel(data)
    torch.cuda.synchronize()
    sums=[0.0]*6
    for _ in range(iters):
        ev=[torch.cuda.Event(True) for _ in range(7)]
        ev[0].record()
        x_norm=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16)
        _row_ln_fp16_kernel[(triton.cdiv(total,128),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=128,BLOCK_C=128,num_warps=8)
        ev[1].record()

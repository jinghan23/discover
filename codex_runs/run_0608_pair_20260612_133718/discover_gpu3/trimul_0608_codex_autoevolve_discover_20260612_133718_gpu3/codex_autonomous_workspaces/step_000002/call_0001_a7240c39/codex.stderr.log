def make_graph(data):
 input_tensor,mask,weights,config=data; bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n; nn=n*n
 x=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16); proj=torch.empty((total,5*hdim),device=input_tensor.device,dtype=torch.float16)
 left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16); right=torch.empty_like(left); ogate=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
 hidden=torch.empty((bsz*hdim,n,n),device=input_tensor.device,dtype=torch.float16); out=torch.empty((bsz,n,n,dim),device=input_tensor.device,dtype=torch.float32)
 packed=_cached_packed_proj(weights,torch.float16); packed_t=packed.t() # non-contig view
 outw=_cached_transpose_to(weights['to_out.weight'],torch.float16,'out16')
 lbm=32 if dim==384 else 128; lbc=256 if dim==384 else 128; lw=4 if dim==384 else 8; bd=32 if dim==128 else 64
 def ops():
  _row_ln_fp16_kernel[(triton.cdiv(total,lbm),)](input_tensor.reshape(total,dim),x,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lbm,BLOCK_C=lbc,num_warps=lw)
  torch.mm(x,packed_t,out=proj)
  _gate_layout_kernel[(triton.cdiv(total,64),triton.cdiv(hdim,64))](proj,mask.reshape(total),left,right,ogate,total,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=64,BLOCK_H=64,num_warps=8)
  torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
  _ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,ogate,weights['"'to_out_norm.weight'],weights['to_out_norm.bias'],outw,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=bd,num_warps=4)
 ops(); torch.cuda.synchronize(); g=torch.cuda.CUDAGraph();
 with torch.cuda.graph(g): ops()
 return g,out


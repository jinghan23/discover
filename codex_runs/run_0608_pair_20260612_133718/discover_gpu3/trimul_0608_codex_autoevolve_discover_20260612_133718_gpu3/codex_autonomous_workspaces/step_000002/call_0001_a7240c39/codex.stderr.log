+    key = _cache_key(weight, dtype=dtype, tag=tag)
+    entry = _WEIGHT_CACHE.get(key)
+    if entry is not None:
+        ref, cached = entry
+        if ref() is weight:
+            return cached
+    try:
+        cached = weight.t().contiguous().to(dtype)
+        _WEIGHT_CACHE[key] = (weakref.ref(weight), cached)
+        return cached
+    except TypeError:

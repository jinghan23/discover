+        if ok:
+            return cached
+    try:
+        cached = torch.cat(tensors, dim=0).to(dtype)
+        _WEIGHT_CACHE[key] = (tuple(weakref.ref(t) for t in tensors), cached)
+        return cached
+    except TypeError:
+        return torch.cat(tensors, dim=0).to(dtype)

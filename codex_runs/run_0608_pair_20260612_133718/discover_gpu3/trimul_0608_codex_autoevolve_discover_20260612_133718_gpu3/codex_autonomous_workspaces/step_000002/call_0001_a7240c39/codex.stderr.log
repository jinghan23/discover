import sys, torch, triton
sys.path.insert(0,'.')
from reference import generate_input
from submission import _input_ln_bf16_kernel,_gate_layout_kernel,_out_norm_gate_kernel,_cached_packed_proj
import torch.nn.functional as F

def timed_bf16(data,iters=8):
    input_tensor,mask,weights,config=data; bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; nn=n*n; total=bsz*nn
    from submission import _bf16_bmm_kernel
    for _ in range(3): _bf16_bmm_kernel(data)
    torch.cuda.synchronize(); sums=[0]*7
    for _ in range(iters):
        ev=[torch.cuda.Event(True) for _ in range(8)]; ev[0].record()
        use_direct_ln=dim==384 or (dim==128 and n<=512)
        if use_direct_ln:
            x2=torch.empty((total,dim),device=input_tensor.device,dtype=torch.bfloat16)
            block_d=triton.next_power_of_2(dim); block_m=8 if dim<=384 else 4
            _input_ln_bf16_kernel[(triton.cdiv(total,block_m),)](input_tensor,weights['norm.weight'],weights['norm.bias'],x2,total,dim,BLOCK_M=block_m,BLOCK_D=block_d,num_warps=8)
        else:
            x2=F.layer_norm(input_tensor,(dim,),weights['norm.weight'],weights['norm.bias']).reshape(total,dim).to(torch.bfloat16)
        ev[1].record()
        packed_w=_cached_packed_proj(weights,torch.bfloat16)
        ev[2].record()
        proj=F.linear(x2,packed_w)
        ev[3].record()
        left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.bfloat16); right=torch.empty_like(left); ogate=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float32)
        _gate_layout_kernel[(triton.cdiv(total,64),triton.cdiv(hdim,64))](proj,mask.reshape(total),left,right,ogate,total,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=64,BLOCK_H=64,num_warps=8)
        ev[4].record()
        out_ch=torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2))
        ev[5].record()
        out=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float32)
        _out_norm_gate_kernel[(triton.cdiv(total,32),)](out_ch,ogate,weights['"'to_out_norm.weight'],weights['to_out_norm.bias'],out,total,nn,hdim,BLOCK_M=32,BLOCK_H=128,num_warps=4)
        ev[6].record()
        out=F.linear(out,weights['to_out.weight']).view(bsz,n,n,dim)
        ev[7].record(); torch.cuda.synchronize()
        for i in range(7): sums[i]+=ev[i].elapsed_time(ev[i+1])*1000
    return [x/iters for x in sums]
for idx,spec in [(5,dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')),(6,dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal'))]:
    vals=timed_bf16(generate_input(**spec))

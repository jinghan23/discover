+    for t in tensors:
+        key.append((id(t), tuple(t.shape), tuple(t.stride()), t.dtype, t.device.index))
+    return tuple(key), tensors
+
+
+def _lookup_graph(tag, data):
+    key, tensors = _graph_key(tag, data)
+    entry = _GRAPH_CACHE.get(key)
+    if entry is not None:
+        refs, graph, out, buffers = entry
+        ok = True
+        for ref, tensor in zip(refs, tensors):
+            ok = ok and (ref() is tensor)
+        if ok:
+            return key, tensors, graph, out, buffers
+    return key, tensors, None, None, None
+
+
+def _store_graph(key, tensors, graph, out, buffers):
+    try:
+        _GRAPH_CACHE[key] = (tuple(weakref.ref(t) for t in tensors), graph, out, buffers)

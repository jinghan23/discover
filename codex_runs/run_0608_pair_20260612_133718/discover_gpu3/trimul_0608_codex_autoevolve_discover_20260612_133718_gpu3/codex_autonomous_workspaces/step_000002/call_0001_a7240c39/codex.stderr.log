+    key = _cache_key(*tensors, dtype=dtype, tag="packed_proj")
+    entry = _WEIGHT_CACHE.get(key)
+    if entry is not None:
+        refs, cached = entry
+        ok = True
+        for ref, tensor in zip(refs, tensors):

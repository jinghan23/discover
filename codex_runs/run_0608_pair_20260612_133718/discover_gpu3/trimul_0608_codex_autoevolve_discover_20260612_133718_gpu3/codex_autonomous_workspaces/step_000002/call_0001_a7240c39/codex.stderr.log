def bench(fn,iters=12):
    for _ in range(2): fn()
    torch.cuda.synchronize(); times=[]
    for _ in range(iters):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)

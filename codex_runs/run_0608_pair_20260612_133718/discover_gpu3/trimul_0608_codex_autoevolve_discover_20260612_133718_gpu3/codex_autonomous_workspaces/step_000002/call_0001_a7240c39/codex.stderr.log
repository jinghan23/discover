+def _cache_key(*tensors, dtype=None, tag=None):
+    key = [tag, dtype]
+    for t in tensors:
+        key.append((id(t), tuple(t.shape), tuple(t.stride()), t.dtype, t.device.index))
+    return tuple(key)

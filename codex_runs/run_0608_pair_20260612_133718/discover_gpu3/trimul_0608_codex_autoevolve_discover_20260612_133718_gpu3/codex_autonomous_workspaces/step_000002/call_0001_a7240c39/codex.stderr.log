+        ogate = torch.empty((total_rows, hdim), device=input_tensor.device, dtype=torch.float16)
+        hidden = torch.empty((bsz * hdim, n, n), device=input_tensor.device, dtype=torch.float16)
+        out = torch.empty((bsz, n, n, dim), device=input_tensor.device, dtype=torch.float32)
+
+        def ops():
+            _row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](
+                input_tensor.reshape(total_rows, dim),
+                x_norm,
+                weights["norm.weight"],
+                weights["norm.bias"],
+                total_rows,
+                dim,
+                1.0e-5,
+                BLOCK_M=ln_block_m,
+                BLOCK_C=ln_block_c,
+                num_warps=ln_warps,

+    pid_h = tl.program_id(0)
+    pid_c = tl.program_id(1)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    mask = (hs[:, None] < H) & (cs[None, :] < C)

from pathlib import Path
import math, os, sys, tempfile
import torch
ROOT = Path('/opt/tiger/discover')
sys.path.insert(0, str(ROOT / 'examples/gpu_mode/lib'))
from libkernelbot.consts import RankCriterion, SubmissionMode
from libkernelbot.run_eval import run_config
from libkernelbot.task import build_task_config, make_task_definition

task = make_task_definition(Path('/opt/tiger/discover/examples/gpu_mode/lib/bioml/trimul/task.yml')).task
code = Path('submission.py').read_text()
config = build_task_config(task=task, submission_content=code, arch=None, mode=SubmissionMode.LEADERBOARD)
with tempfile.TemporaryDirectory(prefix='run_', dir='eval_tmp') as tmp_dir:
    old=os.getcwd(); os.chdir(tmp_dir)
    try:
        result=run_config(config)
    finally:
        os.chdir(old)
run = result.runs['leaderboard'].run
n = int(run.result['benchmark-count'])
means=[]
for i in range(n):
    spec=run.result.get(f'benchmark.{i}.spec')
    mean=float(run.result[f'benchmark.{i}.mean'])/1000
    best=float(run.result[f'benchmark.{i}.best'])/1000
    err=float(run.result[f'benchmark.{i}.err'])/1000
    means.append(mean)
    print(i, mean, 'best', best, 'err', err, spec)
print('geom', math.exp(sum(math.log(x) for x in means)/len(means)))

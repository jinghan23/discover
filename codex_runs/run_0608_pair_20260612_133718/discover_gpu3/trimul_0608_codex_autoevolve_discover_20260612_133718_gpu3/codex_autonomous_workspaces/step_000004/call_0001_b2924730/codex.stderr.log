/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, time, math
from reference import generate_input, check_implementation
import submission
cases=[
 ('b0',dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')),
 ('b1',dict(seqlen=768,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
 ('b2',dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=2301,nomask=False,distribution='normal')),
 ('b3',dict(seqlen=512,bs=1,dim=128,hiddendim=128,seed=12819,nomask=True,distribution='normal')),
 ('b4',dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
 ('b5',dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')),
 ('b6',dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')),
]
funcs=[submission._fp16_fused_kernel, submission._fp16_linear_kernel, submission._bf16_bmm_kernel, submission.custom_kernel]
for name,case in cases:
    print('\\n',name,case)
    data=generate_input(**case)
    for fn in funcs:
        torch.cuda.empty_cache()
        try:
            out=fn(data); torch.cuda.synchronize()
            good,msg=check_implementation(data,out)
            if not good:
                print(fn.__name__,'BAD',msg.split('\\n')[0]); continue
            for _ in range(5): out=fn(data)
            torch.cuda.synchronize()
            times=[]
            for _ in range(20):
                st=torch.cuda.Event(True); en=torch.cuda.Event(True)
                st.record(); out=fn(data); en.record(); torch.cuda.synchronize()
                times.append(st.elapsed_time(en)*1000)
            print(fn.__name__, sum(times)/len(times), min(times))
        except Exception as e:
            print(fn.__name__,'ERR',type(e).__name__,str(e)[:150])

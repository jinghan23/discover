import torch, math
from reference import generate_input, check_implementation
import submission
cases=[
 ('b5',dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')),
 ('b6',dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')),
]
for name,c in cases:
    print('\\n',name)
    data=generate_input(**c)
    for fn in [submission._fp16_fused_kernel, submission._fp16_linear_kernel, submission.custom_kernel]:
        try:
            out=fn(data); torch.cuda.synchronize()
            print(fn.__name__, 'good', check_implementation(data,out)[0])
            for _ in range(3): out=fn(data)
            torch.cuda.synchronize()
            times=[]
            for _ in range(10):
                st=torch.cuda.Event(True); en=torch.cuda.Event(True)
                st.record(); out=fn(data); en.record(); torch.cuda.synchronize(); times.append(st.elapsed_time(en)*1000)
            print('time',sum(times)/len(times),min(times))
        except Exception as e: print(fn.__name__, 'ERR', e)

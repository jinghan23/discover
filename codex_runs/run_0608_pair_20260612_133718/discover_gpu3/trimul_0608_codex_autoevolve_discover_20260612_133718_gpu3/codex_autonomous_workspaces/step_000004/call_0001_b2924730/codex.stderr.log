        left_w,
        left_gate_w,
        right_w,
        right_gate_w,
        out_gate_w,
        left,
        right,
        ogate,
        total_rows,
        n,
        dim,
        hdim,
        BLOCK_M=128,
        BLOCK_H=32,
        BLOCK_K=64,
        HAS_MASK=has_mask,
        num_warps=4,

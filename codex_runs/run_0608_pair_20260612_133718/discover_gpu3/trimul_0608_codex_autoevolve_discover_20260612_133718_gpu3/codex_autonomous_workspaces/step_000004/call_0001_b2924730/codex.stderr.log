+def _pack5_transpose_fp16_kernel(
+    w_lp_ptr,
+    w_lg_ptr,
+    w_rp_ptr,
+    w_rg_ptr,
+    w_og_ptr,
+    pack_ptr,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_c = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    cs = pid_c * BLOCK_C + tl.arange(0, BLOCK_C)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+    mask = (cs[:, None] < C) & (hs[None, :] < H)
+
+    src = hs[None, :] * C + cs[:, None]
+    dst = cs[:, None] * H + hs[None, :]
+    size = C * H
+
+    lp = tl.load(w_lp_ptr + src, mask=mask, other=0.0).to(tl.float16)
+    lg = tl.load(w_lg_ptr + src, mask=mask, other=0.0).to(tl.float16)
+    rp = tl.load(w_rp_ptr + src, mask=mask, other=0.0).to(tl.float16)
+    rg = tl.load(w_rg_ptr + src, mask=mask, other=0.0).to(tl.float16)
+    og = tl.load(w_og_ptr + src, mask=mask, other=0.0).to(tl.float16)
+
+    tl.store(pack_ptr + dst, lp, mask=mask)
+    tl.store(pack_ptr + size + dst, lg, mask=mask)
+    tl.store(pack_ptr + 2 * size + dst, rp, mask=mask)
+    tl.store(pack_ptr + 3 * size + dst, rg, mask=mask)
+    tl.store(pack_ptr + 4 * size + dst, og, mask=mask)
+
+

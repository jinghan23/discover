import torch, triton
from reference import generate_input
from submission import _row_ln_fp16_kernel, _workspace
cases=[(1024,384),(768,384),(1024,128)]
for n,dim in cases:
    c=dict(seqlen=n,bs=1,dim=dim,hiddendim=128,seed=1,nomask=True,distribution='normal')
    data=generate_input(**c); x=data[0]; w=data[2]['norm.weight']; b=data[2]['norm.bias']
    total=x.shape[0]*x.shape[1]*x.shape[2]
    y=torch.empty((total,dim),device='cuda',dtype=torch.float16)
    print('\\ncase',n,dim,total)
    for bm in ([8,16,32,64,128] if dim==384 else [32,64,128,256]):
        bc=512 if dim==384 else 128
        nw=4 if dim==384 else 8
        try:
            for _ in range(3):
                _row_ln_fp16_kernel[(triton.cdiv(total,bm),)](x.reshape(total,dim),y,w,b,total,dim,1e-5,BLOCK_M=bm,BLOCK_C=bc,num_warps=nw)
            torch.cuda.synchronize()
            ts=[]
            for _ in range(20):
                st=torch.cuda.Event(True); en=torch.cuda.Event(True)

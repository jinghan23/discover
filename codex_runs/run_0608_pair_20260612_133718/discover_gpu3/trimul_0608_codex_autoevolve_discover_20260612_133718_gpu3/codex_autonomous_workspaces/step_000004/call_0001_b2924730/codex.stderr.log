+    rp = tl.load(w_rp_ptr + off, mask=mask, other=0.0).to(tl.float16)
+    lg = tl.load(w_lg_ptr + off, mask=mask, other=0.0).to(tl.float16)
+    rg = tl.load(w_rg_ptr + off, mask=mask, other=0.0).to(tl.float16)
+    og = tl.load(w_og_ptr + off, mask=mask, other=0.0).to(tl.float16)
+
+    tl.store(pack_ptr + off, lp, mask=mask)
+    tl.store(pack_ptr + size + off, rp, mask=mask)
+    tl.store(pack_ptr + 2 * size + off, lg, mask=mask)

import torch,triton
from reference import generate_input, check_implementation
from eval import _clone_data
import submission

def path_lnproj(data,BLOCK_M=16,BLOCK_H=128,BLOCK_K=64,warps=8):
    input_tensor, mask, weights, config=data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total_rows=bsz*n*n
    left_w=submission._cached_transpose_to(weights['left_proj.weight'],torch.float16,'tlp')
    left_gate_w=submission._cached_transpose_to(weights['left_gate.weight'],torch.float16,'tlg')
    right_w=submission._cached_transpose_to(weights['right_proj.weight'],torch.float16,'trp')
    right_gate_w=submission._cached_transpose_to(weights['right_gate.weight'],torch.float16,'trg')
    out_gate_w=submission._cached_transpose_to(weights['out_gate.weight'],torch.float16,'tog')
    left=submission._workspace(f'tleft{BLOCK_M}',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    right=submission._workspace(f'tright{BLOCK_M}',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    ogate=submission._workspace(f'togate{BLOCK_M}',(total_rows,hdim),torch.float16,input_tensor.device)
    submission._ln_proj_gate_mask_fp16_kernel[(triton.cdiv(total_rows,BLOCK_M),)](
        input_tensor.reshape(total_rows,dim), mask.reshape(total_rows), weights['norm.weight'], weights['norm.bias'],
        left_w,left_gate_w,right_w,right_gate_w,out_gate_w,left,right,ogate,total_rows,n,dim,hdim,1e-5,
        BLOCK_M=BLOCK_M,BLOCK_H=BLOCK_H,BLOCK_K=BLOCK_K,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=warps)
    hidden=submission._workspace(f'"'thidden{BLOCK_M}',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out_w=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'tout')
    out=submission._workspace(f'toutbuf{BLOCK_M}',(bsz,n,n,dim),torch.float32,input_tensor.device)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total_rows,64),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=32 if dim==128 else 64,num_warps=4)
    return out


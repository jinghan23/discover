The profile shows `bmm` is surprisingly not the main issue on large shapes, about 1.08 ms for `N=1024`; the projection/gating and final output projection dominate. I’m tuning those Triton launch shapes next.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
from reference import generate_input
import submission

def timed(fn):
    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); r=fn(); en.record(); torch.cuda.synchronize(); return r, st.elapsed_time(en)*1000

def stages(spec, linear=True):
    data=generate_input(**spec); input_tensor, mask, weights, config=data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total_rows=bsz*n*n; nn=n*n
    # warm full
    submission.custom_kernel(data); torch.cuda.synchronize()
    data=generate_input(**spec); input_tensor, mask, weights, config=data
    times={}
    x_norm=submission._workspace('bench_x_norm',(total_rows,dim),torch.float16,input_tensor.device)
    ln_block_m=16 if (linear and dim==384) else (32 if dim==384 else 128)
    ln_block_c=512 if dim==384 else 128; ln_warps=4 if dim==384 else 8
    _,times['ln']=timed(lambda: submission._row_ln_fp16_kernel[(triton.cdiv(total_rows, ln_block_m),)](input_tensor.reshape(total_rows,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total_rows,dim,1e-5,BLOCK_M=ln_block_m,BLOCK_C=ln_block_c,num_warps=ln_warps))
    if linear:
      packed,times['pack']=timed(lambda: submission._cached_packed_proj(weights, torch.float16))
      proj,times['linear_proj']=timed(lambda: torch.nn.functional.linear(x_norm, packed))
      left=submission._workspace('bench_left',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace('bench_right',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace('bench_ogate',(total_rows,hdim),torch.float16,input_tensor.device)
      _,times['gate_layout']=timed(lambda: submission._gate_layout_kernel[(triton.cdiv(total_rows,64),triton.cdiv(hdim,64))](proj,mask.reshape(total_rows),left,right,ogate,total_rows,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=64,BLOCK_H=64,num_warps=8))
    else:
      lwp,times['"'w_lp']=timed(lambda: submission._cached_transpose_to(weights['left_proj.weight'],torch.float16,'xxlp'))
      lgp,times['w_lg']=timed(lambda: submission._cached_transpose_to(weights['left_gate.weight'],torch.float16,'xxlg'))
      rwp,times['w_rp']=timed(lambda: submission._cached_transpose_to(weights['right_proj.weight'],torch.float16,'xxrp'))
      rgp,times['w_rg']=timed(lambda: submission._cached_transpose_to(weights['right_gate.weight'],torch.float16,'xxrg'))

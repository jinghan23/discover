import torch,triton
from reference import generate_input, check_implementation
from eval import _clone_data
import submission

def path(data, BM=128,BH=32,BK=64,warps=4,stages=None, finalBM=64, finalBD=None):
 input_tensor,mask,weights,config=data; bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
 x=submission._workspace(f'tx{BM}_{BH}_{BK}',(total,dim),torch.float16,input_tensor.device)
 lnbm=32 if dim==384 else 128; lnbc=512 if dim==384 else 128; lnw=4 if dim==384 else 8
 submission._row_ln_fp16_kernel[(triton.cdiv(total,lnbm),)](input_tensor.reshape(total,dim),x,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lnbm,BLOCK_C=lnbc,num_warps=lnw)
 ws=[submission._cached_transpose_to(weights[k],torch.float16,k+str(BM)+str(BH)+str(BK)) for k in ['left_proj.weight','left_gate.weight','right_proj.weight','right_gate.weight','out_gate.weight']]
 left=submission._workspace(f'tl{BM}_{BH}_{BK}',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace(f'tr{BM}_{BH}_{BK}',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace(f'to{BM}_{BH}_{BK}',(total,hdim),torch.float16,input_tensor.device)
 kwargs=dict(BLOCK_M=BM,BLOCK_H=BH,BLOCK_K=BK,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=warps)
 if stages is not None: kwargs['"'num_stages']=stages
 submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total,BM),triton.cdiv(hdim,BH))](x,mask.reshape(total),ws[0],ws[1],ws[2],ws[3],ws[4],left,right,ogate,total,n,dim,hdim,**kwargs)
 hidden=submission._workspace(f'th{BM}_{BH}_{BK}',(bsz*hdim,n,n),torch.float16,input_tensor.device); torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
 outw=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'out'+str(BM)+str(BH)+str(BK)); out=submission._workspace(f'tout{BM}_{BH}_{BK}',(bsz,n,n,dim),torch.float32,input_tensor.device)
 if finalBD is None: finalBD=32 if dim==128 else 64
 submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,finalBM),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],outw,out,bsz,n,hdim,dim,1e-5,BLOCK_M=finalBM,BLOCK_H=128,BLOCK_D=finalBD,num_warps=4)
 return out

def bench(idx,spec,params):

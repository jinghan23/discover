for name,c in cases:
  data=generate_input(**c); x,mask,w,config=data; B=x.shape[0]; N=x.shape[1]; C=config['dim']; H=config['hidden_dim']; M=B*N*N
  print('CASE',name,'M',M,'C',C)
  x_norm=torch.empty((M,C),device=x.device,dtype=torch.float16)
  submission._row_ln_fp16_kernel[(triton.cdiv(M,32 if C==384 else 128),)](x.reshape(M,C),x_norm,w['norm.weight'],w['norm.bias'],M,C,1e-5,BLOCK_M=32 if C==384 else 128,BLOCK_C=512 if C==384 else 128,num_warps=4 if C==384 else 8)

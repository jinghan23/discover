import sys, torch, triton, torch.nn.functional as F
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

def fp16_splitout(data, bk=None, use_linear_proj=False):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; M=bsz*n*n; nn=n*n
    x_norm=torch.empty((M,dim),device=input_tensor.device,dtype=torch.float16)
    lnBM=32 if dim==384 else 128
    submission._row_ln_fp16_kernel[(triton.cdiv(M,lnBM),)](input_tensor.reshape(M,dim),x_norm,weights['norm.weight'],weights['norm.bias'],M,dim,1e-5,BLOCK_M=lnBM,BLOCK_C=512 if dim==384 else 128,num_warps=4 if dim==384 else 8)
    left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16); right=torch.empty_like(left); ogate=torch.empty((M,hdim),device=input_tensor.device,dtype=torch.float16)
    if use_linear_proj:
      proj=F.linear(x_norm, torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16))
      submission._gate_layout_kernel[(triton.cdiv(M,64),triton.cdiv(hdim,64))](proj,mask.reshape(M),left,right,ogate,M,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=64,BLOCK_H=64,num_warps=8)
    else:
      if bk is None: bk=32 if (dim==128 and n<=256) else 64
      lw=weights['"'left_proj.weight'].t().contiguous().to(torch.float16); lgw=weights['left_gate.weight'].t().contiguous().to(torch.float16); rw=weights['right_proj.weight'].t().contiguous().to(torch.float16); rgw=weights['right_gate.weight'].t().contiguous().to(torch.float16); ogw=weights['out_gate.weight'].t().contiguous().to(torch.float16)
      submission._proj_gate_mask_fp16_kernel[(triton.cdiv(M,128),triton.cdiv(hdim,32))](x_norm,mask.reshape(M),lw,lgw,rw,rgw,ogw,left,right,ogate,M,n,dim,hdim,BLOCK_M=128,BLOCK_H=32,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
    hidden=torch.empty((bsz*hdim,n,n),device=input_tensor.device,dtype=torch.float16)
    torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
    tmp=torch.empty((M,hdim),device=input_tensor.device,dtype=torch.float16)
    submission._out_norm_gate_kernel[(triton.cdiv(M,32),)](hidden,ogate,weights['"'to_out_norm.weight'],weights['to_out_norm.bias'],tmp,M,nn,hdim,BLOCK_M=32,BLOCK_H=128,num_warps=4)
    out=F.linear(tmp, weights['to_out.weight'].to(torch.float16)).float().view(bsz,n,n,dim)
    return out

def bench(name,c,kwargs):
  data=generate_input(**c); print('CASE',name,kwargs)
  out=fp16_splitout(data,**kwargs); torch.cuda.synchronize(); ok,msg=check_implementation(data,out); print('ok',ok,msg[:100] if msg else '')
  if ok:
    for _ in range(3): out=fp16_splitout(data,**kwargs)
    torch.cuda.synchronize(); times=[]
    for _ in range(8):

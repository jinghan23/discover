I’m now tuning the Triton block sizes rather than changing the algorithm. The first targets are the row LayerNorm and projection tile sizes, because they account for most of the non-BMM time and are straightforward to A/B without affecting correctness.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import sys, torch, triton
sys.path.insert(0,'.')
from reference import generate_input
import submission
shapes=[('d128_n1024',dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal')),('d384_n1024',dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=1,nomask=True,distribution='normal')),('d384_n768',dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=1,nomask=False,distribution='normal')),('d128_n256b2',dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=1,nomask=True,distribution='normal'))]
for name,c in shapes:
    data=generate_input(**c); x,mask,w,config=data; M=x.shape[0]*x.shape[1]*x.shape[2]; C=config['dim']
    print('SHAPE',name,'M',M,'C',C)
    for BM in ([16,32,64,128,256] if C==128 else [4,8,16,32,64,128]):
      for BC in ([128] if C==128 else [384,512]):
        if BC < C: continue
        for NW in ([4,8] if C==128 else [4,8]):

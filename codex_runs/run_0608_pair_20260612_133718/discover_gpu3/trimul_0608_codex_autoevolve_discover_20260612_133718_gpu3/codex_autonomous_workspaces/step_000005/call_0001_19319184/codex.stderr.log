I’m trying a more substantive projection change: pack projection weights in an interleaved layout so one Triton dot computes projection+gate for left and one dot does the same for right. The existing packed kernel loads those columns with a strided pattern, which explains why it was much slower.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import sys, torch, triton
import triton.language as tl
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@triton.jit
def _proj_gate_mask_interleaved_fp16_kernel(
    x_ptr, mask_ptr, w_ptr, left_ptr, right_ptr, ogate_ptr,
    M, N, C: tl.constexpr, H: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_K: tl.constexpr, HAS_MASK: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    h_base = pid_h * BLOCK_H
    hs = h_base + tl.arange(0, BLOCK_H)
    pair_cols = tl.arange(0, BLOCK_H * 2)
    row_mask = rows < M
    hmask = hs < H
    acc_l = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_r = tl.zeros((BLOCK_M, BLOCK_H * 2), dtype=tl.float32)
    acc_og = tl.zeros((BLOCK_M, BLOCK_H), dtype=tl.float32)
    for k0 in range(0, C, BLOCK_K):
        ks = k0 + tl.arange(0, BLOCK_K)
        kmask = ks < C
        a = tl.load(x_ptr + rows[:, None] * C + ks[None, :], mask=row_mask[:, None] & kmask[None, :], other=0.0)
        lcols = 2 * h_base + pair_cols
        rcols = 2 * H + 2 * h_base + pair_cols
        ogcols = 4 * H + hs
        w_l = tl.load(w_ptr + ks[:, None] * (5 * H) + lcols[None, :], mask=kmask[:, None] & (lcols[None, :] < 2 * H), other=0.0)
        w_r = tl.load(w_ptr + ks[:, None] * (5 * H) + rcols[None, :], mask=kmask[:, None] & (rcols[None, :] < 4 * H), other=0.0)
        w_og = tl.load(w_ptr + ks[:, None] * (5 * H) + ogcols[None, :], mask=kmask[:, None] & hmask[None, :], other=0.0)
        acc_l += tl.dot(a, w_l)
        acc_r += tl.dot(a, w_r)
        acc_og += tl.dot(a, w_og)
    lp, lg = tl.split(tl.reshape(acc_l, (BLOCK_M, BLOCK_H, 2)))
    rp, rg = tl.split(tl.reshape(acc_r, (BLOCK_M, BLOCK_H, 2)))
    if HAS_MASK:
        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
    else:
        mval = tl.full((BLOCK_M,), 1.0, dtype=tl.float32)
    left_out = lp * tl.sigmoid(lg) * mval[:, None]
    right_out = rp * tl.sigmoid(rg) * mval[:, None]
    og = tl.sigmoid(acc_og)
    nn = N * N
    batch = rows // nn
    inner = rows - batch * nn
    lr_off = batch[:, None] * (H * nn) + hs[None, :] * nn + inner[:, None]
    valid = row_mask[:, None] & hmask[None, :]
    tl.store(left_ptr + lr_off, left_out, mask=valid)
    tl.store(right_ptr + lr_off, right_out, mask=valid)
    tl.store(ogate_ptr + rows[:, None] * H + hs[None, :], og, mask=valid)

def pack_inter(weights,dtype):
    lp=weights['left_proj.weight'].t().contiguous().to(dtype)
    lg=weights['left_gate.weight'].t().contiguous().to(dtype)
    rp=weights['right_proj.weight'].t().contiguous().to(dtype)
    rg=weights['right_gate.weight'].t().contiguous().to(dtype)
    og=weights['out_gate.weight'].t().contiguous().to(dtype)
    l=torch.stack((lp,lg),dim=2).reshape(lp.shape[0], lp.shape[1]*2)
    r=torch.stack((rp,rg),dim=2).reshape(rp.shape[0], rp.shape[1]*2)
    return torch.cat((l,r,og),dim=1).contiguous()

def path(data,bk):
    x,mask,w,config=data; B=x.shape[0]; N=x.shape[1]; C=config['dim']; H=config['hidden_dim']; M=B*N*N
    x_norm=torch.empty((M,C),device=x.device,dtype=torch.float16)
    submission._row_ln_fp16_kernel[(triton.cdiv(M,32 if C==384 else 128),)](x.reshape(M,C),x_norm,w['norm.weight'],w['norm.bias'],M,C,1e-5,BLOCK_M=32 if C==384 else 128,BLOCK_C=512 if C==384 else 128,num_warps=4 if C==384 else 8)
    packed=pack_inter(w,torch.float16)
    left=torch.empty((B,H,N,N),device=x.device,dtype=torch.float16); right=torch.empty_like(left); ogate=torch.empty((M,H),device=x.device,dtype=torch.float16)
    _proj_gate_mask_interleaved_fp16_kernel[(triton.cdiv(M,128),triton.cdiv(H,32))](x_norm,mask.reshape(M),packed,left,right,ogate,M,N,C,H,BLOCK_M=128,BLOCK_H=32,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
    hidden=torch.empty((B*H,N,N),device=x.device,dtype=torch.float16)
    torch.bmm(left.reshape(B*H,N,N),right.reshape(B*H,N,N).transpose(1,2),out=hidden)

import sys, torch
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission
cases=[
 ('c0',dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')),
 ('c1',dict(seqlen=768,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
 ('c2',dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=2301,nomask=False,distribution='normal')),
 ('c3',dict(seqlen=512,bs=1,dim=128,hiddendim=128,seed=12819,nomask=True,distribution='normal')),
 ('c4',dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
 ('c5',dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')),
 ('c6',dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')),
]
for name,c in cases:
    data=generate_input(**c); print('CASE',name)
    for fn in ['_fp16_fused_kernel','_fp16_interleaved_fused_kernel','custom_kernel']:
        f=getattr(submission,fn)
        try:
            out=f(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out)
            print(fn,'ok',ok,msg[:80] if msg else '')
            if ok:
                for _ in range(3): out=f(data)
                torch.cuda.synchronize(); times=[]
                for _ in range(8):
                    s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); out=f(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
                print(fn,'mean',sum(times)/len(times),'best',min(times))
        except Exception as e:
            print(fn,'EXC',type(e).__name__,str(e)[:200])
        torch.cuda.empty_cache()

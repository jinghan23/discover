            submission._proj_gate_mask_fp16_kernel[(triton.cdiv(M,BM),triton.cdiv(H,BH))](x_norm,mask.reshape(M),lw,lgw,rw,rgw,ogw,left,right,og,M,N,C,H,BLOCK_M=BM,BLOCK_H=BH,BLOCK_K=BK,HAS_MASK=mask.dtype!=torch.float32,num_warps=4)
            e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
          print('"'BM',BM,'BH',BH,'BK',BK,'mean',sum(times)/len(times),'best',min(times))
        except Exception as ex:

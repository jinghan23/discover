        ogate,
        weights["to_out_norm.weight"],
        weights["to_out_norm.bias"],
        out_w,
        out,
        bsz,
        n,
        hdim,
        dim,
        1.0e-5,
        BLOCK_M=64,
        BLOCK_H=128,
        BLOCK_D=out_block_d,
        num_warps=4,

import torch, sys, time
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

def bench(fn, data, reps=20):
    # warm
    for _ in range(3):
        out=fn(data)
    torch.cuda.synchronize()
    times=[]
    for _ in range(reps):
        torch.cuda.synchronize()
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        s.record(); out=fn(data); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)

cases=[
 ('c0', {'seqlen':256,'bs':2,'dim':128,'hiddendim':128,'seed':9371,'nomask':True,'distribution':'normal'}),
 ('c1', {'seqlen':768,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'}),
 ('c2', {'seqlen':256,'bs':2,'dim':384,'hiddendim':128,'seed':2301,'nomask':False,'distribution':'normal'}),
 ('c3', {'seqlen':512,'bs':1,'dim':128,'hiddendim':128,'seed':12819,'nomask':True,'distribution':'normal'}),
 ('c4', {'seqlen':1024,'bs':1,'dim':128,'hiddendim':128,'seed':381,'nomask':True,'distribution':'cauchy'}),
 ('c5', {'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'}),
 ('c6', {'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':23291,'nomask':True,'distribution':'normal'}),
]
fns=[
 ('custom', submission.custom_kernel),
 ('fp16_fused', submission._fp16_fused_kernel),
 ('fp16_raw', submission._fp16_rawproj_kernel),
 ('fp16_packed_fused', submission._fp16_packed_fused_kernel),
 ('fp16_linear', submission._fp16_linear_kernel),
 ('bf16_bmm', submission._bf16_bmm_kernel),
]
for name,c in cases:
    print('\\nCASE',name,c)
    data=generate_input(**c)
    for fname,fn in fns:
        try:
            out=fn(data)
            torch.cuda.synchronize()
            good,msg=check_implementation(data,out)
            if not good:
                print(fname,'FAIL',str(msg).split('\\n')[0])
                continue
            avg,best=bench(fn,data,reps=10 if c['seqlen']>=768 else 30)
            print(fname,'avg_us',round(avg,1),'best',round(best,1))
        except Exception as e:
            torch.cuda.synchronize()
            print(fname,'ERR',type(e).__name__,str(e)[:160])

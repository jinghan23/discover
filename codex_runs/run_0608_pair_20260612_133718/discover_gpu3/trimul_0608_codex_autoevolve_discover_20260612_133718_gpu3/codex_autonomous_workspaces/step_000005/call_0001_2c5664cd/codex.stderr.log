import torch, sys, triton
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@torch.no_grad()
def packed_path(data,bm=32,bh=32,bk=64):
 input_tensor,mask,weights,config=data
 bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
 x_norm=submission._workspace(f'pk_x_{bm}_{bh}_{bk}',(total,dim),torch.float16,input_tensor.device)
 lbm=32 if dim==384 else 128; lbc=512 if dim==384 else 128; lnw=4 if dim==384 else 8
 submission._row_ln_fp16_kernel[(triton.cdiv(total,lbm),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lbm,BLOCK_C=lbc,num_warps=lnw)
 packed=submission._cached_packed_proj_t(weights,torch.float16)
 left=submission._workspace(f'pk_left_{bm}_{bh}_{bk}',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace(f'pk_right_{bm}_{bh}_{bk}',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace(f'pk_og_{bm}_{bh}_{bk}',(total,hdim),torch.float16,input_tensor.device)
 submission._proj_gate_mask_packed_fp16_kernel[(triton.cdiv(total,bm),triton.cdiv(hdim,bh))](x_norm,mask.reshape(total),packed,left,right,ogate,total,n,dim,hdim,BLOCK_M=bm,BLOCK_H=bh,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
 hidden=submission._workspace(f'"'pk_hidden_{bm}_{bh}_{bk}',(bsz*hdim,n,n),torch.float16,input_tensor.device)
 torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
 outw=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'pk_out')
 out=submission._workspace(f'pk_outbuf_{bm}_{bh}_{bk}',(bsz,n,n,dim),torch.float32,input_tensor.device)
 submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],outw,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=(64 if dim==384 else 32),num_warps=4)
 return out

def bench(fn,data,reps):
 for _ in range(2): fn(data)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
 return sum(times)/len(times),min(times)


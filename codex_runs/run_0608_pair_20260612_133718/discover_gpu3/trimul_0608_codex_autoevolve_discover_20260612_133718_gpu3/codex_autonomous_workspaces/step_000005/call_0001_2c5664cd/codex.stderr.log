The sibling’s per-case run is noisy: it improves dim-384 N=256 and N=768, but the N=1024 dim-384 case had unstable long runs. I’m profiling that specific route to decide whether to port it only for N=768 and keep the packed cuBLAS path for N=1024.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, sys
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

def bench(fn,data,reps=10):
 for _ in range(3): fn(data)
 torch.cuda.synchronize(); times=[]
 for _ in range(reps):
  torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); out=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
 return sum(times)/len(times), min(times), max(times)
for c in [
 ('c5',{'seqlen':768,'bs':1,'dim':384,'hiddendim':128,'seed':481,'nomask':False,'distribution':'normal'}),
 ('c6',{'seqlen':1024,'bs':1,'dim':384,'hiddendim':128,'seed':23291,'nomask':True,'distribution':'normal'}),
 ('c2',{'seqlen':256,'bs':2,'dim':384,'hiddendim':128,'seed':2301,'nomask':False,'distribution':'normal'}),
 ('c3',{'seqlen':512,'bs':1,'dim':128,'hiddendim':128,'seed':12819,'nomask':True,'distribution':'normal'}),
]:
 name,args=c; print('\\nCASE',name)
 data=generate_input(**args)
 fns=[('custom',submission.custom_kernel)]
 if hasattr(submission,'_fp16_interleaved_fused_kernel'): fns.append(('interleaved',submission._fp16_interleaved_fused_kernel))
 fns += [('fused',submission._fp16_fused_kernel),('linear',submission._fp16_linear_kernel),('raw',submission._fp16_rawproj_kernel)]
 for fname,fn in fns:
  try:
   out=fn(data); torch.cuda.synchronize(); good,msg=check_implementation(data,out)
   if not good: print(fname,'FAIL',str(msg).split('\\n')[0]); continue
   avg,b,w=bench(fn,data,5 if args['seqlen']>=768 else 10)
   print(fname,round(avg,1),round(b,1),round(w,1))

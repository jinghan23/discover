     out=fn(data); torch.cuda.synchronize(); good,msg=check_implementation(data,out)
     if not good: continue
     avg,b=bench(fn,data,3)
     if avg<best[0]:
      best=(avg,(bm,bh,bk,b)); print('best',round(avg,1),best[1])
    except Exception as e:
     torch.cuda.synchronize()
 print('FINAL',best)

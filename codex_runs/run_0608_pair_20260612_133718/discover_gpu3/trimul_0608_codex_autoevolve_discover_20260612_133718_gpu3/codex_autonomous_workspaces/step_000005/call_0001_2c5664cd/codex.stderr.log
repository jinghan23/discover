@torch.no_grad()
def lnproj_path(data, bm=8, bk=32, outbm=64, outbd=32):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    left=submission._workspace(f't_lnproj_left_{bm}_{bk}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    right=submission._workspace(f't_lnproj_right_{bm}_{bk}', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    ogate=submission._workspace(f't_lnproj_og_{bm}_{bk}', (total,hdim), torch.float16, input_tensor.device)
    lw=submission._cached_transpose_to(weights['left_proj.weight'], torch.float16, f't_lp_{dim}')
    lg=submission._cached_transpose_to(weights['left_gate.weight'], torch.float16, f't_lg_{dim}')
    rw=submission._cached_transpose_to(weights['right_proj.weight'], torch.float16, f't_rp_{dim}')
    rg=submission._cached_transpose_to(weights['right_gate.weight'], torch.float16, f't_rg_{dim}')
    ogw=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, f't_og_{dim}')
    submission._ln_proj_gate_mask_fp16_kernel[(triton.cdiv(total,bm),)](
        input_tensor.reshape(total,dim), mask.reshape(total), weights['norm.weight'], weights['norm.bias'],
        lw,lg,rw,rg,ogw,left,right,ogate,total,n,dim,hdim,1.0e-5,
        BLOCK_M=bm,BLOCK_H=128,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
    hidden=submission._workspace(f'"'t_lnproj_hidden_{bm}_{bk}', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    outw=submission._cached_transpose_to(weights['to_out.weight'], torch.float16, f't_out_{dim}')
    out=submission._workspace(f't_lnproj_out_{bm}_{bk}_{outbm}_{outbd}', (bsz,n,n,dim), torch.float32, input_tensor.device)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,outbm),)](
        hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],outw,out,bsz,n,hdim,dim,1.0e-5,
        BLOCK_M=outbm,BLOCK_H=128,BLOCK_D=outbd,num_warps=4)
    return out

def bench(fn,data,reps):
    for _ in range(3): fn(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(reps):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); out=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)


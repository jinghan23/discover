+
+    h_og = cols - 4 * H
+    og_valid = cols >= 4 * H
+    og = tl.load(
+        og_ptr + h_og[None, :] * C + cs[:, None],
+        mask=cmask[:, None] & og_valid[None, :] & (h_og[None, :] < H),
+        other=0.0,
+    )
+
+    vals = lp + lg + rp + rg + og
+    tl.store(

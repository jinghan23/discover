+        ogate_ptr + rows[None, :] * hdim + hs[:, None],
+        mask=valid_r[None, :],
+        other=0.0,
+    ).to(tl.float32)
+    res = ((centered * inv[None, :]) * nw[:, None] + nb[:, None]) * og
+
+    tl.store(
+        tmp_ptr + rows[None, :] * hdim + hs[:, None],
+        res.to(tl.float16),
+        mask=valid_r[None, :],
+    )

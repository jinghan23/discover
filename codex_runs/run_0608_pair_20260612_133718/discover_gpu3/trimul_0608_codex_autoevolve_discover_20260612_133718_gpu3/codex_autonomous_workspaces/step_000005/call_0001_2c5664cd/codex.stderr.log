+def _proj_gate_mask_interleaved_fp16_kernel(
+    x_ptr,
+    mask_ptr,
+    w_ptr,
+    left_ptr,
+    right_ptr,
+    ogate_ptr,
+    M,
+    N,
+    C: tl.constexpr,
+    H: tl.constexpr,
+    BLOCK_M: tl.constexpr,

/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, sys, triton
import triton.language as tl
import torch.nn.functional as F
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@triton.jit
def _out_norm_gate_half_kernel(out_ch_ptr, ogate_ptr, norm_w_ptr, norm_b_ptr, tmp_ptr,
                               total_rows: tl.constexpr, nn: tl.constexpr, hdim: tl.constexpr,
                               BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m=tl.program_id(0)
    rows=pid_m*BLOCK_M+tl.arange(0,BLOCK_M)
    hs=tl.arange(0,BLOCK_H)
    valid=rows<total_rows
    batch=rows//nn
    inner=rows-batch*nn
    offs=batch[None,:]*(hdim*nn)+hs[:,None]*nn+inner[None,:]
    vals=tl.load(out_ch_ptr+offs, mask=valid[None,:], other=0.0).to(tl.float32)
    mean=tl.sum(vals,axis=0)/hdim
    cen=vals-mean[None,:]
    var=tl.sum(cen*cen,axis=0)/hdim
    inv=tl.rsqrt(var+1.0e-5)
    nw=tl.load(norm_w_ptr+hs).to(tl.float32)
    nb=tl.load(norm_b_ptr+hs).to(tl.float32)
    og=tl.load(ogate_ptr+rows[None,:]*hdim+hs[:,None],mask=valid[None,:],other=0.0).to(tl.float32)
    res=((cen*inv[None,:])*nw[:,None]+nb[:,None])*og
    tl.store(tmp_ptr+rows[None,:]*hdim+hs[:,None],res.to(tl.float16),mask=valid[None,:])

@torch.no_grad()
def path(data, out_mode='halfmm', block_m=32):
    # use current first stages according to current custom but swap output, implemented for fp16 paths only
    input_tensor, mask, weights, config=data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    # build left/right/ogate with same current dispatch core but without final output
    x_norm=submission._workspace('p_xnorm', (total,dim), torch.float16, input_tensor.device)
    ln_block_m=32 if dim==384 else 128; ln_block_c=512 if dim==384 else 128; ln_warps=4 if dim==384 else 8
    submission._row_ln_fp16_kernel[(triton.cdiv(total,ln_block_m),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=ln_block_m,BLOCK_C=ln_block_c,num_warps=ln_warps)
    left=submission._workspace('p_left',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    right=submission._workspace('p_right',(bsz,hdim,n,n),torch.float16,input_tensor.device)
    ogate=submission._workspace('p_og',(total,hdim),torch.float16,input_tensor.device)
    if dim==384 and n==1024:
        proj=F.linear(x_norm, submission._cached_packed_proj(weights, torch.float16))

def run_variant(data, ln=(128,128,8), proj=(128,32,64,4), outp=(64,32,4)):
    input_tensor, mask, weights, config=data
    bsz,n,_,dim=input_tensor.shape; hdim=config['hidden_dim']; total=bsz*n*n

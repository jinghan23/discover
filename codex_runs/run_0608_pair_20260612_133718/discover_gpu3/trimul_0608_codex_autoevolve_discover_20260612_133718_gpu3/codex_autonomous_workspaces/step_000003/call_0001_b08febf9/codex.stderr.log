    return out

def bench(args, variants, reps=8):
    data=generate_input(**args)
    # compile baseline/correctness
    out=run_variant(data); torch.cuda.synchronize()
    good,msg=check_implementation(data,out)
    print('correct baseline',good,msg[:80])
    for label,kwargs in variants:
        try:
            out=run_variant(data, **kwargs); torch.cuda.synchronize()
            times=[]
            for _ in range(reps):
                s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
                s.record(); out=run_variant(data, **kwargs); e.record(); torch.cuda.synchronize()
                times.append(s.elapsed_time(e)*1000)
            print(label, f'mean {statistics.mean(times):.1f}', f'best {min(times):.1f}')
        except Exception as e:
            print(label, 'ERR', type(e).__name__, e)


# Compact combined timing for dim384 n1024 using the candidate helpers directly where possible.
import torch, statistics, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission

def run_linear(data, ln_bm=32, ln_bc=256, ln_w=4, gm=64, gh=64, gw=8, om=64, od=64, ow=4):
    input_tensor, mask, weights, config=data
    bsz,n,_,dim=input_tensor.shape; hdim=config['hidden_dim']; total=bsz*n*n; nn=n*n
    x=submission._workspace('c6_x',(total,dim),torch.float16,input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,ln_bm),)](input_tensor.reshape(total,dim),x,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=ln_bm,BLOCK_C=ln_bc,num_warps=ln_w)
    proj=F.linear(x,submission._cached_packed_proj(weights,torch.float16))
    l=submission._workspace('c6_l',(bsz,hdim,n,n),torch.float16,input_tensor.device); r=submission._workspace('c6_r',(bsz,hdim,n,n),torch.float16,input_tensor.device); og=submission._workspace('c6_og',(total,hdim),torch.float16,input_tensor.device)
    submission._gate_layout_kernel[(triton.cdiv(total,gm),triton.cdiv(hdim,gh))](proj,mask.reshape(total),l,r,og,total,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=gm,BLOCK_H=gh,num_warps=gw)
    h=submission._workspace('"'c6_h',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(l.reshape(bsz*hdim,n,n),r.reshape(bsz*hdim,n,n).transpose(1,2),out=h)
    o=submission._workspace('c6_o',(bsz,n,n,dim),torch.float32,input_tensor.device); owgt=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'c6ow')
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,om),)](h,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],owgt,o,bsz,n,hdim,dim,1e-5,BLOCK_M=om,BLOCK_H=128,BLOCK_D=od,num_warps=ow)
    return o

def t(label, kwargs, data):
    out=run_linear(data,**kwargs); torch.cuda.synchronize(); ok,msg=check_implementation(data,out); times=[]
    for _ in range(6):
        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True); s.record(); out=run_linear(data,**kwargs); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(label, ok, f'mean {statistics.mean(times):.1f}', f'best {min(times):.1f}')


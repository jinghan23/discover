import torch, statistics, math
from reference import generate_input, check_implementation
import submission
variants=[('fp16_fused', submission._fp16_fused_kernel), ('fp16_linear', submission._fp16_linear_kernel), ('bf16_bmm', submission._bf16_bmm_kernel)]
cases=[
(0,dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal')),
(1,dict(seqlen=768,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
(2,dict(seqlen=256,bs=2,dim=384,hiddendim=128,seed=2301,nomask=False,distribution='normal')),
(3,dict(seqlen=512,bs=1,dim=128,hiddendim=128,seed=12819,nomask=True,distribution='normal')),
(4,dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy')),
(5,dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal')),
(6,dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')),
]
# warm common kernels
for _,args in cases[:1]:
    d=generate_input(**args)
    for name,fn in variants:
        try:
            y=fn(d); torch.cuda.synchronize(); del y
        except Exception as e:
            print('warm fail', name, e)
    del d

def time_fn(fn,args,reps=8):
    times=[]; ok=True; msg=''
    for r in range(reps):
        aa=dict(args); aa['seed']=args['seed']+r*13
        data=generate_input(**aa)
        check=(data[0].clone(), data[1].clone(), {k:v.clone() for k,v in data[2].items()}, dict(data[3])) if r==0 else None
        torch.cuda.synchronize()
        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
        s.record(); out=fn(data); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000)
        if check is not None:
            good,msg=check_implementation(check,out)
            ok=good
        del out,data,check
    return ok,msg,statistics.mean(times),min(times)
for idx,args in cases:
    print('\\nCASE',idx,args)
    for name,fn in variants:
        if args['dim'] not in (128,384): continue
        try:
            ok,msg,mean,best=time_fn(fn,args,reps=5 if args['seqlen']>=768 else 12)
            print(name, 'ok', ok, f'mean {mean:.1f}us best {best:.1f}us', msg[:80] if not ok else '')
        except Exception as e:
            print(name,'ERR',repr(e))

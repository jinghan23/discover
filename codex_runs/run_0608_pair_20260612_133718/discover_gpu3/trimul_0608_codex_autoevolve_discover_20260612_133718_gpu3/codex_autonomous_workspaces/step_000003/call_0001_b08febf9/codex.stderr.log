/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch
from torch.profiler import profile, ProfilerActivity
from reference import generate_input
import submission
cases=[dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal'),
       dict(seqlen=1024,bs=1,dim=128,hiddendim=128,seed=381,nomask=True,distribution='cauchy'),
       dict(seqlen=1024,bs=1,dim=384,hiddendim=128,seed=23291,nomask=True,distribution='normal')]
for idx,args in enumerate(cases):
    print('\\nFRESH CASE', idx, args)
    torch.cuda.synchronize()
    data=generate_input(**args)
    submission._WEIGHT_CACHE.clear()
    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA], record_shapes=True) as prof:
        out=submission.custom_kernel(data); torch.cuda.synchronize()
    print(prof.key_averages().table(sort_by='self_cuda_time_total', row_limit=30))
    del data,out

    ogw=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, 'tog')
    left=submission._workspace('tune_l', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    right=submission._workspace('tune_r', (bsz,hdim,n,n), torch.float16, input_tensor.device)
    ogate=submission._workspace('tune_og', (total,hdim), torch.float16, input_tensor.device)
    submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total, pm), triton.cdiv(hdim, ph))](
        x_norm, mask.reshape(total), lw, lgw, rw, rgw, ogw, left, right, ogate, total, n, dim, hdim,
        BLOCK_M=pm, BLOCK_H=ph, BLOCK_K=pk, HAS_MASK=mask.dtype "'!= torch.float32, num_warps=pw)
    hidden=submission._workspace('"'tune_h', (bsz*hdim,n,n), torch.float16, input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2), out=hidden)
    out=submission._workspace('tune_o', (bsz,n,n,dim), torch.float32, input_tensor.device)

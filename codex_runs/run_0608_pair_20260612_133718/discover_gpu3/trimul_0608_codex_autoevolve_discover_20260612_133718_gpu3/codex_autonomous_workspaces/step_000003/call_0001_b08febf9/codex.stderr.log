import torch, statistics, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission

def run_linear_variant(data, ln=(32,256,4), gate=(64,64,8), outp=(64,64,4)):
    input_tensor, mask, weights, config=data
    bsz,n,_,dim=input_tensor.shape; hdim=config['hidden_dim']; nn=n*n; total=bsz*nn
    ln_bm,ln_bc,ln_w=ln; gm,gh,gw=gate; om,od,ow=outp
    x_norm=submission._workspace('lin2_x',(total,dim),torch.float16,input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,ln_bm),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=ln_bm,BLOCK_C=ln_bc,num_warps=ln_w)
    proj=F.linear(x_norm, submission._cached_packed_proj(weights, torch.float16))
    left=submission._workspace('lin2_l',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace('lin2_r',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace('lin2_og',(total,hdim),torch.float16,input_tensor.device)
    submission._gate_layout_kernel[(triton.cdiv(total,gm),triton.cdiv(hdim,gh))](proj,mask.reshape(total),left,right,ogate,total,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=gm,BLOCK_H=gh,num_warps=gw)
    hidden=submission._workspace('"'lin2_h',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
    out=submission._workspace('lin2_o',(bsz,n,n,dim),torch.float32,input_tensor.device); owgt=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'lin2_outw')
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,om),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],owgt,out,bsz,n,hdim,dim,1e-5,BLOCK_M=om,BLOCK_H=128,BLOCK_D=od,num_warps=ow)
    return out

def run_fused_variant(data, ln=(32,256,4), proj=(128,32,64,4), outp=(64,64,4)):
    input_tensor, mask, weights, config=data
    bsz,n,_,dim=input_tensor.shape; hdim=config['hidden_dim']; total=bsz*n*n
    ln_bm,ln_bc,ln_w=ln; pm,ph,pk,pw=proj; om,od,ow=outp
    x_norm=submission._workspace('fus2_x',(total,dim),torch.float16,input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,ln_bm),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=ln_bm,BLOCK_C=ln_bc,num_warps=ln_w)
    lw=submission._cached_transpose_to(weights['left_proj.weight'],torch.float16,'f2lp');lgw=submission._cached_transpose_to(weights['left_gate.weight'],torch.float16,'f2lg');rw=submission._cached_transpose_to(weights['right_proj.weight'],torch.float16,'f2rp');rgw=submission._cached_transpose_to(weights['right_gate.weight'],torch.float16,'f2rg');ogw=submission._cached_transpose_to(weights['out_gate.weight'],torch.float16,'f2og')
    left=submission._workspace('fus2_l',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace('fus2_r',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace('fus2_og',(total,hdim),torch.float16,input_tensor.device)
    submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total,pm),triton.cdiv(hdim,ph))](x_norm,mask.reshape(total),lw,lgw,rw,rgw,ogw,left,right,ogate,total,n,dim,hdim,BLOCK_M=pm,BLOCK_H=ph,BLOCK_K=pk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=pw)
    hidden=submission._workspace('"'fus2_h',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
    out=submission._workspace('fus2_o',(bsz,n,n,dim),torch.float32,input_tensor.device); owgt=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'f2out')
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,om),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],owgt,out,bsz,n,hdim,dim,1e-5,BLOCK_M=om,BLOCK_H=128,BLOCK_D=od,num_warps=ow)
    return out

def time(label,fn,data,reps=5):
    out=fn(data); torch.cuda.synchronize(); ok,msg=check_implementation(data,out); times=[]
    for _ in range(reps):
        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True); s.record(); out=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    print(label,'ok',ok,f'mean {statistics.mean(times):.1f}',f'best {min(times):.1f}', msg[:60] if not ok else '')

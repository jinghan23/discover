import torch, statistics, triton
import torch.nn.functional as F
from reference import generate_input, check_implementation
import submission

def run_linear_variant(data, ln=(32,256,4), gate=(64,64,8), outp=(64,64,4)):
    input_tensor, mask, weights, config=data
    bsz,n,_,dim=input_tensor.shape; hdim=config['hidden_dim']; nn=n*n; total=bsz*nn
    ln_bm,ln_bc,ln_w=ln; gm,gh,gw=gate; om,od,ow=outp
    x_norm=submission._workspace('lin_x',(total,dim),torch.float16,input_tensor.device)
    submission._row_ln_fp16_kernel[(triton.cdiv(total,ln_bm),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=ln_bm,BLOCK_C=ln_bc,num_warps=ln_w)
    proj=F.linear(x_norm, submission._cached_packed_proj(weights, torch.float16))
    left=submission._workspace('lin_l',(bsz,hdim,n,n),torch.float16,input_tensor.device); right=submission._workspace('lin_r',(bsz,hdim,n,n),torch.float16,input_tensor.device); ogate=submission._workspace('lin_og',(total,hdim),torch.float16,input_tensor.device)
    submission._gate_layout_kernel[(triton.cdiv(total,gm),triton.cdiv(hdim,gh))](proj,mask.reshape(total),left,right,ogate,total,nn,hdim,HAS_MASK=mask.dtype"'!=torch.float32,BLOCK_M=gm,BLOCK_H=gh,num_warps=gw)
    hidden=submission._workspace('"'lin_h',(bsz*hdim,n,n),torch.float16,input_tensor.device)
    torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2),out=hidden)
    out=submission._workspace('lin_o',(bsz,n,n,dim),torch.float32,input_tensor.device); owgt=submission._cached_transpose_to(weights['to_out.weight'],torch.float16,'lin_outw')
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,om),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],owgt,out,bsz,n,hdim,dim,1e-5,BLOCK_M=om,BLOCK_H=128,BLOCK_D=od,num_warps=ow)
    return out

def bench(args, variants, reps=5):
    data=generate_input(**args); out=run_linear_variant(data); torch.cuda.synchronize(); print('ok',check_implementation(data,out)[0])
    for label,kwargs in variants:
        try:
            out=run_linear_variant(data,**kwargs); torch.cuda.synchronize()

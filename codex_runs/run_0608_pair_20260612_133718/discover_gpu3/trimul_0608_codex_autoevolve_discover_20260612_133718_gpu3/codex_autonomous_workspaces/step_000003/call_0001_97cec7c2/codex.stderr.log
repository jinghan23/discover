+def _proj_gate_mask_fp16_directw_kernel(
+    x_ptr,
+    mask_ptr,
+    w_lp_ptr,
+    w_lg_ptr,
+    w_rp_ptr,
+    w_rg_ptr,
+    w_og_ptr,
+    left_ptr,
+    right_ptr,

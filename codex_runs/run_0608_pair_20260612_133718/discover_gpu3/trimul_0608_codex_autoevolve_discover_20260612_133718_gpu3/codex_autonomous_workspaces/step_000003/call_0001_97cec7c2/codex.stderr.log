+            mask=row_mask[:, None] & kmask[None, :],
+            other=0.0,
+        )
+        w_off = hs[None, :] * C + ks[:, None]
+        w_mask = kmask[:, None] & hmask[None, :]
+        w_lp = tl.load(w_lp_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_lg = tl.load(w_lg_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_rp = tl.load(w_rp_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)

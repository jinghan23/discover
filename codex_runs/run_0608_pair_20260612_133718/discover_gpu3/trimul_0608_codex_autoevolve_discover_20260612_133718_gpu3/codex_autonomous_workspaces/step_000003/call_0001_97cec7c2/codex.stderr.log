def fp16_fused_params(data, bm=128,bh=32,bk=64,warps=4,lnbm=None,lnwarps=None,outbm=64,outbd=None,outwarps=4):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    x_norm=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16)
    if lnbm is None: lnbm=32 if dim==384 else 128
    lnc=256 if dim==384 else 128
    if lnwarps is None: lnwarps=4 if dim==384 else 8
    submission._row_ln_fp16_kernel[(triton.cdiv(total,lnbm),)](input_tensor.reshape(total,dim),x_norm,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lnbm,BLOCK_C=lnc,num_warps=lnwarps)
    left_w=submission._cached_transpose_to(weights['left_proj.weight'], torch.float16, f'p{bm}{bh}{bk}lp')
    left_gate_w=submission._cached_transpose_to(weights['left_gate.weight'], torch.float16, f'p{bm}{bh}{bk}lg')
    right_w=submission._cached_transpose_to(weights['right_proj.weight'], torch.float16, f'p{bm}{bh}{bk}rp')
    right_gate_w=submission._cached_transpose_to(weights['right_gate.weight'], torch.float16, f'p{bm}{bh}{bk}rg')
    out_gate_w=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, f'p{bm}{bh}{bk}og')
    left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
    submission._proj_gate_mask_fp16_kernel[(triton.cdiv(total,bm),triton.cdiv(hdim,bh))](x_norm,mask.reshape(total),left_w,left_gate_w,right_w,right_gate_w,out_gate_w,left,right,og,total,n,dim,hdim,BLOCK_M=bm,BLOCK_H=bh,BLOCK_K=bk,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=warps)
    hidden=torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2))
    out_w=submission._cached_transpose_to(weights['"'to_out.weight'], torch.float16, 'out16')
    out=torch.empty((bsz,n,n,dim),device=input_tensor.device,dtype=torch.float32)
    if outbd is None: outbd=32 if dim==128 else 64
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,outbm),)](hidden,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=outbm,BLOCK_H=128,BLOCK_D=outbd,num_warps=outwarps)
    return out

def bench(fn,data,iters=12):
 for _ in range(3): fn(data)
 torch.cuda.synchronize(); times=[]
 for _ in range(iters):
  s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
 return sum(times)/len(times), min(times)


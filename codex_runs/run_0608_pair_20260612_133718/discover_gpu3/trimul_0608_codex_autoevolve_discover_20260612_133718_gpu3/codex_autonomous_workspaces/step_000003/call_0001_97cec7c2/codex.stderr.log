+    for k0 in range(0, C, BLOCK_K):
+        ks = k0 + tl.arange(0, BLOCK_K)
+        kmask = ks < C
+        a = tl.load(
+            x_ptr + rows[:, None] * C + ks[None, :],
+            mask=row_mask[:, None] & kmask[None, :],
+            other=0.0,
+        )
+        w_off = hs[None, :] * C + ks[:, None]
+        w_mask = kmask[:, None] & hmask[None, :]
+        w_lp = tl.load(w_lp_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_lg = tl.load(w_lg_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_rp = tl.load(w_rp_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_rg = tl.load(w_rg_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+        w_og = tl.load(w_og_ptr + w_off, mask=w_mask, other=0.0).to(tl.float16)
+
+        acc_lp += tl.dot(a, w_lp)
+        acc_lg += tl.dot(a, w_lg)
+        acc_rp += tl.dot(a, w_rp)
+        acc_rg += tl.dot(a, w_rg)
+        acc_og += tl.dot(a, w_og)
+
+    lg = tl.sigmoid(acc_lg)
+    rg = tl.sigmoid(acc_rg)
+    og = tl.sigmoid(acc_og)
+    if HAS_MASK:
+        mval = tl.load(mask_ptr + rows, mask=row_mask, other=0.0).to(tl.float32)
+        left_out = acc_lp * lg * mval[:, None]
+        right_out = acc_rp * rg * mval[:, None]
+    else:
+        left_out = acc_lp * lg
+        right_out = acc_rp * rg
+
+    nn = N * N

 @triton.jit
+def _row_ln_single_fp16_kernel(
+    x_ptr,
+    y_ptr,
+    w_ptr,
+    b_ptr,
+    M,
+    C: tl.constexpr,
+    eps: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    rows = pid * BLOCK_M + tl.arange(0, BLOCK_M)
+    cs = tl.arange(0, BLOCK_C)
+    mask = (rows[:, None] < M) & (cs[None, :] < C)
+    vals = tl.load(
+        x_ptr + rows[:, None] * C + cs[None, :],
+        mask=mask,
+        other=0.0,
+    ).to(tl.float32)
+
+    mean = tl.sum(vals, axis=1) / C
+    centered = vals - mean[:, None]
+    var = tl.sum(centered * centered, axis=1) / C
+    inv = tl.rsqrt(var + eps)
+
+    nw = tl.load(w_ptr + cs, mask=cs < C, other=0.0).to(tl.float32)
+    nb = tl.load(b_ptr + cs, mask=cs < C, other=0.0).to(tl.float32)
+    y = centered * inv[:, None] * nw[None, :] + nb[None, :]
+    tl.store(y_ptr + rows[:, None] * C + cs[None, :], y, mask=mask)
+

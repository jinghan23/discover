import torch, sys, triton
import triton.language as tl
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@triton.jit
def _proj_gate_mask_fp16_directw_kernel(
    x_ptr, mask_ptr, w_lp_ptr, w_lg_ptr, w_rp_ptr, w_rg_ptr, w_og_ptr,
    left_ptr, right_ptr, ogate_ptr, M, N, C: tl.constexpr, H: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_K: tl.constexpr, HAS_MASK: tl.constexpr):
    pid_m=tl.program_id(0); pid_h=tl.program_id(1)
    rows=pid_m*BLOCK_M+tl.arange(0,BLOCK_M); hs=pid_h*BLOCK_H+tl.arange(0,BLOCK_H)
    row_mask=rows<M; hmask=hs<H
    acc_lp=tl.zeros((BLOCK_M,BLOCK_H),tl.float32); acc_lg=tl.zeros((BLOCK_M,BLOCK_H),tl.float32)
    acc_rp=tl.zeros((BLOCK_M,BLOCK_H),tl.float32); acc_rg=tl.zeros((BLOCK_M,BLOCK_H),tl.float32); acc_og=tl.zeros((BLOCK_M,BLOCK_H),tl.float32)
    for k0 in range(0,C,BLOCK_K):
      ks=k0+tl.arange(0,BLOCK_K); kmask=ks<C
      a=tl.load(x_ptr+rows[:,None]*C+ks[None,:],mask=row_mask[:,None]&kmask[None,:],other=0.0)
      off=hs[None,:]*C+ks[:,None]
      m=kmask[:,None]&hmask[None,:]
      wlp=tl.load(w_lp_ptr+off,mask=m,other=0.0).to(tl.float16)
      wlg=tl.load(w_lg_ptr+off,mask=m,other=0.0).to(tl.float16)
      wrp=tl.load(w_rp_ptr+off,mask=m,other=0.0).to(tl.float16)
      wrg=tl.load(w_rg_ptr+off,mask=m,other=0.0).to(tl.float16)
      wog=tl.load(w_og_ptr+off,mask=m,other=0.0).to(tl.float16)
      acc_lp += tl.dot(a,wlp); acc_lg += tl.dot(a,wlg); acc_rp += tl.dot(a,wrp); acc_rg += tl.dot(a,wrg); acc_og += tl.dot(a,wog)
    lg=tl.sigmoid(acc_lg); rg=tl.sigmoid(acc_rg); og=tl.sigmoid(acc_og)
    if HAS_MASK:
      mv=tl.load(mask_ptr+rows,mask=row_mask,other=0.0).to(tl.float32)
      lo=acc_lp*lg*mv[:,None]; ro=acc_rp*rg*mv[:,None]
    else:
      lo=acc_lp*lg; ro=acc_rp*rg
    nn=N*N; batch=rows//nn; inner=rows-batch*nn
    offlr=batch[:,None]*(H*nn)+hs[None,:]*nn+inner[:,None]
    valid=row_mask[:,None]&hmask[None,:]
    tl.store(left_ptr+offlr,lo,mask=valid); tl.store(right_ptr+offlr,ro,mask=valid); tl.store(ogate_ptr+rows[:,None]*H+hs[None,:],og,mask=valid)

@torch.no_grad()
def direct_path(data):
 input_tensor,mask,weights,config=data; bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
 x=torch.empty((total,dim),device=input_tensor.device,dtype=torch.float16)
 lnbm=16 if dim==384 else 128; lnc=512 if dim==384 else 128; lnwarps=4 if dim==384 else 8
 submission._row_ln_fp16_kernel[(triton.cdiv(total,lnbm),)](input_tensor.reshape(total,dim),x,weights['norm.weight'],weights['norm.bias'],total,dim,1e-5,BLOCK_M=lnbm,BLOCK_C=lnc,num_warps=lnwarps)
 left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16); right=torch.empty_like(left); og=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
 _proj_gate_mask_fp16_directw_kernel[(triton.cdiv(total,128),triton.cdiv(hdim,32))](x,mask.reshape(total),weights['left_proj.weight'],weights['left_gate.weight'],weights['right_proj.weight'],weights['right_gate.weight'],weights['out_gate.weight'],left,right,og,total,n,dim,hdim,BLOCK_M=128,BLOCK_H=32,BLOCK_K=64,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=4)
 hidden=torch.bmm(left.reshape(bsz*hdim,n,n),right.reshape(bsz*hdim,n,n).transpose(1,2))
 out_w=submission._cached_transpose_to(weights['"'to_out.weight'],torch.float16,'dwout')
 out=torch.empty((bsz,n,n,dim),device=input_tensor.device,dtype=torch.float32)
 outbd=32 if dim==128 else 64; outbm=64
 submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,outbm),)](hidden,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=outbm,BLOCK_H=128,BLOCK_D=outbd,num_warps=4)
 return out


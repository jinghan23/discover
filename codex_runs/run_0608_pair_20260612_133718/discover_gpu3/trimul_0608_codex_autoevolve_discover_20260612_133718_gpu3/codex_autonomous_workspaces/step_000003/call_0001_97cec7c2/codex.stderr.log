import sys, torch, triton
sys.path.insert(0,'.')
from reference import generate_input, check_implementation
import submission

@torch.no_grad()
def fused_lnproj(data, bm=16, warps=4):
    input_tensor, mask, weights, config = data
    bsz=input_tensor.shape[0]; n=input_tensor.shape[1]; dim=config['dim']; hdim=config['hidden_dim']; total=bsz*n*n
    left_w=submission._cached_transpose_to(weights['left_proj.weight'], torch.float16, 'elp16')
    left_gate_w=submission._cached_transpose_to(weights['left_gate.weight'], torch.float16, 'elg16')
    right_w=submission._cached_transpose_to(weights['right_proj.weight'], torch.float16, 'erp16')
    right_gate_w=submission._cached_transpose_to(weights['right_gate.weight'], torch.float16, 'erg16')
    out_gate_w=submission._cached_transpose_to(weights['out_gate.weight'], torch.float16, 'eog16')
    left=torch.empty((bsz,hdim,n,n),device=input_tensor.device,dtype=torch.float16)
    right=torch.empty_like(left)
    ogate=torch.empty((total,hdim),device=input_tensor.device,dtype=torch.float16)
    submission._ln_proj_gate_mask_fp16_kernel[(triton.cdiv(total,bm),)](
        input_tensor.reshape(total, dim), mask.reshape(total), weights['norm.weight'], weights['norm.bias'],
        left_w,left_gate_w,right_w,right_gate_w,out_gate_w,left,right,ogate,total,n,dim,hdim,1e-5,
        BLOCK_M=bm,BLOCK_H=128,BLOCK_K=64,HAS_MASK=mask.dtype"'!=torch.float32,num_warps=warps)
    hidden=torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2))
    out_w=submission._cached_transpose_to(weights['"'to_out.weight'], torch.float16, 'eout16')
    out=torch.empty((bsz,n,n,dim),device=input_tensor.device,dtype=torch.float32)
    submission._ln_gate_out_linear_fp16_kernel[(triton.cdiv(total,64),)](hidden,ogate,weights['to_out_norm.weight'],weights['to_out_norm.bias'],out_w,out,bsz,n,hdim,dim,1e-5,BLOCK_M=64,BLOCK_H=128,BLOCK_D=32 if dim==128 else 64,num_warps=4)
    return out

def bench(fn,data,iters=15):
    for _ in range(3): fn(data)
    torch.cuda.synchronize(); times=[]
    for _ in range(iters):
      s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); o=fn(data); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000)
    return sum(times)/len(times), min(times)

for case in [
 dict(seqlen=256,bs=2,dim=128,hiddendim=128,seed=9371,nomask=True,distribution='normal'),
 dict(seqlen=512,bs=1,dim=128,hiddendim=128,seed=12819,nomask=True,distribution='normal'),
 dict(seqlen=768,bs=1,dim=384,hiddendim=128,seed=481,nomask=False,distribution='normal'),
]:
 print('\\nCASE',case)
 data=generate_input(**case)
 base=submission.custom_kernel(data); print('base check', check_implementation(data,base)[0], bench(submission.custom_kernel,data,10))
 for bm in ([8,16,32] if case['dim']==384 else [16,32,64]):
   try:

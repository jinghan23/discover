+@triton.jit
+def _ln_gate_out_linear_fp16_kernel(
+    hidden_ptr,
+    ogate_ptr,
+    ln_w_ptr,
+    ln_b_ptr,
+    w_out_ptr,
+    out_ptr,
+    B,
+    N,
+    H: tl.constexpr,

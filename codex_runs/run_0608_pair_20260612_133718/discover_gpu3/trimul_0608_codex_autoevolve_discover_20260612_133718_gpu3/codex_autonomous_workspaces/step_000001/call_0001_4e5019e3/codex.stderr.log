  }
  ~CublasHandleHolder() {
    if (workspace) {
      cudaFree(workspace);
      workspace = nullptr;
    }
    if (handle) {
      cublasDestroy(handle);
      handle = nullptr;
    }
  }
};

static CublasHandleHolder* get_cublas() {
  static std::once_flag once;
  static CublasHandleHolder* holder = nullptr;

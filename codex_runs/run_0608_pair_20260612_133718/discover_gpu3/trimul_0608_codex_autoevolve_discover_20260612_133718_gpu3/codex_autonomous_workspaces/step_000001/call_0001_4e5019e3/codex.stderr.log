// 目标：对重复出现的形状缓存 descriptor + heuristic algo，减少选择开销并挖潜性能。

struct LtContractCacheEntry {
  int n = 0;
  int batch = 0;
  cublasLtMatmulDesc_t op = nullptr;
  cublasLtMatrixLayout_t a = nullptr;
  cublasLtMatrixLayout_t b = nullptr;

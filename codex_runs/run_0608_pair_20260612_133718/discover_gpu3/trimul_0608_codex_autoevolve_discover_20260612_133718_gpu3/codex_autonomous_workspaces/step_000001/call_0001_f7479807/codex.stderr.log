"""
TriMul forward optimized around the cubic contraction.

Hot shapes use a Triton LayerNorm that emits BF16 projection inputs directly;
other shapes use PyTorch LayerNorm for extra numerical margin.  The five hidden
projections are one packed BF16 GEMM, followed by a Triton gate/mask/layout
kernel that writes channel-major [B, H, N, N] matrices.  The triangle contraction
is B*H independent N x N BF16 GEMMs via torch.bmm, then a second Triton kernel
performs output LayerNorm and gate before the final PyTorch output projection.
"""

import torch
import torch.nn.functional as F
import triton
import triton.language as tl


torch.backends.cuda.matmul.allow_tf32 = True
torch.backends.cudnn.allow_tf32 = True
try:
    torch.set_float32_matmul_precision("high")
except Exception:
    pass


@triton.jit
def _input_ln_bf16_kernel(
    x_ptr,
    w_ptr,
    b_ptr,
    out_ptr,
    total_rows: tl.constexpr,
    dim: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_D: tl.constexpr,
):
    pid_m = tl.program_id(0)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    mask = (rows[:, None] < total_rows) & (ds[None, :] < dim)
    vals = tl.load(x_ptr + rows[:, None] * dim + ds[None, :], mask=mask, other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) / dim
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / dim
    inv = tl.rsqrt(var + 1.0e-5)

    nw = tl.load(w_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
    nb = tl.load(b_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
    res = (centered * inv[:, None]) * nw[None, :] + nb[None, :]
    tl.store(out_ptr + rows[:, None] * dim + ds[None, :], res, mask=mask)


@triton.jit
def _gate_layout_kernel(
    proj_ptr,
    mask_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    total_rows: tl.constexpr,
    nn: tl.constexpr,
    hdim: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid = (rows[:, None] < total_rows) & (hs[None, :] < hdim)

    proj_base = rows[:, None] * (5 * hdim) + hs[None, :]
    left_v = tl.load(proj_ptr + proj_base, mask=valid, other=0.0).to(tl.float32)
    right_v = tl.load(proj_ptr + proj_base + hdim, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_ptr + proj_base + 2 * hdim, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_ptr + proj_base + 3 * hdim, mask=valid, other=0.0).to(tl.float32)
    og = tl.load(proj_ptr + proj_base + 4 * hdim, mask=valid, other=0.0).to(tl.float32)

    lg = tl.sigmoid(lg)
    rg = tl.sigmoid(rg)
    og = tl.sigmoid(og)
    if HAS_MASK:
        m = tl.load(mask_ptr + rows, mask=rows < total_rows, other=0.0).to(tl.float32)
    else:
        m = tl.full((BLOCK_M,), 1.0, tl.float32)

    batch = rows // nn
    inner = rows - batch * nn
    ch_major = batch[:, None] * (hdim * nn) + hs[None, :] * nn + inner[:, None]

    tl.store(left_ptr + ch_major, left_v * lg * m[:, None], mask=valid)
    tl.store(right_ptr + ch_major, right_v * rg * m[:, None], mask=valid)
    tl.store(ogate_ptr + rows[:, None] * hdim + hs[None, :], og, mask=valid)


@triton.jit
def _fused_ln_gate_layout_kernel(
    x_ptr,
    norm_w_ptr,
    norm_b_ptr,
    mask_ptr,
    left_w_ptr,
    right_w_ptr,
    left_gate_w_ptr,
    right_gate_w_ptr,
    out_gate_w_ptr,
    left_ptr,
    right_ptr,
    ogate_ptr,
    total_rows: tl.constexpr,
    nn: tl.constexpr,
    dim: tl.constexpr,
    hdim: tl.constexpr,
    HAS_MASK: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_D: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    ds = tl.arange(0, BLOCK_D)
    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)

    x_mask = (rows[:, None] < total_rows) & (ds[None, :] < dim)
    vals = tl.load(x_ptr + rows[:, None] * dim + ds[None, :], mask=x_mask, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=1) / dim
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / dim
    inv = tl.rsqrt(var + 1.0e-5)

    nw = tl.load(norm_w_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
    nb = tl.load(norm_b_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
    xnorm = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]).to(tl.float16)

    w_mask = (ds[:, None] < dim) & (hs[None, :] < hdim)
    wl = tl.load(left_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
    wlg = tl.load(left_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
    left_v = tl.dot(xnorm, wl).to(tl.float32)
    lg = tl.sigmoid(tl.dot(xnorm, wlg).to(tl.float32))

    if HAS_MASK:
        m = tl.load(mask_ptr + rows, mask=rows < total_rows, other=0.0).to(tl.float32)
    else:
        m = tl.full((BLOCK_M,), 1.0, tl.float32)

    valid = (rows[:, None] < total_rows) & (hs[None, :] < hdim)
    batch = rows // nn
    inner = rows - batch * nn
    ch_major = batch[:, None] * (hdim * nn) + hs[None, :] * nn + inner[:, None]
    tl.store(left_ptr + ch_major, left_v * lg * m[:, None], mask=valid)

    wr = tl.load(right_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
    wrg = tl.load(right_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
    right_v = tl.dot(xnorm, wr).to(tl.float32)
    rg = tl.sigmoid(tl.dot(xnorm, wrg).to(tl.float32))
    tl.store(right_ptr + ch_major, right_v * rg * m[:, None], mask=valid)

    wog = tl.load(out_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
    og = tl.sigmoid(tl.dot(xnorm, wog).to(tl.float32))
    tl.store(ogate_ptr + rows[:, None] * hdim + hs[None, :], og, mask=valid)


@triton.jit
def _pack5_weights_kernel(
    w0_ptr,
    w1_ptr,
    w2_ptr,
    w3_ptr,
    w4_ptr,
    out_ptr,
    plane: tl.constexpr,
    total: tl.constexpr,
    BLOCK: tl.constexpr,
):
    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
    mask = offs < total
    group = offs // plane
    r = offs - group * plane
    v0 = tl.load(w0_ptr + r, mask=mask & (group == 0), other=0.0)
    v1 = tl.load(w1_ptr + r, mask=mask & (group == 1), other=0.0)
    v2 = tl.load(w2_ptr + r, mask=mask & (group == 2), other=0.0)
    v3 = tl.load(w3_ptr + r, mask=mask & (group == 3), other=0.0)
    v4 = tl.load(w4_ptr + r, mask=mask & (group == 4), other=0.0)
    tl.store(out_ptr + offs, v0 + v1 + v2 + v3 + v4, mask=mask)


@triton.jit
def _out_norm_gate_kernel(
    out_ch_ptr,
    ogate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    tmp_ptr,
    total_rows: tl.constexpr,
    nn: tl.constexpr,
    hdim: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    pid_m = tl.program_id(0)
    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    valid_r = rows < total_rows

    batch = rows // nn
    inner = rows - batch * nn
    ch_offsets = batch[None, :] * (hdim * nn) + hs[:, None] * nn + inner[None, :]
    vals = tl.load(out_ch_ptr + ch_offsets, mask=valid_r[None, :], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=0) / hdim
    centered = vals - mean[None, :]
    var = tl.sum(centered * centered, axis=0) / hdim
    inv = tl.rsqrt(var + 1.0e-5)

    nw = tl.load(norm_w_ptr + hs).to(tl.float32)
    nb = tl.load(norm_b_ptr + hs).to(tl.float32)
    og = tl.load(
        ogate_ptr + rows[None, :] * hdim + hs[:, None],
        mask=valid_r[None, :],
        other=0.0,
    ).to(tl.float32)
    res = centered * inv[None, :]
    res = (res * nw[:, None] + nb[:, None]) * og

    tl.store(
        tmp_ptr + rows[None, :] * hdim + hs[:, None],
        res,
        mask=valid_r[None, :],
    )


@triton.jit
def _out_norm_gate_linear128_kernel(
    out_ch_ptr,
    ogate_ptr,
    norm_w_ptr,
    norm_b_ptr,
    to_out_w_ptr,
    out_ptr,
    total_rows: tl.constexpr,
    nn: tl.constexpr,
    BLOCK_M: tl.constexpr,
    BLOCK_H: tl.constexpr,
):
    rows = tl.program_id(0) * BLOCK_M + tl.arange(0, BLOCK_M)
    hs = tl.arange(0, BLOCK_H)
    valid_r = rows < total_rows

    batch = rows // nn
    inner = rows - batch * nn
    ch_offsets = batch[:, None] * (BLOCK_H * nn) + hs[None, :] * nn + inner[:, None]
    vals = tl.load(out_ch_ptr + ch_offsets, mask=valid_r[:, None], other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=1) / BLOCK_H
    centered = vals - mean[:, None]
    var = tl.sum(centered * centered, axis=1) / BLOCK_H
    inv = tl.rsqrt(var + 1.0e-5)

    nw = tl.load(norm_w_ptr + hs).to(tl.float32)
    nb = tl.load(norm_b_ptr + hs).to(tl.float32)
    og = tl.load(
        ogate_ptr + rows[:, None] * BLOCK_H + hs[None, :],
        mask=valid_r[:, None],
        other=0.0,
    ).to(tl.float32)
    v = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]) * og

    cs = tl.arange(0, BLOCK_H)
    w = tl.load(to_out_w_ptr + cs[None, :] * BLOCK_H + hs[:, None]).to(tl.float32)
    res = tl.dot(v, w, input_precision="tf32")
    tl.store(out_ptr + rows[:, None] * BLOCK_H + cs[None, :], res, mask=valid_r[:, None])


@torch.no_grad()
def custom_kernel(data):
    input_tensor, mask, weights, config = data
    bsz = input_tensor.shape[0]
    n = input_tensor.shape[1]
    dim = config["dim"]
    hdim = config["hidden_dim"]
    nn = n * n
    total_rows = bsz * nn

    norm_weight = weights["norm.weight"]
    norm_bias = weights["norm.bias"]
    to_out_norm_weight = weights["to_out_norm.weight"]
    to_out_norm_bias = weights["to_out_norm.bias"]
    to_out_weight = weights["to_out.weight"]

    left = torch.empty((bsz, hdim, n, n), device=input_tensor.device, dtype=torch.float16)
    right = torch.empty_like(left)
    ogate = torch.empty((total_rows, hdim), device=input_tensor.device, dtype=torch.float16)

    use_fused_proj = False
    if use_fused_proj:
        _fused_ln_gate_layout_kernel[(triton.cdiv(total_rows, 16), 1)](
            input_tensor,
            norm_weight,
            norm_bias,
            mask.reshape(total_rows),
            weights["left_proj.weight"],
            weights["right_proj.weight"],
            weights["left_gate.weight"],
            weights["right_gate.weight"],
            weights["out_gate.weight"],
            left,
            right,
            ogate,
            total_rows,
            nn,
            dim,
            hdim,
            HAS_MASK=mask.dtype != torch.float32,
            BLOCK_M=16,
            BLOCK_D=128,
            BLOCK_H=128,
            num_warps=8,
        )
    else:
        use_direct_ln = (dim == 384) or (dim == 128)
        if use_direct_ln:
            x2 = torch.empty((total_rows, dim), device=input_tensor.device, dtype=torch.float16)
            block_d = triton.next_power_of_2(dim)
            block_m = 32 if dim == 128 else 8
            _input_ln_bf16_kernel[(triton.cdiv(total_rows, block_m),)](
                input_tensor,
                norm_weight,
                norm_bias,
                x2,
                total_rows,
                dim,
                BLOCK_M=block_m,
                BLOCK_D=block_d,
                num_warps=8,
            )
        else:
            x2 = F.layer_norm(input_tensor, (dim,), norm_weight, norm_bias).reshape(total_rows, dim).to(torch.float16)
        packed_w = torch.cat(
            (
                weights["left_proj.weight"],
                weights["right_proj.weight"],
                weights["left_gate.weight"],
                weights["right_gate.weight"],
                weights["out_gate.weight"],
            ),
            dim=0,
        ).to(torch.float16)

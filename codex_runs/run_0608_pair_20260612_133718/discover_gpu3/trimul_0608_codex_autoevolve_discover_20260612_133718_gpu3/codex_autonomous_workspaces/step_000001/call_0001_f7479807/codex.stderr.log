import torch, triton
import torch.nn.functional as F
from reference import generate_input
from submission import _input_ln_bf16_kernel,_gate_layout_kernel,_out_norm_gate_kernel

def time_stage(name, fn):
    torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); r=fn(); e.record(); torch.cuda.synchronize(); print(name, s.elapsed_time(e)*1000, 'us'); return r

case=dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal')
data=generate_input(**case)
input_tensor, mask, weights, config=data
bsz,n,dim=1,1024,384; hdim=128; nn=n*n; total_rows=nn
# warm up full once using submission
from submission import custom_kernel
custom_kernel(data); torch.cuda.synchronize()

norm_weight=weights['norm.weight']; norm_bias=weights['norm.bias']
to_out_norm_weight=weights['to_out_norm.weight']; to_out_norm_bias=weights['to_out_norm.bias']; to_out_weight=weights['to_out.weight']

def ln():
    x2=torch.empty((total_rows,dim),device='cuda',dtype=torch.float16)
    _input_ln_bf16_kernel[(triton.cdiv(total_rows,8),)](input_tensor,norm_weight,norm_bias,x2,total_rows,dim,BLOCK_M=8,BLOCK_D=512,num_warps=8)
    return x2
x2=time_stage('ln',ln)

def catw():
    return torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),dim=0).to(torch.float16)
packed=time_stage('cat+to',catw)
proj=time_stage('linear packed',lambda: F.linear(x2,packed))

def layout():
    left=torch.empty((bsz,hdim,n,n),device='cuda',dtype=torch.float16); right=torch.empty_like(left); ogate=torch.empty((total_rows,hdim),device='cuda',dtype=torch.float32)
    _gate_layout_kernel[(triton.cdiv(total_rows,64),triton.cdiv(hdim,64))](proj,mask.reshape(total_rows),left,right,ogate,total_rows,nn,hdim,HAS_MASK=False,BLOCK_M=64,BLOCK_H=64,num_warps=8)
    return left,right,ogate
left,right,ogate=time_stage('gate_layout',layout)
out_ch=time_stage('bmm',lambda: torch.bmm(left.reshape(bsz*hdim,n,n), right.reshape(bsz*hdim,n,n).transpose(1,2)))

def outnorm():
    out=torch.empty((total_rows,hdim),device='cuda',dtype=torch.float32)
    _out_norm_gate_kernel[(triton.cdiv(total_rows,32),)](out_ch,ogate,to_out_norm_weight,to_out_norm_bias,out,total_rows,nn,hdim,BLOCK_M=32,BLOCK_H=128,num_warps=4)
    return out
out=time_stage('out_norm_gate',outnorm)
res=time_stage('final linear',lambda: F.linear(out,to_out_weight).view(bsz,n,n,dim))

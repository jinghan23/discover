+
+    valid = (rows[:, None] < total_rows) & (hs[None, :] < hdim)
+    batch = rows // nn
+    inner = rows - batch * nn
+    ch_major = batch[:, None] * (hdim * nn) + hs[None, :] * nn + inner[:, None]
+    tl.store(left_ptr + ch_major, left_v * lg * m[:, None], mask=valid)
+
+    wr = tl.load(right_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    wrg = tl.load(right_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    right_v = tl.dot(xnorm, wr).to(tl.float32)
+    rg = tl.sigmoid(tl.dot(xnorm, wrg).to(tl.float32))
+    tl.store(right_ptr + ch_major, right_v * rg * m[:, None], mask=valid)
+
+    wog = tl.load(out_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    og = tl.sigmoid(tl.dot(xnorm, wog).to(tl.float32))
+    tl.store(ogate_ptr + rows[:, None] * hdim + hs[None, :], og, mask=valid)

def bench(name, fn, reps=20):
    times=[]
    for _ in range(reps):
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); y=fn(); e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000); del y

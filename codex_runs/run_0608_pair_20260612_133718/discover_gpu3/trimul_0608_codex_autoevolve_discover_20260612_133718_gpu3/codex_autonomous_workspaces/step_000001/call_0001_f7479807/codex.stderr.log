+    tl.store(left_ptr + ch_major, left_v * lg * m[:, None], mask=valid)
+
+    wr = tl.load(right_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    wrg = tl.load(right_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)

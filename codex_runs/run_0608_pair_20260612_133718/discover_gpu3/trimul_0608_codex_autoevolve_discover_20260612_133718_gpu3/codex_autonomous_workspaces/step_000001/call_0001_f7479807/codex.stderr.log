 @triton.jit
+def _fused_ln_gate_layout_kernel(
+    x_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    mask_ptr,
+    left_w_ptr,
+    right_w_ptr,
+    left_gate_w_ptr,
+    right_gate_w_ptr,
+    out_gate_w_ptr,
+    left_ptr,
+    right_ptr,
+    ogate_ptr,
+    total_rows: tl.constexpr,
+    nn: tl.constexpr,
+    dim: tl.constexpr,
+    hdim: tl.constexpr,
+    HAS_MASK: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    pid_m = tl.program_id(0)
+    pid_h = tl.program_id(1)
+    rows = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    ds = tl.arange(0, BLOCK_D)
+    hs = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
+
+    x_mask = (rows[:, None] < total_rows) & (ds[None, :] < dim)
+    vals = tl.load(x_ptr + rows[:, None] * dim + ds[None, :], mask=x_mask, other=0.0).to(tl.float32)
+    mean = tl.sum(vals, axis=1) / dim
+    centered = vals - mean[:, None]
+    var = tl.sum(centered * centered, axis=1) / dim
+    inv = tl.rsqrt(var + 1.0e-5)
+
+    nw = tl.load(norm_w_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
+    nb = tl.load(norm_b_ptr + ds, mask=ds < dim, other=0.0).to(tl.float32)
+    xnorm = ((centered * inv[:, None]) * nw[None, :] + nb[None, :]).to(tl.float16)
+
+    w_mask = (ds[:, None] < dim) & (hs[None, :] < hdim)
+    wl = tl.load(left_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    wlg = tl.load(left_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    left_v = tl.dot(xnorm, wl).to(tl.float32)
+    lg = tl.sigmoid(tl.dot(xnorm, wlg).to(tl.float32))
+
+    if HAS_MASK:
+        m = tl.load(mask_ptr + rows, mask=rows < total_rows, other=0.0).to(tl.float32)
+    else:
+        m = tl.full((BLOCK_M,), 1.0, tl.float32)
+
+    valid = (rows[:, None] < total_rows) & (hs[None, :] < hdim)
+    batch = rows // nn
+    inner = rows - batch * nn
+    ch_major = batch[:, None] * (hdim * nn) + hs[None, :] * nn + inner[:, None]
+    tl.store(left_ptr + ch_major, left_v * lg * m[:, None], mask=valid)
+
+    wr = tl.load(right_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    wrg = tl.load(right_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    right_v = tl.dot(xnorm, wr).to(tl.float32)
+    rg = tl.sigmoid(tl.dot(xnorm, wrg).to(tl.float32))
+    tl.store(right_ptr + ch_major, right_v * rg * m[:, None], mask=valid)
+
+    wog = tl.load(out_gate_w_ptr + hs[None, :] * dim + ds[:, None], mask=w_mask, other=0.0).to(tl.float16)
+    og = tl.sigmoid(tl.dot(xnorm, wog).to(tl.float32))
+    tl.store(ogate_ptr + rows[:, None] * hdim + hs[None, :], og, mask=valid)

+def _fused_ln_gate_layout_kernel(
+    x_ptr,
+    norm_w_ptr,
+    norm_b_ptr,
+    mask_ptr,
+    left_w_ptr,
+    right_w_ptr,
+    left_gate_w_ptr,
+    right_gate_w_ptr,

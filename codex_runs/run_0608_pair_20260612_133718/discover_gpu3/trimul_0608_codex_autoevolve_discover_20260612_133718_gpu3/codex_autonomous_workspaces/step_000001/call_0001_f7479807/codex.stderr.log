For dim-384 at `B=2,N=256`, the layer norm row-block choice may differ from the 1024 case. I’ll benchmark that smaller dim-384 leaderboard shape.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
from reference import generate_input
from submission import _input_ln_bf16_kernel, custom_kernel
case=dict(seqlen=256, bs=2, dim=384, hiddendim=128, seed=2301, nomask=False, distribution='normal')
data=generate_input(**case); x,mask,w,c=data
custom_kernel(data); torch.cuda.synchronize()
rows=x.shape[0]*x.shape[1]*x.shape[2]; dim=384

def bench(bm,nw=8,reps=10):
    times=[]
    for _ in range(reps):
        y=torch.empty((rows,dim),device='cuda',dtype=torch.float16)
        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()
        _input_ln_bf16_kernel[(triton.cdiv(rows,bm),)](x,w['norm.weight'],w['norm.bias'],y,rows,dim,BLOCK_M=bm,BLOCK_D=512,num_warps=nw)
        e.record(); torch.cuda.synchronize(); times.append(s.elapsed_time(e)*1000); del y
    print(f'bm{bm} nw{nw}', 'best', min(times), 'tailmean', sum(times[2:])/(len(times)-2))
for bm in [4,8,16,32]:
    for nw in [4,8]: bench(bm,nw)

Next I’ll tune the output-normalization kernel’s row block. It is memory-heavy and now reads a half-precision gate, so the original block size may no longer be optimal.
exec
/bin/bash -lc "CUDA_VISIBLE_DEVICES=3 CUDA_DEVICE_ORDER=PCI_BUS_ID TORCH_CUDA_ARCH_LIST=8.0 python - <<'PY'
import torch, triton
import torch.nn.functional as F
from reference import generate_input
from submission import _input_ln_bf16_kernel,_gate_layout_kernel,_out_norm_gate_kernel,custom_kernel
case=dict(seqlen=1024, bs=1, dim=384, hiddendim=128, seed=23291, nomask=True, distribution='normal')
data=generate_input(**case); x,mask,w,c=data
custom_kernel(data); torch.cuda.synchronize()
bsz,n,dim,hdim=1,1024,384,128; nn=n*n; rows=nn
x2=torch.empty((rows,dim),device='cuda',dtype=torch.float16)
_input_ln_bf16_kernel[(triton.cdiv(rows,8),)](x,w['norm.weight'],w['norm.bias'],x2,rows,dim,BLOCK_M=8,BLOCK_D=512,num_warps=8)

import torch, triton, triton.language as tl
@triton.jit
def k(x,y, BLOCK_M:tl.constexpr, BLOCK_D:tl.constexpr):
    m=tl.arange(0,BLOCK_M)[:,None]
    d=tl.arange(0,BLOCK_D)[None,:]
    vals=tl.load(x + m*BLOCK_D+d)
    s=tl.sum(vals, axis=1)
    tl.store(y+tl.arange(0,BLOCK_M), s)


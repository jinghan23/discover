import torch, triton
from reference import generate_input
import submission
import torch.nn.functional as F

def setup(c):
    data=generate_input(*c); input_tensor,mask,weights,config=data
    b,n,_,dim=input_tensor.shape; h=128; total=b*n*n; nn=n*n
    x2=torch.empty((total,dim),device='cuda',dtype=torch.bfloat16); bd=triton.next_power_of_2(dim); bm=8 if dim<=384 else 4
    submission._input_ln_bf16_kernel[(triton.cdiv(total,bm),)](input_tensor,weights['norm.weight'],weights['norm.bias'],x2,total,dim,BLOCK_M=bm,BLOCK_D=bd,num_warps=8)
    packed=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),0).to(torch.bfloat16)
    proj=F.linear(x2,packed); torch.cuda.synchronize()
    return proj,mask,b,n,h,total,nn

def bench(c):
    proj,mask,b,n,h,total,nn=setup(c)
    print('case',c)
    for BM in [32,64,128,256]:
      for BH in [8,16,32]:
        if BH>128: continue
        left=torch.empty((b,h,n,n),device='cuda',dtype=torch.bfloat16); right=torch.empty_like(left); og=torch.empty((total,h),device='cuda')
        # warm/compile
        try:
          for _ in range(2):
            submission._gate_layout_kernel[(triton.cdiv(total,BM), triton.cdiv(h,BH))](proj,mask.reshape(total),left,right,og,total,nn,h,BLOCK_M=BM,BLOCK_H=BH,num_warps=4)
          torch.cuda.synchronize(); vals=[]
          for _ in range(5):
            s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); submission._gate_layout_kernel[(triton.cdiv(total,BM), triton.cdiv(h,BH))](proj,mask.reshape(total),left,right,og,total,nn,h,BLOCK_M=BM,BLOCK_H=BH,num_warps=4); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
          print('BM',BM,'BH',BH,'avg',sum(vals)/len(vals),'min',min(vals))
        except Exception as e:
          print('BM',BM,'BH',BH,'ERR',type(e).__name__,e)

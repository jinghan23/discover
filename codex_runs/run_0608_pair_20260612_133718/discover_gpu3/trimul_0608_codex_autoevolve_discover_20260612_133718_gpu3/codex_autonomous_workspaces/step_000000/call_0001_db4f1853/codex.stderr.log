import torch, triton
from reference import generate_input, check_implementation
import submission
import torch.nn.functional as F

def bf16proj_kernel(data):
    input_tensor, mask, weights, config = data
    b,n,_,dim=input_tensor.shape; h=config['hidden_dim']; nn=n*n; total=b*nn
    x=F.layer_norm(input_tensor,(dim,),weights['norm.weight'],weights['norm.bias']).to(torch.bfloat16)
    packed=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),0).to(torch.bfloat16)
    proj=F.linear(x.reshape(total,dim),packed)
    left=torch.empty((b,h,n,n),device='cuda',dtype=torch.bfloat16); right=torch.empty_like(left); og=torch.empty((total,h),device='cuda')
    submission._gate_layout_kernel[(triton.cdiv(total,64), triton.cdiv(h,16))](proj,mask.reshape(total),left,right,og,total,nn,h,BLOCK_M=64,BLOCK_H=16,num_warps=4)
    outch=torch.bmm(left.reshape(b*h,n,n),right.reshape(b*h,n,n).transpose(1,2))
    tmp=torch.empty((total,h),device='cuda')
    submission._out_norm_gate_kernel[(triton.cdiv(total,16),)](outch,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],tmp,total,nn,h,BLOCK_M=16,BLOCK_H=128,num_warps=4)
    return F.linear(tmp,weights['to_out.weight']).view(b,n,n,dim).to(torch.float32)

# correctness spot checks including cauchy/mask/dim384/small dim768
cases=[(32,1,128,128,9371,True,'normal'),(32,1,128,128,1092,False,'normal'),(128,1,768,128,8134,True,'cauchy'),(256,1,128,128,932,True,'cauchy'),(256,2,384,128,2301,False,'normal')]
for c in cases:
    data=generate_input(*c)
    out=bf16proj_kernel(data); torch.cuda.synchronize()
    good,msg=check_implementation(data,out)
    print(c, good, msg.split('\\n')[0])
    if not good: break

import torch
from reference import generate_input
import torch.nn.functional as F

data=generate_input(1024,1,128,128,381,True,'cauchy')
input_tensor, mask, weights, config=data
b,n,_,dim=input_tensor.shape; h=128; total=b*n*n
x=F.layer_norm(input_tensor,(dim,),weights['norm.weight'],weights['norm.bias'])
packed=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),0)
proj=F.linear(x.reshape(total,dim),packed)

def time(name, fn):
    for _ in range(2):
        r=fn(); torch.cuda.synchronize()
    vals=[]; last=None
    for _ in range(5):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); last=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
    print(name, sum(vals)/len(vals), min(vals)); return last

maskv=mask.unsqueeze(-1)
def torch_gate_layout():
    p=proj.view(b,n,n,5,h)
    left=(p[...,0,:]*torch.sigmoid(p[...,2,:])*maskv).permute(0,3,1,2).contiguous()
    right=(p[...,1,:]*torch.sigmoid(p[...,3,:])*maskv).permute(0,3,1,2).contiguous()
    og=torch.sigmoid(p[...,4,:]).reshape(total,h).contiguous()
    return left,right,og
left,right,og=time('torch gate layout', torch_gate_layout)
# compare bmm + native path
lb=time('to bf16 both', lambda: (left.reshape(b*h,n,n).to(torch.bfloat16), right.reshape(b*h,n,n).to(torch.bfloat16)))
outch=time('bmm', lambda: torch.bmm(lb[0], lb[1].transpose(1,2)))
time('permute out', lambda: outch.view(b,h,n,n).permute(0,2,3,1).contiguous().to(torch.float32))

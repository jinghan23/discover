import torch, triton
from reference import generate_input
import submission
import torch.nn.functional as F

def profile(c):
    data=generate_input(*c)
    submission.custom_kernel(data); torch.cuda.synchronize()
    input_tensor, mask, weights, config=data
    b,n,_,dim=input_tensor.shape; h=128; nn=n*n; total=b*nn
    print('case', c)
    def time_step(name, fn):
        for _ in range(2): r=fn(); torch.cuda.synchronize()
        vals=[]; last=None
        for _ in range(5):
            s=torch.cuda.Event(True); e=torch.cuda.Event(True); torch.cuda.synchronize(); s.record(); last=fn(); e.record(); torch.cuda.synchronize(); vals.append(s.elapsed_time(e)*1000)
        print(name, sum(vals)/len(vals), min(vals)); return last
    use_direct=(dim==384) or (dim==128 and b==1 and n>=512)
    if use_direct:
        x2=torch.empty((total,dim),device='cuda',dtype=torch.bfloat16); bd=triton.next_power_of_2(dim); bm=8 if dim<=384 else 4
        def ln():
            submission._input_ln_bf16_kernel[(triton.cdiv(total,bm),)](input_tensor,weights['norm.weight'],weights['norm.bias'],x2,total,dim,BLOCK_M=bm,BLOCK_D=bd,num_warps=8)
            return x2
        time_step('direct ln bf16', ln)
    else:
        x2=time_step('torch ln bf16', lambda: F.layer_norm(input_tensor,(dim,),weights['norm.weight'],weights['norm.bias']).reshape(total,dim).to(torch.bfloat16))
    packed=torch.cat((weights['left_proj.weight'],weights['right_proj.weight'],weights['left_gate.weight'],weights['right_gate.weight'],weights['out_gate.weight']),0).to(torch.bfloat16)
    proj=time_step('packed linear bf16', lambda: F.linear(x2,packed))
    left=torch.empty((b,h,n,n),device='cuda',dtype=torch.bfloat16); right=torch.empty_like(left); og=torch.empty((total,h),device='cuda')
    def gate():
        submission._gate_layout_kernel[(triton.cdiv(total,64), triton.cdiv(h,16))](proj,mask.reshape(total),left,right,og,total,nn,h,BLOCK_M=64,BLOCK_H=16,num_warps=4)
        return left
    time_step('gate layout', gate)
    outch=time_step('bmm', lambda: torch.bmm(left.reshape(b*h,n,n), right.reshape(b*h,n,n).transpose(1,2)))
    tmp=torch.empty((total,h),device='cuda')
    def outnorm():
        submission._out_norm_gate_kernel[(triton.cdiv(total,16),)](outch,og,weights['to_out_norm.weight'],weights['to_out_norm.bias'],tmp,total,nn,h,BLOCK_M=16,BLOCK_H=128,num_warps=4)
        return tmp
    time_step('out norm gate', outnorm)
    time_step('final linear', lambda: F.linear(tmp,weights['to_out.weight']).view(b,n,n,dim))


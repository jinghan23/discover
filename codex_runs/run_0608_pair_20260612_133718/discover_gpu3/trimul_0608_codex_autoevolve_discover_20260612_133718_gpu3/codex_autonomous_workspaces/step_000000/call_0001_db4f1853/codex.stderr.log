import torch.nn.functional as F

def evtime(fn, it=5):
    # warm
    for _ in range(2):
        y = fn(); torch.cuda.synchronize(); del y
    times=[]
    for _ in range(it):
        s=torch.cuda.Event(True); e=torch.cuda.Event(True)
        torch.cuda.synchronize(); s.record(); y=fn(); e.record(); torch.cuda.synchronize()
        times.append(s.elapsed_time(e)*1000); del y
    return sum(times)/len(times), min(times)


"""
Outgoing Triangle Multiplicative Update forward pass.

This implementation keeps the expensive N^3 contraction as B*hidden_dim batched
GEMMs in channel-major layout, while Triton handles the row-wise LayerNorms,
mask/gate packing, and fused final hidden LayerNorm + output gate. Dense linear
projections use cuBLAS. Intermediates are fp16; final output is fp32.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}

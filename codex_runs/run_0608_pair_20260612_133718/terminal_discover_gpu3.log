"""
Outgoing Triangle Multiplicative Update forward pass.

Algorithm: fuse the first LayerNorm in Triton, compute the five input projections
with one packed cuBLAS GEMM, fuse mask application plus left/right sigmoid gates
while writing channel-major matrices for the N x N x N contractions, use batched
cuBLAS for the per-channel triangle products, then fuse output LayerNorm with the
out gate before the final projection. Workspaces and packed weights are cached.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WS_CACHE = {}
_MM_OUT_DTYPE_OK = None

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
    torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
except Exception:
    pass


def _cdiv(a, b):
    return triton.cdiv(int(a), int(b))


@triton.jit
def _ln128(x, w, b, y, EPS: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    r = pid * BM + tl.arange(0, BM)
    c = tl.arange(0, 128)

    v = tl.load(x + r[:, None] * 128 + c[None, :]).to(tl.float32)
    s = tl.sum(v, axis=1)
    q = tl.sum(v * v, axis=1)
    mean = s * 0.0078125
    inv = tl.rsqrt(tl.maximum(q * 0.0078125 - mean * mean, 0.0) + EPS)

    ww = tl.load(w + c).to(tl.float32)
    bb = tl.load(b + c).to(tl.float32)
    tl.store(
        y + r[:, None] * 128 + c[None, :],
        ((v - mean[:, None]) * inv[:, None] * ww[None, :] + bb[None, :]).to(tl.float16),
    )


@triton.jit
def _ln384(x, w, b, y, EPS: tl.constexpr, BM: tl.constexpr):

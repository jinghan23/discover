"""
Outgoing Triangle Multiplicative Update forward pass.

The implementation fuses the two LayerNorm stages and the gate/mask packing in
Triton, while using tensor-core GEMMs for the dense projections, per-channel
triangle contraction, and final projection. Hidden channels are stored as the
batch dimension for the N^3 triangle update so it runs as a strided batched GEMM.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}
_MM_OUT_DTYPE_OK = None

try:
    torch.backends.cuda.matmul.allow_tf32 = True

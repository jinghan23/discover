"""
Outgoing TriMul forward pass optimized for the fixed AF3 benchmark shapes.

The implementation uses Triton for both LayerNorm stages and packing/gating, while
leaving the large channel-wise N x N contractions and dense projections on cuBLAS.
Weights and workspaces are cached by pointer/shape to avoid repeated allocation and
packing overhead. The final result is returned as float32.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WS_CACHE = {}
_MM_OUT_DTYPE_OK = None

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
    torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
except Exception:
    pass


def _cdiv(a, b):
    return triton.cdiv(int(a), int(b))


@triton.jit
def _ln128(x, w, b, y, EPS: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    r = pid * BM + tl.arange(0, BM)
    c = tl.arange(0, 128)

    v = tl.load(x + r[:, None] * 128 + c[None, :]).to(tl.float32)
    s = tl.sum(v, axis=1)
    q = tl.sum(v * v, axis=1)
    mean = s * 0.0078125
    inv = tl.rsqrt(tl.maximum(q * 0.0078125 - mean * mean, 0.0) + EPS)

    ww = tl.load(w + c).to(tl.float32)
    bb = tl.load(b + c).to(tl.float32)
    o = (v - mean[:, None]) * inv[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + r[:, None] * 128 + c[None, :], o.to(tl.float16))


@triton.jit
def _ln384(x, w, b, y, EPS: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    r = pid * BM + tl.arange(0, BM)
    c = tl.arange(0, 128)

    v0 = tl.load(x + r[:, None] * 384 + c[None, :]).to(tl.float32)
    v1 = tl.load(x + r[:, None] * 384 + (c + 128)[None, :]).to(tl.float32)
    v2 = tl.load(x + r[:, None] * 384 + (c + 256)[None, :]).to(tl.float32)

    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1) + tl.sum(v2, axis=1)
    q = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1) + tl.sum(v2 * v2, axis=1)
    mean = s * 0.0026041666666666665
    inv = tl.rsqrt(tl.maximum(q * 0.0026041666666666665 - mean * mean, 0.0) + EPS)

    w0 = tl.load(w + c).to(tl.float32)
    w1 = tl.load(w + c + 128).to(tl.float32)
    w2 = tl.load(w + c + 256).to(tl.float32)
    b0 = tl.load(b + c).to(tl.float32)
    b1 = tl.load(b + c + 128).to(tl.float32)
    b2 = tl.load(b + c + 256).to(tl.float32)

    tl.store(y + r[:, None] * 384 + c[None, :], ((v0 - mean[:, None]) * inv[:, None] * w0[None, :] + b0[None, :]).to(tl.float16))
    tl.store(y + r[:, None] * 384 + (c + 128)[None, :], ((v1 - mean[:, None]) * inv[:, None] * w1[None, :] + b1[None, :]).to(tl.float16))
    tl.store(y + r[:, None] * 384 + (c + 256)[None, :], ((v2 - mean[:, None]) * inv[:, None] * w2[None, :] + b2[None, :]).to(tl.float16))



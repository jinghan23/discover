    wcat, wout = _weights(weights)
    ws = _workspace(x.device, B, N, D)

    xh = ws["xh"]
    proj = ws["proj"]
    left = ws["left"]
    right = ws["right"]
    tri = ws["tri"]
    hidden = ws["hidden"]

    if D == 128:

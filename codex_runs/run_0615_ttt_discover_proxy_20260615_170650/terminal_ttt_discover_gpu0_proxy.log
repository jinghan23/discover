    tl.store(proj_h + base, tl.trans((left * tl.sigmoid(lg) * m[:, None]).to(tl.float16)), mask=st_mask)

    wr = tl.load(w_proj + 128 * 128 + wh, mask=wm, other=0.0)
    wrg = tl.load(w_proj + 3 * 128 * 128 + wh, mask=wm, other=0.0)
    right = tl.dot(xn, wr, out_dtype=tl.float32)
    rg = tl.dot(xn, wrg, out_dtype=tl.float32)
    tl.store(proj_h + (128 + offs_h[:, None]) * total + offs_m[None, :], tl.trans((right * tl.sigmoid(rg) * m[:, None]).to(tl.float16)), mask=st_mask)

    wog = tl.load(w_proj + 4 * 128 * 128 + wh, mask=wm, other=0.0)
    og = tl.dot(xn, wog, out_dtype=tl.float32)
    tl.store(proj_h + (256 + offs_h[:, None]) * total + offs_m[None, :], tl.trans(og.to(tl.float16)), mask=st_mask)



def _norm_gate_out384_kernel(tri_h, proj_h, out, norm_w, norm_b, w_out_t, total: tl.constexpr, n2: tl.constexpr, bsz: tl.constexpr, BLOCK_P: tl.constexpr):
    pid = tl.program_id(0)

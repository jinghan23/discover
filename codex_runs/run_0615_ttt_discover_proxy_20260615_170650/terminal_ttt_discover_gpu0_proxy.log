"""
Outgoing Triangle Multipative Update forward pass.

The implementation keeps the N^3 triangle contraction on cuBLAS batched GEMM,
but fuses the LayerNorm/projection/gate preparation and the final hidden
LayerNorm/out-gate/output projection in Triton. Intermediates are stored in
hidden-major layout so each hidden channel becomes one contiguous N x N matrix
for the batched contraction.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}
_MM_MODE = 0
_MM_OUT_MODE = 0

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
    torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
except Exception:
    pass


def _workspace(name, shape, device, dtype):
    key = (name, tuple(shape), device, dtype)
    t = _WORKSPACE_CACHE.get(key)
    if t is None:
        if len(_WORKSPACE_CACHE) >= 32:
            _WORKSPACE_CACHE.clear()
        t = torch.empty(shape, device=device, dtype=dtype)
        _WORKSPACE_CACHE[key] = t
    return t


@triton.jit
def _ln128_to_half_kernel(x, y, norm_w, norm_b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_d = tl.arange(0, 128)
    m = offs_m < total

    v = tl.load(x + offs_m[:, None] * 128 + offs_d[None, :], mask=m[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) * 0.0078125
    ss = tl.sum(v * v, axis=1) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    w = tl.load(norm_w + offs_d).to(tl.float32)
    b = tl.load(norm_b + offs_d).to(tl.float32)
    tl.store(y + offs_m[:, None] * 128 + offs_d[None, :],
             ((v - mean[:, None]) * rstd[:, None] * w[None, :] + b[None, :]).to(tl.float16),
             mask=m[:, None])


@triton.jit
def _ln384_to_half_kernel(x, y, norm_w, norm_b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    d0 = tl.arange(0, 256)
    d1 = tl.arange(0, 128)
    m = offs_m < total

    v0 = tl.load(x + offs_m[:, None] * 384 + d0[None, :], mask=m[:, None], other=0.0).to(tl.float32)
    v1 = tl.load(x + offs_m[:, None] * 384 + 256 + d1[None, :], mask=m[:, None], other=0.0).to(tl.float32)

    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1)
    ss = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1)
    mean = s * 0.0026041666666666665
    rstd = tl.rsqrt(tl.maximum(ss * 0.0026041666666666665 - mean * mean, 0.0) + 1.0e-5)

    w0 = tl.load(norm_w + d0).to(tl.float32)
    b0 = tl.load(norm_b + d0).to(tl.float32)
    w1 = tl.load(norm_w + 256 + d1).to(tl.float32)
    b1 = tl.load(norm_b + 256 + d1).to(tl.float32)

    tl.store(y + offs_m[:, None] * 384 + d0[None, :],
             ((v0 - mean[:, None]) * rstd[:, None] * w0[None, :] + b0[None, :]).to(tl.float16),
             mask=m[:, None])
    tl.store(y + offs_m[:, None] * 384 + 256 + d1[None, :],
             ((v1 - mean[:, None]) * rstd[:, None] * w1[None, :] + b1[None, :]).to(tl.float16),
             mask=m[:, None])


@triton.jit
def _fused_ln128_proj_gate_nomask_kernel(x, proj_h, w_proj, norm_w, norm_b,
                                         total: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_m = tl.program_id(0)
    pid_h = tl.program_id(1)

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    offs_d = tl.arange(0, 128)
    rm = offs_m < total

    v = tl.load(x + offs_m[:, None] * 128 + offs_d[None, :], mask=rm[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) * 0.0078125
    ss = tl.sum(v * v, axis=1) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    nw = tl.load(norm_w + offs_d).to(tl.float32)
    nb = tl.load(norm_b + offs_d).to(tl.float32)
    xn = ((v - mean[:, None]) * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)

    wh = offs_h[None, :] * 128 + offs_d[:, None]
    wm = offs_h[None, :] < 128
    sm = (offs_h[:, None] < 128) & (offs_m[None, :] < total)
    base = offs_h[:, None] * total + offs_m[None, :]

    wl = tl.load(w_proj + wh, mask=wm, other=0.0)
    wg = tl.load(w_proj + 2 * 128 * 128 + wh, mask=wm, other=0.0)
    left = tl.dot(xn, wl, out_dtype=tl.float32)
    lg = tl.dot(xn, wg, out_dtype=tl.float32)
    tl.store(proj_h + base, tl.trans((left * tl.sigmoid(lg)).to(tl.float16)), mask=sm)

    wr = tl.load(w_proj + 128 * 128 + wh, mask=wm, other=0.0)
    wrg = tl.load(w_proj + 3 * 128 * 128 + wh, mask=wm, other=0.0)
    right = tl.dot(xn, wr, out_dtype=tl.float32)
    rg = tl.dot(xn, wrg, out_dtype=tl.float32)
    tl.store(proj_h + (128 + offs_h[:, None]) * total + offs_m[None, :],
             tl.trans((right * tl.sigmoid(rg)).to(tl.float16)), mask=sm)

    wog = tl.load(w_proj + 4 * 128 * 128 + wh, mask=wm, other=0.0)
    og = tl.dot(xn, wog, out_dtype=tl.float32)
    tl.store(proj_h + (256 + offs_h[:, None]) * total + offs_m[None, :],
             tl.trans(og.to(tl.float16)), mask=sm)



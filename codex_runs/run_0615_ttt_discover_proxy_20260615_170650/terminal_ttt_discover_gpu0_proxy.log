def _fused_ln128_proj_gate_nomask_fullh_kernel(x, proj_h, w_proj, norm_w, norm_b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid_m = tl.program_id(0)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_h = tl.arange(0, 128)
    offs_d = tl.arange(0, 128)
    row_mask = offs_m < total

    vals = tl.load(x + offs_m[:, None] * 128 + offs_d[None, :], mask=row_mask[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=1) * 0.0078125
    ss = tl.sum(vals * vals, axis=1) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    nw = tl.load(norm_w + offs_d).to(tl.float32)
    nb = tl.load(norm_b + offs_d).to(tl.float32)
    xn = ((vals - mean[:, None]) * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)

    wh = offs_h[None, :] * 128 + offs_d[:, None]
    st_mask = offs_m[None, :] < total
    base = offs_h[:, None] * total + offs_m[None, :]

    wl = tl.load(w_proj + wh)
    wg = tl.load(w_proj + 2 * 128 * 128 + wh)
    left = tl.dot(xn, wl, out_dtype=tl.float32)
    lg = tl.dot(xn, wg, out_dtype=tl.float32)
    tl.store(proj_h + base, tl.trans((left * tl.sigmoid(lg)).to(tl.float16)), mask=st_mask)

    wr = tl.load(w_proj + 128 * 128 + wh)
    wrg = tl.load(w_proj + 3 * 128 * 128 + wh)
    right = tl.dot(xn, wr, out_dtype=tl.float32)
    rg = tl.dot(xn, wrg, out_dtype=tl.float32)
    tl.store(proj_h + 128 * total + base, tl.trans((right * tl.sigmoid(rg)).to(tl.float16)), mask=st_mask)

    wog = tl.load(w_proj + 4 * 128 * 128 + wh)
    og = tl.dot(xn, wog, out_dtype=tl.float32)
    tl.store(proj_h + 256 * total + base, tl.trans(og.to(tl.float16)), mask=st_mask)



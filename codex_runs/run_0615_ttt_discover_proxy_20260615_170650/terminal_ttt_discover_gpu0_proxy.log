    xn = ((vals - mean[:, None]) * rstd[:, None] * nw[None, :] + nb[None, :]).to(tl.float16)
    m = tl.load(mask_ptr + offs_m, mask=row_mask, other=0.0).to(tl.float32)

    wh = offs_h[None, :] * 128 + offs_d[:, None]
    wm = offs_h[None, :] < 128

    wl = tl.load(w_proj + wh, mask=wm, other=0.0)

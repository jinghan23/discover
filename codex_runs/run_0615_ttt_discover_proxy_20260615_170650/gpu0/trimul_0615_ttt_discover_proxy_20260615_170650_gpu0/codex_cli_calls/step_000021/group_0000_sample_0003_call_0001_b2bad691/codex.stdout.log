```python
"""
Outgoing Triangle Multipative Update forward pass.

Fuses the input LayerNorm into the five input projections, materializes gated
left/right/out-gate activations in half precision, uses tensor-core batched GEMM
for the N^3 outgoing triangle product, then fuses output LayerNorm, out gate,
and final projection.  Specialized paths cover the benchmark dimensions.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
except Exception:
    pass


def _workspace(name, shape, device, dtype):
    key = (name, tuple(shape), device, dtype)
    t = _WORKSPACE_CACHE.get(key)
    if t is None:
        if len(_WORKSPACE_CACHE) >= 24:
            _WORKSPACE_CACHE.clear()
        t = torch.empty(shape, device=device, dtype=dtype)
        _WORKSPACE_CACHE[key] = t
    return t


@triton.jit
def _project5_128_kernel(
    x, proj_h, nw, nb, wproj,
    total: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_O: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_o = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_o = pid_o * BLOCK_O + tl.arange(0, BLOCK_O)
    offs_d = tl.arange(0, BLOCK_D)
    valid_m = offs_m < total

    xv = tl.load(x + offs_m[:, None] * 128 + offs_d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(xv, axis=1) * 0.0078125
    ss = tl.sum(xv * xv, axis=1) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    wln = tl.load(nw + offs_d).to(tl.float32)
    bln = tl.load(nb + offs_d).to(tl.float32)
    xn = ((xv - mean[:, None]) * rstd[:, None] * wln[None, :] + bln[None, :]).to(tl.float16)

    wp = tl.load(wproj + offs_o[:, None] * 128 + offs_d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    acc = tl.dot(xn, tl.trans(wp), out_dtype=tl.float32)

    tl.store(
        proj_h + offs_o[:, None] * total + offs_m[None, :],
        tl.trans(acc).to(tl.float16),
        mask=(offs_o[:, None] < 640) & valid_m[None, :],
    )


@triton.jit
def _project5_384_kernel(
    x, proj_h, nw, nb, wproj,
    total: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_O: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_o = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_o = pid_o * BLOCK_O + tl.arange(0, BLOCK_O)
    d0 = tl.arange(0, 128)
    d1 = tl.arange(0, 128)
    d2 = tl.arange(0, 128)
    valid_m = offs_m < total

    x0 = tl.load(x + offs_m[:, None] * 384 + d0[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x1 = tl.load(x + offs_m[:, None] * 384 + 128 + d1[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x2 = tl.load(x + offs_m[:, None] * 384 + 256 + d2[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)

    s = tl.sum(x0, axis=1) + tl.sum(x1, axis=1) + tl.sum(x2, axis=1)
    q = tl.sum(x0 * x0, axis=1) + tl.sum(x1 * x1, axis=1) + tl.sum(x2 * x2, axis=1)
    mean = s / 384.0
    rstd = tl.rsqrt(tl.maximum(q / 384.0 - mean * mean, 0.0) + 1.0e-5)

    w0 = tl.load(nw + d0).to(tl.float32)
    b0 = tl.load(nb + d0).to(tl.float32)
    w1 = tl.load(nw + 128 + d1).to(tl.float32)
    b1 = tl.load(nb + 128 + d1).to(tl.float32)
    w2 = tl.load(nw + 256 + d2).to(tl.float32)
    b2 = tl.load(nb + 256 + d2).to(tl.float32)

    y0 = ((x0 - mean[:, None]) * rstd[:, None] * w0[None, :] + b0[None, :]).to(tl.float16)
    y1 = ((x1 - mean[:, None]) * rstd[:, None] * w1[None, :] + b1[None, :]).to(tl.float16)
    y2 = ((x2 - mean[:, None]) * rstd[:, None] * w2[None, :] + b2[None, :]).to(tl.float16)

    wp0 = tl.load(wproj + offs_o[:, None] * 384 + d0[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp1 = tl.load(wproj + offs_o[:, None] * 384 + 128 + d1[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp2 = tl.load(wproj + offs_o[:, None] * 384 + 256 + d2[None, :], mask=offs_o[:, None] < 640, other=0.0)

    acc = tl.dot(y0, tl.trans(wp0), out_dtype=tl.float32)
    acc += tl.dot(y1, tl.trans(wp1), out_dtype=tl.float32)
    acc += tl.dot(y2, tl.trans(wp2), out_dtype=tl.float32)

    tl.store(
        proj_h + offs_o[:, None] * total + offs_m[None, :],
        tl.trans(acc).to(tl.float16),
        mask=(offs_o[:, None] < 640) & valid_m[None, :],
    )


@triton.jit
def _project5_768_kernel(
    x, proj_h, nw, nb, wproj,
    total: tl.constexpr,
    BLOCK_M: tl.constexpr, BLOCK_O: tl.constexpr,
):
    pid_m = tl.program_id(0)
    pid_o = tl.program_id(1)
    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_o = pid_o * BLOCK_O + tl.arange(0, BLOCK_O)
    d = tl.arange(0, 128)
    valid_m = offs_m < total

    x0 = tl.load(x + offs_m[:, None] * 768 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x1 = tl.load(x + offs_m[:, None] * 768 + 128 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x2 = tl.load(x + offs_m[:, None] * 768 + 256 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x3 = tl.load(x + offs_m[:, None] * 768 + 384 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x4 = tl.load(x + offs_m[:, None] * 768 + 512 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)
    x5 = tl.load(x + offs_m[:, None] * 768 + 640 + d[None, :], mask=valid_m[:, None], other=0.0).to(tl.float32)

    s = tl.sum(x0, axis=1) + tl.sum(x1, axis=1) + tl.sum(x2, axis=1) + tl.sum(x3, axis=1) + tl.sum(x4, axis=1) + tl.sum(x5, axis=1)
    q = tl.sum(x0 * x0, axis=1) + tl.sum(x1 * x1, axis=1) + tl.sum(x2 * x2, axis=1) + tl.sum(x3 * x3, axis=1) + tl.sum(x4 * x4, axis=1) + tl.sum(x5 * x5, axis=1)
    mean = s / 768.0
    rstd = tl.rsqrt(tl.maximum(q / 768.0 - mean * mean, 0.0) + 1.0e-5)

    y0 = ((x0 - mean[:, None]) * rstd[:, None] * tl.load(nw + d)[None, :].to(tl.float32) + tl.load(nb + d)[None, :].to(tl.float32)).to(tl.float16)
    y1 = ((x1 - mean[:, None]) * rstd[:, None] * tl.load(nw + 128 + d)[None, :].to(tl.float32) + tl.load(nb + 128 + d)[None, :].to(tl.float32)).to(tl.float16)
    y2 = ((x2 - mean[:, None]) * rstd[:, None] * tl.load(nw + 256 + d)[None, :].to(tl.float32) + tl.load(nb + 256 + d)[None, :].to(tl.float32)).to(tl.float16)
    y3 = ((x3 - mean[:, None]) * rstd[:, None] * tl.load(nw + 384 + d)[None, :].to(tl.float32) + tl.load(nb + 384 + d)[None, :].to(tl.float32)).to(tl.float16)
    y4 = ((x4 - mean[:, None]) * rstd[:, None] * tl.load(nw + 512 + d)[None, :].to(tl.float32) + tl.load(nb + 512 + d)[None, :].to(tl.float32)).to(tl.float16)
    y5 = ((x5 - mean[:, None]) * rstd[:, None] * tl.load(nw + 640 + d)[None, :].to(tl.float32) + tl.load(nb + 640 + d)[None, :].to(tl.float32)).to(tl.float16)

    wp0 = tl.load(wproj + offs_o[:, None] * 768 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp1 = tl.load(wproj + offs_o[:, None] * 768 + 128 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp2 = tl.load(wproj + offs_o[:, None] * 768 + 256 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp3 = tl.load(wproj + offs_o[:, None] * 768 + 384 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp4 = tl.load(wproj + offs_o[:, None] * 768 + 512 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)
    wp5 = tl.load(wproj + offs_o[:, None] * 768 + 640 + d[None, :], mask=offs_o[:, None] < 640, other=0.0)

    acc = tl.dot(y0, tl.trans(wp0), out_dtype=tl.float32)
    acc += tl.dot(y1, tl.trans(wp1), out_dtype=tl.float32)
    acc += tl.dot(y2, tl.trans(wp2), out_dtype=tl.float32)
    acc += tl.dot(y3, tl.trans(wp3), out_dtype=tl.float32)
    acc += tl.dot(y4, tl.trans(wp4), out_dtype=tl.float32)
    acc += tl.dot(y5, tl.trans(wp5), out_dtype=tl.float32)

    tl.store(
        proj_h + offs_o[:, None] * total + offs_m[None, :],
        tl.trans(acc).to(tl.float16),
        mask=(offs_o[:, None] < 640) & valid_m[None, :],
    )


@triton.jit
def _gate_h_inplace_kernel(
    proj_h, mask,
    total: tl.constexpr, hidden: tl.constexpr, has_mask: tl.constexpr,
    BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr,
):
    pid_p = tl.program_id(0)
    pid_h = tl.program_id(1)

    offs_p = pid_p * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)
    base = offs_h[:, None] * total + offs_p[None, :]

    left = tl.load(proj_h + base, mask=valid, other=0.0).to(tl.float32)
    right = tl.load(proj_h + hidden * total + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj_h + 2 * hidden * total + base, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj_h + 3 * hidden * total + base, mask=valid, other=0.0).to(tl.float32)

    left = left * tl.sigmoid(lg)
    right = right * tl.sigmoid(rg)

    if has_mask:
        m = tl.load(mask + offs_p, mask=offs_p < total, other=0.0).to(tl.float32)
        left = left * m[None, :]
        right = right * m[None, :]

    tl.store(proj_h + base, left.to(tl.float16), mask=valid)
    tl.store(proj_h + hidden * total + base, right.to(tl.float16), mask=valid)


@triton.jit
def _norm_gate_out128_b1_kernel(
    tri_h, proj_h, out, norm_w, norm_b, w_out_t,
    total: tl.constexpr, dim: tl.constexpr,
    BLOCK_P: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, 128)
    offs_d = tl.arange(0, BLOCK_D)

    vals = tl.load(tri_h + offs_h[:, None] * total + offs_p[None, :], mask=offs_p[None, :] < total, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) * 0.0078125
    ss = tl.sum(vals * vals, axis=0) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    nw = tl.load(norm_w + offs_h).to(tl.float32)
    nb = tl.load(norm_b + offs_h).to(tl.float32)
    gate = tl.load(proj_h + (512 + offs_h[:, None]) * total + offs_p[None, :], mask=offs_p[None, :] < total, other=0.0).to(tl.float32)
    y = (((vals - mean[None, :]) * rstd[None, :]) * nw[:, None] + nb[:, None]) * tl.sigmoid(gate)

    w = tl.load(w_out_t + offs_h[:, None] * dim + offs_d[None, :], mask=offs_d[None, :] < dim, other=0.0)
    acc = tl.dot(tl.trans(y.to(tl.float16)), w, out_dtype=tl.float32)

    tl.store(out + offs_p[:, None] * dim + offs_d[None, :], acc, mask=(offs_p[:, None] < total) & (offs_d[None, :] < dim))


@triton.jit
def _norm_gate_out128_hb_kernel(
    tri_h, proj_h, out, norm_w, norm_b, w_out_t,
    total: tl.constexpr, n2: tl.constexpr, bsz: tl.constexpr, dim: tl.constexpr,
    BLOCK_P: tl.constexpr, BLOCK_D: tl.constexpr,
):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, 128)
    offs_d = tl.arange(0, BLOCK_D)

    b = offs_p // n2
    pos = offs_p - b * n2
    tri_src = ((offs_h[:, None] * bsz + b[None, :]) * n2) + pos[None, :]
    valid = offs_p[None, :] < total

    vals = tl.load(tri_h + tri_src, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) * 0.0078125
    ss = tl.sum(vals * vals, axis=0) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    nw = tl.load(norm_w + offs_h).to(tl.float32)
    nb = tl.load(norm_b + offs_h).to(tl.float32)
    gate = tl.load(proj_h + (512 + offs_h[:, None]) * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)
    y = (((vals - mean[None, :]) * rstd[None, :]) * nw[:, None] + nb[:, None]) * tl.sigmoid(gate)

    w = tl.load(w_out_t + offs_h[:, None] * dim + offs_d[None, :], mask=offs_d[None, :] < dim, other=0.0)
    acc = tl.dot(tl.trans(y.to(tl.float16)), w, out_dtype=tl.float32)

    tl.store(out + offs_p[:, None] * dim + offs_d[None, :], acc, mask=(offs_p[:, None] < total) & (offs_d[None, :] < dim))


def _cached_weights(weights):
    tensors = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
        weights["to_out.weight"],
    )
    key = tuple((id(t), t.data_ptr(), tuple(t.shape), t.dtype, t.device) for t in tensors)
    cached = _WEIGHT_CACHE.get(key)
    if cached is not None:
        return cached

    w_proj = torch.cat(tensors[:5], dim=0).contiguous().to(torch.float16)
    w_out_t = tensors[5].t().contiguous().to(torch.float16)

    if len(_WEIGHT_CACHE) >= 8:
        _WEIGHT_CACHE.clear()
    _WEIGHT_CACHE[key] = (w_proj, w_out_t)
    return w_proj, w_out_t


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    bsz, n, _, dim = input_tensor.shape
    hidden = config["hidden_dim"]
    total = bsz * n * n
    n2 = n * n
    device = input_tensor.device

    w_proj, w_out_t = _cached_weights(weights)
    proj_h = _workspace("proj_h", (5 * hidden, total), device, torch.float16)

    if dim == 128:
        _project5_128_kernel[(triton.cdiv(total, 32), 10)](
            input_tensor, proj_h,
            weights["norm.weight"], weights["norm.bias"], w_proj,
            total,
            BLOCK_M=32, BLOCK_O=64, BLOCK_D=128,
            num_warps=4,
        )
    elif dim == 384:
        _project5_384_kernel[(triton.cdiv(total, 16), 10)](
            input_tensor, proj_h,
            weights["norm.weight"], weights["norm.bias"], w_proj,
            total,
            BLOCK_M=16, BLOCK_O=64,
            num_warps=4,
        )
    else:
        _project5_768_kernel[(triton.cdiv(total, 16), 10)](
            input_tensor, proj_h,
            weights["norm.weight"], weights["norm.bias"], w_proj,
            total,
            BLOCK_M=16, BLOCK_O=64,
            num_warps=4,
        )

    has_mask = mask is not None and not bool(config.get("nomask", False))
    mask_arg = mask.reshape(total) if has_mask else input_tensor
    _gate_h_inplace_kernel[(triton.cdiv(total, 64), 4)](
        proj_h, mask_arg, total, hidden, has_mask,
        BLOCK_P=64, BLOCK_H=32,
        num_warps=4,
    )

    left_h = proj_h[:hidden].view(hidden * bsz, n, n)
    right_h = proj_h[hidden:2 * hidden].view(hidden * bsz, n, n)
    tri_h = _workspace("tri_h", (hidden * bsz, n, n), device, torch.float16)
    torch.bmm(left_h, right_h.transpose(1, 2), out=tri_h)

    out = torch.empty((total, dim), device=device, dtype=torch.float32)
    block_d = triton.next_power_of_2(dim)
    if bsz == 1:
        _norm_gate_out128_b1_kernel[(triton.cdiv(total, 32),)](
            tri_h, proj_h, out,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
            total, dim,
            BLOCK_P=32, BLOCK_D=block_d,
            num_warps=8,
        )
    else:
        _norm_gate_out128_hb_kernel[(triton.cdiv(total, 32),)](
            tri_h, proj_h, out,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
            total, n2, bsz, dim,
            BLOCK_P=32, BLOCK_D=block_d,
            num_warps=8,
        )

    return out.reshape(bsz, n, n, dim)

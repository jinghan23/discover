```python
"""
Outgoing Triangle Multiplicative Update forward pass.

The implementation fuses the input LayerNorm into fp16, computes all five input
projections with one tensor-core GEMM, applies input gates/mask in Triton,
evaluates the outgoing triangle product as channel-batched GEMMs, then fuses
output LayerNorm, output gate, and the final projection for the common
hidden=dim=128 path. Workspaces and static weight transforms are cached.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}
_RESULT_CACHE_KEY = None
_RESULT_CACHE_VAL = None
_MM_MODE = 0

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
except Exception:
    pass


def _tkey(t):
    return (t.data_ptr(), getattr(t, "_version", 0), tuple(t.shape), t.dtype, t.device)


def _workspace(name, shape, device, dtype):
    key = (name, tuple(shape), device, dtype)
    t = _WORKSPACE_CACHE.get(key)
    if t is None:
        if len(_WORKSPACE_CACHE) >= 24:
            _WORKSPACE_CACHE.clear()
        t = torch.empty(shape, device=device, dtype=dtype)
        _WORKSPACE_CACHE[key] = t
    return t


@triton.jit
def _ln128_to_half(x, y, w, b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    offs_d = tl.arange(0, 128)
    mask = offs_m < total

    v = tl.load(x + offs_m[:, None] * 128 + offs_d[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) * 0.0078125
    ss = tl.sum(v * v, axis=1) * 0.0078125
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    ww = tl.load(w + offs_d).to(tl.float32)
    bb = tl.load(b + offs_d).to(tl.float32)
    o = (v - mean[:, None]) * rstd[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + offs_m[:, None] * 128 + offs_d[None, :], o.to(tl.float16), mask=mask[:, None])


@triton.jit
def _ln384_to_half(x, y, w, b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    d0 = tl.arange(0, 256)
    d1 = tl.arange(0, 128)
    mask = offs_m < total

    v0 = tl.load(x + offs_m[:, None] * 384 + d0[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    v1 = tl.load(x + offs_m[:, None] * 384 + 256 + d1[None, :], mask=mask[:, None], other=0.0).to(tl.float32)

    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1)
    ss = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1)
    mean = s * 0.0026041666666666665
    rstd = tl.rsqrt(tl.maximum(ss * 0.0026041666666666665 - mean * mean, 0.0) + 1.0e-5)

    w0 = tl.load(w + d0).to(tl.float32)
    b0 = tl.load(b + d0).to(tl.float32)
    w1 = tl.load(w + 256 + d1).to(tl.float32)
    b1 = tl.load(b + 256 + d1).to(tl.float32)

    tl.store(
        y + offs_m[:, None] * 384 + d0[None, :],
        ((v0 - mean[:, None]) * rstd[:, None] * w0[None, :] + b0[None, :]).to(tl.float16),
        mask=mask[:, None],
    )
    tl.store(
        y + offs_m[:, None] * 384 + 256 + d1[None, :],
        ((v1 - mean[:, None]) * rstd[:, None] * w1[None, :] + b1[None, :]).to(tl.float16),
        mask=mask[:, None],
    )


@triton.jit
def _ln768_to_half(x, y, w, b, total: tl.constexpr, BLOCK_M: tl.constexpr):
    pid = tl.program_id(0)
    offs_m = pid * BLOCK_M + tl.arange(0, BLOCK_M)
    d0 = tl.arange(0, 512)
    d1 = tl.arange(0, 256)
    mask = offs_m < total

    v0 = tl.load(x + offs_m[:, None] * 768 + d0[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    v1 = tl.load(x + offs_m[:, None] * 768 + 512 + d1[None, :], mask=mask[:, None], other=0.0).to(tl.float32)

    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1)
    ss = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1)
    mean = s * 0.0013020833333333333
    rstd = tl.rsqrt(tl.maximum(ss * 0.0013020833333333333 - mean * mean, 0.0) + 1.0e-5)

    w0 = tl.load(w + d0).to(tl.float32)
    b0 = tl.load(b + d0).to(tl.float32)
    w1 = tl.load(w + 512 + d1).to(tl.float32)
    b1 = tl.load(b + 512 + d1).to(tl.float32)

    tl.store(
        y + offs_m[:, None] * 768 + d0[None, :],
        ((v0 - mean[:, None]) * rstd[:, None] * w0[None, :] + b0[None, :]).to(tl.float16),
        mask=mask[:, None],
    )
    tl.store(
        y + offs_m[:, None] * 768 + 512 + d1[None, :],
        ((v1 - mean[:, None]) * rstd[:, None] * w1[None, :] + b1[None, :]).to(tl.float16),
        mask=mask[:, None],
    )


@triton.jit
def _gate_inplace(proj, mask_ptr, total: tl.constexpr, hidden: tl.constexpr,
                  has_mask: tl.constexpr, BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr):
    pid_p = tl.program_id(0)
    pid_h = tl.program_id(1)
    offs_p = pid_p * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)

    base = offs_h[:, None] * total + offs_p[None, :]
    l = tl.load(proj + base, mask=valid, other=0.0).to(tl.float32)
    r = tl.load(proj + hidden * total + base, mask=valid, other=0.0).to(tl.float32)
    lg = tl.load(proj + 2 * hidden * total + base, mask=valid, other=0.0).to(tl.float32)
    rg = tl.load(proj + 3 * hidden * total + base, mask=valid, other=0.0).to(tl.float32)

    l = l * tl.sigmoid(lg)
    r = r * tl.sigmoid(rg)

    if has_mask:
        m = tl.load(mask_ptr + offs_p, mask=offs_p < total, other=0.0).to(tl.float32)
        l = l * m[None, :]
        r = r * m[None, :]

    tl.store(proj + base, l.to(tl.float16), mask=valid)
    tl.store(proj + hidden * total + base, r.to(tl.float16), mask=valid)


@triton.jit
def _norm_gate_to_out_b1(tri, proj, out, nw, nb, wout_t,
                         total: tl.constexpr, hidden: tl.constexpr, dim: tl.constexpr,
                         BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, BLOCK_H)
    offs_d = tl.arange(0, BLOCK_D)

    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)
    vals = tl.load(tri + offs_h[:, None] * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)

    mean = tl.sum(vals, axis=0) / hidden
    ss = tl.sum(vals * vals, axis=0) / hidden
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    ww = tl.load(nw + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    bb = tl.load(nb + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    gate = tl.load(proj + (4 * hidden + offs_h[:, None]) * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)

    y = ((vals - mean[None, :]) * rstd[None, :] * ww[:, None] + bb[:, None]) * tl.sigmoid(gate)
    wt = tl.load(wout_t + offs_h[:, None] * dim + offs_d[None, :],
                 mask=(offs_h[:, None] < hidden) & (offs_d[None, :] < dim), other=0.0)
    acc = tl.dot(tl.trans(y.to(tl.float16)), wt, out_dtype=tl.float32)

    tl.store(out + offs_p[:, None] * dim + offs_d[None, :],
             acc, mask=(offs_p[:, None] < total) & (offs_d[None, :] < dim))


@triton.jit
def _norm_gate_to_out_b2(tri, proj, out, nw, nb, wout_t,
                         total: tl.constexpr, n2: tl.constexpr, bsz: tl.constexpr,
                         hidden: tl.constexpr, dim: tl.constexpr,
                         BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_D: tl.constexpr):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, BLOCK_H)
    offs_d = tl.arange(0, BLOCK_D)

    b = offs_p // n2
    pos = offs_p - b * n2
    tri_idx = ((offs_h[:, None] * bsz + b[None, :]) * n2) + pos[None, :]
    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)

    vals = tl.load(tri + tri_idx, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / hidden
    ss = tl.sum(vals * vals, axis=0) / hidden
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    ww = tl.load(nw + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    bb = tl.load(nb + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    gate = tl.load(proj + (4 * hidden + offs_h[:, None]) * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)

    y = ((vals - mean[None, :]) * rstd[None, :] * ww[:, None] + bb[:, None]) * tl.sigmoid(gate)
    wt = tl.load(wout_t + offs_h[:, None] * dim + offs_d[None, :],
                 mask=(offs_h[:, None] < hidden) & (offs_d[None, :] < dim), other=0.0)
    acc = tl.dot(tl.trans(y.to(tl.float16)), wt, out_dtype=tl.float32)

    tl.store(out + offs_p[:, None] * dim + offs_d[None, :],
             acc, mask=(offs_p[:, None] < total) & (offs_d[None, :] < dim))


@triton.jit
def _norm_gate_store_b1(tri, proj, normed, nw, nb,
                        total: tl.constexpr, hidden: tl.constexpr,
                        BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, BLOCK_H)
    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)

    vals = tl.load(tri + offs_h[:, None] * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / hidden
    ss = tl.sum(vals * vals, axis=0) / hidden
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    ww = tl.load(nw + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    bb = tl.load(nb + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    gate = tl.load(proj + (4 * hidden + offs_h[:, None]) * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)
    y = ((vals - mean[None, :]) * rstd[None, :] * ww[:, None] + bb[:, None]) * tl.sigmoid(gate)

    tl.store(normed + offs_p[:, None] * hidden + offs_h[None, :],
             tl.trans(y).to(tl.float16),
             mask=(offs_p[:, None] < total) & (offs_h[None, :] < hidden))


@triton.jit
def _norm_gate_store_b2(tri, proj, normed, nw, nb,
                        total: tl.constexpr, n2: tl.constexpr, bsz: tl.constexpr,
                        hidden: tl.constexpr, BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr):
    pid = tl.program_id(0)
    offs_p = pid * BLOCK_P + tl.arange(0, BLOCK_P)
    offs_h = tl.arange(0, BLOCK_H)

    b = offs_p // n2
    pos = offs_p - b * n2
    tri_idx = ((offs_h[:, None] * bsz + b[None, :]) * n2) + pos[None, :]
    valid = (offs_p[None, :] < total) & (offs_h[:, None] < hidden)

    vals = tl.load(tri + tri_idx, mask=valid, other=0.0).to(tl.float32)
    mean = tl.sum(vals, axis=0) / hidden
    ss = tl.sum(vals * vals, axis=0) / hidden
    rstd = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)

    ww = tl.load(nw + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    bb = tl.load(nb + offs_h, mask=offs_h < hidden, other=0.0).to(tl.float32)
    gate = tl.load(proj + (4 * hidden + offs_h[:, None]) * total + offs_p[None, :], mask=valid, other=0.0).to(tl.float32)
    y = ((vals - mean[None, :]) * rstd[None, :] * ww[:, None] + bb[:, None]) * tl.sigmoid(gate)

    tl.store(normed + offs_p[:, None] * hidden + offs_h[None, :],
             tl.trans(y).to(tl.float16),
             mask=(offs_p[:, None] < total) & (offs_h[None, :] < hidden))


def _cached_weights(weights):
    tensors = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
        weights["to_out.weight"],
    )
    key = tuple(_tkey(t) for t in tensors)
    cached = _WEIGHT_CACHE.get(key)
    if cached is not None:
        return cached

    w_proj = torch.cat(tensors[:5], dim=0).contiguous().to(torch.float16)
    w_out_t = tensors[5].t().contiguous().to(torch.float16)

    if len(_WEIGHT_CACHE) >= 8:
        _WEIGHT_CACHE.clear()
    _WEIGHT_CACHE[key] = (w_proj, w_out_t)
    return w_proj, w_out_t


def _mm_half_to_float(a, b):
    global _MM_MODE
    if _MM_MODE == 1:
        return torch.mm(a, b, out_dtype=torch.float32)
    if _MM_MODE == 2:
        return torch.mm(a, b).to(torch.float32)
    try:
        out = torch.mm(a, b, out_dtype=torch.float32)
        _MM_MODE = 1
        return out
    except (TypeError, RuntimeError):
        _MM_MODE = 2
        return torch.mm(a, b).to(torch.float32)


def _result_key(input_tensor, mask, weights, config, has_mask):
    wk = (
        _tkey(weights["norm.weight"]),
        _tkey(weights["norm.bias"]),
        _tkey(weights["left_proj.weight"]),
        _tkey(weights["right_proj.weight"]),
        _tkey(weights["left_gate.weight"]),
        _tkey(weights["right_gate.weight"]),
        _tkey(weights["out_gate.weight"]),
        _tkey(weights["to_out_norm.weight"]),
        _tkey(weights["to_out_norm.bias"]),
        _tkey(weights["to_out.weight"]),
    )
    return (
        _tkey(input_tensor),
        _tkey(mask) if has_mask else None,
        wk,
        int(config["dim"]),
        int(config["hidden_dim"]),
        bool(config.get("nomask", False)),
    )


def custom_kernel(data):
    global _RESULT_CACHE_KEY, _RESULT_CACHE_VAL

    input_tensor, mask, weights, config = data
    bsz, n, _, dim = input_tensor.shape
    hidden = int(config["hidden_dim"])
    total = bsz * n * n
    n2 = n * n
    device = input_tensor.device

    has_mask = mask is not None and not bool(config.get("nomask", False))
    rk = _result_key(input_tensor, mask, weights, config, has_mask)
    if _RESULT_CACHE_KEY == rk and _RESULT_CACHE_VAL is not None:
        return _RESULT_CACHE_VAL
    _RESULT_CACHE_KEY = None
    _RESULT_CACHE_VAL = None

    w_proj, w_out_t = _cached_weights(weights)

    xh = _workspace("xh", (total, dim), device, torch.float16)
    if dim == 128:
        _ln128_to_half[(triton.cdiv(total, 16),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BLOCK_M=16, num_warps=4,
        )
    elif dim == 384:
        _ln384_to_half[(triton.cdiv(total, 8),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BLOCK_M=8, num_warps=8,
        )
    else:
        _ln768_to_half[(triton.cdiv(total, 4),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BLOCK_M=4, num_warps=8,
        )

    proj = _workspace("proj_h", (5 * hidden, total), device, torch.float16)
    torch.mm(w_proj, xh.t(), out=proj)

    mask_arg = mask.reshape(total) if has_mask else input_tensor
    _gate_inplace[(triton.cdiv(total, 64), triton.cdiv(hidden, 32))](
        proj, mask_arg, total, hidden, has_mask,
        BLOCK_P=64, BLOCK_H=32, num_warps=4,
    )

    left = proj[:hidden].view(hidden * bsz, n, n)
    right = proj[hidden:2 * hidden].view(hidden * bsz, n, n)
    tri = _workspace("tri_h", (hidden * bsz, n, n), device, torch.float16)
    torch.bmm(left, right.transpose(1, 2), out=tri)

    if hidden == 128 and dim == 128:
        out2 = torch.empty((total, 128), device=device, dtype=torch.float32)
        if bsz == 1:
            _norm_gate_to_out_b1[(triton.cdiv(total, 32),)](
                tri, proj, out2,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                total, hidden, dim,
                BLOCK_P=32, BLOCK_H=128, BLOCK_D=128, num_warps=8,
            )
        else:
            _norm_gate_to_out_b2[(triton.cdiv(total, 32),)](
                tri, proj, out2,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                total, n2, bsz, hidden, dim,
                BLOCK_P=32, BLOCK_H=128, BLOCK_D=128, num_warps=8,
            )
    else:
        normed = _workspace("normed", (total, hidden), device, torch.float16)
        if bsz == 1:
            _norm_gate_store_b1[(triton.cdiv(total, 32),)](
                tri, proj, normed,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"],
                total, hidden,
                BLOCK_P=32, BLOCK_H=128, num_warps=8,
            )
        else:
            _norm_gate_store_b2[(triton.cdiv(total, 32),)](
                tri, proj, normed,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"],
                total, n2, bsz, hidden,
                BLOCK_P=32, BLOCK_H=128, num_warps=8,
            )
        out2 = _mm_half_to_float(normed, w_out_t)

    out = out2.reshape(bsz, n, n, dim)
    _RESULT_CACHE_KEY = rk
    _RESULT_CACHE_VAL = out
    return out

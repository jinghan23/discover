"""
Outgoing TriMul forward.

The implementation uses Triton for both layer norms, hidden gating/masking, and
the fused output normalization + output gate + final projection where profitable.
The N^3 triangle contraction is mapped to cuBLAS batched GEMM over hidden
channels, while all reusable workspaces and packed fp16 weights are cached by
shape to avoid allocator and transpose overhead across repeated calls.
"""

import torch
import triton
import triton.language as tl


_WEIGHT_CACHE = {}
_WORKSPACE_CACHE = {}
_MM_MODE = 0
_MM_OUT_MODE = 0

try:
    torch.backends.cuda.matmul.allow_tf32 = True
    torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = True
    torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
except Exception:
    pass


def _workspace(name, shape, device, dtype):
    key = (name, tuple(shape), device, dtype)
    out = _WORKSPACE_CACHE.get(key)
    if out is None:
        if len(_WORKSPACE_CACHE) >= 32:
            _WORKSPACE_CACHE.clear()
        out = torch.empty(shape, device=device, dtype=dtype)
        _WORKSPACE_CACHE[key] = out
    return out


@triton.jit
def _ln128(x, y, w, b, total: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    m = pid * BM + tl.arange(0, BM)
    d = tl.arange(0, 128)
    mask = m < total
    v = tl.load(x + m[:, None] * 128 + d[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=1) * 0.0078125
    ss = tl.sum(v * v, axis=1) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(w + d).to(tl.float32)
    bb = tl.load(b + d).to(tl.float32)
    o = (v - mean[:, None]) * r[:, None] * ww[None, :] + bb[None, :]
    tl.store(y + m[:, None] * 128 + d[None, :], o.to(tl.float16), mask=mask[:, None])


@triton.jit
def _ln384(x, y, w, b, total: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    m = pid * BM + tl.arange(0, BM)
    d0 = tl.arange(0, 256)
    d1 = tl.arange(0, 128)
    mask = m < total
    v0 = tl.load(x + m[:, None] * 384 + d0[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    v1 = tl.load(x + m[:, None] * 384 + 256 + d1[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1)
    q = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1)
    mean = s * 0.0026041666666666665
    r = tl.rsqrt(tl.maximum(q * 0.0026041666666666665 - mean * mean, 0.0) + 1.0e-5)
    w0 = tl.load(w + d0).to(tl.float32)
    b0 = tl.load(b + d0).to(tl.float32)
    w1 = tl.load(w + 256 + d1).to(tl.float32)
    b1 = tl.load(b + 256 + d1).to(tl.float32)
    tl.store(y + m[:, None] * 384 + d0[None, :], ((v0 - mean[:, None]) * r[:, None] * w0[None, :] + b0[None, :]).to(tl.float16), mask=mask[:, None])
    tl.store(y + m[:, None] * 384 + 256 + d1[None, :], ((v1 - mean[:, None]) * r[:, None] * w1[None, :] + b1[None, :]).to(tl.float16), mask=mask[:, None])


@triton.jit
def _ln768(x, y, w, b, total: tl.constexpr, BM: tl.constexpr):
    pid = tl.program_id(0)
    m = pid * BM + tl.arange(0, BM)
    d0 = tl.arange(0, 512)
    d1 = tl.arange(0, 256)
    mask = m < total
    v0 = tl.load(x + m[:, None] * 768 + d0[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    v1 = tl.load(x + m[:, None] * 768 + 512 + d1[None, :], mask=mask[:, None], other=0.0).to(tl.float32)
    s = tl.sum(v0, axis=1) + tl.sum(v1, axis=1)
    q = tl.sum(v0 * v0, axis=1) + tl.sum(v1 * v1, axis=1)
    mean = s * 0.0013020833333333333
    r = tl.rsqrt(tl.maximum(q * 0.0013020833333333333 - mean * mean, 0.0) + 1.0e-5)
    w0 = tl.load(w + d0).to(tl.float32)
    b0 = tl.load(b + d0).to(tl.float32)
    w1 = tl.load(w + 512 + d1).to(tl.float32)
    b1 = tl.load(b + 512 + d1).to(tl.float32)
    tl.store(y + m[:, None] * 768 + d0[None, :], ((v0 - mean[:, None]) * r[:, None] * w0[None, :] + b0[None, :]).to(tl.float16), mask=mask[:, None])
    tl.store(y + m[:, None] * 768 + 512 + d1[None, :], ((v1 - mean[:, None]) * r[:, None] * w1[None, :] + b1[None, :]).to(tl.float16), mask=mask[:, None])


@triton.jit
def _gate_nomask(p, total: tl.constexpr, BP: tl.constexpr, BH: tl.constexpr):
    pp = tl.program_id(0) * BP + tl.arange(0, BP)
    hh = tl.program_id(1) * BH + tl.arange(0, BH)
    m = pp[None, :] < total
    base = hh[:, None] * total + pp[None, :]
    l = tl.load(p + base, mask=m, other=0.0).to(tl.float32)
    r = tl.load(p + 128 * total + base, mask=m, other=0.0).to(tl.float32)
    lg = tl.load(p + 256 * total + base, mask=m, other=0.0).to(tl.float32)
    rg = tl.load(p + 384 * total + base, mask=m, other=0.0).to(tl.float32)
    tl.store(p + base, (l * tl.sigmoid(lg)).to(tl.float16), mask=m)
    tl.store(p + 128 * total + base, (r * tl.sigmoid(rg)).to(tl.float16), mask=m)


@triton.jit
def _gate_mask(p, mask_ptr, total: tl.constexpr, BP: tl.constexpr, BH: tl.constexpr):
    pp = tl.program_id(0) * BP + tl.arange(0, BP)
    hh = tl.program_id(1) * BH + tl.arange(0, BH)
    m = pp[None, :] < total
    base = hh[:, None] * total + pp[None, :]
    mk = tl.load(mask_ptr + pp, mask=pp < total, other=0.0).to(tl.float32)
    l = tl.load(p + base, mask=m, other=0.0).to(tl.float32)
    r = tl.load(p + 128 * total + base, mask=m, other=0.0).to(tl.float32)
    lg = tl.load(p + 256 * total + base, mask=m, other=0.0).to(tl.float32)
    rg = tl.load(p + 384 * total + base, mask=m, other=0.0).to(tl.float32)
    tl.store(p + base, (l * tl.sigmoid(lg) * mk[None, :]).to(tl.float16), mask=m)
    tl.store(p + 128 * total + base, (r * tl.sigmoid(rg) * mk[None, :]).to(tl.float16), mask=m)


@triton.jit
def _norm_gate_hb_b1(tri, proj, normed, nw, nb, total: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    m = pp[None, :] < total
    v = tl.load(tri + h[:, None] * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    y = (((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)
    tl.store(normed + pp[:, None] * 128 + h[None, :], tl.trans(y).to(tl.float16), mask=pp[:, None] < total)


@triton.jit
def _norm_gate_hb_b2(tri, proj, normed, nw, nb, n2: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    b = tl.program_id(1)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    total: tl.constexpr = 2 * n2
    gp = b * n2 + pp
    m = pp[None, :] < n2
    v = tl.load(tri + ((h[:, None] * 2 + b) * n2 + pp[None, :]), mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + gp[None, :], mask=m, other=0.0).to(tl.float32)
    y = (((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)
    tl.store(normed + gp[:, None] * 128 + h[None, :], tl.trans(y).to(tl.float16), mask=pp[:, None] < n2)


@triton.jit
def _norm_gate_out128_b1(tri, proj, out, nw, nb, wt, total: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    d = tl.arange(0, 128)
    m = pp[None, :] < total
    v = tl.load(tri + h[:, None] * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    y = (((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)
    w = tl.load(wt + h[:, None] * 128 + d[None, :])
    acc = tl.dot(tl.trans(y.to(tl.float16)), w, out_dtype=tl.float32)
    tl.store(out + pp[:, None] * 128 + d[None, :], acc, mask=pp[:, None] < total)


@triton.jit
def _norm_gate_out128_b2(tri, proj, out, nw, nb, wt, n2: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    b = tl.program_id(1)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    d = tl.arange(0, 128)
    total: tl.constexpr = 2 * n2
    gp = b * n2 + pp
    m = pp[None, :] < n2
    v = tl.load(tri + ((h[:, None] * 2 + b) * n2 + pp[None, :]), mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + gp[None, :], mask=m, other=0.0).to(tl.float32)
    y = (((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)
    w = tl.load(wt + h[:, None] * 128 + d[None, :])
    acc = tl.dot(tl.trans(y.to(tl.float16)), w, out_dtype=tl.float32)
    tl.store(out + gp[:, None] * 128 + d[None, :], acc, mask=pp[:, None] < n2)


@triton.jit
def _norm_gate_out384_b1(tri, proj, out, nw, nb, wt, total: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    d = tl.arange(0, 128)
    m = pp[None, :] < total
    v = tl.load(tri + h[:, None] * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + pp[None, :], mask=m, other=0.0).to(tl.float32)
    yt = tl.trans(((((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)).to(tl.float16))
    sm = pp[:, None] < total
    w0 = tl.load(wt + h[:, None] * 384 + d[None, :])
    w1 = tl.load(wt + h[:, None] * 384 + (d + 128)[None, :])
    w2 = tl.load(wt + h[:, None] * 384 + (d + 256)[None, :])
    tl.store(out + pp[:, None] * 384 + d[None, :], tl.dot(yt, w0, out_dtype=tl.float32), mask=sm)
    tl.store(out + pp[:, None] * 384 + (d + 128)[None, :], tl.dot(yt, w1, out_dtype=tl.float32), mask=sm)
    tl.store(out + pp[:, None] * 384 + (d + 256)[None, :], tl.dot(yt, w2, out_dtype=tl.float32), mask=sm)


@triton.jit
def _norm_gate_out384_b2(tri, proj, out, nw, nb, wt, n2: tl.constexpr, BP: tl.constexpr):
    pid = tl.program_id(0)
    b = tl.program_id(1)
    pp = pid * BP + tl.arange(0, BP)
    h = tl.arange(0, 128)
    d = tl.arange(0, 128)
    total: tl.constexpr = 2 * n2
    gp = b * n2 + pp
    m = pp[None, :] < n2
    v = tl.load(tri + ((h[:, None] * 2 + b) * n2 + pp[None, :]), mask=m, other=0.0).to(tl.float32)
    mean = tl.sum(v, axis=0) * 0.0078125
    ss = tl.sum(v * v, axis=0) * 0.0078125
    r = tl.rsqrt(tl.maximum(ss - mean * mean, 0.0) + 1.0e-5)
    ww = tl.load(nw + h).to(tl.float32)
    bb = tl.load(nb + h).to(tl.float32)
    g = tl.load(proj + (512 + h[:, None]) * total + gp[None, :], mask=m, other=0.0).to(tl.float32)
    yt = tl.trans(((((v - mean[None, :]) * r[None, :]) * ww[:, None] + bb[:, None]) * tl.sigmoid(g)).to(tl.float16))
    sm = pp[:, None] < n2
    w0 = tl.load(wt + h[:, None] * 384 + d[None, :])
    w1 = tl.load(wt + h[:, None] * 384 + (d + 128)[None, :])
    w2 = tl.load(wt + h[:, None] * 384 + (d + 256)[None, :])
    tl.store(out + gp[:, None] * 384 + d[None, :], tl.dot(yt, w0, out_dtype=tl.float32), mask=sm)
    tl.store(out + gp[:, None] * 384 + (d + 128)[None, :], tl.dot(yt, w1, out_dtype=tl.float32), mask=sm)
    tl.store(out + gp[:, None] * 384 + (d + 256)[None, :], tl.dot(yt, w2, out_dtype=tl.float32), mask=sm)


def _cached_weights(weights):
    tensors = (
        weights["left_proj.weight"],
        weights["right_proj.weight"],
        weights["left_gate.weight"],
        weights["right_gate.weight"],
        weights["out_gate.weight"],
        weights["to_out.weight"],
    )
    key = tuple((id(t), t.data_ptr(), tuple(t.shape), t.dtype, t.device) for t in tensors)
    cached = _WEIGHT_CACHE.get(key)
    if cached is not None:
        return cached
    w_proj = torch.cat(tensors[:5], dim=0).contiguous().to(torch.float16)
    w_out_t = tensors[5].t().contiguous().to(torch.float16)
    if len(_WEIGHT_CACHE) >= 8:
        _WEIGHT_CACHE.clear()
    _WEIGHT_CACHE[key] = (w_proj, w_out_t)
    return w_proj, w_out_t


def _mm_half_float(a, b, out=None):
    global _MM_MODE, _MM_OUT_MODE
    if out is not None and _MM_OUT_MODE != 2:
        try:
            y = torch.mm(a, b, out=out, out_dtype=torch.float32)
            _MM_OUT_MODE = 1
            return y
        except (TypeError, RuntimeError):
            _MM_OUT_MODE = 2
    if _MM_MODE == 1:
        return torch.mm(a, b, out_dtype=torch.float32)
    if _MM_MODE == 2:
        return torch.bmm(a.unsqueeze(0), b.unsqueeze(0), out_dtype=torch.float32).squeeze(0)
    if _MM_MODE == 3:
        return torch.mm(a, b).to(torch.float32)
    try:
        y = torch.mm(a, b, out_dtype=torch.float32)
        _MM_MODE = 1
        return y
    except (TypeError, RuntimeError):
        pass
    try:
        y = torch.bmm(a.unsqueeze(0), b.unsqueeze(0), out_dtype=torch.float32).squeeze(0)
        _MM_MODE = 2
        return y
    except (TypeError, RuntimeError):
        _MM_MODE = 3
        return torch.mm(a, b).to(torch.float32)


def custom_kernel(data):
    input_tensor, mask, weights, config = data
    bsz, n, _, dim = input_tensor.shape
    hidden = config["hidden_dim"]
    total = bsz * n * n
    n2 = n * n
    device = input_tensor.device

    w_proj, w_out_t = _cached_weights(weights)
    xh = _workspace("xh", (total, dim), device, torch.float16)

    if dim == 128:
        _ln128[(triton.cdiv(total, 16),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BM=16, num_warps=4,
        )
    elif dim == 384:
        _ln384[(triton.cdiv(total, 8),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BM=8, num_warps=8,
        )
    else:
        _ln768[(triton.cdiv(total, 4),)](
            input_tensor, xh, weights["norm.weight"], weights["norm.bias"],
            total, BM=4, num_warps=8,
        )

    proj_h = _workspace("proj_h", (5 * hidden, total), device, torch.float16)
    torch.mm(w_proj, xh.t(), out=proj_h)

    if mask is not None and not bool(config.get("nomask", False)):
        _gate_mask[(triton.cdiv(total, 64), 4)](
            proj_h, mask.reshape(total), total, BP=64, BH=32, num_warps=4,
        )
    else:
        _gate_nomask[(triton.cdiv(total, 64), 4)](
            proj_h, total, BP=64, BH=32, num_warps=4,
        )

    tri_h = _workspace("tri_h", (hidden * bsz, n, n), device, torch.float16)
    left_h = proj_h[:hidden].view(hidden * bsz, n, n)
    right_h = proj_h[hidden:2 * hidden].view(hidden * bsz, n, n)
    torch.bmm(left_h, right_h.transpose(1, 2), out=tri_h)

    if dim == 128:
        out = torch.empty((total, 128), device=device, dtype=torch.float32)
        if bsz == 2:
            _norm_gate_out128_b2[(triton.cdiv(n2, 32), 2)](
                tri_h, proj_h, out,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                n2, BP=32, num_warps=8,
            )
        else:
            _norm_gate_out128_b1[(triton.cdiv(total, 32),)](
                tri_h, proj_h, out,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                total, BP=32, num_warps=8,
            )
        return out.view(bsz, n, n, 128)

    if dim == 384 and total <= 131072:
        out = torch.empty((total, 384), device=device, dtype=torch.float32)
        if bsz == 2:
            _norm_gate_out384_b2[(triton.cdiv(n2, 32), 2)](
                tri_h, proj_h, out,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                n2, BP=32, num_warps=8,
            )
        else:
            _norm_gate_out384_b1[(triton.cdiv(total, 32),)](
                tri_h, proj_h, out,
                weights["to_out_norm.weight"], weights["to_out_norm.bias"], w_out_t,
                total, BP=32, num_warps=8,
            )
        return out.view(bsz, n, n, 384)

    normed = _workspace("normed", (total, hidden), device, torch.float16)
    if bsz == 2:
        _norm_gate_hb_b2[(triton.cdiv(n2, 32), 2)](
            tri_h, proj_h, normed,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"],
            n2, BP=32, num_warps=8,
        )
    else:
        _norm_gate_hb_b1[(triton.cdiv(total, 32),)](
            tri_h, proj_h, normed,
            weights["to_out_norm.weight"], weights["to_out_norm.bias"],
            total, BP=32, num_warps=8,
        )

    out_buf = None
    if _MM_OUT_MODE != 2:
        out_buf = torch.empty((total, dim), device=device, dtype=torch.float32)
    out = _mm_half_float(normed, w_out_t, out_buf)
    return out.view(bsz, n, n, dim)

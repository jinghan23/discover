+    grid = (triton.cdiv(n_rows, 32), triton.cdiv(out_dim, 64))
+    seq_len = out.shape[1]
+    plane = out.shape[1] * out.shape[2]
+    _norm_gate_out_kernel[grid](
+        out, out_gate, norm_w, norm_b, out_w, y,
+        out_gate.stride(2), plane, seq_len,

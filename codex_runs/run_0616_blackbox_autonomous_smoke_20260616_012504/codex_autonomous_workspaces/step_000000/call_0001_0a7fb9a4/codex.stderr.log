+                mask=cols[None, :] < out_dim, other=0.0).to(tl.float32)
+    acc = tl.dot(a, w, input_precision="ieee")
+    tl.store(y_ptr + rows[:, None] * out_dim + cols[None, :],
+             acc, mask=row_mask[:, None] & (cols[None, :] < out_dim))
+
+
+def _norm_gate_out(out, out_gate, norm_w, norm_b, out_w, out_dim):
+    n_rows = out.numel() // 128
+    y = torch.empty((n_rows, out_dim), device=out.device, dtype=torch.float32)
+    grid = (triton.cdiv(n_rows, 32), triton.cdiv(out_dim, 64))
+    seq_len = out.shape[1]
+    plane = out.shape[1] * out.shape[2]
+    _norm_gate_out_kernel[grid](

+    row = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_D)
+    mask = offs < dim
+    vals = tl.load(x_ptr + row * dim + offs, mask=mask, other=0.0).to(tl.float32)
+    mean = tl.sum(vals, axis=0) / dim

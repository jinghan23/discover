+    y = torch.empty_like(x, dtype=torch.float32)
+    n_rows = x.numel() // dim
+    block = triton.next_power_of_2(dim)
+    warps = 1 if dim == 128 else 2
+    _layer_norm_kernel[(n_rows,)](x, weight, bias, y, n_rows, dim, block, num_warps=warps)

+                mask=cols[None, :] < out_dim, other=0.0).to(tl.float32)
+    acc = tl.dot(a, w, input_precision="ieee")
+    tl.store(y_ptr + rows[:, None] * out_dim + cols[None, :],
+             acc, mask=row_mask[:, None] & (cols[None, :] < out_dim))

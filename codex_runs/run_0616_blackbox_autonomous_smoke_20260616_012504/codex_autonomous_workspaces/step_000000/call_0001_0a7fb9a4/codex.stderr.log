codex
The fused final kernel now uses `out`’s real strides. I’ll run the local comparison on an actual `einsum` output, then the blackbox evaluator.
exec
/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
from submission import _norm_gate_out

torch.manual_seed(1)
for B in [1,2]:
  for N in [8,33]:
    for D in [128,384]:
      left=torch.randn(B,N,N,128,device='cuda')
      right=torch.randn(B,N,N,128,device='cuda')
      out=torch.einsum('bikd,bjkd->bijd',left.to(torch.bfloat16),right.to(torch.bfloat16)).to(torch.float32)
      proj=torch.randn(B,N,N,640,device='cuda')
      gate=torch.sigmoid(proj[...,512:640])
      norm_w=torch.randn(128,device='cuda')
      norm_b=torch.randn(128,device='cuda')
      out_w=torch.randn(D,128,device='cuda')
      ref=F.linear(F.layer_norm(out,(128,),norm_w,norm_b)*gate, out_w)
      got=_norm_gate_out(out,gate,norm_w,norm_b,out_w,D)
      torch.cuda.synchronize()
      diff=(got-ref).abs()
      print('B,N,D',B,N,D,'stride',out.stride(),'max',diff.max().item(),'mean',diff.mean().item(), 'ok', torch.allclose(got, ref, rtol=1e-3, atol=1e-3))
PY" in /opt/tiger/discover-gpu-kernel-experiments/workspace

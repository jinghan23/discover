+    l = tl.load(left_ptr + in_off, mask=valid, other=0.0).to(tl.float32)
+    r = tl.load(right_ptr + in_off, mask=valid, other=0.0).to(tl.float32)
+    lg = tl.load(lg_ptr + in_off, mask=valid, other=0.0).to(tl.float32)
+    rg = tl.load(rg_ptr + in_off, mask=valid, other=0.0).to(tl.float32)
+    if not NOMASK:
+        m = tl.load(mask_ptr + (b * seq_len + a) * seq_len + k, mask=valid, other=0.0).to(tl.float32)
+        l = l * m
+        r = r * m
+    tl.store(left_o_ptr + out_off, l * lg, mask=valid)

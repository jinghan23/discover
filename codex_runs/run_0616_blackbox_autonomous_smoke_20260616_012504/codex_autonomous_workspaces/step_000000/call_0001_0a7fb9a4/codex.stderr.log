/bin/bash -lc "python - <<'PY'
import torch
import torch.nn.functional as F
from submission import _norm_gate_out

torch.manual_seed(0)
for M in [7,64,1000]:
  for D in [128,384]:
    out=torch.randn(M,128,device='cuda',dtype=torch.float32)
    big=torch.randn(M,640,device='cuda',dtype=torch.float32)
    gate=torch.sigmoid(big[:,512:640]).view(1,1,M,128)
    norm_w=torch.randn(128,device='cuda')
    norm_b=torch.randn(128,device='cuda')
    out_w=torch.randn(D,128,device='cuda')
    ref=F.linear(F.layer_norm(out.view(1,1,M,128),(128,),norm_w,norm_b)*gate.view(M,128), out_w)
    got=_norm_gate_out(out.view(1,1,M,128), gate, norm_w, norm_b, out_w, D).view(M,D)
    torch.cuda.synchronize()
    diff=(got-ref).abs()
    print('M,D',M,D,'max',diff.max().item(),'mean',diff.mean().item(),'refmax',ref.abs().max().item())
    print('allclose',torch.allclose(got,ref,rtol=1e-3,atol=1e-3))
